# ============================================================================
# Lume v1.0.0 — Verified Multi-Domain Showcase (verified_showcase.src)
# Demonstrates: Contracts (requires/ensures), Laws (QF_LIA), ADTs, Pipe (|>)
# Run with:
#   lume run skills/lume/examples/verified_showcase.src
#   lume test skills/lume/examples/verified_showcase.src
#   lume prove skills/lume/examples/verified_showcase.src
#   lume certify skills/lume/examples/verified_showcase.src
# ============================================================================

const FEE_CAP_BPS: int = 1000

fn math_clamp(x: int, lo: int, hi: int) -> int
  requires lo <= hi
  ensures result >= lo and result <= hi
= if x < lo then lo else if x > hi then hi else x

law scale_bonus_sound(x: int) =
  if x >= 0 then scale_and_bonus(x, 2) >= x + 10 else 1 == 1

fn scale_and_bonus(x: int, factor: int) -> int
  requires x >= 0 and factor >= 1
  ensures result >= x + 10
= (x * factor) + 10

fn ring0_align_4k(phys_addr: int) -> int
  requires phys_addr >= 0
  ensures result <= phys_addr
= let rem = phys_addr % 4096 in
  if rem == 0 then phys_addr else phys_addr - rem

fn test_showcase() =
  let clamped = math_clamp(250, 10, 100) in
  let scaled = clamped |> scale_and_bonus(2) in
  let aligned = ring0_align_4k(12345) in
  clamped == 100 and scaled == 210 and aligned == 12288

print f"Clamped={math_clamp(250, 10, 100)} Scaled={scale_and_bonus(100, 2)} Aligned4K={ring0_align_4k(12345)}"
