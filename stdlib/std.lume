## Lume Sovereign Standard Library (`stdlib/std.lume`)
## Formally Verified QF_LIA Collection, Slice, Hash-Slot & Decimal Helpers

@bound(16)
pub fn decimal_clamp_int(value: int, lo: int, hi: int) -> int
    requires lo <= hi
    ensures result >= lo and result <= hi
    if value < lo then lo else if value > hi then hi else value

@bound(16)
pub fn vec_clamp_index(idx: int, len: int) -> int
    requires len >= 1
    ensures result >= 0 and result < len
    if idx < 0 then 0 else if idx >= len then len - 1 else idx

@bound(8)
pub fn vec_checked_slice_len(start: int, end_idx: int, total_len: int) -> int
    requires start >= 0 and end_idx >= start and end_idx <= total_len
    ensures result == end_idx - start and result >= 0 and result <= total_len
    end_idx - start

@bound(8)
pub fn map_checked_slot(hash_pos: int, cap: int) -> int
    requires hash_pos >= 0 and cap >= 1 and hash_pos < cap
    ensures result >= 0 and result < cap
    hash_pos

@bound(8)
pub fn vec_slice_conservation_law(start: int, end_idx: int) -> int
    requires start >= 0 and end_idx >= start
    ensures result == end_idx
    start + (end_idx - start)

fn test_decimal_clamp_int() = decimal_clamp_int(3, 10, 20) == 10 and decimal_clamp_int(15, 10, 20) == 15 and decimal_clamp_int(99, 10, 20) == 20

fn test_vec_clamp_index() = vec_clamp_index(0 - 5, 10) == 0 and vec_clamp_index(4, 10) == 4 and vec_clamp_index(25, 10) == 9 and vec_clamp_index(0, 1) == 0

fn test_vec_checked_slice_len() = vec_checked_slice_len(2, 7, 10) == 5 and vec_checked_slice_len(0, 10, 10) == 10 and vec_checked_slice_len(4, 4, 10) == 0

fn test_map_checked_slot() = map_checked_slot(0, 256) == 0 and map_checked_slot(127, 256) == 127 and map_checked_slot(255, 256) == 255

fn test_vec_slice_conservation_law() = vec_slice_conservation_law(3, 9) == 9 and vec_slice_conservation_law(0, 16) == 16
