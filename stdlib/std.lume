## Lume Sovereign Standard Library (`stdlib/std.lume`)
## Formally Verified QF_LIA Collection, Slice, Hash-Slot & Decimal Helpers

@bound(16)
pub fn decimal_clamp_int(value: int, lo: int, hi: int) -> int
    requires lo <= hi
    ensures result >= lo and result <= hi
    if value < lo then lo else if value > hi then hi else value

@bound(16)
pub fn vec_clamp_index(idx: int, len: int) -> int
    requires len >= 1
    ensures result >= 0 and result < len
    if idx < 0 then 0 else if idx >= len then len - 1 else idx

@bound(8)
pub fn vec_checked_slice_len(start: int, end_idx: int, total_len: int) -> int
    requires start >= 0 and end_idx >= start and end_idx <= total_len
    ensures result == end_idx - start and result >= 0 and result <= total_len
    end_idx - start

@bound(8)
pub fn map_checked_slot(hash_pos: int, cap: int) -> int
    requires hash_pos >= 0 and cap >= 1 and hash_pos < cap
    ensures result >= 0 and result < cap
    hash_pos

@bound(8)
pub fn vec_slice_conservation_law(start: int, end_idx: int) -> int
    requires start >= 0 and end_idx >= start
    ensures result == end_idx
    start + (end_idx - start)

@bound(16)
pub fn lumeputer_deltanet_ram_step(old_val: int, new_val: int, beta_gate: int) -> int
    requires beta_gate == 0 or beta_gate == 1
    ensures (beta_gate == 1 and result == new_val) or (beta_gate == 0 and result == old_val)
    if beta_gate == 1 then new_val else old_val

@bound(16)
pub fn lumeputer_swiglu_relu_gate(val: int, gate_active: int, k_gain: int) -> int
    requires (gate_active == 0 or gate_active == 1) and k_gain >= 18
    ensures (gate_active == 0 and result == 0) or (gate_active == 1 and result == val)
    if gate_active == 1 then val else 0

@bound(16)
pub fn lumepu_vx_vmat_mac(acc: int, act_i8: int, w_i4: int, scale: int) -> int
    requires scale >= 1
    ensures result == acc + act_i8 * w_i4 * scale
    acc + act_i8 * w_i4 * scale

@bound(24)
pub fn lumeputer_stack_push_frame_sp(sp_bytes: int, frame_words: int) -> int
    requires sp_bytes >= 1024 and sp_bytes <= 32768 and frame_words >= 1 and frame_words <= 64
    ensures result >= 0 and result < sp_bytes
    sp_bytes - frame_words * 4

@bound(24)
pub fn lumeputer_stack_pop_frame_sp(sp_bytes: int, frame_words: int) -> int
    requires sp_bytes >= 0 and sp_bytes <= 32764 and frame_words >= 1 and frame_words <= 64
    ensures result > sp_bytes
    sp_bytes + frame_words * 4

