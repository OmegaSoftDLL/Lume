{
  "name": "Dracula Lume Sovereign",
  "type": "dark",
  "colors": {
    "editor.background": "#282a36",
    "editor.foreground": "#f8f8f2",
    "activityBarBadge.background": "#ff79c6",
    "sideBarTitle.foreground": "#bd93f9",
    "editorLineNumber.foreground": "#6272a4",
    "editor.selectionBackground": "#44475a",
    "editorCursor.foreground": "#f8f8f2"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "comment.line.number-sign.lume"],
      "settings": {
        "foreground": "#6272a4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Formal Verification & Proof Keywords (law, requires, ensures)",
      "scope": ["keyword.other.proof.lume"],
      "settings": {
        "foreground": "#ffb86c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Lume Core Keywords",
      "scope": ["keyword.control.lume"],
      "settings": {
        "foreground": "#ff79c6"
      }
    },
    {
      "name": "Lume Systems & Kernel Attributes",
      "scope": ["entity.name.tag.attribute.lume"],
      "settings": {
        "foreground": "#bd93f9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types & Linear Capabilities",
      "scope": ["storage.type.lume"],
      "settings": {
        "foreground": "#8be9fd",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function.lume"],
      "settings": {
        "foreground": "#50fa7b"
      }
    },
    {
      "name": "Strings",
      "scope": ["string.quoted.double.lume"],
      "settings": {
        "foreground": "#f1fa8c"
      }
    },
    {
      "name": "Numbers & Booleans",
      "scope": ["constant.numeric.lume", "constant.language.boolean.lume"],
      "settings": {
        "foreground": "#bd93f9"
      }
    }
  ]
}
