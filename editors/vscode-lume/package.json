{
  "name": "dracula-lume",
  "displayName": "Lume Language & Dracula Sovereign Theme",
  "description": "Official Lume (.src / .lume) syntax highlighting, formal verification grammar (law/requires/ensures), and Dracula Lume color theme for VS Code, Cursor, and Antigravity IDE.",
  "version": "1.0.0",
  "publisher": "OmegaSoftDLL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OmegaSoftDLL/lume.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lume",
        "aliases": [
          "Lume",
          "lume"
        ],
        "extensions": [
          ".src",
          ".lume"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lume",
        "scopeName": "source.lume",
        "path": "./syntaxes/lume.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Dracula Lume Sovereign",
        "uiTheme": "vs-dark",
        "path": "./themes/dracula-lume-color-theme.json"
      }
    ]
  }
}
