{
  "name": "dracula-lume",
  "displayName": "Lume Language & Dracula Sovereign Theme",
  "description": "Official Lume (.src / .lume) syntax highlighting, formal verification grammar (law/requires/ensures), QF_LIA theorem prover commands, stdio LSP bridge, and Dracula Lume color theme for VS Code, Cursor, and Antigravity IDE.",
  "version": "1.0.0",
  "publisher": "OmegaSoftDLL",
  "icon": "icon.png",
  "license": "Apache-2.0",
  "main": "./extension.js",
  "keywords": [
    "lume",
    "formal-verification",
    "qf-lia",
    "theorem-prover",
    "dracula"
  ],
  "homepage": "https://github.com/OmegaSoftDLL/lume",
  "bugs": {
    "url": "https://github.com/OmegaSoftDLL/lume/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OmegaSoftDLL/lume.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:lume"
  ],
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "lume",
        "aliases": [
          "Lume",
          "lume"
        ],
        "extensions": [
          ".src",
          ".lume"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lume",
        "scopeName": "source.lume",
        "path": "./syntaxes/lume.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Dracula Lume Sovereign",
        "uiTheme": "vs-dark",
        "path": "./themes/dracula-lume-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "lume.proveFile",
        "title": "Lume: Prove Current File (QF_LIA Theorem Prover)"
      },
      {
        "command": "lume.certifyFile",
        "title": "Lume: Certify Current File (Standalone lcert Kernel)"
      },
      {
        "command": "lume.runFile",
        "title": "Lume: Run Current File"
      },
      {
        "command": "lume.startLsp",
        "title": "Lume: Start Language Server (lume lsp --stdio)"
      }
    ]
  }
}
