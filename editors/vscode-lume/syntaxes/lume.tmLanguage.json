{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lume",
  "scopeName": "source.lume",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#proof_keywords" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lume",
          "match": "#.*$"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.name.tag.attribute.lume",
          "match": "@(freestanding|repr|packed|bits|mmio|interrupt|bound|schedule|intent)\\b"
        }
      ]
    },
    "proof_keywords": {
      "patterns": [
        {
          "name": "keyword.other.proof.lume",
          "match": "\\b(law|requires|ensures|invariant|test|assert|prove|certify)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lume",
          "match": "\\b(fn|pub|let|in|if|then|else|match|with|type|struct|enum|effect|handle|resume|spawn|actor|comptime|macro|kernel|extern|use|mod|persist|query|from|where|select|grad|value_and_grad|jvp|vjp)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.lume",
          "match": "\\b(Int|Bool|String|Float|Unit|decimal|money|table|tensor|cap|Page|Port|Irq|Option|Result|List)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lume",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lume",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lume",
          "match": "\\b(0x[0-9a-fA-F_]+|[0-9][0-9_]*(\\.[0-9_]+)?)\\b"
        },
        {
          "name": "constant.language.boolean.lume",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.lume",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}
