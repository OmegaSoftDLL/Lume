## arena_busy_fail.src -- #404: the runtime arena table has 4 slots; a fifth
## concurrent __lume_arena_new must fail CLOSED (stderr diagnostic + exit 12).
## Calls the runtime builtins directly (the std.arena wrapper in
## compiler/stage1/arena.src is a transparent fn over them).
print (let a1 = __lume_arena_new(1024) in
       let a2 = __lume_arena_new(1024) in
       let a3 = __lume_arena_new(1024) in
       let a4 = __lume_arena_new(1024) in
       let a5 = __lume_arena_new(1024) in
       a5)
