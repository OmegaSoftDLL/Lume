## gc_cap_ok.src -- run with LUME_HEAP_CAP=32m. This allocates about 2 GiB in total with a tiny live set, so a
## runtime that does not reclaim memory dies with "heap cap exceeded" long before the end.
fn cell_chain(n, acc) = if n == 0 then acc else cell_chain(n - 1, Cons({v: n}, acc))
fn len_of(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => len_of(t, acc + 1)
fn spin(i, acc) = if i == 0 then acc else spin(i - 1, acc + len_of(cell_chain(1000, Nil), 0))

print spin(10000, 0)
