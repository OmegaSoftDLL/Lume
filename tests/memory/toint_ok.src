## toint_ok.src -- toint reads an optional sign and the digits that follow it.
fn f(s) = toint(s)
print f("42")
print f("-42")
print f("-9223372036854775808")
print f("9223372036854775807")
print f("0")
print f("-0")
print f("12x")
print f("x12")
print f("")
print f("-")
print f(str(0 - 7))
print at("abc", 9) == ""
print "abc"[2]
