## gc_stress_ok.src -- run under LUME_GC_STRESS=3: a collection every third allocation, with freed objects
## poisoned, so any object freed too early turns into a crash or a wrong value here.
fn mk_recs(n, acc) = if n == 0 then acc else mk_recs(n - 1, Cons({id: n, name: "r" + str(n * 7919), nested: Cons(n, Cons(n + 1, Nil))}, acc))
fn second(xs) = match xs
    Cons(a, Cons(b, r)) => b
    _                   => 0
fn check(xs, i) = match xs
    Nil        => 1
    Cons(h, t) => if h.id == i and h.name == "r" + str(i * 7919) and second(h.nested) == i + 1 then check(t, i + 1) else 0
fn churn(n, s) = if n == 0 then s else churn(n - 1, slice("abcdefgh" + str(n), 2, 7))
fn run() = let keep = mk_recs(300, Nil) in let j = churn(400, "") in if check(keep, 1) == 1 and j == "cdefg" then "survivors ok" else "survivors LOST"

print run()
