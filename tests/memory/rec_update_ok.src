## rec_update_ok.src -- `{ r with a: 9 }` keeps every field, whatever the shape of `r`.
type P = record x: int, y: int
fn mk1() = {a: 1, b: 2}
fn mk2() = {a: 1, b: 2, c: 3}
fn f(r) = { r with a: 9 }
fn g(p: P) -> P = { p with y: 5 }
fn step(state) = { state with count: state.count + 1, seen: state.seen + 1 }
fn keep(r) = let s = { r with a: 0 } in r.a * 10 + s.a
print f(mk2())
print f(mk1())
print g(P{x: 1, y: 2})
print step({count: 1, seen: 2, name: "n"})
print let m = mk2() in { m with c: 7 }
print keep({a: 4})
