## gc_frag_cap_ok.src -- run with LUME_HEAP_CAP=16m. A few live cells spread over every chunk leave no chunk
## free after a collection, but plenty of room inside them: the allocator must use that room, not give up.
fn keep_some(i, acc) = if i == 0 then acc else let g = {v: i} in keep_some(i - 1, if i % 300 == 0 then Cons(g, acc) else acc)
fn churn(i, keep) = if i == 0 then keep else let g = {v: i} in churn(i - 1, keep)
fn size(xs, n) = match xs
    Nil        => n
    Cons(h, t) => size(t, n + 1)

print size(churn(3000000, keep_some(300000, Nil)), 0)
