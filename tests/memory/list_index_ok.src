## list_index_ok.src -- `xs[i]` on a parameter, a local, a closure parameter, a string and a top-level value.
let top = [7, 8, 9]
fn third(xs) = xs[2]
fn sum(xs, i) = if i >= count(xs) then 0 else xs[i] + sum(xs, i + 1)
fn first_char(s) = s[0]
fn via_let() = let ys = [4, 5] in ys[1]
fn via_lambda() = let f = fn(zs) => zs[0] in f([6])
fn generic(comptime T: type, x: T) -> T = x
print third([1, 2, 3])
print sum([1, 2, 3, 4], 0)
print first_char("lume")
print via_let()
print via_lambda()
print top[1]
print generic(int, 9)
print [10, 20, 30][1]
print "hello"[1]
print third([[1], [2], [3, 4]])[1]
