## pattern_int_ok.src -- an integer pattern of any size compares all 64 bits.
fn f(x) = match x
    4294967297           => 1
    -4294967297          => 2
    9223372036854775807  => 3
    -9223372036854775808 => 4
    2147483647           => 5
    -2147483648          => 6
    _                    => 0
print f(1)
print f(4294967297)
print f(0 - 4294967297)
print f(9223372036854775807)
print f(0 - 9223372036854775807 - 1)
print f(2147483647)
print f(0 - 2147483648)
print f(0 - 1)
