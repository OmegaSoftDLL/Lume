## heap_cap_fail.src -- #404: with LUME_HEAP_CAP set below the live-set size,
## the runtime must fail CLOSED (stderr diagnostic + exit 12), not segfault.
## 1M small records (~56 MiB of plain-heap growth) against a 32 MiB cap.
fn big_fill(i) = if i == 0 then 0 else let r = {cellv: i} in big_fill(i - 1)

print (let f = big_fill(1000000) in f)
