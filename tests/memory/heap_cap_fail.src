## heap_cap_fail.src -- #404: with LUME_HEAP_CAP set below the LIVE set, the runtime must fail CLOSED (stderr
## diagnostic + exit 12), not segfault. The collector cannot help here: all 2M records stay reachable.
fn keep(i, acc) = if i == 0 then acc else keep(i - 1, Cons({cellv: i}, acc))
fn size(xs, n) = match xs
    Nil        => n
    Cons(h, t) => size(t, n + 1)

print size(keep(2000000, Nil), 0)
