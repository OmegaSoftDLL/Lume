## arena_nopin_ok.src -- an arena is its own mapping: while a 48 MiB arena is live the normal heap must still be
## able to grow past it. Until the heap moved off brk this exact program died with "heap ceiling pinned".
fn keep(i, acc) = if i == 0 then acc else keep(i - 1, Cons({cellv: i}, acc))
fn size(xs, n) = match xs
    Nil        => n
    Cons(h, t) => size(t, n + 1)

print (let a = __lume_arena_new(50331648) in size(keep(1000000, Nil), 0))
