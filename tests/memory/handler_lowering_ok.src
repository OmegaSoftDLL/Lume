## handler_lowering_ok.src -- every lowering reaches the bodies of `with handler` and `with alloc`.
const K: int = 5
let limit = 2 + 3
effect Log { fn say(x) -> int }
fn inc(x) = x + 1
fn app(f, x) = f(x)
fn id(comptime T: type, x: T) -> T = x
fn with_const() = with handler Log { fn say(x) -> int = x + K + limit } in say(1)
fn with_index(ys) = with handler Log { fn say(x) -> int = x + ys[1] } in say(ys[0])
fn with_update(r) = with handler Log { fn say(x) -> int = { r with a: x }.a } in say(7)
fn with_value() = with handler Log { fn say(x) -> int = app(inc, x) } in app(inc, say(1))
fn with_lambda(k) = with handler Log { fn say(x) -> int = app(fn(a) => a + k, x) } in say(1)
fn with_generic() = with handler Log { fn say(x) -> int = id(int, x) } in say(id(int, 8))
fn in_alloc(k) = with alloc = 0 in app(fn(a) => a + k + K, 1) + app(inc, k)
print with_const()
print with_index([1, 2])
print with_update({a: 1, b: 2})
print with_value()
print with_lambda(40)
print with_generic()
print in_alloc(1)
