## freestanding_values_ok.src -- indexing, count and the immediates in a kernel image, with no operating system underneath.
@freestanding
fn kernel_boot_entry() = let xs = [10, 20, 30] in let s = "abcdefghij" in (xs[1] * 1000) + count(s) + ord(s[9])
print kernel_boot_entry()
print exists_range(i, 9223372036854775807, 9223372036854775807, i < 0)
print [7, 8][1]
