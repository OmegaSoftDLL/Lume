## bool_ok.src -- `true`, `false` and comparisons as values, with and without declared types.
fn yes() -> bool = true
fn no() -> bool = false
fn pos(x: int) -> bool = x > 0
fn both(a: bool, b: bool) -> bool = a and b
fn neg(a: bool) -> bool = not a
fn as_int(x: int) -> int = if x > 0 then 1 else 0
fn pick(b: bool) -> str = if b then "yes" else "no"
print yes()
print no()
print pos(1)
print pos(0 - 1)
print both(true, pos(2))
print neg(false)
print as_int(3)
print if true then 10 else 20
print true == true
print pick(pos(5))
print comptime(true)
