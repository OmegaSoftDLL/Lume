## arena_cap_ok.src -- run with LUME_HEAP_CAP=64m. Garbage must not count against a new arena: the heap has
## committed the whole cap, nearly all of it free.
fn churn(i) = if i == 0 then 0 else let g = Cons(i, Nil) in churn(i - 1)

print (let z = churn(4000000) in let a = __lume_arena_new(1048576) in z + 7)
