## dir_race_ok.src -- reads the directory named by argv[1] while something creates files in it: the listing
## can grow between the two passes of fs_read_dir, which must truncate rather than write past its buffer.
fn spin(path, i, acc) = if i == 0 then acc else spin(path, i - 1, acc + (if count(fs_read_dir(path)) >= 0 then 1 else 0))

print spin(os_arg_at(1), 4000, 0)
