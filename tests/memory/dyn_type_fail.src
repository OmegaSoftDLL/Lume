## dyn_type_fail.src -- each line stops the program with exit 3 when it is the one selected by the argument count.
fn bad_match(xs) = match xs { Cons(a, Nil) => a }
fn bad_field(r) = r.b
fn bad_arith(x) = x - 1
fn bad_add(x) = x + 1
fn bad_cmp(x) = x < 1
fn bad_cond(x) = if x then 1 else 0
fn bad_div(a, b) = a / b
fn bad_mod(a, b) = a % b
fn pick(n) = if n == 1 then bad_match(Nil) else if n == 2 then bad_field({a: 1}) else if n == 3 then bad_field("a string, not a record") else if n == 4 then bad_field(7) else if n == 5 then bad_arith("s") else if n == 6 then bad_add(Cons(1, Nil)) else if n == 7 then bad_cmp({a: 1}) else if n == 8 then toint("99999999999999999999") else if n == 9 then bad_cond("s") else if n == 10 then bad_div(0 - 9223372036854775807 - 1, 0 - 1) else if n == 11 then bad_mod(0 - 9223372036854775807 - 1, 0 - 1) else bad_div(1, 0)

print pick(os_arg_count())
