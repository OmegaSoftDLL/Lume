## shadow_call_ok.src -- a local shadows a top-level function when it is called, as it does everywhere else.
fn f(x) = x + 1
fn local_param(f) = f(10)
fn local_let() = let f = fn(a) => a * 2 in f(10)
fn pattern(v) = match v { Some(f) => f(10), _ => 0 }
fn inside(f) = let h = fn(a) => f(a) in h(10)
type O = enum Some(int) | None
print f(1)
print local_param(fn(a) => a + 5)
print local_let()
print pattern(Some(fn(a) => a + 6))
print inside(fn(a) => a + 7)
