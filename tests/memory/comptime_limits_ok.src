## comptime_limits_ok.src -- comptime arithmetic reaches both ends of the 64-bit range and stops only past them.
print comptime(9223372036854775806 + 1)
print comptime(0 - 9223372036854775807 - 1)
print comptime(3037000499 * 3037000499)
print comptime((0 - 3037000499) * 3037000499)
print comptime((0 - 4611686018427387904) * 2)
print comptime(4611686018427387904 * (0 - 2))
print comptime(9223372036854775807 * (0 - 1))
print comptime((0 - 9223372036854775807 - 1) * 1)
print comptime((0 - 9223372036854775807) / (0 - 1))
print comptime((0 - 7) % (0 - 1))
print comptime((0 - 9223372036854775807 - 1) / 1)
