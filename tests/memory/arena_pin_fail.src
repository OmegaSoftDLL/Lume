## arena_pin_fail.src -- #404: while an arena is live, the normal heap cannot
## grow past the arena base (the arena pins the heap ceiling). A normal
## allocation past the pin must fail CLOSED (stderr diagnostic + exit 12),
## not corrupt the arena. Here a 48 MiB arena pins the ceiling and the plain
## heap then tries to grow past it.
fn big_fill(i) = if i == 0 then 0 else let r = {cellv: i} in big_fill(i - 1)

print (let a = __lume_arena_new(50331648) in let f = big_fill(1000000) in f)
