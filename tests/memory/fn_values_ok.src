## fn_values_ok.src -- a named function is a value, with or without lambdas elsewhere in the program.
fn inc(x) = x + 1
fn add(a, b) = a + b
fn apply(f, x) = f(x)
fn twice(f, x) = f(f(x))
fn fold2(f, a, b) = f(a, b)
fn through_let() = let g = inc in g(1)
print apply(inc, 1)
print twice(inc, 1)
print fold2(add, 40, 2)
print through_let()
fn id(comptime T: type, x: T) -> T = x
print apply(id, 7)
print count(str(inc)) > 0
