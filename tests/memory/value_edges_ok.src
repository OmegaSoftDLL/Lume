## value_edges_ok.src -- the answers an old implementation got wrong or a new one could get wrong, one line each.
fn sub(a, b) = a - b
fn add(a, b) = a + b
fn top63() = 4611686018427387903
fn low63() = 0 - 4611686018427387904
fn top() = 9223372036854775807
fn nul() = chr(0)
fn order(a, b) = str(a < b) + str(a <= b) + str(a > b) + str(a >= b) + str(a == b) + str(a != b)
fn pat(v) = match v
    ""  => "empty"
    "a" => "a"
    _   => "other"

## a subtraction that leaves the 63 bits of the word in either direction, and the ones that stay inside
print sub(top63(), 0 - 1)
print sub(low63(), 1)
print sub(top63(), low63())
print sub(low63(), top63())
print sub(top63(), top63())
print sub(0, low63())
print add(top63(), 1)
print add(low63(), 0 - 1)

## a quantifier whose range ends at the top of int stops there, it does not step past it
print exists_range(i, top(), top(), i < 0)
print forall_range(i, top() - 1, top(), i > 0)
print exists_range(i, top() - 1, top(), i == top())
print exists_range(i, 0 - top(), 0 - top(), i > 0)

## an integer past 63 bits is an integer: as a condition it is true, as any other integer that is not 0
fn big() = 4611686018427387904
fn truth(v) = if v then 1 else 0
fn negate(v) = not v
fn either(a, b) = a or b
fn both(a, b) = a and b
print truth(big())
print truth(0 - big() - 1)
print negate(big())
print either(big(), 0)
print either(0, big())
print both(big(), 1)
print both(1, big())
print both(0, big())

## the kind of the value is checked first, so a wrong kind reads the same whatever the position
fn stop_at(v, i) = if __lume_try_begin() == 0 then let r = at(v, i) in let z = __lume_try_end() in "no stop" else __lume_try_msg()
fn stop_index(v, i) = if __lume_try_begin() == 0 then let r = v[i] in let z = __lume_try_end() in "no stop" else __lume_try_msg()
fn stop_ord(v, i) = if __lume_try_begin() == 0 then let r = ord(at(v, i)) in let z = __lume_try_end() in "no stop" else __lume_try_msg()
fn not_string() = 7
print stop_at(not_string(), 0)
print stop_at(not_string(), 0 - 1)
print stop_at([1], 0 - 1)
print stop_index({a: 1}, 0)
print stop_index({a: 1}, 0 - 1)
print stop_index({a: 1}, 4611686018427387904)
print stop_index(not_string(), 0 - 1)
print stop_ord(not_string(), 0)
print stop_ord(not_string(), 0 - 1)
print stop_ord(not_string(), 4611686018427387904)
print stop_ord("abc", "a")
print ord(at("abc", 0 - 1))
print ord(at("abc", 4611686018427387904))

## order, equality and match agree on strings holding a NUL byte: length counts, the bytes are not a C string
print order("", nul())
print order(nul(), "")
print order("a", "a" + nul() + "b")
print order("a" + nul() + "b", "a")
print order("a" + nul() + "b", "a" + nul() + "b")
print order("a" + nul() + "b", "a" + nul() + "c")
print pat(nul())
print pat("a" + nul())
print pat("")
print pat("a")
print count(nul() + nul())
