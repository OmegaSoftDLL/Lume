## expect: run 1101
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
type LL = enum LNil | LCons(L, LL)
fn f(own xs: L, p: LL) -> L = match p
    LNil => Nil
    LCons(xs, r) => (match xs
        Nil => Nil
        Cons(h, t) => Cons(h + 100, t))
fn run() -> int =
    let e = Cons(1, Nil) in
    let r = f(own Cons(5, Nil), LCons(e, LNil)) in
    peek(e) * 1000 + peek(r)
print run()
