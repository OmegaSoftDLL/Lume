## expect: run 203
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
type R = record a: L, b: L
fn run() -> int = let r = R{a: Cons(1, Nil), b: Cons(2, Nil)} in let c = bump(own r.a) in let d = bump(own r.b) in peek(c) + peek(d)
print run()
