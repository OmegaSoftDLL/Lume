## expect: reject O0001
type M = enum Last(int) | More(int, M)
fn bump(own x: M) -> M = match x
    Last(h) => Last(h + 100)
    More(h, t) => More(h + 100, t)
fn sum(x: M) -> int = match x
    Last(h) => h + 0
    More(h, t) => h + sum(t)
fn run() -> int =
    let a = More(1, Last(2)) in
    let s = (match a
        Last(h) => Last(9)
        More(h, t) => t) in
    let c = bump(own s) in
    sum(a) * 1000 + sum(c)
print run()
