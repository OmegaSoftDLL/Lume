## expect: reject O0001
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn head(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h
fn take(own xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => let n = head(own_id(own t)) in head(xs)
fn own_id(own x: L) -> L = x
print take(Cons(1, Nil))
