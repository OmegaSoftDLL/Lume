## expect: run 6
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn head(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h
fn run() -> int = let a = Cons(1, Cons(2, Nil)) in let c = bump(own a) in head(c) - 95
print run()
