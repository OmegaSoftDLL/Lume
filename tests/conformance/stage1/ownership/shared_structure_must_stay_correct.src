## expect: run 1
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn head(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h
fn twice(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, twice(own t))
fn mk(t: L) -> L = Cons(5, t)
fn run() -> int = let t = Cons(1, Nil) in let a = keep2(mk(t)) in let c = twice(own a) in head(t)
fn keep2(x: L) -> L = x
print run()
