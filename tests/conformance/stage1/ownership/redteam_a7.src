## expect: run 1101
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
fn stash(s, x: L) -> int = let z = s.set(x) in 0
fn run() -> int = let s = signal(Nil) in let a = Cons(1, Nil) in let n = stash(s, a) in let c = bump(own a) in peek(s.get()) * 1000 + peek(c)
print run()
