## expect: run 6
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
type R = record n: int, l: L
fn eat(own r: R) -> int = 1
fn run() -> int = let r = R{n: 5, l: Nil} in let h = r.n in let e = eat(own r) in h + e
print run()
