## expect: reject O0013
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
type P = enum Pa(L, L)
fn run() -> P = let a = Cons(1, Nil) in Pa(a, bump(own a))
print 1
