## expect: run 3
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
fn run() -> int = let a = Cons(1, Nil) in let c = bump(own a) in let f = fn(a) => a + 1 in f(2)
print run()
