## expect: reject O0001
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
type W = enum Wrap(L)
fn un(w: W) -> L = match w
    Wrap(x) => x
fn run() -> int = let a = Cons(1, Nil) in let s = (let z = Wrap(a) in z) in let c = bump(own a) in peek(un(s))
print run()
