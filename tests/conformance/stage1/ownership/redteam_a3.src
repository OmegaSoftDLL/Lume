## expect: reject O0013
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
fn f(ys: L, own xs: L) -> int = let r = bump(own xs) in peek(r) * 1000 + peek(ys)
fn run() -> int = let a = Cons(1, Nil) in f(a, own a)
print run()
