## expect: run 1101
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
fn f(own xs: L) -> int =
    let g = fn(k) => peek(xs) + k in
    let n = (match xs
        Nil => Nil
        Cons(h, t) => Cons(h + 100, t)) in
    g(0) * 1000 + peek(n)
print f(own Cons(1, Nil))
