## expect: run 1
type L = enum Nil | Cons(int, L)
fn head(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h
fn keep(x: L) -> L = x
fn g(own x: L) = let k = keep(x) in let m = (match x
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)) in {a: head(k), b: head(m)}
fn run() -> int = let r = g(own Cons(1, Nil)) in r.a
print run()
