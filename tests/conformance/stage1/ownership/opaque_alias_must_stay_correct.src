## expect: run 1
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn head(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h
fn keep(x: L) -> L = x
fn run() -> int = let a = Cons(1, Nil) in let b = keep(a) in let c = bump(own a) in head(b)
print run()
