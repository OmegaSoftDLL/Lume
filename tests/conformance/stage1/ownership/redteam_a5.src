## expect: reject O0001
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
fn mk() -> L = Cons(7, Nil)
fn run(p: int) -> int = let a = Cons(1, Nil) in let b = if p == 0 then a else (let z = bump(own a) in mk()) in peek(a) * 1000 + peek(b)
print run(1)
