## expect: run 1101
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
fn app(f, x) = f(x)
fn run() -> int = let a = Cons(1, Nil) in let c = app(bump, a) in peek(a) * 1000 + peek(c)
print run()
