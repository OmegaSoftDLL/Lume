## expect: run 101
type L = enum Nil | Cons(int, L)
fn head(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h
fn keep(x: L) -> L = x
fn g(own x: L, c: int) -> L = if c == 1 then keep(x) else match x
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn run() -> int = head(g(own Cons(1, Nil), 0))
print run()
