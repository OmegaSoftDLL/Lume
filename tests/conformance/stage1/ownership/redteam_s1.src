## expect: reject O0002
type L = enum Nil | Cons(int, L)
fn bump(own xs: L) -> L = match xs
    Nil => Nil
    Cons(h, t) => Cons(h + 100, t)
fn peek(xs: L) -> int = match xs
    Nil => 0
    Cons(h, t) => h + 0
type I = record b: L
type R = record a: I
fn f(r: R) -> int = let c = bump(own r.a.b) in let d = bump(own r.a.b) in peek(c) + peek(d)
print f(R{a: I{b: Cons(1, Nil)}})
