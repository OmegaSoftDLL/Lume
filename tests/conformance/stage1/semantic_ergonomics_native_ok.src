## Native-only ergonomics gate (Stage-0 has no string interpolation and models `[...]` as arrays).
## 1. Multi-line nested `match` in an arm, on the same line as `=>`
## 2. Brace and `then`-less `if` (F4 surface)
## 3. String braces: JSON survives, `\{` and `\}` never open or close a hole, `\$` is a literal dollar before a hole
## 4. List literals are Cons chains; `count` measures them
## 5. Structural equality runs in constant native stack on any shape
## 6. `not` binds looser than comparison and tighter than `and`
## 7. Escapes decode to the real control bytes

fn second_or_first(xs) = match xs
    Nil => 0
    Cons(a, t) => match t
        Nil => a
        Cons(b, u) => b

fn sibling_after_nested(x, y) = match x
    0 => match y
        0 => 1
        _ => 2
    1 => 3
    _ => 4

fn brace_if(x) = if x > 0 { 1 } else { 2 }

fn strings() =
    let x = 7 in
    let json = "{\"a\":{\"b\":1}}" in
    let a = "\{x}" in
    let b = "{\{x}" in
    let c = "{x\}" in
    let d = "{{x}}" in
    let e = "cost: \${x}" in
    json + "|" + a + "|" + b + "|" + c + "|" + d + "|" + e

fn head_or(xs, d) = match xs
    Nil => d
    Cons(h, t) => h

fn deep_rec(n, acc) = if n <= 0 then acc else deep_rec(n - 1, {next: acc})
fn deep_left(n, acc) = if n <= 0 then acc else deep_left(n - 1, Cons(acc, 0))
fn deep_list(n, acc) = if n <= 0 then acc else deep_list(n - 1, Cons(n, acc))

fn deep_eq() =
    let r1 = if deep_rec(1000000, 0) == deep_rec(1000000, 0) then 1 else 0 in
    let r2 = if deep_rec(1000000, 0) == deep_rec(1000000, 1) then 1 else 0 in
    let l1 = if deep_left(1000000, Nil) == deep_left(1000000, Nil) then 1 else 0 in
    let l2 = if deep_list(1000000, Nil) == deep_list(1000000, Cons(0, Nil)) then 1 else 0 in
    r1 * 1000 + r2 * 100 + l1 * 10 + l2

fn mixed_shapes() =
    let a = if Node(Node(1, 2), {k: Node(3, 4)}, 5) == Node(Node(1, 2), {k: Node(3, 4)}, 5) then 1 else 0 in
    let b = if Node(Node(1, 2), {k: Node(3, 9)}, 5) == Node(Node(1, 2), {k: Node(3, 4)}, 5) then 1 else 0 in
    a * 10 + b

print(second_or_first(Cons(1, Cons(2, Nil))) + second_or_first(Cons(5, Nil)) * 10)
print(sibling_after_nested(0, 1) * 100 + sibling_after_nested(1, 0) * 10 + sibling_after_nested(2, 0))
print(brace_if(1) * 10 + brace_if(0))
print(strings())
print(count([]) + count([1]) * 10 + count([1, 2, 3]) * 100)
print(head_or([9, 8], 0) + head_or([], 5) * 10)
print(if [1, 2] == Cons(1, Cons(2, Nil)) then 1 else 0)
print(deep_eq())
print(mixed_shapes())
print(if not 1 == 2 and not (2 < 1) then 1 else 0)
print(if "\b" == chr(8) and "\f" == chr(12) and count("\b\f") == 2 then 1 else 0)
