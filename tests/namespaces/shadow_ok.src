## shadow_ok.src -- a name bound locally (let, a lambda parameter) stays local even when two imported modules both
## define a function of that name (ns_left and ns_right both define ajuda)
use ns_left
use ns_right

fn local_let() = let ajuda = 5 in ajuda + 1
fn local_lam() = (fn(ajuda) => ajuda * 2)(4)
fn local_param(ajuda) = ajuda + 100
fn test_local_names_win() = local_let() == 6 and local_lam() == 8 and local_param(1) == 101 and ns_left.ajuda(1) == 2
