## localcall_ok.src -- a call through a parameter is never checked against a global function of the same name in
## another module (LumeDesk report, 2026-11-19)
use m2
use m1
fn test_parameter_call() = name_of(fn(k) => k + "!") == "A!"
fn test_global_call() = env(1, "x") == "1x"
fn test_let_bound_call() = let env = fn(s) => s + "?" in env("B") == "B?"
