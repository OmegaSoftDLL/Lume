## same_seg_ok.src -- two modules with the same file name in different folders: `use a/m` is written m, `use b/m as mb`
## is written mb; the names both define (f, tag) stay apart
use same_seg/a/m
use same_seg/b/m as mb
fn test_same_file_name_in_two_folders() = m.f(1) == 2 and mb.g(1) == 3 and mb.f(1, 2) == 3
fn test_shared_names_stay_apart() = m.tag() == "a" and mb.tag() == "b"
