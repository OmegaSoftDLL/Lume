## namespaces_ok.src -- module namespaces: one name in several modules (each module keeps its own), `use X as Y` with
## `Y.NAME`, `module.NAME`, and record fields that share a name with a function.
use ns_left
use ns_right
use ns_json as j
use sub/ns_deep

fn ajuda(x) = x - 1
fn test_each_module_keeps_its_own() = soma_left(1) == 2 and soma_right(1) == 10 and ajuda(1) == 0
fn test_qualified_by_module_name() = ns_left.ajuda(1) == 2 and ns_right.ajuda(1) == 10
fn test_alias() = j.ler("abc") == 3 and j.ajuda(1) == 101
fn test_module_in_a_folder() = ns_deep.ajuda(1) == 1001 and ns_deep.fundo(1) == 2002 and ajuda(1) == 0
fn test_record_field_not_renamed() = let r = {ajuda: 5} in r.ajuda == 5 and j.chave({ajuda: 7}) == 7

print j.ler("abcd") + ns_right.ajuda(2)
