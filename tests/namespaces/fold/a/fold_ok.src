## One file reached by two spellings (../c/c here, ../b/../c/c through b) is one module and keeps its own
## imports (regression of 45d381b reported by the LumeDesk developer: d1 was undefined in the second spelling).
use ../c/c
use ../b/b
fn test_two_spellings_keep_imports() = b.b1(1) == 14 and c.c1(1) == 4
