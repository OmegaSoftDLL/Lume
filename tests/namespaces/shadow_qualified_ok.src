## shadow_qualified_ok.src -- `M.name(...)` always means the function of module M, even where a local binding of the
## same name is in scope (LumeDesk repro35): a let, a lambda parameter, a function parameter, a unique name (ns_left's
## soma_left) and a name two modules define (ajuda, in ns_left and ns_json), with 0, 1 and 2 arguments around.
use ns_left
use ns_json

fn by_let() = let ajuda = {k: 1} in ns_left.ajuda(1) == 2 and ns_json.ajuda(1) == 101 and ajuda.k == 1
fn by_param(soma_left) = ns_left.soma_left(4) == 5 and soma_left == 9
fn by_lambda() = (fn(ler) => ns_json.ler("abc") == 3 and ler == 7)(7)
fn nested() = let ajuda = 0 in ns_left.ajuda(ns_json.ajuda(ns_left.ajuda(1))) == 103 and ajuda == 0

fn test_let_does_not_capture_the_call() = by_let()
fn test_param_does_not_capture_the_call() = by_param(9)
fn test_lambda_param_does_not_capture_the_call() = by_lambda()
fn test_nested_calls() = nested()
