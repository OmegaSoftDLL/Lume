## The prover knows the contracts of a few builtins (docs/LUME_REFERENCE_EN.md, "Builtin contracts"): each function
## below is proved by `lume prove`, not left runtime_checked. `lume test` runs the same functions.

## buf_bits_write answers p + n or -1. The bounds in `requires` matter: without them the clause itself could trap
## (p + n overflowing int), and the prover only proves clauses that cannot trap
fn put_bits(b: buf, p: int, v: int, n: int) -> int
    requires p >= 0 and p <= 1000000000 and n >= 0 and n <= 32
    ensures result == p + n or result == 0 - 1
    = buf_bits_write(b, p, v, n)

## after the -1 check the new position is exactly p + n
fn put_checked(b: buf, p: int, v: int, n: int) -> int
    requires p >= 0 and p <= 1000000000 and n >= 0 and n <= 32
    ensures result == p + n or result == 0 - 2
    = let q = buf_bits_write(b, p, v, n) in if q < 0 then 0 - 2 else q

## a byte read is 0..255 (an index outside the buffer stops the program)
fn byte_plus(b: buf, i: int) -> int
    ensures result >= 1 and result <= 256
    = let v = buf_get(b, i) in v + 1

## the contract applies to a builtin call named with `let` or returned directly
fn size_plus(b: buf) -> int
    ensures result >= 1
    = let n = buf_len(b) in n + 1

fn test_put_bits() = let b = buf_new(8) in put_bits(b, 0, 5, 3) == 3 and put_checked(b, 3, 1, 1) == 4
fn test_byte() = let b = buf_new(4) in byte_plus(b, 2) == 1 and size_plus(b) == 5
