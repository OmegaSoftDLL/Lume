## prove_spans_ok.src -- the diagnostics of `lume prove` name the real file, line and column (reported by the LumeDesk
## developer: a T2001 warning on an untyped law pointed at "module.src", a line past the end of the file).
use hostio

fn ps_run(name, text) = let src = "build/ps_" + name + ".src" in let out = "build/ps_" + name + ".out" in let w = fs_write_sync(src, text) in let r = hio_osrun_ct(hio_lume_cmd("."), Cons("prove", Cons(src, Nil)), out, out + ".err", 600000) in let t = fs_read_file(out) in let c1 = fs_remove(out) in let c2 = fs_remove(out + ".err") in let c3 = fs_remove(src) in t
fn ps_has_at(s, p, i) = if i + count(p) > count(s) then 0 else if slice(s, i, i + count(p)) == p then 1 else ps_has_at(s, p, i + 1)
fn ps_has(s, p) = ps_has_at(s, p, 0) == 1

fn test_untyped_law_warning_points_at_the_law() = let t = ps_run("untyped", "fn um() = 1\n\nlaw l(x) = if x >= 0 and x <= 5 then x + 1 >= 1 else 1 == 1\n\nfn test_um() = um() == 1\n") in ps_has(t, "\"file\":\"build/ps_untyped.src\",\"line\":3,\"col\":17") and ps_has(t, "\"line\":3,\"col\":28") and ps_has(t, "\"line\":3,\"col\":40") and ps_has(t, "module.src") == 0
