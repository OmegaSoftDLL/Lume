fn ae_contains_at(s, part, i) = if i + count(part) > count(s) then 0 else if slice(s, i, i + count(part)) == part then 1 else ae_contains_at(s, part, i + 1)
fn ae_contains(s, part) = ae_contains_at(s, part, 0)
fn ae_case(root, name, call) = let base = root + "/build/arena-effect-" + name in let input = base + ".src" in let output = base + ".s" in let errors = base + ".err" in let prefix = if name == "wrapper" then "fn wrapper(n) = __lume_arena_new(n)\n" else "" in let source = prefix + "pub fn rejected() -> int / pure = " + call + "\nprint rejected()\n" in let written = fs_write_sync(input, source) in if written != 1 then "cannot write fixture: " + name else let status = os_run_input_capture_timeout(root + "/build/bin/lumec", Nil, input, output, errors, 120000) in if status == 0 then "pure function accepted allocation: " + name else if ae_contains(fs_read_file(errors), "[E0200]") == 0 then "missing effect diagnostic: " + name + " " + fs_read_file(errors) else if count(fs_read_file(output)) != 0 then "rejected program produced assembly: " + name else ""
fn ae_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else ae_line_end(s, i + 1)
fn ae_dispatch(s) = if count(s) < 6 or slice(s, 0, 6) != "@root " then ctfail("arena effect gate requires @root\n") else let root = slice(s, 6, ae_line_end(s, 0)) in let first = ae_case(root, "new", "__lume_arena_new(4096)") in if first != "" then ctfail(first + "\n") else let second = ae_case(root, "alloc", "__lume_arena_alloc(0, 8)") in if second != "" then ctfail(second + "\n") else let third = ae_case(root, "wrapper", "wrapper(4096)") in if third != "" then ctfail(third + "\n") else "arena allocation effects rejected in pure functions"
print ae_dispatch(readall())
