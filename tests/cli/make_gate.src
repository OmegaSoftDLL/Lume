fn mg_expected(root) = let top = root + "/compiler/stage1/" in let dir = top + "lume/" in fs_read_file(dir + "01_lexer.src") + fs_read_file(dir + "02_parser.src") + fs_read_file(dir + "03_comptime.src") + fs_read_file(dir + "04_parser_decls.src") + fs_read_file(top + "runtime_core.lume") + fs_read_file(dir + "05_codegen.src") + fs_read_file(dir + "06_typecheck.src") + fs_read_file(top + "own_flow.src") + fs_read_file(top + "name_flow.src") + fs_read_file(dir + "06b_phase3.src") + fs_read_file(dir + "06c_phase4.src") + fs_read_file(dir + "06d_phase5.src") + fs_read_file(dir + "07_driver.src")

fn mg_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else mg_line_end(text, i + 1)

fn mg_first_difference(actual, expected, i) = if i >= count(actual) or i >= count(expected) or at(actual, i) != at(expected, i) then i else mg_first_difference(actual, expected, i + 1)

fn mg_byte_at(text, i) = if i >= count(text) then 0 - 1 else ord(at(text, i))

fn mg_mismatch(actual, expected) = let i = mg_first_difference(actual, expected, 0) in "native amalgamate output differs: actual bytes " + str(count(actual)) + ", expected bytes " + str(count(expected)) + ", first difference " + str(i) + ", actual byte " + str(mg_byte_at(actual, i)) + ", expected byte " + str(mg_byte_at(expected, i))

fn mg_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, mg_line_end(input, 0))

fn mg_seed(root) = let output = root + "/build/lume-make-seed-gate.out" in let errors = root + "/build/lume-make-seed-gate.err" in let status = os_run_capture_timeout(root + "/build/bin/lume_make", Cons("seed", Nil), output, errors, 120000) in if status != 0 then "native seed command failed with native status " + str(status) + "\nstdout:\n" + fs_read_file(output) + "\nstderr:\n" + fs_read_file(errors) else if fs_read_file(output) != "frozen seed built\n" then "native seed command returned unexpected output\n" + fs_read_file(output) else ""

fn mg_test(root) = let output = root + "/build/lume-make-test-gate.out" in let errors = root + "/build/lume-make-test-gate.err" in let status = os_run_capture_timeout(root + "/build/bin/lume_make", Cons("test", Nil), output, errors, 900000) in if status != 0 then "native test command failed with native status " + str(status) + "\nstdout:\n" + fs_read_file(output) + "\nstderr:\n" + fs_read_file(errors) else ""

fn mg_bootstrap_check(root) = let bdir = root + "/build/bootstrap/" in let need_run = if fs_path_exists(bdir + "lumec2") == 1 and fs_path_exists(bdir + "lumec3") == 1 and fs_path_exists(bdir + "lasm2") == 1 and fs_path_exists(bdir + "lasm3") == 1 and fs_path_exists(bdir + "lcli2") == 1 and fs_path_exists(bdir + "lcli3") == 1 then 0 else 1 in let boot_st = if need_run == 1 then os_run_capture_timeout(root + "/build/bin/lume_make", Cons("bootstrap", Nil), root + "/build/lume-make-boot-gate.out", root + "/build/lume-make-boot-gate.err", 1800000) else 0 in if boot_st != 0 then "native bootstrap command failed with status " + str(boot_st) else if fs_files_equal(bdir + "lumec2", bdir + "lumec3") != 1 or fs_files_equal(bdir + "lasm2", bdir + "lasm3") != 1 or fs_files_equal(bdir + "lcli2", bdir + "lcli3") != 1 then "native bootstrap fixpoint mismatch (stage2 != stage3)" else ""

fn mg_main(root) = let seeded = mg_seed(root) in if seeded != "" then seeded else let output = root + "/build/lume-make-gate.out" in let errors = root + "/build/lume-make-gate.err" in let status = os_run_capture_timeout(root + "/build/bin/lume_make", Cons("amalgamate", Nil), output, errors, 900000) in if status != 0 then "native amalgamate command failed with native status " + str(status) + "\nstdout:\n" + fs_read_file(output) + "\nstderr:\n" + fs_read_file(errors) else let actual = fs_read_file(root + "/compiler/stage1/lumec.src") in let expected = mg_expected(root) in if actual != expected then mg_mismatch(actual, expected) else let tested = mg_test(root) in if tested != "" then tested else mg_bootstrap_check(root)

fn mg_dispatch(input) = let root = mg_root(input) in if root == "" then ctfail("native make gate requires @root\n") else let problem = mg_main(root) in if problem != "" then ctfail("native make gate failed: " + problem + "\n") else "native lume_make seed build passed and amalgamate reproduced the exact compiler source"

print mg_dispatch(readall())
