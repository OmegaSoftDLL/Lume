fn dg_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128

fn dg_run(root, args, name) = let output = root + "/build/cli-" + name + ".out" in let errors = root + "/build/cli-" + name + ".err" in let status = os_run_capture_timeout(root + "/build/bin/lume_driver", args, output, errors, 120000) in {status: dg_wait_exit(status), output: fs_read_file(output), errors: fs_read_file(errors)}

fn dg_exact(root, name, args, expected) = let result = dg_run(root, args, name) in if result.status != 0 then name + " failed with status " + str(result.status) + "\nstdout:\n" + result.output + "\nstderr:\n" + result.errors else if result.output != expected then name + " output mismatch: " + result.output else ""

fn dg_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else dg_contains_at(text, part, i + 1)

fn dg_contains(text, part) = dg_contains_at(text, part, 0)

fn dg_part(root, name, args, expected) = let result = dg_run(root, args, name) in if result.status != 0 then name + " failed with status " + str(result.status) + "\nstdout:\n" + result.output + "\nstderr:\n" + result.errors else if dg_contains(result.output, expected) == 0 then name + " is missing expected output: " + expected else ""

fn dg_build(root) = let source = root + "/build/cli_fib.src" in let binary = root + "/build/cli_fib" in let written = fs_write_sync(source, "fn fib(n: int) -> int = if n < 2 then n else fib(n - 1) + fib(n - 2)\nprint fib(10)\n") in if written != 1 then "cannot write native build fixture" else let built = dg_run(root, Cons("build", Cons(source, Cons("-o", Cons(binary, Nil)))), "build") in if built.status != 0 then "native build failed: " + built.errors else if built.output != "" then "native build produced unexpected stdout: " + built.output else let output = root + "/build/cli-fib-run.out" in let errors = root + "/build/cli-fib-run.err" in let executed = os_run_capture_timeout(binary, Nil, output, errors, 10000) in if executed != 0 then "native built program failed: " + fs_read_file(errors) else if fs_read_file(output) != "55\n" then "native built program output mismatch" else let missing = dg_run(root, Cons("build", Cons(root + "/build/definitely-missing.src", Cons("-o", Cons(root + "/build/missing-output", Nil)))), "build-missing") in if missing.status == 0 then "native build accepted a missing source" else ""

fn dg_import_build(root) = let base = root + "/build/cli_base.src" in let base_written = fs_write_sync(base, "fn inc(x: int) -> int = x + 1\n") in let math = root + "/build/cli_math.src" in let math_written = fs_write_sync(math, "use cli_base\nfn answer() -> int = inc(41)\n") in let source = root + "/build/cli_import.src" in let source_written = fs_write_sync(source, "use cli_math\nprint answer()\n") in let binary = root + "/build/cli-import" in if base_written != 1 or math_written != 1 or source_written != 1 then "cannot write transitive import fixtures" else let built = dg_run(root, Cons("build", Cons(source, Cons("-o", Cons(binary, Nil)))), "build-import") in if built.status != 0 then "transitive native bundling failed: " + built.errors else let output = root + "/build/cli-import-run.out" in let errors = root + "/build/cli-import-run.err" in let executed = os_run_capture_timeout(binary, Nil, output, errors, 10000) in if executed != 0 then "transitively bundled program failed: " + fs_read_file(errors) else if fs_read_file(output) != "42\n" then "transitively bundled program output mismatch" else let missing = root + "/build/cli_missing_module.src" in let missing_written = fs_write_sync(missing, "use definitely_missing\nprint 0\n") in let rejected = dg_run(root, Cons("build", Cons(missing, Cons("-o", Cons(root + "/build/cli-missing-module", Nil)))), "build-missing-module") in if rejected.status == 0 then "native bundling accepted a missing module" else ""

fn dg_run_cli(root) = let source = root + "/build/cli_args.src" in let written = fs_write_sync(source, "print os_arg_at(1)\n") in if written != 1 then "cannot write native run fixture" else let args = dg_exact(root, "run-args", Cons("run", Cons(source, Cons("with space", Nil))), "with space\n") in if args != "" then args else let trap = root + "/build/cli_exit.src" in let trap_written = fs_write_sync(trap, "os_exit(7)\n") in let result = dg_run(root, Cons("run", Cons(trap, Nil)), "run-exit") in if result.status != 7 then "native run did not preserve exit code 7: " + str(result.status) else ""

fn dg_target_fixture(root) = fs_write_sync(root + "/build/cli_target.src", "fn scale(x: int) -> int requires x >= 1 ensures result >= 2 = x + x\nprint scale(21)\n")

fn dg_target_pe(root) = let source = root + "/build/cli_target.src" in let out = root + "/build/cli-target.exe" in let result = dg_run(root, Cons("build", Cons("--target", Cons("x86_64-windows-pe", Cons(source, Cons("-o", Cons(out, Nil)))))), "target-pe") in if result.status != 0 or result.output != "" then "native PE target build failed: " + result.errors else if fs_read_byte(out, 0) != 77 or fs_read_byte(out, 1) != 90 or fs_read_byte(out, 64) != 80 or fs_read_byte(out, 65) != 69 then "native PE target artifact has an invalid header" else ""

fn dg_target_lumb(root) = let source = root + "/build/cli_target.src" in let out = root + "/build/cli-target.lumb" in let result = dg_run(root, Cons("build", Cons(source, Cons("-o", Cons(out, Nil)))), "target-lumb") in if result.status != 0 or result.output != "" then "native inferred LUMB target build failed: " + result.errors else if fs_read_byte(out, 0) != 76 or fs_read_byte(out, 1) != 85 or fs_read_byte(out, 2) != 77 or fs_read_byte(out, 3) != 66 or fs_read_byte(out, 4) != 1 then "native LUMB target artifact has an invalid header" else ""

fn dg_target_ihex(root) = let source = root + "/build/cli_target.src" in let out = root + "/build/cli-target.hex" in let result = dg_run(root, Cons("build", Cons("--target=x86_64-none-ihex", Cons(source, Cons("-o", Cons(out, Nil))))), "target-ihex") in if result.status != 0 or result.output != "" then "native Intel HEX target build failed: " + result.errors else if slice(fs_read_file(out), 0, 15) != ":020000040001F9" then "native Intel HEX target artifact has an invalid extended-address record" else ""

fn dg_target_ptx(root) = let source = root + "/build/cli_target_ptx.src" in let out = root + "/build/cli-target.ptx" in let fixture = fs_write_sync(source, "@schedule(tile: 64) kernel fn scale(x: int) -> int / gpu requires x >= 1 ensures result >= 2 = x + x\n") in let result = dg_run(root, Cons("build", Cons(source, Cons("-o", Cons(out, Nil)))), "target-ptx") in if fixture != 1 then "cannot write native PTX target fixture" else if result.status != 0 or result.output != "" then "native inferred PTX target build failed: " + result.errors else if dg_contains(fs_read_file(out), "ld.param.s64") == 0 then "native PTX target artifact is missing parameter loading" else ""

fn dg_target_invalid(root) = let source = root + "/build/cli_target.src" in let out = root + "/build/cli-target-invalid.bin" in let result = dg_run(root, Cons("build", Cons("--target", Cons("mips64-unknown-coff", Cons(source, Cons("-o", Cons(out, Nil)))))), "target-invalid") in if result.status == 0 then "native build accepted an invalid target" else if fs_path_exists(out) == 1 then "native invalid target left an artifact" else ""

fn dg_target_build(root) = let fixture = dg_target_fixture(root) in if fixture != 1 then "cannot write native target fixture" else let pe = dg_target_pe(root) in if pe != "" then pe else let lumb = dg_target_lumb(root) in if lumb != "" then lumb else let ihex = dg_target_ihex(root) in if ihex != "" then ihex else let ptx = dg_target_ptx(root) in if ptx != "" then ptx else dg_target_invalid(root)

fn dg_intent(root) = let source = root + "/examples/intent/verified_specs.intent" in let cache = root + "/build/cli_intent.cache.src" in let built = dg_part(root, "intent-build", Cons("intent", Cons("build", Cons(source, Cons("--cache", Cons(cache, Nil))))), "\"ok\":true") in if built != "" then built else let verified = dg_part(root, "intent-verify", Cons("intent", Cons("verify", Cons(source, Cons("--cache", Cons(cache, Nil))))), "\"cache_valid\":true") in if verified != "" then verified else let tampered = fs_write_sync(cache, fs_read_file(cache) + "fn extra() = 0\n") in if tampered != 1 then "cannot tamper native intent cache" else let rejected = dg_run(root, Cons("intent", Cons("verify", Cons(source, Cons("--cache", Cons(cache, Nil))))), "intent-tampered") in if rejected.status == 0 then "native intent accepted a tampered cache" else if dg_contains(rejected.errors, "\"cache_tampered\":true") == 0 then "native intent cache-tamper diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("intent", Cons("build", Cons(root + "/build/definitely-missing.intent", Nil))), "intent-missing") in if missing.status == 0 then "native intent accepted a missing specification" else ""

fn dg_compile(root) = let source = root + "/build/cli_compile.src" in let written = fs_write_sync(source, "print 40 + 2\n") in if written != 1 then "cannot write native compile fixture" else let json = dg_part(root, "compile-json", Cons("compile", Cons("--json", Cons(source, Nil))), "\"ok\":true") in if json != "" then json else let executed = dg_part(root, "compile-run", Cons("compile", Cons("--run", Cons("--json", Cons(source, Nil)))), "\"ran\":true,\"run_exit\":0,\"stdout\":\"42\"") in if executed != "" then executed else let assembly = dg_run(root, Cons("compile", Cons(source, Nil)), "compile-assembly") in if assembly.status != 0 or dg_contains(assembly.output, ".text") == 0 or dg_contains(assembly.errors, "lume compile: " + source + " OK (") == 0 then "native compile assembly or success diagnostic mismatch: " + assembly.errors else let trapped_source = root + "/build/cli_compile_exit.src" in let trapped_written = fs_write_sync(trapped_source, "os_exit(7)\n") in if trapped_written != 1 then "cannot write native compile exit fixture" else let trapped = dg_run(root, Cons("compile", Cons("--json", Cons("--run", Cons(trapped_source, Nil)))), "compile-run-exit") in if trapped.status != 0 or dg_contains(trapped.output, "\"ok\":true,\"exit\":0") == 0 or dg_contains(trapped.output, "\"run_exit\":7") == 0 then "native compile did not separate compiler and program exit statuses: " + trapped.output + trapped.errors else let invalid = root + "/build/cli_compile_invalid.src" in let invalid_written = fs_write_sync(invalid, "fn broken(\n") in if invalid_written != 1 then "cannot write invalid native compile fixture" else let rejected = dg_run(root, Cons("compile", Cons("--json", Cons(invalid, Nil))), "compile-invalid") in if rejected.status == 0 then "native compile accepted invalid source" else if dg_contains(rejected.output, "\"ok\":false") == 0 then "native compile invalid-source diagnostic mismatch: " + rejected.output + rejected.errors else let missing = dg_run(root, Cons("compile", Cons(root + "/build/definitely-missing-compile.src", Nil)), "compile-missing") in if missing.status == 0 then "native compile accepted a missing source" else ""

fn dg_agent_mode(root, source, mode, expected) = dg_part(root, "agent-" + mode, Cons("agent", Cons(mode, Cons(source, Nil))), expected)

fn dg_agent(root) = let source = root + "/build/cli_agent.src" in let written = fs_write_sync(source, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\nprint clamp(5)\n") in if written != 1 then "cannot write native agent fixture" else let ast = dg_agent_mode(root, source, "ast", "\"ok\":true") in if ast != "" then ast else let expanded = dg_agent_mode(root, source, "expand", "\"expanded\":") in if expanded != "" then expanded else let evaluated = dg_agent_mode(root, source, "eval", "\"result\":\"5\"") in if evaluated != "" then evaluated else let grammar = dg_agent_mode(root, source, "grammar", "\"mode\":\"grammar\"") in if grammar != "" then grammar else let project = dg_agent_mode(root, source, "project", "\"roundtrip_ast_equal\":true") in if project != "" then project else let hashes = dg_agent_mode(root, source, "hashes", "\"definition_count\":1") in if hashes != "" then hashes else let witness = dg_agent_mode(root, source, "witness", "\"mode\":\"witness\"") in if witness != "" then witness else let repair = dg_agent_mode(root, source, "repair", "\"mode\":\"repair\"") in if repair != "" then repair else let impact = dg_agent_mode(root, source, "impact", "\"mode\":\"impact\"") in if impact != "" then impact else let invalid = root + "/build/cli_agent_invalid.src" in let invalid_written = fs_write_sync(invalid, "fn broken(\n") in if invalid_written != 1 then "cannot write invalid native agent fixture" else let rejected = dg_run(root, Cons("agent", Cons("check", Cons(invalid, Nil))), "agent-invalid") in if rejected.status == 0 then "native agent accepted invalid source" else if rejected.errors == "" then "native agent failure omitted diagnostics" else let missing = dg_run(root, Cons("agent", Cons("check", Cons(root + "/build/definitely-missing-agent.src", Nil))), "agent-missing") in if missing.status == 0 then "native agent accepted a missing source" else ""

fn dg_certify(root) = let source = root + "/build/cli_certify.src" in let written = fs_write_sync(source, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\n") in if written != 1 then "cannot write native certify fixture" else let result = dg_run(root, Cons("certify", Cons(source, Nil)), "certify-valid") in if result.status != 0 then "certify-valid failed with status " + str(result.status) + "\nstdout:\n" + result.output + "\nstderr:\n" + result.errors else if dg_contains(result.output, "\"ok\":true") == 0 then "certify-valid is missing expected output" else let cert = root + "/build/cli_certificate.json" in let saved = fs_write_sync(cert, result.output) in if saved != 1 then "cannot save native certificate" else let verified = dg_part(root, "verify-cert-valid", Cons("verify-cert", Cons(cert, Nil)), "\"kernel_verified\":true") in if verified != "" then verified else let tampered = fs_write_sync(cert, "{}") in if tampered != 1 then "cannot write invalid native certificate" else let rejected = dg_run(root, Cons("verify-cert", Cons(cert, Nil)), "verify-cert-invalid") in if rejected.status == 0 then "native verify-cert accepted an invalid artifact" else if dg_contains(rejected.errors, "\"ok\":false") == 0 then "native verify-cert invalid-artifact diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("certify", Cons(root + "/build/definitely-missing-certify.src", Nil)), "certify-missing") in if missing.status == 0 then "native certify accepted a missing source" else ""

fn dg_check(root) = let source = root + "/build/cli_check.src" in let written = fs_write_sync(source, "fn add(a: int, b: int) -> int = a + b\n") in if written != 1 then "cannot write native check fixture" else let result = dg_run(root, Cons("check", Cons(source, Nil)), "check-valid") in if result.status != 0 or result.output != "" or result.errors != source + ": OK (Lume-Core parsed and checked)\n" then "native check success output mismatch:\n" + result.output + result.errors else let json = dg_run(root, Cons("check", Cons("--json", Cons(source, Nil))), "check-json") in if json.status != 0 or json.output != "" or json.errors != "" then "native check --json was not silent" else let invalid = root + "/build/cli_check_invalid.src" in let invalid_written = fs_write_sync(invalid, "fn broken(\n") in if invalid_written != 1 then "cannot write invalid native check fixture" else let rejected = dg_run(root, Cons("check", Cons(invalid, Nil)), "check-invalid") in if rejected.status == 0 then "native check accepted invalid source" else if rejected.errors == "" then "native check failure omitted diagnostics" else let missing = dg_run(root, Cons("check", Cons(root + "/build/definitely-missing-check.src", Nil)), "check-missing") in if missing.status == 0 then "native check accepted a missing source" else ""

fn dg_fmt(root) = let source = root + "/build/cli_format.src" in let raw = "print 2+3\n" in let canonical = "print 2 + 3\n" in let written = fs_write_sync(source, raw) in if written != 1 then "cannot write native fmt fixture" else let stdout = dg_exact(root, "fmt-stdout", Cons("fmt", Cons("--stdout", Cons(source, Nil))), canonical) in if stdout != "" then stdout else let rewritten = dg_run(root, Cons("fmt", Cons(source, Nil)), "fmt-rewrite") in if rewritten.status != 0 or rewritten.output != "" or fs_read_file(source) != canonical then "native fmt rewrite failed: " + rewritten.errors else let checked = dg_exact(root, "fmt-check", Cons("fmt", Cons(source, Cons("--check", Nil))), "") in if checked != "" then checked else let reset = fs_write_sync(source, raw) in if reset != 1 then "cannot reset native fmt fixture" else let rejected = dg_run(root, Cons("fmt", Cons("--check", Cons(source, Nil))), "fmt-check-fail") in if rejected.status != 1 then "native fmt check did not return exit 1: " + str(rejected.status) else if rejected.errors != "lume fmt: " + source + " is not canonically formatted\n" or fs_read_file(source) != raw then "native fmt check failure changed diagnostics or source" else let missing = dg_run(root, Cons("fmt", Cons(root + "/build/definitely-missing-fmt.src", Nil)), "fmt-missing") in if missing.status == 0 then "native fmt accepted a missing source" else ""

fn dg_pkg(root) = let dir = root + "/build/cli_pkg" in let made = fs_mkdir(dir) in let manifest = dir + "/lume.toml" in let written = fs_write_sync(manifest, "[package]\nname = \"demo\"\nversion = \"0.1.0\"\nedition = \"2026\"\n[capabilities]\nallow = [\"pure\"]\n") in if made != 1 or written != 1 then "cannot write native pkg fixture" else let checked = dg_exact(root, "pkg-check", Cons("pkg", Cons("check", Cons(dir, Nil))), "{\"name\":\"demo\",\"version\":\"0.1.0\",\"edition\":\"2026\",\"capabilities\":\"pure\"}\n") in if checked != "" then checked else let aliased = dg_exact(root, "pkg-manifest", Cons("pkg", Cons("manifest", Cons(dir, Nil))), "{\"name\":\"demo\",\"version\":\"0.1.0\",\"edition\":\"2026\",\"capabilities\":\"pure\"}\n") in if aliased != "" then aliased else let invalid = fs_write_sync(manifest, "[package]\nname = \"demo\"\nedition = \"2026\"\n") in if invalid != 1 then "cannot write invalid native pkg fixture" else let rejected = dg_run(root, Cons("pkg", Cons("check", Cons(dir, Nil))), "pkg-invalid") in if rejected.status == 0 then "native pkg accepted a manifest without version" else if dg_contains(rejected.errors, "missing 'version'") == 0 then "native pkg missing-version diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("pkg", Cons("check", Cons(root + "/build/definitely-missing-pkg", Nil))), "pkg-missing") in if missing.status == 0 then "native pkg accepted a missing manifest" else ""

fn dg_doc(root) = let source = root + "/build/cli_doc.src" in let written = fs_write_sync(source, "## Adds one.\nfn inc(x: int) -> int = x + 1\n") in if written != 1 then "cannot write native doc fixture" else let markdown = dg_exact(root, "doc-markdown", Cons("doc", Cons(source, Nil)), "## `fn inc(x: int) -> int`\n\nAdds one.\n") in if markdown != "" then markdown else let json = dg_exact(root, "doc-json", Cons("doc", Cons("--json", Cons(source, Nil))), "{\"module_doc\":\"\",\"items\":[{\"kind\":\"fn\",\"name\":\"inc\",\"signature\":\"fn inc(x: int) -> int\",\"doc\":\"Adds one.\",\"contracts\":[]}]}\n") in if json != "" then json else let missing = dg_run(root, Cons("doc", Cons(root + "/build/definitely-missing-doc.src", Nil)), "doc-missing") in if missing.status == 0 then "native doc accepted a missing source" else ""

fn dg_prove(root) = let source = root + "/build/cli_prove.src" in let written = fs_write_sync(source, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\n") in if written != 1 then "cannot write native prove fixture" else let passed = dg_part(root, "prove-valid", Cons("prove", Cons(source, Nil)), "\"ok\":true") in if passed != "" then passed else let proven = dg_part(root, "prove-status", Cons("prove", Cons(source, Nil)), "\"status\":\"proven\"") in if proven != "" then proven else let invalid = root + "/build/cli_prove_refuted.src" in let invalid_written = fs_write_sync(invalid, "fn bad(x: int) -> int ensures result > x = x\n") in if invalid_written != 1 then "cannot write refuted native prove fixture" else let rejected = dg_run(root, Cons("prove", Cons(invalid, Nil)), "prove-refuted") in if rejected.status == 0 then "native prove accepted a refuted contract" else if dg_contains(rejected.errors, "\"ok\":false") == 0 or dg_contains(rejected.errors, "V0001") == 0 then "native prove refutation diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("prove", Cons(root + "/build/definitely-missing-prove.src", Nil)), "prove-missing") in if missing.status == 0 then "native prove accepted a missing source" else ""

fn dg_adapt(root) = let header = root + "/build/cli_adapter.h" in let written = fs_write_sync(header, "int64_t add(int64_t a, int64_t b);\n") in if written != 1 then "cannot write native adapter fixture" else let json = dg_part(root, "adapt-json", Cons("adapt", Cons("c", Cons("--json", Cons(header, Nil)))), "\"ok\":true") in if json != "" then json else let source = dg_part(root, "adapt-source", Cons("adapt", Cons("c", Cons(header, Nil))), "foreign_add") in if source != "" then source else let out = root + "/build/cli_adapter_generated.src" in let written_out = dg_run(root, Cons("adapt", Cons("c", Cons(header, Cons("-o", Cons(out, Nil))))), "adapt-output") in if written_out.status != 0 then "native adapt output failed: " + written_out.errors else if dg_contains(fs_read_file(out), "foreign_add") == 0 then "native adapt output file is incomplete" else let invalid = root + "/build/cli_adapter_invalid.h" in let invalid_written = fs_write_sync(invalid, "int64_t bad(\n") in if invalid_written != 1 then "cannot write invalid adapter fixture" else let rejected = dg_run(root, Cons("adapt", Cons("c", Cons(invalid, Nil))), "adapt-invalid") in if rejected.status == 0 then "native adapt accepted an invalid header" else if dg_contains(rejected.errors, "I0003") == 0 then "native adapt invalid-header diagnostic mismatch: " + rejected.errors else let exclusive = dg_run(root, Cons("adapt", Cons("c", Cons("--json", Cons(header, Cons("-o", Cons(out, Nil)))))), "adapt-exclusive") in if exclusive.status == 0 then "native adapt accepted --json with --output" else ""

fn dg_mesh(root) = let fixture = root + "/tests/conformance/stage1/semantic_mesh/" in let negotiated = dg_part(root, "mesh-negotiate", Cons("mesh", Cons(fixture + "negotiate.mesh", Nil)), "\"protocol\":\"lume-semantic-intent/0.1\"") in if negotiated != "" then negotiated else let transacted = dg_part(root, "mesh-transact", Cons("mesh", Cons("--json", Cons(fixture + "transact.mesh", Nil))), "\"mode\":\"transact\"") in if transacted != "" then transacted else let rejected = dg_run(root, Cons("mesh", Cons(fixture + "unknown_operation.mesh", Nil)), "mesh-invalid") in if rejected.status == 0 then "native mesh accepted an unknown operation" else if dg_contains(rejected.errors, "\"ok\":false") == 0 then "native mesh invalid-operation diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("mesh", Cons(root + "/build/definitely-missing.mesh", Nil)), "mesh-missing") in if missing.status == 0 then "native mesh accepted a missing request" else ""

fn dg_test(root) = let base = root + "/build/cli_test_base.src" in let base_written = fs_write_sync(base, "fn test_answer() = 42\n") in let source = root + "/build/cli_tests_pass.src" in let written = fs_write_sync(source, "use cli_test_base\nfn test_alpha() = test_answer() == 42\nfn test_beta() = 2 + 3 == 5\nprint 999\n") in if base_written != 1 or written != 1 then "cannot write native test fixtures" else let passed = dg_exact(root, "test-pass", Cons("test", Cons(source, Nil)), "  ok   test_answer\n  ok   test_alpha\n  ok   test_beta\n3 passed, 0 failed\n") in if passed != "" then passed else let failing = root + "/build/cli_tests_fail.src" in let failing_written = fs_write_sync(failing, "fn test_failure() = 0\n") in if failing_written != 1 then "cannot write failing native test fixture" else let rejected = dg_run(root, Cons("test", Cons(failing, Nil)), "test-fail") in if rejected.status != 3 then "native test failure did not return exit 3: " + str(rejected.status) else if rejected.output != "  FAIL test_failure\n0 passed, 1 failed\n" or rejected.errors != "lume test: failed\n" then "native test failure output mismatch:\n" + rejected.output + rejected.errors else let missing = dg_run(root, Cons("test", Cons(root + "/build/definitely-missing-tests.src", Nil)), "test-missing") in if missing.status == 0 then "native test accepted a missing source" else ""

fn dg_run_long(root, args, name) = let output = root + "/build/cli-" + name + ".out" in let errors = root + "/build/cli-" + name + ".err" in let status = os_run_capture_timeout(root + "/build/bin/lume_driver", args, output, errors, 900000) in {status: dg_wait_exit(status), output: fs_read_file(output), errors: fs_read_file(errors)}

fn dg_economy(root) = let out = root + "/build/cli-economy-results.json" in let artifacts = root + "/build/cli-economy-artifacts" in let result = dg_run_long(root, Cons("economy", Cons("--output", Cons(out, Cons("--artifacts", Cons(artifacts, Cons("--self-test", Nil)))))), "economy-real") in if result.status != 0 then "native economy failed: " + result.errors else if dg_contains(result.output, "\"schema\": \"lume-economic-benchmark/0.1\"") == 0 then "native economy summary schema mismatch: " + result.output else let report = fs_read_file(out) in if dg_contains(report, "\"tasks_total\": 6") == 0 or dg_contains(report, "\"outcome\": \"PASS\"") == 0 then "native economy report is incomplete" else let missing = dg_run(root, Cons("economy", Nil), "economy-missing-output") in if missing.status == 0 then "native economy accepted a missing --output" else ""

fn dg_evolve(root) = let goals = dg_part(root, "evolve-goals", Cons("evolve", Cons("goals", Nil)), "G1_CORRECTNESS") in if goals != "" then goals else let budgets = dg_part(root, "evolve-budgets", Cons("evolve", Cons("budgets", Nil)), "std_module: max_asm_lines=120 capability=pure") in if budgets != "" then budgets else let verified = dg_part(root, "evolve-verify", Cons("evolve", Cons("verify", Nil)), "\"gates_ok\":true") in if verified != "" then verified else let approved = dg_part(root, "evolve-approve", Cons("evolve", Cons("approve", Nil)), "\"can_merge\":true") in if approved != "" then approved else let unsigned = dg_run(root, Cons("evolve", Cons("approve", Nil)), "evolve-approve-unsigned") in if unsigned.status == 0 then "native evolve accepted an unsigned proposal" else let missing = dg_run(root, Cons("evolve", Cons("verify", Cons(root + "/build/definitely-missing-proposal.bundle", Nil))), "evolve-missing") in if missing.status == 0 then "native evolve accepted a missing proposal" else ""

fn dg_unknown(root) = let result = dg_run(root, Cons("not-a-command", Nil), "unknown") in if result.status == 0 then "unknown command unexpectedly succeeded" else ""

fn dg_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else dg_line_end(text, i + 1)

fn dg_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, dg_line_end(input, 0))

fn dg_main(root) = let version = dg_exact(root, "version", Cons("--version", Nil), "lume 0.2.0 (edition 2026)\n") in if version != "" then version else let help = dg_part(root, "help", Cons("--help", Nil), "lume build [--target <triple>]") in if help != "" then help else let description = dg_part(root, "describe", Cons("describe", Nil), "\"stage\": \"self-hosted (lumec + lasm + lcli)\"") in if description != "" then description else let targets = dg_part(root, "targets", Cons("targets", Nil), "x86_64-windows-pe") in if targets != "" then targets else let built = dg_build(root) in if built != "" then built else let imports = dg_import_build(root) in if imports != "" then imports else let ran = dg_run_cli(root) in if ran != "" then ran else let targeted = dg_target_build(root) in if targeted != "" then targeted else let tested = dg_test(root) in if tested != "" then tested else let intended = dg_intent(root) in if intended != "" then intended else let compiled = dg_compile(root) in if compiled != "" then compiled else let agented = dg_agent(root) in if agented != "" then agented else let certified = dg_certify(root) in if certified != "" then certified else let checked = dg_check(root) in if checked != "" then checked else let formatted = dg_fmt(root) in if formatted != "" then formatted else let packaged = dg_pkg(root) in if packaged != "" then packaged else let documented = dg_doc(root) in if documented != "" then documented else let proved = dg_prove(root) in if proved != "" then proved else let adapted = dg_adapt(root) in if adapted != "" then adapted else let meshed = dg_mesh(root) in if meshed != "" then meshed else let economic = dg_economy(root) in if economic != "" then economic else let evolved = dg_evolve(root) in if evolved != "" then evolved else dg_unknown(root)

fn dg_dispatch(input) = let root = dg_root(input) in if root == "" then ctfail("native driver gate requires @root\n") else let problem = dg_main(root) in if problem != "" then ctfail("native driver gate failed: " + problem + "\n") else "native driver version, help, describe, targets, build, transitive bundling, run, argv, exit-code, test discovery, test failure, intent cache proofs, tamper rejection, real economic benchmark, and rejection checks passed"

print dg_dispatch(readall())
