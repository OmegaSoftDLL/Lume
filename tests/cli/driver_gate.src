use fs_sha256_file

fn dg_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128

fn dg_run(root, args, name) = let output = root + "/build/cli-" + name + ".out" in let errors = root + "/build/cli-" + name + ".err" in let status = os_run_capture_timeout(root + "/build/bin/lume_driver", args, output, errors, 120000) in {status: dg_wait_exit(status), output: fs_read_file(output), errors: fs_read_file(errors)}

fn dg_exact(root, name, args, expected) = let result = dg_run(root, args, name) in if result.status != 0 then name + " failed with status " + str(result.status) + "\nstdout:\n" + result.output + "\nstderr:\n" + result.errors else if result.output != expected then name + " output mismatch: " + result.output else ""

fn dg_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else dg_contains_at(text, part, i + 1)

fn dg_contains(text, part) = dg_contains_at(text, part, 0)

fn dg_part(root, name, args, expected) = let result = dg_run(root, args, name) in if result.status != 0 then name + " failed with status " + str(result.status) + "\nstdout:\n" + result.output + "\nstderr:\n" + result.errors else if dg_contains(result.output, expected) == 0 then name + " is missing expected output: " + expected else ""

fn dg_build(root) = let source = root + "/build/cli_fib.src" in let binary = root + "/build/cli_fib" in let written = fs_write_sync(source, "fn fib(n: int) -> int = if n < 2 then n else fib(n - 1) + fib(n - 2)\nprint fib(10)\n") in if written != 1 then "cannot write native build fixture" else let built = dg_run(root, Cons("build", Cons(source, Cons("-o", Cons(binary, Nil)))), "build") in if built.status != 0 then "native build failed: " + built.errors else if built.output != "" then "native build produced unexpected stdout: " + built.output else let output = root + "/build/cli-fib-run.out" in let errors = root + "/build/cli-fib-run.err" in let executed = os_run_capture_timeout(binary, Nil, output, errors, 10000) in if executed != 0 then "native built program failed: " + fs_read_file(errors) else if fs_read_file(output) != "55\n" then "native built program output mismatch" else let missing = dg_run(root, Cons("build", Cons(root + "/build/definitely-missing.src", Cons("-o", Cons(root + "/build/missing-output", Nil)))), "build-missing") in if missing.status == 0 then "native build accepted a missing source" else ""

fn dg_import_build(root) = let base = root + "/build/cli_base.src" in let base_written = fs_write_sync(base, "fn inc(x: int) -> int = x + 1\n") in let math = root + "/build/cli_math.src" in let math_written = fs_write_sync(math, "use cli_base\nfn answer() -> int = inc(41)\n") in let source = root + "/build/cli_import.src" in let source_written = fs_write_sync(source, "use cli_math\nprint answer()\n") in let binary = root + "/build/cli-import" in if base_written != 1 or math_written != 1 or source_written != 1 then "cannot write transitive import fixtures" else let built = dg_run(root, Cons("build", Cons(source, Cons("-o", Cons(binary, Nil)))), "build-import") in if built.status != 0 then "transitive native bundling failed: " + built.errors else let output = root + "/build/cli-import-run.out" in let errors = root + "/build/cli-import-run.err" in let executed = os_run_capture_timeout(binary, Nil, output, errors, 10000) in if executed != 0 then "transitively bundled program failed: " + fs_read_file(errors) else if fs_read_file(output) != "42\n" then "transitively bundled program output mismatch" else let missing = root + "/build/cli_missing_module.src" in let missing_written = fs_write_sync(missing, "use definitely_missing\nprint 0\n") in let rejected = dg_run(root, Cons("build", Cons(missing, Cons("-o", Cons(root + "/build/cli-missing-module", Nil)))), "build-missing-module") in if rejected.status == 0 then "native bundling accepted a missing module" else ""

fn dg_run_cli(root) = let source = root + "/build/cli_args.src" in let written = fs_write_sync(source, "print os_arg_at(1)\n") in if written != 1 then "cannot write native run fixture" else let args = dg_exact(root, "run-args", Cons("run", Cons(source, Cons("with space", Nil))), "with space\n") in if args != "" then args else let trap = root + "/build/cli_exit.src" in let trap_written = fs_write_sync(trap, "os_exit(7)\n") in let result = dg_run(root, Cons("run", Cons(trap, Nil)), "run-exit") in if result.status != 7 then "native run did not preserve exit code 7: " + str(result.status) else ""

fn dg_target_fixture(root) = fs_write_sync(root + "/build/cli_target.src", "fn scale(x: int) -> int requires x >= 1 ensures result >= 2 = x + x\nprint scale(21)\n")

fn dg_target_pe(root) = let source = root + "/build/cli_target.src" in let out = root + "/build/cli-target.exe" in let result = dg_run(root, Cons("build", Cons("--target", Cons("x86_64-windows-pe", Cons(source, Cons("-o", Cons(out, Nil)))))), "target-pe") in if result.status != 0 or result.output != "" then "native PE target build failed: " + result.errors else if fs_read_byte(out, 0) != 77 or fs_read_byte(out, 1) != 90 or fs_read_byte(out, 64) != 80 or fs_read_byte(out, 65) != 69 then "native PE target artifact has an invalid header" else ""

fn dg_target_lumb(root) = let source = root + "/build/cli_target.src" in let out = root + "/build/cli-target.lumb" in let result = dg_run(root, Cons("build", Cons(source, Cons("-o", Cons(out, Nil)))), "target-lumb") in if result.status != 0 or result.output != "" then "native inferred LUMB target build failed: " + result.errors else if fs_read_byte(out, 0) != 76 or fs_read_byte(out, 1) != 85 or fs_read_byte(out, 2) != 77 or fs_read_byte(out, 3) != 66 or fs_read_byte(out, 4) != 1 then "native LUMB target artifact has an invalid header" else ""

fn dg_target_ihex(root) = let source = root + "/build/cli_target.src" in let out = root + "/build/cli-target.hex" in let result = dg_run(root, Cons("build", Cons("--target=x86_64-none-ihex", Cons(source, Cons("-o", Cons(out, Nil))))), "target-ihex") in if result.status != 0 or result.output != "" then "native Intel HEX target build failed: " + result.errors else if slice(fs_read_file(out), 0, 15) != ":020000040001F9" then "native Intel HEX target artifact has an invalid extended-address record" else ""

fn dg_target_ptx(root) = let source = root + "/build/cli_target_ptx.src" in let out = root + "/build/cli-target.ptx" in let fixture = fs_write_sync(source, "@schedule(tile: 64) kernel fn scale(x: int) -> int / gpu requires x >= 1 ensures result >= 2 = x + x\n") in let result = dg_run(root, Cons("build", Cons(source, Cons("-o", Cons(out, Nil)))), "target-ptx") in if fixture != 1 then "cannot write native PTX target fixture" else if result.status != 0 or result.output != "" then "native inferred PTX target build failed: " + result.errors else if dg_contains(fs_read_file(out), "ld.param.s64") == 0 then "native PTX target artifact is missing parameter loading" else ""

fn dg_target_invalid(root) = let source = root + "/build/cli_target.src" in let out = root + "/build/cli-target-invalid.bin" in let result = dg_run(root, Cons("build", Cons("--target", Cons("mips64-unknown-coff", Cons(source, Cons("-o", Cons(out, Nil)))))), "target-invalid") in if result.status == 0 then "native build accepted an invalid target" else if fs_path_exists(out) == 1 then "native invalid target left an artifact" else ""

fn dg_target_build(root) = let fixture = dg_target_fixture(root) in if fixture != 1 then "cannot write native target fixture" else let pe = dg_target_pe(root) in if pe != "" then pe else let lumb = dg_target_lumb(root) in if lumb != "" then lumb else let ihex = dg_target_ihex(root) in if ihex != "" then ihex else let ptx = dg_target_ptx(root) in if ptx != "" then ptx else dg_target_invalid(root)

fn dg_intent(root) = let source = root + "/examples/intent/verified_specs.intent" in let cache = root + "/build/cli_intent.cache.src" in let built = dg_part(root, "intent-build", Cons("intent", Cons("build", Cons(source, Cons("--cache", Cons(cache, Nil))))), "\"ok\":true") in if built != "" then built else let verified = dg_part(root, "intent-verify", Cons("intent", Cons("verify", Cons(source, Cons("--cache", Cons(cache, Nil))))), "\"cache_valid\":true") in if verified != "" then verified else let tampered = fs_write_sync(cache, fs_read_file(cache) + "fn extra() = 0\n") in if tampered != 1 then "cannot tamper native intent cache" else let rejected = dg_run(root, Cons("intent", Cons("verify", Cons(source, Cons("--cache", Cons(cache, Nil))))), "intent-tampered") in if rejected.status == 0 then "native intent accepted a tampered cache" else if dg_contains(rejected.errors, "\"cache_tampered\":true") == 0 then "native intent cache-tamper diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("intent", Cons("build", Cons(root + "/build/definitely-missing.intent", Nil))), "intent-missing") in if missing.status == 0 then "native intent accepted a missing specification" else ""

fn dg_compile(root) = let source = root + "/build/cli_compile.src" in let written = fs_write_sync(source, "print 40 + 2\n") in if written != 1 then "cannot write native compile fixture" else let json = dg_part(root, "compile-json", Cons("compile", Cons("--json", Cons(source, Nil))), "\"ok\":true") in if json != "" then json else let executed = dg_part(root, "compile-run", Cons("compile", Cons("--run", Cons("--json", Cons(source, Nil)))), "\"ran\":true,\"run_exit\":0,\"stdout\":\"42\"") in if executed != "" then executed else let assembly = dg_run(root, Cons("compile", Cons(source, Nil)), "compile-assembly") in if assembly.status != 0 or dg_contains(assembly.output, ".text") == 0 or dg_contains(assembly.errors, "lume compile: " + source + " OK (") == 0 then "native compile assembly or success diagnostic mismatch: " + assembly.errors else let trapped_source = root + "/build/cli_compile_exit.src" in let trapped_written = fs_write_sync(trapped_source, "os_exit(7)\n") in if trapped_written != 1 then "cannot write native compile exit fixture" else let trapped = dg_run(root, Cons("compile", Cons("--json", Cons("--run", Cons(trapped_source, Nil)))), "compile-run-exit") in if trapped.status != 0 or dg_contains(trapped.output, "\"ok\":true,\"exit\":0") == 0 or dg_contains(trapped.output, "\"run_exit\":7") == 0 then "native compile did not separate compiler and program exit statuses: " + trapped.output + trapped.errors else let invalid = root + "/build/cli_compile_invalid.src" in let invalid_written = fs_write_sync(invalid, "fn broken(\n") in if invalid_written != 1 then "cannot write invalid native compile fixture" else let rejected = dg_run(root, Cons("compile", Cons("--json", Cons(invalid, Nil))), "compile-invalid") in if rejected.status == 0 then "native compile accepted invalid source" else if dg_contains(rejected.output, "\"ok\":false") == 0 then "native compile invalid-source diagnostic mismatch: " + rejected.output + rejected.errors else let missing = dg_run(root, Cons("compile", Cons(root + "/build/definitely-missing-compile.src", Nil)), "compile-missing") in if missing.status == 0 then "native compile accepted a missing source" else ""

fn dg_agent_mode(root, source, mode, expected) = dg_part(root, "agent-" + mode, Cons("agent", Cons(mode, Cons(source, Nil))), expected)

fn dg_agent(root) = let source = root + "/build/cli_agent.src" in let written = fs_write_sync(source, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\nprint clamp(5)\n") in if written != 1 then "cannot write native agent fixture" else let ast = dg_agent_mode(root, source, "ast", "\"ok\":true") in if ast != "" then ast else let expanded = dg_agent_mode(root, source, "expand", "\"expanded\":") in if expanded != "" then expanded else let evaluated = dg_agent_mode(root, source, "eval", "\"result\":\"5\"") in if evaluated != "" then evaluated else let grammar = dg_agent_mode(root, source, "grammar", "\"mode\":\"grammar\"") in if grammar != "" then grammar else let project = dg_agent_mode(root, source, "project", "\"roundtrip_ast_equal\":true") in if project != "" then project else let hashes = dg_agent_mode(root, source, "hashes", "\"definition_count\":1") in if hashes != "" then hashes else let witness = dg_agent_mode(root, source, "witness", "\"mode\":\"witness\"") in if witness != "" then witness else let repair = dg_agent_mode(root, source, "repair", "\"mode\":\"repair\"") in if repair != "" then repair else let impact = dg_agent_mode(root, source, "impact", "\"mode\":\"impact\"") in if impact != "" then impact else let invalid = root + "/build/cli_agent_invalid.src" in let invalid_written = fs_write_sync(invalid, "fn broken(\n") in if invalid_written != 1 then "cannot write invalid native agent fixture" else let rejected = dg_run(root, Cons("agent", Cons("check", Cons(invalid, Nil))), "agent-invalid") in if rejected.status == 0 then "native agent accepted invalid source" else if rejected.errors == "" then "native agent failure omitted diagnostics" else let missing = dg_run(root, Cons("agent", Cons("check", Cons(root + "/build/definitely-missing-agent.src", Nil))), "agent-missing") in if missing.status == 0 then "native agent accepted a missing source" else ""

fn dg_protocol(root) = let source = root + "/build/cli_protocol.src" in let written = fs_write_sync(source, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\nprint clamp(5)\n") in if written != 1 then "cannot write native protocol fixture" else let lsp = dg_part(root, "lsp-json", Cons("lsp", Cons("--json", Cons(source, Nil))), "\"protocol\":\"lsp/3.17\"") in if lsp != "" then lsp else let symbols = dg_part(root, "lsp-symbols", Cons("lsp", Cons(source, Nil)), "\"name\":\"clamp\"") in if symbols != "" then symbols else let dap = dg_part(root, "dap-json", Cons("dap", Cons("--json", Cons(source, Nil))), "\"protocol\":\"dap/1.65\"") in if dap != "" then dap else let output = dg_part(root, "dap-output", Cons("dap", Cons(source, Nil)), "\"output\":\"5\"") in if output != "" then output else let invalid = root + "/build/cli_protocol_invalid.src" in let invalid_written = fs_write_sync(invalid, "fn broken(\n") in if invalid_written != 1 then "cannot write invalid native protocol fixture" else let lsp_invalid = dg_part(root, "lsp-invalid", Cons("lsp", Cons("--json", Cons(invalid, Nil))), "\"code\":\"P0001\"") in if lsp_invalid != "" then lsp_invalid else let dap_invalid = dg_part(root, "dap-invalid", Cons("dap", Cons("--json", Cons(invalid, Nil))), "\"success\":false") in if dap_invalid != "" then dap_invalid else let repl = dg_part(root, "repl-json", Cons("repl", Cons("--json", Cons(source, Nil))), "\"protocol\":\"lume-repl/1.0\"") in if repl != "" then repl else let repl_output = dg_part(root, "repl-output", Cons("repl", Cons("--json", Cons(source, Nil))), "\"text/plain\":\"5\"") in if repl_output != "" then repl_output else let repl_invalid = dg_part(root, "repl-invalid", Cons("repl", Cons("--json", Cons(invalid, Nil))), "\"ok\":false") in if repl_invalid != "" then repl_invalid else let repl_missing = dg_run(root, Cons("repl", Cons("--json", Cons(root + "/build/definitely-missing-repl.src", Nil))), "repl-missing") in if repl_missing.status == 0 then "native repl accepted a missing source" else let lsp_missing = dg_run(root, Cons("lsp", Cons("--json", Cons(root + "/build/definitely-missing-lsp.src", Nil))), "lsp-missing") in if lsp_missing.status == 0 then "native lsp accepted a missing source" else let dap_missing = dg_run(root, Cons("dap", Cons("--json", Cons(root + "/build/definitely-missing-dap.src", Nil))), "dap-missing") in if dap_missing.status == 0 then "native dap accepted a missing source" else ""

fn dg_agent_advanced(root) = let source = root + "/build/cli_agent_advanced.src" in let written = fs_write_sync(source, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\nprint clamp(5)\n") in if written != 1 then "cannot write advanced agent fixture" else let kernel_source = root + "/build/cli_agent_kernel.src" in let kernel_written = fs_write_sync(kernel_source, "kernel fn scale(x: int) -> int / gpu requires x >= 0 ensures result >= 0 = x + x\nprint scale(3)\n") in if kernel_written != 1 then "cannot write native kernel fixture" else let kernel = dg_part(root, "agent-kernel", Cons("agent", Cons("kernel", Cons(kernel_source, Nil))), "\"gpu_emu_verified\":true") in if kernel != "" then kernel else let export_source = root + "/build/cli_agent_export.src" in let export_written = fs_write_sync(export_source, "pub extern \"c\" fn add(a: int, b: int) -> int = a + b\n") in if export_written != 1 then "cannot write native C-export fixture" else let exported = dg_part(root, "agent-c-export", Cons("agent", Cons("c-export", Cons(export_source, Nil))), "\"mode\":\"c-export\"") in if exported != "" then exported else let replay = dg_part(root, "agent-replay", Cons("agent", Cons("replay", Cons(source, Nil))), "\"replay_verified\":true") in if replay != "" then replay else let lineage = dg_part(root, "agent-lineage", Cons("agent", Cons("lineage", Cons(source, Cons("clamp", Nil)))), "\"mode\":\"lineage\"") in if lineage != "" then lineage else let patched = dg_part(root, "agent-patch", Cons("agent", Cons("patch", Cons(source, Cons("clamp", Cons("x + 1", Nil))))), "\"mode\":\"patch\"") in if patched != "" then patched else let stronger = root + "/build/cli_agent_stronger.src" in let stronger_written = fs_write_sync(stronger, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 1 = x + 1\n") in let shared = root + "/build/cli_agent_shared.src" in let shared_written = fs_write_sync(shared, "fn helper(z: int) -> int requires z >= 0 ensures result >= 0 = z\n") in if stronger_written != 1 or shared_written != 1 then "cannot write check-rot fixtures" else let rot = dg_part(root, "agent-check-rot", Cons("agent", Cons("check-rot", Cons(source, Cons(stronger, Cons(shared, Nil))))), "\"rot_detected\":false") in if rot != "" then rot else let invalid_patch = dg_run(root, Cons("agent", Cons("patch", Cons(source, Cons("missing_fn", Cons("0", Nil))))), "agent-patch-invalid") in if invalid_patch.status == 0 then "native agent accepted an invalid patch target" else if dg_contains(invalid_patch.errors, "\"code\":\"A0004\"") == 0 then "native agent invalid patch diagnostic mismatch: " + invalid_patch.output + invalid_patch.errors else let missing = dg_run(root, Cons("agent", Cons("kernel", Cons(root + "/build/definitely-missing-kernel.src", Nil))), "agent-kernel-missing") in if missing.status == 0 then "native agent accepted a missing kernel source" else ""



fn dg_certify(root) = let source = root + "/build/cli_certify.src" in let written = fs_write_sync(source, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\n") in if written != 1 then "cannot write native certify fixture" else let result = dg_run(root, Cons("certify", Cons(source, Nil)), "certify-valid") in if result.status != 0 then "certify-valid failed with status " + str(result.status) + "\nstdout:\n" + result.output + "\nstderr:\n" + result.errors else if dg_contains(result.output, "\"ok\":true") == 0 then "certify-valid is missing expected output" else let cert = root + "/build/cli_certificate.json" in let saved = fs_write_sync(cert, result.output) in if saved != 1 then "cannot save native certificate" else let verified = dg_part(root, "verify-cert-valid", Cons("verify-cert", Cons(cert, Nil)), "\"kernel_verified\":true") in if verified != "" then verified else let tampered = fs_write_sync(cert, "{}") in if tampered != 1 then "cannot write invalid native certificate" else let rejected = dg_run(root, Cons("verify-cert", Cons(cert, Nil)), "verify-cert-invalid") in if rejected.status == 0 then "native verify-cert accepted an invalid artifact" else if dg_contains(rejected.errors, "\"ok\":false") == 0 then "native verify-cert invalid-artifact diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("certify", Cons(root + "/build/definitely-missing-certify.src", Nil)), "certify-missing") in if missing.status == 0 then "native certify accepted a missing source" else ""

fn dg_check(root) = let source = root + "/build/cli_check.src" in let written = fs_write_sync(source, "fn add(a: int, b: int) -> int = a + b\n") in if written != 1 then "cannot write native check fixture" else let result = dg_run(root, Cons("check", Cons(source, Nil)), "check-valid") in if result.status != 0 or result.output != "" or result.errors != source + ": OK (Lume-Core parsed and checked)\n" then "native check success output mismatch:\n" + result.output + result.errors else let json = dg_run(root, Cons("check", Cons("--json", Cons(source, Nil))), "check-json") in if json.status != 0 or json.output != "" or json.errors != "" then "native check --json was not silent" else let invalid = root + "/build/cli_check_invalid.src" in let invalid_written = fs_write_sync(invalid, "fn broken(\n") in if invalid_written != 1 then "cannot write invalid native check fixture" else let rejected = dg_run(root, Cons("check", Cons(invalid, Nil)), "check-invalid") in if rejected.status == 0 then "native check accepted invalid source" else if rejected.errors == "" then "native check failure omitted diagnostics" else let missing = dg_run(root, Cons("check", Cons(root + "/build/definitely-missing-check.src", Nil)), "check-missing") in if missing.status == 0 then "native check accepted a missing source" else ""

fn dg_fmt(root) = let source = root + "/build/cli_format.src" in let raw = "print 2+3\n" in let canonical = "print 2 + 3\n" in let written = fs_write_sync(source, raw) in if written != 1 then "cannot write native fmt fixture" else let stdout = dg_exact(root, "fmt-stdout", Cons("fmt", Cons("--stdout", Cons(source, Nil))), canonical) in if stdout != "" then stdout else let rewritten = dg_run(root, Cons("fmt", Cons(source, Nil)), "fmt-rewrite") in if rewritten.status != 0 or rewritten.output != "" or fs_read_file(source) != canonical then "native fmt rewrite failed: " + rewritten.errors else let checked = dg_exact(root, "fmt-check", Cons("fmt", Cons(source, Cons("--check", Nil))), "") in if checked != "" then checked else let reset = fs_write_sync(source, raw) in if reset != 1 then "cannot reset native fmt fixture" else let rejected = dg_run(root, Cons("fmt", Cons("--check", Cons(source, Nil))), "fmt-check-fail") in if rejected.status != 1 then "native fmt check did not return exit 1: " + str(rejected.status) else if rejected.errors != "lume fmt: " + source + " is not canonically formatted\n" or fs_read_file(source) != raw then "native fmt check failure changed diagnostics or source" else let missing = dg_run(root, Cons("fmt", Cons(root + "/build/definitely-missing-fmt.src", Nil)), "fmt-missing") in if missing.status == 0 then "native fmt accepted a missing source" else ""

fn dg_pkg(root) = let dir = root + "/build/cli_pkg" in let made = fs_mkdir(dir) in let manifest = dir + "/lume.toml" in let written = fs_write_sync(manifest, "[package]\nname = \"demo\"\nversion = \"0.1.0\"\nedition = \"2026\"\n[capabilities]\nallow = [\"pure\"]\n") in if made != 1 or written != 1 then "cannot write native pkg fixture" else let checked = dg_exact(root, "pkg-check", Cons("pkg", Cons("check", Cons(dir, Nil))), "{\"name\":\"demo\",\"version\":\"0.1.0\",\"edition\":\"2026\",\"capabilities\":\"pure\"}\n") in if checked != "" then checked else let aliased = dg_exact(root, "pkg-manifest", Cons("pkg", Cons("manifest", Cons(dir, Nil))), "{\"name\":\"demo\",\"version\":\"0.1.0\",\"edition\":\"2026\",\"capabilities\":\"pure\"}\n") in if aliased != "" then aliased else let invalid = fs_write_sync(manifest, "[package]\nname = \"demo\"\nedition = \"2026\"\n") in if invalid != 1 then "cannot write invalid native pkg fixture" else let rejected = dg_run(root, Cons("pkg", Cons("check", Cons(dir, Nil))), "pkg-invalid") in if rejected.status == 0 then "native pkg accepted a manifest without version" else if dg_contains(rejected.errors, "missing 'version'") == 0 then "native pkg missing-version diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("pkg", Cons("check", Cons(root + "/build/definitely-missing-pkg", Nil))), "pkg-missing") in if missing.status == 0 then "native pkg accepted a missing manifest" else ""

fn dg_doc(root) = let source = root + "/build/cli_doc.src" in let written = fs_write_sync(source, "## Adds one.\nfn inc(x: int) -> int = x + 1\n") in if written != 1 then "cannot write native doc fixture" else let markdown = dg_exact(root, "doc-markdown", Cons("doc", Cons(source, Nil)), "## `fn inc(x: int) -> int`\n\nAdds one.\n") in if markdown != "" then markdown else let json = dg_exact(root, "doc-json", Cons("doc", Cons("--json", Cons(source, Nil))), "{\"module_doc\":\"\",\"items\":[{\"kind\":\"fn\",\"name\":\"inc\",\"signature\":\"fn inc(x: int) -> int\",\"doc\":\"Adds one.\",\"contracts\":[]}]}\n") in if json != "" then json else let missing = dg_run(root, Cons("doc", Cons(root + "/build/definitely-missing-doc.src", Nil)), "doc-missing") in if missing.status == 0 then "native doc accepted a missing source" else ""

fn dg_prove(root) = let source = root + "/build/cli_prove.src" in let written = fs_write_sync(source, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\n") in if written != 1 then "cannot write native prove fixture" else let passed = dg_part(root, "prove-valid", Cons("prove", Cons(source, Nil)), "\"ok\":true") in if passed != "" then passed else let proven = dg_part(root, "prove-status", Cons("prove", Cons(source, Nil)), "\"status\":\"proven\"") in if proven != "" then proven else let invalid = root + "/build/cli_prove_refuted.src" in let invalid_written = fs_write_sync(invalid, "fn bad(x: int) -> int ensures result > x = x\n") in if invalid_written != 1 then "cannot write refuted native prove fixture" else let rejected = dg_run(root, Cons("prove", Cons(invalid, Nil)), "prove-refuted") in if rejected.status == 0 then "native prove accepted a refuted contract" else if dg_contains(rejected.errors, "\"ok\":false") == 0 or dg_contains(rejected.errors, "V0001") == 0 then "native prove refutation diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("prove", Cons(root + "/build/definitely-missing-prove.src", Nil)), "prove-missing") in if missing.status == 0 then "native prove accepted a missing source" else ""

fn dg_proof_modes(root) = let source = root + "/build/cli_proof_modes.src" in let written = fs_write_sync(source, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\n") in let stronger = root + "/build/cli_proof_stronger.src" in let stronger_written = fs_write_sync(stronger, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 1 = x + 1\n") in if written != 1 or stronger_written != 1 then "cannot write native proof-mode fixtures" else let diff = dg_part(root, "proof-diff", Cons("prove", Cons("--diff", Cons(source, Cons(stronger, Nil)))), "\"mode\":\"proof-diff\"") in if diff != "" then diff else let strengthened = dg_part(root, "proof-diff-strengthened", Cons("prove", Cons(source, Cons(stronger, Cons("--diff", Nil)))), "\"status\":\"strengthened\"") in if strengthened != "" then strengthened else let shared = dg_part(root, "proof-share", Cons("prove", Cons("--share", Cons(source, Nil))), "\"share_uri\":\"lume://verify/sha256:") in if shared != "" then shared else let base = root + "/build/cli_proof_base.src" in let base_written = fs_write_sync(base, "fn base(x: int) -> int requires x >= 0 ensures result >= 0 = x\n") in let derived = root + "/build/cli_proof_derived.src" in let derived_written = fs_write_sync(derived, "fn derived(y: int) -> int requires y >= 0 ensures result >= 0 = base(y)\n") in if base_written != 1 or derived_written != 1 then "cannot write compositional proof fixtures" else let composed = dg_part(root, "proof-compose", Cons("prove", Cons("--compositional", Cons(base, Cons(derived, Nil)))), "\"compositional_verified\":true") in if composed != "" then composed else let weaker = root + "/build/cli_proof_weaker.src" in let weaker_written = fs_write_sync(weaker, "fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 - 1 = x\n") in if weaker_written != 1 then "cannot write weakened native proof fixture" else let weakened = dg_run(root, Cons("prove", Cons("--diff", Cons(source, Cons(weaker, Nil)))), "proof-diff-weakened") in if weakened.status == 0 then "native proof diff accepted a weakened contract" else if dg_contains(weakened.errors, "\"status\":\"regressed\"") == 0 or dg_contains(weakened.errors, "V0003") == 0 then "native proof diff weakening diagnostic mismatch: " + weakened.errors else let incomplete = dg_run(root, Cons("prove", Cons("--diff", Cons(source, Nil))), "proof-diff-incomplete") in if incomplete.status == 0 then "native proof diff accepted one source" else let missing = dg_run(root, Cons("prove", Cons("--diff", Cons(source, Cons(root + "/build/definitely-missing-proof.src", Nil)))), "proof-diff-missing") in if missing.status == 0 then "native proof diff accepted a missing source" else ""

fn dg_adapt(root) = let header = root + "/build/cli_adapter.h" in let written = fs_write_sync(header, "int64_t add(int64_t a, int64_t b);\n") in if written != 1 then "cannot write native adapter fixture" else let json = dg_part(root, "adapt-json", Cons("adapt", Cons("c", Cons("--json", Cons(header, Nil)))), "\"ok\":true") in if json != "" then json else let source = dg_part(root, "adapt-source", Cons("adapt", Cons("c", Cons(header, Nil))), "foreign_add") in if source != "" then source else let out = root + "/build/cli_adapter_generated.src" in let written_out = dg_run(root, Cons("adapt", Cons("c", Cons(header, Cons("-o", Cons(out, Nil))))), "adapt-output") in if written_out.status != 0 then "native adapt output failed: " + written_out.errors else if dg_contains(fs_read_file(out), "foreign_add") == 0 then "native adapt output file is incomplete" else let invalid = root + "/build/cli_adapter_invalid.h" in let invalid_written = fs_write_sync(invalid, "int64_t bad(\n") in if invalid_written != 1 then "cannot write invalid adapter fixture" else let rejected = dg_run(root, Cons("adapt", Cons("c", Cons(invalid, Nil))), "adapt-invalid") in if rejected.status == 0 then "native adapt accepted an invalid header" else if dg_contains(rejected.errors, "I0003") == 0 then "native adapt invalid-header diagnostic mismatch: " + rejected.errors else let exclusive = dg_run(root, Cons("adapt", Cons("c", Cons("--json", Cons(header, Cons("-o", Cons(out, Nil)))))), "adapt-exclusive") in if exclusive.status == 0 then "native adapt accepted --json with --output" else ""

fn dg_mesh(root) = let fixture = root + "/tests/conformance/stage1/semantic_mesh/" in let negotiated = dg_part(root, "mesh-negotiate", Cons("mesh", Cons(fixture + "negotiate.mesh", Nil)), "\"protocol\":\"lume-semantic-intent/0.1\"") in if negotiated != "" then negotiated else let transacted = dg_part(root, "mesh-transact", Cons("mesh", Cons("--json", Cons(fixture + "transact.mesh", Nil))), "\"mode\":\"transact\"") in if transacted != "" then transacted else let rejected = dg_run(root, Cons("mesh", Cons(fixture + "unknown_operation.mesh", Nil)), "mesh-invalid") in if rejected.status == 0 then "native mesh accepted an unknown operation" else if dg_contains(rejected.errors, "\"ok\":false") == 0 then "native mesh invalid-operation diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("mesh", Cons(root + "/build/definitely-missing.mesh", Nil)), "mesh-missing") in if missing.status == 0 then "native mesh accepted a missing request" else ""

fn dg_test(root) = let base = root + "/build/cli_test_base.src" in let base_written = fs_write_sync(base, "fn test_answer() = 42\n") in let source = root + "/build/cli_tests_pass.src" in let written = fs_write_sync(source, "use cli_test_base\nfn test_alpha() = test_answer() == 42\nfn test_beta() = 2 + 3 == 5\nprint 999\n") in if base_written != 1 or written != 1 then "cannot write native test fixtures" else let passed = dg_exact(root, "test-pass", Cons("test", Cons(source, Nil)), "  ok   test_answer\n  ok   test_alpha\n  ok   test_beta\n3 passed, 0 failed\n") in if passed != "" then passed else let failing = root + "/build/cli_tests_fail.src" in let failing_written = fs_write_sync(failing, "fn test_failure() = 0\n") in if failing_written != 1 then "cannot write failing native test fixture" else let rejected = dg_run(root, Cons("test", Cons(failing, Nil)), "test-fail") in if rejected.status != 3 then "native test failure did not return exit 3: " + str(rejected.status) else if rejected.output != "  FAIL test_failure\n0 passed, 1 failed\n" or rejected.errors != "lume test: failed\n" then "native test failure output mismatch:\n" + rejected.output + rejected.errors else let missing = dg_run(root, Cons("test", Cons(root + "/build/definitely-missing-tests.src", Nil)), "test-missing") in if missing.status == 0 then "native test accepted a missing source" else ""

fn dg_run_long(root, args, name) = let output = root + "/build/cli-" + name + ".out" in let errors = root + "/build/cli-" + name + ".err" in let status = os_run_capture_timeout(root + "/build/bin/lume_driver", args, output, errors, 900000) in {status: dg_wait_exit(status), output: fs_read_file(output), errors: fs_read_file(errors)}

fn dg_economy(root) = let out = root + "/build/cli-economy-results.json" in let artifacts = root + "/build/cli-economy-artifacts" in let result = dg_run_long(root, Cons("economy", Cons("--output", Cons(out, Cons("--artifacts", Cons(artifacts, Cons("--self-test", Nil)))))), "economy-real") in if result.status != 0 then "native economy failed: " + result.errors else if dg_contains(result.output, "\"schema\": \"lume-economic-benchmark/0.1\"") == 0 then "native economy summary schema mismatch: " + result.output else let report = fs_read_file(out) in if dg_contains(report, "\"tasks_total\": 6") == 0 or dg_contains(report, "\"outcome\": \"PASS\"") == 0 then "native economy report is incomplete" else let missing = dg_run(root, Cons("economy", Nil), "economy-missing-output") in if missing.status == 0 then "native economy accepted a missing --output" else ""

fn dg_evolve(root) = let raw_signature = fs_read_file(root + "/evolve/proposals/0001_math_clamp/approval.sig") in let signature = slice(raw_signature, 8, dg_line_end(raw_signature, 0)) in let goals = dg_part(root, "evolve-goals", Cons("evolve", Cons("goals", Nil)), "G1_CORRECTNESS") in if goals != "" then goals else let budgets = dg_part(root, "evolve-budgets", Cons("evolve", Cons("budgets", Nil)), "std_module: max_asm_lines=120 capability=pure") in if budgets != "" then budgets else let verified = dg_part(root, "evolve-verify", Cons("evolve", Cons("verify", Nil)), "\"gates_ok\":true") in if verified != "" then verified else let approved = dg_part(root, "evolve-approve", Cons("evolve", Cons("approve", Cons("--by", Cons("ricardo", Cons("--sig", Cons(signature, Nil)))))), "\"can_merge\":true") in if approved != "" then approved else let unsigned = dg_run(root, Cons("evolve", Cons("approve", Nil)), "evolve-approve-unsigned") in if unsigned.status == 0 then "native evolve accepted an unsigned proposal" else let missing = dg_run(root, Cons("evolve", Cons("verify", Cons(root + "/build/definitely-missing-proposal.bundle", Nil))), "evolve-missing") in if missing.status == 0 then "native evolve accepted a missing proposal" else ""

fn dg_unknown(root) = let result = dg_run(root, Cons("not-a-command", Nil), "unknown") in if result.status == 0 then "unknown command unexpectedly succeeded" else ""

fn dg_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else dg_line_end(text, i + 1)

fn dg_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, dg_line_end(input, 0))

fn dg_main(root) = let version = dg_exact(root, "version", Cons("--version", Nil), "lume 0.2.0 (edition 2026)\n") in if version != "" then version else let help = dg_part(root, "help", Cons("--help", Nil), "lume build [--target <triple>]") in if help != "" then help else let description = dg_part(root, "describe", Cons("describe", Nil), "\"stage\": \"self-hosted (lumec + lasm + lcli)\"") in if description != "" then description else let targets = dg_part(root, "targets", Cons("targets", Nil), "x86_64-windows-pe") in if targets != "" then targets else let built = dg_build(root) in if built != "" then built else let imports = dg_import_build(root) in if imports != "" then imports else let ran = dg_run_cli(root) in if ran != "" then ran else let targeted = dg_target_build(root) in if targeted != "" then targeted else let tested = dg_test(root) in if tested != "" then tested else let intended = dg_intent(root) in if intended != "" then intended else let lifecycle = dg_intent_lifecycle(root) in if lifecycle != "" then lifecycle else let compiled = dg_compile(root) in if compiled != "" then compiled else let agented = dg_agent(root) in if agented != "" then agented else let protocol = dg_protocol(root) in if protocol != "" then protocol else let advanced = dg_agent_advanced(root) in if advanced != "" then advanced else let mcp = dg_mcp(root) in if mcp != "" then mcp else let self_checked = dg_self(root) in if self_checked != "" then self_checked else let certified = dg_certify(root) in if certified != "" then certified else let checked = dg_check(root) in if checked != "" then checked else let formatted = dg_fmt(root) in if formatted != "" then formatted else let packaged = dg_pkg(root) in if packaged != "" then packaged else let lmod = dg_lmod_gates(root) in if lmod != "" then lmod else let documented = dg_doc(root) in if documented != "" then documented else let proved = dg_prove(root) in if proved != "" then proved else let proof_modes = dg_proof_modes(root) in if proof_modes != "" then proof_modes else let adapted = dg_adapt(root) in if adapted != "" then adapted else let meshed = dg_mesh(root) in if meshed != "" then meshed else let economic = dg_economy(root) in if economic != "" then economic else let evolved = dg_evolve(root) in if evolved != "" then evolved else dg_unknown(root)

fn dg_run_input(root, args, input, name) = let request = root + "/build/cli-" + name + ".in" in let output = root + "/build/cli-" + name + ".out" in let errors = root + "/build/cli-" + name + ".err" in let written = fs_write_sync(request, input) in if written != 1 then {status: 1, output: "", errors: "cannot write MCP request fixture"} else let status = os_run_input_capture_timeout(root + "/build/bin/lume_driver", args, request, output, errors, 120000) in {status: dg_wait_exit(status), output: fs_read_file(output), errors: fs_read_file(errors)}

fn dg_mcp_request(id, method) = "{\"jsonrpc\":\"2.0\",\"id\":" + str(id) + ",\"method\":\"" + method + "\"}\n"

fn dg_mcp_call(id, name, args) = "{\"jsonrpc\":\"2.0\",\"id\":" + str(id) + ",\"method\":\"tools/call\",\"params\":{\"name\":\"" + name + "\",\"arguments\":" + args + "}}\n"

fn dg_count_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 + dg_count_at(text, part, i + count(part)) else dg_count_at(text, part, i + 1)

fn dg_count(text, part) = dg_count_at(text, part, 0)

fn dg_lines(text, i) = if i >= count(text) then Nil else let e = dg_line_end(text, i) in Cons(slice(text, i, e), dg_lines(text, e + 1))

fn dg_response_lines(lines, id) = match lines
    Nil => ""
    Cons(h, t) => if dg_contains(h, "\"id\":" + str(id) + ",") == 1 then h else dg_response_lines(t, id)

fn dg_response(output, id) = dg_response_lines(dg_lines(output, 0), id)

fn dg_response_cases(output, cases) = match cases
    Nil => ""
    Cons(h, t) => let response = dg_response(output, h.id) in if response == "" then "missing MCP response id " + str(h.id) else if dg_contains(response, h.expected) == 0 then "MCP response id " + str(h.id) + " is missing " + h.expected + ":\n" + response else dg_response_cases(output, t)

fn dg_mcp_valid_input() = dg_mcp_request(1, "initialize") + "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}\n" + dg_mcp_request(2, "tools/list") + dg_mcp_call(3, "lume_check", "{}") + dg_mcp_call(4, "lume_prove", "{}") + dg_mcp_call(5, "lume_impact", "{}") + dg_mcp_call(6, "lume_bind", "{\"header\":\"int64_t add(int64_t a, int64_t b);\"}") + dg_mcp_call(7, "lume_certify", "{}") + dg_mcp_call(8, "lume_proof_diff", "{\"new_source\":\"fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\"}") + dg_mcp_call(9, "lume_check_rot", "{\"new_source\":\"fn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\"}") + dg_mcp_call(10, "lume_share", "{}") + dg_mcp_call(11, "lume_patch", "{\"function\":\"clamp\",\"expression\":\"x\"}") + dg_mcp_call(12, "lume_replay", "{}") + dg_mcp_call(13, "lume_lineage", "{\"symbol\":\"clamp\"}") + dg_mcp_call(14, "lume_compose", "{\"module_source\":\"fn composed(x: int) -> int requires x >= 0 ensures result >= 0 = clamp(x)\"}")

fn dg_mcp_valid(root, source) = let result = dg_run_input(root, Cons("mcp", Cons(source, Nil)), dg_mcp_valid_input(), "mcp-valid") in if result.status != 0 then "native MCP valid session failed:\n" + result.errors else let discovery = dg_response(result.output, 2) in if dg_count(discovery, "\"name\":\"lume_") != 15 or dg_count(discovery, "\"inputSchema\":") != 15 then "native MCP did not discover exactly 15 schemas:\n" + discovery else let cases = Cons({id: 1, expected: "\"serverInfo\":{\"name\":\"lume-oracle-mcp\""}, Cons({id: 3, expected: "\"diagnostics\":[]"}, Cons({id: 4, expected: "\"status\":\"proven\""}, Cons({id: 5, expected: "\"mode\":\"impact\""}, Cons({id: 6, expected: "foreign_add"}, Cons({id: 7, expected: "\"kernel_verified\":true"}, Cons({id: 8, expected: "\"mode\":\"proof-diff\""}, Cons({id: 9, expected: "\"rot_detected\":false"}, Cons({id: 10, expected: "\"badge\":\"Lume Verified"}, Cons({id: 11, expected: "\"patched_source\":\""}, Cons({id: 12, expected: "\"replay_verified\":true"}, Cons({id: 13, expected: "\"mode\":\"lineage\""}, Cons({id: 14, expected: "\"compositional_verified\":true"}, Nil))))))))))))) in let checked = dg_response_cases(result.output, cases) in if checked != "" then checked else let bundle_hash = fs_sha256_file(root + "/build/lume-driver-mcp.bundled.src") in if dg_contains(dg_response(result.output, 7), "\"source_hash\":\"sha256:" + bundle_hash + "\"") == 0 then "native MCP certificate is not bound to the real bundle hash" else ""

fn dg_mcp_fill(root) = let source = root + "/build/cli_mcp_fill.src" in let written = fs_write_sync(source, "fn fill_inc(x: int) -> int ensures result > x = _\n") in if written != 1 then "cannot write native MCP fill fixture" else let input = dg_mcp_request(1, "initialize") + dg_mcp_call(2, "lume_fill", "{}") in let result = dg_run_input(root, Cons("mcp", Cons("--json", Cons(source, Nil))), input, "mcp-fill") in if result.status != 0 then "native MCP fill failed:\n" + result.errors else dg_response_cases(result.output, Cons({id: 2, expected: "\"proven_candidates\":[\"x + 1\"]"}, Nil))

fn dg_mcp_witness_repair(root) = let source = root + "/build/cli_mcp_bad.src" in let written = fs_write_sync(source, "fn bad_inc(x: int) -> int ensures result > x = x\nfn caller(x: int) -> int ensures result > x = bad_inc(x)\n") in if written != 1 then "cannot write native MCP witness fixture" else let input = dg_mcp_request(1, "initialize") + dg_mcp_call(2, "lume_witness", "{}") + dg_mcp_call(3, "lume_repair", "{}") in let result = dg_run_input(root, Cons("mcp", Cons(source, Nil)), input, "mcp-witness-repair") in if result.status != 0 then "native MCP witness/repair failed:\n" + result.errors else dg_response_cases(result.output, Cons({id: 2, expected: "\"has_witness\":true"}, Cons({id: 2, expected: "\"witness\":"}, Cons({id: 3, expected: "\"kind\":\"contract_body_repair\""}, Cons({id: 3, expected: "\"replacement\":\"x + 1\""}, Nil))))

fn dg_mcp_negative(root, source) = let input = dg_mcp_request(1, "initialize") + dg_mcp_call(2, "lume_prove", "{}") + dg_mcp_call(3, "lume_not_real", "{}") + dg_mcp_request(4, "not/a/method") + dg_mcp_call(5, "lume_patch", "{}") in let result = dg_run_input(root, Cons("mcp", Cons(source, Nil)), input, "mcp-negative") in if result.status != 0 then "native MCP negative session failed:\n" + result.errors else let cases = dg_response_cases(result.output, Cons({id: 2, expected: "\"isError\":true"}, Cons({id: 2, expected: "V0001"}, Cons({id: 3, expected: "\"code\":-32602"}, Cons({id: 4, expected: "\"code\":-32601"}, Cons({id: 5, expected: "\"code\":-32602"}, Nil))))) in if cases != "" then cases else let early = dg_run_input(root, Cons("mcp", Cons(source, Nil)), dg_mcp_call(1, "lume_check", "{}"), "mcp-uninitialized") in if early.status != 0 then "native MCP uninitialized session failed:\n" + early.errors else let early_case = dg_response_cases(early.output, Cons({id: 1, expected: "\"code\":-32002"}, Nil)) in if early_case != "" then early_case else let malformed = dg_run_input(root, Cons("mcp", Cons(source, Nil)), "not-json\n", "mcp-malformed") in if malformed.status != 0 or dg_contains(malformed.output, "\"code\":-32700") == 0 then "native MCP malformed JSON rejection mismatch:\n" + malformed.output + malformed.errors else let missing = dg_run(root, Cons("mcp", Cons(root + "/build/definitely-missing-mcp.src", Nil)), "mcp-missing") in if missing.status == 0 then "native MCP accepted a missing source" else ""

fn dg_mcp(root) = let base = root + "/build/cli_mcp_base.src" in let base_written = fs_write_sync(base, "fn imported_answer() -> int = 42\n") in let source = root + "/build/cli_mcp_valid.src" in let written = fs_write_sync(source, "use cli_mcp_base\nfn clamp(x: int) -> int requires x >= 0 ensures result >= 0 = x\nfn answer() -> int = imported_answer()\nprint answer()\n") in if base_written != 1 or written != 1 then "cannot write native MCP bundle fixtures" else let valid = dg_mcp_valid(root, source) in if valid != "" then valid else let filled = dg_mcp_fill(root) in if filled != "" then filled else let witnessed = dg_mcp_witness_repair(root) in if witnessed != "" then witnessed else dg_mcp_negative(root, root + "/build/cli_mcp_bad.src")

fn dg_intent_lifecycle(root) = let source = root + "/examples/intent/verified_specs.intent" in let cache = root + "/build/cli_intent_lifecycle.cache.src" in let cert = root + "/build/cli_intent_lifecycle.cache.cert.json" in let stale = fs_write_sync(cert, "stale") in if stale != 1 then "cannot write stale intent certificate fixture" else let ran = dg_exact(root, "intent-run", Cons("intent", Cons("run", Cons(source, Cons("--cache", Cons(cache, Nil))))), "65\n49\n36\n30\n42\n") in if ran != "" then ran else let status = dg_part(root, "intent-status", Cons("intent", Cons("status", Cons(source, Cons("--cache", Cons(cache, Nil))))), "\"cache_valid\":true") in if status != "" then status else let cleaned = dg_exact(root, "intent-clean", Cons("intent", Cons("clean", Cons(source, Cons("--cache", Cons(cache, Nil))))), "{\"ok\":true,\"mode\":\"intent-clean\",\"cache_file\":\"" + cache + "\"}\n") in if cleaned != "" then cleaned else if fs_path_exists(cache) == 1 or fs_path_exists(cert) == 1 then "native intent clean left cache artifacts" else let repeated = dg_run(root, Cons("intent", Cons("clean", Cons(source, Cons("--cache", Cons(cache, Nil))))), "intent-clean-idempotent") in if repeated.status != 0 then "native intent clean was not idempotent" else ""

fn dg_lmod_reject(root, name, request, expected) = let input = root + "/build/cli-lmod-" + name + ".in" in let output = root + "/build/cli-lmod-" + name + ".out" in let errors = root + "/build/cli-lmod-" + name + ".err" in let written = fs_write_sync(input, request) in if written != 1 then "cannot write native lmod " + name + " fixture" else let raw = os_run_input_capture_timeout(root + "/build/bin/lmod", Nil, input, output, errors, 120000) in let status = dg_wait_exit(raw) in if status == 0 then "native lmod accepted " + name else if dg_contains(fs_read_file(errors), expected) == 0 then "native lmod " + name + " diagnostic mismatch: " + fs_read_file(errors) else ""

fn dg_lmod_gates(root) = let cycle = dg_lmod_reject(root, "cycle", "@module a\nuse b\nfn a_value() = b_value()\n@end\n@module b\nuse a\nfn b_value() = a_value()\n@end\n@entry main\nuse a\nprint a_value()\n@end\n", "circular module dependency") in if cycle != "" then cycle else let missing = dg_lmod_reject(root, "missing", "@entry main\nuse definitely_missing\nprint 0\n@end\n", "module 'definitely_missing' not found") in if missing != "" then missing else dg_lmod_reject(root, "capability", "@grant pure\n@module sneaky\nfn bad() = read()\n@end\n@entry main\nuse sneaky\nprint 0\n@end\n", "capability error: module 'sneaky' uses I/O capability 'read'")

fn dg_pkg_manifest(root) = let dir = root + "/build/cli_pkg" in let made = fs_mkdir(dir) in let manifest = dir + "/lume.toml" in let written = fs_write_sync(manifest, "[package]\nname = \"demo\"\nversion = \"0.1.0\"\nedition = \"2026\"\n[capabilities]\nallow = [\"pure\"]\n") in if made != 1 or written != 1 then "cannot write native pkg fixture" else let checked = dg_exact(root, "pkg-check", Cons("pkg", Cons("check", Cons(dir, Nil))), "{\"name\":\"demo\",\"version\":\"0.1.0\",\"edition\":\"2026\",\"capabilities\":\"pure\"}\n") in if checked != "" then checked else let aliased = dg_exact(root, "pkg-manifest", Cons("pkg", Cons("manifest", Cons(dir, Nil))), "{\"name\":\"demo\",\"version\":\"0.1.0\",\"edition\":\"2026\",\"capabilities\":\"pure\"}\n") in if aliased != "" then aliased else let missing_lock = dg_run(root, Cons("pkg", Cons("verify", Cons(dir, Nil))), "pkg-missing-lock") in if missing_lock.status == 0 then "native pkg verify accepted a missing lockfile" else let invalid = fs_write_sync(manifest, "[package]\nname = \"demo\"\nedition = \"2026\"\n") in if invalid != 1 then "cannot write invalid native pkg fixture" else let rejected = dg_run(root, Cons("pkg", Cons("check", Cons(dir, Nil))), "pkg-invalid") in if rejected.status == 0 then "native pkg accepted a manifest without version" else if dg_contains(rejected.errors, "missing 'version'") == 0 then "native pkg missing-version diagnostic mismatch: " + rejected.errors else let missing = dg_run(root, Cons("pkg", Cons("check", Cons(root + "/build/definitely-missing-pkg", Nil))), "pkg-missing") in if missing.status == 0 then "native pkg accepted a missing manifest" else ""

fn dg_pkg_dir(root) = root + "/build/cli pkg parent/nested/cli pkg native"

fn dg_pkg_init(root) = let dir = dg_pkg_dir(root) in let args = Cons("pkg", Cons("init", Cons(dir, Nil))) in let initialized = dg_exact(root, "pkg-init", args, "lume pkg: initialized cli pkg native in " + dir + "/lume.toml\n") in if initialized != "" then initialized else let expected_manifest = "[package]\nname = \"cli pkg native\"\nversion = \"0.1.0\"\nedition = \"2026\"\n\n[capabilities]\nallow = [\"io\"]\n\n[dependencies]\n" in let expected_main = "## cli pkg native — entry module\nfn main_val() -> int = 42\nprint main_val()\n" in if fs_read_file(dir + "/lume.toml") != expected_manifest or fs_read_file(dir + "/main.src") != expected_main then "native pkg init generated mismatched files" else let repeated = dg_exact(root, "pkg-init-idempotent", args, "lume pkg: initialized cli pkg native in " + dir + "/lume.toml\n") in if repeated != "" then repeated else if fs_read_file(dir + "/lume.toml") != expected_manifest or fs_read_file(dir + "/main.src") != expected_main then "native pkg init overwrote existing files" else let a = fs_write_sync(dir + "/a.src", "use b\nfn a_value() -> int = b_value()\n") in let b = fs_write_sync(dir + "/b.src", "fn b_value() -> int = 42\n") in let main = fs_write_sync(dir + "/main.src", "use a\nfn main_val() -> int = a_value()\nprint main_val()\n") in let src = fs_mkdir(dir + "/src") in let extra = fs_write_sync(dir + "/src/extra.lume", "fn extra() = 1\n") in let ignored = fs_write_sync(dir + "/src/ignored.txt", "ignored\n") in let nested = fs_mkdir(dir + "/src/nested") in let deep = fs_write_sync(dir + "/src/nested/too-deep.src", "print 0\n") in if a != 1 or b != 1 or main != 1 or src != 1 or extra != 1 or ignored != 1 or nested != 1 or deep != 1 then "cannot write native pkg source fixtures" else ""

fn dg_pkg_expected_lock(dir, added) = let header = "# lume.lock — deterministic content-addressed lockfile (P26, P32)\nversion = 1\nmanifest = {\"name\":\"cli pkg native\",\"version\":\"0.1.0\",\"edition\":\"2026\",\"capabilities\":\"io\"}\nmanifest_sha256 = \"" + fs_sha256_file(dir + "/lume.toml") + "\"\n" in let root_mods = "module \"a.src\" sha256 = \"" + fs_sha256_file(dir + "/a.src") + "\"\nmodule \"b.src\" sha256 = \"" + fs_sha256_file(dir + "/b.src") + "\"\nmodule \"main.src\" sha256 = \"" + fs_sha256_file(dir + "/main.src") + "\"\n" in let added_mod = if added == 1 then "module \"src/added.src\" sha256 = \"" + fs_sha256_file(dir + "/src/added.src") + "\"\n" else "" in header + root_mods + added_mod + "module \"src/extra.lume\" sha256 = \"" + fs_sha256_file(dir + "/src/extra.lume") + "\"\n"

fn dg_pkg_lock_and_tree(root) = let dir = dg_pkg_dir(root) in let lock = dir + "/lume.lock" in let locked = dg_exact(root, "pkg-lock", Cons("pkg", Cons("lock", Cons(dir, Nil))), "lume pkg: wrote " + lock + "\n") in if locked != "" then locked else if fs_read_file(lock) != dg_pkg_expected_lock(dir, 0) then "native pkg lockfile format, ordering, hashes, or depth mismatch" else let verified = dg_exact(root, "pkg-verify", Cons("pkg", Cons("verify", Cons(dir, Nil))), "lume pkg: verified " + lock + " (all SHA-256 digests match)\n") in if verified != "" then verified else let expected_tree = "{\"name\":\"cli pkg native\",\"version\":\"0.1.0\",\"edition\":\"2026\",\"capabilities\":\"io\"}\n  |-- a.src -> b \n  |-- b.src\n  |-- main.src -> a\n" in let tree = dg_exact(root, "pkg-tree", Cons("pkg", Cons("tree", Cons(dir, Nil))), expected_tree) in if tree != "" then tree else let source_before = fs_read_file(dir + "/a.src") in let tampered = fs_write_sync(dir + "/a.src", source_before + "## drift\n") in let source_rejected = dg_run(root, Cons("pkg", Cons("verify", Cons(dir, Nil))), "pkg-source-drift") in if tampered != 1 or source_rejected.status == 0 or dg_contains(source_rejected.errors, "source or manifest drift detected") == 0 then "native pkg verify accepted source drift" else let restored = fs_write_sync(dir + "/a.src", source_before) in if restored != 1 then "cannot restore native pkg source" else let lock_before = fs_read_file(lock) in let lock_tampered = fs_write_sync(lock, lock_before + "drift\n") in let lock_rejected = dg_run(root, Cons("pkg", Cons("verify", Cons(dir, Nil))), "pkg-lock-drift") in if lock_tampered != 1 or lock_rejected.status == 0 then "native pkg verify accepted lockfile tampering" else let lock_restored = fs_write_sync(lock, lock_before) in if lock_restored != 1 then "cannot restore native pkg lockfile" else let added = fs_write_sync(dir + "/src/added.src", "fn added() = 1\n") in let addition_rejected = dg_run(root, Cons("pkg", Cons("verify", Cons(dir, Nil))), "pkg-addition-drift") in if added != 1 or addition_rejected.status == 0 then "native pkg verify accepted an unlocked source file" else let relocked = dg_exact(root, "pkg-relock", Cons("pkg", Cons("lock", Cons(dir, Nil))), "lume pkg: wrote " + lock + "\n") in if relocked != "" then relocked else if fs_read_file(lock) != dg_pkg_expected_lock(dir, 1) then "native pkg relock did not include the nested source" else let manifest_before = fs_read_file(dir + "/lume.toml") in let manifest_tampered = fs_write_sync(dir + "/lume.toml", manifest_before + "\n") in let manifest_rejected = dg_run(root, Cons("pkg", Cons("verify", Cons(dir, Nil))), "pkg-manifest-drift") in if manifest_tampered != 1 or manifest_rejected.status == 0 then "native pkg verify accepted manifest drift" else let manifest_restored = fs_write_sync(dir + "/lume.toml", manifest_before) in if manifest_restored != 1 then "cannot restore native pkg manifest" else dg_exact(root, "pkg-verify-restored", Cons("pkg", Cons("verify", Cons(dir, Nil))), "lume pkg: verified " + lock + " (all SHA-256 digests match)\n")

fn dg_self(root) = let prefix = root + "/build/cli_self" in let made = fs_mkdir(prefix) in let artifact = prefix + "/artifact.txt" in let written = fs_write_sync(artifact, "abc") in let manifest = fs_write_sync(prefix + "/MANIFEST.sha256", fs_sha256_file(artifact) + "  artifact.txt\n") in if made != 1 or written != 1 or manifest != 1 then "cannot write native self fixtures" else let verified = dg_part(root, "self-verify", Cons("self", Cons("verify", Cons("--prefix", Cons(prefix, Nil)))), "\"manifest_verified\":true") in if verified != "" then verified else let counted = dg_part(root, "self-count", Cons("self", Cons("verify", Cons("--prefix", Cons(prefix, Nil)))), "\"verified_files\":1") in if counted != "" then counted else let tampered = fs_write_sync(artifact, "tampered") in if tampered != 1 then "cannot tamper native self fixture" else let rejected = dg_run(root, Cons("self", Cons("verify", Cons("--prefix", Cons(prefix, Nil)))), "self-tampered") in if rejected.status == 0 then "native self accepted a tampered manifest" else let in_tree = dg_part(root, "self-status", Cons("self", Cons("status", Cons("--prefix", Cons(root + "/build", Nil)))), "\"mode\":\"in-tree\"") in if in_tree != "" then in_tree else let updated = dg_part(root, "self-update", Cons("self", Cons("update", Cons("--prefix", Cons(prefix, Nil)))), "\"manifest_verified\":true") in if updated != "" then updated else let verified_update = dg_run(root, Cons("self", Cons("verify", Cons("--prefix", Cons(prefix, Nil)))), "self-verify-update") in if verified_update.status != 0 then "native self update produced an invalid manifest" else ""

fn dg_dispatch(input) = let root = dg_root(input) in if root == "" then ctfail("native driver gate requires @root\n") else let problem = dg_main(root) in if problem != "" then ctfail("native driver gate failed: " + problem + "\n") else "native driver version, help, describe, targets, build, transitive bundling, run, argv, exit-code, test discovery, test failure, intent cache proofs, tamper rejection, real economic benchmark, and rejection checks passed"

print dg_dispatch(readall())
