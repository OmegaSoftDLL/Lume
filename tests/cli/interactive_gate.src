fn ig_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn ig_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else ig_contains_at(text, part, i + 1)
fn ig_contains(text, part) = ig_contains_at(text, part, 0)
fn ig_run(root, args, name, input) = let request = root + "/build/interactive-" + name + ".in" in let output = root + "/build/interactive-" + name + ".out" in let errors = root + "/build/interactive-" + name + ".err" in let written = fs_write_sync(request, input) in if written != 1 then {status: 1, output: "", errors: "cannot write session input"} else let status = os_run_input_capture_timeout(root + "/build/bin/lume_driver", args, request, output, errors, 120000) in {status: ig_wait_exit(status), output: fs_read_file(output), errors: fs_read_file(errors)}
fn ig_expect(name, result, expected) = if result.status != 0 then name + " failed with status " + str(result.status) + ": " + result.errors else if ig_contains(result.output, expected) == 0 then name + " is missing " + expected + "\nstdout:\n" + result.output + "\nstderr:\n" + result.errors else ""
fn ig_first(a, b) = if a != "" then a else b

fn ig_lsp_session() = "{{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{{\"rootUri\":\"file:///workspace\"}}}}\n{{\"jsonrpc\":\"2.0\",\"method\":\"initialized\",\"params\":{{}}}}\n{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{{\"textDocument\":{{\"uri\":\"file:///workspace/live.src\",\"languageId\":\"lume\",\"version\":1,\"text\":\"fn step_up(x: int) -> int ensures result > x = x\\nprint step_up(4)\\n\"}}}}}}\n{{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didChange\",\"params\":{{\"textDocument\":{{\"uri\":\"file:///workspace/live.src\",\"version\":2}},\"contentChanges\":[{{\"text\":\"fn step_up(x: int) -> int ensures result > x = x + 1\\nprint step_up(4)\\n\"}}]}}}}\n{{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\",\"params\":{{\"textDocument\":{{\"uri\":\"file:///workspace/live.src\"}},\"position\":{{\"line\":0,\"character\":3}}}}}}\n{{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/codeAction\",\"params\":{{\"textDocument\":{{\"uri\":\"file:///workspace/live.src\"}}}}}}\n{{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"textDocument/documentSymbol\",\"params\":{{\"textDocument\":{{\"uri\":\"file:///workspace/live.src\"}}}}}}\n{{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"shutdown\",\"params\":null}}\n{{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":null}}\n"
fn ig_lsp(root) = let result = ig_run(root, Cons("lsp", Cons("--stdio", Nil)), "lsp", ig_lsp_session()) in let initialized = ig_expect("LSP initialize", result, "\"protocol\":\"lsp/3.17\"") in let opened = ig_expect("LSP didOpen diagnostics", result, "\"code\":\"V0001\"") in let changed = ig_expect("LSP didChange diagnostics", result, "\"diagnostics\":[]") in let hover = ig_expect("LSP hover", result, "Proof status: `proven`") in let actions = ig_expect("LSP codeAction", result, "\"id\":3,\"result\":") in let symbols = ig_expect("LSP documentSymbol", result, "\"name\":\"step_up\"") in let shutdown = ig_expect("LSP shutdown", result, "\"id\":5,\"result\":null") in ig_first(initialized, ig_first(opened, ig_first(changed, ig_first(hover, ig_first(actions, ig_first(symbols, shutdown))))))
fn ig_lsp_sequential_output(root) = let input = "{{\"jsonrpc\":\"2.0\",\"id\":20,\"method\":\"initialize\",\"params\":{{}}}}\n{{\"jsonrpc\":\"2.0\",\"id\":21,\"method\":\"shutdown\"}}\n{{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}}\n" in let result = ig_run(root, Cons("lsp", Cons("--stdio", Nil)), "lsp-sequential", input) in let initialized = "{\"jsonrpc\":\"2.0\",\"id\":20,\"result\":{\"protocol\":\"lsp/3.17\",\"serverInfo\":{\"name\":\"lume-lsp\",\"version\":\"1.1.0\"},\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true,\"codeActionProvider\":true,\"inlayHintProvider\":true}}}" in let shutdown = "{\"jsonrpc\":\"2.0\",\"id\":21,\"result\":null}" in let expected = initialized + "\n" + shutdown + "\n" in if result.status != 0 then "LSP sequential output failed with status " + str(result.status) + ": " + result.errors else if result.output != expected then "LSP sequential output was truncated or reordered\nexpected:\n" + expected + "stdout:\n" + result.output + "\nstderr:\n" + result.errors else ""
fn ig_lsp_framed(root) = let initialize = "{{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"initialize\",\"params\":{{}}}}" in let input = "Content-Length: " + str(count(initialize)) + "\r\n\r\n" + initialize + "\n{\"jsonrpc\":\"2.0\",\"id\":11,\"method\":\"shutdown\"}\n{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}\n" in let result = ig_run(root, Cons("lsp", Cons("--stdio", Nil)), "lsp-framed", input) in ig_expect("LSP Content-Length framing", result, "Content-Length: ")
fn ig_lsp_exit_without_shutdown(root) = let result = ig_run(root, Cons("lsp", Cons("--stdio", Nil)), "lsp-exit", "{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}\n") in if result.status != 1 then "LSP exit without shutdown did not return status 1" else ""
fn ig_lsp_truncated(root) = let result = ig_run(root, Cons("lsp", Cons("--stdio", Nil)), "lsp-truncated", "Content-Length: 50\r\n\r\n{}") in if result.status == 0 then "LSP accepted a truncated framed message" else if ig_contains(result.errors, "truncated message body") == 0 then "LSP truncated-message diagnostic mismatch: " + result.errors else ""

fn ig_dap_session(root) = let source = root + "/build/interactive-dap-source.src" in let written = fs_write_sync(source, "fn clamp_pos(x: int) -> int requires x >= 0 ensures result >= 0 = x + 1\nprint clamp_pos(5)\n") in if written != 1 then "" else "{\"seq\":1,\"type\":\"request\",\"command\":\"initialize\"}\n{\"seq\":2,\"type\":\"request\",\"command\":\"launch\",\"arguments\":{\"program\":\"" + source + "\"}}}}\n{\"seq\":3,\"type\":\"request\",\"command\":\"next\"}\n{\"seq\":4,\"type\":\"request\",\"command\":\"stepIn\"}\n{\"seq\":5,\"type\":\"request\",\"command\":\"stepBack\"}\n{\"seq\":6,\"type\":\"request\",\"command\":\"stackTrace\"}\n{\"seq\":7,\"type\":\"request\",\"command\":\"scopes\"}\n{\"seq\":8,\"type\":\"request\",\"command\":\"evaluate\",\"arguments\":{\"expression\":\"clamp_pos(41)\"}}\n{\"seq\":9,\"type\":\"request\",\"command\":\"disconnect\"}\n"
fn ig_dap(root) = let result = ig_run(root, Cons("dap", Cons("--stdio", Nil)), "dap", ig_dap_session(root)) in let initialized = ig_expect("DAP initialize", result, "\"supportsStepBack\":true") in let launched = ig_expect("DAP launch", result, "\"command\":\"launch\"") in let next = ig_expect("DAP next", result, "\"command\":\"next\",\"body\":{\"step\":2}") in let stepped = ig_expect("DAP stepIn", result, "\"command\":\"stepIn\",\"body\":{\"step\":3}") in let back = ig_expect("DAP stepBack", result, "\"command\":\"stepBack\",\"body\":{\"step\":2,\"replay\":true}") in let trace = ig_expect("DAP stackTrace", result, "\"traceHistory\":\"1,2,3,2\"") in let scopes = ig_expect("DAP scopes", result, "\"name\":\"Globals\"") in let evaluated = ig_expect("DAP evaluate", result, "\"result\":\"42\"") in let disconnected = ig_expect("DAP disconnect", result, "\"event\":\"terminated\"") in ig_first(initialized, ig_first(launched, ig_first(next, ig_first(stepped, ig_first(back, ig_first(trace, ig_first(scopes, ig_first(evaluated, disconnected))))))))

fn ig_repl(root) = let input = "fn add_tax(x: int) -> int requires x >= 0 ensures result >= x = x + 7\nadd_tax(35)\nadd_tax(\"bad_arg_type\")\nadd_tax(10)\nos_getpid() > 0\n:quit\n" in let result = ig_run(root, Cons("repl", Nil), "repl", input) in let defined = ig_expect("REPL definition", result, "[1] defined") in let first = ig_expect("REPL first evaluation", result, "42") in let rejected = ig_expect("REPL failed turn", result, "error:") in let rollback = ig_expect("REPL rollback", result, "17") in let runtime = ig_expect("REPL native runtime", result, "\n1\n") in ig_first(defined, ig_first(first, ig_first(rejected, ig_first(rollback, runtime))))
fn ig_repl_kernel(root) = let input = "{\"msg_type\":\"kernel_info_request\"}\n{\"msg_type\":\"execute_request\",\"code\":\"fn triple(x: int) -> int ensures result == x + x + x = x * 3\\nprint triple(4)\"}\n{\"msg_type\":\"execute_request\",\"code\":\"print triple(\\\"bad\\\")\"}\n{\"msg_type\":\"execute_request\",\"code\":\"print triple(14)\"}\n{\"msg_type\":\"shutdown_request\"}\n" in let result = ig_run(root, Cons("repl", Cons("--kernel", Nil)), "repl-kernel", input) in let info = ig_expect("REPL kernel info", result, "\"msg_type\":\"kernel_info_reply\"") in let defined = ig_expect("REPL kernel definition", result, "\"execution_count\":1,\"status\":\"ok\"") in let rejected = ig_expect("REPL kernel failure", result, "\"execution_count\":2,\"status\":\"error\"") in let rollback = ig_expect("REPL kernel rollback", result, "\"execution_count\":3,\"status\":\"ok\"") in let evaluated = ig_expect("REPL kernel evaluation", result, "\"text/plain\":\"42\"") in let shutdown = ig_expect("REPL kernel shutdown", result, "\"msg_type\":\"shutdown_reply\"") in ig_first(info, ig_first(defined, ig_first(rejected, ig_first(rollback, ig_first(evaluated, shutdown)))))

fn ig_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else ig_line_end(text, i + 1)
fn ig_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, ig_line_end(input, 0))
fn ig_main(root) = let lsp = ig_lsp(root) in if lsp != "" then lsp else let sequential = ig_lsp_sequential_output(root) in if sequential != "" then sequential else let framed = ig_lsp_framed(root) in if framed != "" then framed else let exit_status = ig_lsp_exit_without_shutdown(root) in if exit_status != "" then exit_status else let truncated = ig_lsp_truncated(root) in if truncated != "" then truncated else let dap = ig_dap(root) in if dap != "" then dap else let repl = ig_repl(root) in if repl != "" then repl else ig_repl_kernel(root)
fn ig_dispatch(input) = let root = ig_root(input) in if root == "" then ctfail("native interactive gate requires @root\n") else let problem = ig_main(root) in if problem != "" then ctfail("native interactive gate failed: " + problem + "\n") else "native interactive LSP, DAP, REPL, framing, failure, and rollback checks passed"
print ig_dispatch(readall())
