## --- S09: the safety envelope ---
fn sy_env_req(g, tag, src, fnm, vecs, extra) = "@src " + src + "\n@fn " + fnm + "\n" + vecs + "@log " + g.tmp + "/" + tag + ".jsonl\n@work " + g.tmp + "/envw\n@reset 1\n" + extra
fn sy_env(g, tag, vecs, extra) = let z = sy_rmrf(g.tmp + "/" + tag + ".jsonl") in sy_x_env(g, tag, sy_env_req(g, tag, g.k, "rate_limit", vecs, extra))
fn sy_commit(out, a, v) = sy_has(out, "{\"args\":[" + a + "],\"state\":\"VerifiedActuatorCommit\",\"value\":" + str(v) + ",\"out_a\":" + str(v) + ",\"out_b\":" + str(v) + ",")
## the modules the bundle of a tool binary was built from (`## --- module <name> ---` lines of build/bin/<tool>.bundled.src)
fn sy_mods_at(b, i, acc) = let j = sy_index(b, "## --- module ", i) in if j < 0 then acc else let e = sy_line_end(b, j) in sy_mods_at(b, e, acc + slice(b, j + 14, e - 4) + " ")
fn sy_mods(g, tool) = sy_mods_at(fs_read_file(g.bin + "/" + tool + ".bundled.src"), 0, " ")
fn sy_indep(g) = let me = sy_mods(g, "lsafety_envelope") in let tv = sy_mods(g, "ltv") in if me == " " then "build/bin/lsafety_envelope.bundled.src lists no module (the binary was not built by `lume build`)" else if sy_has(me, " lumec ") == 1 or sy_has(me, " lcaas ") == 1 or sy_has(me, " lrv32_lowered ") == 1 then "the bundle of lsafety_envelope links a compiler module:" + me else if sy_has(tv, " lumec ") == 0 then "control: the bundle of ltv should list the module lumec (the scan would be vacuous):" + tv else ""
fn sy_s09(g) = let r = sy_env(g, "s09_env", "@args 100,900,50\n@args 5000,100,500\n@args 100,120,50\n", "") in sy_st("S09", "safety-envelope", "lsafety_envelope (lockstep, real ltv)", "lockstep report; hash-chained event log; modules of channel B's tool:" + sy_mods(g, "lsafety_envelope"), sy_sha_file(g.tmp + "/s09_env.jsonl"), r.ms, sy_first(sy_l5(sy_c(sy_b(r.status == 0 and sy_has(r.out, "\"committed\":3,\"tripped\":0,\"final_latched\":0") == 1), "the lockstep did not commit the three vectors (exit status " + str(r.status) + "): " + sy_short(r.out + r.err)), sy_c(sy_b(sy_commit(r.out, "100,900,50", 150) == 1 and sy_commit(r.out, "5000,100,500", 4500) == 1 and sy_commit(r.out, "100,120,50", 120) == 1), "a committed value is not the reference value: " + sy_short(r.out)), sy_c(sy_b(sy_has(r.out, "\"ltv\":{\"path\":\"" + g.bin + "/ltv\",\"status\":\"validated\"}") == 1 and sy_count(r.out, "\"cert_ok\":1") == 3), "the certificate guard did not come from the real ltv"), sy_c(sy_b(sy_jstr(r.out, "src_sha256") == g.ksha and sy_has(r.out, "\"monitor\":\"rv32im\"") == 1), "the envelope ran another file than the certified kernel module"), sy_c(sy_b(sy_indep(g) == ""), sy_indep(g)))))
fn sy_qemu_b(img) = "ulimit -s 8192; exec timeout 20 /usr/bin/qemu-system-riscv32 -machine virt -bios none -display none -monitor none -serial stdio -kernel " + img
fn sy_qemu_a64(elf) = "ulimit -s 8192; exec timeout 20 /usr/bin/qemu-aarch64 " + elf
fn sy_qemu_r64(elf) = "ulimit -s 8192; exec timeout 20 /usr/bin/qemu-riscv64 " + elf
## one split-run request; the event log is <tmp>/<log>.jsonl (sy_split_run starts from an empty log)
fn sy_split_req(g, tag, lg, dir, seq, args, cmd_a, cmd_b, extra) = sy_x_env(g, tag, "@mode split-run\n@manifest " + dir + "/manifest.json\n@seq " + str(seq) + "\n@args " + args + "\n@cmd_a " + cmd_a + "\n@cmd_b " + cmd_b + "\n@log " + g.tmp + "/" + lg + ".jsonl\n" + extra)
fn sy_split_run(g, tag, dir, seq, args, cmd_a, cmd_b, extra) = let z = sy_rmrf(g.tmp + "/" + tag + ".jsonl") in sy_split_req(g, tag, tag, dir, seq, args, cmd_a, cmd_b, extra)
fn sy_sp_commit(r, v) = if r.status == 0 and sy_has(r.out, "\"state\":\"VerifiedActuatorCommit\",\"value\":" + str(v) + ",\"reason\":\"ok\"") == 1 then 1 else 0
fn sy_sp_trip(r, reason) = if r.status == 2 and sy_has(r.out, "\"state\":\"SAFE_STATE_TRIP\",\"value\":null,\"reason\":\"" + reason + "\"") == 1 and sy_has(r.out, "VerifiedActuatorCommit") == 0 then 1 else 0
## the response frame of a channel in a split-run report: 160 hex characters (20 words), "" when absent
fn sy_frame(out, chan) = let p = sy_index(out, "\"" + chan + "\":{", 0) in if p < 0 then "" else let q = sy_index(out, "\"frame\":\"", p) in if q < 0 or q + 9 + 160 > count(out) then "" else slice(out, q + 9, q + 9 + 160)
fn sy_s09split(g) = let d = g.split in let z = sy_rmrf(d) in let ex = sy_x_env(g, "s09_split", "@src " + g.k + "\n@fn rate_limit\n@split " + d + "\n") in let vf = sy_x_env(g, "s09_spv", "@mode split-verify\n@manifest " + d + "/manifest.json\n") in let a = d + "/channel_a_x86_64.elf" in let img = d + "/channel_b_riscv_bare.bin" in let rq = sy_split_run(g, "s09_spq", d, 11, "100,900,50", a, sy_qemu_b(img), "@reset 1\n") in let rl = sy_split_run(g, "s09_spl", d, 12, "5000,100,500", a, "lumeputer:" + img, "@reset 1\n") in let rq2 = sy_split_run(g, "s09_spq2", d, 13, "5000,100,500", a, sy_qemu_b(img), "@reset 1\n") in let man = fs_read_file(d + "/manifest.json") in sy_st("S09-SPLIT", "split bundle", "lsafety_envelope @split / split-verify / split-run, qemu-system-riscv32", "split bundle (manifest.json, channel_a_x86_64.elf, channel_b_riscv_bare.bin)", sy_dir_sha(g, "s09_split", d), ex.ms + vf.ms + rq.ms + rl.ms + rq2.ms, sy_first(sy_l6(sy_c(sy_b(ex.status == 0 and sy_has(ex.out, "\"mode\":\"split-export\",\"ok\":true") == 1), "split export failed (exit status " + str(ex.status) + "): " + sy_short(ex.out + ex.err)), sy_c(sy_b(sy_jstr(man, "src_sha256") == g.ksha and sy_has(man, "\"toolchain\":\"clean-room front end and code generator of lsafety_envelope.src\"") == 1 and sy_near(man, "\"channel_a_x86_64\":{", "\"sha256\":\"" + sy_sha_file(a) + "\"", 300) == 1), "the manifest does not name the certified source, the clean-room toolchain of channel B and the hash of channel A's program"), sy_c(sy_b(vf.status == 0 and sy_has(vf.out, "\"mode\":\"split-verify\",\"ok\":true") == 1), "split-verify refused the exported bundle: " + sy_short(vf.out + vf.err)), sy_c(sy_sp_commit(rq, 150), "x86-64 A + qemu-system-riscv32 B did not commit 150: " + sy_short(rq.out + rq.err)), sy_c(sy_sp_commit(rl, 4500), "x86-64 A + LumePuter B did not commit 4500: " + sy_short(rl.out + rl.err)), sy_c(sy_b(sy_sp_commit(rq2, 4500) == 1 and sy_frame(rq2.out, "channel_b") != "" and slice(sy_frame(rq2.out, "channel_b"), 24, 152) == slice(sy_frame(rl.out, "channel_b"), 24, 152)), "the bare image answers differently on qemu-system-riscv32 and on the LumePuter"))))
## the limiter alone is inside the lkir fragment (no bit operation, no law): the AArch64 and RV64 channel-A programs exist
fn sy_s09isa(g) = let src = g.tmp + "/rate_limit_slice.src" in let w = fs_write_sync(src, sy_k_rate()) in let d = g.tmp + "/split_isa" in let z = sy_rmrf(d) in let ex = sy_x_env(g, "s09_isa", "@src " + src + "\n@fn rate_limit\n@split " + d + "\n") in let man = fs_read_file(d + "/manifest.json") in let r = sy_split_run(g, "s09_isar", d, 21, "100,900,50", sy_qemu_a64(d + "/channel_a_aarch64.elf"), sy_qemu_b(d + "/channel_b_riscv_bare.bin"), "@reset 1\n@cmd_c " + sy_qemu_r64(d + "/channel_a_riscv64.elf") + "\n") in sy_st("S09-ISA", "split bundle on three instruction sets", "lsafety_envelope @split (lkir, larm64, lriscv), qemu-aarch64, qemu-system-riscv32, qemu-riscv64", "split bundle of the limiter alone (the three lines of rate_limit, cut from the kernel module)", sy_dir_sha(g, "s09_isa", d), ex.ms + r.ms, sy_first(sy_l4(sy_c(sy_b(sy_has(sy_kernel(), sy_k_rate()) == 1), "the slice is not text of the kernel module"), sy_c(sy_b(ex.status == 0 and fs_path_exists(d + "/channel_a_aarch64.elf") == 1 and fs_path_exists(d + "/channel_a_riscv64.elf") == 1), "the AArch64 / RV64 channel-A programs were not exported: " + sy_short(ex.out + ex.err)), sy_c(sy_sp_commit(r, 150), "qemu-aarch64 A + qemu-system-riscv32 B + qemu-riscv64 C did not commit 150: " + sy_short(r.out + r.err)), sy_c(sy_b(sy_frame(r.out, "channel_c") != "" and sy_has(r.out, "\"channel_c\":{\"how\":\"not configured\"") == 0), "channel C (RV64) sent no frame"))))
fn sy_s09stn(g) = let r = sy_x_cart(g, "s09_cart", g.k, "rate_limit", g.cart) in let c = if fs_path_exists(g.cart) == 1 then lnc_load_file(g.cart) else lnc_lerr("no file") in let f1 = if c.err == "" then lnc_forward(c, sy_l3(100, 900, 50)) else {ok: 0, v: 0, cycles: 0, cause: c.err} in let f2 = if c.err == "" then lnc_forward(c, sy_l3(5000, 100, 500)) else {ok: 0, v: 0, cycles: 0, cause: c.err} in let cert = fs_read_file(g.cert) in sy_st("S09-STN", "neural cartridge", "lume build --target safetensors (lcaas, lneural_cartridge); loader and forward pass linked here", "critical_pipeline.safetensors (" + str(c.nbytes) + " bytes, " + str(c.romn) + " ROM words)", sy_sha_file(g.cart), r.ms, sy_first(sy_l5(sy_c(sy_b(r.status == 0 and fs_path_exists(g.cart) == 1), "lume build --target safetensors: exit status " + str(r.status) + ": " + sy_short(r.out + r.err)), sy_c(sy_b(c.err == "" and c.entry == "rate_limit" and c.arity == 3), "the strict loader refused the cartridge: " + c.err), sy_c(sy_b(lnc_meta(c.meta, "source_sha256") == g.ksha), "the cartridge is not bound to the kernel module (source_sha256 " + lnc_meta(c.meta, "source_sha256") + ")"), sy_c(sy_b(lnc_meta(c.meta, "lcert_kernel_verified") == "true" and lnc_meta(c.meta, "lcert_certificate_hash") == sy_jstr(cert, "certificate_hash") and sy_jstr(cert, "certificate_hash") != ""), "the cartridge does not carry the certificate of S03 (lcert_certificate_hash " + lnc_meta(c.meta, "lcert_certificate_hash") + ")"), sy_c(sy_b(f1.ok == 1 and f1.v == 150 and f2.ok == 1 and f2.v == 4500), "the forward pass from the tensors of the file does not give the values the native program printed (150, 4500): " + str(f1.v) + " " + f1.cause + ", " + str(f2.v) + " " + f2.cause))))

## --- S10: the evidence manifest, signed under an X.509 chain ---
fn sy_now() = 1794398400
fn sy_leaf_seed() = lct_hex_to_bytes("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
fn sy_man_lines(ss) = match ss
    Nil        => ""
    Cons(s, t) => s.id + " " + s.sha + " " + s.tool + "\n" + sy_man_lines(t)
fn sy_all_sha(ss) = match ss
    Nil        => 1
    Cons(s, t) => if count(s.sha) == 64 then sy_all_sha(t) else 0
fn sy_chain() = Cons(lct_x509v_leaf(), Cons(lct_x509v_inter(), Nil))
fn sy_anchors() = Cons(lct_x509_anchor_cert(lct_x509v_root()), Nil)
## cx = {manifest, msg, seed, sig, nonce_ok, nonce_err, chain: the verdict of the chain, key_ok}
fn sy_crypto(g, ss, seed) = let rnd = lct_random_bytes_checked(32) in let manifest = "lume-synergy-evidence-v1\nkernel_sha256 " + g.ksha + "\nnonce " + lct_bytes_to_hex(rnd.bytes) + "\n" + sy_man_lines(ss) in let msg = lct_str_to_bytes(manifest) in let sig = lct_ed25519_sign(seed, msg) in let ch = lct_x509_verify_chain(sy_chain(), sy_anchors(), sy_now()) in {manifest: manifest, msg: msg, seed: seed, sig: sig, nonce_ok: rnd.ok, nonce_err: rnd.err, nonce_len: lct_len(rnd.bytes), chain: ch, pk: lct_ed25519_public_key(seed)}
fn sy_s10(g, ss, cx, t0) = let v = if cx.chain.ok == 1 then lct_ed25519_verify(cx.chain.leaf_key, cx.msg, cx.sig) else 0 in let w1 = fs_write_sync(g.root + "/build/certification/synergy_gate_evidence.manifest", cx.manifest) in let w2 = fs_write_sync(g.root + "/build/certification/synergy_gate_evidence.sig.json", "{\"scheme\":\"Ed25519 (RFC 8032), compiler/stage1/lcrypto_tls.src\",\"signed_file\":\"synergy_gate_evidence.manifest\",\"manifest_sha256\":\"" + lsh256(cx.manifest) + "\",\"signature\":\"" + lct_bytes_to_hex(cx.sig) + "\",\"leaf_key\":\"" + lct_bytes_to_hex(cx.chain.leaf_key) + "\",\"chain\":\"lct_x509v_leaf <- lct_x509v_inter <- pinned lct_x509v_root, verified at " + str(sy_now()) + "\",\"what_this_means\":\"the leaf key is the RFC 8032 TEST 1 key (public seed): the mechanism composes, nobody is authenticated\"}\n") in sy_st("S10", "crypto closure", "lcrypto_tls (linked here): SHA-256, OS entropy health check, Ed25519, lct_x509_verify_chain", "synergy_gate_evidence.manifest (" + str(sy_len(ss, 0)) + " artifact hashes, signature " + slice(lct_bytes_to_hex(cx.sig), 0, 16) + "...)", lsh256(cx.manifest), (os_monotonic_ns() - t0) / 1000000, sy_first(sy_l6(sy_c(sy_all_sha(ss), "a stage left no artifact hash: the manifest would not cover the chain"), sy_c(sy_b(cx.nonce_ok == 1 and cx.nonce_len == 32), "the OS entropy health check refused the nonce draw (" + lct_entropy_err_name(cx.nonce_err) + ")"), sy_c(sy_b(cx.chain.ok == 1 and cx.chain.depth == 2), "lct_x509_verify_chain refused leaf <- inter <- pinned root: " + lct_x509_err_name(cx.chain.err) + " at " + str(cx.chain.at)), sy_c(lct_bytes_eq(cx.chain.leaf_key, cx.pk), "the key the chain verifier returned is not the key that signed the manifest"), sy_c(v, "the Ed25519 signature of the manifest does not verify under the key the chain verifier returned"), sy_c(sy_b(lct_len(cx.sig) == 64), "the signature is not 64 bytes"))))

## --- S11: the polyglot boundary of the kernel ---
fn sy_s11(g) = let w1 = fs_write_sync(g.tmp + "/boundary_ok.h", "int64_t rate_limit(int64_t prev, int64_t req, int64_t step);\n") in let w2 = fs_write_sync(g.tmp + "/boundary_bad.h", "int64_t rate_limit_log(const char *fmt, ...);\n") in let a = sy_x_adapt(g, "s11_ok", g.tmp + "/boundary_ok.h") in let b = sy_x_adapt(g, "s11_bad", g.tmp + "/boundary_bad.h") in sy_st("S11", "boundary contract", "lume adapt c (lchameleon / interop)", "adapter report of `int64_t rate_limit(int64_t, int64_t, int64_t)`", lsh256(a.out), a.ms + b.ms, sy_first(sy_l3(sy_c(sy_b(a.status == 0 and sy_has(a.out, "\"ok\":true") == 1 and sy_has(a.out, "\"symbol\":\"rate_limit\",\"adapter\":\"foreign_rate_limit\"") == 1), "the C boundary of rate_limit was not accepted (exit status " + str(a.status) + "): " + sy_short(a.out + a.err)), sy_c(sy_b(sy_has(a.out, "\"lume_type\":\"unverified[int]\",\"provenance\":\"foreign\"") == 1 and sy_has(a.out, "\"diagnostics\":[]") == 1), "the foreign result does not enter as unverified[int]"), sy_c(sy_b(b.status != 0 and sy_has(b.out, "\"ok\":false") == 1 and sy_has(b.out, "\"code\":\"I0003\"") == 1 and sy_has(b.out, "\"adapters\":[]") == 1), "the variadic boundary was not refused with [I0003] (exit status " + str(b.status) + "): " + sy_short(b.out + b.err)))))

## ====================================================================================================================
## Tamper matrix. Every row: corrupt one artifact, give it to the downstream module, require the stated refusal.
## ====================================================================================================================
fn sy_mut_src(g, tag, pat, rep) = let t = sy_rep1(g.kt, pat, rep, 0) in let p = g.tmp + "/" + tag + "/critical_pipeline.src" in let mk = sy_mkdir(g.tmp + "/" + tag) in let w = fs_write_sync(p, t) in {path: p, changed: sy_b(t != g.kt)}
fn sy_site(m) = if m.changed == 1 then "" else "the mutation site was not found: the artifact is unchanged; "
## (a) the source changes after certification
fn sy_ta(g, id, what, pat, rep) = let m = sy_mut_src(g, id, pat, rep) in let r = sy_x_vcert(g, id + "_vcert", m.path, g.cert) in sy_tm(id, "S03 -> S04", what, "lume verify-cert --check-source", "[K0010] + [K0013], \"ok\":false, exit 3", sy_site(m) + (if r.status == 3 and sy_has(r.out, "\"ok\":false") == 1 and sy_has(r.out, "[K0010]") == 1 and sy_has(r.out, "[K0013]") == 1 then "" else "UNDETECTED: lcert --check-source accepted the certificate for the changed source (exit status " + str(r.status) + "): " + sy_short(r.out + r.err)))
## (b) the certificate changes: a term edited and the certificate re-hashed (certificate_hash = sha256(source_hash | terms | obligations))
fn sy_cert_parts(cert) = let a = sy_index(cert, "\"proof_terms\":[", 0) in let b = sy_index(cert, "],\"obligations\":[", 0) in let c = sy_index(cert, "]}", if b < 0 then 0 else b) in if a < 0 or b < 0 or c < 0 then {ok: 0, sh: "", terms: "", obls: ""} else {ok: 1, sh: sy_jstr(cert, "source_hash"), terms: slice(cert, a + 15, b), obls: slice(cert, b + 17, c)}
fn sy_forge(p, terms) = "{\"ok\":true,\"source_hash\":\"" + p.sh + "\",\"certificate_hash\":\"sha256:" + lsh256(p.sh + "|" + terms + "|" + p.obls) + "\",\"proof_terms\":[" + terms + "],\"obligations\":[" + p.obls + "]}"
fn sy_tb1(g) = let p = sy_cert_parts(fs_read_file(g.cert)) in let t2 = sy_rep1(p.terms, "(<= (+ prev step) 10000)", "(<= (+ prev step) 9000)", 0) in let w0 = fs_write_sync(g.tmp + "/tb_same.json", sy_forge(p, p.terms)) in let w1 = fs_write_sync(g.tmp + "/tb1.json", sy_forge(p, t2)) in let c = sy_x_vcert_plain(g, "tb_same", g.tmp + "/tb_same.json") in let r = sy_x_vcert_plain(g, "tb1", g.tmp + "/tb1.json") in sy_tm("T-B1", "S03 -> S04", "certificate: a proof term falsified (`prev + step <= 10000` -> `<= 9000`), certificate re-hashed", "lume verify-cert (lcert kernel)", "\"ok\":false, \"hash_verified\":true, reason `independent QF_LIA kernel rejected proof term`, exit 3", (if p.ok == 1 and t2 != p.terms then "" else "the mutation site was not found in the certificate; ") + (if c.status == 0 and sy_has(c.out, "\"ok\":true") == 1 then "" else "control: the re-hashed, unmodified certificate must still verify (the forging procedure is wrong): " + sy_short(c.out) + "; ") + (if r.status == 3 and sy_has(r.out, "\"ok\":false") == 1 and sy_has(r.out, "\"hash_verified\":true") == 1 and sy_has(r.out, "independent QF_LIA kernel rejected proof term for 'rate_limit'") == 1 then "" else "UNDETECTED: lcert accepted a falsified, re-hashed proof term (exit status " + str(r.status) + "): " + sy_short(r.out + r.err)))
fn sy_tb2(g) = let p = sy_cert_parts(fs_read_file(g.cert)) in let t2 = sy_rep1(p.terms, "(<= (+ prev step) 10000)", "(<= (+ prev step) 10500)", 0) in let w1 = fs_write_sync(g.tmp + "/tb2.json", sy_forge(p, t2)) in let plain = sy_x_vcert_plain(g, "tb2_plain", g.tmp + "/tb2.json") in let r = sy_x_vcert(g, "tb2", g.k, g.tmp + "/tb2.json") in sy_tm("T-B2", "S03 -> S04", "certificate: a proof term replaced by a weaker TRUE statement (`<= 10500`), re-hashed; the plain kernel accepts it", "lume verify-cert --check-source", "[K0013], \"ok\":false, exit 3", (if p.ok == 1 and t2 != p.terms then "" else "the mutation site was not found in the certificate; ") + (if plain.status == 0 and sy_has(plain.out, "\"ok\":true") == 1 then "" else "control: the plain kernel should accept the weaker true term (the row would not test the binding): " + sy_short(plain.out) + "; ") + (if r.status == 3 and sy_has(r.out, "\"ok\":false") == 1 and sy_has(r.out, "[K0013] contract 'rate_limit'") == 1 then "" else "UNDETECTED: --check-source bound a term that is not the obligation of the source (exit status " + str(r.status) + "): " + sy_short(r.out + r.err)))
## (c) the proof cache
fn sy_tc1(g) = let d = g.tmp + "/tc1_cache" in let z = sy_rmrf(d) in let st = sy_x_pcache(g, "tc1_store", "store", g.k, d) in let f = sy_first_name(g, "tc1", d + "/proofs") in let old = fs_read_file(d + "/proofs/" + f) in let i = sy_index(old, "contract_digest=", 0) in let neu = if i < 0 then old else slice(old, 0, i + 16) + (if at(old, i + 16) == "0" then "1" else "0") + slice(old, i + 17, count(old)) in let w = fs_write_sync(d + "/proofs/" + f, neu) in let ck = sy_x_pcache(g, "tc1_check", "check", g.k, d) in sy_tm("T-C1", "S02", "proof cache: one digit of contract_digest changed in a stored record (the seal left as it was)", "lume proof-cache check", "[PC0002], exit 3, no \"all_cached\":true", (if st.status == 0 and f != "" and neu != old then "" else "the cache record was not tampered; ") + (if ck.status == 3 and sy_has(ck.err + ck.out, "[PC0002]") == 1 and sy_has(ck.out, "\"all_cached\":true") == 0 then "" else "UNDETECTED: the proof cache answered from a tampered record (exit status " + str(ck.status) + "): " + sy_short(ck.out + ck.err)))
fn sy_tc2(g) = let m = sy_mut_src(g, "tc2", "rate_limit(prev, 9000, step)", "rate_limit(prev, 9001, step)") in let ck = sy_x_pcache(g, "tc2_check", "check", m.path, g.tmp + "/pcache") in sy_tm("T-C2", "S02", "proof cache of S02 asked about a source whose actuator_cmd constant changed (9000 -> 9001)", "lume proof-cache check", "\"all_cached\":false, 4 hits of 5, missed_functions [actuator_cmd]: recomputed, not a warm hit", sy_site(m) + (if sy_has(ck.out, "\"all_cached\":false") == 1 and sy_field(ck.out, "hits") == 4 and sy_field(ck.out, "misses") == 1 and sy_has(ck.out, "\"missed_functions\":[\"actuator_cmd\"]") == 1 then "" else "UNDETECTED: the proof cache gave a warm hit for a changed function (exit status " + str(ck.status) + "): " + sy_short(ck.out + ck.err)))
## (d), (e) the emitted assembly
fn sy_mut_asm(g, tag, fnm, pat, rep) = let asm = fs_read_file(g.asm) in let at0 = sy_index(asm, "\n" + fnm + ":\n", 0) in let a2 = sy_rep1(asm, pat, rep, at0) in let p = g.tmp + "/" + tag + ".s" in let w = fs_write_sync(p, a2) in {path: p, changed: sy_b(at0 >= 0 and a2 != asm)}
fn sy_tv_rej(g, id, m, fnm, marker, what, diag) = let r = sy_x_tv(g, id + "_tv", g.k, m.path, g.tmp + "/" + id + "_proofs", 0) in sy_tm(id, "S06 -> S07", what, "ltv", diag, sy_site(m) + (if r.status != 0 and sy_has(r.out, "\"ok\":false") == 1 and sy_has(r.out, "\"name\":\"" + fnm + "\",\"status\":\"rejected\",\"reason\":\"" + marker) == 1 and sy_has(r.out, "\"name\":\"" + fnm + "\",\"status\":\"validated\"") == 0 then "" else "UNDETECTED: ltv did not reject " + fnm + " (exit status " + str(r.status) + "): " + sy_short(r.out + r.err)))
fn sy_td1(g) = sy_tv_rej(g, "T-D1", sy_mut_asm(g, "T-D1", "rate_limit", "    addq %rsi, %rax\n", "    subq %rsi, %rax\n"), "rate_limit", "", "assembly: the first `addq %rsi, %rax` of rate_limit turned into `subq`", "\"name\":\"rate_limit\",\"status\":\"rejected\", exit 3")
fn sy_td2(g) = sy_tv_rej(g, "T-D2", sy_mut_asm(g, "T-D2", "actuator_cmd", "$18001", "$18003"), "actuator_cmd", "", "assembly: the constant 9000 of actuator_cmd (word $18001) turned into 9001 ($18003)", "\"name\":\"actuator_cmd\",\"status\":\"rejected\", exit 3")
fn sy_te1(g) = sy_tv_rej(g, "T-E1", sy_mut_asm(g, "T-E1", "ct_select32", "    movq %rdx, -24(%rbp)\n", "    movq %rdx, -24(%rbp)\n    testq %rdi, %rdi\n    jz .Lsy_ct_inj\n.Lsy_ct_inj:\n"), "ct_select32", "[C0010]", "assembly: `testq %rdi, %rdi; jz` on the secret mask inserted in constant-time kernel ct_select32", "[C0010] secret-dependent conditional branch, exit 3")
## a source that the compiler must refuse: `lume build --critical -g` leaves no ELF and prints the code
fn sy_build_rej(g, id, m, code, stage, what) = let out = g.tmp + "/" + id + ".elf" in let r = sy_x_build(g, id + "_build", m.path, out) in sy_tm(id, stage, what, "lume build --critical -g (lumec)", "[" + code + "], non-zero exit, no ELF", sy_site(m) + (if r.status != 0 and sy_has(r.out + r.err, "[" + code + "]") == 1 and fs_path_exists(out) == 0 then "" else "UNDETECTED: the build did not refuse the source with [" + code + "] (exit status " + str(r.status) + ", ELF " + str(fs_path_exists(out)) + "): " + sy_short(r.out + r.err)))
fn sy_ct_body() = "-> int = bit_xor(b, bit_and(mask, bit_xor(a, b)))"
fn sy_te2(g) = sy_build_rej(g, "T-E2", sy_mut_src(g, "T-E2", sy_ct_body(), "-> int = if mask == 0 then b else a"), "C0009", "S01 -> S06", "source: constant-time kernel ct_select32 rewritten with an `if` on the secret mask")
fn sy_te3(g) = sy_build_rej(g, "T-E3", sy_mut_src(g, "T-E3", sy_ct_body(), "-> int = if 1 == 1 then bit_xor(b, bit_and(mask, bit_xor(a, b))) else a"), "C0011", "S01 -> S06", "source: an `if` on a public constant added to constant-time kernel ct_select32 (no straight-line lowering)")
## (f) the .smt2 certificates
fn sy_tf(g, id, what, pat, rep, diag, key) = let nm = "critical_pipeline__rate_limit.smt2" in let old = fs_read_file(g.proofs + "/" + nm) in let i0 = sy_index(old, "(define-fun val_x86", 0) in let neu = sy_rep1(old, pat, rep, if sy_has(pat, "(assert") == 1 then 0 else i0) in let d = g.tmp + "/" + id in let mk = sy_mkdir(d) in let w = fs_write_sync(d + "/" + nm, neu) in let r = sy_x_smt(g, id + "_smt", d) in sy_tm(id, "S07 -> S07-SMT", what, "lsmt", diag, (if old != "" and neu != old then "" else "the mutation site was not found in the certificate; ") + (if r.status != 0 and sy_has(r.out, "\"ok\":false") == 1 and sy_field(r.out, "unsat") == 0 and sy_field(r.out, key) == 1 then "" else "UNDETECTED: lsmt did not refuse the edited certificate (exit status " + str(r.status) + "): " + sy_short(r.out + r.err)))
fn sy_tf1(g) = sy_tf(g, "T-F1", ".smt2: the value term of the machine code edited (`(+ x_prev x_step)` -> `(+ x_prev (* 2 x_step))`)", "(+ x_prev x_step)", "(+ x_prev (* 2 x_step))", "verdict `unknown` (not `unsat`), \"ok\":false, non-zero exit", "unknown")
fn sy_tf2(g) = sy_tf(g, "T-F2", ".smt2: the claim replaced by `(assert false)` (trivially unsat for a solver)", "(assert (not (and (= trap_ast trap_x86) (=> (not trap_ast) (and ret_x86 (= val_ast val_x86))))))", "(assert false)", "verdict `forged`, \"ok\":false, non-zero exit", "forged")
## (g) a runtime helper
fn sy_tg1(g) = let m = sy_mut_asm(g, "T-G1", "addv", "    jo .Lrt_av_big\n", "    jno .Lrt_av_big\n") in let r = sy_x_tvrt(g, "T-G1_tvrt", m.path) in sy_tm("T-G1", "S06 -> S07-RT", "assembly: `jo .Lrt_av_big` of runtime helper addv turned into `jno` (overflow test inverted)", "ltv_rt", "\"rejections\":[{\"name\":\"addv\",...}], helpers_rejected 1, exit 3", sy_site(m) + (if r.status != 0 and sy_has(r.out, "\"ok\":false") == 1 and sy_has(r.out, "\"rejections\":[{\"name\":\"addv\",\"reason\":\"") == 1 and sy_field(r.out, "helpers_rejected") == 1 then "" else "UNDETECTED: ltv_rt verified a mutated addv (exit status " + str(r.status) + "): " + sy_short(r.out + r.err)))
## (h) the stack bound
fn sy_th1(g) = let m = sy_mut_asm(g, "T-H1", "rate_limit", "    subq $64, %rsp\n", "    subq $80, %rsp\n") in let r = sy_x_stack(g, "T-H1_stack", g.k, m.path) in let base = fs_read_file(g.tmp + "/s06_stack.out") in let b0 = sy_stack1(base, "rate_limit") in let b1 = sy_stack1(r.out, "rate_limit") in let c0 = sy_stack1(base, "actuator_cmd") in let c1 = sy_stack1(r.out, "actuator_cmd") in sy_tm("T-H1", "S06 -> S05", "assembly: the frame of rate_limit enlarged by 16 bytes (`subq $64` -> `subq $80`)", "lstack", "the bound of rate_limit and of its caller actuator_cmd grows by exactly 16 bytes", sy_site(m) + (if r.status == 0 and b0 > 0 and b1 == b0 + 16 and c0 > 0 and c1 == c0 + 16 and sy_stack1(r.out, "ct_add32") == sy_stack1(base, "ct_add32") then "" else "UNDETECTED: lstack reports rate_limit " + str(b0) + " -> " + str(b1) + ", actuator_cmd " + str(c0) + " -> " + str(c1) + " for 16 injected bytes"))
fn sy_th2(g) = let m = sy_mut_asm(g, "T-H2", "rate_limit", ".Ltail_rate_limit:\n", ".Ltail_rate_limit:\n    call rate_limit\n") in let r = sy_x_stack(g, "T-H2_stack", g.k, m.path) in sy_tm("T-H2", "S06 -> S05", "assembly: a non-tail `call rate_limit` inserted in rate_limit", "lstack", "\"name\":\"rate_limit\",\"status\":\"rejected\", `call cycle rate_limit -> rate_limit`, exit 3", sy_site(m) + (if r.status == 3 and sy_has(r.out, "\"name\":\"rate_limit\",\"status\":\"rejected\"") == 1 and sy_has(r.out + r.err, "call cycle rate_limit -> rate_limit") == 1 and sy_stack1(r.out, "rate_limit") < 0 then "" else "UNDETECTED: lstack gave a bound to a recursive rate_limit (exit status " + str(r.status) + "): " + sy_short(r.out + r.err)))
fn sy_th3(g) = sy_build_rej(g, "T-H3", sy_mut_src(g, "T-H3", "then prev - step else req\n", "then prev - step else count(str(req))\n"), "E0210", "S01 -> S06", "source: `@no_alloc` kernel rate_limit edited to allocate (`count(str(req))`)")
## (i) structural coverage
fn sy_ti1(g) = let m = sy_mut_src(g, "T-I1", "then prev - step else req\n", "then prev - step else if req * (180 - req) > 40500 then req else req\n") in let r = sy_x_mcdc(g, "T-I1_mcdc", m.path) in sy_tm("T-I1", "S01 -> S08", "source: a dead branch added to rate_limit (`req * (180 - req) > 40500` never holds)", "lume mcdc --exec (lmcdc)", "\"uncovered\":2, rate_limit not fully covered", sy_site(m) + (if r.status == 0 and sy_field(r.out, "uncovered") == 2 and sy_field(r.out, "functions_fully_covered") == 2 and sy_has(r.out, "\"uncovered_list\":[{\"function\":\"rate_limit\"") == 1 then "" else "UNDETECTED: lmcdc reports " + str(sy_field(r.out, "uncovered")) + " uncovered obligations for a dead branch (exit status " + str(r.status) + "): " + sy_short(r.out + r.err)))
## (j) the safety envelope
fn sy_tj(g, id, inj, reason, what) = let r = sy_env(g, id + "_env", "@args 100,900,50\n", "@inject " + inj + "\n") in sy_tm(id, "S09", what, "lsafety_envelope (voter)", "SAFE_STATE_TRIP " + reason + ", exit 2, no commit", if r.status == 2 and sy_has(r.out, "\"inject\":\"" + inj + "\"") == 1 and sy_has(r.out, "\"state\":\"SAFE_STATE_TRIP\",\"value\":null") == 1 and sy_has(r.out, "\"reason\":\"" + reason + "\"") == 1 and sy_has(r.out, "VerifiedActuatorCommit") == 0 and sy_has(r.out, "\"committed\":0,\"tripped\":1,\"final_latched\":1") == 1 then "" else "UNDETECTED: the envelope did not trip with " + reason + " under @inject " + inj + " (exit status " + str(r.status) + "): " + sy_short(r.out + r.err))
fn sy_tj6(g) = let d = g.split in let a = d + "/channel_a_x86_64.elf" in let b = "lumeputer:" + d + "/channel_b_riscv_bare.bin" in let good = sy_split_run(g, "tj6_good", d, 31, "100,900,50", a, b, "@reset 1\n") in let fa = sy_frame(good.out, "channel_a") in let flip = slice(fa, 0, 133) + (if at(fa, 133) == "0" then "1" else "0") + slice(fa, 134, count(fa)) in let w = fs_write_sync(g.tmp + "/tj6_fa", flip + "\n") in let r = sy_split_run(g, "tj6_bad", d, 31, "100,900,50", "cat " + g.tmp + "/tj6_fa", b, "@reset 1\n") in sy_tm("T-J6", "S09-SPLIT", "split frame: one bit of channel A's response frame flipped on the wire", "lsafety_envelope @mode split-run", "SAFE_STATE_TRIP a_frame_crc, exit 2", (if sy_sp_commit(good, 150) == 1 and count(fa) == 160 then "" else "control: the unmodified frames must commit; ") + (if sy_sp_trip(r, "a_frame_crc") == 1 then "" else "UNDETECTED: a frame with a flipped bit was voted (exit status " + str(r.status) + "): " + sy_short(r.out + r.err)))
fn sy_tj7(g) = let d = g.split in let a = d + "/channel_a_x86_64.elf" in let b = "lumeputer:" + d + "/channel_b_riscv_bare.bin" in let good = sy_split_run(g, "tj7_good", d, 41, "100,900,50", a, b, "@reset 1\n") in let w1 = fs_write_sync(g.tmp + "/tj7_fa", sy_frame(good.out, "channel_a") + "\n") in let w2 = fs_write_sync(g.tmp + "/tj7_fb", sy_frame(good.out, "channel_b") + "\n") in let r = sy_split_run(g, "tj7_bad", d, 42, "100,900,50", "cat " + g.tmp + "/tj7_fa", "cat " + g.tmp + "/tj7_fb", "@reset 1\n") in let r2 = sy_split_req(g, "tj7_again", "tj7_good", d, 41, "100,900,50", "cat " + g.tmp + "/tj7_fa", "cat " + g.tmp + "/tj7_fb", "") in sy_tm("T-J7", "S09-SPLIT", "split frames: the recorded frames of sequence 41 replayed for request 42, and again for a second request 41", "lsafety_envelope @mode split-run", "SAFE_STATE_TRIP a_frame_sequence; SAFE_STATE_TRIP sequence_not_fresh; exit 2", (if sy_sp_commit(good, 150) == 1 then "" else "control: sequence 41 must commit; ") + (if sy_sp_trip(r, "a_frame_sequence") == 1 then "" else "UNDETECTED: replayed frames were voted for a newer request (exit status " + str(r.status) + "): " + sy_short(r.out + r.err) + "; ") + (if sy_sp_trip(r2, "sequence_not_fresh") == 1 then "" else "UNDETECTED: a sequence number was accepted twice (exit status " + str(r2.status) + "): " + sy_short(r2.out + r2.err)))
fn sy_tj8(g) = let d = g.tmp + "/split_badman" in let z = sy_rmrf(d) in let c = sy_cpr(g.split, d) in let man = fs_read_file(d + "/manifest.json") in let i = sy_index(man, "\"channel_b_riscv_bare\":{", 0) in let j = if i < 0 then 0 - 1 else sy_index(man, "\"sha256\":\"", i) in let m2 = if j < 0 then man else slice(man, 0, j + 10) + (if at(man, j + 10) == "0" then "1" else "0") + slice(man, j + 11, count(man)) in let w = fs_write_sync(d + "/manifest.json", m2) in let r = sy_x_env(g, "tj8_spv", "@mode split-verify\n@manifest " + d + "/manifest.json\n") in sy_tm("T-J8", "S09-SPLIT", "split manifest: the SHA-256 of channel B's image altered by one digit", "lsafety_envelope @mode split-verify", "\"ok\":false, names channel_b_riscv_bare, exit 2", (if m2 != man then "" else "the manifest was not altered; ") + (if r.status == 2 and sy_has(r.out, "\"mode\":\"split-verify\",\"ok\":false") == 1 and sy_has(r.out, "channel_b_riscv_bare") == 1 then "" else "UNDETECTED: split-verify accepted a manifest whose artifact hash was altered (exit status " + str(r.status) + "): " + sy_short(r.out + r.err)))
## (k) the cartridge
fn sy_tk1(g) = let bs = lnc_read_file(g.cart) in let n = lnc_len(bs, 0) in let p = g.tmp + "/tk1.safetensors" in let w = fs_write_hex_file(p, lnc_hex(lct_flip(bs, n - 200, 1))) in let c = lnc_load_file(p) in sy_tm("T-K1", "S09-STN", "safetensors: one bit of a tensor byte flipped on disk (byte " + str(n - 200) + " of " + str(n) + ")", "lneural_cartridge strict loader (lnc_load_file)", "the loader refuses the file: tensors_sha256 mismatch", (if n > 1000 and sy_sha_file(p) != sy_sha_file(g.cart) and sy_sha_file(p) != "" then "" else "the cartridge copy was not altered; ") + (if c.err != "" and sy_has(c.err, "sha256") == 1 then "" else "UNDETECTED: the loader accepted a cartridge with a flipped byte: " + c.err))
## (l) the signed manifest and its chain
fn sy_tl(id, what, detector, diag, bad) = sy_tm(id, "S10", what, detector, diag, bad)
## index of the first byte of the subject public key in the leaf certificate (after the BIT STRING header 03 21 00)
fn sy_leaf_key_at() = let h = lct_bytes_to_hex(lct_x509v_leaf()) in let i = sy_index(h, "032100d75a980182b10ab7", 0) in if i < 0 or i % 2 != 0 then 0 else i / 2 + 3
fn sy_chain_err(chain, anchors, now, want) = let r = lct_x509_verify_chain(chain, anchors, now) in if r.ok == 0 and r.err == want and lct_len(r.leaf_key) == 0 then "" else "UNDETECTED: lct_x509_verify_chain answered ok " + str(r.ok) + ", error " + str(r.err) + " (" + lct_x509_err_name(r.err) + "), expected error " + str(want)
fn sy_entropy_bad(good) = if lct_entropy_check(lct_zeros(512), 512) == 2 and good.ok == 1 and lct_entropy_check(good.bytes, 512) == 0 and lct_entropy_check2(good.bytes, good.bytes, 512) == 6 then "" else "UNDETECTED: the entropy health check accepts a degenerate block (zeros: " + str(lct_entropy_check(lct_zeros(512), 512)) + ", repeat: " + str(lct_entropy_check2(good.bytes, good.bytes, 512)) + ")"
fn sy_tl_rows(cx) = let key = cx.chain.leaf_key in let m2 = lct_flip(cx.msg, 40, 1) in sy_l6(sy_tl("T-L1", "manifest: one bit changed after signing", "lct_ed25519_verify under the chain's leaf key", "signature invalid (0)", if lct_len(key) == 32 and lct_ed25519_verify(key, cx.msg, cx.sig) == 1 and lct_ed25519_verify(key, m2, cx.sig) == 0 then "" else "UNDETECTED: the signature verifies for an altered manifest"), sy_tl("T-L2", "signature: one bit flipped", "lct_ed25519_verify under the chain's leaf key", "signature invalid (0)", if lct_len(key) == 32 and lct_ed25519_verify(key, cx.msg, lct_flip(cx.sig, 40, 1)) == 0 and lct_ed25519_verify(key, cx.msg, lct_flip(cx.sig, 5, 128)) == 0 then "" else "UNDETECTED: an altered signature verifies"), sy_tl("T-L3", "leaf certificate: one bit of its subject public key flipped (DER still well formed)", "lct_x509_verify_chain", "error 50 (bad signature), no key returned", sy_chain_err(Cons(lct_flip(lct_x509v_leaf(), sy_leaf_key_at() + 5, 1), Cons(lct_x509v_inter(), Nil)), sy_anchors(), sy_now(), 50)), sy_tl("T-L4", "time: the chain verified at 2030-01-01 (leaf notAfter is 2028-01-01)", "lct_x509_verify_chain", "error 43 (expired), no key returned", sy_chain_err(sy_chain(), sy_anchors(), 1893456000, 43)), sy_tl("T-L5", "trust anchor: another pinned certificate (a self-signed certificate of another key) instead of the root", "lct_x509_verify_chain", "error 51 (unknown issuer), no key returned", sy_chain_err(sy_chain(), Cons(lct_x509_anchor_cert(lct_x509v_selfleaf()), Nil), sy_now(), 51)), sy_tl("T-L6", "entropy: an all-zero 512-byte block, and a block that repeats the previous read", "lct_entropy_check / lct_entropy_check2", "defect 2 (every byte is zero); defect 6 (repeated read)", sy_entropy_bad(lct_random_bytes_checked(512))))
## (m) a false theorem
fn sy_tm_false(g, id, m, nm, knd, what) = let r = sy_x_prove(g, id + "_prove", m.path) in let out = g.tmp + "/" + id + ".elf" in let b = sy_x_build(g, id + "_build", m.path, out) in sy_tm(id, "S01, S06", what, "lume prove (lcaas); lume build --critical -g (lumec)", "\"status\":\"refuted\" with a counterexample, \"code\":\"V0001\"; the build stops with [V0001] and leaves no ELF", sy_site(m) + (if sy_has(r.out, "\"ok\":false") == 1 and sy_has(r.out, "\"code\":\"V0001\"") == 1 and sy_has(r.out, "\"name\":\"" + nm + "\",\"kind\":\"" + knd + "\",\"status\":\"refuted\"") == 1 and sy_has(r.out, "\"name\":\"" + nm + "\",\"kind\":\"" + knd + "\",\"status\":\"proven\"") == 0 then "" else "UNDETECTED: lume prove did not refute " + nm + ": " + sy_short(r.out + r.err) + "; ") + (if b.status != 0 and sy_has(b.out + b.err, "[V0001]") == 1 and fs_path_exists(out) == 0 then "" else "UNDETECTED: the build accepted a refuted " + knd + " (exit status " + str(b.status) + "): " + sy_short(b.out + b.err)))
fn sy_tm1(g) = let t = g.kt + "law rate_limit_never_moves(prev: int, req: int, step: int) = if prev >= 0 and prev <= 10000 and req >= 0 and req <= 10000 and step >= 1 and step <= 500 then rate_limit(prev, req, step) == prev else 1 == 1\n" in let mk = sy_mkdir(g.tmp + "/T-M1") in let w = fs_write_sync(g.tmp + "/T-M1/critical_pipeline.src", t) in sy_tm_false(g, "T-M1", {path: g.tmp + "/T-M1/critical_pipeline.src", changed: 1}, "rate_limit_never_moves", "law", "source: a false law added (`rate_limit(prev, req, step) == prev`)")
fn sy_tm2(g) = sy_tm_false(g, "T-M2", sy_mut_src(g, "T-M2", "ensures result >= 0 and result <= 10000 = if req > 9000", "ensures result >= 0 and result <= 9000 = if req > 9000"), "actuator_cmd", "contract", "source: the ensures of actuator_cmd strengthened to a false bound (`result <= 9000`)")

fn sy_tampers_1(g) = Cons(sy_ta(g, "T-A1", "source: `requires` of rate_limit weakened after certification (`step <= 500` -> `step <= 501`)", "step <= 500 ensures result >= 0 and result <= 10000 and result - prev", "step <= 501 ensures result >= 0 and result <= 10000 and result - prev"), Cons(sy_ta(g, "T-A2", "source: a constant of actuator_cmd changed after certification (9000 -> 9001)", "rate_limit(prev, 9000, step)", "rate_limit(prev, 9001, step)"), Cons(sy_tb1(g), Cons(sy_tb2(g), Cons(sy_tc1(g), Cons(sy_tc2(g), Cons(sy_td1(g), Cons(sy_td2(g), Cons(sy_te1(g), Cons(sy_te2(g), Cons(sy_te3(g), Cons(sy_tf1(g), Cons(sy_tf2(g), Cons(sy_tg1(g), Cons(sy_th1(g), Cons(sy_th2(g), Cons(sy_th3(g), Cons(sy_ti1(g), Nil))))))))))))))))))
fn sy_tampers_2(g) = Cons(sy_tj(g, "T-J1", "a_src:arith:0", "a_compile_failed", "envelope: channel A compiles a source mutant (arithmetic operator), channel B the original"), Cons(sy_tj(g, "T-J2", "b_src:arith:0", "b_ebreak_contract_violation", "envelope: channel B compiles a source mutant (arithmetic operator), channel A the original"), Cons(sy_tj(g, "T-J3", "b_cg:reg:0", "b_ebreak_contract_violation", "envelope: a register of channel B's generated code corrupted"), Cons(sy_tj(g, "T-J4", "a_asm:addsub:1", "lockstep_mismatch", "envelope: an add/sub of channel A's emitted assembly mutated before lasm"), Cons(sy_tj(g, "T-J5", "b_rom:60:20", "b_ram_misaligned", "envelope: one bit of channel B's ROM flipped before reset"), Cons(sy_tj6(g), Cons(sy_tj7(g), Cons(sy_tj8(g), Cons(sy_tk1(g), Nil)))))))))
fn sy_tampers_3(g, cx) = sy_app(sy_tl_rows(cx), Cons(sy_tm1(g), Cons(sy_tm2(g), Nil)))

## ====================================================================================================================
## Report
## ====================================================================================================================
fn sy_passed(xs) = match xs
    Nil        => 0
    Cons(h, t) => h.ok + sy_passed(t)
fn sy_stages_json(ss) = match ss
    Nil        => ""
    Cons(s, t) => "{\"id\":\"" + s.id + "\",\"stage\":\"" + sy_jesc(s.title) + "\",\"tool\":\"" + sy_jesc(s.tool) + "\",\"artifact\":\"" + sy_jesc(s.art) + "\",\"artifact_sha256\":\"" + s.sha + "\",\"ms\":" + str(s.ms) + ",\"pass\":" + (if s.ok == 1 then "true" else "false") + ",\"failure\":\"" + sy_jesc(s.note) + "\"}" + (if sy_len(t, 0) == 0 then "" else ",") + sy_stages_json(t)
fn sy_tampers_json(ts) = match ts
    Nil        => ""
    Cons(x, t) => "{\"id\":\"" + x.id + "\",\"stage\":\"" + x.stage + "\",\"corruption\":\"" + sy_jesc(x.corruption) + "\",\"detector\":\"" + sy_jesc(x.detector) + "\",\"diagnostic\":\"" + sy_jesc(x.diag) + "\",\"caught\":" + (if x.ok == 1 then "true" else "false") + ",\"failure\":\"" + sy_jesc(x.note) + "\"}" + (if sy_len(t, 0) == 0 then "" else ",") + sy_tampers_json(t)
fn sy_stage_lines(ss) = match ss
    Nil        => ""
    Cons(s, t) => (if s.ok == 1 then "  ok   " else "  FAIL ") + s.id + " " + s.title + " [" + s.tool + "] " + str(s.ms) + " ms: " + (if s.ok == 1 then s.art else s.note) + "\n" + sy_stage_lines(t)
fn sy_tamper_lines(ts) = match ts
    Nil        => ""
    Cons(x, t) => (if x.ok == 1 then "  caught     " else "  UNDETECTED ") + x.id + " (" + x.stage + ") " + x.corruption + " => " + x.detector + ": " + (if x.ok == 1 then x.diag else x.note) + "\n" + sy_tamper_lines(t)
fn sy_missing(g, xs) = match xs
    Nil        => ""
    Cons(h, t) => (if fs_path_exists(if at(h, 0) == "/" then h else g.bin + "/" + h) == 1 then "" else h + " ") + sy_missing(g, t)
fn sy_needed() = Cons("lume_driver", Cons("lumec", Cons("lasm", Cons("lcaas", Cons("lcert", Cons("lproof_cache", Cons("lstack", Cons("ltv", Cons("ltv_rt", Cons("lsmt", Cons("lmcdc", Cons("lsafety_envelope", Cons("lneural_cartridge", Cons("/usr/bin/readelf", Cons("/usr/bin/nm", Cons("/usr/bin/addr2line", Cons("/usr/bin/qemu-system-riscv32", Cons("/usr/bin/qemu-aarch64", Cons("/usr/bin/qemu-riscv64", Nil)))))))))))))))))))
fn sy_cfg(root, tmp) = let kt = sy_kernel() in {root: root, bin: root + "/build/bin", tmp: tmp, kt: kt, ksha: lsh256(kt), k: tmp + "/critical_pipeline.src", demo: tmp + "/critical_pipeline_demo.src", elf: tmp + "/critical_pipeline_demo.elf", asm: tmp + "/critical_pipeline_demo.elf.s", cert: tmp + "/critical_pipeline.cert.json", proofs: tmp + "/proofs", split: tmp + "/split", cart: tmp + "/critical_pipeline.safetensors"}
fn sy_examples(g) = let a = fs_read_file(g.root + "/examples/synergy/critical_pipeline.src") in let b = fs_read_file(g.root + "/examples/synergy/critical_pipeline_demo.src") in if sy_code(a) != sy_code(sy_kernel()) then "examples/synergy/critical_pipeline.src is not the kernel module this gate runs (compare its code lines with sy_kernel)" else if sy_code(b) != sy_code(sy_demo()) then "examples/synergy/critical_pipeline_demo.src is not the program this gate builds" else ""
fn sy_stages_a(g) = let s1 = sy_s01(g) in let s2 = sy_s02(g) in let s3 = sy_s03(g) in let s4 = sy_s04(g) in let s4p = sy_s04par(g) in let s5 = sy_s05(g) in let s6 = sy_s06(g) in let s7 = sy_s07(g) in let s7r = sy_s07rt(g) in let s7s = sy_s07smt(g) in let s8 = sy_s08(g) in let s9 = sy_s09(g) in let s9s = sy_s09split(g) in let s9i = sy_s09isa(g) in let s9n = sy_s09stn(g) in Cons(s1, Cons(s2, Cons(s3, Cons(s4, Cons(s4p, Cons(s5, Cons(s6, Cons(s7, Cons(s7r, Cons(s7s, Cons(s8, Cons(s9, Cons(s9s, Cons(s9i, Cons(s9n, Nil)))))))))))))))
fn sy_finish(g, t0, ss, ts, keep) = let ns = sy_len(ss, 0) in let nt = sy_len(ts, 0) in let ps = sy_passed(ss) in let pt = sy_passed(ts) in let ms = (os_monotonic_ns() - t0) / 1000000 in let ok = if ps == ns and pt == nt then 1 else 0 in let json = "{\"gate\":\"synergy_gate\",\"ok\":" + (if ok == 1 then "true" else "false") + ",\"kernel_module\":\"examples/synergy/critical_pipeline.src\",\"kernel_sha256\":\"" + g.ksha + "\",\"stages_total\":" + str(ns) + ",\"stages_passed\":" + str(ps) + ",\"tampers_total\":" + str(nt) + ",\"tampers_caught\":" + str(pt) + ",\"tampers_undetected\":" + str(nt - pt) + ",\"ltv_tvint_fields_mandatory\":" + (if sy_expect_tvint() == 1 then "true" else "false") + ",\"duration_ms\":" + str(ms) + ",\"evidence_manifest\":\"build/certification/synergy_gate_evidence.manifest\",\"evidence_signature\":\"build/certification/synergy_gate_evidence.sig.json\",\"stages\":[" + sy_stages_json(ss) + "],\"tamper_matrix\":[" + sy_tampers_json(ts) + "]}\n" in let w = fs_write_sync(g.root + "/build/certification/synergy_gate_summary.json", json) in let rm = if ok == 1 and keep == 0 then sy_rmrf(g.tmp) else 0 in let text = "synergy gate: kernel module sha256 " + g.ksha + "\nstages\n" + sy_stage_lines(ss) + "tamper matrix\n" + sy_tamper_lines(ts) in if ok == 1 then text + "OK: synergy gate: stages: " + str(ns) + " passed; tamper matrix: " + str(pt) + " of " + str(nt) + " caught; 0 undetected; " + str(ms) + " ms" else let o = fs_write_sync("/dev/stdout", text) in ctfail("synergy gate FAILED: stages: " + str(ps) + " of " + str(ns) + " passed; tamper matrix: " + str(pt) + " of " + str(nt) + " caught; " + str(nt - pt) + " undetected; the summary is build/certification/synergy_gate_summary.json, the scratch directory " + g.tmp + "\n")
fn sy_go(g, keep) = let t0 = os_monotonic_ns() in let mk = sy_mkdir(g.tmp) in let mc = sy_mkdir(g.root + "/build/certification") in let w1 = fs_write_sync(g.k, g.kt) in let w2 = fs_write_sync(g.demo, sy_demo()) in if sy_sha_file(g.k) != g.ksha then ctfail("synergy gate failed: the kernel module was not written to " + g.k + "\n") else let ss = sy_stages_a(g) in let tc = os_monotonic_ns() in let cx = sy_crypto(g, ss, sy_leaf_seed()) in let s10 = sy_s10(g, ss, cx, tc) in let s11 = sy_s11(g) in let ts = sy_app(sy_tampers_1(g), sy_app(sy_tampers_2(g), sy_tampers_3(g, cx))) in sy_finish(g, t0, sy_app(ss, Cons(s10, Cons(s11, Nil))), ts, keep)
fn sy_main(input) = let root = sy_get(input, "root") in if root == "" then ctfail("synergy gate requires @root\n") else let tmp = if sy_get(input, "tmp") != "" then sy_get(input, "tmp") else "/tmp/lume-synergy-gate." + str(os_getpid()) in let g = sy_cfg(root, tmp) in let miss = sy_missing(g, sy_needed()) in if miss != "" then ctfail("synergy gate failed: missing tool or emulator (a missing tool is a failure, not a skip): " + miss + "\n") else let e = sy_examples(g) in if e != "" then ctfail("synergy gate failed: " + e + "\n") else sy_go(g, if sy_get(input, "keep") == "1" then 1 else 0)

print sy_main(readall())
