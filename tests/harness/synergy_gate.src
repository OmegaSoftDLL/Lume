## synergy_gate.src -- the end-to-end cross-module synergy gate (Wave 14).
##   printf '@root %s\n' "$PWD" | build/bin/synergy_gate            [@tmp <dir>]   [@keep 1: leave the scratch directory]
##
## ONE pipeline over ONE kernel module (examples/synergy/critical_pipeline.src; the gate carries the same code and
## refuses to run when the two differ), every stage run through the real tool and fed the artifact the stage before it
## produced. Nothing is mocked and no verdict is written by this file: each assertion reads the exit status and the
## output of the tool, and each hash is recomputed here from the file on disk.
##
##   S01 prove            lume prove                       3 obligations proven, 2 budget-checked, 0 refuted / runtime
##   S02 proof-cache      lume proof-cache store, check    cold store, then every function a warm hit
##   S03 certify          lume certify                     certificate JSON; its source_hash is the kernel file's
##   S04 verify-cert      lume verify-cert --check-source  every obligation bound to THIS file
##   S05 stack            lstack (--critical code)         every `@no_alloc` kernel bounded, bytes recorded
##   S04-PAR parity       lume certify, lume verify-cert   the proof service and the certificate kernel give the SAME
##                                                         kernel verdict for a contract over bit operations
##   S06 build            lume build --critical -g         the demo program (`use critical_pipeline`) runs, DWARF line
##                                                         table read back by readelf / nm / addr2line; the stack
##                                                         bounds of the `.s` that was assembled equal those of S05
##   S07 tv               ltv --critical @exec 1           on the `.s` S06 left: 6 of 6 validated, 3 constant-time
##                                                         kernels checked transitively ([C0010]); source and assembly
##                                                         hashes in the report are the files of S03 and S06
##   S07-RT tv-rt         ltv_rt                           every integer runtime helper of the same `.s` verified
##   S07-SMT smt-check    lsmt                             every .smt2 certificate S07 wrote is `unsat`
##   S08 mcdc             lume mcdc --exec                 0 uncovered, witnesses confirmed by the real binary
##   S09 envelope         lsafety_envelope                 2oo2D commit on three vectors through the real ltv; channel
##                                                         B's tool links no compiler module
##   S09-SPLIT            @split, split-verify, split-run  native x86-64 A against the bare RV32IM image on
##                                                         qemu-system-riscv32 and on the in-tool LumePuter
##   S09-ISA              the limiter alone (lkir fragment) qemu-aarch64 A + qemu-system-riscv32 B + qemu-riscv64 C
##   S09-STN              lume build --target safetensors  cartridge of the same kernel file: loaded back, bound to the
##                                                         source and to the certificate of S03, forward pass == S06
##   S10 crypto           lcrypto_tls (linked here)        evidence manifest (SHA-256 of every artifact above), nonce
##                                                         through the OS entropy health check, Ed25519 signature
##                                                         under a leaf key whose X.509 chain verifies to a pinned root
##   S11 boundary         lume adapt c                     the kernel's C boundary accepted as `unverified[int]`, a
##                                                         variadic boundary refused with [I0003]
##
## The tamper matrix (sy_tampers) corrupts one artifact per row and requires the DOWNSTREAM module to refuse it with
## the stated diagnostic. A row that is not refused is an UNDETECTED tamper and fails the gate. Every row first checks
## that its corruption really changed the artifact (a mutation site that is not found is a failure, not a pass).
##
## The gate does not stop at the first failure: it runs every stage and every row, prints each failure, writes
## build/certification/synergy_gate_summary.json (and the signed manifest next to it) and exits non-zero unless
## everything passed. The last line of a passing run is
##   OK: synergy gate: stages: N passed; tamper matrix: M of M caught; 0 undetected; <ms> ms
##
## Real level, stated once: the X.509 chain is the fixed test chain of compiler/stage1/lcrypto_tls.src (made with
## OpenSSL); its leaf key is the RFC 8032 section 7.1 TEST 1 key, whose private seed is public. The signature of S10
## therefore shows that the manifest, the signature and the chain verification compose, not that anybody is
## authenticated. Channel B and the emulators run on this host. ltv is given `--critical` on its command line so that
## its linked front end lowers the kernels as `lume build --critical` did (w12_keep_proven reads the process
## arguments); ltv has no documented option for that.
##
## The lines marked SWITCH call a tool binary through its stdin protocol because `lume` had no command (or no option)
## for the step when this gate was written. Each is one function: replace its body by the driver call.
use lcrypto_tls
use lneural_cartridge

## --- text helpers ---
fn sy_b(c) = if c then 1 else 0
fn sy_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else sy_line_end(s, i + 1)
fn sy_get_at(s, key, i) = if i >= count(s) then "" else let e = sy_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else sy_get_at(s, key, e + 1)
fn sy_get(s, key) = sy_get_at(s, key, 0)
fn sy_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn sy_index(text, part, i) = if i + count(part) > count(text) then 0 - 1 else if at(text, i) == at(part, 0) and slice(text, i, i + count(part)) == part then i else sy_index(text, part, i + 1)
fn sy_has(text, part) = if sy_index(text, part, 0) >= 0 then 1 else 0
fn sy_count_at(text, part, i, acc) = let j = sy_index(text, part, i) in if j < 0 then acc else sy_count_at(text, part, j + count(part), acc + 1)
fn sy_count(text, part) = sy_count_at(text, part, 0, 0)
fn sy_join(xs) = match xs
    Nil        => ""
    Cons(h, t) => h + sy_join(t)
fn sy_len(xs, n) = match xs
    Nil        => n
    Cons(h, t) => sy_len(t, n + 1)
fn sy_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, sy_app(t, ys))
fn sy_l1(a) = Cons(a, Nil)
fn sy_l2(a, b) = Cons(a, Cons(b, Nil))
fn sy_l3(a, b, c) = Cons(a, Cons(b, Cons(c, Nil)))
fn sy_l4(a, b, c, d) = Cons(a, Cons(b, sy_l2(c, d)))
fn sy_l5(a, b, c, d, e) = Cons(a, Cons(b, sy_l3(c, d, e)))
fn sy_l6(a, b, c, d, e, f) = Cons(a, Cons(b, Cons(c, sy_l3(d, e, f))))
fn sy_digits_end(s, i) = if i < count(s) and at(s, i) >= "0" and at(s, i) <= "9" then sy_digits_end(s, i + 1) else i
fn sy_num(s, i, n, acc) = if i >= n then acc else sy_num(s, i + 1, n, acc * 10 + (ord(at(s, i)) - 48))
## the non-negative integer that follows "key": at or after `from` (-1 when the key is absent or no digit follows)
fn sy_field_from(out, key, at0) = let i = sy_index(out, "\"" + key + "\":", at0) in if i < 0 then 0 - 1 else let b = i + count(key) + 3 in let e = sy_digits_end(out, b) in if e == b then 0 - 1 else sy_num(out, b, e, 0)
fn sy_field(out, key) = sy_field_from(out, key, 0)
fn sy_jstr_end(s, i) = if i >= count(s) or at(s, i) == "\"" then i else sy_jstr_end(s, i + 1)
fn sy_jstr(text, key) = let i = sy_index(text, "\"" + key + "\":\"", 0) in if i < 0 then "" else let b = i + count(key) + 4 in slice(text, b, sy_jstr_end(text, b))
## replace the first occurrence of `pat` at or after `from`; the text comes back unchanged when there is none
fn sy_rep1(s, pat, rep, at0) = if at0 < 0 then s else let i = sy_index(s, pat, at0) in if i < 0 then s else slice(s, 0, i) + rep + slice(s, i + count(pat), count(s))
fn sy_short(s) = if count(s) > 360 then slice(s, 0, 360) + " ..." else s
fn sy_jesc1(c) = if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then "\\n" else if c == "\t" then " " else if c == "\r" then "" else c
fn sy_jesc_at(s, i, n) = if i >= n then Nil else Cons(sy_jesc1(at(s, i)), sy_jesc_at(s, i + 1, n))
fn sy_jesc(s) = sy_join(sy_jesc_at(s, 0, count(s)))
## `part` occurs within `span` characters after the first occurrence of `anchor`
fn sy_near(text, anchor, part, span) = let i = sy_index(text, anchor, 0) in if i < 0 then 0 else let e = if i + span > count(text) then count(text) else i + span in sy_has(slice(text, i, e), part)
## the lines of a text that are not `##` comments (what the gate compares with the example files)
fn sy_code_at(s, i, acc) = if i >= count(s) then acc else let e = sy_line_end(s, i) in let ln = slice(s, i, e) in sy_code_at(s, e + 1, if count(ln) >= 2 and slice(ln, 0, 2) == "##" then acc else acc + ln + "\n")
fn sy_code(s) = sy_code_at(s, 0, "")
fn sy_lines_before(s, i, k, n) = if k >= i then n else sy_lines_before(s, i, k + 1, if at(s, k) == "\n" then n + 1 else n)
fn sy_line_start(s, i) = if i <= 0 then 0 else if at(s, i - 1) == "\n" then i else sy_line_start(s, i - 1)
fn sy_ints(xs) = match xs
    Nil        => ""
    Cons(h, t) => str(h) + (if sy_len(t, 0) == 0 then "" else ",") + sy_ints(t)

## --- the kernel module and the program that runs it (same code as examples/synergy/*.src) ---
fn sy_k_rate() = "@no_alloc\n@bound(cycles: 64)\nfn rate_limit(prev: int, req: int, step: int) -> int / pure requires prev >= 0 and prev <= 10000 and req >= 0 and req <= 10000 and step >= 1 and step <= 500 ensures result >= 0 and result <= 10000 and result - prev <= step and prev - result <= step = if req > prev + step then prev + step else if req < prev - step then prev - step else req\n"
fn sy_k_ct() = "@secret\n@no_alloc\nfn ct_add32(a: int, b: int) -> int = bit_and(bit_and(a, 4294967295) + bit_and(b, 4294967295), 4294967295)\n@secret\n@no_alloc\nfn ct_select32(mask: int, a: int, b: int) -> int = bit_xor(b, bit_and(mask, bit_xor(a, b)))\n@secret\n@no_alloc\nfn ct_cmp_step(acc: int, a: int, b: int) -> int = bit_or(acc, bit_xor(ct_add32(a, 0), ct_add32(b, 0)))\n"
fn sy_k_law() = "law rate_limit_monotone_step(prev: int, req: int, step: int) = if prev >= 0 and prev <= 10000 and req >= 0 and req <= 10000 and step >= 1 and step <= 500 then rate_limit(prev, req, step) <= prev + step else 1 == 1\n"
fn sy_k_comp() = "@no_alloc\n@bound(cycles: 200)\nfn actuator_cmd(prev: int, req: int, step: int) -> int / pure requires prev >= 0 and prev <= 10000 and req >= 0 and req <= 10000 and step >= 1 and step <= 500 ensures result >= 0 and result <= 10000 = if req > 9000 then rate_limit(prev, 9000, step) else rate_limit(prev, req, step)\n"
fn sy_kernel() = "## critical_pipeline.src -- written by tests/harness/synergy_gate.src; the commented copy is examples/synergy/critical_pipeline.src\n" + sy_k_rate() + sy_k_ct() + sy_k_law() + sy_k_comp()
fn sy_demo() = "use critical_pipeline\nprint rate_limit(100, 900, 50)\nprint rate_limit(5000, 100, 500)\nprint rate_limit(100, 120, 50)\nprint actuator_cmd(9000, 10000, 50)\nprint ct_add32(4294967295, 2)\nprint ct_select32(0 - 1, 7, 9)\nprint ct_select32(0, 7, 9)\nprint ct_cmp_step(0, 5, 5)\nprint ct_cmp_step(0, 5, 3)\n"
fn sy_demo_out() = "150\n4500\n120\n9000\n1\n7\n9\n0\n6\n"

## --- running tools ---
fn sy_cap(bin, args, inp, base, ms) = let t0 = os_monotonic_ns() in let st = if inp == "" then os_run_capture_timeout(bin, args, base + ".out", base + ".err", ms) else os_run_input_capture_timeout(bin, args, inp, base + ".out", base + ".err", ms) in {status: sy_wait_exit(st), out: fs_read_file(base + ".out"), err: fs_read_file(base + ".err"), ms: (os_monotonic_ns() - t0) / 1000000}
fn sy_drv(g, tag, args) = sy_cap(g.bin + "/lume_driver", args, "", g.tmp + "/" + tag, 300000)
fn sy_bin(g, tag, tool, args, request) = let w = fs_write_sync(g.tmp + "/" + tag + ".in", request) in sy_cap(g.bin + "/" + tool, args, g.tmp + "/" + tag + ".in", g.tmp + "/" + tag, 300000)
fn sy_sys(g, tag, bin, args) = sy_cap(bin, args, "", g.tmp + "/" + tag, 60000)
fn sy_sha_file(path) = if fs_path_exists(path) == 1 then se_sha256_file(path) else ""
fn sy_mkdir(d) = os_run("/bin/mkdir", Cons("-p", Cons(d, Nil)))
fn sy_rmrf(d) = os_run("/bin/rm", Cons("-rf", Cons(d, Nil)))
fn sy_cp(a, b) = os_run("/bin/cp", Cons(a, Cons(b, Nil)))
fn sy_cpr(a, b) = os_run("/bin/cp", Cons("-r", Cons(a, Cons(b, Nil))))
## digest of a directory: SHA-256 over `<name> <sha256 of the file>` lines in `ls` order
fn sy_dir_lines(dir, ls, i, acc) = if i >= count(ls) then acc else let e = sy_line_end(ls, i) in let nm = slice(ls, i, e) in sy_dir_lines(dir, ls, e + 1, if nm == "" then acc else acc + nm + " " + sy_sha_file(dir + "/" + nm) + "\n")
fn sy_dir_sha(g, tag, dir) = let ls = sy_sys(g, tag + "_ls", "/bin/ls", Cons(dir, Nil)) in if ls.status != 0 or ls.out == "" then "" else lsh256(sy_dir_lines(dir, ls.out, 0, ""))
fn sy_first_name(g, tag, dir) = let ls = sy_sys(g, tag + "_ls", "/bin/ls", Cons(dir, Nil)) in slice(ls.out, 0, sy_line_end(ls.out, 0))

## --- the command of each stage: ONE function per step ---------------------------------------------------------------
fn sy_x_prove(g, tag, src) = sy_drv(g, tag, sy_l2("prove", src))
fn sy_x_pcache(g, tag, cmd, src, dir) = sy_drv(g, tag, sy_l4("proof-cache", cmd, src, dir))
fn sy_x_certify(g, tag, src) = sy_drv(g, tag, sy_l2("certify", src))
fn sy_x_vcert(g, tag, src, cert) = sy_drv(g, tag, sy_l4("verify-cert", "--check-source", src, cert))
fn sy_x_vcert_plain(g, tag, cert) = sy_drv(g, tag, sy_l2("verify-cert", cert))
fn sy_x_build(g, tag, src, out) = sy_drv(g, tag, sy_l6("build", "--critical", "-g", src, "-o", out))
fn sy_x_mcdc(g, tag, src) = sy_drv(g, tag, sy_l3("mcdc", src, "--exec"))
fn sy_x_cart(g, tag, src, entry, out) = sy_drv(g, tag, Cons("build", Cons("--target", sy_l6("safetensors", "--entry", entry, src, "-o", out))))
fn sy_x_adapt(g, tag, hdr) = sy_drv(g, tag, sy_l4("adapt", "c", "--json", hdr))
## SWITCH (lume stack): static stack bytes of the `@no_alloc` functions; `asm` == "" lets lstack compile with --critical
fn sy_x_stack(g, tag, src, asm) = sy_drv(g, tag, Cons("stack", Cons(src, if asm == "" then sy_l2("--critical", "--json") else sy_l3("--asm", asm, "--json"))))
## SWITCH (lume tv --critical --asm <file.s> --out <dir> [--exec]): translation validation of a given assembly text
fn sy_x_tv(g, tag, src, asm, outdir, exec) = sy_bin(g, tag, "ltv", sy_l1("--critical"), "@root " + g.root + "\n@src " + src + "\n@asm " + asm + "\n@out " + outdir + "\n" + (if exec == 1 then "@exec 1\n" else ""))
## SWITCH (lume tv-rt): the runtime helpers of an assembly text
fn sy_x_tvrt(g, tag, asm) = sy_drv(g, tag, sy_l4("tv-rt", "--asm", asm, "--json"))
## SWITCH (lume smt-check): every .smt2 of a directory
fn sy_x_smt(g, tag, dir) = sy_drv(g, tag, sy_l4("smt-check", "--dir", dir, "--json"))
## SWITCH (lume safety-envelope with --inject / --log / --work, and the split modes): `body` is the request after @root
fn sy_x_env(g, tag, body) = sy_bin(g, tag, "lsafety_envelope", Nil, "@root " + g.root + "\n" + body)

## --- the Wave 14 fields ltv gains when it calls ltv_rt and lsmt in process (workstream tvint) -----------------------
## 0: a field that is present must satisfy its assertion, an absent field is accepted.
## 1: every field must be present. FLIP THIS CONSTANT once the fields exist.
fn sy_expect_tvint() = 1
fn sy_tvint1(out, key, want_eq, v) = if sy_has(out, "\"" + key + "\":") == 0 then (if sy_expect_tvint() == 1 then "the ltv report has no field " + key + "; " else "") else let x = sy_field(out, key) in if want_eq == 1 then (if x == v then "" else key + " is " + str(x) + ", expected " + str(v) + "; ") else (if x > v then "" else key + " is " + str(x) + ", expected more than " + str(v) + "; ")
fn sy_tvint(out) = sy_tvint1(out, "runtime_helpers_verified", 0, 0) + sy_tvint1(out, "smt2_checked_native", 1, sy_field(out, "validated")) + (if sy_has(out, "\"branch_correlation\":") == 0 then (if sy_expect_tvint() == 1 then "the ltv report has no field branch_correlation; " else "") else sy_tvint1(out, "uncorrelated", 1, 0))
fn sy_tvint_seen(out) = sy_has(out, "\"runtime_helpers_verified\":") + sy_has(out, "\"smt2_checked_native\":") + sy_has(out, "\"branch_correlation\":")

## --- results ---
fn sy_c(ok, why) = {ok: ok, why: why}
fn sy_first(cs) = match cs
    Nil        => ""
    Cons(h, t) => if h.ok == 1 then sy_first(t) else h.why
fn sy_st(id, title, tool, art, sha, ms, why) = {id: id, title: title, tool: tool, art: art, sha: sha, ms: ms, ok: if why == "" then 1 else 0, note: why}
fn sy_tm(id, stage, corruption, detector, diag, why) = {id: id, stage: stage, corruption: corruption, detector: detector, diag: diag, ok: if why == "" then 1 else 0, note: why}

## ====================================================================================================================
## Stages
## ====================================================================================================================
fn sy_s01(g) = let r = sy_x_prove(g, "s01_prove", g.k) in sy_st("S01", "prove", "lume prove", "prove report (JSON)", lsh256(r.out), r.ms, sy_first(sy_l6(sy_c(sy_b(r.status == 0 and sy_has(r.out, "\"ok\":true") == 1), "lume prove: exit status " + str(r.status) + ": " + sy_short(r.out + r.err)), sy_c(sy_b(sy_count(r.out, "\"status\":\"proven\"") == 3), "expected 3 proven obligations, got " + str(sy_count(r.out, "\"status\":\"proven\""))), sy_c(sy_b(sy_count(r.out, "\"status\":\"budget_checked\"") == 2), "expected 2 budget-checked obligations"), sy_c(sy_b(sy_count(r.out, "\"status\":\"refuted\"") == 0 and sy_count(r.out, "\"status\":\"runtime_checked\"") == 0), "an obligation is refuted or only runtime-checked"), sy_c(sy_b(sy_has(r.out, "\"name\":\"rate_limit\",\"kind\":\"contract\",\"status\":\"proven\"") == 1 and sy_has(r.out, "\"name\":\"actuator_cmd\",\"kind\":\"contract\",\"status\":\"proven\"") == 1), "the contracts of rate_limit and actuator_cmd are not both proven"), sy_c(sy_has(r.out, "\"name\":\"rate_limit_monotone_step\",\"kind\":\"law\",\"status\":\"proven\""), "the law is not proven"))))
fn sy_s02(g) = let z = sy_rmrf(g.tmp + "/pcache") in let st = sy_x_pcache(g, "s02_store", "store", g.k, g.tmp + "/pcache") in let ck = sy_x_pcache(g, "s02_check", "check", g.k, g.tmp + "/pcache") in let n = sy_field(st.out, "total") in sy_st("S02", "proof-cache", "lume proof-cache store / check", "cache directory (" + str(sy_field(ck.out, "hits")) + " warm hits of " + str(sy_field(ck.out, "total")) + ", check " + str(sy_field(ck.out, "elapsed_ms")) + " ms)", sy_dir_sha(g, "s02", g.tmp + "/pcache/proofs"), st.ms + ck.ms, sy_first(sy_l4(sy_c(sy_b(st.status == 0 and n == 5 and sy_field(st.out, "stored") == 5 and sy_field(st.out, "reused") == 0), "cold store: exit status " + str(st.status) + ": " + sy_short(st.out + st.err)), sy_c(sy_b(ck.status == 0 and sy_has(ck.out, "\"all_cached\":true") == 1), "warm check: exit status " + str(ck.status) + ": " + sy_short(ck.out + ck.err)), sy_c(sy_b(sy_field(ck.out, "hits") == 5 and sy_field(ck.out, "total") == 5 and sy_field(ck.out, "misses") == 0), "warm check: expected 5 hits of 5, 0 misses: " + sy_short(ck.out)), sy_c(sy_b(sy_has(ck.out, "\"missed_functions\":[]") == 1), "warm check lists a missed function"))))
fn sy_s03(g) = let r = sy_x_certify(g, "s03_certify", g.k) in let w = fs_write_sync(g.cert, r.out) in sy_st("S03", "certify", "lume certify", "critical_pipeline.cert.json", sy_sha_file(g.cert), r.ms, sy_first(sy_l4(sy_c(sy_b(r.status == 0 and sy_has(r.out, "\"ok\":true") == 1 and sy_has(r.out, "\"kernel_verified\":true") == 1), "lume certify: exit status " + str(r.status) + ": " + sy_short(r.out + r.err)), sy_c(sy_b(sy_jstr(r.out, "source_hash") == "sha256:" + g.ksha), "the certificate's source_hash " + sy_jstr(r.out, "source_hash") + " is not the SHA-256 of the kernel file " + g.ksha), sy_c(sy_b(sy_field(r.out, "proven_count") == 3 and sy_field(r.out, "budget_checked_count") == 2 and sy_field(r.out, "total_obligations") == 5), "expected 3 proven + 2 budget-checked = 5 obligations in the certificate"), sy_c(sy_b(count(sy_jstr(r.out, "certificate_hash")) == 71), "the certificate has no certificate_hash"))))
fn sy_s04(g) = let r = sy_x_vcert(g, "s04_vcert", g.k, g.cert) in sy_st("S04", "verify-cert --check-source", "lume verify-cert --check-source (lcert)", "binding report (JSON)", lsh256(r.out), r.ms, sy_first(sy_l4(sy_c(sy_b(r.status == 0 and sy_has(r.out, "\"ok\":true") == 1 and sy_has(r.out, "\"kernel_verified\":true") == 1), "lcert: exit status " + str(r.status) + ": " + sy_short(r.out + r.err)), sy_c(sy_b(sy_has(r.out, "\"source_binding\":{\"checked\":true") == 1 and sy_has(r.out, "\"unbound\":[]") == 1), "the source binding is not complete: " + sy_short(slice(r.out, if sy_index(r.out, "\"source_binding\"", 0) < 0 then 0 else sy_index(r.out, "\"source_binding\"", 0), count(r.out)))), sy_c(sy_b(sy_field(r.out, "obligations_bound") == 5), "expected 5 obligations bound, got " + str(sy_field(r.out, "obligations_bound"))), sy_c(sy_has(r.out, "\"source_sha256\":\"sha256:" + g.ksha + "\""), "lcert bound the certificate to another file than the kernel module"))))
## Parity of the two places that state a kernel verdict. `lume certify` (lcaas) writes "kernel_verified" into the
## certificate; `lume verify-cert` (the lcert binary) re-derives it. For a contract whose proof needs bit facts (the
## kind a constant-time kernel would carry) both must say the same thing: a certificate that claims a kernel verdict
## the kernel does not give is a false claim, even though the kernel itself fails closed.
fn sy_bit_src() = "fn m32(a: int, b: int) -> int ensures result >= 0 and result <= 8589934590 = bit_and(a, 4294967295) + bit_and(b, 4294967295)\n"
fn sy_tf_word(b) = if b == 1 then "true" else "false"
fn sy_s04par(g) = let src = g.tmp + "/bit_contract.src" in let cp = g.tmp + "/bit_contract.cert.json" in let w = fs_write_sync(src, sy_bit_src()) in let c = sy_x_certify(g, "s04par_certify", src) in let w2 = fs_write_sync(cp, c.out) in let v = sy_x_vcert_plain(g, "s04par_vcert", cp) in let ck = sy_has(c.out, "\"kernel_verified\":true") in let vk = sy_has(v.out, "\"kernel_verified\":true") in sy_st("S04-PAR", "certify / verify-cert parity", "lume certify (lcaas) against lume verify-cert (lcert)", "certificate of a contract over bit operations (kernel_verified: certify " + sy_tf_word(ck) + ", verify-cert " + sy_tf_word(vk) + ")", sy_sha_file(cp), c.ms + v.ms, sy_first(sy_l3(sy_c(sy_b(c.out != "" and v.out != "" and sy_has(c.out, "\"name\":\"m32\"") == 1), "lume certify / verify-cert gave no report for the bit contract: " + sy_short(c.out + c.err + v.out + v.err)), sy_c(sy_b(ck == vk), "lume certify wrote \"kernel_verified\":" + sy_tf_word(ck) + " into a certificate for which lume verify-cert answers \"kernel_verified\":" + sy_tf_word(vk) + " (" + sy_short(sy_jstr(v.out, "reason")) + "): the proof service claims a kernel verdict the certificate kernel does not give"), sy_c(sy_b(sy_has(c.out, "\"ok\":true") == sy_has(v.out, "\"ok\":true")), "lume certify and lume verify-cert disagree on \"ok\" for the same certificate"))))
## the stack bytes of the five `@no_alloc` kernels as `name=bytes,...` ("" when one of them is not bounded)
fn sy_stack1(out, nm) = let i = sy_index(out, "\"name\":\"" + nm + "\",\"status\":\"bounded\"", 0) in if i < 0 then 0 - 1 else sy_field_from(out, "max_stack_bytes_proven_paths", i)
fn sy_stack_names() = sy_l5("rate_limit", "ct_add32", "ct_select32", "ct_cmp_step", "actuator_cmd")
fn sy_stack_list(out, ns) = match ns
    Nil        => ""
    Cons(h, t) => let b = sy_stack1(out, h) in if b <= 0 then "?" else h + "=" + str(b) + (if sy_len(t, 0) == 0 then "" else ",") + sy_stack_list(out, t)
fn sy_stack_ok(s) = if s != "" and sy_has(s, "?") == 0 then 1 else 0
fn sy_s05(g) = let r = sy_x_stack(g, "s05_stack", g.k, "") in let bs = sy_stack_list(r.out, sy_stack_names()) in sy_st("S05", "stack", "lstack", "stack report (" + bs + " bytes)", lsh256(r.out), r.ms, sy_first(sy_l3(sy_c(sy_b(r.status == 0 and sy_has(r.out, "\"ok\":true") == 1), "lstack: exit status " + str(r.status) + ": " + sy_short(r.out + r.err)), sy_c(sy_stack_ok(bs), "a `@no_alloc` kernel has no stack bound: " + bs), sy_c(sy_b(sy_count(r.out, "\"no_alloc\":true") == 5 and sy_has(r.out, "\"status\":\"rejected\"") == 0), "lstack did not analyse exactly the five `@no_alloc` kernels"))))
## DWARF: sections, a line table that names the bundled source, and the address of rate_limit mapped back to its line
fn sy_nm_addr(nm, name) = let i = sy_index(nm, " " + name + "\n", 0) in if i < 0 then "" else let b = sy_line_start(nm, i) in if i - b < 16 then "" else slice(nm, b, b + 16)
fn sy_dwarf(g) = let secs = sy_sys(g, "s06_secs", "/usr/bin/readelf", sy_l2("-S", g.elf)) in let dl = sy_sys(g, "s06_lines", "/usr/bin/readelf", sy_l2("--debug-dump=decodedline", g.elf)) in let nm = sy_sys(g, "s06_nm", "/usr/bin/nm", sy_l1(g.elf)) in let addr = sy_nm_addr(nm.out, "rate_limit") in let a2l = sy_sys(g, "s06_a2l", "/usr/bin/addr2line", sy_l4("-f", "-e", g.elf, "0x" + addr)) in let bsrc = fs_read_file(g.elf + ".bundled.src") in let fi = sy_index(bsrc, "\nfn rate_limit(", 0) in let line = sy_lines_before(bsrc, fi + 1, 0, 1) in if secs.status != 0 or sy_has(secs.out, ".debug_line") == 0 or sy_has(secs.out, ".debug_info") == 0 or sy_has(secs.out, ".debug_abbrev") == 0 then "the ELF has no .debug_line / .debug_info / .debug_abbrev section" else if dl.status != 0 or sy_has(dl.out, "critical_pipeline_demo.elf.bundled.src") == 0 then "readelf decodes no line table that names the bundled source" else if addr == "" or fi < 0 then "nm lists no rate_limit symbol (or the bundled source has no rate_limit)" else if a2l.status != 0 or sy_has(a2l.out, "rate_limit\n") == 0 or sy_has(a2l.out, "critical_pipeline_demo.elf.bundled.src:" + str(line) + "\n") == 0 then "addr2line does not map rate_limit (0x" + addr + ") to line " + str(line) + " of the bundled source: " + sy_short(a2l.out + a2l.err) else ""
fn sy_s06(g) = let r = sy_x_build(g, "s06_build", g.demo, g.elf) in let run = if fs_path_exists(g.elf) == 1 then sy_sys(g, "s06_run", g.elf, Nil) else {status: 127, out: "", err: "no ELF", ms: 0} in let asm = fs_read_file(g.asm) in let lk = sy_x_stack(g, "s06_stack", g.k, g.asm) in let b5 = sy_stack_list(fs_read_file(g.tmp + "/s05_stack.out"), sy_stack_names()) in let b6 = sy_stack_list(lk.out, sy_stack_names()) in let dw = if fs_path_exists(g.elf) == 1 then sy_dwarf(g) else "no ELF to read DWARF from" in sy_st("S06", "build --critical -g", "lume build --critical -g (lumec, lasm --strict)", "critical_pipeline_demo.elf (+ .s " + sy_sha_file(g.asm) + ")", sy_sha_file(g.elf), r.ms + run.ms, sy_first(sy_l6(sy_c(sy_b(r.status == 0 and fs_path_exists(g.elf) == 1 and asm != ""), "lume build: exit status " + str(r.status) + ": " + sy_short(r.out + r.err)), sy_c(sy_b(run.status == 0 and run.out == sy_demo_out()), "the program printed " + sy_short(run.out + run.err) + " (exit status " + str(run.status) + ")"), sy_c(sy_b(sy_has(asm, "runtime contract violation (ensures) in 'rate_limit'") == 1), "--critical did not keep the check of the proven ensures of rate_limit in the emitted code"), sy_c(sy_b(sy_has(asm, "    .loc 1 ") == 1), "the assembly has no .loc line directive"), sy_c(sy_b(dw == ""), dw), sy_c(sy_b(lk.status == 0 and sy_stack_ok(b6) == 1 and b6 == b5), "the stack bounds of the assembled text (" + b6 + ") are not those of S05 (" + b5 + ")"))))
fn sy_ct_ok(out, nm) = sy_near(out, "\"name\":\"" + nm + "\",\"status\":\"validated\"", "\"secret\":true,\"constant_time_kernel\":true,\"ct_checked_transitively\":true", 400)
fn sy_s07(g) = let z = sy_rmrf(g.proofs) in let r = sy_x_tv(g, "s07_tv", g.k, g.asm, g.proofs, 1) in let v = sy_field(r.out, "validated") in sy_st("S07", "tv", "ltv --critical @exec 1", "ltv report (JSON); certificates in proofs/; ltv fields of workstream tvint present: " + str(sy_tvint_seen(r.out)) + " of 3", lsh256(r.out), r.ms, sy_first(Cons(sy_c(sy_b(r.status == 0 and sy_has(r.out, "\"ok\":true") == 1), "ltv: exit status " + str(r.status) + ": " + sy_short(r.out + r.err)), Cons(sy_c(sy_b(v == 6 and sy_field(r.out, "typed_integer_functions") == 6 and sy_field(r.out, "rejected") == 0 and sy_field(r.out, "unsupported") == 0), "expected 6 of 6 typed integer functions validated, 0 rejected, 0 unsupported"), sy_l6(sy_c(sy_b(sy_field(r.out, "constant_time_kernels") == 3 and sy_field(r.out, "constant_time_kernels_validated") == 3 and sy_field(r.out, "secret_rejected") == 0), "expected 3 constant-time kernels, all validated"), sy_c(sy_b(sy_ct_ok(r.out, "ct_add32") == 1 and sy_ct_ok(r.out, "ct_select32") == 1 and sy_ct_ok(r.out, "ct_cmp_step") == 1), "a constant-time kernel is not reported constant_time_kernel + ct_checked_transitively"), sy_c(sy_near(r.out, "\"name\":\"ct_cmp_step\",\"status\":\"validated\"", "\"ct_callees_inspected\":[\"ct_add32\"]", 400), "[C0010] was not closed over the call ct_cmp_step -> ct_add32"), sy_c(sy_b(sy_jstr(r.out, "source_sha256") == g.ksha and sy_jstr(r.out, "asm_sha256") == sy_sha_file(g.asm)), "ltv validated other files than the certified source (S03) and the assembled text (S06)"), sy_c(sy_b(sy_field(r.out, "native_vectors") > 0 and sy_field(r.out, "certificates_written") == 12), "expected native boundary vectors and 12 certificate files (6 .smt2 + 6 .lean)"), sy_c(sy_b(sy_tvint(r.out) == ""), sy_tvint(r.out)))))))
