## claude_audit_gate.src -- 100% native Lume verification harness for the 21 Claude Opus 5.5
## audit issues (#1-#21), Red Team Round 1 soundness hardening, and pure-Lume 4-way differential fuzzing.
use prover_fuzz

fn cag_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn cag_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else cag_contains_at(text, part, i + 1)
fn cag_contains(text, part) = cag_contains_at(text, part, 0)
fn cag_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else cag_line_end(s, i + 1)
fn cag_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, cag_line_end(input, 0))
fn cag_join(a, b) = if a != "" then a else b

fn cag_run(bin, args, out) = cag_run_ms(bin, args, out, 180000)
## self-prove certifies fifteen batteries; on a loaded host that is minutes, and a timeout here is not a verdict
fn cag_run_ms(bin, args, out, ms) = let st = os_run_capture_timeout(bin, args, out, out + ".err", ms) in {status: cag_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn cag_input(bin, args, inp, out) = let st = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", 180000) in {status: cag_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn cag_sh(cmd, out) = cag_run("/bin/sh", Cons("-c", Cons(cmd, Nil)), out)

fn cag_compile_run(root, tmp, name, code) = let src = tmp + "/" + name + ".src" in let asm = tmp + "/" + name + ".s" in let elf = tmp + "/" + name + ".elf" in let w = fs_write_sync(src, code) in let c = cag_input(root + "/build/bin/lumec", Nil, src, asm) in if c.status != 0 then {ok: 0, status: c.status, out: "", err: c.err} else let a = cag_run(root + "/build/bin/lasm", Cons("--strict", Cons(asm, Nil)), elf) in if a.status != 0 then {ok: 0, status: a.status, out: "", err: a.err} else let m = os_run("/bin/chmod", Cons("+x", Cons(elf, Nil))) in let r = cag_run(elf, Nil, elf + ".run") in {ok: 1, status: r.status, out: r.out, err: r.err}

fn cag_check_seed_path(root, tmp) = let probe = tmp + "/seed_probe.src" in let w = fs_write_sync(probe, "fn ok_fn(x: int) -> int requires x >= 0 ensures result >= 0 = x\nprint ok_fn(7)\n") in let r1 = cag_sh("LUME_FORCE_SEED=1 \"" + root + "/lume\" prove \"" + probe + "\"", tmp + "/seed_lcaas.out") in if r1.status != 0 or cag_contains(r1.out, "\"ok\":true") == 0 then "Stage-0 seed failed on lcaas.src: " + r1.err else let bad = tmp + "/seed_bad.src" in let wb = fs_write_sync(bad, "fn broken(\n") in let r2 = cag_sh("LUME_FORCE_SEED=1 \"" + root + "/lume\" check \"" + probe + "\" && ! LUME_FORCE_SEED=1 \"" + root + "/lume\" check \"" + bad + "\"", tmp + "/force_seed.out") in if r2.status != 0 then "LUME_FORCE_SEED=1 check gate failed: " + r2.out + r2.err else ""

fn cag_check_prover_soundness(root, tmp) = let b1 = tmp + "/b01_mod.src" in let b2 = tmp + "/b02_wrap.src" in let b3 = tmp + "/rt1_ovf.src" in let b4 = tmp + "/rt1_nia.src" in let w1 = fs_write_sync(b1, "fn bad_mod(x: int) -> int requires x < 0 ensures result >= 0 = x % 4\nprint bad_mod(-3)\n") in let w2 = fs_write_sync(b2, "fn bad_wrap(x: int) -> int requires x > 0 ensures result > x = x +% 1\nprint bad_wrap(1)\n") in let w3 = fs_write_sync(b3, "fn bad_mul(x: int) -> int requires 4611686018427387904 * x == 0 ensures result == 99 = x\nprint bad_mul(2)\n") in let w4 = fs_write_sync(b4, "fn bad_nia(x: int) -> int requires x >= 3037000500 ensures result * result >= 100 = x\nprint bad_nia(3037000500)\n") in let p1 = cag_run(root + "/build/bin/lume_driver", Cons("prove", Cons(b1, Nil)), tmp + "/b01.out") in let p2 = cag_run(root + "/build/bin/lume_driver", Cons("prove", Cons(b2, Nil)), tmp + "/b02.out") in let p3 = cag_input(root + "/build/bin/lcaas", Nil, b3, tmp + "/b03.out") in let p4 = cag_input(root + "/build/bin/lcaas", Nil, b4, tmp + "/b04.out") in if p1.status == 0 or p2.status == 0 then "prover accepted false negative-mod or wrapping-add contract" else if cag_contains(p3.out, "\"status\":\"proven\"") == 1 or cag_contains(p4.out, "\"status\":\"proven\"") == 1 then "prover falsely proved overflowing linear or NIA contract" else ""

fn cag_check_perceus_and_effects(root, tmp) = let r_perc = cag_compile_run(root, tmp, "b05_perceus", "fn hd(xs: [int]) -> int = match xs\n    Nil => 0\n    Cons(h, t) => h\nfn step(xs: [int]) -> [int] = match xs\n    Nil => Nil\n    Cons(h, t) => Cons(h + 1, t)\nfn check_alias(xs: [int]) -> int =\n    let ys = xs in\n    let zs = step(xs) in\n    hd(ys) * 100 + hd(zs)\nprint check_alias(Cons(10, Cons(20, Nil)))\n") in if r_perc.ok == 0 or r_perc.status != 0 or r_perc.out != "1011\n" then "Perceus alias reuse corrupted shared Cons cell: " + r_perc.out + r_perc.err else let p_src = tmp + "/b09_pure.src" in let wp = fs_write_sync(p_src, "fn bad() -> int / pure = fs_path_exists(\"a\")\nprint bad()\n") in let cp = cag_input(root + "/build/bin/lumec", Nil, p_src, tmp + "/b09_pure.s") in if cp.status == 0 or cag_contains(cp.err, "E0200") == 0 then "/ pure failed to reject I/O builtin [E0200]" else let s1 = tmp + "/b09_sec1.src" in let s2 = tmp + "/b09_sec2.src" in let s3 = tmp + "/rt1_sec_let.src" in let ws1 = fs_write_sync(s1, "@secret fn leak(k: int) -> int = if k == 0 then 1 else 2\nprint leak(5)\n") in let ws2 = fs_write_sync(s2, "@secret fn leak2(k: int) -> string = __lume_mem_pack(k)\nprint leak2(5)\n") in let ws3 = fs_write_sync(s3, "fn leak3(secret_k: int) -> int =\n    let y = secret_k + 1 in\n    if y > 10 then 1 else 0\nprint leak3(5)\n") in let cs1 = cag_input(root + "/build/bin/lumec", Nil, s1, tmp + "/s1.s") in let cs2 = cag_input(root + "/build/bin/lumec", Nil, s2, tmp + "/s2.s") in let cs3 = cag_input(root + "/build/bin/lumec", Nil, s3, tmp + "/s3.s") in if cs1.status == 0 or cs2.status == 0 or cs3.status == 0 or cag_contains(cs1.err, "C0009") == 0 or cag_contains(cs2.err, "C0009") == 0 or cag_contains(cs3.err, "C0009") == 0 then "@secret failed to reject secret branching, mem_pack, or let-taint [C0009]" else ""

fn cag_check_cli_and_engines(root, tmp) = let qn = tmp + "/qn_input.src" in let orig = "fn hello() -> int = 42\nprint hello()\n" in let wq = fs_write_sync(qn, orig) in let rq = cag_run(root + "/build/bin/lume_driver", Cons("quantum-nexus", Cons(qn, Nil)), tmp + "/qn.out") in if rq.status != 0 or fs_read_file(qn) != orig then "quantum-nexus failed or overwrote input source file" else let py = tmp + "/morph_in.py" in let wm = fs_write_sync(py, "def calc_area(w, h):\n    return w * h\n") in let rm = cag_run(root + "/build/bin/lume_driver", Cons("morph", Cons(py, Nil)), tmp + "/morph.out") in let rmb = cag_run(root + "/build/bin/lume_driver", Cons("morph", Cons(tmp + "/no_such.py", Nil)), tmp + "/morph_bad.out") in if rm.status != 0 or cag_contains(rm.out, "calc_area") == 0 or rmb.status == 0 then "morph failed to translate input or accepted missing file" else let sp = cag_run_ms(root + "/build/bin/lume_driver", Cons("self-prove", Cons("--json", Nil)), tmp + "/self_prove.out", 1200000) in if os_last_timed_out() != 0 then "self-prove --json timed out after 1200 s (no verdict)" else if sp.status != 0 or cag_contains(sp.out, "\"ok\":true") == 0 or cag_contains(sp.out, "\"live_probes_verified\":true") == 0 or cag_contains(sp.out, "\"checked\":false") == 1 then "self-prove --json did not verify all obligations" else let iso_src = tmp + "/iso_k.src" in let iso_out = tmp + "/boot.iso" in let wi = fs_write_sync(iso_src, "fn main() -> int = 0\nprint main()\n") in let ri = cag_run(root + "/build/bin/lume_driver", Cons("package", Cons("iso", Cons(iso_src, Cons("-o", Cons(iso_out, Nil))))), tmp + "/iso.out") in if ri.status != 0 or fs_path_exists(iso_out) != 1 or fs_read_file(iso_out) == "fn main() -> int = 0\nprint main()\n" or fs_read_byte(iso_out, 0) != 235 or fs_read_byte(iso_out, 510) != 85 or fs_read_byte(iso_out, 511) != 170 or fs_read_byte(iso_out, 32769) != 67 then "package iso did not emit a valid binary boot image" else let gdir = tmp + "/gen_proj" in let rg = cag_run(root + "/build/bin/lume_driver", Cons("genesis", Cons(gdir, Cons("utility", Nil))), tmp + "/gen.out") in if rg.status != 0 or fs_path_exists(gdir + ".src") != 1 or count(fs_read_file(gdir + ".src")) < 80 then "genesis failed to scaffold project files on disk" else ""

fn cag_check_missing_engines(root, tmp, cmds) = match cmds
    Nil        => ""
    Cons(h, t) => let r = cag_run(root + "/build/bin/lume_driver", Cons(h, Cons(tmp + "/definitely_missing_input.src", Nil)), tmp + "/miss_" + h + ".out") in if r.status == 0 then "domain engine " + h + " accepted a nonexistent input file" else cag_check_missing_engines(root, tmp, t)

fn cag_check_lex_and_runtime(root, tmp) = let lb = chr(123) in let rb = chr(125) in let lex_code = "fn calc() -> int =\n    let a = 1.50 in\n    let b = 2.5 in\n    let c = 1.0 in\n    let s = a + b + c in\n    s.coefficient * 10 + s.scale\nfn lex_vals() -> int =\n    let h = 0xFF in\n    let b = 0b101 in\n    let o = 0o17 in\n    let u = 1_000_000 in\n    h + b + o + u\nfn map_val() -> int =\n    let m = " + lb + "\"k\": 42" + rb + " in\n    m[\"k\"]\nfn fmt_val(x: int) -> str = \"" + lb + "x:04x" + rb + "\"\nprint lex_vals()\nprint \"\"\"hello\"\"\"\nprint map_val()\nprint fmt_val(255)\nprint calc()\n" in let rl = cag_compile_run(root, tmp, "lex_fmt", lex_code) in if rl.ok == 0 or rl.status != 0 or rl.out != "1000275\nhello\n42\n00ff\n5002\n" then "lexical/format/decimal check failed: " + rl.out + rl.err else let rnul = cag_compile_run(root, tmp, "nul_path", "print fs_path_exists(\"a\" + chr(0) + \"b\")\n") in if rnul.ok == 0 or rnul.status == 0 then "interior NUL byte path was not rejected at runtime" else let rfull = cag_compile_run(root, tmp, "hello_full", "print \"hello world\"\n") in if rfull.ok == 0 then "failed to compile hello_full" else let df = if fs_path_exists("/dev/full") == 1 then cag_sh("\"" + tmp + "/hello_full.elf\" > /dev/full 2>/dev/null", tmp + "/df.out") else {status: 1, out: "", err: ""} in if fs_path_exists("/dev/full") == 1 and df.status == 0 then "runtime ignored stdout write failure on /dev/full" else ""

fn cag_prng(seed) = (seed * 1103515245 + 12345) % 2147483648
fn cag_fuzz_expr(seed, depth) = let s1 = cag_prng(seed) in if depth <= 0 then {s: s1, code: str(s1 % 97 + 1)} else let kind = s1 / 65536 % 4 in let l = cag_fuzz_expr(s1, depth - 1) in let r = cag_fuzz_expr(l.s, depth - 1) in if kind == 0 then {s: r.s, code: "(" + l.code + " + " + r.code + ")"} else if kind == 1 then {s: r.s, code: "(" + l.code + " - " + r.code + ")"} else if kind == 2 then {s: r.s, code: "(if " + l.code + " >= " + r.code + " then " + l.code + " else " + r.code + ")"} else {s: r.s, code: "(let v" + str(depth) + " = " + l.code + " in v" + str(depth) + " + " + r.code + ")"}

fn cag_fuzz_one(root, tmp, idx, seed) = let g = cag_fuzz_expr(seed, 3) in let prog = "fn f(x: int) -> int = " + g.code + " + x\nprint f(" + str(idx + 1) + ")\n" in let r_nat = cag_compile_run(root, tmp, "fuzz_" + str(idx), prog) in if r_nat.ok == 0 or r_nat.status != 0 then "fuzzer native run failed on case " + str(idx) + ": " + r_nat.err else let src = tmp + "/fuzz_" + str(idx) + ".src" in let elf = tmp + "/fuzz_" + str(idx) + ".elf" in let r_gc = cag_sh("LUME_GC_STRESS=1 \"" + elf + "\"", tmp + "/fuzz_gc_" + str(idx) + ".out") in let r_seed = cag_run(root + "/bootstrap/lume0/lume0", Cons("run", Cons(root + "/compiler/stage1/compiler_in_core.lume", Cons(src, Nil))), tmp + "/fuzz_seed_" + str(idx) + ".out") in let r_caas = cag_input(root + "/build/bin/lcaas", Nil, src, tmp + "/fuzz_caas_" + str(idx) + ".out") in if r_gc.status != 0 or r_gc.out != r_nat.out then "fuzzer GC stress mismatch on case " + str(idx) else if r_seed.status != 0 or r_seed.out != r_nat.out then "fuzzer Stage-0 seed mismatch on case " + str(idx) else if r_caas.status != 0 or cag_contains(r_caas.out, "\"ok\":true") == 0 then "fuzzer lcaas failed on case " + str(idx) else ""

fn cag_fuzz_loop(root, tmp, idx, n, seed) = if idx >= n then "" else let err = cag_fuzz_one(root, tmp, idx, seed) in if err != "" then err else cag_fuzz_loop(root, tmp, idx + 1, n, cag_prng(seed))

fn cag_check_redteam_r2(root, tmp) = let lb = chr(123) in let rb = chr(125) in let r2_inv = tmp + "/rt2_inv.src" in let w1 = fs_write_sync(r2_inv, "type Pos = " + lb + " v: int " + rb + " invariant v > 0\nfn mk_bad(x: int) -> Pos = Pos " + lb + " v: x " + rb + "\nprint (mk_bad(0 - 5)).v\n") in let p1 = cag_input(root + "/build/bin/lcaas", Nil, r2_inv, tmp + "/rt2_inv.out") in if cag_contains(p1.out, "\"ok\":true") == 1 then "RT2-A02/A06 failed: lcaas accepted unguarded record construction violating type invariant" else let r2_eff = tmp + "/rt2_eff.src" in let w2 = fs_write_sync(r2_eff, "fn spoof() -> int / pure = with handler fs " + lb + " fn op() = 0 " + rb + " in fs_path_exists(\"a\")\nprint spoof()\n") in let p2 = cag_input(root + "/build/bin/lumec", Nil, r2_eff, tmp + "/rt2_eff.s") in if p2.status == 0 or cag_contains(p2.err, "E0200") == 0 then "RT2-B05 failed: with-handler spoofed primitive io/fs effect inside / pure" else let r2_dup = tmp + "/rt2_dup.src" in let w3 = fs_write_sync(r2_dup, "fn dup_param(x: int, x: int) -> int = x\nprint dup_param(1, 2)\n") in let p3 = cag_input(root + "/build/bin/lumec", Nil, r2_dup, tmp + "/rt2_dup.s") in if p3.status == 0 then "RT2-B06 failed: duplicate parameter name was not rejected" else let r2_exh = tmp + "/rt2_exh.src" in let w4 = fs_write_sync(r2_exh, "fn bad_match(x: int) -> int = match x\n    1 => 10\n    2 => 20\nprint bad_match(3)\n") in let p4 = cag_input(root + "/build/bin/lumec", Nil, r2_exh, tmp + "/rt2_exh.s") in if p4.status == 0 or cag_contains(p4.err, "T1002") == 0 then "RT2-B07 failed: non-exhaustive integer literal match was not rejected with [T1002]" else let r2_lasm = tmp + "/rt2_bad.s" in let w5 = fs_write_sync(r2_lasm, ".globl _start\n_start:\n    bogus_mnemonic %rax, %rbx\n") in let p5 = cag_run(root + "/build/bin/lasm", Cons("--strict", Cons(r2_lasm, Nil)), tmp + "/rt2_bad.elf") in if p5.status == 0 then "RT2-B09 failed: lasm accepted unknown instruction mnemonic" else ""

fn cag_check_round3_ui_vec_wave10(root, tmp) = let dec_s = fs_read_file(root + "/compiler/stage1/decimal.src") in let sen_s = fs_read_file(root + "/compiler/stage1/lsentience.src") in let man_s = fs_read_file(root + "/compiler/stage1/lmanual.src") in let int_s = fs_read_file(root + "/compiler/stage1/linteractive.src") in if cag_contains(dec_s, "decimal_clamp") == 0 then "decimal.src missing decimal_clamp" else if cag_contains(sen_s, "sentience_daemon_triad_json") == 0 or cag_contains(sen_s, "sentience_hot_evolve_json") == 0 or cag_contains(sen_s, "sentience_live_cockpit_json") == 0 then "lsentience.src missing Wave 10 daemon-triad/hot-evolve/live-cockpit markers" else if cag_contains(man_s, "@ui-layout") == 0 or cag_contains(man_s, "ui_split_conservation_law") == 0 or cag_contains(man_s, "vec_clamp_index") == 0 or cag_contains(man_s, "vec_checked_slice_len") == 0 or cag_contains(man_s, "map_checked_slot") == 0 or cag_contains(int_s, "@ui-layout") == 0 then "lmanual.src or linteractive.src missing @ui-layout/vec/Wave 10 markers" else if fs_path_exists(root + "/compiler/stage1/vec.src") == 1 then let vec_s = fs_read_file(root + "/compiler/stage1/vec.src") in let r_vp = cag_run(root + "/build/bin/lume_driver", Cons("prove", Cons(root + "/compiler/stage1/vec.src", Nil)), tmp + "/vec_prove.out") in if cag_contains(vec_s, "vec_clamp_index") == 0 or cag_contains(vec_s, "vec_checked_slice_len") == 0 or cag_contains(vec_s, "map_checked_slot") == 0 or r_vp.status != 0 or cag_contains(r_vp.out, "\"ok\":true") == 0 then "vec.src collection contracts check failed: " + r_vp.out + r_vp.err else "" else ""

fn ag_test_wave4_zero_limitation_tensor_fp_and_assimilator(root) = let tmp = root + "/build/claude-audit-gate" in let rm_ch = os_run("/bin/rm", Cons("-f", Cons(root + "/build/bin/lchameleon", Nil))) in let b_ch = cag_run(root + "/build/bin/lume_driver", Cons("build", Cons(root + "/compiler/stage1/lchameleon.src", Cons("-o", Cons(root + "/build/bin/lchameleon", Nil)))), tmp + "/w4_lcham_build.out") in let r_ch = cag_run(root + "/build/bin/lchameleon", Nil, tmp + "/w4_lcham.out") in let r_caas = cag_run(root + "/build/bin/lume_driver", Cons("prove", Cons(root + "/compiler/stage1/lchameleon.src", Nil)), tmp + "/w4_lcaas.out") in let want_ch = cag_test_count("\n" + fs_read_file(root + "/compiler/stage1/lchameleon.src"), 0, 0) in if b_ch.status != 0 or r_ch.status != 0 or want_ch < 18 or r_ch.out != str(want_ch) + "\n" then "lchameleon binary did not return the number of its own unit tests (" + str(want_ch) + "): " + r_ch.out + r_ch.err else if r_caas.status != 0 or cag_contains(r_caas.out, "\"ok\":true") == 0 or cag_contains(r_caas.out, "fp_bf16_nan_inf_rejection_law") == 0 or cag_contains(r_caas.out, "fp_quire_associativity_law") == 0 or cag_contains(r_caas.out, "fp_interval_soundness_enclosure_law") == 0 or cag_contains(r_caas.out, "pkg_assimilate_supply_chain_backdoor_rejected_law") == 0 or cag_contains(r_caas.out, "pkg_mvcc_uncommitted_invisible_law") == 0 or cag_contains(r_caas.out, "lumeputer_deltanet_zero_drift_retention_law") == 0 or cag_contains(r_caas.out, "lumepu_vx_vmat_zero_bf16_drift_law") == 0 or cag_contains(r_caas.out, "lumeputer_stack_frame_push_pop_identity_law") == 0 or cag_contains(r_caas.out, "prover_octagon_transitivity_soundness_law") == 0 or cag_contains(r_caas.out, "prover_loop_ranking_strict_decrease_law") == 0 or cag_contains(r_caas.out, "incremental_iface_mismatch_forces_recompile_law") == 0 or cag_contains(r_caas.out, "lumeputer_ecall_mret_roundtrip_law") == 0 or cag_contains(r_caas.out, "lumeputer_inweights_lcert_soundness_law") == 0 or cag_contains(r_caas.out, "prover_farkas_contradiction_soundness_law") == 0 or cag_contains(r_caas.out, "prover_bitshift_shl_monotonic_law") == 0 or cag_contains(r_caas.out, "ffi_callback_stale_epoch_rejected_law") == 0 or cag_contains(r_caas.out, "diag_fuzzy_exact_match_zero_score_law") == 0 or cag_contains(r_caas.out, "ssa_zero_spill_when_k_colorable_law") == 0 or cag_contains(r_caas.out, "avx512_vectorized_strictly_faster_law") == 0 or cag_contains(r_caas.out, "ffi_auto_abi_size_mismatch_rejected_law") == 0 or cag_contains(r_caas.out, "io_uring_backpressure_no_overflow_law") == 0 or cag_contains(r_caas.out, "prover_inductive_cycle_rejected_law") == 0 or cag_contains(r_caas.out, "vex_simd_hardware_add4_linearity_law") == 0 or cag_contains(r_caas.out, "io_uring_kernel_sqe_cqe_conservation_law") == 0 or cag_contains(r_caas.out, "ast_native_quadratic_square_completion_law") == 0 or cag_contains(r_caas.out, "c_header_unterminated_ifdef_rejected_law") == 0 then "Wave 4/5/6/7/8/9/10 lcaas formal proof failed on lchameleon.src: " + r_caas.out + r_caas.err else ""

## A unit-test run is accepted on what it shows, not on a count written down here: exit status 0, the "N passed,
## 0 failed" summary, and one `ok   <name>` line for every `fn test_*` that the source file itself defines. A test that
## is added later is covered at once; a test that is removed, skipped or failing is a failure of this gate.
fn cag_find(text, part, i) = if i + count(part) > count(text) then 0 - 1 else if slice(text, i, i + count(part)) == part then i else cag_find(text, part, i + 1)
fn cag_name_end(s, i) = if i >= count(s) or at(s, i) == "(" then i else cag_name_end(s, i + 1)
fn cag_tests_missing(src, out, i, n) = let p = cag_find(src, "\nfn test_", i) in if p < 0 then (if n > 0 then "" else "(no tests found in the source)") else let e = cag_name_end(src, p + 4) in let nm = slice(src, p + 4, e) in if cag_contains(out, "ok   " + nm + "\n") == 0 then nm else cag_tests_missing(src, out, e, n + 1)
## the number of `fn test_*` a source file defines (the module binary prints the sum of its own tests, each 1 on success)
fn cag_test_count(src, i, n) = let p = cag_find(src, "\nfn test_", i) in if p < 0 then n else cag_test_count(src, p + 9, n + 1)
fn cag_tests_problem(path, r) = if r.status != 0 then "exit status " + str(r.status) else if cag_contains(r.out, " passed, 0 failed") == 0 then "no 'N passed, 0 failed' summary" else let miss = cag_tests_missing("\n" + fs_read_file(path), r.out, 0, 0) in if miss == "" then "" else "no 'ok' line for " + miss

fn cag_check_win64_gui_interp_chameleon(root, tmp) = let r_reg = cag_run(root + "/build/bin/lume_driver", Cons("test", Cons(root + "/compiler/stage1/win64_gui_and_interp_regression_ok.src", Nil)), tmp + "/w64_reg.out") in if r_reg.status != 0 or cag_contains(r_reg.out, "8 passed, 0 failed") == 0 then "win64_gui_and_interp_regression_ok.src failed: " + r_reg.out + r_reg.err else let r_cham_t = cag_run(root + "/build/bin/lume_driver", Cons("test", Cons(root + "/compiler/stage1/lchameleon.src", Nil)), tmp + "/cham_test.out") in if cag_tests_problem(root + "/compiler/stage1/lchameleon.src", r_cham_t) != "" then "lchameleon.src unit tests failed (" + cag_tests_problem(root + "/compiler/stage1/lchameleon.src", r_cham_t) + "): " + r_cham_t.out + r_cham_t.err else let r_cham_p = cag_run(root + "/build/bin/lume_driver", Cons("prove", Cons(root + "/compiler/stage1/lchameleon.src", Nil)), tmp + "/cham_prove.out") in if r_cham_p.status != 0 or cag_contains(r_cham_p.out, "\"ok\":true") == 0 or cag_contains(r_cham_p.out, "\"status\":\"proven\"") == 0 then "lchameleon.src QF_LIA proof failed: " + r_cham_p.out + r_cham_p.err else let r_cham_c = cag_run(root + "/build/bin/lume_driver", Cons("certify", Cons(root + "/compiler/stage1/lchameleon.src", Nil)), tmp + "/cham_cert.out") in if r_cham_c.status != 0 or cag_contains(r_cham_c.out, "Lume Verified") == 0 then "lchameleon.src certification failed: " + r_cham_c.out + r_cham_c.err else let r_cham_cli = cag_run(root + "/build/bin/lume_driver", Cons("chameleon", Nil), tmp + "/cham_cli.out") in if r_cham_cli.status != 0 or cag_contains(r_cham_cli.out, "\"ecosystems_supported\":9") == 0 or cag_contains(r_cham_cli.out, "\"ecosystems_verified\":9") == 0 or cag_contains(r_cham_cli.out, "\"tensor_fp_quire_interval_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"autonomous_pkg_assimilator_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"lumeputer_rv32im_in_weights_vm_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"lumepu_vx_npu_deltanet_zero_drift_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"lumeputer_stack_lweights_compiler_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"octagon_interval_loop_prover_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"incremental_iface_signature_cache_v2_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"lumeputer_ecall_lcert_in_weights_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"farkas_dual_bitshift_prover_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"ffi_callback_epoch_and_fuzzy_repair_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"ssa_chaitin_avx512_optimizer_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"automated_ffi_io_uring_zero_copy_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"nonlinear_horner_inductive_graph_prover_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"structural_compiler_pass_evolver_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"vex_evex_simd_hardware_codegen_verified\":true") == 0 or cag_contains(r_cham_cli.out, "\"ast_native_horner_quadratic_prover_verified\":true") == 0 then "lume chameleon CLI failed: " + r_cham_cli.out + r_cham_cli.err else let w4_err = ag_test_wave4_zero_limitation_tensor_fp_and_assimilator(root) in if w4_err != "" then w4_err else let r_ufe_cli = cag_run(root + "/build/bin/lume_driver", Cons("unified-field", Nil), tmp + "/ufe_cli.out") in let r_sng_cli = cag_run(root + "/build/bin/lume_driver", Cons("singularity", Nil), tmp + "/sng_cli.out") in let r_iec_cli = cag_run(root + "/build/bin/lume_driver", Cons("iec62443", Nil), tmp + "/iec_cli.out") in let r_cnd_cli = cag_run(root + "/build/bin/lume_driver", Cons("conduite", Nil), tmp + "/cnd_cli.out") in let r_msh_cli = cag_run(root + "/build/bin/lume_driver", Cons("omega-mesh", Nil), tmp + "/msh_cli.out") in let r_sub_cli = cag_run(root + "/build/bin/lume_driver", Cons("subsea", Nil), tmp + "/sub_cli.out") in let r_lp_cli = cag_run(root + "/build/bin/lume_driver", Cons("lumeputer", Nil), tmp + "/lp_cli.out") in let r_lpu_cli = cag_run(root + "/build/bin/lume_driver", Cons("lumepu", Nil), tmp + "/lpu_cli.out") in let r_qp_cli = cag_run(root + "/build/bin/lume_driver", Cons("qwenputer", Nil), tmp + "/qp_cli.out") in if r_ufe_cli.status != 0 or cag_contains(r_ufe_cli.out, "\"mode\":\"cyber-physical-ufe-ote\"") == 0 or r_sng_cli.status != 0 or cag_contains(r_sng_cli.out, "\"tau_max_ms\":250") == 0 or cag_contains(r_sng_cli.out, "\"beta_binomial_posterior_num\":3") == 0 or r_iec_cli.status != 0 or cag_contains(r_iec_cli.out, "\"l4_to_l2_direct_blocked\":true") == 0 or r_cnd_cli.status != 0 or cag_contains(r_cnd_cli.out, "\"conduit_ha_parity_ok\":true") == 0 or r_msh_cli.status != 0 or cag_contains(r_msh_cli.out, "\"mesh_raft_quorum_verified\":true") == 0 or r_sub_cli.status != 0 or cag_contains(r_sub_cli.out, "\"catenary_top_tension_n\":650000") == 0 or r_lp_cli.status != 0 or cag_contains(r_lp_cli.out, "\"mode\":\"lumeputer-lumepu-vm\"") == 0 or cag_contains(r_lp_cli.out, "\"recursive_stack_sp_verified\":true") == 0 or cag_contains(r_lp_cli.out, "\"ecall_mret_csr_and_inweights_lcert_verified\":true") == 0 or cag_contains(r_lp_cli.out, "\"ssa_chaitin_avx512_optimizer_verified\":true") == 0 or cag_contains(r_lp_cli.out, "\"structural_compiler_pass_evolver_verified\":true") == 0 or cag_contains(r_lp_cli.out, "\"vex_evex_simd_hardware_codegen_verified\":true") == 0 or r_lpu_cli.status != 0 or cag_contains(r_lpu_cli.out, "\"deltanet_zero_bf16_drift_verified\":true") == 0 or r_qp_cli.status != 0 or cag_contains(r_qp_cli.out, "\"meta_neural_stories260k_in_weights_ready\":true") == 0 then "lume unified-field/singularity/iec62443/conduite/omega-mesh/subsea/lumeputer CLI failed" else cag_check_round3_ui_vec_wave10(root, tmp)

## ---- Pillar 2: adversarial prover-unsoundness fuzzer. Every program is valid syntax with a FALSE contract whose
## ---- counterexample is a boundary value; the printed call itself satisfies the contract wherever one can, so only the
## ---- prover can catch it. Two TRUE controls keep the "not proven" verdict from being vacuous.
fn cag_ft(name, params, contract, body, call) = "fn " + name + "(" + params + ") -> int " + contract + " = " + body + "\nprint " + name + "(" + call + ")\n"
fn cag_ft_paren(s, i) = if i >= count(s) or at(s, i) == "(" then i else cag_ft_paren(s, i + 1)
fn cag_ft_name(prog) = slice(prog, 3, cag_ft_paren(prog, 3))
fn cag_ft_syntax(text) = if cag_contains(text, "P0001") == 1 or cag_contains(text, "P0002") == 1 then 1 else 0
fn cag_ft_lumec(root, tmp, name, prog) = let src = tmp + "/" + name + ".src" in let w = fs_write_sync(src, prog) in cag_input(root + "/build/bin/lumec", Nil, src, tmp + "/" + name + ".s")
fn cag_ft_prove(root, tmp, name, prog) = let inp = tmp + "/" + name + ".prove.in" in let w = fs_write_sync(inp, "@mode prove\n" + prog) in cag_input(root + "/build/bin/lcaas", Nil, inp, tmp + "/" + name + ".prove.out")
fn cag_ft_kill(root, tmp, prog) = let name = cag_ft_name(prog) in let c = cag_ft_lumec(root, tmp, name, prog) in let p = cag_ft_prove(root, tmp, name, prog) in if c.status == 0 then "UNSOUND: lumec accepted false theorem " + name else if cag_ft_syntax(c.err) == 1 then "false theorem " + name + " was rejected by lumec as a syntax error, not by the prover: " + c.err else if cag_contains(c.err, "[V0001]") == 0 then "false theorem " + name + " was rejected by lumec without [V0001]: " + c.err else if cag_ft_syntax(p.out + p.err) == 1 then "false theorem " + name + " was rejected by lcaas as a syntax error, not by the prover: " + p.out + p.err else if cag_contains(p.out, "\"status\":\"proven\"") == 1 then "UNSOUND: lcaas @mode prove reported false theorem " + name + " as proven" else if cag_contains(p.out, "\"status\":\"") == 0 and cag_contains(p.out, "V0001") == 0 then "lcaas gave no verdict on false theorem " + name + ": " + p.out + p.err else ""
fn cag_ft_control(root, tmp, prog) = let name = cag_ft_name(prog) in let c = cag_ft_lumec(root, tmp, name, prog) in let p = cag_ft_prove(root, tmp, name, prog) in if c.status != 0 then "false-theorem control " + name + " (a TRUE contract) was rejected by lumec: " + c.err else if cag_contains(p.out, "\"status\":\"proven\"") == 0 then "false-theorem control " + name + " (a TRUE contract) was not proven by lcaas @mode prove: " + p.out + p.err else ""
fn cag_ft_controls(root, tmp) = let e1 = cag_ft_control(root, tmp, cag_ft("ft_ctl_identity", "x: int", "requires x >= 0 ensures result >= 0", "x", "7")) in if e1 != "" then e1 else cag_ft_control(root, tmp, cag_ft("ft_ctl_tight_linear", "x: int", "requires x >= 0 and x <= 10 ensures result <= 21", "2 * x + 1", "3"))
fn cag_ft_run(root, tmp, cases, n) = match cases
    Nil        => {err: "", n: n}
    Cons(h, t) => let e = cag_ft_kill(root, tmp, h) in if e != "" then {err: e, n: n} else cag_ft_run(root, tmp, t, n + 1)

fn cag_ft_lia_cases() = Cons(cag_ft("ft_lia_strict_zero", "x: int", "requires x >= 0 ensures result > 0", "x", "1"), Cons(cag_ft("ft_lia_sum_strict", "x: int, y: int", "requires x >= 0 and y >= 0 and x <= 1000 and y <= 1000 ensures result > x", "x + y", "1, 1"), Cons(cag_ft("ft_lia_upper_tight", "x: int", "requires x >= 0 and x <= 10 ensures result <= 20", "2 * x + 1", "3"), Cons(cag_ft("ft_lia_clamp_strict", "x: int", "requires x >= 0 and x <= 100 ensures result < 100", "if x > 100 then 100 else x", "5"), Cons(cag_ft("ft_lia_max_strict", "a: int, b: int", "requires a >= 0 and a <= 1000 and b >= 0 and b <= 1000 ensures result > a", "if a >= b then a else b", "1, 2"), Cons(cag_ft("ft_lia_diff_positive", "a: int, b: int", "requires b >= 0 and a >= b and a <= 1000 ensures result >= 1", "a - b", "5, 2"), Cons(cag_ft("ft_lia_mid_strict", "lo: int, hi: int", "requires lo >= 0 and hi <= 1000 and lo <= hi ensures result < hi", "lo + (hi - lo) / 2", "2, 8"), Cons(cag_ft("ft_lia_triple_plus_one", "x: int", "requires x >= 1 and x <= 50 ensures result == 3 * x", "x + x + x + 1", "2"), Nil))))))))
fn cag_ft_mod_cases() = Cons(cag_ft("ft_mod_neg_nonneg", "x: int", "requires x >= 0 - 9 and x <= 9 ensures result >= 0", "x % 3", "4"), Cons(cag_ft("ft_mod_upper_tight", "x: int", "requires x >= 0 and x <= 1000 ensures result < 6", "x % 7", "3"), Cons(cag_ft("ft_mod_never_zero", "x: int", "requires x >= 1 and x <= 1000 ensures result >= 1", "x % 5", "3"), Cons(cag_ft("ft_mod_neg_never_zero", "x: int", "requires x >= 0 - 100 and x <= 0 - 1 ensures result <= 0 - 1", "x % 4", "-3"), Nil))))
fn cag_ft_wrap_cases() = Cons(cag_ft("ft_wrap_add_positive", "x: int, y: int", "requires x > 0 and y > 0 ensures result > 0", "x +% y", "1, 1"), Cons(cag_ft("ft_wrap_sub_negative", "x: int", "requires x <= 0 ensures result < 0", "x -% 1", "0"), Cons(cag_ft("ft_wrap_mul_positive", "x: int", "requires x > 0 ensures result > 0", "x *% 2", "1"), Cons(cag_ft("ft_wrap_mul_monotone", "x: int", "requires x >= 1 ensures result >= x", "x *% 3", "1"), Cons(cag_ft("ft_wrap_double_nonneg", "x: int", "requires x >= 0 ensures result >= 0", "x +% x", "1"), Nil)))))
fn cag_ft_quad_cases() = Cons(cag_ft("ft_quad_strict_growth", "x: int", "requires x >= 0 and x <= 1000 ensures result > x", "x * x", "2"), Cons(cag_ft("ft_quad_upper_tight", "x: int", "requires x >= 0 - 10 and x <= 10 ensures result <= 99", "x * x", "3"), Cons(cag_ft("ft_quad_positive", "x: int", "requires x >= 0 - 100 and x <= 100 ensures result >= 1", "x * x", "3"), Cons(cag_ft("ft_quad_result_square", "x: int", "requires x >= 0 and x <= 100 ensures result * result >= x + 1", "x", "2"), Cons(cag_ft("ft_quad_cross_sign", "x: int, y: int", "requires x >= 0 - 50 and x <= 50 and y >= 0 - 50 and y <= 50 ensures result >= 0", "x * y", "2, 3"), Nil)))))
fn cag_ft_shadow_cases() = Cons(cag_ft("ft_shadow_let_param", "x: int", "requires x >= 0 and x <= 100 ensures result == x", "let x = x + 1 in x", "1"), Cons(cag_ft("ft_shadow_let_chain", "x: int", "requires x >= 1 and x <= 100 ensures result > x", "let y = x in let x = y - 1 in x", "5"), Cons(cag_ft("ft_shadow_let_halved", "x: int", "requires x >= 0 and x <= 100 ensures result >= x", "let x = x / 2 in x", "0"), Nil)))
fn cag_ft_impl_cases() = Cons(cag_ft("ft_impl_contradictory", "x: int", "requires x >= 0 - 100 and x <= 100 ensures (x <= 0 or result > 0) and (x > 0 or result > 0)", "x", "1"), Cons(cag_ft("ft_impl_swapped_max", "x: int, y: int", "requires x >= 0 and x <= 10 and y >= 0 and y <= 10 ensures (x < y or result == x) and (x >= y or result == y)", "if x > y then y else x", "2, 2"), Cons(cag_ft("ft_impl_gap", "x: int", "requires x >= 0 and x <= 100 ensures (x < 10 or result >= 10) and (x >= 10 or result < 9)", "x", "20"), Nil)))
fn cag_ft_div_cases() = Cons(cag_ft("ft_div_half_positive", "x: int", "requires x >= 1 and x <= 1000 ensures result >= 1", "x / 2", "4"), Cons(cag_ft("ft_div_roundtrip", "x: int", "requires x >= 0 and x <= 1000 ensures result == x", "(x / 3) * 3", "3"), Cons(cag_ft("ft_div_strict_shrink", "x: int, d: int", "requires x >= 0 and x <= 1000 and d >= 1 and d <= 10 ensures result < x", "x / d", "4, 2"), Nil)))
fn cag_ft_ext_cases() = Cons(cag_ft("ft_ext_shl_strict", "x: int", "requires x >= 0 and x <= 1000 ensures result > x", "bit_shl(x, 1)", "1"), Cons(cag_ft("ft_ext_shr_positive", "x: int", "requires x >= 1 and x <= 1000 ensures result >= 1", "bit_shr(x, 1)", "4"), Cons(cag_ft("ft_ext_forall_shadow", "x: int", "requires x >= 0 and x <= 100 ensures forall_range(k, 0, 10, k <= result)", "let k = x in k", "1"), Cons(cag_ft("ft_ext_exists_shadow", "x: int", "requires x >= 0 and x <= 100 ensures exists_range(k, 0, 10, k > result and k < result + 1)", "let k = x in k", "1"), Nil))))

## PRNG off-by-one linear contracts: a*x + b on [0, n]. The tight bounds are b and a*n + b; the claim is one past either.
fn cag_ft_gen_one(idx, seed) = let s1 = cag_prng(seed) in let s2 = cag_prng(s1) in let s3 = cag_prng(s2) in let s4 = cag_prng(s3) in let a = s1 / 65536 % 9 + 1 in let b = s2 / 65536 % 97 in let n = s3 / 65536 % 50 + 1 in let upper = s4 / 65536 % 2 in let claim = if upper == 0 then "result <= " + str(a * n + b - 1) else "result >= " + str(b + 1) in let call = if upper == 0 then "0" else str(n) in cag_ft("ft_gen_" + str(idx), "x: int", "requires x >= 0 and x <= " + str(n) + " ensures " + claim, str(a) + " * x + " + str(b), call)
fn cag_ft_gen_loop(root, tmp, idx, n, seed) = if idx >= n then "" else let e = cag_ft_kill(root, tmp, cag_ft_gen_one(idx, seed)) in if e != "" then e else cag_ft_gen_loop(root, tmp, idx + 1, n, cag_prng(cag_prng(cag_prng(cag_prng(seed)))))

fn cag_fuzz_false_theorems(root, tmp) = let ctl = cag_ft_controls(root, tmp) in if ctl != "" then ctl else let r1 = cag_ft_run(root, tmp, cag_ft_lia_cases(), 0) in if r1.err != "" then r1.err else let r2 = cag_ft_run(root, tmp, cag_ft_mod_cases(), r1.n) in if r2.err != "" then r2.err else let r3 = cag_ft_run(root, tmp, cag_ft_wrap_cases(), r2.n) in if r3.err != "" then r3.err else let r4 = cag_ft_run(root, tmp, cag_ft_quad_cases(), r3.n) in if r4.err != "" then r4.err else let r5 = cag_ft_run(root, tmp, cag_ft_shadow_cases(), r4.n) in if r5.err != "" then r5.err else let r6 = cag_ft_run(root, tmp, cag_ft_impl_cases(), r5.n) in if r6.err != "" then r6.err else let r7 = cag_ft_run(root, tmp, cag_ft_div_cases(), r6.n) in if r7.err != "" then r7.err else let r8 = cag_ft_run(root, tmp, cag_ft_ext_cases(), r7.n) in if r8.err != "" then r8.err else if r8.n < 35 then "false-theorem fuzzer ran too few hand-written cases: " + str(r8.n) else cag_ft_gen_loop(root, tmp, 0, 16, 424242)

## ---- Pillar 3: gate mutation-kill harness. Each mutant is paired with an unmutated control that must pass, and
## ---- must die with its exact code; a mutant that dies for another reason counts as a survivor.
fn cag_mut_pair(root, tmp, name, orig, mutant, code) = let o = cag_ft_lumec(root, tmp, "mut_" + name + "_orig", orig) in if o.status != 0 then "mutation control " + name + ": the unmutated program does not compile: " + o.err else let m = cag_ft_lumec(root, tmp, "mut_" + name + "_kill", mutant) in if m.status == 0 then "mutant SURVIVED (" + name + "): lumec accepted it, expected [" + code + "]" else if cag_contains(m.err, "[" + code + "]") == 0 then "mutant " + name + " died for the wrong reason, expected [" + code + "]: " + m.err else if m.status != 3 then "mutant " + name + " died with exit status " + str(m.status) + ", expected 3" else if fs_read_byte(tmp + "/mut_" + name + "_kill.s", 0) >= 0 then "mutant " + name + " was rejected but assembly was still emitted" else ""
fn cag_mut_lines(s, i) = if i >= count(s) then Nil else let e = cag_line_end(s, i) in Cons(slice(s, i, e), cag_mut_lines(s, e + 1))
fn cag_mut_own(root, tmp, names, n) = match names
    Nil        => if n > 0 then "" else "no O0001/O0002 ownership mutant found in tests/conformance/stage1/ownership/MANIFEST"
    Cons(h, t) => if h == "" then cag_mut_own(root, tmp, t, n) else let path = root + "/tests/conformance/stage1/ownership/" + h + ".src" in let src = fs_read_file(path) in let head = slice(src, 0, cag_line_end(src, 0)) in if head != "## expect: reject O0001" and head != "## expect: reject O0002" then cag_mut_own(root, tmp, t, n) else let code = slice(head, 18, count(head)) in let c = cag_input(root + "/build/bin/lumec", Nil, path, tmp + "/mut_own_" + h + ".s") in if c.status == 0 then "mutant SURVIVED (ownership " + h + "): lumec accepted it, expected [" + code + "]" else if cag_contains(c.err, "[" + code + "]") == 0 then "ownership mutant " + h + " died for the wrong reason, expected [" + code + "]: " + c.err else cag_mut_own(root, tmp, t, n + 1)
fn cag_mut_lasm(root, tmp) = let ok_s = tmp + "/mut_simd_orig.s" in let bad_s = tmp + "/mut_simd_kill.s" in let w1 = fs_write_sync(ok_s, ".globl _start\n_start:\n    vpxorq %zmm1, %zmm2, %zmm3\n") in let w2 = fs_write_sync(bad_s, ".globl _start\n_start:\n    vpxorq %zmm1, %zmm2, %zmm32\n") in let o = cag_run(root + "/build/bin/lasm", Cons("--strict", Cons(ok_s, Nil)), tmp + "/mut_simd_orig.elf") in if o.status != 0 then "mutation control simd: lasm --strict rejected a valid EVEX instruction: " + o.err else let m = cag_run(root + "/build/bin/lasm", Cons("--strict", Cons(bad_s, Nil)), tmp + "/mut_simd_kill.elf") in if m.status == 0 then "mutant SURVIVED (simd): lasm --strict accepted register %zmm32, expected L0001" else if cag_contains(m.err, "L0001") == 0 then "mutant simd died for the wrong reason, expected L0001: " + m.err else ""
fn cag_mut_adapt_one(root, tmp, name, header) = let h = tmp + "/mut_hdr_" + name + ".h" in let w = fs_write_sync(h, header) in cag_run(root + "/build/bin/lume_driver", Cons("adapt", Cons("c", Cons("--json", Cons(h, Nil)))), tmp + "/mut_hdr_" + name + ".json")
fn cag_mut_adapt(root, tmp) = let o = cag_mut_adapt_one(root, tmp, "orig", "int64_t mut_checksum(const char *text);\n") in if o.status != 0 then "mutation control c-header: adapt c rejected a safe prototype: " + o.out + o.err else let m1 = cag_mut_adapt_one(root, tmp, "variadic", "int64_t mut_checksum(const char *text, ...);\n") in if m1.status == 0 then "mutant SURVIVED (c-header variadic): adapt c exited 0" else if cag_contains(m1.out, "\"code\":\"I0003\"") == 0 or cag_contains(m1.out, "\"ok\":false") == 0 then "mutant c-header variadic died for the wrong reason, expected I0003: " + m1.out else let m2 = cag_mut_adapt_one(root, tmp, "mutable_buffer", "int64_t mut_checksum(char *text);\n") in if m2.status == 0 then "mutant SURVIVED (c-header mutable buffer): adapt c exited 0" else let m3 = cag_mut_adapt_one(root, tmp, "callback", "int64_t mut_checksum(int64_t (*cb)(int64_t));\n") in if m3.status == 0 then "mutant SURVIVED (c-header callback): adapt c exited 0" else ""
fn cag_check_mutation_kills(root, tmp) = let e1 = cag_mut_pair(root, tmp, "ensures", "fn mk_abs(x: int) -> int requires x >= 0 - 1000 and x <= 1000 ensures result >= 0 = if x < 0 then 0 - x else x\nprint mk_abs(7)\n", "fn mk_abs(x: int) -> int requires x >= 0 - 1000 and x <= 1000 ensures result > 0 = if x < 0 then 0 - x else x\nprint mk_abs(7)\n", "V0001") in if e1 != "" then e1 else let e2 = cag_mut_pair(root, tmp, "body_op", "fn mk_next(x: int) -> int requires x >= 0 and x <= 1000 ensures result > x = x + 1\nprint mk_next(7)\n", "fn mk_next(x: int) -> int requires x >= 0 and x <= 1000 ensures result > x = x - 1\nprint mk_next(7)\n", "V0001") in if e2 != "" then e2 else let e3 = cag_mut_pair(root, tmp, "secret_let", "fn sel(plain_k: int) -> int =\n    let y = plain_k + 1 in\n    if y > 10 then 1 else 0\nprint sel(5)\n", "fn sel(secret_k: int) -> int =\n    let y = secret_k + 1 in\n    if y > 10 then 1 else 0\nprint sel(5)\n", "C0009") in if e3 != "" then e3 else let e4 = cag_mut_pair(root, tmp, "secret_branch", "fn pick_k(k: int) -> int = if k == 0 then 1 else 2\nprint pick_k(5)\n", "@secret fn pick_k(k: int) -> int = if k == 0 then 1 else 2\nprint pick_k(5)\n", "C0009") in if e4 != "" then e4 else let e5 = cag_mut_pair(root, tmp, "pure", "fn pf() -> int / pure = 41 + 1\nprint pf()\n", "fn pf() -> int / pure = fs_path_exists(\"a\")\nprint pf()\n", "E0200") in if e5 != "" then e5 else let e6 = cag_mut_pair(root, tmp, "match", "fn pick(xs: [int]) -> int = match xs\n    Nil => 0\n    Cons(h, t) => h\nprint pick(Cons(7, Nil))\n", "fn pick(x: int) -> int = match x\n    1 => 10\n    2 => 20\nprint pick(3)\n", "T1002") in if e6 != "" then e6 else let e7 = cag_mut_own(root, tmp, cag_mut_lines(fs_read_file(root + "/tests/conformance/stage1/ownership/MANIFEST"), 0), 0) in if e7 != "" then e7 else let e8 = cag_mut_lasm(root, tmp) in if e8 != "" then e8 else cag_mut_adapt(root, tmp)

## ---- Red Team Round 4 (2026-11): every program below is a FALSE theorem that an earlier toolchain reported as proven
## ---- (lumec elided the runtime check and lcaas said "proven"). Each is called at its counterexample: it must be
## ---- rejected with [V0001] or die on its runtime check with exit status 3, and lcaas must not call it proven.
fn cag_r4_cfg(root, tmp, lumec) = {tmp: tmp, lumec: lumec, lasm: root + "/build/bin/lasm", lcaas: root + "/build/bin/lcaas"}
fn cag_r4_arr() = "type Arr = enum\n    | ArrConst(int)\n    | ArrWrite(Arr, int, int)\n\nfn array_new(v: int) -> Arr = ArrConst(v)\nfn array_store(a: Arr, i: int, v: int) -> Arr = ArrWrite(a, i, v)\n"
fn cag_r4_sel(delta) = "fn array_select(a: Arr, i: int) -> int = match a\n    ArrConst(v) => v\n    ArrWrite(base, k, v) => if i == k then v" + delta + " else array_select(base, i)\n"
fn cag_r4_blind(params, reqs, ens, body, call) = "fn f(" + params + ", z: int) -> int requires z <= 0 - 1" + reqs + " ensures " + ens + " = " + body + "\nprint f(" + call + ", 0 - 1)\n"
## a body-level `let` that shadows a parameter must not change what `ensures` means
fn cag_r4_let_shadow() = cag_r4_blind("x: int, y: int", " and x >= 0 and x <= 100 and y >= 0 and y <= 100", "result == x", "let x = y in x + bit_and(z, 0)", "5, 6")
## bit_shl wraps at 64 bits; it is not multiplication unless the operand is bounded
fn cag_r4_shl_wrap() = cag_r4_blind("x: int", " and x >= 0", "result >= x", "bit_shl(x, 1) + bit_and(z, 0)", "4611686018427387904")
## bit_shr is an arithmetic shift: bit_shr(-9, 1) == -5
fn cag_r4_shr_floor() = cag_r4_blind("x: int", " and x >= 0 and x <= 9", "result >= 0 - 4", "bit_shr(0 - 9, 1) + bit_and(z, 0) + x - x", "1")
## a parameter spelled like the prover's internal quantifier symbol
fn cag_r4_quant_symbol() = "fn f(_q0_k: int) -> int requires _q0_k >= 0 and _q0_k <= 5 ensures forall_range(k, 0, 1000, k == _q0_k) = _q0_k\nprint f(1)\n"
## an exists_range witness substituted under a forall_range that rebinds the witness's variable
fn cag_r4_exists_capture() = "fn f(x: int) -> int requires x >= 0 and x <= 100 ensures exists_range(k, x, x, forall_range(x, 0, 100, k == x)) = x\nprint f(1)\n"
## program functions named like verifier builtins are verified as written, not as the builtin
fn cag_r4_user_clone() = "fn clone(a: int) -> int = a + 1\n" + cag_r4_blind("x: int", " and x >= 0 and x <= 10", "result == x", "clone(x) + bit_and(z, 0)", "1")
fn cag_r4_user_verify() = "fn verify(a: int) -> int = a + 1\n" + cag_r4_blind("x: int", " and x >= 0 and x <= 10", "result == x", "verify(x) + bit_and(z, 0)", "1")
fn cag_r4_user_dec_add() = "fn dec_add(a: int, b: int) -> int = a - b\n" + cag_r4_blind("x: int", " and x >= 0 and x <= 10", "result == x + x", "dec_add(x, x) + bit_and(z, 0)", "1")
## the array theory applies only to the canonical model; this array_select returns v + 1
fn cag_r4_theory_model() = cag_r4_arr() + cag_r4_sel(" + 1") + cag_r4_blind("a: Arr, i: int, v: int", "", "result == v", "array_select(array_store(a, i, v), i) + bit_and(z, 0)", "array_new(0), 1, 5")
## an opaque array read is keyed by the array, not by the spelling of a shadowing binder
fn cag_r4_array_shadow() = cag_r4_arr() + cag_r4_sel("") + cag_r4_blind("a: Arr, c: Arr, i: int", "", "result == array_select(a, i)", "(let a = c in array_select(a, i)) + bit_and(z, 0)", "array_new(1), array_new(2), 0")
## a proven postcondition does not license dropping the precondition check: g calls h outside h's `requires`
fn cag_r4_requires_kept() = "fn h(x: int) -> int requires x >= 10 ensures result >= 11 = x + 1\nfn g(y: int) -> int = h(y)\nprint g(2)\n"
## unfolding a call substitutes all parameters at once: sub2(y, x) is y - x, not x - x
fn cag_r4_param_swap() = "fn sub2(x: int, y: int, z: int) -> int = if x >= y then x - y + bit_and(z, 0) else x - y + bit_and(z, 0)\nfn f(x: int, y: int, z: int) -> int requires z <= 0 - 1 and x >= 0 and x <= 9 and y >= 0 and y <= 9 ensures result == 0 = sub2(y, x, z)\nprint f(1, 5, 0 - 1)\n"
## splitting a goal on a conditional hidden inside a callee must keep both branches
fn cag_r4_if_lift() = "fn esc(b: int, eb: int, z: int) -> int = if eb == 1 then b + 1 + bit_and(z, 0) else b\nfn f(b: int, eb: int, z: int) -> int requires z <= 0 - 1 and b >= 0 and b <= 4 and eb >= 0 and eb <= 1 ensures result <= b = esc(b, eb, z)\nprint f(1, 1, 0 - 1)\n"
fn cag_r4_cases() = Cons({n: "r4_param_swap", s: cag_r4_param_swap()}, Cons({n: "r4_if_lift", s: cag_r4_if_lift()}, Cons({n: "r4_let_shadow", s: cag_r4_let_shadow()}, Cons({n: "r4_shl_wrap", s: cag_r4_shl_wrap()}, Cons({n: "r4_shr_floor", s: cag_r4_shr_floor()}, Cons({n: "r4_quant_symbol", s: cag_r4_quant_symbol()}, Cons({n: "r4_exists_capture", s: cag_r4_exists_capture()}, Cons({n: "r4_user_clone", s: cag_r4_user_clone()}, Cons({n: "r4_user_verify", s: cag_r4_user_verify()}, Cons({n: "r4_user_dec_add", s: cag_r4_user_dec_add()}, Cons({n: "r4_theory_model", s: cag_r4_theory_model()}, Cons({n: "r4_array_shadow", s: cag_r4_array_shadow()}, Nil))))))))))))
fn cag_r4_false(cfg, name, src) = let b = pf_build(cfg, name, src) in if b.ok < 0 then "lasm rejected the compiler output for " + name + ": " + b.err else if b.ok == 0 then (if pf_syntax(b.err) == 0 and pf_contains(b.err, "[V0001]") == 1 then "" else "false theorem " + name + " was rejected without [V0001]: " + b.err) else let r = pf_run(cfg.tmp + "/" + name + ".elf", Nil, cfg.tmp + "/" + name + ".run") in if r.status == 0 then "UNSOUND (lumec): false theorem " + name + " ran to completion at its counterexample (the runtime check was elided), printed " + r.out else if r.status != 3 or pf_contains(r.err, "runtime contract violation (ensures) in 'f'") == 0 and pf_contains(r.err, "runtime contract violation (requires) in 'h'") == 0 then "false theorem " + name + " died for another reason (status " + str(r.status) + "): " + r.err else ""
fn cag_r4_caas(cfg, name, src) = let p = pf_caas(cfg, name, src) in if pf_proven(p.out, "f") == 1 then "UNSOUND (lcaas): false theorem " + name + " is reported as proven" else if pf_contains(p.out, "\"name\":\"f\",\"kind\":\"contract\",\"status\":\"") == 0 then "lcaas gave no verdict on " + name + ": " + p.out + p.err else ""
fn cag_r4_false_all(cfg, cases) = match cases
    Nil        => ""
    Cons(h, t) => let e = cag_join(cag_r4_false(cfg, h.n, h.s), cag_r4_caas(cfg, h.n, h.s)) in if e != "" then e else cag_r4_false_all(cfg, t)
## the fixes must not cost the TRUE theorems next to them: these stay proven (no runtime check) and print their value
fn cag_r4_true(cfg, name, src, expect) = let b = pf_build(cfg, name, src) in let p = pf_caas(cfg, name, src) in if b.ok != 1 then "true theorem " + name + " does not compile: " + b.err else let r = pf_run(cfg.tmp + "/" + name + ".elf", Nil, cfg.tmp + "/" + name + ".run") in if r.status != 0 or r.out != expect then "true theorem " + name + " did not run to " + expect + ": " + r.out + r.err else if pf_proven(p.out, "f") == 0 then "true theorem " + name + " is no longer proven by lcaas: " + p.out + p.err else if pf_contains(fs_read_file(cfg.tmp + "/" + name + ".s"), "(ensures) in 'f'") == 1 then "true theorem " + name + " is no longer proven by lumec (a runtime check was emitted)" else ""
fn cag_r4_controls(cfg) = let e1 = cag_r4_true(cfg, "r4_ok_array", cag_r4_arr() + cag_r4_sel("") + "fn f(a: Arr, i: int, v: int) -> int ensures result == v = array_select(array_store(a, i, v), i)\nprint f(array_new(0), 1, 5)\n", "5\n") in if e1 != "" then e1 else let e2 = cag_r4_true(cfg, "r4_ok_shl", "fn f(x: int) -> int requires x >= 0 and x <= 1000000 ensures result == x * 8 = bit_shl(x, 3)\nprint f(3)\n", "24\n") in if e2 != "" then e2 else let e3 = cag_r4_true(cfg, "r4_ok_nia", "fn f(h: int, w: int, d: int) -> int requires h >= 1 and w >= 1 and w <= 100000 and d >= 1 and d <= 10000 ensures result > h = h + w * d\nprint f(1, 1, 1)\n", "2\n") in if e3 != "" then e3 else let e4 = cag_r4_true(cfg, "r4_ok_forall", "fn f(n: int) -> int requires n >= 0 ensures result == 1 = forall_range(k, 0, n, k * k >= 0)\nprint f(3)\n", "1\n") in if e4 != "" then e4 else let e5 = cag_r4_true(cfg, "r4_ok_exists", "fn f(lo: int, hi: int) -> int requires lo <= hi ensures result == 1 = exists_range(k, lo, hi, k >= lo and k <= hi)\nprint f(1, 3)\n", "1\n") in if e5 != "" then e5 else let e6 = cag_r4_true(cfg, "r4_ok_lift", "fn esc(b: int, eb: int, es: int) -> int = if eb == 1 then (if es == 1 then (if b < 4 then b + 1 else 4) else b) else b\nfn f(b: int, eb: int, es: int) -> int requires b >= 0 and b <= 4 and eb >= 0 and eb <= 1 and es >= 0 and es <= 1 ensures result >= b and result <= 4 = esc(b, eb, es)\nprint f(1, 1, 1)\n", "2\n") in if e6 != "" then e6 else cag_r4_true(cfg, "r4_ok_let", "fn f(x: int, y: int) -> int requires x >= 0 and x <= 100 and y >= 0 and y <= 100 ensures result == y = let x = y in x\nprint f(5, 6)\n", "6\n")
## contract words cannot be redefined: one definition would be called by the generated code and ignored by the verifier
fn cag_r4_reserved_one(cfg, name, src) = let c = cag_ft_lumec_at(cfg, name, src) in if c.status == 0 then "lumec accepted a user definition of a contract builtin (" + name + ")" else if c.status != 3 or cag_contains(c.err, "[R0201]") == 0 then name + " was rejected for the wrong reason, expected [R0201]: " + c.err else ""
fn cag_ft_lumec_at(cfg, name, prog) = let src = cfg.tmp + "/" + name + ".src" in let w = fs_write_sync(src, prog) in cag_input(cfg.lumec, Nil, src, cfg.tmp + "/" + name + ".s")
fn cag_r4_reserved(cfg) = let e1 = cag_r4_reserved_one(cfg, "r4_def_old", "fn old(a: int) -> int = a + 1\nfn f(x: int) -> int = old(x)\nprint f(1)\n") in if e1 != "" then e1 else let e2 = cag_r4_reserved_one(cfg, "r4_def_forall", "fn forall_range(a: int, b: int, c: int, d: int) -> int = 96\nprint forall_range(1, 2, 3, 4)\n") in if e2 != "" then e2 else cag_r4_reserved_one(cfg, "r4_def_exists", "fn exists_range(a: int, b: int, c: int, d: int) -> int = 96\nprint exists_range(1, 2, 3, 4)\n")
fn cag_r4_kernel(root, tmp) = let r = cag_run(root + "/build/bin/lume_driver", Cons("test", Cons(root + "/compiler/stage1/lcert.src", Nil)), tmp + "/r4_lcert_test.out") in if cag_tests_problem(root + "/compiler/stage1/lcert.src", r) != "" or cag_contains(r.out, "ok   test_lcert_redteam_exists_witness_capture") == 0 or cag_contains(r.out, "ok   test_lcert_redteam_quantifier_symbol_collision") == 0 then "lcert kernel red-team regressions failed: " + r.out + r.err else ""
fn cag_check_redteam_r4(root, tmp) = let cfg = cag_r4_cfg(root, tmp, root + "/build/bin/lumec") in let e1 = cag_r4_false_all(cfg, cag_r4_cases()) in if e1 != "" then e1 else let e2 = cag_r4_controls(cfg) in if e2 != "" then e2 else let e3 = cag_r4_reserved(cfg) in if e3 != "" then e3 else let e4 = cag_r4_false(cfg, "r4_requires_kept", cag_r4_requires_kept()) in if e4 != "" then e4 else cag_r4_kernel(root, tmp)

## ---- Pillar 3b: mutation testing of the GATE. Each mutant is the real compiler with one soundness guard removed
## ---- (a textual edit of compiler/stage1/lumec.src that must apply exactly once), rebuilt from source. The Round 4 case
## ---- that guards it must then report exactly its "UNSOUND (lumec)" verdict; with the unmutated compiler the same
## ---- check passes (cag_check_redteam_r4). A gate that could not tell the mutant from the compiler would be theater.
fn cag_find_from(s, n, part, m, c0, i) = if i + m > n then 0 - 1 else if at(s, i) == c0 and slice(s, i, i + m) == part then i else cag_find_from(s, n, part, m, c0, i + 1)
fn cag_mutate(src, old, new) = let n = count(src) in let m = count(old) in let p = cag_find_from(src, n, old, m, at(old, 0), 0) in if p < 0 then {ok: 0, text: ""} else if cag_find_from(src, n, old, m, at(old, 0), p + 1) >= 0 then {ok: 0, text: ""} else {ok: 1, text: slice(src, 0, p) + new + slice(src, p + m, n)}
fn cag_mutant_build(root, tmp, tag, old, new) = let mu = cag_mutate(fs_read_file(root + "/compiler/stage1/lumec.src"), old, new) in if mu.ok == 0 then "compiler mutant " + tag + ": the guarded source text was not found exactly once (update the mutant with the code)" else let src = tmp + "/mutc_" + tag + ".src" in let w = fs_write_sync(src, mu.text) in let c = cag_ddc_input(root + "/build/bin/lumec", Nil, src, tmp + "/mutc_" + tag + ".s", 900000) in if c.status != 0 then "compiler mutant " + tag + " does not compile: " + c.err else let a = cag_ddc_run(root + "/build/bin/lasm", Cons("--strict", Cons(tmp + "/mutc_" + tag + ".s", Nil)), tmp + "/mutc_" + tag, 900000) in if a.status != 0 then "compiler mutant " + tag + " does not assemble: " + a.err else let cx = os_run("/bin/chmod", Cons("+x", Cons(tmp + "/mutc_" + tag, Nil))) in ""
fn cag_mutant_kill(root, tmp, tag, old, new, name, src) = let b = cag_mutant_build(root, tmp, tag, old, new) in if b != "" then b else let e = cag_r4_false(cag_r4_cfg(root, tmp, tmp + "/mutc_" + tag), name + "_mut", src) in if e == "" then "compiler mutant SURVIVED (" + tag + "): with the guard removed, the gate case " + name + " still passes" else if cag_contains(e, "UNSOUND (lumec): false theorem " + name + "_mut ran to completion") == 0 then "compiler mutant " + tag + " died for the wrong reason, expected the UNSOUND (lumec) verdict of " + name + ": " + e else ""
fn cag_check_compiler_mutants(root, tmp) = let e1 = cag_mutant_kill(root, tmp, "ensures_scope", "vlin_env_base(lenv, lenv))) in vprove_goals_all(", "lenv)) in vprove_goals_all(", "r4_let_shadow", cag_r4_let_shadow()) in if e1 != "" then e1 else let e2 = cag_mutant_kill(root, tmp, "shl_range", "lk.c0 <= 16 and vshl_in_range(la, lk.c0, hyps) == 1 then", "lk.c0 <= 16 and 1 == 1 then", "r4_shl_wrap", cag_r4_shl_wrap()) in if e2 != "" then e2 else let e3 = cag_mutant_kill(root, tmp, "shr_floor", "then vlin_const(vfm_fdiv(la.c0, p)) else vlin_bin_op(\"/\", a_e, Num(p)", "then vlin_const(la.c0 / p) else vlin_bin_op(\"/\", a_e, Num(p)", "r4_shr_floor", cag_r4_shr_floor()) in if e3 != "" then e3 else let e4 = cag_mutant_kill(root, tmp, "quant_symbol", "let lv = vlin_var(\"?q\" + str(len(hyps)) + \".\" + str(d) + \".\" + vnm) in", "let lv = vlin_var(\"_q\" + str(d) + \"_\" + vnm) in", "r4_quant_symbol", cag_r4_quant_symbol()) in if e4 != "" then e4 else let e5 = cag_mutant_kill(root, tmp, "requires_elided", "let post = if isnil(vsg.enss) == 1 or w12_keep_proven() == 0 and vqflia_prove_fn(ps, vsg.reqs, vsg.enss, raw_body, lctx.fns) == 1 then low_body else LetIn(", "if w12_keep_proven() == 0 and vqflia_prove_fn(ps, vsg.reqs, vsg.enss, raw_body, lctx.fns) == 1 then low_body else let post = if isnil(vsg.enss) == 1 then low_body else LetIn(", "r4_requires_kept", cag_r4_requires_kept()) in if e5 != "" then e5 else cag_mutant_kill(root, tmp, "user_fn_model", "else if vuser_shadows(cnm, fns) == 1 then vlin_ufn(vfnlookup(cnm, fns), vlin_args(args, hyps, lenv, fns, d), hyps, fns, d) else if (cnm == \"verify\"", "else if (cnm == \"verify\"", "r4_user_clone", cag_r4_user_clone())

## ---- Pillar 4: diverse double-compilation. C seed -> stage1_lumec -> stage2_from_seed must be bit-identical to
## ---- build/bin/lumec, and stage2_from_seed must reproduce its own assembly (fixpoint).
## ---- The seed is not taken on trust: its C sources are checked against bootstrap/lume0/SEED_FREEZE.sha256 and it is
## ---- rebuilt here by the host C compiler. When a second, unrelated C compiler is installed (clang), a second seed is
## ---- built with it and must produce the bit-identical stage1 compiler -- so a trojan would have to live in both.
fn cag_ddc_seed_build_cmd(root, d, cc, tag) = "cd \"" + root + "\" && sha256sum -c --quiet bootstrap/lume0/SEED_FREEZE.sha256 >&2 && cd bootstrap/lume0 && \"" + cc + "\" -std=c11 -O2 -o \"" + d + "/lume0_" + tag + "\" main.c lexer.c diag.c ast.c parser.c value.c interp.c lbe.c asmgen.c elf.c resolve.c -lm"
fn cag_ddc_seed_build(root, d, cc, tag) = let r = cag_ddc_run("/bin/sh", Cons("-c", Cons(cag_ddc_seed_build_cmd(root, d, cc, tag), Nil)), d + "/seed_build_" + tag + ".log", 600000) in if r.status != 0 or fs_path_exists(d + "/lume0_" + tag) != 1 then "DDC: cannot rebuild the frozen seed with " + cc + " from hash-verified sources (SEED_FREEZE.sha256): " + r.err else ""
fn cag_ddc_diverse(root, d, st1, lsrc) = if fs_path_exists("/usr/bin/clang") != 1 then "" else let b = cag_ddc_seed_build(root, d, "/usr/bin/clang", "clang") in if b != "" then b else let mk = os_run("/bin/mkdir", Cons("-p", Cons(d + "/clang", Nil))) in let s1 = cag_ddc_run("/bin/sh", Cons("-c", Cons(cag_ddc_seed_cmd(d + "/lume0_clang", st1, lsrc, d + "/clang"), Nil)), d + "/clang/seed.log", 3600000) in if s1.status != 0 then "DDC: the clang-built seed could not build stage1_lumec: " + s1.err else if cag_files_equal(d + "/stage1_lumec", d + "/clang/stage1_lumec") != 1 then "DDC: the cc-built and clang-built seeds produce DIFFERENT stage1 compilers from the same lumec.src" else ""
fn cag_ddc_run(bin, args, out, ms) = let st = os_run_capture_timeout(bin, args, out, out + ".err", ms) in {status: cag_wait_exit(st), err: fs_read_file(out + ".err")}
fn cag_ddc_input(bin, args, inp, out, ms) = let st = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", ms) in {status: cag_wait_exit(st), err: fs_read_file(out + ".err")}
fn cag_files_equal(a, b) = if fs_path_exists(a) != 1 or fs_path_exists(b) != 1 then 0 else fs_files_equal(a, b)
fn cag_ddc_seed_cmd(l0, st1, lsrc, d) = "ulimit -s unlimited 2>/dev/null || ulimit -s 65536 2>/dev/null || true; \"" + l0 + "\" run \"" + st1 + "/data_asm_cc.lume\" \"" + lsrc + "\" \"" + d + "/stage1_lumec.s\" >/dev/null && \"" + l0 + "\" asm \"" + d + "/stage1_lumec.s\" \"" + d + "/stage1_lumec\" >/dev/null && chmod +x \"" + d + "/stage1_lumec\""
fn cag_check_ddc_bootstrap(root, tmp) = let d = tmp + "/ddc" in let mk = os_run("/bin/mkdir", Cons("-p", Cons(d, Nil))) in let l0 = d + "/lume0_cc" in let st1 = root + "/compiler/stage1" in let lsrc = st1 + "/lumec.src" in let self_bin = root + "/build/bin/lumec" in let sb = cag_ddc_seed_build(root, d, "/usr/bin/cc", "cc") in if sb != "" then sb else if fs_path_exists(lsrc) != 1 then "DDC: compiler/stage1/lumec.src is missing (run the amalgamation first)" else let clean = os_run("/bin/rm", Cons("-f", Cons(d + "/stage1_lumec", Cons(d + "/stage1_lumec.s", Cons(d + "/stage2_from_seed", Cons(d + "/stage2_from_seed.s", Cons(d + "/stage3_from_seed.s", Nil))))))) in let s1 = cag_ddc_run("/bin/sh", Cons("-c", Cons(cag_ddc_seed_cmd(l0, st1, lsrc, d), Nil)), d + "/seed.log", 3600000) in if s1.status != 0 or fs_path_exists(d + "/stage1_lumec") != 1 then "DDC: the C seed could not build stage1_lumec from lumec.src: " + s1.err else let c2 = cag_ddc_input(d + "/stage1_lumec", Nil, lsrc, d + "/stage2_from_seed.s", 1800000) in if c2.status != 0 then "DDC: stage1_lumec failed compiling lumec.src: " + c2.err else let a2 = cag_ddc_run(root + "/build/bin/lasm", Cons("--strict", Cons(d + "/stage2_from_seed.s", Nil)), d + "/stage2_from_seed", 1800000) in if a2.status != 0 then "DDC: lasm --strict failed assembling stage2_from_seed: " + a2.err else let cx = os_run("/bin/chmod", Cons("+x", Cons(d + "/stage2_from_seed", Nil))) in let c3 = cag_ddc_input(d + "/stage2_from_seed", Nil, lsrc, d + "/stage3_from_seed.s", 1800000) in if c3.status != 0 then "DDC: stage2_from_seed failed compiling lumec.src: " + c3.err else if fs_read_file(d + "/stage2_from_seed.s") != fs_read_file(d + "/stage3_from_seed.s") then "DDC: no fixpoint - the seed-built and self-built compilers emit different assembly for lumec.src" else if cag_files_equal(d + "/stage2_from_seed", self_bin) != 1 then "DDC: stage2_from_seed is NOT bit-identical to build/bin/lumec (the seed chain reaches a fixpoint, so build/bin/lumec is stale relative to lumec.src or has drifted)" else cag_ddc_diverse(root, d, st1, lsrc)

fn cag_main(root) = let tmp = root + "/build/claude-audit-gate" in let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil))) in let engines = Cons("pingora", Cons("egm", Cons("ncm", Cons("opentpu", Cons("continuum", Cons("crypto-engine", Cons("morph", Cons("quantum-nexus", Nil)))))))) in let e1 = cag_check_seed_path(root, tmp) in if e1 != "" then ctfail("claude audit gate failed: " + e1 + "\n") else let e2 = cag_check_prover_soundness(root, tmp) in if e2 != "" then ctfail("claude audit gate failed: " + e2 + "\n") else let e3 = cag_check_perceus_and_effects(root, tmp) in if e3 != "" then ctfail("claude audit gate failed: " + e3 + "\n") else let e4 = cag_check_cli_and_engines(root, tmp) in if e4 != "" then ctfail("claude audit gate failed: " + e4 + "\n") else let e5 = cag_check_missing_engines(root, tmp, engines) in if e5 != "" then ctfail("claude audit gate failed: " + e5 + "\n") else let e6 = cag_check_lex_and_runtime(root, tmp) in if e6 != "" then ctfail("claude audit gate failed: " + e6 + "\n") else let e7 = cag_check_redteam_r2(root, tmp) in if e7 != "" then ctfail("claude audit gate failed: " + e7 + "\n") else let e8 = cag_check_win64_gui_interp_chameleon(root, tmp) in if e8 != "" then ctfail("claude audit gate failed: " + e8 + "\n") else let e9 = cag_fuzz_loop(root, tmp, 0, 12, 1337) in if e9 != "" then ctfail("claude audit gate failed: " + e9 + "\n") else let e10 = cag_fuzz_false_theorems(root, tmp) in if e10 != "" then ctfail("claude audit gate failed: " + e10 + "\n") else let e11 = cag_check_mutation_kills(root, tmp) in if e11 != "" then ctfail("claude audit gate failed: " + e11 + "\n") else let e13 = cag_check_redteam_r4(root, tmp) in if e13 != "" then ctfail("claude audit gate failed: " + e13 + "\n") else let fz = pf_fuzz(pf_cfg(root, tmp), 48, 20261110) in if fz.err != "" then ctfail("claude audit gate failed: " + fz.err + "\n") else let e14 = cag_check_compiler_mutants(root, tmp) in if e14 != "" then ctfail("claude audit gate failed: " + e14 + "\n") else let e12 = cag_check_ddc_bootstrap(root, tmp) in if e12 != "" then ctfail("claude audit gate failed: " + e12 + "\n") else "OK: 100% pure-Lume Claude Opus 5.5 + Red Team (Rounds 1-4) audit gate, 4-way differential fuzzer (12 random programs), false-theorem fuzzer (35 hand-written + 16 generated + 48 oracle-checked cases: " + str(fz.traps) + " false theorems stopped by their runtime check, " + str(fz.rejects) + " refuted at compile time, 0 proven by lumec, lcaas or the lcert kernel), mutation-kill harness (program mutants + 6 compiler mutants killed) and seed-vs-self DDC bit-identity passed"

fn cag_dispatch(input) = let root = cag_root(input) in if root == "" then ctfail("claude audit gate requires @root\n") else cag_main(root)

print cag_dispatch(readall())
