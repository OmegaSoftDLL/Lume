## claude_audit_gate.src -- 100% native Lume verification harness for the 21 Claude Opus 5.5
## audit issues (#1-#21), Red Team Round 1 soundness hardening, and pure-Lume 4-way differential fuzzing.

fn cag_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn cag_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else cag_contains_at(text, part, i + 1)
fn cag_contains(text, part) = cag_contains_at(text, part, 0)
fn cag_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else cag_line_end(s, i + 1)
fn cag_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, cag_line_end(input, 0))
fn cag_join(a, b) = if a != "" then a else b

fn cag_run(bin, args, out) = let st = os_run_capture_timeout(bin, args, out, out + ".err", 180000) in {status: cag_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn cag_input(bin, args, inp, out) = let st = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", 180000) in {status: cag_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn cag_sh(cmd, out) = cag_run("/bin/sh", Cons("-c", Cons(cmd, Nil)), out)

fn cag_compile_run(root, tmp, name, code) = let src = tmp + "/" + name + ".src" in let asm = tmp + "/" + name + ".s" in let elf = tmp + "/" + name + ".elf" in let w = fs_write_sync(src, code) in let c = cag_input(root + "/build/bin/lumec", Nil, src, asm) in if c.status != 0 then {ok: 0, status: c.status, out: "", err: c.err} else let a = cag_run(root + "/build/bin/lasm", Cons("--strict", Cons(asm, Nil)), elf) in if a.status != 0 then {ok: 0, status: a.status, out: "", err: a.err} else let m = os_run("/bin/chmod", Cons("+x", Cons(elf, Nil))) in let r = cag_run(elf, Nil, elf + ".run") in {ok: 1, status: r.status, out: r.out, err: r.err}

fn cag_check_seed_path(root, tmp) = let probe = tmp + "/seed_probe.src" in let w = fs_write_sync(probe, "fn ok_fn(x: int) -> int requires x >= 0 ensures result >= 0 = x\nprint ok_fn(7)\n") in let r1 = cag_sh("LUME_FORCE_SEED=1 \"" + root + "/lume\" prove \"" + probe + "\"", tmp + "/seed_lcaas.out") in if r1.status != 0 or cag_contains(r1.out, "\"ok\":true") == 0 then "Stage-0 seed failed on lcaas.src: " + r1.err else let bad = tmp + "/seed_bad.src" in let wb = fs_write_sync(bad, "fn broken(\n") in let r2 = cag_sh("LUME_FORCE_SEED=1 \"" + root + "/lume\" check \"" + probe + "\" && ! LUME_FORCE_SEED=1 \"" + root + "/lume\" check \"" + bad + "\"", tmp + "/force_seed.out") in if r2.status != 0 then "LUME_FORCE_SEED=1 check gate failed: " + r2.out + r2.err else ""

fn cag_check_prover_soundness(root, tmp) = let b1 = tmp + "/b01_mod.src" in let b2 = tmp + "/b02_wrap.src" in let b3 = tmp + "/rt1_ovf.src" in let b4 = tmp + "/rt1_nia.src" in let w1 = fs_write_sync(b1, "fn bad_mod(x: int) -> int requires x < 0 ensures result >= 0 = x % 4\nprint bad_mod(-3)\n") in let w2 = fs_write_sync(b2, "fn bad_wrap(x: int) -> int requires x > 0 ensures result > x = x +% 1\nprint bad_wrap(1)\n") in let w3 = fs_write_sync(b3, "fn bad_mul(x: int) -> int requires 4611686018427387904 * x == 0 ensures result == 99 = x\nprint bad_mul(2)\n") in let w4 = fs_write_sync(b4, "fn bad_nia(x: int) -> int requires x >= 3037000500 ensures result * result >= 100 = x\nprint bad_nia(3037000500)\n") in let p1 = cag_run(root + "/build/bin/lume_driver", Cons("prove", Cons(b1, Nil)), tmp + "/b01.out") in let p2 = cag_run(root + "/build/bin/lume_driver", Cons("prove", Cons(b2, Nil)), tmp + "/b02.out") in let p3 = cag_input(root + "/build/bin/lcaas", Nil, b3, tmp + "/b03.out") in let p4 = cag_input(root + "/build/bin/lcaas", Nil, b4, tmp + "/b04.out") in if p1.status == 0 or p2.status == 0 then "prover accepted false negative-mod or wrapping-add contract" else if cag_contains(p3.out, "\"status\":\"proven\"") == 1 or cag_contains(p4.out, "\"status\":\"proven\"") == 1 then "prover falsely proved overflowing linear or NIA contract" else ""

fn cag_check_perceus_and_effects(root, tmp) = let r_perc = cag_compile_run(root, tmp, "b05_perceus", "fn hd(xs: [int]) -> int = match xs\n    Nil => 0\n    Cons(h, t) => h\nfn step(xs: [int]) -> [int] = match xs\n    Nil => Nil\n    Cons(h, t) => Cons(h + 1, t)\nfn check_alias(xs: [int]) -> int =\n    let ys = xs in\n    let zs = step(xs) in\n    hd(ys) * 100 + hd(zs)\nprint check_alias(Cons(10, Cons(20, Nil)))\n") in if r_perc.ok == 0 or r_perc.status != 0 or r_perc.out != "1011\n" then "Perceus alias reuse corrupted shared Cons cell: " + r_perc.out + r_perc.err else let p_src = tmp + "/b09_pure.src" in let wp = fs_write_sync(p_src, "fn bad() -> int / pure = fs_path_exists(\"a\")\nprint bad()\n") in let cp = cag_input(root + "/build/bin/lumec", Nil, p_src, tmp + "/b09_pure.s") in if cp.status == 0 or cag_contains(cp.err, "E0200") == 0 then "/ pure failed to reject I/O builtin [E0200]" else let s1 = tmp + "/b09_sec1.src" in let s2 = tmp + "/b09_sec2.src" in let s3 = tmp + "/rt1_sec_let.src" in let ws1 = fs_write_sync(s1, "fn leak(@secret k: int) -> int = if k == 0 then 1 else 2\nprint leak(5)\n") in let ws2 = fs_write_sync(s2, "fn leak2(@secret k: int) -> string = __lume_mem_pack(k)\nprint leak2(5)\n") in let ws3 = fs_write_sync(s3, "fn leak3(secret_k: int) -> int =\n    let y = secret_k + 1 in\n    if y > 10 then 1 else 0\nprint leak3(5)\n") in let cs1 = cag_input(root + "/build/bin/lumec", Nil, s1, tmp + "/s1.s") in let cs2 = cag_input(root + "/build/bin/lumec", Nil, s2, tmp + "/s2.s") in let cs3 = cag_input(root + "/build/bin/lumec", Nil, s3, tmp + "/s3.s") in if cs1.status == 0 or cs2.status == 0 or cs3.status == 0 or cag_contains(cs3.err, "C0009") == 0 then "@secret failed to reject secret branching, mem_pack, or let-taint [C0009]" else ""

fn cag_check_cli_and_engines(root, tmp) = let qn = tmp + "/qn_input.src" in let orig = "fn hello() -> int = 42\nprint hello()\n" in let wq = fs_write_sync(qn, orig) in let rq = cag_run(root + "/build/bin/lume_driver", Cons("quantum-nexus", Cons(qn, Nil)), tmp + "/qn.out") in if rq.status != 0 or fs_read_file(qn) != orig then "quantum-nexus failed or overwrote input source file" else let py = tmp + "/morph_in.py" in let wm = fs_write_sync(py, "def calc_area(w, h):\n    return w * h\n") in let rm = cag_run(root + "/build/bin/lume_driver", Cons("morph", Cons(py, Nil)), tmp + "/morph.out") in let rmb = cag_run(root + "/build/bin/lume_driver", Cons("morph", Cons(tmp + "/no_such.py", Nil)), tmp + "/morph_bad.out") in if rm.status != 0 or cag_contains(rm.out, "calc_area") == 0 or rmb.status == 0 then "morph failed to translate input or accepted missing file" else let sp = cag_run(root + "/build/bin/lume_driver", Cons("self-prove", Cons("--json", Nil)), tmp + "/self_prove.out") in if sp.status != 0 or cag_contains(sp.out, "\"ok\":true") == 0 or cag_contains(sp.out, "\"live_probes_verified\":true") == 0 or cag_contains(sp.out, "\"checked\":false") == 1 then "self-prove --json did not verify all obligations" else let iso_src = tmp + "/iso_k.src" in let iso_out = tmp + "/boot.iso" in let wi = fs_write_sync(iso_src, "fn main() -> int = 0\nprint main()\n") in let ri = cag_run(root + "/build/bin/lume_driver", Cons("package", Cons("iso", Cons(iso_src, Cons("-o", Cons(iso_out, Nil))))), tmp + "/iso.out") in if ri.status != 0 or fs_path_exists(iso_out) != 1 or fs_read_file(iso_out) == "fn main() -> int = 0\nprint main()\n" or fs_read_byte(iso_out, 0) != 235 and fs_read_byte(iso_out, 510) != 85 and fs_read_byte(iso_out, 32769) != 67 then "package iso did not emit a valid binary boot image" else let gdir = tmp + "/gen_proj" in let rg = cag_run(root + "/build/bin/lume_driver", Cons("genesis", Cons(gdir, Cons("utility", Nil))), tmp + "/gen.out") in if rg.status != 0 or fs_path_exists(gdir + ".src") != 1 or count(fs_read_file(gdir + ".src")) < 80 then "genesis failed to scaffold project files on disk" else ""

fn cag_check_missing_engines(root, tmp, cmds) = match cmds
    Nil        => ""
    Cons(h, t) => let r = cag_run(root + "/build/bin/lume_driver", Cons(h, Cons(tmp + "/definitely_missing_input.src", Nil)), tmp + "/miss_" + h + ".out") in if r.status == 0 then "domain engine " + h + " accepted a nonexistent input file" else cag_check_missing_engines(root, tmp, t)

fn cag_check_lex_and_runtime(root, tmp) = let lb = chr(123) in let rb = chr(125) in let lex_code = "fn calc() -> int =\n    let a = 1.50 in\n    let b = 2.5 in\n    let c = 1.0 in\n    let s = a + b + c in\n    s.coefficient * 10 + s.scale\nfn lex_vals() -> int =\n    let h = 0xFF in\n    let b = 0b101 in\n    let o = 0o17 in\n    let u = 1_000_000 in\n    h + b + o + u\nfn map_val() -> int =\n    let m = " + lb + "\"k\": 42" + rb + " in\n    m[\"k\"]\nfn fmt_val(x: int) -> str = \"" + lb + "x:04x" + rb + "\"\nprint lex_vals()\nprint \"\"\"hello\"\"\"\nprint map_val()\nprint fmt_val(255)\nprint calc()\n" in let rl = cag_compile_run(root, tmp, "lex_fmt", lex_code) in if rl.ok == 0 or rl.status != 0 or rl.out != "1000275\nhello\n42\n00ff\n5002\n" then "lexical/format/decimal check failed: " + rl.out + rl.err else let rnul = cag_compile_run(root, tmp, "nul_path", "print fs_path_exists(\"a\" + chr(0) + \"b\")\n") in if rnul.ok == 0 or rnul.status == 0 then "interior NUL byte path was not rejected at runtime" else let rfull = cag_compile_run(root, tmp, "hello_full", "print \"hello world\"\n") in if rfull.ok == 0 then "failed to compile hello_full" else let df = if fs_path_exists("/dev/full") == 1 then cag_sh("\"" + tmp + "/hello_full.elf\" > /dev/full 2>/dev/null", tmp + "/df.out") else {status: 1, out: "", err: ""} in if fs_path_exists("/dev/full") == 1 and df.status == 0 then "runtime ignored stdout write failure on /dev/full" else ""

fn cag_prng(seed) = (seed * 1103515245 + 12345) % 2147483648
fn cag_fuzz_expr(seed, depth) = let s1 = cag_prng(seed) in if depth <= 0 then {s: s1, code: str(s1 % 97 + 1)} else let kind = s1 % 4 in let l = cag_fuzz_expr(s1, depth - 1) in let r = cag_fuzz_expr(l.s, depth - 1) in if kind == 0 then {s: r.s, code: "(" + l.code + " + " + r.code + ")"} else if kind == 1 then {s: r.s, code: "(" + l.code + " - " + r.code + ")"} else if kind == 2 then {s: r.s, code: "(if " + l.code + " >= " + r.code + " then " + l.code + " else " + r.code + ")"} else {s: r.s, code: "(let v" + str(depth) + " = " + l.code + " in v" + str(depth) + " + " + r.code + ")"}

fn cag_fuzz_one(root, tmp, idx, seed) = let g = cag_fuzz_expr(seed, 3) in let prog = "fn f(x: int) -> int = " + g.code + " + x\nprint f(" + str(idx + 1) + ")\n" in let r_nat = cag_compile_run(root, tmp, "fuzz_" + str(idx), prog) in if r_nat.ok == 0 or r_nat.status != 0 then "fuzzer native run failed on case " + str(idx) + ": " + r_nat.err else let src = tmp + "/fuzz_" + str(idx) + ".src" in let elf = tmp + "/fuzz_" + str(idx) + ".elf" in let r_gc = cag_sh("LUME_GC_STRESS=1 \"" + elf + "\"", tmp + "/fuzz_gc_" + str(idx) + ".out") in let r_seed = cag_run(root + "/bootstrap/lume0/lume0", Cons("run", Cons(root + "/compiler/stage1/compiler_in_core.lume", Cons(src, Nil))), tmp + "/fuzz_seed_" + str(idx) + ".out") in let r_caas = cag_input(root + "/build/bin/lcaas", Nil, src, tmp + "/fuzz_caas_" + str(idx) + ".out") in if r_gc.status != 0 or r_gc.out != r_nat.out then "fuzzer GC stress mismatch on case " + str(idx) else if r_seed.status != 0 or r_seed.out != r_nat.out then "fuzzer Stage-0 seed mismatch on case " + str(idx) else if r_caas.status != 0 or cag_contains(r_caas.out, "\"ok\":true") == 0 then "fuzzer lcaas failed on case " + str(idx) else ""

fn cag_fuzz_loop(root, tmp, idx, n, seed) = if idx >= n then "" else let err = cag_fuzz_one(root, tmp, idx, seed) in if err != "" then err else cag_fuzz_loop(root, tmp, idx + 1, n, cag_prng(seed))

fn cag_check_redteam_r2(root, tmp) = let lb = chr(123) in let rb = chr(125) in let r2_inv = tmp + "/rt2_inv.src" in let w1 = fs_write_sync(r2_inv, "type Pos = " + lb + " v: int " + rb + " invariant v > 0\nfn mk_bad(x: int) -> Pos = Pos " + lb + " v: x " + rb + "\nprint (mk_bad(0 - 5)).v\n") in let p1 = cag_input(root + "/build/bin/lcaas", Nil, r2_inv, tmp + "/rt2_inv.out") in if cag_contains(p1.out, "\"ok\":true") == 1 then "RT2-A02/A06 failed: lcaas accepted unguarded record construction violating type invariant" else let r2_eff = tmp + "/rt2_eff.src" in let w2 = fs_write_sync(r2_eff, "fn spoof() -> int / pure = with handler fs " + lb + " fn op() = 0 " + rb + " in fs_path_exists(\"a\")\nprint spoof()\n") in let p2 = cag_input(root + "/build/bin/lumec", Nil, r2_eff, tmp + "/rt2_eff.s") in if p2.status == 0 or cag_contains(p2.err, "E0200") == 0 then "RT2-B05 failed: with-handler spoofed primitive io/fs effect inside / pure" else let r2_dup = tmp + "/rt2_dup.src" in let w3 = fs_write_sync(r2_dup, "fn dup_param(x: int, x: int) -> int = x\nprint dup_param(1, 2)\n") in let p3 = cag_input(root + "/build/bin/lumec", Nil, r2_dup, tmp + "/rt2_dup.s") in if p3.status == 0 then "RT2-B06 failed: duplicate parameter name was not rejected" else let r2_exh = tmp + "/rt2_exh.src" in let w4 = fs_write_sync(r2_exh, "fn bad_match(x: int) -> int = match x\n    1 => 10\n    2 => 20\nprint bad_match(3)\n") in let p4 = cag_input(root + "/build/bin/lumec", Nil, r2_exh, tmp + "/rt2_exh.s") in if p4.status == 0 or cag_contains(p4.err, "T1002") == 0 then "RT2-B07 failed: non-exhaustive integer literal match was not rejected with [T1002]" else let r2_lasm = tmp + "/rt2_bad.s" in let w5 = fs_write_sync(r2_lasm, ".globl _start\n_start:\n    bogus_mnemonic %rax, %rbx\n") in let p5 = cag_run(root + "/build/bin/lasm", Cons("--strict", Cons(r2_lasm, Nil)), tmp + "/rt2_bad.elf") in if p5.status == 0 then "RT2-B09 failed: lasm accepted unknown instruction mnemonic" else ""

fn cag_check_round3_ui_vec_wave10(root, tmp) = let dec_s = fs_read_file(root + "/compiler/stage1/decimal.src") in let sen_s = fs_read_file(root + "/compiler/stage1/lsentience.src") in let man_s = fs_read_file(root + "/compiler/stage1/lmanual.src") in let int_s = fs_read_file(root + "/compiler/stage1/linteractive.src") in if cag_contains(dec_s, "decimal_clamp") == 0 then "decimal.src missing decimal_clamp" else if cag_contains(sen_s, "sentience_daemon_triad_json") == 0 or cag_contains(sen_s, "sentience_hot_evolve_json") == 0 or cag_contains(sen_s, "sentience_live_cockpit_json") == 0 then "lsentience.src missing Wave 10 daemon-triad/hot-evolve/live-cockpit markers" else if cag_contains(man_s, "@ui-layout") == 0 or cag_contains(man_s, "ui_split_conservation_law") == 0 or cag_contains(man_s, "vec_clamp_index") == 0 or cag_contains(man_s, "vec_checked_slice_len") == 0 or cag_contains(man_s, "map_checked_slot") == 0 or cag_contains(int_s, "@ui-layout") == 0 then "lmanual.src or linteractive.src missing @ui-layout/vec/Wave 10 markers" else if fs_path_exists(root + "/compiler/stage1/vec.src") == 1 then let vec_s = fs_read_file(root + "/compiler/stage1/vec.src") in let r_vp = cag_run(root + "/build/bin/lume_driver", Cons("prove", Cons(root + "/compiler/stage1/vec.src", Nil)), tmp + "/vec_prove.out") in if cag_contains(vec_s, "vec_clamp_index") == 0 or cag_contains(vec_s, "vec_checked_slice_len") == 0 or cag_contains(vec_s, "map_checked_slot") == 0 or r_vp.status != 0 or cag_contains(r_vp.out, "\"ok\":true") == 0 then "vec.src collection contracts check failed: " + r_vp.out + r_vp.err else "" else ""

fn cag_check_win64_gui_interp_chameleon(root, tmp) = let r_reg = cag_run(root + "/build/bin/lume_driver", Cons("test", Cons(root + "/compiler/stage1/win64_gui_and_interp_regression_ok.src", Nil)), tmp + "/w64_reg.out") in if r_reg.status != 0 or cag_contains(r_reg.out, "8 passed, 0 failed") == 0 then "win64_gui_and_interp_regression_ok.src failed: " + r_reg.out + r_reg.err else let r_cham_t = cag_run(root + "/build/bin/lume_driver", Cons("test", Cons(root + "/compiler/stage1/lchameleon.src", Nil)), tmp + "/cham_test.out") in if r_cham_t.status != 0 or cag_contains(r_cham_t.out, "8 passed, 0 failed") == 0 then "lchameleon.src unit tests failed: " + r_cham_t.out + r_cham_t.err else let r_cham_p = cag_run(root + "/build/bin/lume_driver", Cons("prove", Cons(root + "/compiler/stage1/lchameleon.src", Nil)), tmp + "/cham_prove.out") in if r_cham_p.status != 0 or cag_contains(r_cham_p.out, "\"ok\":true") == 0 or cag_contains(r_cham_p.out, "\"status\":\"proven\"") == 0 then "lchameleon.src QF_LIA proof failed: " + r_cham_p.out + r_cham_p.err else let r_cham_c = cag_run(root + "/build/bin/lume_driver", Cons("certify", Cons(root + "/compiler/stage1/lchameleon.src", Nil)), tmp + "/cham_cert.out") in if r_cham_c.status != 0 or cag_contains(r_cham_c.out, "Lume Verified") == 0 then "lchameleon.src certification failed: " + r_cham_c.out + r_cham_c.err else let r_cham_cli = cag_run(root + "/build/bin/lume_driver", Cons("chameleon", Nil), tmp + "/cham_cli.out") in if r_cham_cli.status != 0 or cag_contains(r_cham_cli.out, "\"ecosystems_supported\":9") == 0 or cag_contains(r_cham_cli.out, "\"ecosystems_verified\":9") == 0 then "lume chameleon CLI failed: " + r_cham_cli.out + r_cham_cli.err else cag_check_round3_ui_vec_wave10(root, tmp)

fn cag_main(root) = let tmp = root + "/build/claude-audit-gate" in let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil))) in let engines = Cons("pingora", Cons("egm", Cons("ncm", Cons("opentpu", Cons("continuum", Cons("crypto-engine", Cons("morph", Cons("quantum-nexus", Nil)))))))) in let e1 = cag_check_seed_path(root, tmp) in if e1 != "" then ctfail("claude audit gate failed: " + e1 + "\n") else let e2 = cag_check_prover_soundness(root, tmp) in if e2 != "" then ctfail("claude audit gate failed: " + e2 + "\n") else let e3 = cag_check_perceus_and_effects(root, tmp) in if e3 != "" then ctfail("claude audit gate failed: " + e3 + "\n") else let e4 = cag_check_cli_and_engines(root, tmp) in if e4 != "" then ctfail("claude audit gate failed: " + e4 + "\n") else let e5 = cag_check_missing_engines(root, tmp, engines) in if e5 != "" then ctfail("claude audit gate failed: " + e5 + "\n") else let e6 = cag_check_lex_and_runtime(root, tmp) in if e6 != "" then ctfail("claude audit gate failed: " + e6 + "\n") else let e7 = cag_check_redteam_r2(root, tmp) in if e7 != "" then ctfail("claude audit gate failed: " + e7 + "\n") else let e8 = cag_check_win64_gui_interp_chameleon(root, tmp) in if e8 != "" then ctfail("claude audit gate failed: " + e8 + "\n") else let e9 = cag_fuzz_loop(root, tmp, 0, 12, 1337) in if e9 != "" then ctfail("claude audit gate failed: " + e9 + "\n") else "OK: 100% pure-Lume Claude Opus 5.5 + Red Team (Rounds 1, 2 & 3) audit gate and 4-way differential fuzzer (12 random programs) passed"

fn cag_dispatch(input) = let root = cag_root(input) in if root == "" then ctfail("claude audit gate requires @root\n") else cag_main(root)

print cag_dispatch(readall())
