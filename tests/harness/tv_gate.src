## tv_gate.src -- codegen mutation gate for the Lume Translation Validator (compiler/stage1/ltv.src).
##
## A validator that accepts everything would pass any positive test, so this gate measures it against ground truth:
##   1. the fixture below and compiler/stage1/lstd.src are compiled by the real lumec; ltv must VALIDATE every
##      fixture function, and its native boundary run (@exec 1) must agree with the real machine code;
##   2. every instruction line of every fixture function is mutated by every operator that applies to it (swap
##      addq/subq, shift a frame slot, swap setcc / jcc conditions, swap %rdi and %rsi, change an immediate, unbalance
##      %rsp, swap or drop a runtime call, delete the instruction, ...). Each mutant is a real program: it is
##      assembled by lasm and run natively on the fixture's input vectors, one process per vector, trapping vectors
##      included. A mutant whose observable behaviour (exit status, stdout) differs from the original on any vector
##      is PROVEN non-equivalent, and ltv must reject it. One such mutant accepted is an unsound validator: the gate
##      fails and prints it.
##   3. every mutation class the qualification plan names must contain behaviour-changing mutants (so that a class
##      cannot pass by being empty), and the total must be large enough to mean something.
## The observable behaviour of a run is its exit status, stdout and stderr (so a trap with another message differs).
## Mutants that behave like the original on all vectors are reported in two honest buckets and claimed as nothing:
## "rejected anyway" (the validator is conservative, or the vectors missed the difference) and "accepted". An accepted
## mutant is then run on 48 more pseudo-random vectors per function that include boxed 64-bit values; a difference
## there is the same unsoundness failure. What is left is listed in build/certification/tv_gate_equivalent_mutants.txt
## (dead stores, re-loads of a register that still holds the value, a jump into a slow path that recomputes the same
## result, code made unreachable by constant operands).
##   4. Wave 14, the hub: every ltv run of this gate also verifies the integer runtime helpers of the SAME assembly
##      (ltv_rt) and re-checks every certificate it writes with the native checker (lsmt); the gate requires the
##      report of the fixture to say so (18 helpers verified, as many native checks as validated functions), and
##      measures the object-code branch correlation with its own fixture and campaign (section "branch correlation").
##
## stdin: @root <repo>   [@stride <n>: test every n-th mutant, default 1]   [@tmp <dir>, default /tmp/lume-tv-gate.<pid>]

fn tg_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else tg_line_end(s, i + 1)
fn tg_get_at(s, key, i) = if i >= count(s) then "" else let e = tg_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else tg_get_at(s, key, e + 1)
fn tg_get(s, key) = tg_get_at(s, key, 0)
fn tg_or(v, d) = if v == "" then d else v
fn tg_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn tg_index(text, part, i) = if i + count(part) > count(text) then 0 - 1 else if slice(text, i, i + count(part)) == part then i else tg_index(text, part, i + 1)
fn tg_has(text, part) = if tg_index(text, part, 0) >= 0 then 1 else 0
fn tg_starts(s, pre) = if count(s) >= count(pre) and slice(s, 0, count(pre)) == pre then 1 else 0
fn tg_rep1(s, pat, rep) = let i = tg_index(s, pat, 0) in if i < 0 then s else slice(s, 0, i) + rep + slice(s, i + count(pat), count(s))
fn tg_repall(s, pat, rep, i) = let j = tg_index(s, pat, i) in if j < 0 then s else tg_repall(slice(s, 0, j) + rep + slice(s, j + count(pat), count(s)), pat, rep, j + count(rep))
fn tg_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + tg_len(t)
fn tg_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, tg_app(t, ys))
fn tg_revacc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => tg_revacc(t, Cons(h, acc))
fn tg_join(xs) = match xs
    Nil        => ""
    Cons(h, t) => h + tg_join(t)
fn tg_run(bin, args, out, ms) = let st = os_run_capture_timeout(bin, args, out, out + ".err", ms) in {status: tg_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn tg_input(bin, args, inp, out, ms) = let st = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", ms) in {status: tg_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}

## --- the fixture: every construct the validator models, written so that each mutation class changes behaviour ---
fn tg_fixture() = "fn tva(x: int, y: int) -> int requires x >= 0 and x <= 100 and y >= 1 and y <= 50 = if x <= y then x + y * 2 else (x - y) / y\n" + "fn tvb(a: int) -> int = let t = a * 3 in if t == 6 and a != 0 or a < 0 then 0 - t else t % 7\n" + "fn tvc(x: int, y: int) -> bool = x <= y\n" + "fn tvd(x: int, y: int) -> int = x - y * 3\n" + "fn tve(a: int, b: int) -> int = tvd(a, b) + tvd(b, a + 1) * 2\n" + "fn tvf(x: int, y: int, z: int) -> int = (x + y) * (y - z) + (x - z) * (y + 1)\n" + "fn tvg(x: int, y: int) -> bool = x < y and y < 10 or x == 7\n" + "fn tvh(p: int, q: int, r: int) -> int requires r != 0 = let u = p - q in let w = u * r + 1 in if w > p then (if tvc(u, w) then w / r else u % r) else if q >= 1000000000000 then 9 else w - 5\n" + "fn tvi(flag: bool, n: int) -> int = if flag then (if n != 0 then n + 1000 else 0 - 1) else 7 - n\n"
## a vector is {f, a: argv text}: the arguments reach the program through argv, so the compiler cannot fold or refute a
## call and every `requires` check stays in the emitted code
fn tg_arg(n) = if n < 0 then "-" + str(0 - n) else str(n)
fn tg_v(f, x, y, z) = {f: f, x: tg_arg(x), y: tg_arg(y), z: tg_arg(z)}
fn tg_grid2y(f, x, ys) = match ys
    Nil        => Nil
    Cons(y, t) => Cons(tg_v(f, x, y, 0), tg_grid2y(f, x, t))
fn tg_grid2(f, xs, ys) = match xs
    Nil        => Nil
    Cons(x, t) => tg_app(tg_grid2y(f, x, ys), tg_grid2(f, t, ys))
fn tg_list1(f, xs) = match xs
    Nil        => Nil
    Cons(x, t) => Cons(tg_v(f, x, 0, 0), tg_list1(f, t))
fn tg_l3(a, b, c) = Cons(a, Cons(b, Cons(c, Nil)))
fn tg_l4(a, b, c, d) = Cons(a, tg_l3(b, c, d))
fn tg_l5(a, b, c, d, e) = Cons(a, tg_l4(b, c, d, e))
fn tg_vecs_a() = tg_grid2("tva", tg_app(tg_l4(0, 1, 50, 51), tg_l3(100, 101, 0 - 1)), tg_l5(1, 2, 50, 51, 0))
fn tg_vecs_b() = tg_list1("tvb", tg_app(tg_l5(0 - 2, 0 - 1, 0, 1, 2), tg_l4(3, 7, 4611686018427387903, 2305843009213693952)))
fn tg_vecs_c() = tg_grid2("tvc", tg_l4(0 - 1, 0, 1, 5), tg_l3(0, 1, 5))
fn tg_vecs_d() = tg_grid2("tvd", tg_l4(0, 4, 0 - 7, 4611686018427387903), tg_l3(1, 9, 0 - 2))
fn tg_vecs_e() = tg_grid2("tve", tg_l3(0, 3, 0 - 5), tg_l3(1, 8, 0 - 4))
fn tg_vecs_f() = tg_app(tg_l3(tg_v("tvf", 1, 2, 3), tg_v("tvf", 0, 0, 0), tg_v("tvf", 5, 0 - 3, 2)), tg_l3(tg_v("tvf", 0 - 4, 7, 7), tg_v("tvf", 9, 1, 0 - 6), tg_v("tvf", 4611686018427387903, 1, 0)))
fn tg_vecs_g() = tg_grid2("tvg", tg_l5(0, 7, 9, 10, 0 - 3), tg_l4(1, 9, 10, 11))
fn tg_vecs_h() = tg_app(tg_l5(tg_v("tvh", 1, 2, 3), tg_v("tvh", 10, 2, 3), tg_v("tvh", 5, 5, 1), tg_v("tvh", 7, 2, 0), tg_v("tvh", 0 - 3, 4, 0 - 2)), tg_l4(tg_v("tvh", 2, 1000000000000, 1), tg_v("tvh", 9, 1, 2), tg_v("tvh", 0, 3, 0 - 1), tg_v("tvh", 100, 1, 5)))
fn tg_vecs_i() = tg_l5(tg_v("tvi", 1, 0, 0), tg_v("tvi", 1, 5, 0), tg_v("tvi", 1, 0 - 2, 0), tg_v("tvi", 0, 0, 0), tg_v("tvi", 0, 9, 0))
fn tg_vecs() = tg_app(tg_vecs_a(), tg_app(tg_vecs_b(), tg_app(tg_vecs_c(), tg_app(tg_vecs_d(), tg_app(tg_vecs_e(), tg_app(tg_vecs_f(), tg_app(tg_vecs_g(), tg_app(tg_vecs_h(), tg_vecs_i()))))))))
fn tg_source() = tg_fixture() + "fn argi(k: int) -> int = let s = os_arg_at(k) in if count(s) > 0 and at(s, 0) == \"-\" then 0 - toint(slice(s, 1, count(s))) else toint(s)
fn pick(f: str, a: int, b: int, c: int) -> int = if f == \"tva\" then tva(a, b) else if f == \"tvb\" then tvb(a) else if f == \"tvc\" then (if tvc(a, b) then 1 else 0) else if f == \"tvd\" then tvd(a, b) else if f == \"tve\" then tve(a, b) else if f == \"tvf\" then tvf(a, b, c) else if f == \"tvg\" then (if tvg(a, b) then 1 else 0) else if f == \"tvh\" then tvh(a, b, c) else tvi(a == 1, b)
print pick(os_arg_at(1), argi(2), argi(3), argi(4))
"
fn tg_fnames() = Cons("tva", Cons("tvb", Cons("tvc", Cons("tvd", Cons("tve", Cons("tvf", Cons("tvg", Cons("tvh", Cons("tvi", Nil)))))))))

## --- assembly text: split around one function ---
fn tg_nl(s, n, i) = if i >= n then n else if at(s, i) == "\n" then i else tg_nl(s, n, i + 1)
fn tg_fn_start(s, n, i, hdr) = if i >= n then 0 - 1 else let e = tg_nl(s, n, i) in if slicen(s, n, i, e) == hdr then i else tg_fn_start(s, n, e + 1, hdr)
fn tg_fn_end(s, n, i) = if i >= n then n else let e = tg_nl(s, n, i) in if slicen(s, n, i, e) == "    ret" then e + 1 else tg_fn_end(s, n, e + 1)
fn tg_lines(s, n, i) = if i >= n then Nil else let e = tg_nl(s, n, i) in Cons(slicen(s, n, i, e), tg_lines(s, n, e + 1))
fn tg_unlines(ls) = match ls
    Nil        => Nil
    Cons(h, t) => Cons(h + "\n", tg_unlines(t))

## --- mutation operators: each returns replacements {cls, ls} for one instruction line ---
fn tg_m(cls, l) = {cls: cls, ls: Cons(l, Nil)}
fn tg_del(cls) = {cls: cls, ls: Nil}
fn tg_swap_reg(l) = tg_repall(tg_repall(tg_repall(l, "%rdi", "%r__", 0), "%rsi", "%rdi", 0), "%r__", "%rsi", 0)
fn tg_digits_end(s, i) = if i < count(s) and at(s, i) >= "0" and at(s, i) <= "9" then tg_digits_end(s, i + 1) else i
fn tg_num(s, i, n, acc) = if i >= n then acc else tg_num(s, i + 1, n, acc * 10 + (ord(at(s, i)) - 48))
## `-N(%rbp)` -> `-(N+d)(%rbp)`
fn tg_slot(l, d) = let j = tg_index(l, "(%rbp)", 0) in if j < 2 then "" else let b = tg_slot_start(l, j - 1) in if b < 1 or at(l, b - 1) != "-" then "" else let nv = tg_num(l, b, j, 0) + d in if nv < 8 then "" else slice(l, 0, b) + str(nv) + slice(l, j, count(l))
fn tg_slot_start(l, i) = if i >= 0 and at(l, i) >= "0" and at(l, i) <= "9" then tg_slot_start(l, i - 1) else i + 1
## `$K` -> `$(K+d)` for a non-negative immediate
fn tg_imm(l, d) = let j = tg_index(l, "$", 0) in if j < 0 then "" else let e = tg_digits_end(l, j + 1) in if e == j + 1 then "" else slice(l, 0, j + 1) + str(tg_num(l, j + 1, e, 0) + d) + slice(l, e, count(l))
fn tg_opt(cls, l, acc) = if l == "" then acc else Cons(tg_m(cls, l), acc)
fn tg_if(c, cls, l, acc) = if c == 1 then Cons(tg_m(cls, l), acc) else acc
fn tg_jcc(l, acc) = if tg_starts(l, "    jle ") == 1 then Cons(tg_m("jcc-swap", tg_rep1(l, "jle ", "jl ")), Cons(tg_m("jcc-swap", tg_rep1(l, "jle ", "jg ")), acc)) else if tg_starts(l, "    jl ") == 1 then Cons(tg_m("jcc-swap", tg_rep1(l, "jl ", "jle ")), Cons(tg_m("jcc-swap", tg_rep1(l, "jl ", "jge ")), acc)) else if tg_starts(l, "    jge ") == 1 then Cons(tg_m("jcc-swap", tg_rep1(l, "jge ", "jg ")), Cons(tg_m("jcc-swap", tg_rep1(l, "jge ", "jl ")), acc)) else if tg_starts(l, "    jg ") == 1 then Cons(tg_m("jcc-swap", tg_rep1(l, "jg ", "jge ")), Cons(tg_m("jcc-swap", tg_rep1(l, "jg ", "jle ")), acc)) else if tg_starts(l, "    jne ") == 1 then Cons(tg_m("jcc-swap", tg_rep1(l, "jne ", "je ")), acc) else if tg_starts(l, "    je ") == 1 then Cons(tg_m("jcc-swap", tg_rep1(l, "je ", "jne ")), acc) else if tg_starts(l, "    jnz ") == 1 then Cons(tg_m("jcc-swap", tg_rep1(l, "jnz ", "jz ")), acc) else if tg_starts(l, "    jz ") == 1 then Cons(tg_m("jcc-swap", tg_rep1(l, "jz ", "jnz ")), acc) else if tg_starts(l, "    jno ") == 1 then Cons(tg_m("jcc-swap", tg_rep1(l, "jno ", "jo ")), acc) else if tg_starts(l, "    jo ") == 1 then Cons(tg_m("jcc-swap", tg_rep1(l, "jo ", "jno ")), acc) else acc
fn tg_setcc(l, acc) = if tg_starts(l, "    setle ") == 1 then Cons(tg_m("setcc-swap", tg_rep1(l, "setle ", "setl ")), acc) else if tg_starts(l, "    setl ") == 1 then Cons(tg_m("setcc-swap", tg_rep1(l, "setl ", "setle ")), acc) else if tg_starts(l, "    setge ") == 1 then Cons(tg_m("setcc-swap", tg_rep1(l, "setge ", "setg ")), acc) else if tg_starts(l, "    setg ") == 1 then Cons(tg_m("setcc-swap", tg_rep1(l, "setg ", "setge ")), acc) else if tg_starts(l, "    setne ") == 1 then Cons(tg_m("setcc-swap", tg_rep1(l, "setne ", "sete ")), acc) else if tg_starts(l, "    sete ") == 1 then Cons(tg_m("setcc-swap", tg_rep1(l, "sete ", "setne ")), acc) else acc
fn tg_arith(l, acc) = if tg_has(l, "%rsp") == 1 then acc else if tg_starts(l, "    addq ") == 1 then Cons(tg_m("arith-swap", tg_rep1(l, "addq ", "subq ")), acc) else if tg_starts(l, "    subq ") == 1 then Cons(tg_m("arith-swap", tg_rep1(l, "subq ", "addq ")), acc) else if tg_starts(l, "    imulq ") == 1 then Cons(tg_m("arith-swap", tg_rep1(l, "imulq ", "addq ")), acc) else if tg_starts(l, "    leaq -1(") == 1 then Cons(tg_m("arith-swap", tg_rep1(l, "leaq -1(", "leaq 1(")), acc) else if l == "    incq %rax" then Cons(tg_m("arith-swap", "    decq %rax"), acc) else if l == "    sarq $1, %rax" then Cons(tg_m("arith-swap", "    sarq $2, %rax"), acc) else acc
fn tg_callm(l, acc) = if l == "    call addv" then Cons(tg_m("call-swap", "    call __rt_sub"), acc) else if l == "    call __rt_sub" then Cons(tg_m("call-swap", "    call addv"), acc) else if l == "    call __rt_mul" then Cons(tg_m("call-swap", "    call addv"), acc) else if l == "    call __rt_div" then Cons(tg_m("call-swap", "    call __rt_mod"), acc) else if l == "    call __rt_mod" then Cons(tg_m("call-swap", "    call __rt_div"), acc) else if l == "    call cmpv" then Cons(tg_m("call-swap", "    call eqv"), acc) else if l == "    call ctfail" then Cons(tg_del("call-swap"), acc) else acc
fn tg_rsp(l, acc) = if l == "    movq %rbp, %rsp" or l == "    popq %rbp" or l == "    pushq %rbp" then Cons(tg_del("rsp-unbalance"), acc) else if tg_starts(l, "    subq $") == 1 and tg_has(l, ", %rsp") == 1 then Cons(tg_m("rsp-unbalance", tg_imm(l, 8)), acc) else if tg_starts(l, "    pushq %r") == 1 or tg_starts(l, "    popq %r") == 1 then Cons(tg_del("rsp-unbalance"), Cons({cls: "rsp-unbalance", ls: Cons(l, Cons(l, Nil))}, acc)) else if l == "    ret" then Cons({cls: "rsp-unbalance", ls: Cons("    pushq %rax", Cons(l, Nil))}, acc) else acc
fn tg_isframe(l) = if l == "    movq %rbp, %rsp" or l == "    popq %rbp" or l == "    pushq %rbp" or l == "    ret" or l == "    movq %rsp, %rbp" or tg_has(l, "%rsp") == 1 then 1 else 0
fn tg_muts(l) = if count(l) < 5 or at(l, 0) != " " then Nil else if tg_isframe(l) == 1 then tg_rsp(l, Nil) else tg_rsp(l, tg_jcc(l, tg_setcc(l, tg_arith(l, tg_callm(l, tg_opt("slot-shift", tg_slot(l, 8), tg_opt("slot-shift", tg_slot(l, 0 - 8), tg_if(if tg_has(l, "%rdi") == 1 or tg_has(l, "%rsi") == 1 then 1 else 0, "reg-swap", tg_swap_reg(l), tg_opt("immediate", if tg_starts(l, "    movq $") == 1 or tg_starts(l, "    cmpq $") == 1 or tg_starts(l, "    testb $") == 1 then tg_imm(l, 2) else "", Cons(tg_del("delete"), Nil))))))))))
## every mutant of a function: {cls, at: line index, was: original line, ls: the function's lines after the mutation}
fn tg_fn_muts(before_rev, ls, i) = match ls
    Nil        => Nil
    Cons(l, t) => tg_app(tg_line_muts(tg_muts(l), before_rev, l, t, i), tg_fn_muts(Cons(l, before_rev), t, i + 1))
fn tg_line_muts(ms, before_rev, l, after, i) = match ms
    Nil        => Nil
    Cons(m, t) => Cons({cls: m.cls, at: i, was: l, ls: tg_revacc(before_rev, tg_app(m.ls, after))}, tg_line_muts(t, before_rev, l, after, i))
fn tg_show_new(ls, i) = match ls
    Nil        => "<end>"
    Cons(h, t) => if i <= 0 then h else tg_show_new(t, i - 1)

## --- behaviour of a binary on the vectors of one function: status and stdout per vector ---
fn tg_beh1(elf, h, out) = let r = tg_run(elf, Cons(h.f, Cons(h.x, Cons(h.y, Cons(h.z, Nil)))), out, 10000) in str(r.status) + ":" + r.out + ":" + r.err
fn tg_beh(elf, vs, f, out) = match vs
    Nil        => ""
    Cons(h, t) => (if h.f == f then tg_beh1(elf, h, out) + "|" else "") + tg_beh(elf, t, f, out)
## extended vectors: small values, contract bounds, and words on both sides of the 63-bit tag limit
fn tg_pool(i) = if i == 0 then 0 else if i == 1 then 1 else if i == 2 then 0 - 1 else if i == 3 then 2 else if i == 4 then 3 else if i == 5 then 7 else if i == 6 then 10 else if i == 7 then 50 else if i == 8 then 100 else if i == 9 then 0 - 7 else if i == 10 then 1000000000000 else if i == 11 then 4611686018427387903 else if i == 12 then 4611686018427387904 else if i == 13 then 0 - 4611686018427387904 else if i == 14 then 0 - 4611686018427387905 else if i == 15 then 9223372036854775807 else if i == 16 then 0 - 9223372036854775807 else if i == 17 then 6 else if i == 18 then 51 else 101
fn tg_prng(s) = (s * 1103515245 + 12345) % 2147483648
fn tg_ext(f, k, s) = if k <= 0 then Nil else let s1 = tg_prng(s) in let s2 = tg_prng(s1) in let s3 = tg_prng(s2) in Cons(tg_v(f, tg_pool(s1 / 65536 % 20), tg_pool(s2 / 65536 % 20), tg_pool(s3 / 65536 % 20)), tg_ext(f, k - 1, s3))
fn tg_nvec(vs, f) = match vs
    Nil        => 0
    Cons(h, t) => (if h.f == f then 1 else 0) + tg_nvec(t, f)

## --- one mutant: assemble, run, validate ---
## st = {err, n, killed (behaviour differs), rej_killed, eq_rej (same behaviour, rejected), eq_acc, noasm, cls: per-class killed counts, log}
fn tg_cls_add(cs, c) = match cs
    Nil        => Cons({c: c, n: 1}, Nil)
    Cons(h, t) => if h.c == c then Cons({c: c, n: h.n + 1}, t) else Cons(h, tg_cls_add(t, c))
fn tg_cls_get(cs, c) = match cs
    Nil        => 0
    Cons(h, t) => if h.c == c then h.n else tg_cls_get(t, c)
fn tg_cls_show(cs) = match cs
    Nil        => ""
    Cons(h, t) => h.c + " " + str(h.n) + tg_sep(t) + tg_cls_show(t)
fn tg_sep(t) = match t
    Nil        => ""
    Cons(h, r) => ", "
fn tg_ltv(cfg, f, asm_path, out) = tg_input(cfg.ltv, Nil, out + ".in", out, 120000)
fn tg_mutant(cfg, f, pre, post, m, base, vs, st) = let sp = cfg.tmp + "/m.s" in let w = fs_write_sync(sp, pre + tg_join(tg_unlines(m.ls)) + post) in let a = tg_run(cfg.lasm, Cons("--strict", Cons(sp, Nil)), cfg.tmp + "/m.elf", 120000) in let wi = fs_write_sync(cfg.tmp + "/m.tv.in", "@root " + cfg.root + "\n@src " + cfg.tmp + "/fixture.src\n@asm " + sp + "\n@fn " + f + "\n@out " + cfg.tmp + "/proofs\n") in let v = tg_ltv(cfg, f, sp, cfg.tmp + "/m.tv") in let rejected = if v.status != 0 and tg_has(v.out, "\"name\":\"" + f + "\",\"status\":\"rejected\"") == 1 then 1 else 0 in let validated = if v.status == 0 and tg_has(v.out, "\"name\":\"" + f + "\",\"status\":\"validated\"") == 1 then 1 else 0 in let what = f + " line " + str(m.at) + " [" + m.cls + "]: `" + m.was + "` -> `" + (if tg_len(m.ls) < cfg.nlines then "<deleted>" else tg_show_new(m.ls, m.at)) + "`" in if rejected == 0 and validated == 0 then {err: "ltv gave no verdict (crash or malformed report) on mutant " + what + ": status " + str(v.status) + " " + v.err, n: st.n, killed: st.killed, rej_killed: st.rej_killed, eq_rej: st.eq_rej, eq_acc: st.eq_acc, noasm: st.noasm, cls: st.cls, log: st.log} else if a.status != 0 then {err: "", n: st.n + 1, killed: st.killed, rej_killed: st.rej_killed, eq_rej: st.eq_rej, eq_acc: st.eq_acc, noasm: st.noasm + 1, cls: st.cls, log: st.log} else let ch = os_run("/bin/chmod", Cons("+x", Cons(cfg.tmp + "/m.elf", Nil))) in let differs = if tg_beh(cfg.tmp + "/m.elf", vs, f, cfg.tmp + "/m.run") != base then 1 else 0 in if differs == 1 and validated == 1 then {err: "UNSOUND: ltv validated a mutant whose native behaviour differs from the original: " + what, n: st.n, killed: st.killed, rej_killed: st.rej_killed, eq_rej: st.eq_rej, eq_acc: st.eq_acc, noasm: st.noasm, cls: st.cls, log: st.log} else if differs == 1 then {err: "", n: st.n + 1, killed: st.killed + 1, rej_killed: st.rej_killed + 1, eq_rej: st.eq_rej, eq_acc: st.eq_acc, noasm: st.noasm, cls: tg_cls_add(st.cls, m.cls), log: st.log} else if rejected == 1 then {err: "", n: st.n + 1, killed: st.killed, rej_killed: st.rej_killed, eq_rej: st.eq_rej + 1, eq_acc: st.eq_acc, noasm: st.noasm, cls: st.cls, log: st.log} else if tg_beh(cfg.tmp + "/m.elf", cfg.ext, f, cfg.tmp + "/m.run") != cfg.extbase then {err: "UNSOUND: ltv validated a mutant whose native behaviour differs from the original on the extended vectors: " + what, n: st.n, killed: st.killed, rej_killed: st.rej_killed, eq_rej: st.eq_rej, eq_acc: st.eq_acc, noasm: st.noasm, cls: st.cls, log: st.log} else {err: "", n: st.n + 1, killed: st.killed, rej_killed: st.rej_killed, eq_rej: st.eq_rej, eq_acc: st.eq_acc + 1, noasm: st.noasm, cls: st.cls, log: Cons("  equivalent (accepted, same behaviour on the base and the extended vectors): " + what + "\n", st.log)}
fn tg_mutants(cfg, f, pre, post, ms, k, base, vs, st) = match ms
    Nil        => st
    Cons(m, t) => if st.err != "" then st else if k % cfg.stride != 0 then tg_mutants(cfg, f, pre, post, t, k + 1, base, vs, st) else tg_mutants(cfg, f, pre, post, t, k + 1, base, vs, tg_mutant(cfg, f, pre, post, m, base, vs, st))
fn tg_fn(cfg, asm, f, vs, st) = let n = count(asm) in let b = tg_fn_start(asm, n, 0, f + ":") in if b < 0 then {err: "fixture function " + f + " is missing from the assembly", n: st.n, killed: st.killed, rej_killed: st.rej_killed, eq_rej: st.eq_rej, eq_acc: st.eq_acc, noasm: st.noasm, cls: st.cls, log: st.log} else let e = tg_fn_end(asm, n, b) in let ls = tg_lines(asm, e, b) in let base = tg_beh(cfg.tmp + "/fixture.elf", vs, f, cfg.tmp + "/base.run") in let ext = tg_ext(f, 48, 20261110 + count(f) * 7919 + ord(at(f, 2))) in tg_mutants({root: cfg.root, tmp: cfg.tmp, lasm: cfg.lasm, ltv: cfg.ltv, stride: cfg.stride, nlines: tg_len(ls), ext: ext, extbase: tg_beh(cfg.tmp + "/fixture.elf", ext, f, cfg.tmp + "/base.run")}, f, slicen(asm, n, 0, b), slicen(asm, n, e, n), tg_fn_muts(Nil, ls, 0), 0, base, vs, st)
fn tg_fns(cfg, asm, fs, vs, st) = match fs
    Nil        => st
    Cons(f, t) => if st.err != "" then st else tg_fns(cfg, asm, t, vs, tg_fn(cfg, asm, f, vs, st))
fn tg_all_validated(out, fs) = match fs
    Nil        => ""
    Cons(f, t) => if tg_has(out, "\"name\":\"" + f + "\",\"status\":\"validated\"") == 1 then tg_all_validated(out, t) else f
fn tg_field(out, key) = let i = tg_index(out, "\"" + key + "\":", 0) in if i < 0 then 0 else let b = i + count(key) + 3 in tg_num(out, b, tg_digits_end(out, b), 0)
fn tg_need(cs, names) = match names
    Nil        => ""
    Cons(h, t) => if tg_cls_get(cs, h) == 0 then h else tg_need(cs, t)
## --- [C0010]: machine-level constant time of `@secret` functions. ltv scans the emitted code of a `@secret` function and
##     rejects a conditional branch, a division and a memory access that is not a frame slot. The gate checks both
##     directions on real lumec output: a branch-free function is validated, the same `+` that is validated in a public
##     function is rejected in a secret one (its tag test is a branch), and three leaks injected into the validated
##     code are each rejected with [C0010] and the reason that names the leak. Since Wave 14 the scan is closed over
##     calls: the code of every routine a `@secret` function reaches is scanned too. The branch-free function is
##     therefore a constant-time kernel (`@secret` + `@no_alloc`, lowered without runtime helpers); the SAME body
##     in a plain `@secret` function (`ctplain`) goes through __rt_un2 / mkint, which branch, and must be rejected
##     with the call chain in the reason -- before Wave 14 it was validated because helpers were not inspected. ---
fn tg_ct_source() = "@secret\n@no_alloc\nfn ctsel(mask: int, a: int, b: int) -> int = bit_xor(a, bit_and(mask, bit_xor(a, b)))\n@secret fn ctadd(k: int, m: int) -> int = k + m\n@secret fn ctplain(mask: int, a: int, b: int) -> int = bit_xor(a, bit_and(mask, bit_xor(a, b)))\nfn pubadd(k: int, m: int) -> int = k + m\nprint 0\n"
fn tg_rep1_from(s, pat, rep, from) = let i = tg_index(s, pat, from) in if i < 0 then s else slice(s, 0, i) + rep + slice(s, i + count(pat), count(s))
fn tg_ct_ltv(cfg, asm_path, f, tag) = let w = fs_write_sync(cfg.tmp + "/ct." + tag + ".in", "@root " + cfg.root + "\n@src " + cfg.tmp + "/ct.src\n@asm " + asm_path + "\n@fn " + f + "\n@out " + cfg.tmp + "/proofs\n") in tg_input(cfg.ltv, Nil, cfg.tmp + "/ct." + tag + ".in", cfg.tmp + "/ct." + tag + ".out", 120000)
fn tg_ct_rejected(v, f, why) = if v.status != 0 and tg_has(v.out, "\"name\":\"" + f + "\",\"status\":\"rejected\",\"reason\":\"[C0010]") == 1 and tg_has(v.out, why) == 1 then 1 else 0
fn tg_ct_mut(cfg, asm, at0, tag, pat, rep, why) = let m = tg_rep1_from(asm, pat, rep, at0) in if m == asm then "the mutation site `" + pat + "` is not in the code of ctsel" else let w = fs_write_sync(cfg.tmp + "/ct." + tag + ".s", m) in let v = tg_ct_ltv(cfg, cfg.tmp + "/ct." + tag + ".s", "ctsel", tag) in if tg_ct_rejected(v, "ctsel", why) == 1 then "" else "ltv did not reject with [C0010] (" + why + ") the @secret function ctsel after `" + rep + "` was injected: " + v.out + v.err
fn tg_ct(cfg) = let w = fs_write_sync(cfg.tmp + "/ct.src", tg_ct_source()) in let c = tg_input(cfg.root + "/build/bin/lumec", Nil, cfg.tmp + "/ct.src", cfg.tmp + "/ct.s", 120000) in if c.status != 0 then "lumec rejected the fixture: " + c.err else let asm = fs_read_file(cfg.tmp + "/ct.s") in let at0 = tg_index(asm, "\nctsel:\n", 0) in if at0 < 0 then "ctsel is missing from the assembly" else let p = tg_ct_ltv(cfg, cfg.tmp + "/ct.s", "ctsel", "pos") in if p.status != 0 or tg_has(p.out, "\"name\":\"ctsel\",\"status\":\"validated\"") == 0 then "ltv did not validate the branch-free @secret function ctsel: " + p.out + p.err else let q = tg_ct_ltv(cfg, cfg.tmp + "/ct.s", "pubadd", "pub") in if q.status != 0 or tg_has(q.out, "\"name\":\"pubadd\",\"status\":\"validated\"") == 0 then "ltv did not validate the public function pubadd: " + q.out + q.err else let n = tg_ct_ltv(cfg, cfg.tmp + "/ct.s", "ctadd", "neg") in if tg_ct_rejected(n, "ctadd", "conditional branch") == 0 then "ltv did not reject with [C0010] the @secret function ctadd, whose emitted `+` branches on the tag of its operands: " + n.out + n.err else let n2 = tg_ct_ltv(cfg, cfg.tmp + "/ct.s", "ctplain", "neg2") in if tg_ct_rejected(n2, "ctplain", "ctplain -> __rt_un2 -> __rt_uint: secret-dependent conditional branch") == 0 then "ltv did not reject with [C0010] the plain @secret function ctplain, whose bit operations call runtime helpers that branch (the reason must name the call chain): " + n2.out + n2.err else let m1 = tg_ct_mut(cfg, asm, at0, "m1", "    xorq %rcx, %rax\n", "    xorq %rcx, %rax\n    jo .Lct_leak\n.Lct_leak:\n", "conditional branch") in if m1 != "" then m1 else let m2 = tg_ct_mut(cfg, asm, at0, "m2", "    andq %rcx, %rax\n", "    andq %rcx, %rax\n    movq (%rcx), %rdx\n", "memory access") in if m2 != "" then m2 else tg_ct_mut(cfg, asm, at0, "m3", "    xorq %rcx, %rax\n", "    xorq %rcx, %rax\n    idivq %rcx\n", "division")
## --- Wave 14: constant-time kernels (`@secret` + `@no_alloc`). The kernels below are written in the shape a crypto
##     library uses them (ChaCha20 add / xor-rotate / quarter round, Poly1305 clamp / multiply row / carry, X25519
##     conditional swap, tag compare). The gate checks, on real lumec output:
##       1. every kernel is emitted without any jump, any division and any call that is not a call of another kernel;
##       2. ltv validates all of them (0 rejected), reports each as a constant-time kernel checked transitively, and its
##          native boundary run (the extremes -2^62 and 2^62 - 1 included) agrees with the real machine code;
##       3. negative controls are each rejected with [C0010] and the reason that names the leak: a branch on a secret,
##          the entry guard removed or weakened, a call into a runtime helper that branches (the call chain is named:
##          this is the transitive scan), a secret-indexed memory access, a division, a leak inside a CALLEE kernel;
##          and a kernel whose callee computes something else is rejected as well;
##       4. a mutation campaign in the style of the one below: every instruction line of ten kernels is mutated by
##          every operator that applies; a mutant that changes native behaviour on the vectors (boxed arguments are
##          vectors too: the original faults on them, so a weakened guard is a behaviour change) must be rejected.
##     The digests in the report are compared with /usr/bin/sha256sum (ltv has its own SHA-256). ---
fn tk_k(nm, sig, body) = "@secret\n@no_alloc\nfn " + nm + sig + " -> int = " + body + "\n"
fn tk_rot(nm, l, r) = tk_k(nm, "(x: int, y: int)", "let v = bit_xor(bit_and(x, 4294967295), bit_and(y, 4294967295)) in bit_or(bit_and(bit_shl(v, " + str(l) + "), 4294967295), bit_shr(v, " + str(r) + "))")
fn tk_qr(nm, tail) = tk_k(nm, "(a: int, b: int, c: int, d: int)", "let a1 = add32(a, b) in let d1 = xrotl16(d, a1) in let c1 = add32(c, d1) in let b1 = xrotl12(b, c1) in " + tail)
fn tk_fixture() = tk_k("add32", "(a: int, b: int)", "bit_and(bit_and(a, 4294967295) + bit_and(b, 4294967295), 4294967295)") + tk_rot("xrotl16", 16, 16) + tk_rot("xrotl12", 12, 20) + tk_rot("xrotl8", 8, 24) + tk_rot("xrotl7", 7, 25) + tk_qr("qr_a", "add32(a1, b1)") + tk_qr("qr_d", "xrotl8(d1, add32(a1, b1))") + tk_qr("qr_c", "add32(c1, xrotl8(d1, add32(a1, b1)))") + tk_qr("qr_b", "xrotl7(b1, add32(c1, xrotl8(d1, add32(a1, b1))))") + tk_k("p_clamp0", "(t: int)", "bit_and(t, 67108863)") + tk_k("p_clamp1", "(t: int)", "bit_and(t, 67108611)") + tk_k("p_clamp2", "(t: int)", "bit_and(t, 67092735)") + tk_k("p_clamp3", "(t: int)", "bit_and(t, 66076671)") + tk_k("p_clamp4", "(t: int)", "bit_and(t, 1048575)") + tk_k("p_row", "(h0: int, h1: int, h2: int, h3: int, h4: int, r0: int, s1: int, s2: int, s3: int, s4: int, carry: int)", "bit_and(h0, 268435455) * bit_and(r0, 536870911) + bit_and(h1, 268435455) * bit_and(s4, 536870911) + bit_and(h2, 268435455) * bit_and(s3, 536870911) + bit_and(h3, 268435455) * bit_and(s2, 536870911) + bit_and(h4, 268435455) * bit_and(s1, 536870911) + bit_and(carry, 1099511627775)") + tk_k("p_carry", "(d: int)", "bit_shr(d, 26)") + tk_k("p_low", "(d: int)", "bit_and(d, 67108863)") + tk_k("x_cswap", "(mask: int, x: int, y: int)", "ct_select(mask, y, x)") + tk_k("x_cswap_xor", "(mask: int, x: int, y: int)", "bit_xor(x, bit_and(mask, bit_xor(x, y)))") + tk_k("tag_step", "(acc: int, a: int, b: int)", "bit_or(bit_and(acc, 255), bit_xor(bit_and(a, 255), bit_and(b, 255)))") + tk_k("tag_eq", "(a: int, b: int)", "ct_eq(a, b)") + tk_k("k_mix", "(a: int, b: int)", "bit_not(bit_and(a, 65535)) - bit_and(b, 255) * 3 +% bit_shr(a, 62) *% 2")
fn tk_names() = Cons("add32", Cons("xrotl16", Cons("xrotl12", Cons("xrotl8", Cons("xrotl7", Cons("qr_a", Cons("qr_d", Cons("qr_c", Cons("qr_b", Cons("p_clamp0", Cons("p_clamp1", Cons("p_clamp2", Cons("p_clamp3", Cons("p_clamp4", Cons("p_row", Cons("p_carry", Cons("p_low", Cons("x_cswap", Cons("x_cswap_xor", Cons("tag_step", Cons("tag_eq", Cons("k_mix", Nil))))))))))))))))))))))
## the kernels the campaign mutates, with their arity
fn tk_camp() = Cons({f: "add32", n: 2}, Cons({f: "xrotl16", n: 2}, Cons({f: "qr_b", n: 4}, Cons({f: "p_row", n: 11}, Cons({f: "p_carry", n: 1}, Cons({f: "x_cswap", n: 3}, Cons({f: "x_cswap_xor", n: 3}, Cons({f: "tag_step", n: 3}, Cons({f: "tag_eq", n: 2}, Cons({f: "k_mix", n: 2}, Nil))))))))))
fn tk_pick1(nm, call) = "if f == \"" + nm + "\" then " + call + " else "
fn tk_source() = tk_fixture() + "fn argi(k: int) -> int = let s = os_arg_at(k) in if count(s) > 0 and at(s, 0) == \"-\" then 0 - toint(slice(s, 1, count(s))) else toint(s)\nfn pk(f: str, a: int, b: int, c: int, d: int, e: int, g: int, h: int, i: int, j: int, k: int, l: int) -> int = " + tk_pick1("add32", "add32(a, b)") + tk_pick1("xrotl16", "xrotl16(a, b)") + tk_pick1("qr_b", "qr_b(a, b, c, d)") + tk_pick1("p_carry", "p_carry(a)") + tk_pick1("x_cswap", "x_cswap(a, b, c)") + tk_pick1("x_cswap_xor", "x_cswap_xor(a, b, c)") + tk_pick1("tag_step", "tag_step(a, b, c)") + tk_pick1("tag_eq", "tag_eq(a, b)") + tk_pick1("k_mix", "k_mix(a, b)") + "p_row(a, b, c, d, e, g, h, i, j, k, l)\nprint pk(os_arg_at(1), argi(2), argi(3), argi(4), argi(5), argi(6), argi(7), argi(8), argi(9), argi(10), argi(11), argi(12))\n"
fn tk_in(xs, x) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else tk_in(t, x)
## 1. the emitted text of a kernel
fn tk_clean_lines(ls, names) = match ls
    Nil        => ""
    Cons(l, t) => if tg_starts(l, "    j") == 1 then "a jump `" + l + "`" else if tg_has(l, "div") == 1 then "a division `" + l + "`" else if tg_starts(l, "    call ") == 1 and tk_in(names, slice(l, 9, count(l))) == 0 then "a call of something that is not a kernel `" + l + "`" else tk_clean_lines(t, names)
fn tk_clean(asm, fs, names) = match fs
    Nil        => ""
    Cons(f, t) => let n = count(asm) in let b = tg_fn_start(asm, n, 0, f + ":") in if b < 0 then "kernel " + f + " is missing from the assembly" else let bad = tk_clean_lines(tg_lines(asm, tg_fn_end(asm, n, b), b), names) in if bad != "" then "the emitted code of kernel " + f + " holds " + bad else tk_clean(asm, t, names)
fn tk_all_ct(out, fs) = match fs
    Nil        => ""
    Cons(f, t) => if tg_has(out, "\"name\":\"" + f + "\",\"status\":\"validated\",\"reason\":\"\"") == 1 and tk_ct_flags(out, f) == 1 then tk_all_ct(out, t) else f
fn tk_ct_flags(out, f) = let i = tg_index(out, "\"name\":\"" + f + "\"", 0) in if i < 0 then 0 else let e = tg_index(out, "}", i) in if e < 0 then 0 else let o = slice(out, i, e) in if tg_has(o, "\"constant_time_kernel\":true") == 1 and tg_has(o, "\"ct_checked_transitively\":true") == 1 then 1 else 0
fn tk_sha(cfg, path) = let r = tg_run("/usr/bin/sha256sum", Cons(path, Nil), cfg.tmp + "/sha.out", 60000) in if r.status != 0 or count(r.out) < 64 then "" else slice(r.out, 0, 64)
## 3. negative controls on the real assembly
fn tk_ltv(cfg, asm_path, f, tag) = let w = fs_write_sync(cfg.tmp + "/kn." + tag + ".in", "@root " + cfg.root + "\n@src " + cfg.tmp + "/kfix.src\n@asm " + asm_path + "\n@fn " + f + "\n@out " + cfg.tmp + "/proofs\n") in tg_input(cfg.ltv, Nil, cfg.tmp + "/kn." + tag + ".in", cfg.tmp + "/kn." + tag + ".out", 120000)
fn tk_neg(cfg, asm, site, f, tag, pat, rep, pre, why1, why2) = let at0 = tg_index(asm, "\n" + site + ":\n", 0) in if at0 < 0 then "kernel " + site + " is missing from the assembly" else let m = tg_rep1_from(asm, pat, rep, at0) in if m == asm then "[" + tag + "] the mutation site is not in the code of " + site else let w = fs_write_sync(cfg.tmp + "/kn." + tag + ".s", m) in let v = tk_ltv(cfg, cfg.tmp + "/kn." + tag + ".s", f, tag) in if v.status != 0 and tg_has(v.out, "\"name\":\"" + f + "\",\"status\":\"rejected\",\"reason\":\"" + pre) == 1 and tg_has(v.out, why1) == 1 and tg_has(v.out, why2) == 1 then "" else "[" + tag + "] ltv did not reject kernel " + f + " with '" + pre + "' / '" + why1 + "' / '" + why2 + "': " + v.out + v.err
fn tk_first(xs) = match xs
    Nil        => ""
    Cons(h, t) => if h != "" then h else tk_first(t)
fn tk_negs(cfg, asm) = let site = "    decq %rax\n    addq %rcx, %rax\n" in let guard = "    andq $1, %rax\n    decq %rax\n    orq %rsp, %rax\n    movq (%rax), %rax\n" in let c = "[C0010]" in tk_first(Cons(tk_neg(cfg, asm, "add32", "add32", "branch", site, site + "    jz .Lk_leak\n.Lk_leak:\n", c, "secret-dependent conditional branch", "jz .Lk_leak"), Cons(tk_neg(cfg, asm, "add32", "add32", "noguard", guard, "", c, "without the literal fail-closed entry guard", "add32"), Cons(tk_neg(cfg, asm, "add32", "add32", "guard-inc", "    andq $1, %rax\n    decq %rax\n", "    andq $1, %rax\n    incq %rax\n", c, "movq (%rax), %rax", "memory access"), Cons(tk_neg(cfg, asm, "x_cswap", "x_cswap", "guard-param", "    movq -24(%rbp), %rcx\n    andq %rcx, %rax\n", "", c, "entry guard does not cover parameter 'y'", "x_cswap"), Cons(tk_neg(cfg, asm, "add32", "add32", "mkint", site, site + "    movq %rax, %rdi\n    call mkint\n", c, "add32 -> mkint: secret-dependent conditional branch", "jo "), Cons(tk_neg(cfg, asm, "add32", "add32", "addv", site, "    movq %rax, %rdi\n    movq %rcx, %rsi\n    call addv\n", c, "add32 -> addv: secret-dependent conditional branch", "call"), Cons(tk_neg(cfg, asm, "add32", "add32", "memidx", site, site + "    movq (%rcx), %rdx\n", c, "memory access", "movq (%rcx), %rdx"), Cons(tk_neg(cfg, asm, "add32", "add32", "div", site, site + "    idivq %rcx\n", c, "variable-latency division", "idivq %rcx"), Cons(tk_neg(cfg, asm, "add32", "add32", "indirect", site, site + "    call *%rcx\n", c, "indirect call", "call *%rcx"), Cons(tk_neg(cfg, asm, "add32", "add32", "nosym", site, site + "    call tk_no_such_routine\n", c, "add32 -> tk_no_such_routine", "not defined in the assembly"), Cons(tk_neg(cfg, asm, "xrotl12", "qr_b", "callee-branch", "    orq $1, %rax\n", "    orq $1, %rax\n    jz .Lk_leak2\n.Lk_leak2:\n", c, "qr_b -> xrotl12: secret-dependent conditional branch", "jz .Lk_leak2"), Cons(tk_neg(cfg, asm, "add32", "qr_b", "callee-value", site, "    addq %rcx, %rax\n", "constant-time kernel callee 'add32' is not validated", "add32", "qr_b"), Nil)))))))))))))
## 4. mutation campaign
fn tk_pool(i) = if i == 0 then 0 else if i == 1 then 1 else if i == 2 then 0 - 1 else if i == 3 then 255 else if i == 4 then 256 else if i == 5 then 65535 else if i == 6 then 4294967295 else if i == 7 then 4294967296 else if i == 8 then 0 - 4294967296 else if i == 9 then 4611686018427387903 else if i == 10 then 0 - 4611686018427387904 else if i == 11 then 1311768467463790320 else if i == 12 then 67108863 else if i == 13 then 1099511627775 else if i == 14 then 0 - 81985529216486896 else 305419896
## 11 argument texts; position `boxat` (when >= 0) holds 2^62, which is not an immediate: the kernel must fault on it
fn tk_argl(k, s, boxat) = if k >= 11 then Nil else let s1 = tg_prng(s) in Cons(if k == boxat then "4611686018427387904" else tg_arg(tk_pool(s1 / 65536 % 16)), tk_argl(k + 1, s1, boxat))
fn tk_vecs_rand(f, k, s) = if k <= 0 then Nil else Cons({f: f, a: tk_argl(0, s, 0 - 1)}, tk_vecs_rand(f, k - 1, tg_prng(tg_prng(s) + k)))
fn tk_vecs_box(f, j, n, s) = if j >= n then Nil else Cons({f: f, a: tk_argl(0, s + j * 31, j)}, tk_vecs_box(f, j + 1, n, s))
fn tk_beh(elf, vs, out) = match vs
    Nil        => ""
    Cons(h, t) => let r = tg_run(elf, Cons(h.f, h.a), out, 10000) in str(r.status) + ":" + r.out + ":" + r.err + "|" + tk_beh(elf, t, out)
fn tk_swap2(l, x, y) = tg_repall(tg_repall(tg_repall(l, x, "%r__", 0), y, x, 0), "%r__", y, 0)
fn tk_bit(l, acc) = if tg_starts(l, "    andq %r") == 1 then Cons(tg_m("bit-swap", tg_rep1(l, "andq ", "orq ")), Cons(tg_m("bit-swap", tg_rep1(l, "andq ", "xorq ")), acc)) else if tg_starts(l, "    orq %r") == 1 then Cons(tg_m("bit-swap", tg_rep1(l, "orq ", "xorq ")), Cons(tg_m("bit-swap", tg_rep1(l, "orq ", "andq ")), acc)) else if tg_starts(l, "    xorq %r") == 1 then Cons(tg_m("bit-swap", tg_rep1(l, "xorq ", "andq ")), Cons(tg_m("bit-swap", tg_rep1(l, "xorq ", "orq ")), acc)) else acc
fn tk_tag(l, acc) = if l == "    orq $1, %rax" then Cons(tg_m("tag", "    orq $3, %rax"), Cons(tg_m("tag", "    orq $2, %rax"), acc)) else if l == "    andq $1, %rax" then Cons(tg_m("tag", "    andq $3, %rax"), Cons(tg_m("tag", "    andq $2, %rax"), acc)) else if l == "    xorq $1, %rax" then Cons(tg_m("tag", "    xorq $3, %rax"), acc) else if tg_starts(l, "    leaq 1(%rax,%rax)") == 1 then Cons(tg_m("tag", tg_rep1(l, "leaq 1(", "leaq 3(")), Cons(tg_m("tag", tg_rep1(l, "leaq 1(", "leaq 0(")), acc)) else acc
fn tk_shift(l, acc) = if l == "    sarq $1, %rax" then Cons(tg_m("shift", "    shrq $1, %rax"), acc) else if tg_starts(l, "    sarq $") == 1 then tg_opt("shift", tg_imm(l, 1), tg_opt("shift", tg_imm(l, 0 - 1), Cons(tg_m("shift", tg_rep1(l, "sarq ", "shrq ")), acc))) else if tg_starts(l, "    salq $") == 1 then tg_opt("shift", tg_imm(l, 1), tg_opt("shift", tg_imm(l, 0 - 1), Cons(tg_m("shift", tg_rep1(l, "salq ", "sarq ")), acc))) else if tg_starts(l, "    shrq $") == 1 then tg_opt("shift", tg_imm(l, 0 - 1), Cons(tg_m("shift", tg_rep1(l, "shrq ", "sarq ")), acc)) else acc
fn tk_unary(l, acc) = if tg_starts(l, "    negq ") == 1 then Cons(tg_m("neg", tg_rep1(l, "negq ", "notq ")), acc) else if tg_starts(l, "    decq ") == 1 then Cons(tg_m("incdec", tg_rep1(l, "decq ", "incq ")), acc) else if tg_starts(l, "    incq ") == 1 and l != "    incq %rax" then Cons(tg_m("incdec", tg_rep1(l, "incq ", "decq ")), acc) else acc
fn tk_opswap(l, acc) = if tg_has(l, "%rsp") == 1 or tg_has(l, "(%rax)") == 1 then acc else let a1 = if tg_has(l, "%rax") == 1 and tg_has(l, "%rcx") == 1 then Cons(tg_m("operand-swap", tk_swap2(l, "%rax", "%rcx")), acc) else acc in if tg_has(l, "%rcx") == 1 and tg_has(l, "%rdx") == 1 then Cons(tg_m("operand-swap", tk_swap2(l, "%rcx", "%rdx")), a1) else if tg_has(l, "%rax") == 1 and tg_has(l, "%rdx") == 0 and tg_has(l, "%rcx") == 0 and tg_starts(l, "    movq -") == 1 then Cons(tg_m("operand-swap", tg_rep1(l, "%rax", "%rcx")), a1) else a1
fn tk_const(l, acc) = if tg_starts(l, "    movq $") == 1 then tg_opt("const", tg_imm(l, 1), tg_opt("const", tg_imm(l, 4), acc)) else acc
fn tk_muts(l) = if count(l) < 5 or at(l, 0) != " " then Nil else if l == "    orq %rsp, %rax" then Cons(tg_del("delete"), tk_bit(l, Nil)) else if tg_isframe(l) == 1 then tg_muts(l) else tk_bit(l, tk_tag(l, tk_shift(l, tk_unary(l, tk_opswap(l, tk_const(l, tg_muts(l)))))))
fn tk_isguard(prev, l) = if l == "    andq $1, %rax" or l == "    orq %rsp, %rax" or l == "    movq (%rax), %rax" or (l == "    decq %rax" and prev == "    andq $1, %rax") then 1 else 0
fn tk_line_muts(ms, before_rev, l, after, i, g) = match ms
    Nil        => Nil
    Cons(m, t) => Cons({cls: if g == 1 then "guard" else m.cls, at: i, was: l, ls: tg_revacc(before_rev, tg_app(m.ls, after))}, tk_line_muts(t, before_rev, l, after, i, g))
fn tk_fn_muts(before_rev, ls, i, prev) = match ls
    Nil        => Nil
    Cons(l, t) => tg_app(tk_line_muts(tk_muts(l), before_rev, l, t, i, tk_isguard(prev, l)), tk_fn_muts(Cons(l, before_rev), t, i + 1, l))
fn tk_st(st, err, dn, dk, der, dea, dna, cls, log) = {err: err, n: st.n + dn, killed: st.killed + dk, rej_killed: st.rej_killed + dk, eq_rej: st.eq_rej + der, eq_acc: st.eq_acc + dea, noasm: st.noasm + dna, cls: cls, log: log}
fn tk_mutant(cfg, f, pre, post, m, base, vs, st) = let sp = cfg.tmp + "/k.s" in let w = fs_write_sync(sp, pre + tg_join(tg_unlines(m.ls)) + post) in let a = tg_run(cfg.lasm, Cons("--strict", Cons(sp, Nil)), cfg.tmp + "/k.elf", 120000) in let wi = fs_write_sync(cfg.tmp + "/k.tv.in", "@root " + cfg.root + "\n@src " + cfg.tmp + "/kfix.src\n@asm " + sp + "\n@fn " + f + "\n@out " + cfg.tmp + "/proofs\n") in let v = tg_input(cfg.ltv, Nil, cfg.tmp + "/k.tv.in", cfg.tmp + "/k.tv", 120000) in let rejected = if v.status != 0 and tg_has(v.out, "\"name\":\"" + f + "\",\"status\":\"rejected\"") == 1 then 1 else 0 in let validated = if v.status == 0 and tg_has(v.out, "\"name\":\"" + f + "\",\"status\":\"validated\"") == 1 then 1 else 0 in let what = f + " line " + str(m.at) + " [" + m.cls + "]: `" + m.was + "` -> `" + (if tg_len(m.ls) < cfg.nlines then "<deleted>" else tg_show_new(m.ls, m.at)) + "`" in if rejected == 0 and validated == 0 then tk_st(st, "ltv gave no verdict (crash or malformed report) on kernel mutant " + what + ": status " + str(v.status) + " " + v.err, 0, 0, 0, 0, 0, st.cls, st.log) else if a.status != 0 then tk_st(st, "", 1, 0, 0, 0, 1, st.cls, st.log) else let ch = os_run("/bin/chmod", Cons("+x", Cons(cfg.tmp + "/k.elf", Nil))) in let differs = if tk_beh(cfg.tmp + "/k.elf", vs, cfg.tmp + "/k.run") != base then 1 else 0 in if differs == 1 and validated == 1 then tk_st(st, "UNSOUND: ltv validated a kernel mutant whose native behaviour differs from the original: " + what, 0, 0, 0, 0, 0, st.cls, st.log) else if differs == 1 then tk_st(st, "", 1, 1, 0, 0, 0, tg_cls_add(st.cls, m.cls), st.log) else if rejected == 1 then tk_st(st, "", 1, 0, 1, 0, 0, st.cls, st.log) else if tk_beh(cfg.tmp + "/k.elf", cfg.ext, cfg.tmp + "/k.run") != cfg.extbase then tk_st(st, "UNSOUND: ltv validated a kernel mutant whose native behaviour differs from the original on the extended vectors: " + what, 0, 0, 0, 0, 0, st.cls, st.log) else tk_st(st, "", 1, 0, 0, 1, 0, st.cls, Cons("  equivalent kernel mutant (accepted, same behaviour on the base and the extended vectors): " + what + "\n", st.log))
fn tk_mutants(cfg, f, pre, post, ms, k, base, vs, st) = match ms
    Nil        => st
    Cons(m, t) => if st.err != "" then st else if k % cfg.stride != 0 then tk_mutants(cfg, f, pre, post, t, k + 1, base, vs, st) else tk_mutants(cfg, f, pre, post, t, k + 1, base, vs, tk_mutant(cfg, f, pre, post, m, base, vs, st))
fn tk_fn(cfg, asm, c, st) = let n = count(asm) in let b = tg_fn_start(asm, n, 0, c.f + ":") in if b < 0 then tk_st(st, "kernel " + c.f + " is missing from the assembly", 0, 0, 0, 0, 0, st.cls, st.log) else let e = tg_fn_end(asm, n, b) in let ls = tg_lines(asm, e, b) in let seed = 20261111 + count(c.f) * 7919 + ord(at(c.f, 2)) in let vs = tg_app(tk_vecs_rand(c.f, 20, seed), tk_vecs_box(c.f, 0, c.n, seed + 5)) in let ext = tk_vecs_rand(c.f, 40, seed + 977) in let base = tk_beh(cfg.tmp + "/kfix.elf", vs, cfg.tmp + "/kbase.run") in if tg_has(base, "139:") == 0 then tk_st(st, "the original kernel " + c.f + " did not fault on a boxed argument: its vectors cannot kill a weakened guard", 0, 0, 0, 0, 0, st.cls, st.log) else tk_mutants({root: cfg.root, tmp: cfg.tmp, lasm: cfg.lasm, ltv: cfg.ltv, stride: cfg.stride, nlines: tg_len(ls), ext: ext, extbase: tk_beh(cfg.tmp + "/kfix.elf", ext, cfg.tmp + "/kbase.run")}, c.f, slicen(asm, n, 0, b), slicen(asm, n, e, n), tk_fn_muts(Nil, ls, 0, ""), 0, base, vs, st)
fn tk_fns(cfg, asm, cs, st) = match cs
    Nil        => st
    Cons(c, t) => if st.err != "" then st else tk_fns(cfg, asm, t, tk_fn(cfg, asm, c, st))
fn tk_fail(msg) = {err: msg, n: 0, killed: 0, rej_killed: 0, eq_rej: 0, eq_acc: 0, noasm: 0, cls: Nil, log: Nil, nat: 0}
fn tk_all(cfg) = let w = fs_write_sync(cfg.tmp + "/kfix.src", tk_source()) in let c = tg_input(cfg.root + "/build/bin/lumec", Nil, cfg.tmp + "/kfix.src", cfg.tmp + "/kfix.s", 120000) in if c.status != 0 then tk_fail("lumec rejected the kernel fixture: " + c.err) else let asm = fs_read_file(cfg.tmp + "/kfix.s") in let cl = tk_clean(asm, tk_names(), tk_names()) in if cl != "" then tk_fail(cl) else let a = tg_run(cfg.lasm, Cons("--strict", Cons(cfg.tmp + "/kfix.s", Nil)), cfg.tmp + "/kfix.elf", 120000) in if a.status != 0 then tk_fail("lasm rejected the kernel fixture: " + a.err) else let ch = os_run("/bin/chmod", Cons("+x", Cons(cfg.tmp + "/kfix.elf", Nil))) in let w1 = fs_write_sync(cfg.tmp + "/kpos.in", "@root " + cfg.root + "\n@src " + cfg.tmp + "/kfix.src\n@asm " + cfg.tmp + "/kfix.s\n@out " + cfg.tmp + "/proofs\n@exec 1\n") in let p = tg_input(cfg.ltv, Nil, cfg.tmp + "/kpos.in", cfg.tmp + "/kpos.out", 600000) in let nk = tg_len(tk_names()) in let miss = tk_all_ct(p.out, tk_names()) in if p.status != 0 or miss != "" then tk_fail("ltv did not validate the constant-time kernel fixture (" + miss + "): " + p.out + p.err) else if tg_field(p.out, "rejected") != 0 or tg_field(p.out, "constant_time_kernels") != nk or tg_field(p.out, "constant_time_kernels_validated") != nk or tg_field(p.out, "secret_validated") != nk or tg_field(p.out, "secret_rejected") != 0 then tk_fail("the ltv report of the kernel fixture does not count " + str(nk) + " validated constant-time kernels: " + p.out) else if tg_field(p.out, "native_vectors") < nk * 20 then tk_fail("the native boundary run of the kernel fixture covered only " + str(tg_field(p.out, "native_vectors")) + " vectors") else if tg_has(p.out, "\"name\":\"qr_b\"") == 0 or tg_has(p.out, "\"ct_callees_inspected\":[\"add32\",\"xrotl16\",\"xrotl12\",\"xrotl8\",\"xrotl7\"]") == 0 then tk_fail("the report of qr_b does not list the callee kernels the transitive scan inspected: " + p.out) else if tg_has(p.out, "\"source_sha256\":\"" + tk_sha(cfg, cfg.tmp + "/kfix.src") + "\",\"asm_sha256\":\"" + tk_sha(cfg, cfg.tmp + "/kfix.s") + "\"") == 0 then tk_fail("the SHA-256 digests in the ltv report differ from /usr/bin/sha256sum") else let ng = tk_negs(cfg, asm) in if ng != "" then tk_fail(ng) else let st = tk_fns(cfg, asm, tk_camp(), {err: "", n: 0, killed: 0, rej_killed: 0, eq_rej: 0, eq_acc: 0, noasm: 0, cls: Nil, log: Nil}) in if st.err != "" then tk_fail(st.err + "\n  mutant assembly kept at " + cfg.tmp + "/k.s") else let lack = if cfg.stride == 1 then tg_need(st.cls, Cons("bit-swap", Cons("tag", Cons("shift", Cons("neg", Cons("incdec", Cons("operand-swap", Cons("const", Cons("guard", Cons("arith-swap", Cons("slot-shift", Cons("rsp-unbalance", Cons("delete", Nil))))))))))))) else "" in if lack != "" then tk_fail("kernel mutation class " + lack + " produced no behaviour-changing mutant, so it proves nothing") else if cfg.stride == 1 and st.killed < 400 then tk_fail("only " + str(st.killed) + " behaviour-changing kernel mutants; the campaign is too small to mean anything") else {err: "", n: st.n, killed: st.killed, rej_killed: st.rej_killed, eq_rej: st.eq_rej, eq_acc: st.eq_acc, noasm: st.noasm, cls: st.cls, log: st.log, nat: tg_field(p.out, "native_vectors")}
## --- Wave 14: object-code branch correlation. ltv must establish, for every validated function, a one-to-one
##     correspondence between the conditions of the lowered AST and the decision instructions (`j<cc>` / `set<cc>` on
##     comparison flags) of the emitted code, and reject a function where it does not hold -- even when the function
##     still computes the same values. The gate checks, on real lumec output:
##       1. a fixture with every condition form (contract check, short-circuit and / or, a constant condition, a
##          truth test of a value, comparisons materialised by set<cc>, immediate and register comparisons, a boxed
##          comparison through cmpv / eqv, a condition made unreachable by a constant) is validated with EXACTLY the
##          expected number of conditions per function, as many decision branches, `correlated: true`, and the
##          unreachable conditionals of `tb8` reported as such;
##       2. a campaign over every decision instruction and every `cmpq` of the fixture functions. Each mutant is a real
##          program: it is assembled by lasm and run natively on 49 vectors per function (boxed values included).
##            bc-duplicate    the instruction twice                                  (same values by construction)
##            bc-invert-keep  `jcc T` -> `j!cc .L; jmp T; .L:`                       (same values by construction)
##            bc-add          a new `je .L; .L:` after a set<cc> or a cmpq            (same values by construction)
##            bc-invert       `jcc T` -> `j!cc T`
##            bc-remove       the jump deleted
##          ltv must reject EVERY mutant. For the first three classes the gate also requires that the native
##          behaviour is unchanged (so the only thing wrong with the mutant is its branch structure) and that the
##          reason is the branch correlation. Each class must have mutants; bc-remove must contain a mutant that keeps
##          the behaviour (the jump of the constant condition of `tb3`) and is rejected for the correlation alone. ---
fn tb_fixture() = "fn tb1(x: int, y: int) -> int requires x >= 0 and y != 0 = if x < y and y < 10 or x == 7 then x + 1 else x - y\n" + "fn tb2(a: int, b: int) -> bool = a <= b\n" + "fn tb3(a: int, b: int) -> int = if 1 == 1 then a else b\n" + "fn tb4(flag: bool, n: int) -> int = if flag then (if n then 1 else 2) else 3\n" + "fn tb5(a: int, b: int) -> int = (if a < b then 1 else 0) + (if a == b or a > 5 then 10 else 20)\n" + "fn tb6(a: int, b: int) -> bool = a < b and b < 100 or a == 7\n" + "fn tb7(a: int, b: int) -> int = if (a < b) == (b < 9) then 1 else 0\n" + "fn tb8(a: int, b: int) -> int = if 0 == 1 and a < b then 1 else 2\n" + "fn tb9(a: int, b: int) -> int = if a >= 1000000000000 or b == a then 9 else 0\n"
## {f, n: conditions of the lowered AST, counted by hand from the source above}
fn tb_fns() = Cons({f: "tb1", n: 5}, Cons({f: "tb2", n: 1}, Cons({f: "tb3", n: 1}, Cons({f: "tb4", n: 2}, Cons({f: "tb5", n: 3}, Cons({f: "tb6", n: 3}, Cons({f: "tb7", n: 3}, Cons({f: "tb8", n: 2}, Cons({f: "tb9", n: 2}, Nil)))))))))
fn tb_source() = tb_fixture() + "fn argi(k: int) -> int = let s = os_arg_at(k) in if count(s) > 0 and at(s, 0) == \"-\" then 0 - toint(slice(s, 1, count(s))) else toint(s)\nfn pick(f: str, a: int, b: int) -> int = if f == \"tb1\" then tb1(a, b) else if f == \"tb2\" then (if tb2(a, b) then 1 else 0) else if f == \"tb3\" then tb3(a, b) else if f == \"tb4\" then tb4(a == 1, b) else if f == \"tb5\" then tb5(a, b) else if f == \"tb6\" then (if tb6(a, b) then 1 else 0) else if f == \"tb7\" then tb7(a, b) else if f == \"tb8\" then tb8(a, b) else tb9(a, b)\nprint pick(os_arg_at(1), argi(2), argi(3))\n"
fn tb_xs() = Cons(0, Cons(1, Cons(7, Cons(0 - 3, Cons(6, Cons(1000000000000, Cons(4611686018427387904, Nil)))))))
fn tb_ys() = Cons(0, Cons(1, Cons(9, Cons(10, Cons(0 - 2, Cons(100, Cons(4611686018427387904, Nil)))))))
fn tb_beh_y(elf, f, x, ys, out) = match ys
    Nil        => ""
    Cons(y, t) => let r = tg_run(elf, Cons(f, Cons(tg_arg(x), Cons(tg_arg(y), Nil))), out, 10000) in str(r.status) + ":" + r.out + ":" + r.err + "|" + tb_beh_y(elf, f, x, t, out)
fn tb_beh(elf, f, xs, out) = match xs
    Nil        => ""
    Cons(x, t) => tb_beh_y(elf, f, x, tb_ys(), out) + tb_beh(elf, f, t, out)
fn tb_obj(out, f) = let i = tg_index(out, "{\"name\":\"" + f + "\"", 0) in if i < 0 then "" else let e = tg_index(out, "}", i) in if e < 0 then "" else slice(out, i, e)
fn tb_pos(out, fs) = match fs
    Nil        => ""
    Cons(h, t) => let o = tb_obj(out, h.f) in if tg_has(o, "\"status\":\"validated\"") == 0 or tg_has(o, "\"correlated\":true") == 0 then h.f + " is not validated and correlated: " + o else if tg_field(o, "ast_decisions") != h.n or tg_field(o, "object_decision_branches") != h.n then h.f + " has " + str(h.n) + " conditions in its source; ltv reports ast_decisions " + str(tg_field(o, "ast_decisions")) + " and object_decision_branches " + str(tg_field(o, "object_decision_branches")) else if h.f == "tb8" and tg_field(o, "unreachable_branches") < 1 then "the conditionals behind the constant-false condition of tb8 are not reported as unreachable: " + o else if h.f != "tb8" and tg_field(o, "unreachable_branches") != 0 then h.f + " reports unreachable conditionals: " + o else tb_pos(out, t)
fn tb_sum(fs) = match fs
    Nil        => 0
    Cons(h, t) => h.n + tb_sum(t)
fn tb_m(cls, keep, ls) = {cls: cls, keep: keep, ls: ls}
fn tb_mn(l) = let t = slice(l, 4, count(l)) in let sp = tg_index(t, " ", 0) in if sp < 0 then t else slice(t, 0, sp)
fn tb_arg(l) = let t = slice(l, 4, count(l)) in let sp = tg_index(t, " ", 0) in if sp < 0 then "" else slice(t, sp + 1, count(t))
fn tb_inv(m) = if m == "jl" then "jge" else if m == "jge" then "jl" else if m == "jg" then "jle" else if m == "jle" then "jg" else if m == "je" then "jne" else if m == "jne" then "je" else ""
fn tb_add(l, i) = tb_m("bc-add", 1, Cons(l, Cons("    je .Ltb_a" + str(i), Cons(".Ltb_a" + str(i) + ":", Nil))))
fn tb_muts(l, i) = if count(l) < 6 or tg_starts(l, "    ") == 0 then Nil else let m = tb_mn(l) in let a = tb_arg(l) in if tb_inv(m) != "" then Cons(tb_m("bc-duplicate", 1, Cons(l, Cons(l, Nil))), Cons(tb_m("bc-invert-keep", 1, Cons("    " + tb_inv(m) + " .Ltb_i" + str(i), Cons("    jmp " + a, Cons(".Ltb_i" + str(i) + ":", Nil)))), Cons(tb_m("bc-invert", 0, Cons("    " + tb_inv(m) + " " + a, Nil)), Cons(tb_m("bc-remove", 0, Nil), Nil)))) else if tg_starts(m, "set") == 1 then Cons(tb_m("bc-duplicate", 1, Cons(l, Cons(l, Nil))), Cons(tb_add(l, i), Nil)) else if m == "cmpq" then Cons(tb_add(l, i), Nil) else Nil
fn tb_line_muts(ms, before_rev, l, after, i) = match ms
    Nil        => Nil
    Cons(m, t) => Cons({cls: m.cls, keep: m.keep, at: i, was: l, now: m.ls, ls: tg_revacc(before_rev, tg_app(m.ls, after))}, tb_line_muts(t, before_rev, l, after, i))
fn tb_fn_muts(before_rev, ls, i) = match ls
    Nil        => Nil
    Cons(l, t) => tg_app(tb_line_muts(tb_muts(l, i), before_rev, l, t, i), tb_fn_muts(Cons(l, before_rev), t, i + 1))
fn tb_show(ls) = match ls
    Nil        => "<deleted>"
    Cons(h, t) => h + tb_show2(t)
fn tb_show2(t) = match t
    Nil        => ""
    Cons(h, r) => "; " + h + tb_show2(r)
## st = {err, n, same: same native behaviour, corr: rejected for the correlation, diff: behaviour differs, cls}
fn tb_st(st, err, dsame, dcorr, ddiff, cls) = {err: err, n: if err == "" then st.n + 1 else st.n, same: st.same + dsame, corr: st.corr + dcorr, diff: st.diff + ddiff, cls: cls}
fn tb_reason(out) = let k = "\"status\":\"rejected\",\"reason\":\"" in let i = tg_index(out, k, 0) in if i < 0 then "" else let e = tg_index(out, "\"", i + count(k)) in if e < 0 then "" else slice(out, i + count(k), e)
fn tb_mutant(cfg, f, pre, post, m, base, st) = let sp = cfg.tmp + "/b.s" in let w = fs_write_sync(sp, pre + tg_join(tg_unlines(m.ls)) + post) in let a = tg_run(cfg.lasm, Cons("--strict", Cons(sp, Nil)), cfg.tmp + "/b.elf", 120000) in let wi = fs_write_sync(cfg.tmp + "/b.tv.in", "@root " + cfg.root + "\n@src " + cfg.tmp + "/tbfix.src\n@asm " + sp + "\n@fn " + f + "\n@out " + cfg.tmp + "/proofs\n") in let v = tg_input(cfg.ltv, Nil, cfg.tmp + "/b.tv.in", cfg.tmp + "/b.tv", 120000) in let rejected = if v.status != 0 and tg_has(v.out, "\"name\":\"" + f + "\",\"status\":\"rejected\"") == 1 and tg_has(v.out, "\"correlated\":false") == 1 then 1 else 0 in let why = tb_reason(v.out) in let corr = if rejected == 1 and tg_starts(why, "branch correlation: ") == 1 and tg_field(v.out, "uncorrelated") == 1 then 1 else 0 in let what = f + " line " + str(m.at) + " [" + m.cls + "]: `" + m.was + "` -> `" + tb_show(m.now) + "`" in if a.status != 0 then tb_st(st, "the branch mutant does not assemble: " + what + ": " + a.err, 0, 0, 0, st.cls) else if rejected == 0 then tb_st(st, "UNCORRELATED CODE ACCEPTED: ltv did not reject " + what + ": status " + str(v.status) + " " + v.out + v.err, 0, 0, 0, st.cls) else let ch = os_run("/bin/chmod", Cons("+x", Cons(cfg.tmp + "/b.elf", Nil))) in let same = if tb_beh(cfg.tmp + "/b.elf", f, tb_xs(), cfg.tmp + "/b.run") == base then 1 else 0 in if m.keep == 1 and same == 0 then tb_st(st, "a mutant that keeps the values by construction changed the native behaviour: " + what, 0, 0, 0, st.cls) else if m.keep == 1 and corr == 0 then tb_st(st, "a mutant that only changes the branch structure was rejected for another reason than the branch correlation (`" + why + "`): " + what, 0, 0, 0, st.cls) else tb_st(st, "", same, corr, 1 - same, tg_cls_add(st.cls, if same == 1 and corr == 1 then m.cls + "/same-values-uncorrelated" else if same == 1 then m.cls + "/same-values" else m.cls + "/values-differ"))
fn tb_mutants(cfg, f, pre, post, ms, k, base, st) = match ms
    Nil        => st
    Cons(m, t) => if st.err != "" then st else if k % cfg.stride != 0 then tb_mutants(cfg, f, pre, post, t, k + 1, base, st) else tb_mutants(cfg, f, pre, post, t, k + 1, base, tb_mutant(cfg, f, pre, post, m, base, st))
fn tb_fn(cfg, asm, f, st) = let n = count(asm) in let b = tg_fn_start(asm, n, 0, f + ":") in if b < 0 then tb_st(st, "branch fixture function " + f + " is missing from the assembly", 0, 0, 0, st.cls) else let e = tg_fn_end(asm, n, b) in tb_mutants(cfg, f, slicen(asm, n, 0, b), slicen(asm, n, e, n), tb_fn_muts(Nil, tg_lines(asm, e, b), 0), 0, tb_beh(cfg.tmp + "/tbfix.elf", f, tb_xs(), cfg.tmp + "/bbase.run"), st)
fn tb_each(cfg, asm, fs, st) = match fs
    Nil        => st
    Cons(h, t) => if st.err != "" then st else tb_each(cfg, asm, t, tb_fn(cfg, asm, h.f, st))
fn tb_fail(msg) = {err: msg, n: 0, same: 0, corr: 0, diff: 0, cls: Nil, conds: 0}
fn tb_all(cfg) = let w = fs_write_sync(cfg.tmp + "/tbfix.src", tb_source()) in let c = tg_input(cfg.root + "/build/bin/lumec", Nil, cfg.tmp + "/tbfix.src", cfg.tmp + "/tbfix.s", 120000) in if c.status != 0 then tb_fail("lumec rejected the branch fixture: " + c.err) else let a = tg_run(cfg.lasm, Cons("--strict", Cons(cfg.tmp + "/tbfix.s", Nil)), cfg.tmp + "/tbfix.elf", 120000) in if a.status != 0 then tb_fail("lasm rejected the branch fixture: " + a.err) else let ch = os_run("/bin/chmod", Cons("+x", Cons(cfg.tmp + "/tbfix.elf", Nil))) in let w1 = fs_write_sync(cfg.tmp + "/tbpos.in", "@root " + cfg.root + "\n@src " + cfg.tmp + "/tbfix.src\n@asm " + cfg.tmp + "/tbfix.s\n@out " + cfg.tmp + "/proofs\n@exec 1\n") in let p = tg_input(cfg.ltv, Nil, cfg.tmp + "/tbpos.in", cfg.tmp + "/tbpos.out", 600000) in if p.status != 0 or tg_field(p.out, "rejected") != 0 then tb_fail("ltv did not validate the branch fixture: " + p.out + p.err) else let pos = tb_pos(p.out, tb_fns()) in if pos != "" then tb_fail(pos) else if tg_has(p.out, "\"branch_correlation\":{\"functions\":") == 0 or tg_field(p.out, "uncorrelated") != 0 then tb_fail("the report of the branch fixture has no clean branch_correlation totals: " + p.out) else let asm = fs_read_file(cfg.tmp + "/tbfix.s") in let st = tb_each(cfg, asm, tb_fns(), {err: "", n: 0, same: 0, corr: 0, diff: 0, cls: Nil}) in if st.err != "" then tb_fail(st.err + "\n  mutant assembly kept at " + cfg.tmp + "/b.s") else let lack = if cfg.stride == 1 then tg_need(st.cls, Cons("bc-duplicate/same-values-uncorrelated", Cons("bc-invert-keep/same-values-uncorrelated", Cons("bc-add/same-values-uncorrelated", Cons("bc-remove/same-values-uncorrelated", Cons("bc-remove/values-differ", Cons("bc-invert/values-differ", Nil))))))) else "" in if lack != "" then tb_fail("branch mutation class " + lack + " is empty, so it proves nothing") else if cfg.stride == 1 and st.n < 100 then tb_fail("only " + str(st.n) + " branch mutants; the campaign is too small to mean anything") else {err: "", n: st.n, same: st.same, corr: st.corr, diff: st.diff, cls: st.cls, conds: tb_sum(tb_fns())}
## the hub fields of a full-module report: helpers of the same assembly verified, every certificate checked natively
fn tg_hub(out, what) = let nv = tg_field(out, "validated") in if tg_has(out, "\"runtime_helpers\":\"verified\"") == 0 or tg_field(out, "runtime_helpers_verified") != 18 or tg_field(out, "runtime_helper_obligations") < 100 then "the ltv report of " + what + " does not show the 18 integer runtime helpers of its assembly verified" else if tg_field(out, "smt2_checked_native") != nv or nv < 1 then "the ltv report of " + what + " counts " + str(tg_field(out, "smt2_checked_native")) + " native certificate checks for " + str(nv) + " validated functions" else if tg_has(out, "\"external_solver\":\"none installed\"") == 0 and tg_field(out, "smt2_checked_external") != nv then "the ltv report of " + what + " names an external solver but counts " + str(tg_field(out, "smt2_checked_external")) + " external checks for " + str(nv) + " validated functions" else if tg_field(out, "uncorrelated") != 0 or tg_has(out, "\"branch_correlation\":{") == 0 then "the ltv report of " + what + " has uncorrelated functions" else ""
fn tg_main(input) = let root = tg_get(input, "root") in if root == "" then ctfail("tv gate requires @root\n") else let tmp = tg_or(tg_get(input, "tmp"), "/tmp/lume-tv-gate." + str(os_getpid())) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp + "/proofs", Nil))) in let cfg = {root: root, tmp: tmp, lasm: root + "/build/bin/lasm", ltv: root + "/build/bin/ltv", stride: toint(tg_or(tg_get(input, "stride"), "1")), nlines: 0, ext: Nil, extbase: ""} in let vs = tg_vecs() in let w = fs_write_sync(tmp + "/fixture.src", tg_source()) in let c = tg_input(root + "/build/bin/lumec", Nil, tmp + "/fixture.src", tmp + "/fixture.s", 120000) in if c.status != 0 then ctfail("tv gate failed: lumec rejected the fixture: " + c.err + "\n") else let a = tg_run(cfg.lasm, Cons("--strict", Cons(tmp + "/fixture.s", Nil)), tmp + "/fixture.elf", 120000) in if a.status != 0 then ctfail("tv gate failed: lasm rejected the fixture: " + a.err + "\n") else let ch = os_run("/bin/chmod", Cons("+x", Cons(tmp + "/fixture.elf", Nil))) in let w1 = fs_write_sync(tmp + "/pos.in", "@root " + root + "\n@src " + tmp + "/fixture.src\n@asm " + tmp + "/fixture.s\n@out " + tmp + "/proofs\n@exec 1\n") in let p1 = tg_input(cfg.ltv, Nil, tmp + "/pos.in", tmp + "/pos.out", 600000) in let miss = tg_all_validated(p1.out, tg_fnames()) in if p1.status != 0 or miss != "" then ctfail("tv gate failed: ltv did not validate the unmutated fixture (" + miss + "): " + p1.out + p1.err + "\n") else if tg_field(p1.out, "native_vectors") < 40 then ctfail("tv gate failed: the native boundary run of the fixture covered only " + str(tg_field(p1.out, "native_vectors")) + " vectors\n") else let w2 = fs_write_sync(tmp + "/std.in", "@root " + root + "\n@src " + root + "/compiler/stage1/lstd.src\n@out " + root + "/build/certification/proofs\n@exec 1\n") in let p2 = tg_input(cfg.ltv, Nil, tmp + "/std.in", tmp + "/std.out", 600000) in if p2.status != 0 or tg_field(p2.out, "validated") < 30 or tg_field(p2.out, "rejected") != 0 or tg_field(p2.out, "native_vectors") < 200 then ctfail("tv gate failed: ltv on compiler/stage1/lstd.src: " + p2.out + p2.err + "\n") else let hub = tg_hub(p1.out, "the fixture") + tg_hub(p2.out, "compiler/stage1/lstd.src") in if hub != "" then ctfail("tv gate failed: " + hub + "\n") else let bc = tb_all(cfg) in if bc.err != "" then ctfail("tv gate failed: branch correlation: " + bc.err + "\n") else let ct = tg_ct(cfg) in if ct != "" then ctfail("tv gate failed: [C0010] machine constant-time check: " + ct + "\n") else let kt = tk_all(cfg) in if kt.err != "" then ctfail("tv gate failed: constant-time kernels: " + kt.err + "\n") else let asm = fs_read_file(tmp + "/fixture.s") in let st = tg_fns(cfg, asm, tg_fnames(), vs, {err: "", n: 0, killed: 0, rej_killed: 0, eq_rej: 0, eq_acc: 0, noasm: 0, cls: Nil, log: Nil}) in if st.err != "" then ctfail("tv gate failed: " + st.err + "\n  mutant assembly kept at " + tmp + "/m.s\n") else let lack = if cfg.stride == 1 then tg_need(st.cls, Cons("arith-swap", Cons("slot-shift", Cons("setcc-swap", Cons("jcc-swap", Cons("reg-swap", Cons("immediate", Cons("rsp-unbalance", Cons("call-swap", Cons("delete", Nil)))))))))) else "" in if lack != "" then ctfail("tv gate failed: mutation class " + lack + " produced no behaviour-changing mutant, so it proves nothing\n") else if cfg.stride == 1 and st.killed < 300 then ctfail("tv gate failed: only " + str(st.killed) + " behaviour-changing mutants; the campaign is too small to mean anything\n") else let lg = fs_write_sync(root + "/build/certification/tv_gate_equivalent_mutants.txt", "Mutants that ltv accepted and that behave exactly like the original (exit status, stdout, stderr) on every base vector and on 48 extended vectors per function, boxed 64-bit values included. Listed for audit:\n" + tg_join(st.log) + "Constant-time kernel mutants that ltv accepted and that behave exactly like the original on every base vector (boxed arguments included) and on 40 extended vectors per kernel:\n" + tg_join(kt.log)) in let rm = os_run("/bin/rm", Cons("-rf", Cons(tmp, Nil))) in "OK: ltv validated " + str(tg_len(tg_fnames())) + "/" + str(tg_len(tg_fnames())) + " fixture functions and " + str(tg_field(p2.out, "validated")) + " functions of lstd.src (native boundary vectors agreeing with the real machine: " + str(tg_field(p1.out, "native_vectors")) + " + " + str(tg_field(p2.out, "native_vectors")) + "); " + str(st.n) + " codegen mutants over " + str(tg_len(vs)) + " vectors: " + str(st.killed) + " change native behaviour and ltv rejected " + str(st.rej_killed) + "/" + str(st.killed) + " of them (0 unsound acceptances) [" + tg_cls_show(st.cls) + "]; behaviour-identical mutants: " + str(st.eq_rej) + " rejected anyway, " + str(st.eq_acc) + " accepted as equivalent after 48 extended vectors each; " + str(st.noasm) + " not assemblable; [C0010] machine constant-time, closed over calls: 1 constant-time kernel validated, 2 plain @secret functions rejected (own tag-test branch; runtime helper reached by call, chain named) and 3 injected leaks (branch, memory access, division) rejected; constant-time kernels: " + str(tg_len(tk_names())) + "/" + str(tg_len(tk_names())) + " validated (ChaCha20 add / xor-rotate / quarter round, Poly1305 clamp / row / carry, X25519 cswap, tag compare; no jump, no division, no non-kernel call in their code; " + str(kt.nat) + " native boundary vectors agreeing), 12 negative controls rejected (branch, guard removed / weakened / parameter dropped, mkint and addv reached by call, memory index, division, indirect call, undefined symbol, leak in a callee, wrong callee), " + str(kt.n) + " kernel mutants: " + str(kt.killed) + " change native behaviour and ltv rejected " + str(kt.rej_killed) + "/" + str(kt.killed) + " of them (0 unsound acceptances) [" + tg_cls_show(kt.cls) + "]; behaviour-identical kernel mutants: " + str(kt.eq_rej) + " rejected anyway, " + str(kt.eq_acc) + " accepted as equivalent; " + str(kt.noasm) + " not assemblable; hub: every run verified the 18 integer runtime helpers of its own assembly and re-checked its certificates natively; branch correlation: " + str(tg_len(tb_fns())) + " fixture functions with " + str(bc.conds) + " conditions correlated one-to-one, " + str(bc.n) + " branch mutants all rejected (" + str(bc.same) + " keep the native behaviour on every vector, " + str(bc.corr) + " rejected for the correlation, " + str(bc.diff) + " change behaviour) [" + tg_cls_show(bc.cls) + "]"

print tg_main(readall())
