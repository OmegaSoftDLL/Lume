## dwarf_cache_gate.src -- 100% Native Lume Gate for ELF64 DWARF v4 Debug Info & <30ms Incremental Proof Cache.
##
## Usage:
##   printf '@root %s\n' "$PWD" | ./build/bin/dwarf_cache_gate
##
## Verifies:
##   1. `lumec --emit-asm --dwarf <path.src> <path.src>` + `lasm --strict` emits valid ELF64 DWARF v4
##      sections (`.debug_abbrev`, `.debug_info`, `.debug_line`, `.symtab`, `.strtab`), preserves
##      runtime execution, and maps symbol/code addresses back to exact `.src` line numbers via both
##      `readelf --debug-dump=decodedline` and `nm` + `addr2line -f -e`.
##   2. `build/bin/lproof_cache` (and `lproof_cache.src`) on a 20-function verified `.src` module:
##      cold `store` -> warm `check` (`20/20` hits) and 1-function edit (`19/20` hits) in `< 30 ms`
##      monotonic wall-clock, comment/whitespace invariance, deterministic `ensures` & callee-`ensures`
##      invalidation, false-contract store refusal (`[PC0003]`), and fail-closed `.cert` tamper
##      rejection (`[PC0002]`).

use lproof_cache

fn dcg_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128

fn dcg_chomp(s) = let n = count(s) in if n == 0 then "" else let c = at(s, n - 1) in if c == "\n" or c == "\r" or c == " " or c == "\t" then dcg_chomp(slice(s, 0, n - 1)) else s

fn dcg_root_from_input(input) = let line = pc_nth_str(pc_lines(input), 0) in let r = if pc_starts_with(line, "@root ") == 1 then dcg_chomp(slice(line, 6, count(line))) else dcg_chomp(line) in if r != "" then r else if fs_path_exists("build/bin/lumec") == 1 then "." else if fs_path_exists("../build/bin/lumec") == 1 then ".." else ""

fn dcg_run(bin, args, out, ms) = let raw = os_run_capture_timeout(bin, args, out, out + ".err", ms) in {status: dcg_wait_exit(raw), tmo: os_last_timed_out(), out: fs_read_file(out), err: fs_read_file(out + ".err")}

fn dcg_run_in(bin, args, inp, out, ms) = let raw = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", ms) in {status: dcg_wait_exit(raw), tmo: os_last_timed_out(), out: fs_read_file(out), err: fs_read_file(out + ".err")}

## --- Part 1: ELF64 DWARF v4 Emission & Exact Source-Line Roundtrip ----------------------------

fn dcg_dwarf_fixture_src() = "## Line 1: DWARF v4 multi-function verification fixture\n" + "## Line 2: spacer\n" + "fn dw_scale(x: int) -> int\n" + "    requires x >= 0\n" + "    ensures result >= 1\n" + "= x * 3 + 1\n" + "## Line 7: spacer\n" + "fn dw_combine(a: int, b: int) -> int\n" + "    requires a >= 0 and b >= 0\n" + "    ensures result >= 1\n" + "= dw_scale(a) + b\n" + "## Line 12: spacer\n" + "fn dw_pipeline(n: int) -> int\n" + "    requires n >= 1\n" + "    ensures result >= 4\n" + "= dw_combine(n, n + 1)\n" + "## Line 17: spacer\n" + "print dw_pipeline(10)\n"

fn dcg_nm_addr_lines(lines, sym) = match lines
    Nil        => ""
    Cons(h, t) => let suffix = " " + sym in if pc_ends_with(h, suffix) == 1 and count(h) >= 16 then let sp = pc_line_space(h, 0, count(h)) in if sp > 0 then slice(h, 0, sp) else dcg_nm_addr_lines(t, sym) else dcg_nm_addr_lines(t, sym)

fn pc_line_space(s, i, n) = if i >= n or at(s, i) == " " or at(s, i) == "\t" then i else pc_line_space(s, i + 1, n)

fn dcg_prepare_lasm(root, tmp) = let prebuilt = root + "/build/bin/lasm" in let probe_s = tmp + "/dw_probe.s" in let probe_e = tmp + "/dw_probe.elf" in let pw = fs_write_sync(probe_s, "    .file 1 \"probe.src\"\n    .section .text\n_start:\n    .loc 1 1 0\n    ret\n") in let pr = dcg_run_in(prebuilt, Cons("--strict", Nil), probe_s, probe_e, 30000) in if pw == 1 and pr.status == 0 then {err: "", bin: prebuilt} else let fresh = tmp + "/lasm" in let bld = dcg_run(root + "/build/bin/lume_driver", Cons("build", Cons(root + "/compiler/stage1/lasm.src", Cons("-o", Cons(fresh, Nil)))), tmp + "/lasm_build.out", 180000) in if bld.status != 0 or bld.tmo == 1 then {err: "cannot build fresh lasm from compiler/stage1/lasm.src: " + bld.err, bin: ""} else {err: "", bin: fresh}

fn dcg_test_dwarf_v4(root, tmp) = let lumec = root + "/build/bin/lumec" in let lasm_prep = dcg_prepare_lasm(root, tmp) in if lasm_prep.err != "" then {err: lasm_prep.err, summary: ""} else let lasm = lasm_prep.bin in let src = tmp + "/dw_prog.src" in let asm = tmp + "/dw_prog.s" in let elf = tmp + "/dw_prog.elf" in if fs_write_sync(src, dcg_dwarf_fixture_src()) != 1 then {err: "cannot write DWARF fixture source", summary: ""} else let comp = dcg_run_in(lumec, Cons("--emit-asm", Cons("--dwarf", Cons(src, Cons(src, Nil)))), src, asm, 120000) in if comp.status != 0 or comp.tmo == 1 then {err: "lumec --emit-asm --dwarf failed: " + comp.err, summary: ""} else let asm_txt = fs_read_file(asm) in if pc_contains(asm_txt, ".file 1 \"" + src + "\"") == 0 or pc_contains(asm_txt, ".loc 1 3 0") == 0 or pc_contains(asm_txt, ".loc 1 8 0") == 0 or pc_contains(asm_txt, ".loc 1 13 0") == 0 or pc_contains(asm_txt, ".loc 1 18 0") == 0 then {err: "lumec --dwarf assembly missing expected .file/.loc directives", summary: ""} else let asmb = dcg_run_in(lasm, Cons("--strict", Nil), asm, elf, 120000) in if asmb.status != 0 or asmb.tmo == 1 then {err: "lasm --strict failed on DWARF assembly: " + asmb.err, summary: ""} else let chm = os_run("/bin/chmod", Cons("+x", Cons(elf, Nil))) in let run_res = dcg_run(elf, Nil, tmp + "/dw_run.out", 30000) in if run_res.status != 0 or run_res.out != "42\n" then {err: "DWARF ELF64 execution failed: status=" + str(run_res.status) + " out=" + run_res.out + " err=" + run_res.err, summary: ""} else dcg_verify_dwarf_tools(lumec, lasm, src, elf, tmp)

fn dcg_verify_dwarf_tools(lumec, lasm, src, elf, tmp) = let secs = dcg_run("/usr/bin/readelf", Cons("-S", Cons(elf, Nil)), tmp + "/dw_secs.out", 30000) in if secs.status != 0 then {err: "readelf -S failed: " + secs.err, summary: ""} else if pc_contains(secs.out, ".debug_info") == 0 or pc_contains(secs.out, ".debug_line") == 0 or pc_contains(secs.out, ".debug_abbrev") == 0 or pc_contains(secs.out, ".symtab") == 0 or pc_contains(secs.out, ".strtab") == 0 then {err: "ELF64 missing required DWARF v4 / symbol sections:\n" + secs.out, summary: ""} else let info = dcg_run("/usr/bin/readelf", Cons("--debug-dump=info", Cons(elf, Nil)), tmp + "/dw_info.out", 30000) in if info.status != 0 or pc_contains(info.out, "DW_TAG_compile_unit") == 0 or pc_contains(info.out, "DW_TAG_subprogram") == 0 or pc_contains(info.out, "dw_scale") == 0 or pc_contains(info.out, "dw_combine") == 0 or pc_contains(info.out, "dw_pipeline") == 0 then {err: "readelf --debug-dump=info missing DWARF v4 compile_unit or subprograms:\n" + info.out, summary: ""} else let dline = dcg_run("/usr/bin/readelf", Cons("--debug-dump=decodedline", Cons(elf, Nil)), tmp + "/dw_line.out", 30000) in if dline.status != 0 or pc_contains(dline.out, "dw_prog.src") == 0 or pc_contains(dline.out, "3") == 0 or pc_contains(dline.out, "8") == 0 or pc_contains(dline.out, "13") == 0 or pc_contains(dline.out, "18") == 0 then {err: "readelf --debug-dump=decodedline missing source line mappings:\n" + dline.out, summary: ""} else let nm_res = dcg_run("/usr/bin/nm", Cons(elf, Nil), tmp + "/dw_nm.out", 30000) in if nm_res.status != 0 then {err: "nm failed on DWARF ELF64: " + nm_res.err, summary: ""} else let nlines = pc_lines(nm_res.out) in let a_scale = dcg_nm_addr_lines(nlines, "dw_scale") in let a_comb = dcg_nm_addr_lines(nlines, "dw_combine") in let a_pipe = dcg_nm_addr_lines(nlines, "dw_pipeline") in let a_start = dcg_nm_addr_lines(nlines, "_start") in if a_scale == "" or a_comb == "" or a_pipe == "" or a_start == "" then {err: "nm .symtab missing function symbols:\n" + nm_res.out, summary: ""} else let a2l = dcg_run("/usr/bin/addr2line", Cons("-f", Cons("-e", Cons(elf, Cons("0x" + a_scale, Cons("0x" + a_comb, Cons("0x" + a_pipe, Cons("0x" + a_start, Nil))))))), tmp + "/dw_a2l.out", 30000) in if a2l.status != 0 or pc_contains(a2l.out, "dw_prog.src:3") == 0 or pc_contains(a2l.out, "dw_prog.src:8") == 0 or pc_contains(a2l.out, "dw_prog.src:13") == 0 or pc_contains(a2l.out, "dw_prog.src:18") == 0 then {err: "addr2line did not map symbol addresses back to exact .src lines 3, 8, 13, 18:\n" + a2l.out + a2l.err, summary: ""} else dcg_verify_dwarf_negative_control(lumec, lasm, src, tmp, a_scale, a_comb, a_pipe)

fn dcg_verify_dwarf_negative_control(lumec, lasm, src, tmp, a_scale, a_comb, a_pipe) = let plain_asm = tmp + "/dw_plain.s" in let plain_elf = tmp + "/dw_plain.elf" in let c0 = dcg_run_in(lumec, Cons("--emit-asm", Nil), src, plain_asm, 120000) in let a0 = dcg_run_in(lasm, Cons("--strict", Nil), plain_asm, plain_elf, 120000) in let s0 = dcg_run("/usr/bin/readelf", Cons("-S", Cons(plain_elf, Nil)), tmp + "/dw_plain_secs.out", 30000) in if c0.status != 0 or a0.status != 0 then {err: "plain non-DWARF control build failed", summary: ""} else if pc_contains(s0.out, ".debug_info") == 1 or pc_contains(s0.out, ".debug_line") == 1 then {err: "non-DWARF build unexpectedly emitted .debug_info/.debug_line sections", summary: ""} else {err: "", summary: "DWARF v4 verified (.debug_abbrev/.debug_info/.debug_line/.symtab/.strtab, dw_scale@0x" + a_scale + "->L3, dw_combine@0x" + a_comb + "->L8, dw_pipeline@0x" + a_pipe + "->L13)"}

## --- Part 2: 20-Function Incremental Proof Cache (< 30 ms) & Soundness/Tamper Gate ------------

fn dcg_pad2(n) = if n < 10 then "0" + str(n) else str(n)

fn dcg_gen_fn(i, body_bonus_19, ens_05_delta, ens_19_delta) = let nm = "vf_" + dcg_pad2(i) in if i == 5 then let k5 = 5 + ens_05_delta in "fn " + nm + "(x: int) -> int requires x >= 0 ensures result >= x + " + str(k5) + " = x + 5\n" else if i == 19 then let b19 = 19 + body_bonus_19 in let e19 = 19 + ens_19_delta in "fn " + nm + "(x: int) -> int requires x >= 0 ensures result >= x + " + str(e19) + " = x + " + str(b19) + "\n" else if i == 20 then "fn " + nm + "(y: int) -> int requires y >= 0 ensures result >= 19 = vf_19(y)\n" else "fn " + nm + "(x: int) -> int requires x >= 0 ensures result >= x + " + str(i) + " = x + " + str(i) + "\n"

fn dcg_gen_mod20_loop(i, body_bonus_19, ens_05_delta, ens_19_delta, acc) = if i > 20 then pc_joinall(pc_rev(Cons("print vf_20(1)\n", acc))) else dcg_gen_mod20_loop(i + 1, body_bonus_19, ens_05_delta, ens_19_delta, Cons(dcg_gen_fn(i, body_bonus_19, ens_05_delta, ens_19_delta), acc))

fn dcg_gen_mod20(body_bonus_19, ens_05_delta, ens_19_delta) = dcg_gen_mod20_loop(1, body_bonus_19, ens_05_delta, ens_19_delta, Nil)

fn dcg_count_certs_loop(entries, n) = match entries
    Nil        => n
    Cons(h, t) => dcg_count_certs_loop(t, if pc_ends_with(h, ".cert") == 1 then n + 1 else n)

fn dcg_first_cert(entries) = match entries
    Nil        => ""
    Cons(h, t) => if pc_ends_with(h, ".cert") == 1 then h else dcg_first_cert(t)

fn dcg_flip_last_hex(cert_txt) = let n = count(cert_txt) in if n < 4 then "corrupt" else let last_ch = at(cert_txt, n - 2) in let repl = if last_ch == "a" then "b" else "a" in slice(cert_txt, 0, n - 2) + repl + "\n"

fn dcg_test_proof_cache(root, fast_tmp) = let lpc = root + "/build/bin/lproof_cache" in if fs_path_exists(lpc) != 1 then {err: "missing build/bin/lproof_cache binary", summary: ""} else let mod_src = fast_tmp + "/verified20.src" in let cdir = fast_tmp + "/.lume_cache" in let pdir = cdir + "/proofs" in let base_code = dcg_gen_mod20(0, 0, 0) in if fs_write_sync(mod_src, base_code) != 1 then {err: "cannot write 20-function module", summary: ""} else let st_cold = dcg_run(lpc, Cons("store", Cons(mod_src, Cons(cdir, Nil))), fast_tmp + "/st_cold.out", 120000) in if st_cold.status != 0 or pc_contains(st_cold.out, "\"total\":20") == 0 or pc_contains(st_cold.out, "\"stored\":20") == 0 or pc_contains(st_cold.out, "\"reused\":0") == 0 then {err: "cold lproof_cache store failed: " + st_cold.out + st_cold.err, summary: ""} else let cert_cnt = dcg_count_certs_loop(pc_lines(fs_read_dir(pdir)), 0) in if cert_cnt != 20 then {err: "expected 20 .cert files in .lume_cache/proofs, got " + str(cert_cnt), summary: ""} else dcg_test_proof_cache_warm_and_mutations(lpc, mod_src, cdir, pdir, fast_tmp, base_code)

fn dcg_run_fast(bin, args, out) = let raw = os_run_capture(bin, args, out, out + ".err") in {status: dcg_wait_exit(raw), out: fs_read_file(out), err: fs_read_file(out + ".err")}

fn dcg_test_proof_cache_warm_and_mutations(lpc, mod_src, cdir, pdir, fast_tmp, base_code) =
    ## Warm check #1: 0 functions changed -> 20/20 hits in < 30 ms monotonic wall-clock
    let t0_w20 = os_monotonic_ns() in
    let ck20_lib = pc_check_file(mod_src, cdir) in
    let t1_w20 = os_monotonic_ns() in
    let w20_lib_ns = t1_w20 - t0_w20 in
    let t0_cli20 = os_monotonic_ns() in
    let ck20_cli = dcg_run_fast(lpc, Cons("check", Cons(mod_src, Cons(cdir, Cons("--require-all-hits", Nil)))), fast_tmp + "/ck20.out") in
    let t1_cli20 = os_monotonic_ns() in
    let w20_cli_ns = t1_cli20 - t0_cli20 in
    if ck20_lib.ok != 1 or ck20_lib.hits != 20 or ck20_lib.misses != 0 then
        {err: "warm 20/20 library check failed: " + ck20_lib.err, summary: ""}
    else if ck20_cli.status != 0 or pc_contains(ck20_cli.out, "\"hits\":20") == 0 or pc_contains(ck20_cli.out, "\"misses\":0") == 0 then
        {err: "warm 20/20 CLI check failed: " + ck20_cli.out + ck20_cli.err, summary: ""}
    else if ck20_lib.elapsed_ns >= 30000000 or w20_lib_ns >= 30000000 or w20_cli_ns >= 30000000 then
        {err: "warm 20/20 check exceeded 30 ms budget: lib_ns=" + str(w20_lib_ns) + " cli_ns=" + str(w20_cli_ns), summary: ""}
    ## Comment / whitespace formatting edit -> still 20/20 hits
    else let fmt_w = fs_write_sync(mod_src, "## extra comment banner\n\n" + base_code + "\n") in
         let ck_fmt = dcg_run_fast(lpc, Cons("check", Cons(mod_src, Cons(cdir, Cons("--require-all-hits", Nil)))), fast_tmp + "/ck_fmt.out") in
         if fmt_w != 1 or ck_fmt.status != 0 or pc_contains(ck_fmt.out, "\"hits\":20") == 0 then
             {err: "comment/whitespace edit unexpectedly invalidated proof cache: " + ck_fmt.out + ck_fmt.err, summary: ""}
         ## 1-function body edit (vf_19 body x+19 -> x+20, contract unchanged) -> 19/20 hits in < 30 ms!
         else let mod_1fn = dcg_gen_mod20(1, 0, 0) in
              let w1 = fs_write_sync(mod_src, mod_1fn) in
              let t0_lib19 = os_monotonic_ns() in
              let ck19_lib = pc_check_file(mod_src, cdir) in
              let t1_lib19 = os_monotonic_ns() in
              let w19_lib_ns = t1_lib19 - t0_lib19 in
              let t0_cli19 = os_monotonic_ns() in
              let ck19_cli = dcg_run_fast(lpc, Cons("check", Cons(mod_src, Cons(cdir, Nil))), fast_tmp + "/ck19.out") in
              let t1_cli19 = os_monotonic_ns() in
              let w19_cli_ns = t1_cli19 - t0_cli19 in
              if w1 != 1 or ck19_lib.ok != 1 or ck19_lib.hits != 19 or ck19_lib.misses != 1 then
                  {err: "1-function edit expected 19/20 hits, got hits=" + str(ck19_lib.hits) + " misses=" + str(ck19_lib.misses), summary: ""}
              else if ck19_cli.status != 0 or pc_contains(ck19_cli.out, "\"hits\":19") == 0 or pc_contains(ck19_cli.out, "\"misses\":1") == 0 or pc_contains(ck19_cli.out, "\"vf_19\"") == 0 then
                  {err: "CLI 1-function edit check mismatch: " + ck19_cli.out + ck19_cli.err, summary: ""}
              else if ck19_lib.elapsed_ns >= 30000000 or w19_lib_ns >= 30000000 or w19_cli_ns >= 30000000 then
                  {err: "19/20 incremental hit check exceeded 30 ms budget: lib_ns=" + str(w19_lib_ns) + " cli_ns=" + str(w19_cli_ns), summary: ""}
              else dcg_test_contract_invalidation_and_tamper(lpc, mod_src, cdir, pdir, fast_tmp, base_code, w20_lib_ns, w20_cli_ns, w19_lib_ns, w19_cli_ns)

fn dcg_test_contract_invalidation_and_tamper(lpc, mod_src, cdir, pdir, fast_tmp, base_code, w20_lib_ns, w20_cli_ns, w19_lib_ns, w19_cli_ns) =
    ## Standalone `ensures` mutation on vf_05 -> deterministic 19/20 invalidation of vf_05
    let mod_ens05 = dcg_gen_mod20(0, 0 - 1, 0) in
    let we5 = fs_write_sync(mod_src, mod_ens05) in
    let ck_ens05 = dcg_run(lpc, Cons("check", Cons(mod_src, Cons(cdir, Nil))), fast_tmp + "/ck_ens05.out", 30000) in
    let ck_ens05_strict = dcg_run(lpc, Cons("check", Cons(mod_src, Cons(cdir, Cons("--require-all-hits", Nil)))), fast_tmp + "/ck_ens05_strict.out", 30000) in
    if we5 != 1 or ck_ens05.status != 0 or pc_contains(ck_ens05.out, "\"hits\":19") == 0 or pc_contains(ck_ens05.out, "\"misses\":1") == 0 or pc_contains(ck_ens05.out, "\"vf_05\"") == 0 or ck_ens05_strict.status == 0 then
        {err: "standalone ensures mutation did not deterministically invalidate vf_05: " + ck_ens05.out + ck_ens05.err, summary: ""}
    ## Callee `ensures` mutation on vf_19 (called by vf_20) -> MUST invalidate BOTH vf_19 AND caller vf_20 (18/20 hits, 2 misses)!
    else let mod_callee_ens = dcg_gen_mod20(1, 0, 1) in
         let we19 = fs_write_sync(mod_src, mod_callee_ens) in
         let ck_cal = dcg_run(lpc, Cons("check", Cons(mod_src, Cons(cdir, Nil))), fast_tmp + "/ck_callee.out", 30000) in
         if we19 != 1 or ck_cal.status != 0 or pc_contains(ck_cal.out, "\"hits\":18") == 0 or pc_contains(ck_cal.out, "\"misses\":2") == 0 or pc_contains(ck_cal.out, "\"vf_19\"") == 0 or pc_contains(ck_cal.out, "\"vf_20\"") == 0 then
             {err: "callee ensures mutation did not invalidate both callee vf_19 and caller vf_20: " + ck_cal.out + ck_cal.err, summary: ""}
         ## False contract store refusal ([PC0003]): lproof_cache store must refuse to cache a refuted contract
         else let false_mod = base_code + "fn vf_bad(x: int) -> int requires x >= 0 ensures result > x + 100 = x + 1\n" in
              let wf = fs_write_sync(mod_src, false_mod) in
              let st_false = dcg_run(lpc, Cons("store", Cons(mod_src, Cons(cdir, Nil))), fast_tmp + "/st_false.out", 120000) in
              if wf != 1 or st_false.status == 0 or pc_contains(st_false.err, "[PC0003]") == 0 then
                  {err: "lproof_cache store accepted a false/refuted contract instead of failing closed [PC0003]: " + st_false.out + st_false.err, summary: ""}
              ## Tamper fail-closed check ([PC0002]): flip 1 hex nibble in a `.cert` seal inside `.lume_cache/proofs/`
              else let wb = fs_write_sync(mod_src, base_code) in
                   let target_cert = dcg_first_cert(pc_lines(fs_read_dir(pdir))) in
                   if target_cert == "" then {err: "no .cert file found in proofs dir for tamper check", summary: ""}
                   else let cert_path = pdir + "/" + target_cert in
                        let orig_cert = fs_read_file(cert_path) in
                        let bad_cert = dcg_flip_last_hex(orig_cert) in
                        let wt = fs_write_sync(cert_path, bad_cert) in
                        let ck_tamp = dcg_run(lpc, Cons("check", Cons(mod_src, Cons(cdir, Nil))), fast_tmp + "/ck_tamp.out", 30000) in
                        let st_tamp = dcg_run(lpc, Cons("store", Cons(mod_src, Cons(cdir, Nil))), fast_tmp + "/st_tamp.out", 30000) in
                        let wrest = fs_write_sync(cert_path, orig_cert) in
                        let ck_restored = dcg_run(lpc, Cons("check", Cons(mod_src, Cons(cdir, Cons("--require-all-hits", Nil)))), fast_tmp + "/ck_rest.out", 30000) in
                        if wt != 1 or ck_tamp.status == 0 or pc_contains(ck_tamp.err, "[PC0002]") == 0 or st_tamp.status == 0 or pc_contains(st_tamp.err, "[PC0002]") == 0 then
                            {err: "tampered .cert in .lume_cache/proofs/ was NOT rejected fail-closed with [PC0002]: check_status=" + str(ck_tamp.status) + " err=" + ck_tamp.err, summary: ""}
                        else if wrest != 1 or ck_restored.status != 0 then
                            {err: "restored .cert failed post-tamper verification: " + ck_restored.err, summary: ""}
                        else let metrics = "proof-cache verified (20/20 warm hit: in-proc " + str(w20_lib_ns / 1000) + " us / CLI " + str(w20_cli_ns / 1000) + " us; 19/20 1-fn edit hit: in-proc " + str(w19_lib_ns / 1000) + " us / CLI " + str(w19_cli_ns / 1000) + " us, all < 30000 us; ensures + callee-ensures invalidation + [PC0003] false-theorem guard + [PC0002] fail-closed tamper rejection)" in
                             {err: "", summary: metrics}

fn dcg_main(root) = if root == "" then ctfail("dwarf_cache_gate requires @root <repo> on stdin or run from repo root\n") else let tmp = root + "/build/dwarf-cache-gate" in let fast_tmp = (if fs_path_exists("/tmp") == 1 then "/tmp" else root + "/build") + "/lume-proof-cache-gate-" + str(os_getpid()) in let rm1 = os_run("/bin/rm", Cons("-rf", Cons(tmp, Cons(fast_tmp, Nil)))) in let mk1 = os_run("/bin/mkdir", Cons("-p", Cons(tmp, Cons(fast_tmp, Nil)))) in let dw = dcg_test_dwarf_v4(root, tmp) in if dw.err != "" then let cl = os_run("/bin/rm", Cons("-rf", Cons(fast_tmp, Nil))) in ctfail("dwarf_cache_gate failed (DWARF v4): " + dw.err + "\n") else let pc = dcg_test_proof_cache(root, fast_tmp) in let cl2 = os_run("/bin/rm", Cons("-rf", Cons(fast_tmp, Nil))) in if pc.err != "" then ctfail("dwarf_cache_gate failed (Proof Cache): " + pc.err + "\n") else "OK: " + dw.summary + "; " + pc.summary

fn dcg_entry() = if os_arg_count() >= 3 and os_arg_at(1) == "--root" then dcg_main(os_arg_at(2)) else dcg_main(dcg_root_from_input(readall()))

print dcg_entry()
