## lcaas_scale_gate.src -- complexity regression gate for the compiler-as-a-service oracle (build/bin/lcaas).
##
## Usage:
##   printf '@root %s\n' "$PWD" | ./build/bin/lcaas_scale_gate            # the gate (about 2.5 minutes)
##   printf '@root %s\n@full\n' "$PWD" | ./build/bin/lcaas_scale_gate     # every mode x every family, as a table
## Optional input lines: `@lcaas <path>` (another binary, e.g. build/bin/lcaas.before), `@modes a,b` and
## `@fams x,y` (restrict the table of `@full`), `@reps <k>` (runs per size, default 3), `@timeout <ms>` (per run).
##
## What it measures. For a (mode, family) pair the gate generates a synthetic program of size N, 2N, 4N and 8N,
## feeds it to the real lcaas binary on stdin (`@mode <mode>` first, as the driver does) and keeps the best wall
## time of three runs of each size (os_monotonic_ns around os_run_input_capture_timeout; the peak resident size is
## read from /usr/bin/time when that program exists). The same program of size 2N and 8N is given to the compiler
## alone (build/bin/lumec, best of two runs). A row is flagged when
##   - a run fails, gives an empty reply or passes the per-run timeout (30 s);
##   - one doubling multiplies the time by more than three times the factor (an exponential pass stops here);
##   - from 2N to 8N (two doublings, where the run time dominates the start of the process) the time is multiplied
##     by more than factor * factor = 7.84 AND by more than 1.4 times what the compiler alone shows over the same
##     two doublings. The second clause is there because the compiler's own passes are superlinear in most of these
##     dimensions (measured multipliers of lumec from 2N to 8N: 6.5 to 22, i.e. N^1.35 to N^2.2), and lcaas runs
##     those passes in process: what the gate pins down is that lcaas adds no term of a higher degree on top;
##   - the 8N case takes more than 4 times the compiler alone plus 150 ms (8 times for certify / hashes / replay),
##     more than the ceiling of 20 s, or more than 1.5 GB.
##
## Families (the dimension N scales):
##   fns          N independent functions                 chain        f_k calls f_{k-1} (depth N)
##   chain_fwd    f_k calls f_{k+1} (forward references)  diamond      f_k calls f_{k-1} and f_{k-2}
##   diamond_fwd  f_k calls f_{k+1} and f_{k+2}           eff_dfwd     diamond_fwd over a leaf that does I/O
##   scc          one mutual-recursion ring of N          let_depth    N nested `let`
##   if_chain     N `else if` arms                        arith        N left-nested `+`
##   arith_nest   N nested parentheses                    match_arms   N arms of one `match`
##   params       N parameters                            contracts    N functions with requires/ensures
##   laws         N laws                                  strlit       one string literal of 64 N bytes
##   records      one record literal of N fields          ident_len    32 functions whose names have N letters
##   fanout       one body that calls N functions         handlers     N functions with a `with handler`
##   inline_fan   a contract over a call tree of fan-out N, six levels (the certificate term inlines five)
##   rec_self     N self-recursive `@no_alloc` functions with a contract
##   cheader      N C prototypes (the `bind*` modes)
##
## Rows of the gate (all with factor 2.8 and ceiling 20 s) and what each one guards; the times are in the report.
##   prove    fns chain chain_fwd diamond diamond_fwd eff_dfwd scc    the function table and the effect rows: the
##            table was a list scanned per call site and copied per body (quadratic in the number of functions), the
##            effect row of a forward reference or of a ring was re-derived along every call path (exponential)
##   prove    let_depth if_chain arith match_arms params records fanout strlit laws contracts handlers   the shapes
##            of one body; lcaas follows the compiler here
##   prove / certify inline_fan    the certificate term of a call tree: exponential before the term budget (cs_cw_*)
##   check    rec_self    the second proof attempt unfolded a recursive callee again on every branch: one such
##            function with `ensures result == result` did not finish in 200 s
##   certify  contracts diamond_fwd    lsp / dap / hashes  fns    replay  diamond_fwd    bind  cheader
##
## Semantic checks. Nine answers of the oracle are compared with what this binary computes natively (64-bit bit
## operations, the flooring `bit_shr`, a contract evaluated through `bit_shr`), two controls require that the former
## wrong answers (4464 for bit_and(70000, 70000), -3 for bit_shr(-7, 1)) are NOT given, and the certificate of an
## oversize obligation must carry the term `(implies (and) oversize)` unchecked and unverified.
##
## Negative control. The detector that judges the rows is also run on three routines of this file: a linear sum,
## a deliberately quadratic one (the length of a list recomputed per element) and a deliberately exponential one
## (naive Fibonacci). The gate fails unless the linear one passes and the other two are flagged.
fn lsg_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn lsg_chomp(s) = let n = count(s) in if n == 0 then "" else let c = at(s, n - 1) in if c == "\n" or c == "\r" or c == " " or c == "\t" then lsg_chomp(slice(s, 0, n - 1)) else s
fn lsg_find_at(s, pat, i, n, m) = if i + m > n then 0 - 1 else if slice(s, i, i + m) == pat then i else lsg_find_at(s, pat, i + 1, n, m)
fn lsg_has(s, pat) = if lsg_find_at(s, pat, 0, count(s), count(pat)) >= 0 then 1 else 0
fn lsg_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else lsg_line_end(s, i + 1)
fn lsg_root(input) = if count(input) >= 6 and slice(input, 0, 6) == "@root " then lsg_chomp(slice(input, 6, lsg_line_end(input, 0))) else ""
fn lsg_get_at(s, key, i) = if i >= count(s) then "" else let e = lsg_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then lsg_chomp(slice(s, i + n + 2, e)) else lsg_get_at(s, key, e + 1)
fn lsg_flag_at(s, key, i) = if i >= count(s) then 0 else let e = lsg_line_end(s, i) in if lsg_chomp(slice(s, i, e)) == "@" + key then 1 else lsg_flag_at(s, key, e + 1)
fn lsg_opt(input, key, dflt) = let v = lsg_get_at(input, key, 0) in if v == "" then dflt else v
fn lsg_num(s, i, acc) = if i >= count(s) or at(s, i) < "0" or at(s, i) > "9" then acc else lsg_num(s, i + 1, acc * 10 + toint(at(s, i)))
fn lsg_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => lsg_rev(t, Cons(h, acc))
fn lsg_len(xs, n) = match xs
    Nil        => n
    Cons(h, t) => lsg_len(t, n + 1)
fn lsg_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, lsg_app(t, ys))
## join a list of chunks in O(total log n): adjacent pairs are concatenated until one string is left
fn lsg_pairs(xs, acc) = match xs
    Nil        => lsg_rev(acc, Nil)
    Cons(a, t) => lsg_pairs1(a, t, acc)
fn lsg_pairs1(a, t, acc) = match t
    Nil        => lsg_rev(Cons(a, acc), Nil)
    Cons(b, r) => lsg_pairs(r, Cons(a + b, acc))
fn lsg_join(xs) = match xs
    Nil        => ""
    Cons(a, t) => lsg_join1(a, t, xs)
fn lsg_join1(a, t, xs) = match t
    Nil => a
    _   => lsg_join(lsg_pairs(xs, Nil))
fn lsg_rep_acc(s, n, acc) = if n <= 0 then acc else lsg_rep_acc(s, n - 1, Cons(s, acc))
fn lsg_rep(s, n) = lsg_join(lsg_rep_acc(s, n, Nil))
## comma-separated membership: "" admits everything
fn lsg_csv_has(csv, w, i) = if csv == "" then 1 else if i >= count(csv) then 0 else let e = lsg_csv_end(csv, i) in if slice(csv, i, e) == w then 1 else lsg_csv_has(csv, w, e + 1)
fn lsg_csv_end(s, i) = if i >= count(s) or at(s, i) == "," then i else lsg_csv_end(s, i + 1)

## --- generators: a family is head + piece(0) + .. + piece(cnt - 1) + tail ---
fn lsg_fn(i) = "fn f" + str(i) + "(x: int) -> int = "
fn lsg_cnt(fam, n) = if fam == "arith_nest" or fam == "fanout" then 2 * n + 1 else if fam == "ident_len" then 32 else if fam == "inline_fan" then 7 else n
fn lsg_head(fam, n) = if fam == "let_depth" or fam == "if_chain" or fam == "arith_nest" then "fn g(x: int) -> int = " else if fam == "arith" then "fn g(x: int) -> int = x" else if fam == "match_arms" then "fn g(x: int) -> int = match x\n" else if fam == "params" then "fn g(" else if fam == "strlit" then "fn g() = \"" else if fam == "records" then "fn g(x: int) -> int = let r = {" else if fam == "handlers" then "effect Log { fn say(x) -> int }\n" else ""
fn lsg_tail(fam, n) = if fam == "fns" or fam == "chain" or fam == "scc" then "print f0(1)\n" else if fam == "chain_fwd" or fam == "diamond_fwd" then "print f" + str(n - 1) + "(1)\n" else if fam == "diamond" then "print f1(1)\n" else if fam == "let_depth" then "a" + str(n - 1) + "\nprint g(1)\n" else if fam == "if_chain" then "0\nprint g(1)\n" else if fam == "arith" or fam == "arith_nest" then "\nprint g(1)\n" else if fam == "match_arms" then "    _ => 0\nprint g(1)\n" else if fam == "params" then ") -> int = p0 + p" + str(n - 1) + "\nprint 1\n" else if fam == "contracts" then "print c0(1)\n" else if fam == "strlit" then "\"\nprint count(g())\n" else if fam == "records" then "} in r.f0 + r.f" + str(n - 1) + "\nprint g(1)\n" else if fam == "fanout" then "\nprint top(1)\n" else if fam == "handlers" then "print h0(1)\n" else if fam == "inline_fan" then "fn top(t: int) -> int requires t >= 0 ensures result >= 0 = g6(t)\nprint top(1)\n" else if fam == "cheader" then "" else "print 1\n"
fn lsg_piece(fam, i, n) = if fam == "fns" then lsg_fn(i) + "x + " + str(i) + "\n" else if fam == "chain" then lsg_fn(i) + (if i == 0 then "x + 1\n" else "f" + str(i - 1) + "(x) + 1\n") else if fam == "chain_fwd" then lsg_fn(i) + (if i >= n - 1 then "x\n" else "f" + str(i + 1) + "(x) + 1\n") else if fam == "diamond" then lsg_fn(i) + (if i < 2 then "x + " + str(i) + "\n" else "f" + str(i - 1) + "(x) + f" + str(i - 2) + "(x)\n") else if fam == "diamond_fwd" then lsg_fn(i) + (if i >= n - 2 then "x + " + str(i) + "\n" else "f" + str(i + 1) + "(x) + f" + str(i + 2) + "(x)\n") else if fam == "eff_dfwd" then lsg_fn(i) + (if i >= n - 2 then "let z = os_getpid() in x\n" else "f" + str(i + 1) + "(x) + f" + str(i + 2) + "(x)\n") else if fam == "scc" then lsg_fn(i) + "if x <= 0 then 0 else f" + str((i + 1) % n) + "(x - 1)\n" else lsg_piece2(fam, i, n)
fn lsg_piece2(fam, i, n) = if fam == "let_depth" then "let a" + str(i) + " = " + (if i == 0 then "x" else "a" + str(i - 1)) + " + 1 in " else if fam == "if_chain" then "if x == " + str(i) + " then " + str(i) + " else " else if fam == "arith" then " + 1" else if fam == "arith_nest" then (if i < n then "(1 + " else if i == n then "x" else ")") else if fam == "match_arms" then "    " + str(i) + " => " + str(i) + "\n" else if fam == "params" then (if i > 0 then ", " else "") + "p" + str(i) + ": int" else if fam == "contracts" then "fn c" + str(i) + "(x: int) -> int requires x >= 0 ensures result >= " + str(i) + " = x + " + str(i) + "\n" else if fam == "laws" then "law l" + str(i) + "(a: int) = a + " + str(i) + " >= a\n" else if fam == "strlit" then "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" else if fam == "records" then (if i > 0 then ", " else "") + "f" + str(i) + ": x" else lsg_piece3(fam, i, n)
fn lsg_piece3(fam, i, n) = if fam == "ident_len" then "fn " + lsg_rep("a", n) + str(i) + "(x: int) -> int = x\n" else if fam == "fanout" then (if i < n then lsg_fn(i) + "x + " + str(i) + "\n" else if i == n then "fn top(x: int) -> int = 0" else " + f" + str(i - n - 1) + "(x)") else if fam == "handlers" then "fn h" + str(i) + "(x: int) -> int = with handler Log { fn say(y) -> int = y + " + str(i) + " } in say(x)\n" else if fam == "inline_fan" then (if i == 0 then "fn g0(t: int) -> int = t + 1\n" else "fn g" + str(i) + "(t: int) -> int = if t < 0 then g" + str(i - 1) + "(t)" + lsg_rep(" + g" + str(i - 1) + "(t + 1)", n - 1) + " else t\n") else if fam == "cheader" then "int f" + str(i) + "(int a, int b);\n" else if fam == "rec_self" then "@no_alloc\nfn r" + str(i) + "(n: int) -> int requires n >= 0 and n <= 1000 ensures result == result = if n == 0 then 0 else r" + str(i) + "(n - 1)\n" else ""
fn lsg_pieces(fam, i, cnt, n, acc) = if i >= cnt then acc else lsg_pieces(fam, i + 1, cnt, n, Cons(lsg_piece(fam, i, n), acc))
fn lsg_src(fam, n) = lsg_join(Cons(lsg_head(fam, n), lsg_rev(Cons(lsg_tail(fam, n), lsg_pieces(fam, 0, lsg_cnt(fam, n), n, Nil)), Nil)))

## --- the request a mode takes: how the driver frames the source for it ---
fn lsg_two(mode) = if mode == "proof-diff" or mode == "compose" or mode == "diff-semver" or mode == "equiv" then 1 else 0
fn lsg_request(mode, src) = if mode == "prove" then src else if mode == "focus" then "@focus 13\nprint f0(1)\n\n" + src else let p = "@mode " + mode + "\n" in if lsg_two(mode) == 1 then p + src + "\n@split\n" + src else if mode == "check-rot" then p + src + "\n@split\n" + src + "\n@split\n" else if mode == "lineage" then p + src + "\n@split\nf0" else if mode == "patch" then p + src + "\n@split\nf0\n@split\nx + 2" else if mode == "patch-fn" then p + "f0\nfn f0(x: int) -> int = x + 2\n@split\n" + src else p + src

## --- one timed run: {us: wall microseconds, ok: exit 0 with a reply, kb: peak resident size or -1} ---
fn lsg_run(c, inp, out) = let memf = out + ".mem" in let t0 = os_monotonic_ns() in let raw = if c.timebin == "" then os_run_input_capture_timeout(c.lcaas, Nil, inp, out, out + ".err", c.timeout) else os_run_input_capture_timeout(c.timebin, Cons("-f", Cons("%M", Cons("-o", Cons(memf, Cons(c.lcaas, Nil))))), inp, out, out + ".err", c.timeout) in let t1 = os_monotonic_ns() in let reply = fs_read_file(out) in {us: (t1 - t0) / 1000, ok: if lsg_wait_exit(raw) == 0 and count(reply) > 0 then 1 else 0, kb: if c.timebin == "" or fs_path_exists(memf) == 0 then 0 - 1 else lsg_num(lsg_last_line(lsg_chomp(fs_read_file(memf))), 0, 0)}
fn lsg_last_line_at(s, i, st) = if i >= count(s) then slice(s, st, count(s)) else if at(s, i) == "\n" then lsg_last_line_at(s, i + 1, i + 1) else lsg_last_line_at(s, i + 1, st)
fn lsg_last_line(s) = lsg_last_line_at(s, 0, 0)
## best of `k` runs of one request
fn lsg_best(c, inp, out, k, best) = if k <= 0 then best else let r = lsg_run(c, inp, out) in if r.ok == 0 then {us: r.us, ok: 0, kb: r.kb} else lsg_best(c, inp, out, k - 1, if best.us < 0 or r.us < best.us then r else best)
fn lsg_measure(c, mode, fam, n) = let inp = c.tmp + "/" + mode + "." + fam + "." + str(n) + ".in" in let w = fs_write_sync(inp, lsg_request(mode, lsg_src(fam, n))) in lsg_best(c, inp, c.tmp + "/reply.out", c.reps, {us: 0 - 1, ok: 1, kb: 0 - 1})
## the compiler alone (build/bin/lumec) on the same program: the yardstick for what lcaas adds on top of it
fn lsg_compiler(c, fam, n) = let inp = c.tmp + "/lumec." + fam + "." + str(n) + ".in" in let w = fs_write_sync(inp, lsg_src(fam, n)) in lsg_best({lcaas: c.lumec, timebin: "", timeout: c.timeout}, inp, c.tmp + "/lumec.out", 2, {us: 0 - 1, ok: 1, kb: 0 - 1})

## --- the detector: times of N, 2N, 4N, 8N against a factor per doubling (in hundredths) and a ceiling ---
## log2(x) in hundredths for x given in hundredths (x100 = 100 * x), by halving and a linear last step
fn lsg_log2h(x100, acc) = if x100 >= 200 then lsg_log2h(x100 / 2, acc + 100) else if x100 <= 100 then acc else acc + (x100 - 100)
fn lsg_ratio(a, b) = if a <= 0 then 999999 else b * 100 / a
fn lsg_fmt2(h) = str(h / 100) + "." + (if h % 100 < 10 then "0" else "") + str(h % 100)
fn lsg_ms(us) = lsg_fmt2(us / 10)
## verdict of one doubling: "" when the step from `a` to `b` (microseconds) is within `factor`
fn lsg_step_bad(a, b, factor) = if lsg_ratio(a, b) > factor then 1 else 0

## run a row size by size; stop at the first failed run or violated doubling.
## row = {mode, fam, n, factor, ceil_ms}; result = {line, bad, why}
fn lsg_row_go(c, row, k, prev, times, kb) = if k >= 4 then {times: times, kb: kb, why: ""} else let n = row.n * lsg_pow2(k) in let m = lsg_measure(c, row.mode, row.fam, n) in if m.ok == 0 then {times: Cons(m.us, times), kb: kb, why: "the run of N=" + str(n) + " failed or passed the per-run timeout after " + lsg_ms(m.us) + " ms"} else if prev > 0 and lsg_step_bad(prev, m.us, 3 * row.factor) == 1 then {times: Cons(m.us, times), kb: m.kb, why: "doubling N to " + str(n) + " multiplied the time by " + lsg_fmt2(lsg_ratio(prev, m.us)) + " (more than three times the bound " + lsg_fmt2(row.factor) + ")"} else lsg_row_go(c, row, k + 1, m.us, Cons(m.us, times), m.kb)
## the verdict over the four sizes (`times` holds t(8N), t(4N), t(2N), t(N)): the two doublings from 2N to 8N, where the
## run time dominates the start of the process, may multiply the time by at most factor * factor
fn lsg_nth(xs, i) = match xs
    Nil        => 0
    Cons(h, t) => if i <= 0 then h else lsg_nth(t, i - 1)
## `ctrend` is the same multiplier measured on the compiler alone (0 when there is none): where the compiler's own
## passes are superlinear in the stressed dimension, lcaas (which runs them) may follow it within 1.4 times
fn lsg_trend_allow(factor, ctrend) = let a = factor * factor / 100 in let b = ctrend * 140 / 100 in if b > a then b else a
fn lsg_trend_bad(times, factor, ctrend) = if lsg_ratio(lsg_nth(times, 2), lsg_nth(times, 0)) > lsg_trend_allow(factor, ctrend) then 1 else 0
fn lsg_trend_why(times, factor, ctrend) = if lsg_trend_bad(times, factor, ctrend) == 0 then "" else "from 2N to 8N the time was multiplied by " + lsg_fmt2(lsg_ratio(lsg_nth(times, 2), lsg_nth(times, 0))) + " (bound " + lsg_fmt2(lsg_trend_allow(factor, ctrend)) + ": " + lsg_fmt2(factor) + " per doubling, or 1.4 times the compiler's own " + lsg_fmt2(ctrend) + ")"
fn lsg_pow2(k) = if k <= 0 then 1 else 2 * lsg_pow2(k - 1)
fn lsg_first(xs) = match xs
    Nil        => 0
    Cons(h, t) => h
fn lsg_last(xs) = match xs
    Nil        => 0
    Cons(h, t) => lsg_last1(h, t)
fn lsg_last1(h, t) = match t
    Nil => h
    _   => lsg_last(t)
fn lsg_times_txt(xs) = match xs
    Nil        => ""
    Cons(h, t) => " " + lsg_ms(h) + lsg_times_txt(t)
fn lsg_ratios_txt(prev, xs) = match xs
    Nil        => ""
    Cons(h, t) => (if prev > 0 then " x" + lsg_fmt2(lsg_ratio(prev, h)) else "") + lsg_ratios_txt(h, t)
## the fitted exponent: log2(t(8N) / t(N)) / 3 when the four sizes ran, else over the sizes that did
fn lsg_exp(ts) = let k = lsg_len(ts, 0) in if k < 2 then "-" else lsg_fmt2(lsg_log2h(lsg_ratio(lsg_first(ts), lsg_last(ts)), 0) / (k - 1))
## `over` is the bound, in hundredths, on t_lcaas(8N) / t_lumec(8N) (0: the family is not a Lume program); 150 ms of
## slack cover the start-up of the larger binary
fn lsg_over_why(row, big, lc) = if row.over <= 0 or lc.ok == 0 or lc.us <= 0 then "" else if big > lc.us * row.over / 100 + 150000 then "the 8N case took " + lsg_ms(big) + " ms, more than " + lsg_fmt2(row.over) + " times the compiler alone (" + lsg_ms(lc.us) + " ms) plus 150 ms" else ""
## A flagged row is measured a second time and is flagged only if the second measurement is flagged too: on a shared
## machine the load can change between the run of 2N and the run of 8N. A real defect is flagged twice.
fn lsg_row(c, row) = let r1 = lsg_row1(c, row) in if r1.bad == 0 then r1 else let r2 = lsg_row1(c, row) in if r2.bad == 1 then r2 else {bad: 0, line: r2.line + " (second measurement; the first one was flagged)"}
fn lsg_row1(c, row) = let r = lsg_row_go(c, row, 0, 0, Nil, 0 - 1) in let ts = lsg_rev(r.times, Nil) in let big = lsg_first(r.times) in let lc = if row.over > 0 and r.why == "" and c.lumec != "" then lsg_compiler(c, row.fam, row.n * 8) else {us: 0 - 1, ok: 0, kb: 0 - 1} in let lc2 = if lc.ok == 1 then lsg_compiler(c, row.fam, row.n * 2) else lc in let ctrend = if lc.ok == 1 and lc2.ok == 1 then lsg_ratio(lc2.us, lc.us) else 0 in let why = if r.why != "" then r.why else if lsg_trend_bad(r.times, row.factor, ctrend) == 1 then lsg_trend_why(r.times, row.factor, ctrend) else if big > row.ceil_ms * 1000 then "the 8N case took " + lsg_ms(big) + " ms (ceiling " + str(row.ceil_ms) + " ms)" else if r.kb > 1572864 then "the 8N case peaked at " + str(r.kb) + " KB (ceiling 1572864 KB)" else lsg_over_why(row, big, lc) in {bad: if why == "" then 0 else 1, line: row.mode + " " + row.fam + " N=" + str(row.n) + " ms:" + lsg_times_txt(ts) + " |" + lsg_ratios_txt(0, ts) + " | exp " + lsg_exp(ts) + " | peak " + str(r.kb) + " KB | lumec(8N) " + (if lc.ok == 1 then lsg_ms(lc.us) + " x" + lsg_fmt2(ctrend) else "-") + " | " + (if why == "" then "ok" else "FLAG: " + why)}
fn lsg_rows(c, rows, bad, acc) = match rows
    Nil        => {bad: bad, lines: lsg_rev(acc, Nil)}
    Cons(h, t) => let r = lsg_row(c, h) in lsg_rows(c, t, bad + r.bad, Cons(r.line + "\n", acc))

## --- the rows of the gate (the table of the header) ---
fn lsg_r(mode, fam, n, factor, ceil_ms) = {mode: mode, fam: fam, n: n, factor: factor, ceil_ms: ceil_ms, over: if fam == "cheader" then 0 else if mode == "certify" or mode == "hashes" or mode == "replay" then 800 else 400}
fn lsg_g(mode, fam, factor, rest) = Cons(lsg_r(mode, fam, lsg_base_n(fam), factor, 20000), rest)
fn lsg_gate_rows() = lsg_g("prove", "fns", 280, lsg_g("prove", "chain", 280, lsg_g("prove", "chain_fwd", 280, lsg_g("prove", "diamond", 280, lsg_g("prove", "diamond_fwd", 280, lsg_g("prove", "eff_dfwd", 280, lsg_g("prove", "scc", 280, lsg_g("prove", "let_depth", 280, lsg_g("prove", "if_chain", 280, lsg_g("prove", "arith", 280, lsg_g("prove", "match_arms", 280, lsg_g("prove", "params", 280, lsg_g("prove", "contracts", 280, lsg_g("prove", "laws", 280, lsg_gate_rows2()))))))))))))))
fn lsg_gate_rows2() = lsg_g("prove", "strlit", 280, lsg_g("prove", "records", 280, lsg_g("prove", "fanout", 280, lsg_g("prove", "handlers", 280, lsg_g("prove", "inline_fan", 280, lsg_g("check", "rec_self", 280, lsg_g("certify", "contracts", 280, lsg_g("certify", "diamond_fwd", 280, lsg_g("certify", "inline_fan", 280, lsg_g("lsp", "fns", 280, lsg_g("dap", "fns", 280, lsg_g("replay", "diamond_fwd", 280, lsg_g("hashes", "fns", 280, lsg_g("bind", "cheader", 280, Nil))))))))))))))

## --- `@full`: every mode over every family, with the default bound (a table for the audit, not the gate) ---
fn lsg_all_modes() = Cons("prove", Cons("check", Cons("focus", Cons("certify", Cons("witness", Cons("repair", Cons("impact", Cons("hashes", Cons("grammar", Cons("project", Cons("lsp", Cons("dap", Cons("repl", Cons("c-export", Cons("kernel", Cons("replay", Cons("trace", Cons("skeleton", Cons("registry-interface", Cons("mcp", Cons("share", Cons("heal", Cons("proof-diff", Cons("compose", Cons("diff-semver", Cons("equiv", Cons("check-rot", Cons("lineage", Cons("patch", Cons("patch-fn", Nil))))))))))))))))))))))))))))))
fn lsg_all_fams() = Cons("fns", Cons("chain", Cons("chain_fwd", Cons("diamond", Cons("diamond_fwd", Cons("eff_dfwd", Cons("scc", Cons("let_depth", Cons("if_chain", Cons("arith", Cons("arith_nest", Cons("match_arms", Cons("params", Cons("contracts", Cons("laws", Cons("strlit", Cons("records", Cons("ident_len", Cons("fanout", Cons("handlers", Cons("inline_fan", Nil)))))))))))))))))))))
fn lsg_base_n(fam) = if fam == "cheader" then 600 else if fam == "fns" then 300 else if fam == "strlit" then 2000 else if fam == "ident_len" then 1000 else if fam == "match_arms" then 400 else if fam == "params" then 500 else if fam == "records" then 350 else if fam == "laws" then 300 else if fam == "handlers" then 150 else if fam == "rec_self" then 25 else if fam == "arith" or fam == "arith_nest" then 100 else if fam == "contracts" then 100 else if fam == "fanout" then 50 else if fam == "inline_fan" then 8 else if fam == "diamond_fwd" or fam == "eff_dfwd" then 150 else 200
fn lsg_full_fams(c, mode, fams, acc) = match fams
    Nil        => acc
    Cons(f, r) => lsg_full_fams(c, mode, r, if lsg_csv_has(c.fams, f, 0) == 1 then Cons(lsg_r(mode, f, lsg_base_n(f), 280, 20000), acc) else acc)
fn lsg_full_modes(c, modes, acc) = match modes
    Nil        => lsg_rev(acc, Nil)
    Cons(m, r) => lsg_full_modes(c, r, if lsg_csv_has(c.modes, m, 0) == 1 then lsg_full_fams(c, m, lsg_all_fams(), acc) else acc)
fn lsg_bind_rows(c, modes, acc) = match modes
    Nil        => acc
    Cons(m, r) => lsg_bind_rows(c, r, if lsg_csv_has(c.modes, m, 0) == 1 and lsg_csv_has(c.fams, "cheader", 0) == 1 then Cons(lsg_r(m, "cheader", 300, 280, 20000), acc) else acc)
fn lsg_full_rows(c) = lsg_app(lsg_full_modes(c, lsg_all_modes(), Nil), lsg_rev(lsg_bind_rows(c, Cons("bind", Cons("bind-raw", Cons("bind-source", Cons("bind-raw-source", Nil)))), Nil), Nil))

## --- answers of the oracle that an earlier lcaas got wrong or never gave (each compared with native code) ---
## `lsg_k` keeps the operands out of reach of constant folding: the expected text is what this binary computes.
fn lsg_k(x) = x + lsg_len(Nil, 0)
fn lsg_ask(c, tag, req) = let inp = c.tmp + "/sem." + tag + ".in" in let w = fs_write_sync(inp, req) in let raw = os_run_input_capture_timeout(c.lcaas, Nil, inp, c.tmp + "/sem.out", c.tmp + "/sem.err", c.timeout) in if lsg_wait_exit(raw) != 0 then "" else fs_read_file(c.tmp + "/sem.out")
fn lsg_sem1(c, tag, req, want, forbid) = let out = lsg_ask(c, tag, req) in if lsg_has(out, want) == 0 then tag + ": the reply lacks " + want + ": " + slice(out, 0, if count(out) < 400 then count(out) else 400) else if forbid != "" and lsg_has(out, forbid) == 1 then tag + ": the reply contains " + forbid else ""
fn lsg_res(v) = "\"result\":\"" + str(v) + "\""
fn lsg_bit(c, op, a, b, v) = lsg_sem1(c, op, "print " + op + "(" + (if a < 0 then "0 - " + str(0 - a) else str(a)) + ", " + str(b) + ")\n", lsg_res(v), "")
fn lsg_first_bad(xs) = match xs
    Nil        => ""
    Cons(h, t) => if h != "" then h else lsg_first_bad(t)
fn lsg_sem(c) = let a = lsg_k(70000) in let big = lsg_k(4294967296) in let m7 = lsg_k(0 - 7) in lsg_first_bad(Cons(lsg_bit(c, "bit_and", a, a, bit_and(a, a)), Cons(lsg_bit(c, "bit_or", 65536, 1, bit_or(lsg_k(65536), 1)), Cons(lsg_bit(c, "bit_xor", big, 70001, bit_xor(big, lsg_k(70001))), Cons(lsg_bit(c, "bit_and", 0 - 1, 1099511627775, bit_and(lsg_k(0 - 1), 1099511627775)), Cons(lsg_bit(c, "bit_shr", m7, 1, bit_shr(m7, 1)), Cons(lsg_bit(c, "bit_shr", 0 - 1, 62, bit_shr(lsg_k(0 - 1), 62)), Cons(lsg_bit(c, "bit_shr", 1099511627776, 3, bit_shr(lsg_k(1099511627776), 3)), Cons(lsg_bit(c, "bit_shl", 3, 40, bit_shl(lsg_k(3), 40)), Cons(lsg_sem1(c, "shr-contract", "fn f(a: int) -> int ensures result == 0 - 4 = bit_shr(0 - 7, 1)\nprint f(0)\n", lsg_res(bit_shr(m7, 1)), "V0001"), Cons((if lsg_sem1(c, "control-16-bit", "print bit_and(70000, 70000)\n", lsg_res(4464), "") == "" then "control: the oracle still answers 4464 for bit_and(70000, 70000), or the comparison accepts anything" else ""), Cons((if lsg_sem1(c, "control-trunc", "print bit_shr(0 - 7, 1)\n", lsg_res(0 - 3), "") == "" then "control: the oracle still truncates bit_shr(-7, 1) to -3, or the comparison accepts anything" else ""), Cons(lsg_sem1(c, "oversize-certificate", "@mode certify\n" + lsg_src("inline_fan", 8), "\"term\":\"(implies (and) oversize)\",\"checked\":false", "\"kernel_verified\":true"), Nil)))))))))))))

## --- negative control: the same detector on three routines of known growth ---
fn lsg_ref_lin(i, n, acc) = if i >= n then acc else lsg_ref_lin(i + 1, n, acc + i % 7)
fn lsg_ref_list(n, acc) = if n <= 0 then acc else lsg_ref_list(n - 1, Cons(n, acc))
## quadratic on purpose: the length of the whole list is recomputed for every element
fn lsg_ref_quad(xs, all, acc) = match xs
    Nil        => acc
    Cons(h, t) => lsg_ref_quad(t, all, acc + lsg_len(all, 0) % 3)
## exponential on purpose
fn lsg_ref_fib(n) = if n < 2 then n else lsg_ref_fib(n - 1) + lsg_ref_fib(n - 2)
fn lsg_ref_time(kind, n) = let t0 = os_monotonic_ns() in let v = if kind == "linear" then lsg_ref_lin(0, n, 0) else if kind == "quadratic" then (let xs = lsg_ref_list(n, Nil) in lsg_ref_quad(xs, xs, 0)) else lsg_ref_fib(n) in let t1 = os_monotonic_ns() in if v < 0 then 0 else (t1 - t0) / 1000
fn lsg_ref_best(kind, n, k, best) = if k <= 0 then best else let t = lsg_ref_time(kind, n) in lsg_ref_best(kind, n, k - 1, if best < 0 or t < best then t else best)
## 1 when the detector of the rows flags the routine: one doubling past twice the factor, or the trend from 2N to 8N
fn lsg_ref_flagged(kind, n, k, prev, factor, times) = if k >= 4 then lsg_trend_bad(times, factor, 0) else let t = lsg_ref_best(kind, n, 3, 0 - 1) in if prev > 0 and lsg_step_bad(prev, t, 3 * factor) == 1 then 1 else lsg_ref_flagged(kind, n * 2, k + 1, t, factor, Cons(t, times))
fn lsg_control() = let lin = lsg_ref_flagged("linear", 2000000, 0, 0, 280, Nil) in let quad = lsg_ref_flagged("quadratic", 3000, 0, 0, 280, Nil) in let ex = lsg_ref_flagged("exponential", 14, 0, 0, 280, Nil) in {bad: if lin == 0 and quad == 1 and ex == 1 then 0 else 1, line: "control: linear " + (if lin == 0 then "passes" else "FLAGGED") + ", quadratic " + (if quad == 1 then "flagged" else "NOT FLAGGED") + ", exponential " + (if ex == 1 then "flagged" else "NOT FLAGGED") + "\n"}

fn lsg_main(input) = let root = lsg_root(input) in if root == "" then ctfail("lcaas scale gate requires @root\n") else let tmp = root + "/build/lcaas-scale-gate-" + str(os_getpid()) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil))) in let c = {root: root, tmp: tmp, lcaas: lsg_opt(input, "lcaas", root + "/build/bin/lcaas"), timebin: if fs_path_exists("/usr/bin/time") == 1 then "/usr/bin/time" else "", lumec: (let lp = lsg_opt(input, "lumec", root + "/build/bin/lumec") in if fs_path_exists(lp) == 1 then lp else ""), reps: lsg_num(lsg_opt(input, "reps", "3"), 0, 0), timeout: lsg_num(lsg_opt(input, "timeout", "30000"), 0, 0), modes: lsg_get_at(input, "modes", 0), fams: lsg_get_at(input, "fams", 0)} in let full = lsg_flag_at(input, "full", 0) in if fs_path_exists(c.lcaas) == 0 then ctfail("lcaas scale gate: " + c.lcaas + " is missing (build it with ./lume build compiler/stage1/lcaas.src -o build/bin/lcaas)\n") else let ctl = lsg_control() in let sem = if full == 1 then "" else lsg_sem(c) in let t0 = os_monotonic_ns() in let rs = lsg_rows(c, if full == 1 then lsg_full_rows(c) else lsg_gate_rows(), 0, Nil) in let secs = (os_monotonic_ns() - t0) / 1000000000 in let rm = os_run("/bin/rm", Cons("-rf", Cons(tmp, Nil))) in let report = ctl.line + lsg_join(rs.lines) in if full == 1 then report + "lcaas scale table: " + str(lsg_len(rs.lines, 0)) + " rows, " + str(rs.bad) + " flagged, " + str(secs) + " s (" + c.lcaas + ")" else if ctl.bad == 1 then ctfail(report + "lcaas scale gate FAILED: the detector did not separate the reference routines\n") else if sem != "" then ctfail(report + "lcaas scale gate FAILED: " + sem + "\n") else if rs.bad > 0 then ctfail(report + "lcaas scale gate FAILED: " + str(rs.bad) + " of " + str(lsg_len(rs.lines, 0)) + " rows flagged (" + c.lcaas + ")\n") else report + "lcaas scale gate ok: " + str(lsg_len(rs.lines, 0)) + " rows within their bounds, negative control flagged, 9 oracle answers equal to native code (2 controls), " + str(secs) + " s"

print lsg_main(readall())
