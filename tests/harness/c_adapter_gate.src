use c_adapter_fixtures

fn ca_run(path, args, out) = os_run_capture_timeout(path, args, out, out + ".err", 900000)
fn ca_input(path, args, input, out) = os_run_input_capture_timeout(path, args, input, out, out + ".err", 900000)
fn ca_lume(root, args, out) = ca_run("/usr/bin/env", Cons("PATH=/usr/local/bin:/usr/bin:/bin", Cons(root + "/lume", args)), out)
fn ca_build(root, source, out, log) = ca_lume(root, Cons("build", Cons(source, Cons("-o", Cons(out, Nil)))), log)
fn ca_ok(step, status, out) = if status == 0 then "" else step + ": " + fs_read_file(out) + fs_read_file(out + ".err")
fn ca_write(path, text) = if fs_write_sync(path, text) == 1 then "" else "cannot write " + path
fn ca_copy(source, destination) = ca_write(destination, fs_read_file(source))
fn ca_same_at(a, b, i) = let av = fs_read_byte(a, i) in let bv = fs_read_byte(b, i) in if av != bv then 0 else if av < 0 then 1 else ca_same_at(a, b, i + 1)
fn ca_same(a, b, step) = if fs_path_exists(a) == 0 or fs_path_exists(b) == 0 then step + ": missing comparison artifact" else if ca_same_at(a, b, 0) == 1 then "" else step + ": files differ"
fn ca_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else ca_contains_at(text, part, i + 1)
fn ca_contains(text, part) = ca_contains_at(text, part, 0)
fn ca_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else ca_line_end(text, i + 1)
fn ca_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, ca_line_end(input, 0))
fn ca_oracle(root, tmp, request) = let input = tmp + "/oracle.in" in let out = tmp + "/oracle.out" in let written = ca_write(input, request) in if written != "" then written else ca_ok("native manifest oracle", ca_input(tmp + "/c_adapter_assert", Nil, input, out), out)
fn ca_prepare(root, tmp) = let parent = fs_mkdir(root + "/build") in if parent != 1 then "cannot create adapter capture parent" else let removed = ca_run("/bin/rm", Cons("-rf", Cons(tmp, Nil)), tmp + ".rm.out") in if removed != 0 then "cannot reset adapter gate directory: status " + str(removed) + ": " + fs_read_file(tmp + ".rm.out") + fs_read_file(tmp + ".rm.out.err") else let made = ca_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil)), tmp + ".mkdir.out") in if made != 0 then "cannot create adapter gate directory: status " + str(made) + ": " + fs_read_file(tmp + ".mkdir.out") + fs_read_file(tmp + ".mkdir.out.err") else let fixture = cf_write(tmp, "buffer_math") in if fixture != 1 then "cannot generate buffer_math fixture in Lume" else let assertion = ca_build(root, root + "/tests/harness/c_adapter_assertions.src", tmp + "/c_adapter_assert", tmp + "/assert-build.out") in if assertion != 0 then "cannot build manifest oracle: " + fs_read_file(tmp + "/assert-build.out.err") else let library = ca_build(root, root + "/tests/fixtures/c_adapter/buffer_math.src", tmp + "/libc_adapter_fixture.so", tmp + "/library-build.out") in if library != 0 then "cannot build Lume shared library: " + fs_read_file(tmp + "/library-build.out.err") else ""
fn ca_generate(root, tmp) = let header = tmp + "/buffer_math.h" in let json = tmp + "/adapter.json" in let generated = ca_lume(root, Cons("adapt", Cons("c", Cons("--json", Cons(header, Nil)))), json) in if generated != 0 then "adapter generation failed: " + fs_read_file(json + ".err") else let checked = ca_oracle(root, tmp, "@mode manifest\n@path " + json + "\n@header " + header + "\n@output " + tmp + "/generated.src\n") in if checked != "" then checked else let stdout = ca_lume(root, Cons("adapt", Cons("c", Cons(header, Nil))), tmp + "/generated-stdout.src") in if stdout != 0 then "adapter stdout generation failed" else let output = ca_lume(root, Cons("adapt", Cons("c", Cons(header, Cons("-o", Cons(tmp + "/generated-output.src", Nil))))), tmp + "/generated-output.log") in if output != 0 then "adapter output generation failed" else let first = ca_same(tmp + "/generated.src", tmp + "/generated-stdout.src", "stdout generation") in if first != "" then first else ca_same(tmp + "/generated.src", tmp + "/generated-output.src", "output generation")
fn ca_caller(root, tmp) = let fixture = root + "/tests/fixtures/c_adapter" in let copied = ca_copy(fixture + "/lume.toml", tmp + "/lume.toml") in if copied != "" then copied else let source = "@capability(allow: [\"ffi\"])\n" + fs_read_file(tmp + "/generated.src") + fs_read_file(fixture + "/caller_tail.src") in let written = ca_write(tmp + "/caller.src", source) in if written != "" then written else let built = ca_build(root, tmp + "/caller.src", tmp + "/caller", tmp + "/caller-build.out") in if built != 0 then "cannot build C ABI caller: " + fs_read_file(tmp + "/caller-build.out.err") else let out = tmp + "/actual-output.txt" in let executed = ca_run("/usr/bin/env", Cons("LD_LIBRARY_PATH=" + tmp, Cons(tmp + "/caller", Nil)), out) in if executed != 0 then "C ABI caller failed: " + fs_read_file(out + ".err") else ca_same(fixture + "/expected_output.txt", out, "C ABI execution")
fn ca_provenance(root, tmp) = let source = "@capability(allow: [\"ffi\"])\n" + fs_read_file(tmp + "/generated.src") + "pub fn bad_trusted_return(bytes: str) -> int / {{ffi}} = foreign_c_buffer_weighted_sum(bytes, 1)\nprint 0\n" in let written = ca_write(tmp + "/bad-provenance.src", source) in if written != "" then written else let out = tmp + "/bad-provenance.out" in let rejected = ca_build(root, tmp + "/bad-provenance.src", tmp + "/bad-provenance", out) in if rejected == 0 then "foreign provenance unexpectedly discharged" else if ca_contains(fs_read_file(out + ".err"), "A0003") == 0 then "missing A0003 diagnostic: " + fs_read_file(out + ".err") else if fs_path_exists(tmp + "/bad-provenance") == 1 then "rejected provenance produced an executable" else ""
fn ca_invalid(root, tmp, name) = let header = tmp + "/" + name + ".h" in let fixture = cf_write(tmp, name) in if fixture != 1 then "cannot generate invalid fixture in Lume: " + name else let output = tmp + "/" + name + ".src" in let preserved = ca_write(output, "preserve-existing-output\n") in if preserved != "" then preserved else let json = tmp + "/" + name + ".json" in let rejected = ca_lume(root, Cons("adapt", Cons("c", Cons(header, Cons("-o", Cons(output, Nil))))), json) in if rejected == 0 then "invalid header unexpectedly accepted: " + name else let unchanged = ca_same(output, tmp + "/preserve.expected", "preserved output for " + name) in if unchanged != "" then unchanged else ca_oracle(root, tmp, "@mode invalid\n@path " + json + "\n")
fn ca_invalid_names() = Cons("array", Cons("callback", Cons("duplicate_parameter", Cons("duplicate_symbol", Cons("garbage", Cons("length_type", Cons("mixed", Cons("multiline", Cons("mutable_buffer", Cons("preprocessor", Cons("trailing_comma", Cons("trailing_garbage", Cons("unspecified_arity", Cons("variadic", Nil))))))))))))))
fn ca_invalids(root, tmp, names) = match names
    Nil => ""
    Cons(h, t) => let err_msg = ca_invalid(root, tmp, h) in if err_msg != "" then err_msg else ca_invalids(root, tmp, t)
fn ca_callback(root, tmp) = let fixture = cf_write(tmp, "callback") in if fixture != 1 then "cannot generate callback fixture in Lume" else let json = tmp + "/agent-callback.json" in let rejected = ca_lume(root, Cons("agent", Cons("bind", Cons(tmp + "/callback.h", Nil))), json) in if rejected == 0 then "agent bind unexpectedly accepted a callback" else ca_oracle(root, tmp, "@mode callback\n@path " + json + "\n")
## --- positive `adapt c --preprocess` coverage: an industrial-style header (include guard, empty calling-convention
## macro, struct block, CUDAAPI/extern prefixes) must be rejected by the strict path and accepted, with exactly the
## two prototypes bound and nothing leaked from the struct or macros, by the preprocessing path.
fn ca_raw_header() = "#ifndef LUME_RAW_FIXTURE_H\n#define LUME_RAW_FIXTURE_H\n#include <stdint.h>\n#define CUDAAPI\nstruct raw_ctx {{\n    int64_t handle;\n    int64_t flags;\n}};\nCUDAAPI int64_t raw_buffer_sum(const char *bytes, int64_t bytes_len, int64_t weight);\nextern int64_t raw_text_checksum(const char *text);\n#endif\n"
fn ca_preprocess(root, tmp) = let header = tmp + "/raw_preprocess.h" in let written = ca_write(header, ca_raw_header()) in if written != "" then written else let strict_json = tmp + "/raw-strict.json" in let strict = ca_lume(root, Cons("adapt", Cons("c", Cons("--json", Cons(header, Nil)))), strict_json) in if strict == 0 then "strict adapt c unexpectedly accepted a raw header with #ifndef/#define/struct/CUDAAPI" else let json = tmp + "/raw-preprocess.json" in let status = ca_lume(root, Cons("adapt", Cons("c", Cons("--preprocess", Cons("--json", Cons(header, Nil))))), json) in if status != 0 then "adapt c --preprocess rejected a valid raw header: " + fs_read_file(json) + fs_read_file(json + ".err") else let j = fs_read_file(json) in if ca_contains(j, "\"ok\":true") == 0 or ca_contains(j, "\"mode\":\"bind-raw\"") == 0 or ca_contains(j, "\"preprocessed\":true") == 0 or ca_contains(j, "\"diagnostics\":[]") == 0 then "adapt c --preprocess --json did not report a clean bind-raw manifest: " + j else if ca_contains(j, "\"adapter\":\"foreign_raw_buffer_sum\"") == 0 or ca_contains(j, "\"adapter\":\"foreign_raw_text_checksum\"") == 0 or ca_contains(j, "\"length_parameter\":\"bytes_len\"") == 0 then "adapt c --preprocess --json lost a prototype or the sized-buffer pairing: " + j else if ca_contains(j, "raw_ctx") == 1 or ca_contains(j, "CUDAAPI") == 1 or ca_contains(j, "handle") == 1 then "adapt c --preprocess leaked struct or macro text into the manifest: " + j else let out = tmp + "/raw-preprocess.src" in let emitted = ca_lume(root, Cons("adapt", Cons("c", Cons("--preprocess", Cons(header, Cons("-o", Cons(out, Nil)))))), tmp + "/raw-preprocess.log") in if emitted != 0 then "adapt c --preprocess -o failed: " + fs_read_file(tmp + "/raw-preprocess.log.err") else let g = fs_read_file(out) in if ca_contains(g, "extern \"c\" fn raw_buffer_sum(c_bytes: str, c_bytes_len: int, c_weight: int) -> int\n") == 0 or ca_contains(g, "extern \"c\" fn raw_text_checksum(c_text: str) -> int\n") == 0 or ca_contains(g, "pub fn foreign_raw_buffer_sum(c_bytes: str, c_weight: int) -> unverified[int]") == 0 or ca_contains(g, "pub fn foreign_raw_text_checksum(c_text: str) -> unverified[int]") == 0 then "adapt c --preprocess -o generated unexpected Lume source: " + g else if ca_contains(g, "raw_ctx") == 1 or ca_contains(g, "CUDAAPI") == 1 then "adapt c --preprocess -o leaked struct or macro text into generated source" else ""
fn ca_main(root) = if cf_self_test() == 0 then "Lume fixture integrity check failed" else let tmp = root + "/build/c-adapter-gate" in let prepared = ca_prepare(root, tmp) in if prepared != "" then prepared else let preserved = ca_write(tmp + "/preserve.expected", "preserve-existing-output\n") in if preserved != "" then preserved else let generated = ca_generate(root, tmp) in if generated != "" then generated else let caller = ca_caller(root, tmp) in if caller != "" then caller else let provenance = ca_provenance(root, tmp) in if provenance != "" then provenance else let invalid = ca_invalids(root, tmp, ca_invalid_names()) in if invalid != "" then invalid else let preprocessed = ca_preprocess(root, tmp) in if preprocessed != "" then preprocessed else ca_callback(root, tmp)
fn ca_dispatch(input) = let root = ca_root(input) in if root == "" then ctfail("C adapter gate requires @root\n") else let err_msg = ca_main(root) in if err_msg != "" then ctfail("C adapter gate failed: " + err_msg + "\n") else "C adapter generation, CLI, rejection, provenance, and real shared-library interop passed"
print ca_dispatch(readall())
