## cert_source_gate.src -- gate for the source-to-obligation binding of the proof-certificate kernel
## (`lcert --check-source <file.src>`, compiler/stage1/lcert.src section 6; `lume verify-cert --check-source`).
##
## Usage:
##   printf '@root %s\n' "$PWD" | ./build/bin/cert_source_gate
##
## The kernel without the flag proves that every proof term of a certificate is a theorem. It does not prove that
## the terms are the obligations of the source. This gate pins the difference down with the real tools:
##   1. POSITIVE: three sources (linear contracts, a callee whose body is used by a caller, nonlinear contracts,
##      laws, `@bound` functions, measured and lexicographic recursion, a `total` non-recursive function) are
##      certified by the real `build/bin/lcaas`; plain `lcert` accepts each certificate and `lcert --check-source`
##      binds EVERY obligation (`"unbound":[]`), by argv and by the `@check-source` stdin directive alike.
##   2. NEGATIVE: ten certificates that plain `lcert` ACCEPTS (asserted: each forged certificate is re-hashed, so the
##      tamper-evidence check passes and every term is a true theorem) and `lcert --check-source` REFUSES with the
##      binding diagnostic naming the function: another source (an `ensures` constant differs), a removed obligation,
##      a weakened goal, a strengthened hypothesis, an obligation for a function that is not in the source, a source
##      edited by one byte, a goal whose callee `let` captured a caller parameter, a loosened cycle bound, a descent
##      entry with an invented path hypothesis, a weakened law.
##   3. DRIVER: `lume_driver verify-cert --check-source <file.src> <cert.json>` accepts the bound certificate, fails
##      on a forged one, and `lume_driver verify-cert <cert.json>` still works as before.
##   4. A file of the repository (examples/apps/lume_os/scheduler.src) is certified and checked; the verdict must be
##      self-consistent (`"ok":true` exactly when nothing is unbound and the hash matches).
use fs_sha256_file

fn csg_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn csg_chomp(s) = let n = count(s) in if n == 0 then "" else let c = at(s, n - 1) in if c == "\n" or c == "\r" or c == " " or c == "\t" then csg_chomp(slice(s, 0, n - 1)) else s
fn csg_find_at(s, pat, i, n, m) = if i + m > n then 0 - 1 else if slice(s, i, i + m) == pat then i else csg_find_at(s, pat, i + 1, n, m)
fn csg_find(s, pat, from) = csg_find_at(s, pat, from, count(s), count(pat))
fn csg_has(s, pat) = if csg_find(s, pat, 0) >= 0 then 1 else 0
fn csg_replace(s, was, rep) = let p = csg_find(s, was, 0) in if p < 0 then s else slice(s, 0, p) + rep + slice(s, p + count(was), count(s))
fn csg_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else csg_line_end(s, i + 1)
fn csg_root(input) = if count(input) >= 6 and slice(input, 0, 6) == "@root " then csg_chomp(slice(input, 6, csg_line_end(input, 0))) else ""
## optional input lines `@lcaas <path>`, `@lcert <path>`, `@driver <path>` replace the tools of build/bin
fn csg_get_at(s, key, i) = if i >= count(s) then "" else let e = csg_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then csg_chomp(slice(s, i + n + 2, e)) else csg_get_at(s, key, e + 1)
fn csg_tool(input, key, dflt) = let v = csg_get_at(input, key, 0) in if v == "" then dflt else v
fn csg_first(xs) = match xs
    Nil        => ""
    Cons(h, t) => if h != "" then h else csg_first(t)
fn csg_run_in(bin, args, inp, out, ms) = let raw = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", ms) in {status: csg_wait_exit(raw), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn csg_run(bin, args, out, ms) = let raw = os_run_capture_timeout(bin, args, out, out + ".err", ms) in {status: csg_wait_exit(raw), out: fs_read_file(out), err: fs_read_file(out + ".err")}

## --- the real tools ---
## certify `src` with the real lcaas: {src: path of the source file, cert: the certificate JSON}
fn csg_certify(c, tag, src) = let sp = c.tmp + "/" + tag + ".src" in let ip = c.tmp + "/" + tag + ".in" in let w1 = fs_write_sync(sp, src) in let w2 = fs_write_sync(ip, "@mode certify\n" + src) in let r = csg_run_in(c.lcaas, Nil, ip, c.tmp + "/" + tag + ".cert", 120000) in {src: sp, cert: csg_chomp(r.out)}
## run lcert on a certificate; `src_path` == "" is the plain kernel, anything else adds `--check-source <src_path>`
fn csg_lcert(c, tag, cert, src_path) = let cp = c.tmp + "/" + tag + ".json" in let w = fs_write_sync(cp, cert) in let r = csg_run_in(c.lcert, if src_path == "" then Nil else Cons("--check-source", Cons(src_path, Nil)), cp, c.tmp + "/" + tag + ".out", 120000) in csg_chomp(r.out)
## the same check requested by a first stdin line instead of argv
fn csg_lcert_directive(c, tag, cert, src_path) = let cp = c.tmp + "/" + tag + ".json" in let w = fs_write_sync(cp, "@check-source " + src_path + "\n" + cert) in let r = csg_run_in(c.lcert, Nil, cp, c.tmp + "/" + tag + ".out", 120000) in csg_chomp(r.out)

## --- certificate surgery: the hash scheme of lcert_verify_artifact, reproduced ---
## certificate_hash = sha256(source_hash + "|" + <raw proof_terms array> + "|" + <raw obligations array>)
fn csg_arr_end(s, i, n, depth, in_str) = if i >= n then n else let c = at(s, i) in if in_str == 1 then (if c == "\\" then csg_arr_end(s, i + 2, n, depth, 1) else if c == "\"" then csg_arr_end(s, i + 1, n, depth, 0) else csg_arr_end(s, i + 1, n, depth, 1)) else if c == "\"" then csg_arr_end(s, i + 1, n, depth, 1) else if c == "[" then csg_arr_end(s, i + 1, n, depth + 1, 0) else if c == "]" then (if depth == 1 then i else csg_arr_end(s, i + 1, n, depth - 1, 0)) else csg_arr_end(s, i + 1, n, depth, 0)
fn csg_arr(json, key) = let pat = "\"" + key + "\":[" in let p = csg_find(json, pat, 0) in if p < 0 then "" else let start = p + count(pat) in slice(json, start, csg_arr_end(json, start - 1, count(json), 0, 0))
fn csg_jstr(json, key) = let pat = "\"" + key + "\":\"" in let p = csg_find(json, pat, 0) in if p < 0 then "" else let st = p + count(pat) in slice(json, st, csg_find(json, "\"", st))
fn csg_forge(c, tag, sh, terms, obls) = let pre = c.tmp + "/" + tag + ".pre" in let w = fs_write_sync(pre, sh + "|" + terms + "|" + obls) in "{\"ok\":true,\"source_hash\":\"" + sh + "\",\"certificate_hash\":\"sha256:" + fs_sha256_file(pre) + "\",\"proof_terms\":[" + terms + "],\"obligations\":[" + obls + "]}"
## drop the JSON object that starts with `head` (and one adjacent comma) from a raw array
fn csg_drop_obj(raw, head) = let p = csg_find(raw, head, 0) in if p < 0 then raw else let e = csg_find(raw, "}", p) + 1 in if p == 0 then slice(raw, if e < count(raw) then e + 1 else e, count(raw)) else slice(raw, 0, p - 1) + slice(raw, e, count(raw))

## --- fixtures ---
fn csg_src1() = "## positive sample: every obligation is provable\n" + "fn inc(x: int) -> int\n" + "  requires x >= 0\n" + "  ensures result >= 1\n" + "= x + 1\n" + "\n" + "fn clamp(x, lo, hi) requires lo <= hi ensures result >= lo ensures result <= hi = if x < lo then lo else if x > hi then hi else x\n" + "\n" + "fn twice(x: int) -> int\n" + "  requires x >= 0\n" + "  ensures result >= 2\n" + "= let y = inc(x) in y + inc(x)\n" + "\n" + "fn sq(x: int) -> int\n" + "  requires x >= 0 and x <= 1000\n" + "  ensures result >= 0\n" + "= x * x\n" + "\n" + "@bound(cycles: 40)\n" + "fn lim(d: int, c: int) -> int / pure\n" + "  requires c >= 0 and c <= 100 and d >= 0 - 100 and d <= 100\n" + "  ensures result >= c - 1 and result <= c + 1\n" + "= if d > c + 1 then c + 1 else if d < c - 1 then c - 1 else d\n" + "\n" + "fn absd(a: int, b: int) -> int\n" + "  requires a >= 0 - 1000 and a <= 1000 and b >= 0 - 1000 and b <= 1000\n" + "  ensures result >= 0\n" + "= let d = a - b in if d < 0 or d == 0 then 0 - d else d\n" + "\n" + "fn cd(n: int) -> int\n" + "  terminates (n)\n" + "= if n <= 0 then 0 else cd(n - 1)\n" + "\n" + "total fn idt(n: int) -> int = n + 1\n" + "\n" + "law inc_mono(a: int) = if a >= 0 then inc(a) > a else 1 == 1\n" + "\n" + "law sq_nonneg(a: int) = if a >= 0 and a <= 100 then sq(a) >= 0 else true\n" + "\n" + "print twice(3)\n"
fn csg_src2() = "## kernels: typed parameters, effect rows, elif, newline lets, a callee chain, a law over a callee, measures\n" + "@bound(cycles: 64)\n" + "fn sat_add(a: int, b: int, cap: int) -> int / pure\n" + "  requires a >= 0 and b >= 0 and cap >= 0 and a <= 1000000 and b <= 1000000\n" + "  ensures result >= 0 and result <= cap\n" + "= let s = a + b in if s > cap then cap elif s < 0 then 0 else s\n" + "\n" + "fn dist(a: int, b: int) -> int\n" + "  requires a >= -1000 and a <= 1000 and b >= -1000 and b <= 1000\n" + "  ensures result >= 0\n" + "= if a >= b then a - b else b - a\n" + "\n" + "fn dist3(a: int, b: int, c: int) -> int\n" + "  requires a >= -1000 and a <= 1000 and b >= -1000 and b <= 1000 and c >= -1000 and c <= 1000\n" + "  ensures result >= 0\n" + "=\n" + "  let d1 = dist(a, b)\n" + "  let d2 = dist(b, c)\n" + "  d1 + d2\n" + "\n" + "law dist_sym(a: int, b: int) = if a >= -100 and a <= 100 and b >= -100 and b <= 100 then dist(a, b) == dist(b, a) else true\n" + "\n" + "total fn gauss(n: int, acc: int) -> int\n" + "  terminates (n)\n" + "= if n > 0 then gauss(n - 1, acc + n) else acc\n" + "\n" + "fn ack_like(m: int, n: int) -> int\n" + "  terminates (m, n)\n" + "= if m <= 0 then n + 1 else if n <= 0 then ack_like(m - 1, 1) else ack_like(m, n - 1)\n" + "\n" + "print dist3(1, 5, 2)\n"
fn csg_src3() = "## nonlinear contracts\n" + "fn area(w: int, h: int) -> int\n" + "  requires w >= 1 and w <= 1000 and h >= 1 and h <= 1000\n" + "  ensures result >= 1\n" + "= w * h\n" + "\n" + "fn sq_plus(x: int) -> int requires x >= 0 and x <= 1000 ensures result >= x = x * x + x\n" + "\n" + "fn half(total: int) -> int\n" + "  requires total >= 0\n" + "  ensures result >= 0 and result <= total\n" + "= total / 2\n" + "\n" + "law area_comm(w: int, h: int) = if w >= 1 and w <= 100 and h >= 1 and h <= 100 then area(w, h) == area(h, w) else true\n" + "\n" + "print area(3, 4)\n"
## `f(t) = 1 + t`, so `ensures result == 2` is FALSE. Hoisting the callee's `let t = 1` above the caller's goal without
## renaming makes `t` read as 1 and the goal `1 + 1 == 2`, a true theorem about another function.
fn csg_src_capture() = "fn g(a: int) -> int = let t = a in t\n" + "fn f(t: int) -> int ensures result == 2 = let y = g(1) in y + t\n" + "print f(5)\n"

## --- 1. positive ---
fn csg_pos(c, tag, src, want) = let k = csg_certify(c, tag, src) in let plain = csg_lcert(c, tag + ".plain", k.cert, "") in let sb = csg_lcert(c, tag + ".sb", k.cert, k.src) in let dv = csg_lcert_directive(c, tag + ".dir", k.cert, k.src) in if csg_has(k.cert, "\"ok\":true") == 0 then tag + ": lcaas did not certify the fixture: " + k.cert else if csg_has(plain, "\"ok\":true") == 0 or csg_has(plain, "source_binding") == 1 then tag + ": plain lcert did not accept the real certificate unchanged: " + plain else if csg_has(sb, "\"ok\":true") == 0 or csg_has(sb, "\"ok\":false") == 1 or csg_has(sb, "\"kernel_verified\":true") == 0 then tag + ": --check-source did not accept the real certificate: " + sb else if csg_has(sb, "\"source_binding\":{\"checked\":true,\"source_sha256\":\"sha256:" + fs_sha256_file(k.src) + "\",") == 0 then tag + ": --check-source did not report the hash of the source file: " + sb else if csg_has(sb, want + ",\"unbound\":[]}") == 0 then tag + ": --check-source did not bind every obligation (wanted " + want + "): " + sb else if dv != sb then tag + ": the @check-source stdin directive and the argv form disagree: " + dv else ""

## --- 2. negative: plain lcert accepts, --check-source refuses with `code` and names `who` ---
fn csg_neg(c, tag, cert, src_path, code, who) = let plain = csg_lcert(c, tag + ".plain", cert, "") in let sb = csg_lcert(c, tag + ".sb", cert, src_path) in if csg_has(plain, "\"ok\":true") == 0 or csg_has(plain, "\"kernel_verified\":true") == 0 then tag + ": plain lcert does not accept this certificate, so the contrast is lost: " + plain else if csg_has(sb, "\"ok\":false") == 0 or csg_has(sb, "\"ok\":true") == 1 or csg_has(sb, "\"kernel_verified\":true") == 1 then tag + ": --check-source ACCEPTED a certificate that is not bound to the source: " + sb else if csg_has(sb, "\"source_binding\":{\"checked\":true") == 0 or csg_has(sb, "[" + code + "]") == 0 or csg_has(sb, who) == 0 then tag + ": --check-source refused without the diagnostic [" + code + "] naming " + who + ": " + sb else ""
fn csg_changed(tag, a, b) = if a == b then tag + ": the forgery did not change the certificate (fixture drift)" else ""
## `f` holds the pieces of the real certificate of csg_src1 and their forged variants (built in csg_negs)
fn csg_neg_controls(c, k, f) = Cons(if csg_has(f.ident, "\"ok\":true") == 1 and csg_has(f.ident, "\"unbound\":[]}") == 1 then "" else "control: a re-hashed but unmodified certificate must still bind (the forging procedure is wrong): " + f.ident, Cons(csg_changed("a", csg_src1(), fs_read_file(f.src_b)), Cons(csg_changed("b-terms", f.terms, f.t_b), Cons(csg_changed("b-obligations", f.obls, f.o_b), Cons(csg_changed("c", f.terms, f.t_c), Cons(csg_changed("d", f.terms, f.t_d), Cons(csg_changed("f", csg_src1(), fs_read_file(f.src_f)), Cons(csg_changed("h", f.terms, f.t_h), Cons(csg_changed("i", f.terms, f.t_i), Cons(csg_changed("j", f.terms, f.t_j), Nil))))))))))
fn csg_neg_cases(c, k, f) = Cons(csg_neg(c, "a-other-source", k.cert, f.src_b, "K0010", "source_hash"), Cons(csg_neg(c, "a-other-source-term", k.cert, f.src_b, "K0013", "contract 'inc'"), Cons(csg_neg(c, "b-removed-obligation", csg_forge(c, "b", f.sh, f.t_b, f.o_b), k.src, "K0011", "contract 'sq'"), Cons(csg_neg(c, "c-weakened-goal", csg_forge(c, "c", f.sh, f.t_c, f.obls), k.src, "K0013", "contract 'inc'"), Cons(csg_neg(c, "d-strengthened-hypothesis", csg_forge(c, "d", f.sh, f.t_d, f.obls), k.src, "K0013", "contract 'inc'"), Cons(csg_neg(c, "e-absent-function", csg_forge(c, "e", f.sh, f.t_e, f.o_e), k.src, "K0012", "contract 'ghost'"), Cons(csg_neg(c, "f-source-edited", k.cert, f.src_f, "K0010", "source_hash"), Cons(csg_neg(c, "h-loosened-bound", csg_forge(c, "h", f.sh, f.t_h, f.obls), k.src, "K0013", "wcet 'lim'"), Cons(csg_neg(c, "i-invented-path-hypothesis", csg_forge(c, "i", f.sh, f.t_i, f.obls), k.src, "K0013", "termination 'cd'"), Cons(csg_neg(c, "j-weakened-law", csg_forge(c, "j", f.sh, f.t_j, f.obls), k.src, "K0013", "law 'inc_mono'"), Nil))))))))))
fn csg_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, csg_app(t, ys))
fn csg_neg_list(c, k, f) = csg_app(csg_neg_controls(c, k, f), csg_neg_cases(c, k, f))
fn csg_negs(c, k) = let sh = csg_jstr(k.cert, "source_hash") in let terms = csg_arr(k.cert, "proof_terms") in let obls = csg_arr(k.cert, "obligations") in let ident = csg_lcert(c, "ident.sb", csg_forge(c, "ident", sh, terms, obls), k.src) in let src_b = c.tmp + "/other.src" in let wb = fs_write_sync(src_b, csg_replace(csg_src1(), "  ensures result >= 1\n= x + 1\n", "  ensures result >= 0\n= x + 1\n")) in let src_f = c.tmp + "/edited.src" in let wf = fs_write_sync(src_f, csg_replace(csg_src1(), "is provable\n", "is provablE\n")) in let t_b = csg_drop_obj(terms, "{\"name\":\"sq\",\"kind\":\"contract\"") in let o_b = csg_drop_obj(obls, "{\"name\":\"sq\",\"kind\":\"contract\"") in let t_c = csg_replace(terms, "(implies (and (>= x 0)) (>= (+ x 1) 1))", "(implies (and (>= x 0)) (>= (+ x 1) 0))") in let t_d = csg_replace(terms, "(implies (and (>= x 0)) (>= (+ x 1) 1))", "(implies (and (>= x 5)) (>= (+ x 1) 1))") in let t_e = terms + ",{\"name\":\"ghost\",\"kind\":\"contract\",\"term\":\"(implies (and (>= z 0)) (>= (+ z 1) 1))\",\"checked\":true}" in let o_e = obls + ",{\"name\":\"ghost\",\"kind\":\"contract\",\"status\":\"proven\",\"obligation\":\"(>= z 0) => (>= result 1)\",\"counterexample\":\"\"}" in let t_h = csg_replace(terms, "wcet_budget(17 <= 40)", "wcet_budget(17 <= 4000)") in let t_i = csg_replace(terms, "(call (and (> n 0)) (- n 1))", "(call (and (> n 0) (> n 7)) (- n 1))") in let t_j = csg_replace(terms, "(> (+ a 1) a)", "(>= (+ a 1) a)") in csg_first(csg_neg_list(c, k, {sh: sh, terms: terms, obls: obls, ident: ident, src_b: src_b, src_f: src_f, t_b: t_b, o_b: o_b, t_c: t_c, t_d: t_d, t_e: t_e, o_e: o_e, t_h: t_h, t_i: t_i, t_j: t_j}))
## the captured goal is a true theorem (plain lcert proves it) about a FALSE contract; the kernel reader renames, so it refuses
fn csg_neg_capture(c) = let sp = c.tmp + "/capture.src" in let w = fs_write_sync(sp, csg_src_capture()) in let terms = "{\"name\":\"f\",\"kind\":\"contract\",\"term\":\"(implies (and) (let t 1 (let ?L0.y t (== (+ ?L0.y t) 2))))\",\"checked\":true}" in let obls = "{\"name\":\"f\",\"kind\":\"contract\",\"status\":\"proven\",\"obligation\":\" => (== result 2)\",\"counterexample\":\"\"}" in csg_neg(c, "g-captured-parameter", csg_forge(c, "g", "sha256:" + fs_sha256_file(sp), terms, obls), sp, "K0013", "contract 'f'")

## --- 2b. what the honest lcaas emits when a callee's `let` has the name of a caller parameter ---
## `g` binds `t`, `f` has a parameter `t` and mentions it after the call. lcaas used to hoist `let t = 1` over the
## caller's `t` (capture). Now the hoisted binder is renamed: for the TRUE contract the certificate is accepted by the
## plain kernel and bound to the source, its term keeps the caller's `t` free; for the FALSE contract lcaas refuses to
## certify and its term, even with the status forged to proven, is not a theorem (the plain kernel refuses it too).
fn csg_cap_true() = "fn g(a: int) -> int = let t = a in t\nfn f(t: int) -> int requires t >= 0 ensures result == t + 1 = let y = g(1) in y + t\n"
fn csg_cap_false() = "fn g(a: int) -> int = let t = a in t\nfn f(t: int) -> int requires t >= 0 ensures result == 2 = let y = g(1) in y + t\n"
fn csg_cap_honest(c) = let kt = csg_certify(c, "cap_true", csg_cap_true()) in let kf = csg_certify(c, "cap_false", csg_cap_false()) in let pt = csg_lcert(c, "cap_true.plain", kt.cert, "") in let bt = csg_lcert(c, "cap_true.sb", kt.cert, kt.src) in let forged = csg_replace(kf.cert, "\"name\":\"f\",\"kind\":\"contract\",\"status\":\"refuted\"", "\"name\":\"f\",\"kind\":\"contract\",\"status\":\"proven\"") in let pf = csg_lcert(c, "cap_false.plain", forged, "") in if csg_has(kt.cert, "\"ok\":true") == 0 or csg_has(kt.cert, "(let t 1 ") == 1 or csg_has(kt.cert, "(== (+ ?L0.y t) (+ t 1))") == 0 then "capture: lcaas did not emit a capture-free term for the true contract: " + kt.cert else if csg_has(pt, "\"ok\":true") == 0 or csg_has(bt, "\"ok\":true") == 0 or csg_has(bt, "\"unbound\":[]}") == 0 then "capture: the capture-free certificate is not accepted and bound: " + pt + bt else if csg_has(kf.cert, "\"ok\":true") == 1 or csg_has(kf.cert, "(let t 1 ") == 1 then "capture: lcaas certified the false contract or still emits the capturing term: " + kf.cert else if csg_has(pf, "\"ok\":true") == 1 then "capture: the term lcaas emits for the false contract is accepted by the plain kernel once its status is forged: " + pf else ""

## --- 2c. the plain kernel: false terms an earlier kernel proved (or died on), each with a TRUE control ---
## A one-entry certificate named `k`, status `proven`, re-hashed. The control (the same statement spelled with the
## kernel's own operators) must be accepted, so a refusal is the term's doing, not the envelope's.
fn csg_k_term(t) = "{\"name\":\"k\",\"kind\":\"contract\",\"term\":\"" + t + "\",\"checked\":true}"
fn csg_k_obl() = "{\"name\":\"k\",\"kind\":\"contract\",\"status\":\"proven\",\"obligation\":\"forged\",\"counterexample\":\"\"}"
fn csg_refused(r) = if csg_has(r, "\"ok\":false") == 1 and csg_has(r, "\"ok\":true") == 0 and csg_has(r, "\"kernel_verified\":true") == 0 then 1 else 0
fn csg_kern1(c, tag, sh, bad, good) = let rb = csg_lcert(c, tag + ".bad", csg_forge(c, tag + "b", sh, csg_k_term(bad), csg_k_obl()), "") in let rg = csg_lcert(c, tag + ".good", csg_forge(c, tag + "g", sh, csg_k_term(good), csg_k_obl()), "") in if csg_has(rg, "\"ok\":true") == 0 or csg_has(rg, "\"kernel_verified\":true") == 0 then tag + ": the plain kernel refuses the TRUE control " + good + ": " + rg else if csg_refused(rb) == 0 then tag + ": the plain kernel ACCEPTED (or gave no verdict on) the false term " + bad + ": " + rb else ""
## the kernel reads the first `term` / `proof_terms`; a reader that keeps the last one would see the false term
fn csg_kern_dup(c, sh) = let good = "(implies (and) (== 1 1))" in let bad = "(implies (and) (== 1 2))" in let cert = csg_forge(c, "dup0", sh, csg_k_term(good), csg_k_obl()) in let r0 = csg_lcert(c, "dup0", cert, "") in let r1 = csg_lcert(c, "dup1", csg_forge(c, "dup1", sh, "{\"name\":\"k\",\"kind\":\"contract\",\"term\":\"" + good + "\",\"term\":\"" + bad + "\",\"checked\":true}", csg_k_obl()), "") in let r2 = csg_lcert(c, "dup2", slice(cert, 0, count(cert) - 1) + ",\"proof_terms\":[" + csg_k_term(bad) + "]}", "") in let r3 = csg_lcert(c, "dup3", csg_forge(c, "dup3", sh, csg_k_term(good), "{\"name\":\"k\",\"kind\":\"contract\",\"status\":\"proven\",\"status\":\"refuted\",\"obligation\":\"forged\",\"counterexample\":\"\"}"), "") in if csg_has(r0, "\"ok\":true") == 0 then "dup: the control certificate is refused: " + r0 else if csg_refused(r1) == 0 then "dup: an entry with two `term` keys is accepted: " + r1 else if csg_refused(r2) == 0 then "dup: a certificate with two `proof_terms` arrays is accepted: " + r2 else if csg_refused(r3) == 0 then "dup: an entry with two `status` keys is accepted: " + r3 else ""
## a call tree of fan-out 4, six levels: its term is exponentially large. lcaas must not certify it and the kernel
## reader must answer (it used to exhaust the heap) and refuse to bind it.
fn csg_fan_calls(i, k) = if k <= 0 then "" else " + g" + str(i - 1) + "(t + 1)" + csg_fan_calls(i, k - 1)
fn csg_fan_fns(i) = if i > 6 then "" else "fn g" + str(i) + "(t: int) -> int = if t < 0 then g" + str(i - 1) + "(t)" + csg_fan_calls(i, 3) + " else t\n" + csg_fan_fns(i + 1)
fn csg_fan_src() = "fn g0(t: int) -> int = t + 1\n" + csg_fan_fns(1) + "fn top(t: int) -> int requires t >= 0 ensures result >= 0 = g6(t)\nprint top(1)\n"
fn csg_kern_big(c) = let k = csg_certify(c, "big", csg_fan_src()) in let sb = csg_lcert(c, "big.sb", k.cert, k.src) in let pl = csg_lcert(c, "big.plain", k.cert, "") in if csg_has(k.cert, "\"term\":\"(implies (and) oversize)\",\"checked\":false") == 0 or csg_has(k.cert, "\"ok\":true") == 1 then "oversize: lcaas did not mark the oversize obligation as unchecked: " + slice(k.cert, 0, if count(k.cert) < 600 then count(k.cert) else 600) else if csg_refused(pl) == 0 then "oversize: the plain kernel did not refuse the oversize term: " + pl else if csg_refused(sb) == 0 or csg_has(sb, "contract 'top'") == 0 or csg_has(sb, "\"obligations_bound\":0") == 0 then "oversize: --check-source did not answer with a refusal naming contract 'top': " + sb else ""
fn csg_kernel(c) = let sp = c.tmp + "/k.src" in let w = fs_write_sync(sp, "print 1\n") in let sh = "sha256:" + fs_sha256_file(sp) in csg_first(Cons(csg_kern1(c, "k-literal-overflow", sh, "(implies (and) (== 18446744073709551617 1))", "(implies (and) (== 1 1))"), Cons(csg_kern1(c, "k-literal-min", sh, "(implies (and) (== -9223372036854775808 0))", "(implies (and) (== -5 (- 0 5)))"), Cons(csg_kern1(c, "k-atom-product", sh, "(implies (and (>= x 2) (<= x 2) (>= y 3) (<= y 3)) (== x*y 6))", "(implies (and (>= x 2) (<= x 2) (>= y 3) (<= y 3)) (== (* x y) 6))"), Cons(csg_kern1(c, "k-atom-index", sh, "(implies (and) (== (array_select a 0+2*x) (array_select a (* 2 x))))", "(implies (and) (== (array_select a (* 2 x)) (array_select a (* 2 x))))"), Cons(csg_kern1(c, "k-atom-field", sh, "(implies (and) (== (field (field a b) c) (field a.b c)))", "(implies (and) (== (field (field a b) c) (field (field a b) c)))"), Cons(csg_kern_dup(c, sh), Cons(csg_kern_big(c), Nil))))))))

## --- 3. driver ---
fn csg_driver(c, k) = let good = c.tmp + "/drv_good.json" in let bad = c.tmp + "/drv_bad.json" in let w1 = fs_write_sync(good, k.cert) in let w2 = fs_write_sync(bad, csg_forge(c, "drv", csg_jstr(k.cert, "source_hash"), csg_replace(csg_arr(k.cert, "proof_terms"), "(implies (and (>= x 0)) (>= (+ x 1) 1))", "(implies (and (>= x 0)) (>= (+ x 1) 0))"), csg_arr(k.cert, "obligations"))) in let r1 = csg_run(c.driver, Cons("verify-cert", Cons("--check-source", Cons(k.src, Cons(good, Nil)))), c.tmp + "/drv1.out", 180000) in let r2 = csg_run(c.driver, Cons("verify-cert", Cons("--check-source", Cons(k.src, Cons(bad, Nil)))), c.tmp + "/drv2.out", 180000) in let r3 = csg_run(c.driver, Cons("verify-cert", Cons(bad, Nil)), c.tmp + "/drv3.out", 180000) in if r1.status != 0 or csg_has(r1.out, "\"ok\":true") == 0 or csg_has(r1.out, "\"unbound\":[]}") == 0 then "driver: verify-cert --check-source did not accept the bound certificate (status " + str(r1.status) + "): " + r1.out + r1.err else if r2.status == 0 or csg_has(r2.out + r2.err, "[K0013]") == 0 then "driver: verify-cert --check-source did not fail on the forged certificate (status " + str(r2.status) + "): " + r2.out + r2.err else if r3.status != 0 or csg_has(r3.out, "\"ok\":true") == 0 or csg_has(r3.out, "source_binding") == 1 then "driver: plain verify-cert changed behaviour (status " + str(r3.status) + "): " + r3.out + r3.err else ""

## --- 4. a file of the repository: whatever the verdict, it must be self-consistent ---
fn csg_repo(c, rel) = let path = c.root + "/" + rel in if fs_path_exists(path) == 0 then {err: rel + " is missing", note: ""} else let k = csg_certify(c, "repo", fs_read_file(path)) in let sb = csg_lcert(c, "repo.sb", k.cert, path) in let clean = if csg_has(sb, "\"unbound\":[]}") == 1 then 1 else 0 in let okv = csg_has(sb, "\"ok\":true") in let plain = csg_has(csg_lcert(c, "repo.plain", k.cert, ""), "\"ok\":true") in if csg_has(sb, "\"source_binding\":{\"checked\":true,\"source_sha256\":\"sha256:" + fs_sha256_file(path) + "\",") == 0 then {err: rel + ": no source_binding report: " + sb, note: ""} else if okv == 1 and (clean == 0 or plain == 0) then {err: rel + ": accepted although something is unbound or the plain kernel refuses: " + sb, note: ""} else if okv == 0 and clean == 1 and plain == 1 then {err: rel + ": refused although every obligation is bound: " + sb, note: ""} else {err: "", note: rel + (if okv == 1 then " fully bound" else " not accepted (unbound obligations are reported)")}

fn csg_main(input) = let root = csg_root(input) in if root == "" then ctfail("cert source gate requires @root\n") else let tmp = root + "/build/cert-source-gate-" + str(os_getpid()) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil))) in let c = {root: root, tmp: tmp, lcaas: csg_tool(input, "lcaas", root + "/build/bin/lcaas"), lcert: csg_tool(input, "lcert", root + "/build/bin/lcert"), driver: csg_tool(input, "driver", root + "/build/bin/lume_driver")} in if fs_path_exists(c.lcaas) == 0 or fs_path_exists(c.lcert) == 0 or fs_path_exists(c.driver) == 0 then ctfail("cert source gate requires build/bin/lcaas, build/bin/lcert and build/bin/lume_driver\n") else let k1 = csg_certify(c, "s1", csg_src1()) in let rp = csg_repo(c, "examples/apps/lume_os/scheduler.src") in let rl = csg_repo(c, "compiler/stage1/lstd.src") in let rlerr = if rl.err != "" then rl.err else if csg_has(rl.note, "fully bound") == 0 then "compiler/stage1/lstd.src is not fully bound (its SIMD intrinsic kernel included): " + rl.note else "" in let err = csg_first(Cons(rlerr, Cons(csg_cap_honest(c), Cons(csg_pos(c, "p1-linear-law-bound-measure", csg_src1(), "\"functions_with_contracts\":6,\"obligations_bound\":11"), Cons(csg_pos(c, "p2-kernels-callee-lexicographic", csg_src2(), "\"functions_with_contracts\":3,\"obligations_bound\":7"), Cons(csg_pos(c, "p3-nonlinear", csg_src3(), "\"functions_with_contracts\":3,\"obligations_bound\":4"), Cons(csg_negs(c, k1), Cons(csg_neg_capture(c), Cons(csg_kernel(c), Cons(csg_driver(c, k1), Cons(rp.err, Nil))))))))))) in if err != "" then ctfail("cert source gate failed: " + err + "\n(work directory kept: " + tmp + ")\n") else let rm = os_run("/bin/rm", Cons("-rf", Cons(tmp, Nil))) in "OK: cert_source_gate: 3 sources certified by lcaas bind every obligation (22 bound, argv and stdin directive); 10 certificate/source pairs that plain lcert accepts are refused by --check-source ([K0010] other/edited source, [K0011] removed obligation, [K0012] absent function, [K0013] weakened goal, strengthened hypothesis, captured parameter, loosened bound, invented path hypothesis, weakened law); lcaas renames a hoisted callee `let` that would capture a caller parameter (true contract accepted and bound, false contract not certified and not provable when forged); plain kernel refuses 5 false terms an earlier kernel proved or died on (19+ digit literals, atoms spelled like the solver's unknowns `x*y`, `0+2*x`, `a.b`) and accepts their true controls, refuses duplicated `term` / `status` / `proof_terms` keys, and an oversize obligation is neither certified by lcaas nor bound (the reader answers instead of exhausting the heap); driver verify-cert --check-source accepts/refuses; " + rp.note + "; " + rl.note + " (simd_add4_i64 / simd_sub4_i64 read as 4 * (a + b) / 4 * (a - b), the lowering lcaas certifies)"

print csg_main(readall())
