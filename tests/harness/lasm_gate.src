use lasm_fixtures

fn la_run(path, args, out) = os_run_capture_timeout(path, args, out, out + ".err", 120000)
fn la_input(path, input, out) = os_run_input_capture_timeout(path, Nil, input, out, out + ".err", 120000)
fn la_lume(root, args, out) = la_run(root + "/lume", args, out)
fn la_seed(root) = root + "/bootstrap/lume0/lume0"
fn la_chmod(path) = la_run("/bin/chmod", Cons("+x", Cons(path, Nil)), path + ".chmod.out")

fn la_prepare(root, tmp) = let parent = fs_mkdir(root + "/build") in if parent != 1 then "cannot create assembly gate parent" else let removed = la_run("/bin/rm", Cons("-rf", Cons(tmp, Nil)), tmp + ".rm.out") in if removed != 0 then "cannot reset assembly gate directory" else let made = la_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil)), tmp + ".mkdir.out") in if made != 0 then "cannot create assembly gate directory" else let built = la_lume(root, Cons("build", Cons(root + "/compiler/stage1/lasm.src", Cons("-o", Cons(tmp + "/lasm", Nil)))), tmp + "/lasm-build.out") in if built != 0 then "cannot build native lasm: " + fs_read_file(tmp + "/lasm-build.out.err") else ""

fn la_execute(path, expected, out) = let status = la_run(path, Nil, out) in if status != 0 then "native executable failed with status " + str(status) + ": " + fs_read_file(out + ".err") else if fs_read_file(out) != expected then "native executable output mismatch: " + fs_read_file(out) else ""

fn la_hello(root, tmp) = let source = lf_write(tmp, "elf_hello") in if source != 1 then "cannot generate ELF hello fixture" else let binary = tmp + "/elf_hello" in let assembled = la_run(la_seed(root), Cons("asm", Cons(tmp + "/elf_hello.s", Cons(binary, Nil))), tmp + "/elf-hello-asm.out") in if assembled != 0 then "seed assembler rejected ELF hello" else let executable = la_chmod(binary) in if executable != 0 then "cannot mark ELF hello executable" else la_execute(binary, "lume native elf\n", tmp + "/elf-hello-run.out")

fn la_collisions(root, tmp) = let source = lf_write(tmp, "symbol_collisions") in if source != 1 then "cannot generate symbol collision fixture" else let native = tmp + "/collisions-native" in let seed = tmp + "/collisions-seed" in let assembled = la_input(tmp + "/lasm", tmp + "/symbol_collisions.s", native) in if assembled != 0 then "native lasm rejected symbol collisions" else let oracle = la_run(la_seed(root), Cons("asm", Cons(tmp + "/symbol_collisions.s", Cons(seed, Nil))), tmp + "/collisions-seed.out") in if oracle != 0 then "seed assembler rejected symbol collisions" else if fs_files_equal(native, seed) != 1 then "native and seed ELFs differ for symbol collisions" else let executable = la_chmod(native) in if executable != 0 then "cannot mark collision ELF executable" else la_execute(native, "", tmp + "/collisions-run.out")

fn la_local_labels(root, tmp) = let source = lf_write(tmp, "local_labels") in if source != 1 then "cannot generate local label fixture" else let native = tmp + "/local-native" in let seed = tmp + "/local-seed" in let assembled = la_input(tmp + "/lasm", tmp + "/local_labels.s", native) in if assembled != 0 then "native lasm rejected local labels" else let oracle = la_run(la_seed(root), Cons("asm", Cons(tmp + "/local_labels.s", Cons(seed, Nil))), tmp + "/local-seed.out") in if oracle != 0 then "seed assembler rejected local labels" else let native_executable = la_chmod(native) in let seed_executable = la_chmod(seed) in if native_executable != 0 or seed_executable != 0 then "cannot mark local label ELFs executable" else let correct = la_execute(native, "ok\n", tmp + "/local-native-run.out") in if correct != "" then correct else let wrong = la_run(seed, Nil, tmp + "/local-seed-run.out") in if wrong == 0 and fs_read_file(tmp + "/local-seed-run.out") == "ok\n" then "seed unexpectedly resolved reused local labels correctly" else ""

fn la_movabs(root, tmp) = let source = lf_write(tmp, "movabs_boundaries") in if source != 1 then "cannot generate movabs boundary fixture" else let native = tmp + "/movabs-native" in let seed = tmp + "/movabs-seed" in let assembled = la_input(tmp + "/lasm", tmp + "/movabs_boundaries.s", native) in if assembled != 0 then "native lasm rejected movabs boundaries" else let oracle = la_run(la_seed(root), Cons("asm", Cons(tmp + "/movabs_boundaries.s", Cons(seed, Nil))), tmp + "/movabs-seed.out") in if oracle != 0 then "seed assembler rejected movabs boundaries" else if fs_files_equal(native, seed) != 1 then "native and seed ELFs differ for movabs boundaries" else ""

## --- strict mode (#428): an unresolved call target must be a named compile error ([L0001], exit
## non-zero, no ELF bytes), while the default mode keeps the historical address-0 resolution so
## the byte-compat oracle above is unaffected. FAILs the gate if either property regresses.
fn la_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else la_contains_at(text, part, i + 1)
fn la_contains(text, part) = la_contains_at(text, part, 0)
fn la_is_elf(path) = if fs_read_byte(path, 0) == 127 and fs_read_byte(path, 1) == 69 and fs_read_byte(path, 2) == 76 and fs_read_byte(path, 3) == 70 then 1 else 0
fn la_bytes_at(path, i, bs) = match bs
    Nil        => 1
    Cons(h, t) => if fs_read_byte(path, i) != h then 0 else la_bytes_at(path, i + 1, t)
fn la_find_bytes(path, i, bs) = if fs_read_byte(path, i) < 0 then 0 - 1 else if la_bytes_at(path, i, bs) == 1 then i else la_find_bytes(path, i + 1, bs)

fn la_strict_undefined(root, tmp) = let asm = tmp + "/undefined_call.s" in let written = fs_write_sync(asm, "    .section .text\n_start:\n    call missing_fn\n    ret\n") in if written != 1 then "cannot write undefined-call fixture" else let strict_out = tmp + "/undef-strict.elf" in let strict_status = la_run(tmp + "/lasm", Cons("--strict", Cons(asm, Nil)), strict_out) in if strict_status == 0 then "lasm --strict accepted an undefined call target (expected [L0001])" else let err = fs_read_file(strict_out + ".err") in if la_contains(err, "missing_fn") == 0 or la_contains(err, "[L0001]") == 0 then "lasm --strict error must name the symbol with [L0001], got:\n" + err else if la_is_elf(strict_out) == 1 then "lasm --strict failure still wrote ELF bytes to its output (expected a 0-byte or non-ELF file)" else if fs_read_byte(strict_out, 0) >= 0 then "lasm --strict failure wrote a non-empty output file (expected 0 bytes)" else let lenient_out = tmp + "/undef-lenient.elf" in let lenient_status = la_run(tmp + "/lasm", Cons(asm, Nil), lenient_out) in if lenient_status != 0 then "lasm default mode rejected the undefined-call fixture (compat address-0 resolution must be preserved)" else if fs_files_equal(strict_out, lenient_out) == 1 then "lasm --strict still emitted an ELF for the undefined-call fixture" else ""

fn la_vex_evex_simd(root, tmp) = let vex_asm = tmp + "/vex_simd.s" in let w1 = fs_write_sync(vex_asm, "    .section .bss\n    .lcomm vbuf, 64\n    .section .rodata\nokv:\n    .asciz \"simd110\\n\"\nbadv:\n    .asciz \"bad\\n\"\n    .section .text\n    .globl _start\n_start:\n    leaq vbuf(%rip), %r10\n    leaq vbuf+32(%rip), %r11\n    movq $10, (%r10)\n    movq $20, 8(%r10)\n    movq $30, 16(%r10)\n    movq $40, 24(%r10)\n    movq $1, (%r11)\n    movq $2, 8(%r11)\n    movq $3, 16(%r11)\n    movq $4, 24(%r11)\n    vmovdqu (%r10), %ymm0\n    vmovdqu (%r11), %ymm1\n    vpaddq %ymm1, %ymm0, %ymm0\n    vmovdqu %ymm0, (%r10)\n    vzeroupper\n    movq (%r10), %rax\n    addq 8(%r10), %rax\n    addq 16(%r10), %rax\n    addq 24(%r10), %rax\n    cmpq $110, %rax\n    jne 1f\n    leaq okv(%rip), %rsi\n    movq $8, %rdx\n    jmp 2f\n1:\n    leaq badv(%rip), %rsi\n    movq $4, %rdx\n2:\n    movq $1, %rax\n    movq $1, %rdi\n    syscall\n    movq $60, %rax\n    xorq %rdi, %rdi\n    syscall\n") in if w1 != 1 then "cannot write VEX SIMD fixture" else let vex_elf = tmp + "/vex_simd.elf" in let a1 = la_input(tmp + "/lasm", vex_asm, vex_elf) in if a1 != 0 then "lasm rejected VEX AVX2 SIMD fixture" else let c1 = la_chmod(vex_elf) in let r1 = la_execute(vex_elf, "simd110\n", tmp + "/vex_simd.run") in if r1 != "" then r1 else let evex_asm = tmp + "/evex_simd.s" in let w2 = fs_write_sync(evex_asm, "    .section .text\n    .globl _start\n_start:\n    vpaddq %zmm1, %zmm0, %zmm0\n    vpmullq %zmm1, %zmm0, %zmm0\n    ret\n") in let evex_elf = tmp + "/evex_simd.elf" in let a2 = la_input(tmp + "/lasm", evex_asm, evex_elf) in if a2 != 0 then "lasm rejected EVEX AVX-512 SIMD fixture" else if la_is_elf(evex_elf) != 1 then "lasm EVEX output is not an ELF image" else let evex_code = Cons(98, Cons(241, Cons(253, Cons(72, Cons(212, Cons(193, Cons(98, Cons(242, Cons(253, Cons(72, Cons(64, Cons(193, Cons(195, Nil))))))))))))) in if la_find_bytes(evex_elf, 0, evex_code) < 0 then "lasm EVEX encoding mismatch: expected 62 F1 FD 48 D4 C1 (vpaddq zmm) + 62 F2 FD 48 40 C1 (vpmullq zmm) + C3 in the ELF image" else ""

## --- differential assembler verification: lasm vs GNU as + objcopy -O binary, byte for byte.
## Branch targets are local (non-global) labels >127 bytes away so GAS resolves them at assembly
## time as rel32; all %rip references stay inside .text so the .o carries no relocations.
fn la_bat_branch() = "    .section .text\n_start:\nbat_top:\n    jmp bat_far\n    je bat_far\n    jne bat_far\n    jl bat_far\n    jg bat_far\n    jle bat_far\n    jge bat_far\n    js bat_far\n    jns bat_far\n    jo bat_far\n    jno bat_far\n    jc bat_far\n    jnc bat_far\n    call bat_far\n    jge 1f\n"
fn la_bat_mov() = "    movq %rax, %rbx\n    movq %r8, %r15\n    movq $1000, %rcx\n    movq $-1, %r11\n    movq $81985529216486895, %rdx\n    movq $-9223372036854775808, %r9\n    movq $7, 8(%rax)\n    movq 8(%rsp), %rax\n    movq %rax, -16(%rbp)\n    movq (%r12), %rsi\n    movq %rdi, (%r13)\n    movq 1000(%rbx,%rcx,8), %rdx\n    movq %r10, -8(%r14,%r9,4)\n    movq (%rax,%rcx,2), %r8\n    movl %eax, %ebx\n    movl (%rdi), %eax\n    movl %edx, 4(%rsi)\n    movb %al, (%rdi)\n    movb (%rsi), %cl\n    movb $65, 1(%rdi)\n    movb %sil, (%rdi)\n    movb %dil, %al\n    movzbq %al, %rax\n    movzbq (%rsi), %rcx\n    movzbl %dl, %eax\n    leaq 24(%rsp), %rdi\n    leaq (%rax,%rax,2), %rax\n"
fn la_bat_alu() = "    addq %rbx, %rax\n    addq $1000, %rbx\n    addq 8(%rsp), %rcx\n    addq %rdx, 16(%rbp)\n    subq %r9, %r10\n    subq $100000, %rsp\n    andq %rcx, %rdx\n    andq $-4096, %rbx\n    orq (%rdi), %rsi\n    orq $65536, %r12\n    xorq %rdi, %rdi\n    xorq $305419896, %r13\n    cmpq %rax, %rbx\n    cmpq $1000, %rcx\n    cmpq 24(%rsp), %r15\n    cmpq $100000, (%rdi)\n    addl %eax, %ebx\n    cmpb %al, %cl\n    cmpb %sil, %cl\n    cmpb $10, (%rsi)\n    testq %rax, %rax\n    testq $1000, %rbx\n    testb %al, %al\n    testb $1, %cl\n"
fn la_bat_misc() = "    negq %rax\n    notq %rbx\n    incq %rcx\n    decq %r8\n    incq 8(%rdi)\n    mulq %rcx\n    cqto\n    idivq %rbx\n    divq %r9\n    imulq %rbx, %rax\n    imulq 8(%rsp), %rcx\n    imulq $1000, %rdx\n    salq $4, %rax\n    shlq $3, %rbx\n    sarq $63, %rcx\n    shrq $12, %r10\n    shlq %cl, %rdx\n    sarq %cl, %rsi\n    shrq %cl, 8(%rdi)\n    pushq %rbp\n    pushq %r12\n    popq %r12\n    popq %rbp\n    sete %al\n    setne %cl\n    setl %dl\n    setg %bl\n    setle %sil\n    setge %dil\n    sets %r8b\n    setns %al\n    xchgq %rbx, (%rdi)\n    xaddq %rcx, (%rsi)\n    lock xaddq %rdx, (%rdi)\n    cmpxchgq %rcx, (%rdi)\n    lock cmpxchgq %rbx, 8(%rsi)\n    syscall\n    pause\n    mfence\n    rdtsc\nbat_far:\n1:\n    ret\n"
fn la_bat_vex() = "    vmovdqu (%r10), %ymm0\n    vmovdqu 32(%r10), %ymm1\n    vmovdqu %ymm0, (%rdi)\n    vmovdqu %ymm2, 1000(%rsi)\n    vmovdqu %ymm1, %ymm2\n    vmovdqu (%rax,%rcx,8), %ymm9\n    vpaddq %ymm1, %ymm0, %ymm0\n    vpaddq %ymm2, %ymm3, %ymm12\n    vpaddq (%r11), %ymm4, %ymm5\n    vpaddq 64(%rsp), %ymm6, %ymm7\n    vpsubq %ymm1, %ymm2, %ymm3\n    vpxor %ymm0, %ymm0, %ymm0\n    vpxor (%rdi), %ymm1, %ymm2\n    vpand %ymm3, %ymm4, %ymm5\n    vpor %ymm6, %ymm7, %ymm8\n    vzeroupper\n"
fn la_bat_evex() = "    vmovdqu64 (%r10), %zmm0\n    vmovdqu64 64(%r10), %zmm1\n    vmovdqu64 -128(%rsp), %zmm2\n    vmovdqu64 32(%rdi), %zmm3\n    vmovdqu64 8192(%rsi), %zmm4\n    vmovdqu64 8128(%rsi), %zmm5\n    vmovdqu64 -8192(%rsi), %zmm6\n    vmovdqu64 %zmm0, (%r11)\n    vmovdqu64 %zmm1, 128(%rax,%rcx,8)\n    vmovdqu64 %zmm2, %zmm3\n    vmovdqu64 (%rdi), %ymm1\n    vmovdqu64 96(%rdi), %ymm2\n    vmovdqu64 %ymm3, 16(%rsi)\n    vpaddq %zmm1, %zmm0, %zmm0\n    vpaddq 64(%r10), %zmm2, %zmm3\n    vpaddq 100(%r10), %zmm4, %zmm5\n    vpsubq %zmm6, %zmm7, %zmm8\n    vpmullq %zmm1, %zmm0, %zmm0\n    vpmullq 192(%rdi), %zmm9, %zmm10\n    vpmullq %ymm1, %ymm2, %ymm3\n    vpmullq 32(%rsp), %ymm4, %ymm5\n    vpxorq %zmm1, %zmm2, %zmm3\n    vpandq %zmm4, %zmm5, %zmm6\n    vporq (%rdi), %zmm7, %zmm8\n    vpxorq %ymm1, %ymm2, %ymm3\n    jmp 1b\n    jle 1b\n    call bat_top\n    ret\n"
fn la_battery() = la_bat_branch() + la_bat_mov() + la_bat_alu() + la_bat_misc() + la_bat_vex() + la_bat_evex()

fn la_raw_len(path, i) = if fs_read_byte(path, i) < 0 then i else la_raw_len(path, i + 1)
fn la_first_diff(elf, raw, i, n) = if i >= n then 0 - 1 else if fs_read_byte(elf, 120 + i) != fs_read_byte(raw, i) then i else la_first_diff(elf, raw, i + 1, n)
fn la_pad_ok(elf, i, e) = if i >= e then 1 else if fs_read_byte(elf, 120 + i) != 204 then 0 else la_pad_ok(elf, i + 1, e)

fn la_gas_diff(root, tmp) = let asm = tmp + "/gas_battery.s" in let w = fs_write_sync(asm, la_battery()) in if w != 1 then "cannot write GAS differential battery" else if fs_path_exists("/usr/bin/as") != 1 or fs_path_exists("/usr/bin/objcopy") != 1 then "GAS differential requires /usr/bin/as and /usr/bin/objcopy (binutils)" else let elf = tmp + "/gas_battery.elf" in let a1 = la_input(tmp + "/lasm", asm, elf) in if a1 != 0 then "native lasm rejected the GAS differential battery: " + fs_read_file(elf + ".err") else let obj = tmp + "/gas_battery.o" in let a2 = la_run("/usr/bin/as", Cons("--64", Cons("-o", Cons(obj, Cons(asm, Nil)))), tmp + "/gas_battery.as.out") in if a2 != 0 then "GNU as rejected the differential battery: " + fs_read_file(tmp + "/gas_battery.as.out.err") else let raw = tmp + "/gas_battery.bin" in let a3 = la_run("/usr/bin/objcopy", Cons("-O", Cons("binary", Cons("-j", Cons(".text", Cons(obj, Cons(raw, Nil)))))), tmp + "/gas_battery.objcopy.out") in if a3 != 0 then "objcopy -O binary failed: " + fs_read_file(tmp + "/gas_battery.objcopy.out.err") else let n = la_raw_len(raw, 0) in if n < 400 then "GNU as produced an implausibly small .text (" + str(n) + " bytes)" else let d = la_first_diff(elf, raw, 0, n) in if d >= 0 then "lasm and GNU as machine code differ at .text offset " + str(d) + ": lasm=" + str(fs_read_byte(elf, 120 + d)) + " gas=" + str(fs_read_byte(raw, d)) + " (inspect with objdump -d " + obj + ")" else let e = n + (8 - n % 8) % 8 in if la_pad_ok(elf, n, e) != 1 or fs_read_byte(elf, 120 + e) >= 0 then "lasm emitted bytes beyond the GNU as instruction stream" else ""

## =============================================================================================
## Generated differential battery: lasm vs GNU as on tens of thousands of instruction encodings.
## The fixed battery above pins ~170 hand-picked lines; the generator below walks operand CLASSES
## (every general register in every position, every base register x displacement class, every
## base x index x scale, boundary immediates, %rip-relative operands, ymm/zmm 0-15 in every position,
## EVEX disp8*N boundaries) for each mnemonic family, writes one .s per family, assembles it with
## both assemblers and requires the .text bytes to be identical. A divergence names the family, the
## .text offset, both bytes and -- by bisecting the family on line prefixes -- the first diverging line.
##
## Forms where lasm deliberately emits a different but EQUIVALENT encoding than GNU as are not in
## these families (the compiler's own output and the seed-identity fixtures depend on those bytes):
##   * add/or/and/sub/xor/cmp $imm: always 81 /n id (80 /n ib for b); GAS picks 83 /n ib when the
##     immediate fits a signed byte and the short accumulator opcodes (05/0D/25/2D/35/3D, 04..3C)
##     for %rax/%eax/%al.
##   * movl/movb $imm, %reg: C7 /0 id and C6 /0 ib; GAS picks B8+r / B0+r.
##   * testq/testb $imm, %rax/%al: F7 /0 id and F6 /0 ib; GAS picks A9 / A8.
##   * imulq $imm8, %reg: 69 /r id; GAS picks 6B /r ib.
##   * shift $1: C1 /n 01; GAS picks D1 /n.          * xchgq with %rax: 87 /r; GAS picks 90+r.
##   * jmp/jcc/call to a near label: always rel32; GAS relaxes to rel8 when it fits.
## The first four classes are checked by la_alt (GNU objdump must disassemble lasm's bytes and GNU
## as's bytes to the same instruction text, line by line), the shift/xchg class by la_pinned (exact
## bytes from the Intel SDM opcode tables), near jumps by the executed local-label fixtures.
fn la_r64(i) = if i == 0 then "%rax" else if i == 1 then "%rcx" else if i == 2 then "%rdx" else if i == 3 then "%rbx" else if i == 4 then "%rsp" else if i == 5 then "%rbp" else if i == 6 then "%rsi" else if i == 7 then "%rdi" else "%r" + str(i)
fn la_r32(i) = if i == 0 then "%eax" else if i == 1 then "%ecx" else if i == 2 then "%edx" else if i == 3 then "%ebx" else if i == 4 then "%esi" else "%edi"
fn la_r8(i) = if i == 0 then "%al" else if i == 1 then "%cl" else if i == 2 then "%dl" else if i == 3 then "%bl" else if i == 4 then "%sil" else if i == 5 then "%dil" else "%r" + str(i + 2) + "b"
fn la_cr(i) = if i == 0 then "%cr0" else if i == 1 then "%cr2" else if i == 2 then "%cr3" else if i == 3 then "%cr4" else "%cr8"
## displacement classes: none, +-1, the disp8 edges, the first disp32 values, the int32 edges
fn la_disp(j) = if j == 0 then "" else if j == 1 then "1" else if j == 2 then "-1" else if j == 3 then "127" else if j == 4 then "-128" else if j == 5 then "128" else if j == 6 then "-129" else if j == 7 then "2147483647" else "-2147483648"
fn la_scale(j) = if j == 0 then "1" else if j == 1 then "2" else if j == 2 then "4" else "8"
## class 20: disp(%base) -- 16 bases x 9 displacement classes (rsp/r12 need SIB, rbp/r13 need a disp)
fn la_mem_a(i) = la_disp(i % 9) + "(" + la_r64(i / 9) + ")"
## class 22: disp(%base,%index,scale) -- 16 bases x 15 indexes (no %rsp) x 4 scales x {no disp, disp8, disp32}
fn la_mem_b(i) = let d = i % 3 in let x = i / 12 % 15 in (if d == 0 then "" else if d == 1 then "-128" else "128") + "(" + la_r64(i / 180) + "," + la_r64(if x >= 4 then x + 1 else x) + "," + la_scale(i / 3 % 4) + ")"
## class 21: a 40-operand sample of both, used where the full cross product would be too large
fn la_mem_s(i) = if i < 16 then la_mem_a(i * 9 + i % 9) else la_mem_b(((i - 16) * 127 + 5) % 2880)
## classes 61/62: EVEX disp8*N boundaries for N = 32 (ymm) / 64 (zmm), also used un-compressed under VEX
fn la_inner9(j) = if j == 0 then "%rax" else if j == 1 then "%rsp" else if j == 2 then "%rbp" else if j == 3 then "%r12" else if j == 4 then "%r13" else if j == 5 then "%r10" else if j == 6 then "%rax,%rcx,8" else if j == 7 then "%r12,%r13,4" else "%rbp,%r15,2"
fn la_disp_e(n, j) = if j == 0 then "" else if j == 1 then str(n) else if j == 2 then str(0 - n) else if j == 3 then str(127 * n) else if j == 4 then str(128 * n) else if j == 5 then str(0 - 128 * n) else if j == 6 then str(0 - 129 * n) else if j == 7 then str(n / 2) else if j == 8 then "1" else "100"
fn la_mem_e(n, i) = la_disp_e(n, i % 10) + "(" + la_inner9(i / 10) + ")"
fn la_rip(i) = if i == 0 then "gen_top(%rip)" else if i == 1 then "gen_top+8(%rip)" else if i == 2 then "gen_end(%rip)" else "gen_end+64(%rip)"
## immediate classes: 40 = needs imm32 (not imm8); 41 = byte; 42 = test; 43 = movq to a register (imm32 and
## movabs edges); 44 = any signed 32-bit; 45 = shift counts (not 1); 47 = fits a signed byte
fn la_imm40(i) = if i == 0 then "$128" else if i == 1 then "$-129" else if i == 2 then "$1000" else if i == 3 then "$2147483647" else "$-2147483648"
fn la_imm41(i) = if i == 0 then "$0" else if i == 1 then "$1" else if i == 2 then "$127" else if i == 3 then "$-128" else if i == 4 then "$255" else "$-1"
fn la_imm42(i) = if i == 0 then "$0" else if i == 1 then "$1" else if i == 2 then "$-1" else if i == 3 then "$127" else if i == 4 then "$128" else if i == 5 then "$2147483647" else "$-2147483648"
fn la_imm43(i) = if i == 0 then "$0" else if i == 1 then "$1" else if i == 2 then "$-1" else if i == 3 then "$127" else if i == 4 then "$128" else if i == 5 then "$-128" else if i == 6 then "$-129" else if i == 7 then "$2147483647" else if i == 8 then "$-2147483648" else if i == 9 then "$2147483648" else if i == 10 then "$-2147483649" else if i == 11 then "$4294967295" else if i == 12 then "$4294967296" else if i == 13 then "$9223372036854775807" else if i == 14 then "$-9223372036854775808" else "$81985529216486895"
fn la_imm44(i) = if i < 7 then la_imm43(i) else if i == 7 then "$2147483647" else "$-2147483648"
fn la_imm45(i) = if i == 0 then "$0" else if i == 1 then "$2" else if i == 2 then "$31" else if i == 3 then "$32" else if i == 4 then "$63" else if i == 5 then "$64" else "$255"
fn la_imm47(i) = if i == 0 then "$0" else if i == 1 then "$1" else if i == 2 then "$127" else if i == 3 then "$-128" else "$-1"
## operand classes: 8/4/1 = every 64/32/8-bit register lasm names; 9/3/2 = the same without the accumulator;
## 11/12/13 = only %rax/%eax/%al; 10 = %cl; 5/6 = ymm/zmm 0-15; 50 = control registers; 70 = %rip-relative
fn la_opn(c) = if c == 8 then 16 else if c == 9 then 15 else if c == 4 then 6 else if c == 3 then 5 else if c == 1 then 14 else if c == 2 then 13 else if c == 5 or c == 6 then 16 else if c == 10 or c == 11 or c == 12 or c == 13 then 1 else if c == 20 then 144 else if c == 21 then 40 else if c == 22 then 2880 else if c == 40 then 5 else if c == 41 then 6 else if c == 42 then 7 else if c == 43 then 16 else if c == 44 then 9 else if c == 45 then 7 else if c == 47 then 5 else if c == 50 then 5 else if c == 61 or c == 62 then 90 else if c == 70 then 4 else 0
fn la_op(c, i) = if c == 8 then la_r64(i) else if c == 9 then la_r64(i + 1) else if c == 4 then la_r32(i) else if c == 3 then la_r32(i + 1) else if c == 1 then la_r8(i) else if c == 2 then la_r8(i + 1) else if c == 5 then "%ymm" + str(i) else if c == 6 then "%zmm" + str(i) else if c == 10 then "%cl" else if c == 11 then "%rax" else if c == 12 then "%eax" else if c == 13 then "%al" else if c == 20 then la_mem_a(i) else if c == 21 then la_mem_s(i) else if c == 22 then la_mem_b(i) else if c == 40 then la_imm40(i) else if c == 41 then la_imm41(i) else if c == 42 then la_imm42(i) else if c == 43 then la_imm43(i) else if c == 44 then la_imm44(i) else if c == 45 then la_imm45(i) else if c == 47 then la_imm47(i) else if c == 50 then la_cr(i) else if c == 61 then la_mem_e(32, i) else if c == 62 then la_mem_e(64, i) else la_rip(i)
## line builders. Text is accumulated per row and rows are appended to the family, so building a
## family of n lines copies O(n * sqrt(n)) characters instead of O(n * n).
fn la_l1(mn, x) = "    " + mn + " " + x + "\n"
fn la_l2(mn, x, y) = "    " + mn + " " + x + ", " + y + "\n"
fn la_l3(mn, x, y, z) = "    " + mn + " " + x + ", " + y + ", " + z + "\n"
## la_u1: `mn x` for every x of class c
fn la_u1_go(mn, c, i, n, acc) = if i >= n then acc else la_u1_go(mn, c, i + 1, n, acc + la_l1(mn, la_op(c, i)))
fn la_u1(mn, c) = la_u1_go(mn, c, 0, la_opn(c), "")
## la_pairs: `mn a, b` for EVERY a of class ca and EVERY b of class cb
fn la_p2_row(mn, ca, cb, i, j, n, acc) = if j >= n then acc else la_p2_row(mn, ca, cb, i, j + 1, n, acc + la_l2(mn, la_op(ca, i), la_op(cb, j)))
fn la_p2_go(mn, ca, cb, i, n, acc) = if i >= n then acc else la_p2_go(mn, ca, cb, i + 1, n, acc + la_p2_row(mn, ca, cb, i, 0, la_opn(cb), ""))
fn la_pairs(mn, ca, cb) = la_p2_go(mn, ca, cb, 0, la_opn(ca), "")
## la_zip: one line per x of class ca, paired with class cb walked on the stride (m, a); rev = 0 emits
## `mn x, y`, rev = 1 emits `mn y, x`
fn la_z_row(mn, ca, cb, m, a, rev, i, e, acc) = if i >= e then acc else let x = la_op(ca, i) in let y = la_op(cb, (i * m + a) % la_opn(cb)) in la_z_row(mn, ca, cb, m, a, rev, i + 1, e, acc + (if rev == 0 then la_l2(mn, x, y) else la_l2(mn, y, x)))
fn la_z_go(mn, ca, cb, m, a, rev, i, n, acc) = if i >= n then acc else la_z_go(mn, ca, cb, m, a, rev, i + 64, n, acc + la_z_row(mn, ca, cb, m, a, rev, i, if i + 64 < n then i + 64 else n, ""))
fn la_zip(mn, ca, cb, m, a, rev) = la_z_go(mn, ca, cb, m, a, rev, 0, la_opn(ca), "")
## three-operand vector forms over register class w (5 = ymm, 6 = zmm): la_v3_all = all 16^3 triples;
## la_v3_diag = every (src, vvvv) pair with two derived destinations; la_v3_mem = memory source of class cm
fn la_v3_k(mn, w, i, j, k, acc) = if k >= 16 then acc else la_v3_k(mn, w, i, j, k + 1, acc + la_l3(mn, la_op(w, i), la_op(w, j), la_op(w, k)))
fn la_v3_j(mn, w, i, j, acc) = if j >= 16 then acc else la_v3_j(mn, w, i, j + 1, acc + la_v3_k(mn, w, i, j, 0, ""))
fn la_v3_i(mn, w, i, acc) = if i >= 16 then acc else la_v3_i(mn, w, i + 1, acc + la_v3_j(mn, w, i, 0, ""))
fn la_v3_all(mn, w) = la_v3_i(mn, w, 0, "")
fn la_v3d_j(mn, w, i, j, acc) = if j >= 16 then acc else la_v3d_j(mn, w, i, j + 1, acc + la_l3(mn, la_op(w, i), la_op(w, j), la_op(w, (i * 5 + j * 3 + 1) % 16)) + la_l3(mn, la_op(w, i), la_op(w, j), la_op(w, (i + j * 7 + 9) % 16)))
fn la_v3d_i(mn, w, i, acc) = if i >= 16 then acc else la_v3d_i(mn, w, i + 1, acc + la_v3d_j(mn, w, i, 0, ""))
fn la_v3_diag(mn, w) = la_v3d_i(mn, w, 0, "")
fn la_v3m_go(mn, cm, w, i, n, acc) = if i >= n then acc else la_v3m_go(mn, cm, w, i + 1, n, acc + la_l3(mn, la_op(cm, i), la_op(w, (i * 3 + 1) % 16), la_op(w, (i * 7 + 2) % 16)))
fn la_v3_mem(mn, cm, w) = la_v3m_go(mn, cm, w, 0, la_opn(cm), "")

fn la_alu(i) = if i == 0 then "add" else if i == 1 then "or" else if i == 2 then "and" else if i == 3 then "sub" else if i == 4 then "xor" else "cmp"
fn la_unary(i) = if i == 0 then "negq" else if i == 1 then "notq" else if i == 2 then "mulq" else if i == 3 then "divq" else if i == 4 then "idivq" else if i == 5 then "incq" else "decq"
fn la_shift(i) = if i == 0 then "salq" else if i == 1 then "shlq" else if i == 2 then "sarq" else "shrq"
fn la_setcc(i) = if i == 0 then "sete" else if i == 1 then "setne" else if i == 2 then "setl" else if i == 3 then "setg" else if i == 4 then "setle" else if i == 5 then "setge" else if i == 6 then "sets" else "setns"
fn la_jmp(i) = if i == 0 then "jmp" else if i == 1 then "call" else if i == 2 then "je" else if i == 3 then "jz" else if i == 4 then "jne" else if i == 5 then "jnz" else if i == 6 then "jl" else if i == 7 then "jg" else if i == 8 then "jle" else if i == 9 then "jge" else if i == 10 then "js" else if i == 11 then "jns" else if i == 12 then "jo" else if i == 13 then "jno" else if i == 14 then "jc" else "jnc"
fn la_vop(i) = if i == 0 then "vpaddq" else if i == 1 then "vpsubq" else if i == 2 then "vpxor" else if i == 3 then "vpand" else if i == 4 then "vpor" else if i == 5 then "vpmullq" else if i == 6 then "vpxorq" else if i == 7 then "vpandq" else "vporq"

## --- the families ---
fn la_f_mov_rr() = la_pairs("movq", 8, 8) + la_pairs("movl", 4, 4) + la_pairs("movb", 1, 1)
fn la_f_mov_mem() = la_zip("movq", 20, 8, 7, 3, 0) + la_zip("movq", 20, 8, 5, 1, 1) + la_zip("movq", 21, 8, 3, 2, 0) + la_zip("movq", 21, 8, 5, 7, 1) + la_zip("movl", 20, 4, 1, 1, 0) + la_zip("movl", 20, 4, 5, 2, 1) + la_zip("movl", 21, 4, 1, 0, 0) + la_zip("movl", 21, 4, 5, 3, 1) + la_zip("movb", 20, 1, 3, 1, 0) + la_zip("movb", 20, 1, 5, 2, 1) + la_zip("movb", 21, 1, 1, 0, 0) + la_zip("movb", 21, 1, 3, 5, 1)
fn la_f_lea() = la_zip("leaq", 22, 8, 7, 1, 0) + la_zip("leaq", 20, 8, 3, 0, 0)
fn la_alu_rr_q(i, acc) = if i >= 6 then acc else la_alu_rr_q(i + 1, acc + la_pairs(la_alu(i) + "q", 8, 8))
fn la_alu_rr_lb(i, acc) = if i >= 6 then acc else la_alu_rr_lb(i + 1, acc + la_pairs(la_alu(i) + "l", 4, 4) + la_pairs(la_alu(i) + "b", 1, 1))
fn la_alu_mem(i, acc) = if i >= 6 then acc else let c = la_alu(i) in la_alu_mem(i + 1, acc + la_zip(c + "q", 20, 8, 5, 2, 0) + la_zip(c + "q", 20, 8, 7, 3, 1) + la_zip(c + "q", 21, 8, 3, 1, 0) + la_zip(c + "q", 21, 8, 5, 4, 1) + la_zip(c + "l", 21, 4, 1, 0, 0) + la_zip(c + "l", 21, 4, 5, 1, 1) + la_zip(c + "b", 21, 1, 3, 1, 0) + la_zip(c + "b", 21, 1, 5, 2, 1))
fn la_alu_imm(i, acc) = if i >= 6 then acc else let c = la_alu(i) in la_alu_imm(i + 1, acc + la_pairs(c + "q", 40, 9) + la_pairs(c + "l", 40, 3) + la_pairs(c + "b", 41, 2) + la_zip(c + "q", 21, 40, 1, 0, 1) + la_zip(c + "l", 21, 40, 3, 1, 1) + la_zip(c + "b", 21, 41, 1, 0, 1))
fn la_f_test() = la_pairs("testq", 8, 8) + la_pairs("testb", 1, 1) + la_pairs("testq", 42, 9) + la_pairs("testb", 41, 2) + la_zip("testq", 21, 8, 3, 1, 1) + la_zip("testq", 21, 8, 5, 2, 0) + la_zip("testb", 21, 1, 3, 1, 1) + la_zip("testb", 21, 1, 5, 2, 0) + la_zip("testq", 21, 42, 1, 0, 1) + la_zip("testb", 21, 41, 1, 0, 1)
fn la_unary_go(i, acc) = if i >= 7 then acc else la_unary_go(i + 1, acc + la_u1(la_unary(i), 8) + la_u1(la_unary(i), 21) + (if i == 0 or i == 5 then la_u1(la_unary(i), 20) else ""))
fn la_shift_go(i, acc) = if i >= 4 then acc else let s = la_shift(i) in la_shift_go(i + 1, acc + la_pairs(s, 45, 8) + la_pairs(s, 10, 8) + la_pairs(s, 10, 21) + la_zip(s, 21, 45, 1, 0, 1))
fn la_f_imul() = la_pairs("imulq", 8, 8) + la_pairs("imulq", 40, 8) + la_zip("imulq", 21, 8, 3, 1, 0) + la_zip("imulq", 20, 8, 5, 2, 0)
fn la_f_movimm() = la_pairs("movq", 43, 8) + la_zip("movq", 20, 44, 1, 0, 1) + la_zip("movq", 21, 44, 2, 1, 1) + la_zip("movl", 21, 44, 1, 0, 1) + la_zip("movb", 21, 41, 1, 0, 1)
fn la_setcc_go(i, acc) = if i >= 8 then acc else la_setcc_go(i + 1, acc + la_u1(la_setcc(i), 1) + la_u1(la_setcc(i), 21))
fn la_f_sys() = "    cli\n    sti\n    hlt\n    iretq\n    rdmsr\n    wrmsr\n    rdtsc\n    pause\n    mfence\n    vzeroupper\n    vzeroall\n    syscall\n    cqto\n    ret\n    outb %al, %dx\n    inb %dx, %al\n    outw %ax, %dx\n    inw %dx, %ax\n    outl %eax, %dx\n    inl %dx, %eax\n    int $0\n    int $1\n    int $3\n    int $32\n    int $128\n    int $255\n"
fn la_f_misc() = la_u1("pushq", 8) + la_u1("popq", 8) + la_setcc_go(0, "") + la_pairs("movzbq", 1, 8) + la_pairs("movzbl", 1, 4) + la_zip("movzbq", 21, 8, 3, 1, 0) + la_zip("movzbl", 21, 4, 1, 0, 0) + la_pairs("movq", 50, 8) + la_pairs("movq", 8, 50) + la_u1("lgdt", 21) + la_u1("lidt", 21) + la_u1("invlpg", 21) + la_f_sys()
fn la_f_xchg() = la_pairs("xchgq", 9, 9) + la_zip("xchgq", 21, 8, 3, 1, 1) + la_zip("xchgq", 21, 8, 5, 2, 0) + la_pairs("xaddq", 8, 8) + la_pairs("cmpxchgq", 8, 8) + la_zip("xaddq", 21, 8, 3, 1, 1) + la_zip("cmpxchgq", 21, 8, 5, 2, 1) + la_zip("lock xaddq", 21, 8, 7, 3, 1) + la_zip("lock cmpxchgq", 21, 8, 5, 4, 1)
## %rip-relative operands, including immediates AFTER the displacement (the rel32 is relative to the
## END of the instruction) and a forward reference (gen_end)
fn la_rip_alu(i, acc) = if i >= 6 then acc else let c = la_alu(i) in la_rip_alu(i + 1, acc + la_zip(c + "q", 70, 8, 3, i, 0) + la_zip(c + "q", 70, 8, 5, i, 1) + la_zip(c + "q", 70, 40, 1, i, 1) + la_zip(c + "b", 70, 41, 1, i, 1) + la_zip(c + "l", 70, 4, 1, i, 0))
fn la_rip_un(i, acc) = if i >= 7 then acc else la_rip_un(i + 1, acc + la_u1(la_unary(i), 70))
fn la_rip_sh(i, acc) = if i >= 4 then acc else la_rip_sh(i + 1, acc + la_pairs(la_shift(i), 45, 70) + la_pairs(la_shift(i), 10, 70))
fn la_rip_set(i, acc) = if i >= 8 then acc else la_rip_set(i + 1, acc + la_u1(la_setcc(i), 70))
fn la_rip_vop(i, acc) = if i >= 9 then acc else la_rip_vop(i + 1, acc + la_v3_mem(la_vop(i), 70, 5) + (if i == 2 or i == 3 or i == 4 then "" else la_v3_mem(la_vop(i), 70, 6)))
fn la_f_rip() = la_pairs("leaq", 70, 8) + la_pairs("movq", 70, 8) + la_pairs("movq", 8, 70) + la_pairs("movl", 70, 4) + la_pairs("movl", 4, 70) + la_pairs("movb", 70, 1) + la_pairs("movb", 1, 70) + la_pairs("movq", 44, 70) + la_pairs("movl", 44, 70) + la_pairs("movb", 41, 70) + la_rip_alu(0, "") + la_rip_un(0, "") + la_rip_sh(0, "") + la_rip_set(0, "") + la_pairs("movzbq", 70, 8) + la_pairs("movzbl", 70, 4) + la_pairs("imulq", 70, 8) + la_pairs("testq", 8, 70) + la_pairs("testq", 70, 8) + la_pairs("testq", 42, 70) + la_pairs("testb", 41, 70) + la_pairs("xchgq", 8, 70) + la_pairs("lock xaddq", 8, 70) + la_pairs("lock cmpxchgq", 8, 70) + la_u1("lgdt", 70) + la_u1("lidt", 70) + la_u1("invlpg", 70) + la_pairs("vmovdqu", 70, 5) + la_pairs("vmovdqu", 5, 70) + la_pairs("vmovdqu64", 70, 6) + la_pairs("vmovdqu64", 6, 70) + la_pairs("vmovdqu64", 70, 5) + la_rip_vop(0, "")
## every branch mnemonic, forward to gen_end and backward to gen_top across >= 768 bytes of filler
## (rel32 in both assemblers; near jumps are an alternate-encoding class, see the header)
fn la_jmp_go(tgt, i, acc) = if i >= 16 then acc else la_jmp_go(tgt, i + 1, acc + la_l1(la_jmp(i), tgt))
fn la_f_branch() = la_jmp_go("gen_end", 0, "") + la_pairs("movq", 8, 8) + la_jmp_go("gen_top", 0, "") + la_jmp_go("gen_end", 0, "") + la_pairs("addq", 8, 8) + la_jmp_go("gen_top", 0, "")
fn la_vex_ops(i, acc) = if i >= 5 then acc else la_vex_ops(i + 1, acc + la_v3_diag(la_vop(i), 5) + la_v3_mem(la_vop(i), 21, 5) + la_v3_mem(la_vop(i), 61, 5))
fn la_f_vex() = la_pairs("vmovdqu", 5, 5) + la_zip("vmovdqu", 21, 5, 3, 1, 0) + la_zip("vmovdqu", 21, 5, 5, 2, 1) + la_zip("vmovdqu", 61, 5, 3, 1, 0) + la_zip("vmovdqu", 61, 5, 5, 2, 1) + la_zip("vmovdqu", 20, 5, 7, 3, 0) + la_vex_ops(0, "")
fn la_f_vex_cube() = la_v3_all("vpaddq", 5)
fn la_evex512_ops(i, acc) = if i >= 9 then acc else if i == 2 or i == 3 or i == 4 then la_evex512_ops(i + 1, acc) else la_evex512_ops(i + 1, acc + la_v3_diag(la_vop(i), 6) + la_v3_mem(la_vop(i), 62, 6) + la_v3_mem(la_vop(i), 21, 6))
fn la_f_evex512() = la_pairs("vmovdqu64", 6, 6) + la_zip("vmovdqu64", 62, 6, 3, 1, 0) + la_zip("vmovdqu64", 62, 6, 5, 2, 1) + la_zip("vmovdqu64", 21, 6, 3, 1, 0) + la_zip("vmovdqu64", 21, 6, 5, 2, 1) + la_zip("vmovdqu64", 20, 6, 7, 3, 0) + la_evex512_ops(0, "")
fn la_evex256_ops(i, acc) = if i >= 9 then acc else la_evex256_ops(i + 1, acc + la_v3_diag(la_vop(i), 5) + la_v3_mem(la_vop(i), 61, 5) + la_v3_mem(la_vop(i), 21, 5))
fn la_f_evex256() = la_pairs("vmovdqu64", 5, 5) + la_zip("vmovdqu64", 61, 5, 3, 1, 0) + la_zip("vmovdqu64", 61, 5, 5, 2, 1) + la_zip("vmovdqu64", 21, 5, 3, 1, 0) + la_zip("vmovdqu64", 21, 5, 5, 2, 1) + la_evex256_ops(5, "")
fn la_f_evex_cube() = la_v3_all("vpmullq", 6)

fn la_fam_count() = 21
fn la_fam_name(i) = if i == 0 then "mov_rr" else if i == 1 then "mov_mem" else if i == 2 then "lea" else if i == 3 then "alu_rr_q" else if i == 4 then "alu_rr_lb" else if i == 5 then "alu_mem" else if i == 6 then "alu_imm" else if i == 7 then "test" else if i == 8 then "unary" else if i == 9 then "shift" else if i == 10 then "imul" else if i == 11 then "movimm" else if i == 12 then "misc" else if i == 13 then "xchg" else if i == 14 then "rip" else if i == 15 then "branch" else if i == 16 then "vex" else if i == 17 then "vex_cube" else if i == 18 then "evex512" else if i == 19 then "evex256" else "evex_cube"
fn la_fam_body(i) = if i == 0 then la_f_mov_rr() else if i == 1 then la_f_mov_mem() else if i == 2 then la_f_lea() else if i == 3 then la_alu_rr_q(0, "") else if i == 4 then la_alu_rr_lb(0, "") else if i == 5 then la_alu_mem(0, "") else if i == 6 then la_alu_imm(0, "") else if i == 7 then la_f_test() else if i == 8 then la_unary_go(0, "") else if i == 9 then la_shift_go(0, "") else if i == 10 then la_f_imul() else if i == 11 then la_f_movimm() else if i == 12 then la_f_misc() else if i == 13 then la_f_xchg() else if i == 14 then la_f_rip() else if i == 15 then la_f_branch() else if i == 16 then la_f_vex() else if i == 17 then la_f_vex_cube() else if i == 18 then la_f_evex512() else if i == 19 then la_f_evex256() else la_f_evex_cube()

## --- differential machinery (GNU as + objcopy are the oracle; sizes and byte comparison are native, see la_bdiff) ---
fn la_count_nl(s, n, i, acc) = if i >= n then acc else la_count_nl(s, n, i + 1, if at(s, i) == "\n" then acc + 1 else acc)
fn la_lines_of(s) = la_count_nl(s, count(s), 0, 0)
## index just past the m-th newline of s (0 for m = 0)
fn la_nl_after(s, n, m, i) = if m <= 0 then i else if i >= n then n else if at(s, i) == "\n" then la_nl_after(s, n, m - 1, i + 1) else la_nl_after(s, n, m, i + 1)
fn la_nth_line(s, m) = let n = count(s) in let a = la_nl_after(s, n, m - 1, 0) in let b = la_nl_after(s, n, m, 0) in if b <= a then "" else slice(s, a, b - 1)
fn la_index_of(text, part, i) = if i + count(part) > count(text) then 0 - 1 else if slice(text, i, i + count(part)) == part then i else la_index_of(text, part, i + 1)
fn la_gen_file(body) = "    .section .text\n_start:\ngen_top:\n" + body + "gen_end:\n    ret\n"
fn la_tools_ok() = if fs_path_exists("/usr/bin/as") != 1 or fs_path_exists("/usr/bin/objcopy") != 1 or fs_path_exists("/usr/bin/objdump") != 1 then "GAS differential requires /usr/bin/as, /usr/bin/objcopy and /usr/bin/objdump (binutils)" else ""
## Byte-level work on the two outputs is done here, in Lume: fs_read_file returns the exact bytes of a file (NUL and
## high bytes included), so size, comparison and column extraction need no cmp / stat / cut / head / tail.
fn la_size(path) = if fs_path_exists(path) != 1 then 0 - 1 else count(fs_read_file(path))
## first i in [0, n) with a[off + i] != b[i] (a missing byte on either side is a difference), or n
fn la_bdiff(a, off, b, n, i) = if i >= n then n else if off + i >= count(a) or i >= count(b) then i else if ord(at(a, off + i)) != ord(at(b, i)) then i else la_bdiff(a, off, b, n, i + 1)
## assemble `text` with lasm (-> tag.elf) and GNU as (-> tag.o -> tag.bin); "" when both succeeded
fn la_asm_both(tmp, tag, text) = let asm = tmp + "/" + tag + ".s" in if fs_write_sync(asm, text) != 1 then "cannot write " + asm else let elf = tmp + "/" + tag + ".elf" in if la_input(tmp + "/lasm", asm, elf) != 0 then "native lasm rejected '" + tag + "': " + slice(fs_read_file(elf + ".err"), 0, 600) else let obj = tmp + "/" + tag + ".o" in if la_run("/usr/bin/as", Cons("--64", Cons("-o", Cons(obj, Cons(asm, Nil)))), tmp + "/" + tag + ".as.out") != 0 then "GNU as rejected '" + tag + "': " + slice(fs_read_file(tmp + "/" + tag + ".as.out.err"), 0, 600) else if la_run("/usr/bin/objcopy", Cons("-O", Cons("binary", Cons("-j", Cons(".text", Cons(obj, Cons(tmp + "/" + tag + ".bin", Nil)))))), tmp + "/" + tag + ".objcopy.out") != 0 then "objcopy -O binary failed for '" + tag + "'" else ""
## 1 when tag.elf holds exactly tag.bin at offset 120, then only int3 padding to 8, then EOF
fn la_same_text(tmp, tag, n) = let elf = tmp + "/" + tag + ".elf" in let raw = tmp + "/" + tag + ".bin" in if n < 1 then 0 else if la_bdiff(fs_read_file(elf), 120, fs_read_file(raw), n, 0) != n then 0 else let e = n + (8 - n % 8) % 8 in if la_pad_ok(elf, n, e) != 1 or fs_read_byte(elf, 120 + e) >= 0 then 0 else 1
## first differing .text offset, or -1 when the first n bytes agree
fn la_cmp_off(tmp, tag, n) = let d = la_bdiff(fs_read_file(tmp + "/" + tag + ".elf"), 120, fs_read_file(tmp + "/" + tag + ".bin"), n, 0) in if d >= n then 0 - 1 else d
fn la_prefix_ok(tmp, body, n, m) = let text = la_gen_file(slice(body, 0, la_nl_after(body, n, m, 0))) in if la_asm_both(tmp, "bisect", text) != "" then 0 else la_same_text(tmp, "bisect", la_size(tmp + "/bisect.bin"))
## invariant: the first `lo` lines assemble identically, the first `hi` lines do not -> first diverging line
fn la_bisect(tmp, body, n, lo, hi) = if hi - lo <= 1 then hi else let mid = (lo + hi) / 2 in if la_prefix_ok(tmp, body, n, mid) == 1 then la_bisect(tmp, body, n, mid, hi) else la_bisect(tmp, body, n, lo, mid)
fn la_gen_explain(tmp, name, body, lines, n) = let tag = "gen_" + name in let d = la_cmp_off(tmp, tag, n) in let m = la_bisect(tmp, body, count(body), 0, lines) in let where = "; first diverging generated line #" + str(m) + ": `" + la_nth_line(body, m) + "` (inspect with objdump -d " + tmp + "/" + tag + ".o)" in if d < 0 then "generated family '" + name + "': lasm emitted bytes beyond the GNU as instruction stream" + where else "generated family '" + name + "': lasm and GNU as machine code differ at .text offset " + str(d) + ": lasm=" + str(fs_read_byte(tmp + "/" + tag + ".elf", 120 + d)) + " gas=" + str(fs_read_byte(tmp + "/" + tag + ".bin", d)) + where
fn la_gen_check(tmp, name, body) = let lines = la_lines_of(body) in let e1 = la_asm_both(tmp, "gen_" + name, la_gen_file(body)) in if e1 != "" then e1 else let n = la_size(tmp + "/gen_" + name + ".bin") in if n < lines + 1 then "generated family '" + name + "': GNU as produced an implausibly small .text (" + str(n) + " bytes for " + str(lines) + " instructions)" else if la_same_text(tmp, "gen_" + name, n) == 1 then "" else la_gen_explain(tmp, name, body, lines, n)
fn la_gen_run(tmp, i, total) = if i >= la_fam_count() then {err: "", lines: total} else let body = la_fam_body(i) in let e = la_gen_check(tmp, la_fam_name(i), body) in if e != "" then {err: e, lines: total} else la_gen_run(tmp, i + 1, total + la_lines_of(body))

## --- alternate encodings: same instruction, different bytes than GNU as (see the header). GNU objdump
## disassembles lasm's .text and GNU as's .text; the instruction columns must be identical line by
## line, so the operation, the operands and the immediate value are all pinned by an independent decoder.
fn la_alt_alu(i, acc) = if i >= 6 then acc else let c = la_alu(i) in la_alt_alu(i + 1, acc + la_pairs(c + "q", 47, 8) + la_pairs(c + "q", 40, 11) + la_pairs(c + "l", 47, 4) + la_pairs(c + "l", 40, 12) + la_pairs(c + "b", 41, 13) + la_zip(c + "q", 21, 47, 1, 0, 1) + la_zip(c + "l", 21, 47, 2, 1, 1))
fn la_alt_body() = la_alt_alu(0, "") + la_pairs("movl", 44, 4) + la_pairs("movb", 41, 1) + la_pairs("testq", 42, 11) + la_pairs("testb", 41, 13) + la_pairs("imulq", 47, 8)
## objdump -D -z -b binary (from `start`) -> instruction column -> first `lines` lines in <out>.insn;
## whatever follows is left in <out>.rest. Returns "" on success.
## third TAB-separated field of every line that has a TAB (what `cut -s -f3` printed), one per line
fn la_tab_in(s, i, e) = if i >= e then e else if at(s, i) == "\t" then i else la_tab_in(s, i + 1, e)
fn la_col3_line(s, a, e) = let t1 = la_tab_in(s, a, e) in if t1 >= e then "" else let t2 = la_tab_in(s, t1 + 1, e) in if t2 >= e then "\n" else slice(s, t2 + 1, la_tab_in(s, t2 + 1, e)) + "\n"
fn la_col3(s, n, i, acc) = if i >= n then acc else let e = la_line_end(s, i) in la_col3(s, n, e + 1, Cons(la_col3_line(s, i, e), acc))
fn la_cat_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => la_cat_rev(t, h + acc)
fn la_dis(file, start, lines, out) = if la_run("/usr/bin/objdump", Cons("-D", Cons("-z", Cons("-b", Cons("binary", Cons("-m", Cons("i386:x86-64", Cons("--insn-width=16", Cons("--start-address=" + str(start), Cons(file, Nil))))))))), out) != 0 then "objdump failed on " + file else let raw = fs_read_file(out) in let col = la_cat_rev(la_col3(raw, count(raw), 0, Nil), "") in let k = la_nl_after(col, count(col), lines, 0) in if fs_write_sync(out + ".col", col) != 1 then "cannot write " + out + ".col" else if fs_write_sync(out + ".insn", slice(col, 0, k)) != 1 then "cannot write " + out + ".insn" else if fs_write_sync(out + ".rest", slice(col, k, count(col))) != 1 then "cannot write " + out + ".rest" else ""
fn la_int3_only(t, n, i) = if i >= n then 1 else if i + 5 <= n and slice(t, i, i + 5) == "int3\n" then la_int3_only(t, n, i + 5) else 0
fn la_alt_diff_line(a, b, body, m, total) = if m > total then "alternate-encoding battery: disassembly files differ but no differing line was found" else if la_nth_line(a, m) != la_nth_line(b, m) then "alternate-encoding battery: line #" + str(m) + " `" + la_nth_line(body, m) + "` disassembles as `" + la_nth_line(a, m) + "` from lasm but `" + la_nth_line(b, m) + "` from GNU as" else la_alt_diff_line(a, b, body, m + 1, total)
fn la_alt(tmp) = let body = la_alt_body() in let lines = la_lines_of(body) in let e1 = la_asm_both(tmp, "alt", la_gen_file(body)) in if e1 != "" then {err: e1, lines: 0} else let e2 = la_dis(tmp + "/alt.elf", 120, lines + 1, tmp + "/alt.lasm.dis") in if e2 != "" then {err: e2, lines: 0} else let e3 = la_dis(tmp + "/alt.bin", 0, lines + 1, tmp + "/alt.gas.dis") in if e3 != "" then {err: e3, lines: 0} else let a = fs_read_file(tmp + "/alt.lasm.dis.insn") in let b = fs_read_file(tmp + "/alt.gas.dis.insn") in if la_lines_of(b) != lines + 1 or fs_read_file(tmp + "/alt.gas.dis.rest") != "" then {err: "alternate-encoding battery: GNU as output does not disassemble to exactly " + str(lines + 1) + " instructions", lines: 0} else if a != b then {err: la_alt_diff_line(a, b, body, 1, lines + 1), lines: 0} else let rest = fs_read_file(tmp + "/alt.lasm.dis.rest") in if count(rest) > 35 or la_int3_only(rest, count(rest), 0) != 1 then {err: "alternate-encoding battery: lasm emitted bytes beyond the instruction stream: " + slice(rest, 0, 200), lines: 0} else {err: "", lines: lines}

## shift-by-1 and xchg-with-%rax print differently in objdump for the two encodings, so they are pinned
## to the exact bytes of the Intel SDM forms lasm emits: C1 /n ib (shift) and REX.W 87 /r (xchg).
fn la_pinned_src() = "    .section .text\n_start:\n    sarq $1, %rax\n    shlq $1, %rcx\n    salq $1, %rdx\n    shrq $1, %r10\n    sarq $1, 8(%rdi)\n    xchgq %rax, %rdx\n    xchgq %rdx, %rax\n    xchgq %rax, %rax\n    xchgq %r8, %rax\n    xchgq %rax, %r15\n"
fn la_pinned_bytes() = Cons(72, Cons(193, Cons(248, Cons(1, Cons(72, Cons(193, Cons(225, Cons(1, Cons(72, Cons(193, Cons(226, Cons(1, Cons(73, Cons(193, Cons(234, Cons(1, Cons(72, Cons(193, Cons(127, Cons(8, Cons(1, Cons(72, Cons(135, Cons(194, Cons(72, Cons(135, Cons(208, Cons(72, Cons(135, Cons(192, Cons(76, Cons(135, Cons(192, Cons(73, Cons(135, Cons(199, Cons(204, Cons(204, Cons(204, Cons(204, Nil))))))))))))))))))))))))))))))))))))))))
fn la_pinned(tmp) = let asm = tmp + "/pinned.s" in if fs_write_sync(asm, la_pinned_src()) != 1 then "cannot write pinned-encoding fixture" else let elf = tmp + "/pinned.elf" in if la_input(tmp + "/lasm", asm, elf) != 0 then "native lasm rejected the pinned-encoding fixture: " + fs_read_file(elf + ".err") else if la_run("/usr/bin/as", Cons("--64", Cons("-o", Cons(tmp + "/pinned.o", Cons(asm, Nil)))), tmp + "/pinned.as.out") != 0 then "GNU as rejected the pinned-encoding fixture" else if la_bytes_at(elf, 120, la_pinned_bytes()) != 1 or fs_read_byte(elf, 160) >= 0 then "pinned shift-by-1 / xchg-%rax encodings changed (expected C1 /n 01 and REX.W 87 /r; see la_pinned_bytes)" else ""

## --- negative battery: silent mis-assembly must be impossible. Each case is one invalid (or
## unsupported) line that an earlier lasm ACCEPTED and encoded as something else; `lasm --strict` must
## now exit non-zero, print [L0001] naming `needle` on stderr and write zero bytes. Every case carries
## a near-identical VALID control line; all controls are assembled together by lasm AND by GNU as, so
## a rejection can never be explained by the surrounding fixture being broken.
fn la_n(bad, ctl, needle, rest) = Cons({bad: bad, ctl: ctl, needle: needle}, rest)
## a data-directive body: leave .text, emit `d` in .rodata, return to .text
fn la_ro(d) = "ret\n    .section .rodata\n    " + d + "\n    .section .text"
## operand count / operand kind
fn la_neg_a() = la_n("ret $8", "ret", "ret $8", la_n("syscall %rax", "syscall", "syscall %rax", la_n("cqto %rax", "cqto", "cqto %rax", la_n("hlt junk", "hlt", "junk", la_n("vzeroupper %ymm0", "vzeroupper", "vzeroupper %ymm0", la_n("outb", "outb %al, %dx", "outb", la_n("outb %al, $128", "outb %al, %dx", "outb %al, $128", la_n("inb %dx, %ax", "inb %dx, %al", "inb %dx, %ax", la_n("outl %ax, %dx", "outl %eax, %dx", "outl %ax, %dx", la_n("int $256", "int $255", "int $256", la_n("int $-1", "int $1", "int $-1", la_n("int %rax", "int $32", "int %rax", la_n("lgdt %rax", "lgdt (%rax)", "lgdt %rax", la_n("invlpg", "invlpg (%rdi)", "invlpg", la_n("pushq $5", "pushq %rbp", "pushq $5", la_n("pushq (%rax)", "pushq %rax", "pushq (%rax)", la_n("popq %eax", "popq %rax", "popq %eax", la_n("pushq", "pushq %r12", "pushq", Nil))))))))))))))))))
## branches
fn la_neg_b() = la_n("jmp", "jmp la_ctl", "jmp", la_n("jne", "jne la_ctl", "jne", la_n("call *%rax", "call la_ctl", "*%rax", la_n("jmp la_ctl, la_ctl", "jmp la_ctl", "la_ctl, la_ctl", la_n("jmp la_ctl+4", "jmp la_ctl", "la_ctl+4", la_n("jmp nosuch_label", "jmp la_ctl", "nosuch_label", la_n("jz 9f", "jz la_ctl", "9#0", Nil)))))))
## setcc / movzb / unary / imul / shifts
fn la_neg_c() = la_n("sete %rax", "sete %al", "sete %rax", la_n("sete $1", "sete (%rax)", "sete $1", la_n("setne %ax", "setne %cl", "setne %ax", la_n("movzbq %rax, %rbx", "movzbq %al, %rbx", "movzbq %rax, %rbx", la_n("movzbl %al, %rbx", "movzbl %al, %ebx", "movzbl %al, %rbx", la_n("movzbq $5, %rax", "movzbq (%rsi), %rax", "movzbq $5, %rax", la_n("negq", "negq %rax", "negq", la_n("negq $5", "negq (%rax)", "negq $5", la_n("incq %eax", "incq %rax", "incq %eax", la_n("mulq %rax, %rbx", "mulq %rbx", "mulq %rax, %rbx", la_n("imulq %rax", "imulq %rax, %rbx", "imulq %rax", la_n("imulq $3, %rax, %rbx", "imulq $3, %rbx", "imulq $3, %rax, %rbx", la_n("imulq $4294967296, %rax", "imulq $2147483647, %rax", "imulq $4294967296, %rax", la_n("imulq $5, (%rax)", "imulq (%rax), %rbx", "imulq $5, (%rax)", la_n("shlq %rax, %rbx", "shlq %cl, %rbx", "shlq %rax, %rbx", la_n("shlq %rbx", "shlq $3, %rbx", "shlq %rbx", la_n("shlq $256, %rax", "shlq $63, %rax", "shlq $256, %rax", la_n("sarq $-1, %rax", "sarq $1, %rax", "sarq $-1, %rax", la_n("shrq %cl, %eax", "shrq %cl, %rax", "shrq %cl, %eax", la_n("shrq %al, %rax", "shrq %cl, %rax", "shrq %al, %rax", Nil))))))))))))))))))))
## immediates that do not fit their field (they used to be truncated)
fn la_neg_d() = la_n("movq $4294967296, (%rax)", "movq $2147483647, (%rax)", "movq $4294967296, (%rax)", la_n("movq $-2147483649, 8(%rsp)", "movq $-2147483648, 8(%rsp)", "movq $-2147483649, 8(%rsp)", la_n("addq $4294967296, %rax", "addq $2147483647, %rax", "addq $4294967296, %rax", la_n("addq $2147483648, %rbx", "addq $-2147483648, %rbx", "addq $2147483648, %rbx", la_n("cmpq $4294967296, (%rdi)", "cmpq $2147483647, (%rdi)", "cmpq $4294967296, (%rdi)", la_n("movl $4294967296, %eax", "movl $4294967295, %eax", "movl $4294967296, %eax", la_n("subl $-2147483649, %ecx", "subl $-2147483648, %ecx", "subl $-2147483649, %ecx", la_n("movb $256, %al", "movb $255, %al", "movb $256, %al", la_n("movb $-129, (%rdi)", "movb $-128, (%rdi)", "movb $-129, (%rdi)", la_n("cmpb $256, (%rsi)", "cmpb $255, (%rsi)", "cmpb $256, (%rsi)", la_n("testq $4294967296, %rax", "testq $2147483647, %rax", "testq $4294967296, %rax", la_n("testb $256, %al", "testb $255, %al", "testb $256, %al", Nil))))))))))))
## immediate / displacement syntax lasm does not implement (hex, octal, symbols, expressions)
fn la_neg_e() = la_n("movq $0x10, %rax", "movq $16, %rax", "0x10", la_n("movq $010, %rax", "movq $10, %rax", "010", la_n("movq $12abc, %rax", "movq $12, %rax", "12abc", la_n("movq $la_ctl, %rax", "leaq la_ctl(%rip), %rax", "la_ctl", la_n("movq $, %rax", "movq $0, %rax", "integer ''", la_n("movq $1+2, %rax", "movq $3, %rax", "1+2", la_n("movq $9223372036854775808, %rax", "movq $9223372036854775807, %rax", "9223372036854775808", la_n("movq $-9223372036854775809, %rax", "movq $-9223372036854775808, %rax", "-9223372036854775809", la_n("movq 0x8(%rax), %rbx", "movq 8(%rax), %rbx", "0x8", la_n("movq 010(%rax), %rbx", "movq 10(%rax), %rbx", "010", la_n("movq 4294967296(%rax), %rbx", "movq 2147483647(%rax), %rbx", "4294967296(%rax)", la_n("movq -2147483649(%rax), %rbx", "movq -2147483648(%rax), %rbx", "-2147483649(%rax)", Nil))))))))))))
## mnemonics, suffixes and operand sizes
fn la_neg_f() = la_n("addw %ax, %ax", "addl %eax, %eax", "addw", la_n("addx %rax, %rbx", "addq %rax, %rbx", "addx", la_n("adds %rax, %rbx", "addq %rax, %rbx", "adds", la_n("add %rax, %rbx", "addq %rax, %rbx", "'add'", la_n("nop", "pause", "nop", la_n("MOVQ %rax, %rbx", "movq %rax, %rbx", "MOVQ", la_n("movw %ax, %dx", "movl %eax, %edx", "movw", la_n("testl %eax, %eax", "testq %rax, %rax", "testl", la_n("movq %eax, %rbx", "movq %rax, %rbx", "movq %eax, %rbx", la_n("movq %rax, %ebx", "movq %rax, %rbx", "movq %rax, %ebx", la_n("movl %rax, %rbx", "movl %eax, %ebx", "movl %rax, %rbx", la_n("movb %rax, (%rdi)", "movb %al, (%rdi)", "movb %rax, (%rdi)", la_n("movq %al, %rbx", "movq %rax, %rbx", "movq %al, %rbx", la_n("addq %eax, %rbx", "addq %rax, %rbx", "addq %eax, %rbx", la_n("cmpb %rax, %rcx", "cmpb %al, %cl", "cmpb %rax, %rcx", la_n("testb %rax, %rax", "testb %al, %al", "testb %rax, %rax", la_n("xorq %ax, %ax", "xorq %rax, %rax", "xorq %ax, %ax", Nil)))))))))))))))))
## operand combinations
fn la_neg_g() = la_n("movq (%rax), (%rbx)", "movq (%rax), %rbx", "movq (%rax), (%rbx)", la_n("movq %rax, $5", "movq $5, %rax", "movq %rax, $5", la_n("movq $5, $6", "movq $5, %rsi", "movq $5, $6", la_n("movq %rax", "movq %rax, %rax", "movq %rax", la_n("movq %rax, %rbx, %rcx", "movq %rax, %rbx", "movq %rax, %rbx, %rcx", la_n("addq (%rax), (%rbx)", "addq (%rax), %rbx", "addq (%rax), (%rbx)", la_n("addq %rax", "addq %rax, %rax", "addq %rax", la_n("leaq %rax, %rbx", "leaq (%rax), %rbx", "leaq %rax, %rbx", la_n("leaq (%rax), (%rbx)", "leaq (%rax), %rbx", "leaq (%rax), (%rbx)", la_n("leaq (%rax), %ebx", "leaq (%rax), %rbx", "leaq (%rax), %ebx", la_n("xchgq $5, %rax", "xchgq %rbx, %rax", "xchgq $5, %rax", la_n("lock xaddq %rax, %rbx", "lock xaddq %rax, (%rbx)", "lock xaddq %rax, %rbx", la_n("lxaddq %rax, (%rbx)", "xaddq %rax, (%rbx)", "lxaddq", la_n("lock addq %rax, (%rbx)", "addq %rax, (%rbx)", "lock addq", la_n("xaddq (%rax), %rbx", "xaddq %rbx, (%rax)", "xaddq (%rax), %rbx", la_n("movq %cr0, %eax", "movq %cr0, %rax", "movq %cr0, %eax", la_n("movq %cr1, %rax", "movq %cr2, %rax", "cr1", la_n("movq %cr0, (%rax)", "movq %cr0, %rbx", "movq %cr0, (%rax)", la_n("movl %cr0, %eax", "movq %cr0, %rax", "movl %cr0, %eax", la_n("movq %ymm0, %rax", "movq %rdx, %rax", "movq %ymm0, %rax", Nil))))))))))))))))))))
## registers lasm does not name
fn la_neg_h() = la_n("movq %r16, %rax", "movq %r15, %rax", "r16", la_n("movb %spl, %al", "movb %sil, %al", "spl", la_n("movb %ah, %al", "movb %bl, %al", "ah", la_n("movl %r8d, %eax", "movl %edi, %eax", "r8d", la_n("movl %esp, %eax", "movl %esi, %eax", "esp", la_n("movq %RAX, %rbx", "movq %rax, %rbx", "RAX", la_n("movq rax, %rbx", "movq %rax, %rbx", "rax", la_n("vmovdqu %xmm0, %ymm1", "vmovdqu %ymm0, %ymm1", "xmm0", la_n("vmovdqu %ymm16, %ymm1", "vmovdqu %ymm15, %ymm1", "ymm16", la_n("vmovdqu %ymm01, %ymm1", "vmovdqu %ymm1, %ymm1", "ymm01", Nil))))))))))
## memory operands
fn la_neg_i() = la_n("movq (%rax,%rsp,1), %rbx", "movq (%rsp,%rax,1), %rbx", "%rsp cannot be an index", la_n("movq (%rax,%rcx,3), %rbx", "movq (%rax,%rcx,4), %rbx", "scale '3'", la_n("movq (%rax,%rcx,16), %rbx", "movq (%rax,%rcx,8), %rbx", "scale '16'", la_n("movq (%rax,%rcx,), %rbx", "movq (%rax,%rcx), %rbx", "scale ''", la_n("movq (%eax), %rbx", "movq (%rax), %rbx", "%eax", la_n("movq (%rax,%ecx,2), %rbx", "movq (%rax,%rcx,2), %rbx", "%ecx", la_n("movq 8(%rax)junk, %rbx", "movq 8(%rax), %rbx", "8(%rax)junk", la_n("movq (%rax, %rbx", "movq (%rax), %rbx", "(%rax, %rbx", la_n("movq la_ctl(%rax), %rbx", "movq la_ctl(%rip), %rbx", "la_ctl(%rax)", la_n("movq la_ctl, %rbx", "movq la_ctl(%rip), %rbx", "'la_ctl'", la_n("movq 4096, %rbx", "movq 4096(%rax), %rbx", "'4096'", la_n("movq 8(%rip), %rbx", "movq la_ctl+8(%rip), %rbx", "8(%rip)", la_n("movq (%rip,%rax), %rbx", "movq (%rdi,%rax), %rbx", "rip", la_n("leaq nosuch_sym(%rip), %rax", "leaq la_ctl(%rip), %rax", "nosuch_sym", la_n("movq (,%rcx,8), %rbx", "movq (%rdx,%rcx,8), %rbx", "malformed memory operand register", la_n("movq (%ymm0), %rbx", "movq (%rbp), %rbx", "%ymm0", Nil))))))))))))))))
## trailing garbage / separators
fn la_neg_j() = la_n("ret # note:", "ret", "malformed label", la_n("movq %rax, %rbx junk", "movq %rax, %rbx", "rbx junk", la_n("movq %rax, %rbx # c", "movq %rax, %rbx", "rbx # c", la_n("movq %rax, %rbx,", "movq %rax, %rbx", "movq %rax, %rbx,", la_n("movq , %rbx", "movq %rdi, %rbx", "movq , %rbx", la_n("ret; ret", "ret", "operand 'ret'", Nil))))))
## vector forms
fn la_neg_k() = la_n("vmovdqu %zmm0, %zmm1", "vmovdqu64 %zmm0, %zmm1", "vmovdqu %zmm0, %zmm1", la_n("vmovdqu (%rax), %zmm1", "vmovdqu64 (%rax), %zmm1", "vmovdqu (%rax), %zmm1", la_n("vpxor %zmm0, %zmm1, %zmm2", "vpxorq %zmm0, %zmm1, %zmm2", "vpxor %zmm0", la_n("vpand (%rax), %zmm1, %zmm2", "vpandq (%rax), %zmm1, %zmm2", "vpand (%rax)", la_n("vpor %zmm0, %zmm1, %zmm2", "vporq %zmm0, %zmm1, %zmm2", "vpor %zmm0", la_n("vpaddq %ymm1, %ymm2", "vpaddq %ymm1, %ymm2, %ymm2", "vpaddq %ymm1, %ymm2", la_n("vpaddq %ymm1, %zmm2, %zmm3", "vpaddq %zmm1, %zmm2, %zmm3", "vpaddq %ymm1, %zmm2, %zmm3", la_n("vpaddq %ymm1, %ymm2, %zmm3", "vpaddq %ymm1, %ymm2, %ymm3", "vpaddq %ymm1, %ymm2, %zmm3", la_n("vpaddq %rax, %ymm1, %ymm2", "vpaddq %ymm0, %ymm1, %ymm2", "vpaddq %rax", la_n("vpaddq $1, %ymm1, %ymm2", "vpaddq (%rax), %ymm1, %ymm2", "vpaddq $1", la_n("vpaddq %ymm1, %ymm2, (%rax)", "vpaddq (%rax), %ymm2, %ymm1", "vpaddq %ymm1, %ymm2, (%rax)", la_n("vpaddq %ymm1, %ymm2, %ymm3, %ymm4", "vpaddq %ymm1, %ymm2, %ymm3", "ymm3, %ymm4", la_n("vmovdqu (%rax), (%rbx)", "vmovdqu (%rax), %ymm3", "vmovdqu (%rax), (%rbx)", la_n("vmovdqu %ymm0", "vmovdqu %ymm0, %ymm0", "vmovdqu %ymm0", la_n("vmovdqu64 %ymm0, %zmm1", "vmovdqu64 %ymm0, %ymm1", "vmovdqu64 %ymm0, %zmm1", la_n("vmovdqu %rax, %ymm0", "vmovdqu (%rax), %ymm0", "vmovdqu %rax, %ymm0", Nil))))))))))))))))
## directives and sections (data used to be dropped or misplaced without a word)
fn la_neg_l() = la_n(la_ro(".word 5"), la_ro(".byte 5"), ".word 5", la_n(la_ro(".zero 8"), la_ro(".quad 0"), ".zero 8", la_n(la_ro(".ascii \"abc\""), la_ro(".asciz \"abc\""), ".ascii", la_n(la_ro(".byte 256"), la_ro(".byte 255"), ".byte 256", la_n(la_ro(".byte 0x41"), la_ro(".byte 65"), "0x41", la_n(la_ro(".byte 1,"), la_ro(".byte 1, 2"), "integer ''", la_n(la_ro(".long 4294967296"), la_ro(".long 4294967295"), ".long 4294967296", la_n(la_ro(".long la_ctl"), la_ro(".quad la_ctl"), "la_ctl", la_n(la_ro(".quad 1, 2"), la_ro(".quad 1"), "1, 2", la_n(la_ro(".quad nosuch_q"), la_ro(".quad la_ctl"), "nosuch_q", la_n(la_ro(".asciz \"a\\x41\""), la_ro(".asciz \"a\\n\""), "escape", la_n(la_ro(".asciz \"a\\012\""), la_ro(".asciz \"a\\0\""), "escape", la_n(la_ro(".asciz \"abc"), la_ro(".asciz \"abc\""), "unterminated", la_n(la_ro(".asciz \"a\", \"b\""), la_ro(".asciz \"a, b\""), "after the string", la_n(la_ro(".balign 3"), la_ro(".balign 4"), ".balign 3", la_n(la_ro(".p2align 3"), la_ro(".balign 8"), ".p2align 3", la_n(".byte 1", la_ro(".byte 1"), "outside .section .rodata", la_n(la_ro("movq %rax, %rbx"), "movq %rax, %rbx", "outside .section .text", la_n("ret\n    .section .data\n    .section .text", "ret\n    .section .rodata\n    .section .text", ".section .data", la_n("ret\n    .text", "ret\n    .section .text", ".text", la_n("ret\n    .section .bss\n    .lcomm la_bx\n    .section .text", "ret\n    .section .bss\n    .lcomm la_bc, 8\n    .section .text", ".lcomm la_bx", la_n("ret\n    .section .bss\n    .lcomm la_by, 0x10\n    .section .text", "ret\n    .section .bss\n    .lcomm la_bd, 16\n    .section .text", "0x10", Nil))))))))))))))))))))))
fn la_cat(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, la_cat(t, ys))
fn la_neg_all() = la_cat(la_neg_a(), la_cat(la_neg_b(), la_cat(la_neg_c(), la_cat(la_neg_d(), la_cat(la_neg_e(), la_cat(la_neg_f(), la_cat(la_neg_g(), la_cat(la_neg_h(), la_cat(la_neg_i(), la_cat(la_neg_j(), la_cat(la_neg_k(), la_neg_l())))))))))))
fn la_neg_src(body) = "    .section .text\n_start:\nla_ctl:\n    " + body + "\n    ret\n"
fn la_neg_ctl(cs, acc) = match cs
    Nil        => acc
    Cons(c, t) => la_neg_ctl(t, acc + "    " + c.ctl + "\n")
fn la_neg_one(tmp, c) = let asm = tmp + "/neg_case.s" in if fs_write_sync(asm, la_neg_src(c.bad)) != 1 then "cannot write negative case" else let out = tmp + "/neg_case.elf" in let st = la_run(tmp + "/lasm", Cons("--strict", Cons(asm, Nil)), out) in if st == 0 then "lasm --strict ACCEPTED the invalid line `" + c.bad + "` (silent mis-assembly; expected an [L0001] error)" else let err = fs_read_file(out + ".err") in if la_contains(err, "[L0001]") == 0 then "lasm --strict rejected `" + c.bad + "` without [L0001] (status " + str(st) + "): " + err else if la_contains(err, c.needle) == 0 then "the [L0001] error for `" + c.bad + "` must name `" + c.needle + "`, got: " + err else if fs_read_byte(out, 0) >= 0 then "lasm --strict rejected `" + c.bad + "` but still wrote output bytes" else ""
fn la_neg_each(tmp, cs, k) = match cs
    Nil        => {err: "", cases: k}
    Cons(c, t) => let e = la_neg_one(tmp, c) in if e != "" then {err: e, cases: k} else la_neg_each(tmp, t, k + 1)
fn la_neg(tmp) = let cs = la_neg_all() in let asm = tmp + "/neg_controls.s" in if fs_write_sync(asm, "    .section .text\n_start:\nla_ctl:\n" + la_neg_ctl(cs, "") + "    ret\n") != 1 then {err: "cannot write negative-battery controls", cases: 0} else let elf = tmp + "/neg_controls.elf" in let st = la_run(tmp + "/lasm", Cons("--strict", Cons(asm, Nil)), elf) in if st != 0 or la_is_elf(elf) != 1 then {err: "lasm --strict rejected a VALID control line of the negative battery: " + fs_read_file(elf + ".err"), cases: 0} else if la_run("/usr/bin/as", Cons("--64", Cons("-o", Cons(tmp + "/neg_controls.o", Cons(asm, Nil)))), tmp + "/neg_controls.as.out") != 0 then {err: "GNU as rejected a control line of the negative battery: " + slice(fs_read_file(tmp + "/neg_controls.as.out.err"), 0, 600), cases: 0} else la_neg_each(tmp, cs, 0)

fn la_fail(m) = {err: m, note: ""}
## the native comparator must see a wrong byte, a short file and trailing bytes before its "identical" means anything
fn la_cmp_ctl(tmp) = let h = la_ctl_hdr(120, "") in let w = fs_write_sync(tmp + "/ctl.elf", h + "ABCDEFGH") in let b1 = fs_write_sync(tmp + "/ctl.bin", "ABCDEFGH") in if w != 1 or b1 != 1 then "cannot write comparator controls" else if la_size(tmp + "/ctl.bin") != 8 or la_size(tmp + "/ctl.elf") != 128 or la_size(tmp + "/ctl.missing") != 0 - 1 then "native size control failed" else if la_same_text(tmp, "ctl", 8) != 1 or la_cmp_off(tmp, "ctl", 8) != 0 - 1 then "native comparator rejected identical bytes" else let b2 = fs_write_sync(tmp + "/ctl.bin", "ABCDxFGH") in if la_same_text(tmp, "ctl", 8) != 0 or la_cmp_off(tmp, "ctl", 8) != 4 then "native comparator missed a wrong byte at offset 4" else let b3 = fs_write_sync(tmp + "/ctl.bin", "ABCD") in if la_same_text(tmp, "ctl", 8) != 0 or la_cmp_off(tmp, "ctl", 8) != 4 then "native comparator missed a short file" else let b4 = fs_write_sync(tmp + "/ctl.bin", "ABCDEFG") in if la_same_text(tmp, "ctl", 7) != 0 then "native comparator accepted a trailing byte that is not int3 padding" else let c = la_cat_rev(la_col3("a\tb\tmov x\tz\nno tab here\nq\tr\n", 31, 0, Nil), "") in if c != "mov x\n\n" then "native column extraction control failed: " + c else ""
fn la_ctl_hdr(n, acc) = if n <= 0 then acc else la_ctl_hdr(n - 1, acc + "h")
fn la_hard(root, tmp) = let tools = la_tools_ok() in if tools != "" then la_fail(tools) else let ctl = la_cmp_ctl(tmp) in if ctl != "" then la_fail(ctl) else let g = la_gen_run(tmp, 0, 0) in if g.err != "" then la_fail(g.err) else let a = la_alt(tmp) in if a.err != "" then la_fail(a.err) else let p = la_pinned(tmp) in if p != "" then la_fail(p) else let ng = la_neg(tmp) in if ng.err != "" then la_fail(ng.err) else {err: "", note: "; GNU as differential: " + str(g.lines) + " generated instruction lines in " + str(la_fam_count()) + " families byte-identical, " + str(a.lines) + " alternate-encoding lines disassembly-identical, " + str(ng.cases) + " invalid lines rejected with [L0001]"}

fn la_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else la_line_end(text, i + 1)
fn la_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, la_line_end(input, 0))

fn la_core(root, tmp) = let hello = la_hello(root, tmp) in if hello != "" then hello else let collisions = la_collisions(root, tmp) in if collisions != "" then collisions else let locals = la_local_labels(root, tmp) in if locals != "" then locals else let strict = la_strict_undefined(root, tmp) in if strict != "" then strict else let simd = la_vex_evex_simd(root, tmp) in if simd != "" then simd else let gas = la_gas_diff(root, tmp) in if gas != "" then gas else la_movabs(root, tmp)
fn la_main(root) = if lf_self_test() == 0 then la_fail("assembly fixture integrity check failed") else let tmp = root + "/build/lasm-gate" in let prepared = la_prepare(root, tmp) in if prepared != "" then la_fail(prepared) else let core = la_core(root, tmp) in if core != "" then la_fail(core) else la_hard(root, tmp)

fn la_dispatch(input) = let root = la_root(input) in if root == "" then ctfail("native assembly gate requires @root\n") else let r = la_main(root) in if r.err != "" then ctfail("native assembly gate failed: " + r.err + "\n") else "native Lume-generated assembly fixtures passed execution, ELF identity, collisions, and local-label checks" + r.note

print la_dispatch(readall())
