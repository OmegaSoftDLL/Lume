## crypto_tls_gate.src -- acceptance gate of the sovereign crypto + TLS 1.3 stack (compiler/stage1/lcrypto_tls.src).
##   printf '@root %s\n' "$PWD" | build/bin/crypto_tls_gate
## Runs, in this process and with no external tool (no OpenSSL, no C):
##   * every official vector: SHA-256 / SHA-512 (FIPS 180-4, incl. the one-million-'a' message), HMAC-SHA256
##     (RFC 4231 cases 1-7), HKDF-SHA256 (RFC 5869 A.1-A.3), ChaCha20 (RFC 8439 2.3.2, 2.4.2, A.1, A.2), Poly1305
##     (RFC 8439 2.5.2, 2.6.2, A.3 #1-#11, A.4), ChaCha20-Poly1305 (RFC 8439 2.8.2, A.5), Ed25519 (RFC 8032 7.1:
##     TEST 1, 2, 3, 1024, SHA(abc)), the TLS 1.3 key schedule of the RFC 8448 section 3 trace, and X25519 (RFC 7748
##     5.2 both vectors, 1 and 1,000 iterations, 6.1 Alice / Bob, the RFC 8448 section 3 key pairs and shared secret);
##     the 1,000-iteration vector (about a thousand ladders, ~10 s) runs here only, not in the unit tests;
##   * every rejection: tampered tag / ciphertext / AAD / nonce / key, forged and malleable signatures, altered
##     messages and keys, TLS records with a wrong sequence number, a replay, an altered header, a truncation;
##   * a TLS 1.3 record round trip in both directions over the ChaCha20-Poly1305 keys derived from the trace;
##   * the TLS 1.3 handshake state machines (client and server, RFC 8446 Appendix A): a full in-memory 1-RTT handshake
##     with fixed, caller-supplied ephemeral keys and randoms (x25519, Ed25519 CertificateVerify under a pinned raw
##     public key -- no X.509 --, Finished both ways), identical application secrets on both sides, application records
##     through the connected states; the same with a CertificateRequest; and every fail-closed rejection (tampered
##     Finished, CertificateVerify under another key, messages and records out of order, unoffered cipher suite,
##     missing / all-zero / low-order key_share, downgraded supported_versions, ...), each of which must end in the
##     error state with the expected alert and no secret or key left in the state;
##   * throughput: SHA-256, ChaCha20-Poly1305 seal + open, Ed25519 sign and verify.
## The first mismatch aborts with the vector's name, the value computed and the value expected.
use lcrypto_tls

fn cg_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else cg_line_end(s, i + 1)
fn cg_get_at(s, key, i) = if i >= count(s) then "" else let e = cg_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else cg_get_at(s, key, e + 1)
fn cg_ms(t0) = (os_monotonic_ns() - t0) / 1000000
fn cg_us(t0) = (os_monotonic_ns() - t0) / 1000
## one known-answer group: all its checks must pass, and exactly as many as the library declares
fn cg_group(st, name, k) = if k.err != "" then ctfail("crypto/TLS gate failed: " + k.err + "\n") else if k.n != lct_kat_expected(name) or k.n <= 0 then ctfail("crypto/TLS gate failed: group " + name + " ran " + str(k.n) + " checks, " + str(lct_kat_expected(name)) + " expected\n") else {checks: st.checks + k.n, groups: st.groups + 1}
fn cg_kats() = let s0 = {checks: 0, groups: 0} in let s1 = cg_group(s0, "sha256", lct_kat_sha256()) in let s2 = cg_group(s1, "sha512", lct_kat_sha512()) in let s3 = cg_group(s2, "hmac", lct_kat_hmac()) in let s4 = cg_group(s3, "hkdf", lct_kat_hkdf()) in let s5 = cg_group(s4, "chacha20", lct_kat_chacha20()) in let s6 = cg_group(s5, "poly1305", lct_kat_poly1305()) in let s7 = cg_group(s6, "aead", lct_kat_aead()) in let s8 = cg_group(s7, "ed25519", lct_kat_ed25519()) in cg_group(s8, "tls13", lct_kat_tls13())
## a gate that cannot fail proves nothing: a wrong expected value must be reported, and a corrupted input must change the answer
fn cg_self_check() = let k = lct_kat_hex(lct_kat_new(), "self-check", lct_sha256(lct_str_to_bytes("abc")), "00" + slice(lct_bytes_to_hex(lct_sha256(lct_str_to_bytes("abc"))), 2, 64)) in if k.err == "" then ctfail("crypto/TLS gate failed: the known-answer checker accepted a wrong digest\n") else if lct_bytes_to_hex(lct_sha256(lct_str_to_bytes("abd"))) == lct_bytes_to_hex(lct_sha256(lct_str_to_bytes("abc"))) then ctfail("crypto/TLS gate failed: SHA-256 does not depend on its input\n") else 1
## FIPS 180-4 long message: one million 'a'; also the SHA-256 throughput measurement. {us}
fn cg_sha_million() = let msg = lct_repeat(97, 1000000, Nil) in let t0 = os_monotonic_ns() in let h = lct_bytes_to_hex(lct_sha256(msg)) in let us = cg_us(t0) in if h != lct_sha256_million_a_hex() then ctfail("crypto/TLS gate failed: SHA-256 of one million 'a': got " + h + ", expected " + lct_sha256_million_a_hex() + "\n") else us
fn cg_fill(n, x, acc) = if n <= 0 then acc else cg_fill(n - 1, (x * 73 + 41) % 256, Cons(x, acc))
## 256 KiB through ChaCha20-Poly1305: seal, authenticated open, equality, and rejection after one flipped bit. {seal_us, open_us}
fn cg_aead_bulk() = let key = lct_hex_to_bytes("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f") in let nonce = lct_hex_to_bytes("070000004041424344454647") in let aad = lct_hex_to_bytes("50515253c0c1c2c3c4c5c6c7") in let pt = cg_fill(262144, 7, Nil) in let t0 = os_monotonic_ns() in let s = lct_aead_seal(key, nonce, aad, pt) in let seal_us = cg_us(t0) in let t1 = os_monotonic_ns() in let o = lct_aead_open(key, nonce, aad, s.ct, s.tag) in let open_us = cg_us(t1) in if o.ok != 1 or lct_ct_eq(o.pt, pt) != 1 then ctfail("crypto/TLS gate failed: 256 KiB ChaCha20-Poly1305 round trip did not return the plaintext\n") else if lct_len(s.ct) != 262144 or lct_ct_eq(s.ct, pt) == 1 then ctfail("crypto/TLS gate failed: 256 KiB ciphertext is the plaintext\n") else if (lct_aead_open(key, nonce, aad, lct_flip(s.ct, 1000, 1), s.tag)).ok != 0 then ctfail("crypto/TLS gate failed: one flipped bit in 256 KiB of ciphertext was accepted\n") else {seal_us: seal_us, open_us: open_us}
## Ed25519 timing on RFC 8032 TEST 3. {sign_us, verify_us}
fn cg_ed_bench() = let seed = lct_hex_to_bytes("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7") in let pk = lct_hex_to_bytes("fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025") in let msg = lct_hex_to_bytes("af82") in let t0 = os_monotonic_ns() in let sig = lct_ed25519_sign(seed, msg) in let sign_us = cg_us(t0) in let t1 = os_monotonic_ns() in let ok = lct_ed25519_verify(pk, msg, sig) in let verify_us = cg_us(t1) in if ok != 1 or lct_bytes_to_hex(sig) != "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a" then ctfail("crypto/TLS gate failed: Ed25519 RFC 8032 TEST 3 signature mismatch in the timing run\n") else {sign_us: sign_us, verify_us: verify_us}
## a TLS 1.3 conversation: both directions, 64 records each, fresh keys from HKDF, sequence numbers enforced
fn cg_tls_stream(key, iv, seq, n, acc) = if seq >= n then acc else let data = cg_fill(1 + seq * 37 % 900, seq, Nil) in let rec = lct_tls13_record_seal(key, iv, seq, 23, data) in let o = lct_tls13_record_open(key, iv, seq, rec) in if o.ok != 1 or o.ctype != 23 or lct_ct_eq(o.data, data) != 1 then ctfail("crypto/TLS gate failed: TLS 1.3 record " + str(seq) + " did not round-trip\n") else if (lct_tls13_record_open(key, iv, seq + 1, rec)).ok != 0 then ctfail("crypto/TLS gate failed: TLS 1.3 record " + str(seq) + " opened under sequence number " + str(seq + 1) + "\n") else cg_tls_stream(key, iv, lct_tls13_seq_next(seq), n, acc + lct_len(rec))
fn cg_tls_session() = let ks = lct_tls13_key_schedule(Nil, lct_sha256(lct_str_to_bytes("lume ecdhe shared secret")), lct_sha256(lct_str_to_bytes("hello transcript")), lct_sha256(lct_str_to_bytes("finished transcript"))) in let c = lct_tls13_traffic_keys(ks.c_ap, 32) in let s = lct_tls13_traffic_keys(ks.s_ap, 32) in if lct_ct_eq(c.key, s.key) == 1 or lct_ct_eq(c.iv, s.iv) == 1 or lct_ct_eq(ks.c_hs, ks.c_ap) == 1 then ctfail("crypto/TLS gate failed: TLS 1.3 traffic secrets are not separated\n") else cg_tls_stream(c.key, c.iv, 0, 64, 0) + cg_tls_stream(s.key, s.iv, 0, 64, 0)
## the groups added with X25519 and the handshake: {checks, groups, rej: fail-closed rejections (the group minus its one control check)}
fn cg_kats_hs(s0) = let rj = lct_kat_tls13_handshake_rejects() in let s1 = cg_group(s0, "x25519", lct_kat_x25519()) in let s2 = cg_group(s1, "handshake", lct_kat_tls13_handshake()) in let s3 = cg_group(s2, "handshake_rejects", rj) in {checks: s3.checks, groups: s3.groups, rej: rj.n - 1}
## RFC 7748 section 5.2, 1,000 iterations: {st, ms}
fn cg_x25519_1000(s0) = let t0 = os_monotonic_ns() in let s1 = cg_group(s0, "x25519_1000", lct_kat_x25519_1000()) in {checks: s1.checks, groups: s1.groups, ms: cg_ms(t0)}
## application data through two connected state machines, both directions: {wire}
fn cg_hs_ping(c, s, i, n, wire) = if i >= n then wire else let data = cg_fill(1 + i * 53 % 700, i, Nil) in let m = lct_tls13_send(c, data) in let s1 = lct_tls13_feed_all(s, (m.st).out) in let r = lct_tls13_send(s1, data) in let c1 = lct_tls13_feed_all(m.st, (r.st).out) in if m.ok != 1 or r.ok != 1 or lct_ct_eq(lct_concat(s1.app), data) != 1 or lct_ct_eq(lct_concat(c1.app), data) != 1 then ctfail("crypto/TLS gate failed: application record " + str(i) + " did not round-trip through the connected handshake states
") else cg_hs_ping(c1, r.st, i + 1, n, wire + lct_len(lct_concat((m.st).out)) + lct_len(lct_concat((r.st).out)))
## A full handshake with keys of the gate's own (not the vectors of the library): fixed here, random in real use.
## {steps, hs_us, hs_wire, app_wire}; 35 checks: both CONNECTED, secrets agree, the rejection checker refuses a healthy state, 32 records
fn cg_handshake() = let seed = lct_sha256(lct_str_to_bytes("crypto_tls_gate: server identity seed")) in let t0 = os_monotonic_ns() in let c1 = lct_tls13_client_start(lct_tls13_client_config(lct_sha256(lct_str_to_bytes("crypto_tls_gate: client random")), Nil, lct_sha256(lct_str_to_bytes("crypto_tls_gate: client x25519 private key")), lct_ed25519_public_key(seed))) in let s1 = lct_tls13_feed_all(lct_tls13_server_start(lct_tls13_server_config(lct_sha256(lct_str_to_bytes("crypto_tls_gate: server random")), lct_sha256(lct_str_to_bytes("crypto_tls_gate: server x25519 private key")), seed, 0)), c1.out) in let c7 = lct_tls13_feed_all(c1, s1.out) in let s2 = lct_tls13_feed_all(s1, c7.out) in let hs_us = cg_us(t0) in let cs = lct_tls13_secrets(c7) in let ss = lct_tls13_secrets(s2) in if c7.state != 7 or s2.state != 16 then ctfail("crypto/TLS gate failed: handshake ended in client state " + lct_tls13_state_name(c7.state) + " (alert " + str(c7.alert) + "), server state " + lct_tls13_state_name(s2.state) + " (alert " + str(s2.alert) + ")
") else if cs.ok != 1 or ss.ok != 1 or lct_len(cs.c_ap) != 32 or lct_ct_eq(cs.c_ap, ss.c_ap) != 1 or lct_ct_eq(cs.s_ap, ss.s_ap) != 1 or lct_ct_eq(cs.exp_master, ss.exp_master) != 1 or lct_ct_eq(cs.c_ap, cs.s_ap) == 1 then ctfail("crypto/TLS gate failed: client and server do not hold the same application traffic secrets after the handshake
") else if (lct_kat_hs_reject(lct_kat_new(), "self-check", c7, 51)).err == "" then ctfail("crypto/TLS gate failed: the rejection checker accepted a CONNECTED state as fail-closed
") else {steps: c7.steps + s2.steps, hs_us: hs_us, hs_wire: lct_len(lct_concat(c1.out)) + lct_len(lct_concat(s1.out)) + lct_len(lct_concat(c7.out)), app_wire: cg_hs_ping(c7, s2, 0, 16, 0)}
fn cg_rate(bytes, us) = if us <= 0 then "inf" else let r = bytes * 100000000 / us / 1048576 in str(r / 100) + "." + str(r / 10 % 10) + str(r % 10)
fn cg_msf(us) = str(us / 1000) + "." + str(us / 100 % 10)
fn cg_main(input) = let root = cg_get_at(input, "root", 0) in if root == "" then ctfail("crypto/TLS gate requires @root\n") else let t0 = os_monotonic_ns() in let z = cg_self_check() in let sa = cg_kats_hs(cg_kats()) in let kat_ms = cg_ms(t0) in let st = cg_x25519_1000(sa) in let hs = cg_handshake() in let sha_us = cg_sha_million() in let ae = cg_aead_bulk() in let ed = cg_ed_bench() in let t1 = os_monotonic_ns() in let wire = cg_tls_session() in let tls_ms = cg_ms(t1) in "OK: crypto/TLS gate: " + str(st.checks + 299) + " checks passed (" + str(st.checks) + " official-vector and rejection checks in " + str(st.groups) + " groups, " + str(kat_ms) + " ms + " + str(st.ms) + " ms for the X25519 1,000-iteration vector; 299 bulk, handshake, timing and self checks) [SHA-256/512 FIPS 180-4, HMAC RFC 4231, HKDF RFC 5869, ChaCha20-Poly1305 RFC 8439, Ed25519 RFC 8032, X25519 RFC 7748, TLS 1.3 RFC 8448]; TLS 1.3 handshake state machine: " + str(hs.steps) + " transitions, " + str(sa.rej) + " fail-closed rejections; 1-RTT x25519 + Ed25519 (pinned raw public key, no X.509) handshake " + str(hs.hs_wire) + " wire bytes in " + cg_msf(hs.hs_us) + " ms, then 32 application records / " + str(hs.app_wire) + " wire bytes through the connected states; SHA-256 1 MB in " + cg_msf(sha_us) + " ms = " + cg_rate(1000000, sha_us) + " MiB/s; ChaCha20-Poly1305 256 KiB seal " + cg_msf(ae.seal_us) + " ms = " + cg_rate(262144, ae.seal_us) + " MiB/s, open " + cg_msf(ae.open_us) + " ms = " + cg_rate(262144, ae.open_us) + " MiB/s; Ed25519 sign " + cg_msf(ed.sign_us) + " ms, verify " + cg_msf(ed.verify_us) + " ms; TLS 1.3 session 128 records / " + str(wire) + " wire bytes both directions in " + str(tls_ms) + " ms; total " + str(cg_ms(t0)) + " ms; zero C, zero OpenSSL"

print cg_main(readall())
