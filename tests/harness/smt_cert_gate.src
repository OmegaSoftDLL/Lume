## smt_cert_gate.src -- the exported .smt2 certificates of ltv are MACHINE-CHECKED, and the checker is measured.
##
## compiler/stage1/lsmt.src is a native, clean-room decision procedure for the certificate fragment. A checker that
## answered `unsat` to everything would pass any positive test, so this gate measures it against ground truth:
##   1. independence: the bundle the lsmt binary was built from defines only sm_* / lsmt_* / smt_* / test_lsmt_*
##      functions and has no `use` line (no code of ltv, lcert or the compiler);
##   2. fixed controls that need no external solver: tiny unsat scripts lsmt must prove, tiny sat scripts it must not,
##      malformed / out-of-subset scripts (each carrying an `(assert false)` so that a reader which skipped the broken
##      part would say unsat), all 46656 conjunctions of three comparisons of x with 0..2 against a brute-force truth,
##      truncations of a real certificate, forged certificates (assert false, a contradictory
##      extra assert, a weakened claim, redefined prelude): never `unsat`, and the exact verdict is checked;
##   3. fresh certificates: the real ltv validates compiler/stage1/lstd.src, examples/safety_envelope/
##      critical_kernels.src and the fixture below (with @chameleon 1 also lchameleon.src); every certificate must be
##      `unsat` by lsmt in-process, by the lsmt binary, and by z3 when /usr/bin/z3 (or /usr/local/bin/z3) exists;
##   4. soundness: every fresh certificate is mutated systematically (operator, constant, swapped ite branches, negated
##      condition, dropped conjunct, replaced body, altered define-fun, altered claim). z3 decides each mutant; lsmt
##      answering `unsat` where z3 answers `sat` (or rejects the text) is an UNSOUND acceptance and fails the gate.
##      The table counts, per class: mutants, z3 sat / unsat / error / unknown, sat mutants lsmt rejected, mutants both
##      prove, mutants only z3 proves (incompleteness, reported), unsound (must be 0).
## The gate prints whether the external solver ran. Without z3 the parts 1, 2, 3 (native) and the shape checks of 4
## still run and `external_solver` is "none"; with `@require_z3 1` a missing z3 is a failure.
##
## stdin: @root <repo>   [@require_z3 1]   [@solver none: run the native parts only]   [@chameleon 1]   [@corpus <dir of extra .smt2 that must all be unsat>]
##        [@sites <n>: mutation sites per class and certificate, default 2]   [@tmp <dir>, default /tmp/lume-smt-gate.<pid>]
use lsmt

fn sc_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else sc_line_end(s, i + 1)
fn sc_get_at(s, key, i) = if i >= count(s) then "" else let e = sc_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else sc_get_at(s, key, e + 1)
fn sc_get(s, key) = sc_get_at(s, key, 0)
fn sc_or(v, d) = if v == "" then d else v
fn sc_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn sc_index(s, n, part, m, i) = if i + m > n then 0 - 1 else if slicen(s, n, i, i + m) == part then i else sc_index(s, n, part, m, i + 1)
fn sc_idx(s, part, i) = sc_index(s, count(s), part, count(part), i)
fn sc_has(s, part) = if sc_idx(s, part, 0) >= 0 then 1 else 0
fn sc_starts(s, pre) = if count(s) >= count(pre) and slice(s, 0, count(pre)) == pre then 1 else 0
fn sc_ends(s, suf) = if count(s) >= count(suf) and slice(s, count(s) - count(suf), count(s)) == suf then 1 else 0
fn sc_rep1(s, pat, rep) = let i = sc_idx(s, pat, 0) in if i < 0 then s else slice(s, 0, i) + rep + slice(s, i + count(pat), count(s))
fn sc_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + sc_len(t)
fn sc_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => sc_rev(t, Cons(h, acc))
fn sc_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, sc_app(t, ys))
fn sc_nth(xs, k) = match xs
    Nil        => 0 - 1
    Cons(h, t) => if k == 0 then h else sc_nth(t, k - 1)
fn sc_join(xs, sep) = match xs
    Nil        => ""
    Cons(h, t) => h + (if sc_len(t) == 0 then "" else sep) + sc_join(t, sep)
fn sc_isdig(c) = if c >= "0" and c <= "9" then 1 else 0
fn sc_digits_end(s, i) = if i < count(s) and sc_isdig(at(s, i)) == 1 then sc_digits_end(s, i + 1) else i
fn sc_num(s, i, n, acc) = if i >= n then acc else sc_num(s, i + 1, n, acc * 10 + (ord(at(s, i)) - 48))
fn sc_field(out, key) = let i = sc_idx(out, "\"" + key + "\":", 0) in if i < 0 then 0 - 1 else let b = i + count(key) + 3 in if sc_digits_end(out, b) == b then 0 - 1 else sc_num(out, b, sc_digits_end(out, b), 0)
fn sc_jesc1(c) = if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then " " else c
fn sc_jesc_at(s, i, n) = if i >= n then "" else sc_jesc1(at(s, i)) + sc_jesc_at(s, i + 1, n)
fn sc_jesc(s) = sc_jesc_at(s, 0, if count(s) > 600 then 600 else count(s))
fn sc_run(bin, args, out, ms) = let st = os_run_capture_timeout(bin, args, out, out + ".err", ms) in {status: sc_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn sc_input(bin, args, inp, out, ms) = let st = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", ms) in {status: sc_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
## the non-empty lines of a text
fn sc_lines(s, n, i, acc) = if i >= n then sc_rev(acc, Nil) else let e = sc_line_end(s, i) in sc_lines(s, n, e + 1, if e > i then Cons(slicen(s, n, i, e), acc) else acc)
fn sc_smt2_of(names, dir, acc) = match names
    Nil        => sc_rev(acc, Nil)
    Cons(h, t) => sc_smt2_of(t, dir, if sc_ends(h, ".smt2") == 1 then Cons(dir + "/" + h, acc) else acc)
fn sc_smt2(dir) = let ls = fs_read_dir(dir) in sc_smt2_of(sc_lines(ls, count(ls), 0, Nil), dir, Nil)

## --- the external solver. The stack limit is reset first: a native Lume process raises it at start-up, the child
## inherits it, and z3 then cannot create a thread under an address-space limit (`ulimit -v`). ---
fn sc_solver() = if fs_path_exists("/usr/bin/z3") == 1 then "/usr/bin/z3" else if fs_path_exists("/usr/local/bin/z3") == 1 then "/usr/local/bin/z3" else ""
## the answer of one z3 run: unsat | sat | unknown (z3 said `unknown` or `timeout`) | error (z3 rejected the text) |
## failed (z3 did not answer at all: it could not be started or it died). A run that failed is repeated twice; a gate
## that counted a solver that did not run as "unknown" would silently check nothing.
fn sc_z3_once(cfg, path) = let st = os_run_capture_timeout("/bin/sh", Cons("-c", Cons("ulimit -s 8192; exec \"$0\" -T:10 \"$1\"", Cons(cfg.z3, Cons(path, Nil)))), cfg.tmp + "/z3.out", cfg.tmp + "/z3.err", 60000) in let out = fs_read_file(cfg.tmp + "/z3.out") in if sc_has(out, "(error") == 1 then "error" else if sc_starts(out, "unsat") == 1 then "unsat" else if sc_starts(out, "sat") == 1 then "sat" else if sc_starts(out, "unknown") == 1 or sc_starts(out, "timeout") == 1 then "unknown" else "failed"
fn sc_z3_try(cfg, path, k) = let r = sc_z3_once(cfg, path) in if r != "failed" or k <= 1 then r else let w = os_sleep_ms(300) in sc_z3_try(cfg, path, k - 1)
fn sc_z3(cfg, path) = if cfg.z3 == "" then "none" else sc_z3_try(cfg, path, 3)
fn sc_z3_text(cfg, text) = if cfg.z3 == "" then "none" else let w = fs_write_sync(cfg.tmp + "/one.smt2", text) in sc_z3(cfg, cfg.tmp + "/one.smt2")

## --- 1. independence ---
## every `fn` of the bundle has one of lsmt's prefixes: i is the start of a line
fn sc_fn_ok(s, n, i) = if slicen(s, n, i, i + 6) == "fn sm_" or slicen(s, n, i, i + 8) == "fn lsmt_" or slicen(s, n, i, i + 7) == "fn smt_" or slicen(s, n, i, i + 13) == "fn test_lsmt_" then 1 else 0
fn sc_bundle_scan(s, n, i, nf) = if i >= n then {err: "", nf: nf} else let e = sc_line_end(s, i) in if e - i >= 4 and slicen(s, n, i, i + 4) == "use " then {err: "the lsmt bundle has a `use` line: " + slicen(s, n, i, e), nf: nf} else if e - i >= 3 and slicen(s, n, i, i + 3) == "fn " then (if sc_fn_ok(s, n, i) == 1 then sc_bundle_scan(s, n, e + 1, nf + 1) else {err: "the lsmt bundle defines a function that is not lsmt's: " + slicen(s, n, i, if e - i > 60 then i + 60 else e), nf: nf}) else sc_bundle_scan(s, n, e + 1, nf)
fn sc_indep(cfg) = let bp = cfg.root + "/build/bin/lsmt.bundled.src" in if fs_path_exists(bp) == 0 then {err: "no " + bp + " (build lsmt with `./lume build compiler/stage1/lsmt.src -o build/bin/lsmt`)", nf: 0} else let b = fs_read_file(bp) in let src = fs_read_file(cfg.root + "/compiler/stage1/lsmt.src") in if b != src then {err: "build/bin/lsmt.bundled.src is not compiler/stage1/lsmt.src: the binary is stale or the bundle pulled other modules in", nf: 0} else let r = sc_bundle_scan(b, count(b), 0, 0) in if r.err != "" then r else if r.nf < 100 then {err: "the lsmt bundle has only " + str(r.nf) + " functions", nf: r.nf} else if sc_has(b, "tv_") == 1 or sc_has(b, "lumec_") == 1 or sc_has(b, "lcert_") == 1 or sc_has(b, "lc_") == 1 then {err: "the lsmt bundle mentions a tv_ / lumec_ / lcert_ / lc_ symbol", nf: r.nf} else let ow = sc_own(cfg, src) in if ow != "" then {err: ow, nf: r.nf} else r
## the lsmt this gate calls in-process is the one linked into the gate binary. `lume build` caches a bundle under the
## hash of the entry file and the total LENGTH of its modules, so an lsmt.src edited without changing its length can
## leave a stale lsmt in the gate: the gate's own bundle has to contain compiler/stage1/lsmt.src verbatim (all of it
## up to its final `print` line).
fn sc_own(cfg, src) = let gp = cfg.root + "/build/bin/smt_cert_gate.bundled.src" in if fs_path_exists(gp) == 0 then "no " + gp + " (build the gate with `./lume build tests/harness/smt_cert_gate.src -o build/bin/smt_cert_gate`)" else let gb = fs_read_file(gp) in let cut = sc_idx(src, "\nprint sm_finish(", 0) in let at0 = sc_idx(gb, slice(src, 0, sc_line_end(src, 0) + 1), 0) in if cut < 0 or at0 < 0 then "cannot locate lsmt.src in the bundle of the gate" else if slicen(gb, count(gb), at0, at0 + cut + 1) != slice(src, 0, cut + 1) then "the lsmt module linked into this gate binary is not the current compiler/stage1/lsmt.src (stale bundle cache: touch tests/harness/smt_cert_gate.src or change the length of lsmt.src, then rebuild the gate)" else ""

## --- 2. fixed controls. One script per line; the raw-mode ones are wrapped in sc_pre() ... (check-sat). ---
fn sc_pre() = "(set-logic QF_UFNIA)\n(declare-const x Int)\n(declare-const y Int)\n(declare-const b Bool)\n(declare-fun f (Int) Int)\n(declare-fun g (Int Int) Int)\n(declare-fun p (Int) Bool)\n"
fn sc_wrap(body) = sc_pre() + body + "\n(check-sat)\n"
fn sc_unsat_bodies() = "(assert false)\n(assert (and (< x 0) (>= x 0)))\n(assert (and (< x 3) (> x 5)))\n(assert (and (= x 4) (< x 0)))\n(assert (not (= (* (+ x y) (- x y)) (- (* x x) (* y y)))))\n(assert (not (= (f (+ x 1)) (f (+ 1 x)))))\n(assert (not (=> (< x y) (<= x y))))\n(assert (and (<= x 5) (>= x 5) (not (= x 5))))\n(assert (not (= (ite (< x 0) (- x) x) (ite (>= x 0) x (- 0 x)))))\n(assert (and b (not b)))\n(assert (and (p x) (not (p (+ x 0)))))\n(assert (not (= (g x (ite b 1 2)) (ite b (g x 1) (g x 2)))))\n(assert (< x 0)) (assert (> x 0))\n(assert (not (or (< x y) (= x y) (> x y))))\n(assert (not (= (+ x (* 2 y) (- x)) (* y 2))))\n(assert (and (= x y) (not (= y x))))\n(assert (and (< (f x) 0) (> (f x) 0)))\n(assert (not (= (- 5) (- 0 5))))\n(assert (and (> x 9223372036854775806) (< x 9223372036854775807)))\n(assert (not (= (* x 0) 0)))\n(assert (and (< x y) (< y x)))\n(assert (and (< x 1) (> x (- 1)) (not (= x 0))))\n(assert (not (= (= x y) (= (- x y) 0))))\n(assert (not (= (ite b x y) (ite (not b) y x))))\n(assert (and (not (= x 0)) (not (= x 1)) (>= x 0) (<= x 1)))\n(assert (not (= (+ x 9223372036854775808) (+ 9223372036854775808 x))))\n(assert (not (=> (and (>= x 0) (not (= x 0))) (>= x 1))))\n(assert (not (= (f (g x y)) (f (g (+ x 0) (* 1 y))))))\n(assert (and (< (* 2 x) 1) (> (* 2 x) (- 1)) (not (= x 0))))\n(assert (and (< (* 4 (- x y)) 0) (>= x y)))\n(assert (= (* 2 x) (+ (* 2 y) 1)))\n(assert (and (> (* 3 x) 3) (< (* 3 x) 6)))\n(assert (not (= b b)))\n(assert (not (= (< x y) (> y x))))\n(assert (and (= b (p x)) b (not (p x))))\n(assert (not (= (ite b (< x 0) (> x 0)) (or (and b (< x 0)) (and (not b) (> x 0))))))\n"
fn sc_sat_bodies() = "(assert true)\n(assert (< x 0))\n(assert (not (= (f x) (f y))))\n(assert (and (< x 5) (> x 3)))\n(assert (not (= (* x y) (+ x y))))\n(assert (and (<= x 5) (>= x 5)))\n(assert (not (= (ite b 1 2) 1)))\n(assert (and (p x) (not (p y))))\n(assert (or (< x 0) (> x 0)))\n(assert (not (= (g x y) (g y x))))\n(assert (= (* x x) 4))\n(assert (and (> x 0) (< x 2)))\n(assert (not (=> (<= x y) (< x y))))\n(assert (and (not (= x 0)) (>= x 0) (<= x 1)))\n(assert (and (not (= x 0)) (not (= x 1)) (>= x 0) (<= x 2)))\n(assert (= (+ x 9223372036854775807) y))\n(assert (not (= (- x y) (- y x))))\n(assert (= (f (f x)) x))\n(assert (and (< x 2) (> x (- 1)) (not (= x 0))))\n(assert (< x 99999999999999999999999))\n(assert (not (= (ite b x y) (ite b y x))))\n(assert (and (< x y) (< y (+ x 2))))\n(assert (not (= (* 2 x) (* x x))))\n(assert (and (not (= x 5)) (<= x 5) (>= x 4)))\n(assert (and (>= x 0) (not (= x 5)) (< x 3)))\n(assert (and (<= x 9) (not (= x 5)) (> x 7)))\n(assert (and (>= (- x y) 0) (not (= x (+ y 5))) (< x (+ y 3))))\n(assert (and (< (f x) (f y)) (< (f y) (+ (f x) 2))))\n(assert (and (> (* 3 x) 3) (< (* 3 x) 7)))\n(assert (= (* 2 x) (+ (* 2 y) 2)))\n(assert (and (<= (* 4 (- x y)) 3) (>= x y)))\n(assert (not (= (f (* 2 x)) (f (* 3 x)))))\n(assert (and (< (+ x (* 2 y)) 0) (>= (+ x (* 3 y)) 0)))\n(assert (not (= (+ (* 9223372036854775807 x) (* 9223372036854775807 x) (* 2 x)) 0)))\n(assert (not (= (* 4294967296 (* 4294967296 x)) 0)))\n(assert (not (= (* 4294967296 (* 4294967297 x)) (* 4294967296 x))))\n(assert (not (= (* (* 4294967296 x) (* 4294967297 y)) (* 4294967296 (* x y)))))\n(assert (= b (p x)))\n(assert (not (= b (p x))))\n(assert (= (< x 0) (> x 0)))\n(assert (not (= (< x 0) (<= x 0))))\n(assert (ite b (< x 0) (> x 0)))\n(assert (not (= (+ x 9223372036854775808) (+ 9223372036854775809 x))))\n(assert (not (=> (>= x 0) (>= x 1))))\n(assert (and (> x 9223372036854775805) (< x 9223372036854775807)))\n(assert (not (= (f (g x y)) (f (g y x)))))\n"
## true over the integers but beyond the procedure (a coefficient leaves 64 bits, non-linear reasoning):
## the honest answer is `unknown`
fn sc_beyond_bodies() = "(assert (not (= (* 4611686018427387904 (* 2 x)) (* 2 (* 4611686018427387904 x)))))\n(assert (< (* x x) 0))\n(assert (and (> x 0) (> y 0) (< (* x y) 0)))\n"
## verdict|script. Every script would be `unsat` for a checker that dropped the offending part.
fn sc_bad_scripts() = "malformed|(set-logic QF_UFNIA) (assert false) (check-sat))\nmalformed|(set-logic QF_UFNIA) (assert false) (check-sat\nmalformed|(set-logic QF_UFNIA) (assert false)\nmalformed|(set-logic QF_UFNIA) (declare-const x Int) (assert (< x z)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (declare-const x Int) (declare-const x Int) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (define-fun d () Bool false) (define-fun d () Bool true) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (declare-const x Int) (assert (+ x 1)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (declare-const b Bool) (assert (< b 1)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (declare-fun f (Int) Int) (assert (= (f 1 2) 0)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (declare-fun k () Int) (assert (= (k) 0)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (declare-fun f (Int) Int) (assert (= f 0)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (assert (= 01 1)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (assert (= 1x 1)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) junk (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) () (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (frobnicate) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (set-logic QF_UFNIA) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (assert false false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (assert 0) (check-sat)\nmalformed|(set-logic QF_UFNIA) (assert (not)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (assert (ite false false)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (assert (ite false 1 false)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (define-fun d () Int false) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (define-fun d ((n Int) (n Int)) Int n) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (declare-const and Bool) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (declare-const 5 Int) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (define-fun d () Bool d) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (assert false) (check-sat 1)\nmalformed|(set-logic QF_UFNIA) (assert (= 1 false)) (assert false) (check-sat)\nmalformed|(set-logic QF_UFNIA) (assert false) ' (check-sat)\nmalformed|\nunsupported|(set-logic QF_LIA) (assert false) (check-sat)\nunsupported|(assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (push 1) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (assert (let ((z 1)) false)) (check-sat)\nunsupported|(set-logic QF_UFNIA) (declare-const x Int) (assert (= (div x 2) 0)) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (declare-const x Int) (assert (distinct x 1)) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (set-info :status unsat) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (echo \"hello\") (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (declare-const |a b| Int) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (assert (= #x10 16)) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (declare-const r Real) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (declare-fun h (Bool) Int) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (assert false) (check-sat) (get-model)\nunsupported|(set-logic QF_UFNIA) (assert false) (check-sat) (check-sat)\nunsupported|(set-logic QF_UFNIA) (assert false) (check-sat) (assert true)\nunsupported|(set-logic QF_UFNIA) (declare-const x.y Int) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (declare-const x Int) (assert (< x 1 2)) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (declare-const b Bool) (assert (and b)) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (define-fun d ((q Bool)) Bool q) (assert false) (check-sat)\nunsupported|(set-logic QF_UFNIA) (assert (forall ((z Int)) false)) (check-sat)\nunsupported|(set-logic QF_UFNIA) (assert (! false :named a)) (check-sat)\nunsupported|(set-logic QF_UFNIA) (declare-const x Int) (assert (= (mod x 2) 3)) (assert false) (check-sat)\n"
fn sc_bar(s, i) = if i >= count(s) then i else if at(s, i) == "|" then i else sc_bar(s, i + 1)
## bodies that must get verdict `want` in raw mode; with z3, its answer must be `zwant` ("" = not asked)
fn sc_bodies(cfg, lines, want, zwant, n) = match lines
    Nil        => {err: "", n: n}
    Cons(h, t) => let text = sc_wrap(h) in let v = (lsmt_solve_text(text)).verdict in if v != want then {err: "fixed control: lsmt answered `" + v + "` where `" + want + "` is required: " + h, n: n} else let z = if zwant == "" then "none" else sc_z3_text(cfg, text) in if z != "none" and z != zwant then {err: "fixed control: z3 answered `" + z + "` on a script the gate labels `" + zwant + "`: " + h, n: n} else if (lsmt_check_text(text)).verdict != "forged" then {err: "fixed control: certificate mode accepted the shape of a script that is not a certificate: " + h, n: n} else sc_bodies(cfg, t, want, zwant, n + 1)
fn sc_bads(lines, n) = match lines
    Nil        => {err: "", n: n}
    Cons(h, t) => let i = sc_bar(h, 0) in let want = slice(h, 0, i) in let text = slice(h, i + 1, count(h)) in let v = (lsmt_solve_text(text)).verdict in let c = (lsmt_check_text(text)).verdict in if v != want then {err: "malformed control: lsmt (raw) answered `" + v + "` where `" + want + "` is required: " + text, n: n} else if c != want then {err: "malformed control: lsmt (certificate) answered `" + c + "` where `" + want + "` is required: " + text, n: n} else sc_bads(t, n + 1)
fn sc_fixed(cfg) = let u = sc_unsat_bodies() in let s = sc_sat_bodies() in let y = sc_beyond_bodies() in let m = sc_bad_scripts() + "malformed|" in let a = sc_bodies(cfg, sc_lines(u, count(u), 0, Nil), "unsat", "unsat", 0) in if a.err != "" then {err: a.err, nu: 0, ns: 0, nb: 0, nm: 0} else let b = sc_bodies(cfg, sc_lines(s, count(s), 0, Nil), "unknown", "sat", 0) in if b.err != "" then {err: b.err, nu: 0, ns: 0, nb: 0, nm: 0} else let c = sc_bodies(cfg, sc_lines(y, count(y), 0, Nil), "unknown", "", 0) in if c.err != "" then {err: c.err, nu: 0, ns: 0, nb: 0, nm: 0} else let d = sc_bads(sc_lines(m, count(m), 0, Nil), 0) in if d.err != "" then {err: d.err, nu: 0, ns: 0, nb: 0, nm: 0} else if a.n < 25 or b.n < 25 or d.n < 50 then {err: "too few fixed controls ran", nu: 0, ns: 0, nb: 0, nm: 0} else {err: "", nu: a.n, ns: b.n, nb: c.n, nm: d.n}

## --- 3. fresh certificates from the real ltv ---
fn sc_fixture() = "fn k7() -> int = 7\nfn usek(x: int) -> int = x + k7()\nfn usek2(x: int) -> int = if k7() < x then k7() * 2 else x\nfn big2(x: int) -> int = x + 4611686018427387904\nfn big3(x: int, y: int) -> int = (x - 4611686018427387903) * y\nfn dm(x: int, y: int) -> int = if y == 0 then 0 else x / y + x % y\nfn dm2(x: int, y: int) -> int = (x / y) * y + x % y\nfn bits(x: int, y: int) -> int = bit_and(x, y) + bit_or(x, 3) + bit_xor(y, x) + bit_shl(x, 2) + bit_shr(y, 1)\nfn bl(x: int, y: int) -> bool = x < y and (y <= 10 or x != 3)\nfn bl2(a: bool, b: bool) -> bool = if a then b else a == b\nfn tr(x: int) -> int = if x < 0 then ctfail(\"neg\\n\") else if x > 100 then ctfail(\"big\\n\") else x * x\nfn lt3(x: int, y: int, z: int) -> int = let a = x * y in let b = a + z in if b >= a then b - a else a * b\nfn nest(x: int, y: int) -> int = usek(dm(x, y)) + tr(bits(x, y))\nfn neg(x: int) -> int = 0 - x\nfn mx(x: int, y: int) -> int = if x >= y then x else y\nfn cube(x: int) -> int = x * x * x - 3 * x * x + 3 * x - 1\nfn cmpc(x: int) -> bool = (x >= 5) == (not (x < 5))\nfn tri(x: int, y: int) -> int = if x < y then 0 - 1 else if x == y then 0 else 1\nfn clampi(x: int, lo: int, hi: int) -> int = if x < lo then lo else if x > hi then hi else x\nprint usek(1)\n"
## every certificate of a directory: lsmt in-process and z3. bad collects "name: why" of the first failures
fn sc_check_files(cfg, files, n, nz, bad) = match files
    Nil        => {n: n, nz: nz, bad: bad}
    Cons(h, t) => let text = fs_read_file(h) in let r = lsmt_check_text(text) in let z = sc_z3(cfg, h) in sc_check_files(cfg, t, n + (if r.verdict == "unsat" then 1 else 0), nz + (if z == "unsat" then 1 else 0), bad + (if r.verdict != "unsat" then h + ": lsmt " + r.verdict + " (" + r.why + "); " else "") + (if z != "none" and z != "unsat" then h + ": z3 " + z + "; " else ""))
fn sc_module(cfg, stem, src) = let dir = cfg.tmp + "/fresh/" + stem in let mk = os_run("/bin/mkdir", Cons("-p", Cons(dir, Nil))) in let w = fs_write_sync(cfg.tmp + "/" + stem + ".in", "@root " + cfg.root + "\n@src " + src + "\n@out " + dir + "\n") in let p = sc_input(cfg.root + "/build/bin/ltv", Nil, cfg.tmp + "/" + stem + ".in", cfg.tmp + "/" + stem + ".json", 1200000) in let nv = sc_field(p.out, "validated") in if p.status != 0 or sc_has(p.out, "\"ok\":true") == 0 then {err: "ltv did not validate " + src + ": " + sc_jesc(p.out) + sc_jesc(p.err), files: Nil, n: 0, nz: 0, ms: 0} else if nv < 1 or nv != sc_field(p.out, "typed_integer_functions") then {err: "ltv validated " + str(nv) + " of " + str(sc_field(p.out, "typed_integer_functions")) + " functions of " + src, files: Nil, n: 0, nz: 0, ms: 0} else let files = sc_smt2(dir) in if sc_len(files) != nv then {err: "ltv validated " + str(nv) + " functions of " + src + " but " + dir + " has " + str(sc_len(files)) + " certificates", files: Nil, n: 0, nz: 0, ms: 0} else let c = sc_check_files(cfg, files, 0, 0, "") in if c.bad != "" then {err: "a certificate ltv issued for " + src + " is not machine-checked: " + c.bad, files: Nil, n: 0, nz: 0, ms: 0} else let wi = fs_write_sync(cfg.tmp + "/" + stem + ".lsmt.in", "@dir " + dir + "\n") in let q = sc_input(cfg.root + "/build/bin/lsmt", Nil, cfg.tmp + "/" + stem + ".lsmt.in", cfg.tmp + "/" + stem + ".lsmt.json", 600000) in if q.status != 0 or sc_has(q.out, "\"ok\":true") == 0 or sc_field(q.out, "files") != nv or sc_field(q.out, "unsat") != nv then {err: "the lsmt binary did not prove the " + str(nv) + " certificates of " + src + ": status " + str(q.status) + " " + sc_jesc(q.out) + sc_jesc(q.err), files: Nil, n: 0, nz: 0, ms: 0} else {err: "", files: files, n: c.n, nz: c.nz, ms: sc_field(q.out, "elapsed_ms")}
fn sc_bundle_of(cfg, src) = let r = sc_run(cfg.root + "/build/bin/lume_driver", Cons("bundle", Cons(src, Nil)), cfg.tmp + "/bundle.out", 600000) in let ln = sc_lines(r.out, count(r.out), 0, Nil) in if r.status != 0 or sc_len(ln) != 1 then "" else let p = sc_nth(ln, 0) in if sc_starts(p, "./") == 1 then cfg.root + "/" + slice(p, 2, count(p)) else p
fn sc_mods(cfg) = Cons({stem: "lstd", src: cfg.root + "/compiler/stage1/lstd.src"}, Cons({stem: "critical_kernels", src: cfg.root + "/examples/safety_envelope/critical_kernels.src"}, Cons({stem: "smtfix", src: cfg.tmp + "/smtfix.src"}, if cfg.cham == 1 then Cons({stem: "lchameleon", src: sc_bundle_of(cfg, cfg.root + "/compiler/stage1/lchameleon.src")}, Nil) else Nil)))
fn sc_fresh_each(cfg, mods, files, n, nz, ms, per) = match mods
    Nil        => {err: "", files: files, n: n, nz: nz, ms: ms, per: per}
    Cons(h, t) => if h.src == "" then {err: "cannot bundle the module `" + h.stem + "` (run the gate from the repository root)", files: Nil, n: 0, nz: 0, ms: 0, per: ""} else let r = sc_module(cfg, h.stem, h.src) in if r.err != "" then {err: r.err, files: Nil, n: 0, nz: 0, ms: 0, per: ""} else sc_fresh_each(cfg, t, sc_app(files, r.files), n + r.n, nz + r.nz, ms + r.ms, per + (if per == "" then "" else ",") + "{\"module\":\"" + h.stem + "\",\"certificates\":" + str(sc_len(r.files)) + ",\"lsmt_unsat\":" + str(r.n) + ",\"z3_unsat\":" + str(r.nz) + ",\"lsmt_binary_ms\":" + str(r.ms) + "}")
## the exporter regression: a callee without parameters is the constant f_k7, not the ill-formed application (f_k7)
fn sc_zero_arity(cfg) = let p = cfg.tmp + "/fresh/smtfix/smtfix__usek.smt2" in let t = fs_read_file(p) in if fs_path_exists(p) == 0 then "the fixture certificate smtfix__usek.smt2 is missing" else if sc_has(t, "(declare-fun f_k7 () Int)") == 0 then "smtfix__usek.smt2 does not declare the callee f_k7" else if sc_has(t, "(f_k7)") == 1 then "smtfix__usek.smt2 applies the zero-arity callee as `(f_k7)`, which is not SMT-LIB" else if sc_has(t, "(+ f_k7 x_x)") == 0 and sc_has(t, "(+ x_x f_k7)") == 0 then "smtfix__usek.smt2 does not use the callee f_k7 as a constant" else ""
fn sc_fresh(cfg) = let w = fs_write_sync(cfg.tmp + "/smtfix.src", sc_fixture()) in let r = sc_fresh_each(cfg, sc_mods(cfg), Nil, 0, 0, 0, "") in if r.err != "" then r else let z = sc_zero_arity(cfg) in if z != "" then {err: z, files: Nil, n: 0, nz: 0, ms: 0, per: ""} else r

## --- forged and truncated certificates, built from a real one ---
fn sc_claim() = "(assert (not (and (= trap_ast trap_x86) (=> (not trap_ast) (and ret_x86 (= val_ast val_x86))))))"
fn sc_want(text, want, what) = let c = (lsmt_check_text(text)).verdict in if c == want then "" else "forged control `" + what + "`: lsmt (certificate) answered `" + c + "` where `" + want + "` is required; "
fn sc_forged(cfg, cert) = let base = lsmt_check_text(cert) in if base.verdict != "unsat" or sc_has(cert, sc_claim()) == 0 then "the certificate the forged controls start from is not a proved certificate" else sc_want(sc_rep1(cert, sc_claim(), "(assert false)"), "forged", "assert false") + sc_want(sc_rep1(cert, sc_claim(), "(assert (and ret_x86 (not ret_x86)))"), "forged", "assert (and x (not x))") + sc_want(sc_rep1(cert, sc_claim(), "(assert false)\n" + sc_claim()), "forged", "contradictory extra assert before the claim") + sc_want(sc_rep1(cert, sc_claim() + "\n(check-sat)", sc_claim() + "\n(assert false)\n(check-sat)"), "forged", "contradictory extra assert after the claim") + sc_want(sc_rep1(cert, "(= val_ast val_x86))))))", "(= val_ast val_ast))))))"), "forged", "claim compares val_ast with itself") + sc_want(sc_rep1(cert, "(and ret_x86 (= val_ast val_x86))", "(= val_ast val_x86)"), "forged", "claim without ret_x86") + sc_want(sc_rep1(cert, "(=> (not trap_ast) ", "(=> trap_ast "), "forged", "claim guarded by trap_ast") + sc_want(sc_rep1(cert, "(define-fun trap_ast () Bool ", "(declare-const trap_ast Bool)\n(define-fun trap_ast_was () Bool "), "forged", "trap_ast declared, not defined") + sc_want(sc_rep1(cert, "(declare-fun lume_div (Int Int) Int)", "(define-fun lume_div ((a Int) (c Int)) Int 0)"), "forged", "lume_div defined") + sc_want(sc_rep1(cert, "(<= n 4611686018427387903)", "(<= n 4611686018427387902)"), "forged", "lume_fits63 altered") + sc_want(sc_rep1(cert, "(define-fun trap_ast ", "(define-fun extra () Bool true)\n(define-fun trap_ast "), "forged", "extra definition") + sc_want(sc_rep1(cert, "(define-fun trap_ast ", "(declare-const y_extra Int)\n(define-fun trap_ast "), "forged", "declaration outside the x_ / f_ name spaces") + sc_want(sc_rep1(cert, "(define-fun val_x86 () Int ", "(define-fun val_x86 () Int (+ 0 "), "malformed", "unbalanced body") + sc_want(sc_rep1(cert, "(check-sat)", "(check-sat)\n(check-sat)"), "unsupported", "two check-sat") + sc_want(sc_rep1(cert, "(set-logic QF_UFNIA)", "(set-logic QF_UFLIA)"), "unsupported", "another logic") + sc_want(sc_rep1(cert, "(check-sat)\n", ""), "malformed", "no check-sat") + sc_want(sc_rep1(cert, "(define-fun val_ast () Int ", "(define-fun val_ast () Int (+ undeclared_symbol "), "malformed", "unknown symbol")
fn sc_trunc(cert, n, k, bad) = if k > 15 then bad else let cut = if k == 15 then n - 2 else if k == 14 then n - 12 else n * k / 14 in let t = slicen(cert, n, 0, cut) in let c = (lsmt_check_text(t)).verdict in let r = (lsmt_solve_text(t)).verdict in sc_trunc(cert, n, k + 1, bad + (if c != "malformed" or r != "malformed" then "a certificate truncated to " + str(cut) + " of " + str(n) + " bytes is `" + c + "` / `" + r + "`, not malformed; " else ""))

## --- 4. mutants ---
fn sc_close(s, n, i, d) = if i >= n then n else let c = at(s, i) in if c == "(" then sc_close(s, n, i + 1, d + 1) else if c == ")" then (if d == 1 then i + 1 else sc_close(s, n, i + 1, d - 1)) else sc_close(s, n, i + 1, d)
fn sc_tok_end(s, n, i) = if i >= n then n else let c = at(s, i) in if c == " " or c == ")" or c == "\n" then i else sc_tok_end(s, n, i + 1)
## the end (exclusive) of the term that starts at i
fn sc_term_end(s, n, i) = if i < n and at(s, i) == "(" then sc_close(s, n, i + 1, 1) else sc_tok_end(s, n, i)
fn sc_positions(s, n, pat, m, i, hi, acc) = let j = sc_index(s, n, pat, m, i) in if j < 0 or j >= hi then sc_rev(acc, Nil) else sc_positions(s, n, pat, m, j + 1, hi, Cons(j, acc))
## at most k of the positions, spread from the first to the last
fn sc_spread(ps, len, k, i, acc) = if i >= k or i >= len then sc_rev(acc, Nil) else sc_spread(ps, len, k, i + 1, Cons(sc_nth(ps, if len <= k then i else if k == 1 then 0 else i * (len - 1) / (k - 1)), acc))
fn sc_sites(s, n, pat, lo, hi, k) = let ps = sc_positions(s, n, pat, count(pat), lo, hi, Nil) in sc_spread(ps, sc_len(ps), k, 0, Nil)
fn sc_mk(cl, s, t, rest) = if t == s then rest else Cons({c: cl, t: t}, rest)
## kind 0: replace pat by rep; 1: swap the branches of an ite; 2: negate the condition of an ite; 3 / 4: keep only the
## left / right operand of a binary and / or
fn sc_mut1(kind, s, n, j, pat, rep) = if kind == 0 then slicen(s, n, 0, j) + rep + slicen(s, n, j + count(pat), n) else let a0 = j + count(pat) in let a1 = sc_term_end(s, n, a0) in let b0 = a1 + 1 in let b1 = sc_term_end(s, n, b0) in if kind == 3 then slicen(s, n, 0, j) + slicen(s, n, a0, a1) + slicen(s, n, b1 + 1, n) else if kind == 4 then slicen(s, n, 0, j) + slicen(s, n, b0, b1) + slicen(s, n, b1 + 1, n) else if kind == 2 then slicen(s, n, 0, a0) + "(not " + slicen(s, n, a0, a1) + ")" + slicen(s, n, a1, n) else let c0 = b1 + 1 in let c1 = sc_term_end(s, n, c0) in slicen(s, n, 0, b0) + slicen(s, n, c0, c1) + " " + slicen(s, n, b0, b1) + slicen(s, n, c1, n)
fn sc_site_muts(cl, kind, s, n, sites, pat, rep, rest) = match sites
    Nil        => rest
    Cons(j, t) => sc_mk(cl, s, sc_mut1(kind, s, n, j, pat, rep), sc_site_muts(cl, kind, s, n, t, pat, rep, rest))
fn sc_op(cl, kind, pat, rep, s, n, lo, hi, k, rest) = sc_site_muts(cl, kind, s, n, sc_sites(s, n, pat, lo, hi, k), pat, rep, rest)
## numerals: a digit run that follows a blank; the mutant adds one
fn sc_num_sites(s, n, i, hi, acc) = if i >= hi then sc_rev(acc, Nil) else if sc_isdig(at(s, i)) == 1 and at(s, i - 1) == " " then sc_num_sites(s, n, sc_digits_end(s, i), hi, Cons(i, acc)) else sc_num_sites(s, n, i + 1, hi, acc)
fn sc_const_muts(s, n, sites, rest) = match sites
    Nil        => rest
    Cons(j, t) => let e = sc_digits_end(s, j) in if e - j > 17 then sc_const_muts(s, n, t, rest) else Cons({c: "constant-plus-one", t: slicen(s, n, 0, j) + str(sc_num(s, j, e, 0) + 1) + slicen(s, n, e, n)}, sc_const_muts(s, n, t, rest))
## the body of (define-fun name () sort body): {b0, b1}, b0 < 0 when absent
fn sc_body(s, n, head) = let i = sc_index(s, n, head, count(head), 0) in if i < 0 then {b0: 0 - 1, b1: 0} else {b0: i + count(head), b1: sc_term_end(s, n, i + count(head))}
fn sc_body_text(s, n, head) = let b = sc_body(s, n, head) in if b.b0 < 0 then "" else slicen(s, n, b.b0, b.b1)
fn sc_setbody(cl, s, n, head, pre, post, whole, rest) = let b = sc_body(s, n, head) in if b.b0 < 0 then rest else sc_mk(cl, s, slicen(s, n, 0, b.b0) + (if whole != "" then whole else pre + slicen(s, n, b.b0, b.b1) + post) + slicen(s, n, b.b1, n), rest)
fn sc_muts(s, k) = let n = count(s) in let lo = sc_index(s, n, "(define-fun trap_ast ", 21, 0) in let hi = sc_index(s, n, "(assert ", 8, 0) in if lo < 0 or hi < lo then Nil else sc_op("rel-weaken", 0, "(< ", "(<= ", s, n, lo, hi, k, sc_op("condition-negate", 0, "(< ", "(>= ", s, n, lo, hi, k, sc_op("eq-to-lt", 0, "(= ", "(< ", s, n, lo, hi, k, sc_op("add-to-mul", 0, "(+ ", "(* ", s, n, lo, hi, k, sc_op("mul-to-add", 0, "(* ", "(+ ", s, n, lo, hi, k, sc_op("and-to-or", 0, "(and ", "(or ", s, n, lo, hi, k, sc_op("or-to-and", 0, "(or ", "(and ", s, n, lo, hi, k, sc_op("drop-not", 0, "(not ", "(and true ", s, n, lo, hi, k, sc_op("ite-swap", 1, "(ite ", "", s, n, lo, hi, k, sc_op("ite-condition-negate", 2, "(ite ", "", s, n, lo, hi, k, sc_op("drop-conjunct", 3, "(and ", "", s, n, lo, hi, k, sc_op("drop-conjunct", 4, "(and ", "", s, n, lo, hi, k, sc_op("drop-disjunct", 3, "(or ", "", s, n, lo, hi, k, sc_op("drop-disjunct", 4, "(or ", "", s, n, lo, hi, k, sc_const_muts(s, n, sc_spread(sc_num_sites(s, n, lo, hi, Nil), sc_len(sc_num_sites(s, n, lo, hi, Nil)), k, 0, Nil), sc_muts2(s, n))))))))))))))))
fn sc_muts2(s, n) = sc_setbody("value-replace", s, n, "(define-fun val_x86 () Int ", "(+ 1 ", ")", "", sc_setbody("value-replace", s, n, "(define-fun val_x86 () Int ", "", "", "0", sc_setbody("value-replace", s, n, "(define-fun val_ast () Int ", "(+ ", " 1)", "", sc_setbody("value-as-ast", s, n, "(define-fun val_x86 () Int ", "", "", sc_body_text(s, n, "(define-fun val_ast () Int "), sc_setbody("trap-replace", s, n, "(define-fun trap_x86 () Bool ", "(not ", ")", "", sc_setbody("trap-replace", s, n, "(define-fun trap_x86 () Bool ", "", "", "false", sc_setbody("trap-replace", s, n, "(define-fun trap_ast () Bool ", "", "", "true", sc_setbody("ret-replace", s, n, "(define-fun ret_x86 () Bool ", "(not ", ")", "", sc_setbody("ret-replace", s, n, "(define-fun ret_x86 () Bool ", "", "", "false", sc_muts3(s, n))))))))))
## these change the prelude or the claim: certificate mode has to call every one of them forged
fn sc_muts3(s, n) = sc_mk("define-fun-alter", s, sc_rep1(s, "(<= n 4611686018427387903)", "(<= n 4611686018427387902)"), sc_mk("define-fun-alter", s, sc_rep1(s, "Bool (and (<= (- 4611686018427387904) n)", "Bool (or (<= (- 4611686018427387904) n)"), sc_mk("define-fun-alter", s, sc_rep1(s, "(declare-fun lume_div (Int Int) Int)", "(define-fun lume_div ((a Int) (c Int)) Int (+ a c))"), sc_mk("claim-alter", s, sc_rep1(s, sc_claim(), "(assert false)"), sc_mk("claim-alter", s, sc_rep1(s, "(= val_ast val_x86))))))", "(= val_ast val_ast))))))"), sc_mk("claim-alter", s, sc_rep1(s, sc_claim(), "(assert false)\n" + sc_claim()), sc_mk("claim-alter", s, sc_rep1(s, "(and ret_x86 (= val_ast val_x86))", "(= val_ast val_x86)"), sc_mk("claim-alter", s, sc_rep1(s, "(assert (not (and (= trap_ast trap_x86)", "(assert (and true (and (= trap_ast trap_x86)"), sc_mk("claim-alter", s, sc_rep1(s, "(and (= trap_ast trap_x86) (=> ", "(or (= trap_ast trap_x86) (=> "), Nil)))))))))
fn sc_base(p, i, last) = if i >= count(p) then last else sc_base(p, i + 1, if at(p, i) == "/" then i + 1 else last)
fn sc_basename(p) = slice(p, sc_base(p, 0, 0), count(p))
fn sc_shape_class(c) = if c == "define-fun-alter" or c == "claim-alter" then 1 else 0
## the table: one row per class {c, n, zs, zu, ze, zk, rj, bu, lu, xu, fg, bad}
fn sc_row0(c) = {c: c, n: 0, zs: 0, zu: 0, ze: 0, zk: 0, rj: 0, bu: 0, lu: 0, xu: 0, fg: 0, bad: 0}
fn sc_b(x) = if x then 1 else 0
fn sc_row_add(r, z, rc, rr, bad) = {c: r.c, n: r.n + 1, zs: r.zs + sc_b(z == "sat"), zu: r.zu + sc_b(z == "unsat"), ze: r.ze + sc_b(z == "error"), zk: r.zk + sc_b(z == "unknown"), rj: r.rj + sc_b(z == "sat" and rr != "unsat" and rc != "unsat"), bu: r.bu + sc_b(z == "unsat" and rr == "unsat"), lu: r.lu + sc_b(z == "unsat" and rr != "unsat"), xu: r.xu + sc_b(z == "unknown" and rr == "unsat"), fg: r.fg + sc_b(rc == "forged"), bad: r.bad + bad}
fn sc_tab_add(tab, c, z, rc, rr, bad) = match tab
    Nil        => Cons(sc_row_add(sc_row0(c), z, rc, rr, bad), Nil)
    Cons(h, t) => if h.c == c then Cons(sc_row_add(h, z, rc, rr, bad), t) else Cons(h, sc_tab_add(t, c, z, rc, rr, bad))
## one mutant. Unsound: z3 says sat (or rejects the text) and lsmt says unsat in either mode. A shape-class mutant
## has to be `forged` in certificate mode; any other mutant keeps the shape, so both modes must give the same verdict.
fn sc_one(cfg, m, st) = let path = cfg.tmp + "/mut.smt2" in let w = fs_write_sync(path, m.t) in let z = sc_z3(cfg, path) in let rc = (lsmt_check_text(m.t)).verdict in let rr = (lsmt_solve_text(m.t)).verdict in let unsound = if (z == "sat" or z == "error") and (rc == "unsat" or rr == "unsat") then 1 else 0 in let zf = if z == "failed" then 1 else 0 in let shape = if sc_shape_class(m.c) == 1 then (if rc != "forged" then 1 else 0) else (if rc != rr then 1 else 0) in let keep = if unsound + shape + zf > 0 then fs_write_sync(cfg.tmp + "/bad." + str(st.nbad) + ".smt2", m.t) else 0 in {tab: sc_tab_add(st.tab, m.c, z, rc, rr, unsound), inc: (if z == "unsat" and rr != "unsat" and sc_len(st.inc) < 20 then Cons("{\"class\":\"" + m.c + "\",\"certificate\":\"" + sc_jesc(sc_basename(st.cur)) + "\",\"lsmt\":\"" + rr + "\",\"why\":\"" + sc_jesc((lsmt_solve_text(m.t)).why) + "\"}", st.inc) else st.inc), nbad: st.nbad + unsound + shape + zf, why: st.why + (if zf == 1 and count(st.why) < 2000 then "z3 did not answer on a `" + m.c + "` mutant of " + st.cur + " (three attempts; stderr: " + sc_jesc(fs_read_file(cfg.tmp + "/z3.err")) + "); " else "") + (if unsound == 1 then "UNSOUND: lsmt answered unsat (certificate mode `" + rc + "`, raw mode `" + rr + "`) on a `" + m.c + "` mutant of " + st.cur + " that z3 answers `" + z + "` (kept as " + cfg.tmp + "/bad." + str(st.nbad) + ".smt2); " else "") + (if shape == 1 then "a `" + m.c + "` mutant of " + st.cur + " got certificate verdict `" + rc + "` and raw verdict `" + rr + "` (kept as " + cfg.tmp + "/bad." + str(st.nbad) + ".smt2); " else ""), cur: st.cur}
fn sc_each_mut(cfg, ms, st) = match ms
    Nil        => st
    Cons(h, t) => sc_each_mut(cfg, t, sc_one(cfg, h, st))
fn sc_mutants(cfg, files, st) = match files
    Nil        => st
    Cons(h, t) => let r = sc_each_mut(cfg, sc_muts(fs_read_file(h), cfg.sites), {tab: st.tab, inc: st.inc, nbad: st.nbad, why: st.why, cur: h}) in sc_mutants(cfg, t, r)
fn sc_sum(tab, a) = match tab
    Nil        => a
    Cons(h, t) => sc_sum(t, {n: a.n + h.n, zs: a.zs + h.zs, zu: a.zu + h.zu, ze: a.ze + h.ze, zk: a.zk + h.zk, rj: a.rj + h.rj, bu: a.bu + h.bu, lu: a.lu + h.lu, xu: a.xu + h.xu, fg: a.fg + h.fg, bad: a.bad + h.bad})
fn sc_row_json(h) = "{\"class\":\"" + h.c + "\",\"mutants\":" + str(h.n) + ",\"z3_sat\":" + str(h.zs) + ",\"z3_unsat\":" + str(h.zu) + ",\"z3_error\":" + str(h.ze) + ",\"z3_unknown\":" + str(h.zk) + ",\"sat_rejected_by_lsmt\":" + str(h.rj) + ",\"unsat_by_both\":" + str(h.bu) + ",\"unsat_by_z3_only\":" + str(h.lu) + ",\"lsmt_unsat_z3_unknown\":" + str(h.xu) + ",\"forged_by_shape\":" + str(h.fg) + ",\"unsound\":" + str(h.bad) + "}"
fn sc_tab_json(tab) = match tab
    Nil        => ""
    Cons(h, t) => sc_row_json(h) + (if sc_len(t) == 0 then "" else ",") + sc_tab_json(t)
fn sc_classes() = Cons("rel-weaken", Cons("condition-negate", Cons("eq-to-lt", Cons("add-to-mul", Cons("mul-to-add", Cons("and-to-or", Cons("or-to-and", Cons("drop-not", Cons("ite-swap", Cons("ite-condition-negate", Cons("drop-conjunct", Cons("drop-disjunct", Cons("constant-plus-one", Cons("value-replace", Cons("value-as-ast", Cons("trap-replace", Cons("ret-replace", Cons("define-fun-alter", Cons("claim-alter", Nil)))))))))))))))))))
fn sc_row_of(tab, c) = match tab
    Nil        => sc_row0(c)
    Cons(h, t) => if h.c == c then h else sc_row_of(t, c)
## every class has mutants; with z3, every class that changes the meaning has sat mutants and all of them rejected
fn sc_class_check(tab, cs, z3) = match cs
    Nil        => ""
    Cons(c, t) => let r = sc_row_of(tab, c) in if r.n == 0 then "the mutation class `" + c + "` is empty" else if z3 != "" and c != "value-as-ast" and c != "define-fun-alter" and r.zs == 0 then "no mutant of the class `" + c + "` is sat for z3: the class tests nothing" else if r.rj != r.zs then "class `" + c + "`: " + str(r.zs) + " sat mutants, only " + str(r.rj) + " rejected" else if sc_shape_class(c) == 1 and r.fg != r.n then "class `" + c + "`: " + str(r.n) + " mutants, only " + str(r.fg) + " called forged" else sc_class_check(tab, t, z3)

## --- the binary: exit status and JSON on mixed input ---
fn sc_hex1(o) = let d = "0123456789abcdef" in at(d, o / 16) + at(d, o % 16)
fn sc_hex_at(s, i, n) = if i >= n then "" else sc_hex1(ord(at(s, i))) + sc_hex_at(s, i + 1, n)
fn sc_cli(cfg, good) = let lsmt = cfg.root + "/build/bin/lsmt" in let sat = sc_wrap("(assert (< x 0))") in let w1 = fs_write_sync(cfg.tmp + "/cli.sat.smt2", sat) in let w2 = fs_write_sync(cfg.tmp + "/cli.unsat.smt2", sc_wrap("(assert (and (< x 0) (> x 0)))")) in let w3 = fs_write_hex_file(cfg.tmp + "/cli.nul.smt2", sc_hex_at("(set-logic QF_UFNIA)(assert false)(check-sat)", 0, 45) + "00" + sc_hex_at("(assert true)", 0, 13)) in let i1 = fs_write_sync(cfg.tmp + "/cli1.in", "@file " + good + "\n@file " + cfg.tmp + "/cli.sat.smt2\n@file " + cfg.tmp + "/no-such-file.smt2\n") in let r1 = sc_input(lsmt, Nil, cfg.tmp + "/cli1.in", cfg.tmp + "/cli1.out", 60000) in let i2 = fs_write_sync(cfg.tmp + "/cli2.in", "@root " + cfg.root + "\n") in let r2 = sc_input(lsmt, Nil, cfg.tmp + "/cli2.in", cfg.tmp + "/cli2.out", 60000) in let i3 = fs_write_sync(cfg.tmp + "/cli3.in", "@mode raw\n@file " + cfg.tmp + "/cli.unsat.smt2\n") in let r3 = sc_input(lsmt, Nil, cfg.tmp + "/cli3.in", cfg.tmp + "/cli3.out", 60000) in let i4 = fs_write_sync(cfg.tmp + "/cli4.in", "@file " + cfg.tmp + "/cli.unsat.smt2\n") in let r4 = sc_input(lsmt, Nil, cfg.tmp + "/cli4.in", cfg.tmp + "/cli4.out", 60000) in let i5 = fs_write_sync(cfg.tmp + "/cli5.in", "@mode raw\n@file " + cfg.tmp + "/cli.nul.smt2\n") in let r5 = sc_input(lsmt, Nil, cfg.tmp + "/cli5.in", cfg.tmp + "/cli5.out", 60000) in let i6 = fs_write_sync(cfg.tmp + "/cli6.in", "@budget 1\n@file " + good + "\n") in let r6 = sc_input(lsmt, Nil, cfg.tmp + "/cli6.in", cfg.tmp + "/cli6.out", 60000) in if r1.status != 1 or sc_field(r1.out, "files") != 3 or sc_field(r1.out, "unsat") != 1 or sc_field(r1.out, "forged") != 1 or sc_field(r1.out, "malformed") != 1 or sc_has(r1.out, "\"ok\":false") == 0 then "lsmt binary, mixed input (one certificate, one non-certificate, one missing file): status " + str(r1.status) + " " + sc_jesc(r1.out) else if r2.status != 1 or sc_field(r2.out, "files") != 0 or sc_has(r2.out, "\"ok\":false") == 0 then "lsmt binary without any file must fail: status " + str(r2.status) + " " + sc_jesc(r2.out) else if r3.status != 0 or sc_field(r3.out, "unsat") != 1 or sc_has(r3.out, "\"mode\":\"raw\"") == 0 then "lsmt binary, raw mode on a tiny unsat script: status " + str(r3.status) + " " + sc_jesc(r3.out) else if r4.status != 1 or sc_field(r4.out, "forged") != 1 then "lsmt binary, certificate mode on a script that is not a certificate: status " + str(r4.status) + " " + sc_jesc(r4.out) else if r5.status != 1 or sc_field(r5.out, "malformed") != 1 then "lsmt binary on a file with a NUL byte after a complete unsat script: status " + str(r5.status) + " " + sc_jesc(r5.out) else if good != "" and sc_field(r6.out, "unsat") == 1 and sc_field(r6.out, "evaluation_passes") > 2 then "lsmt binary ignored @budget 1: " + sc_jesc(r6.out) else ""

## --- an extra corpus (@corpus <dir>): every .smt2 must be unsat by the lsmt binary and by z3 ---
fn sc_z3_all(cfg, files, n, bad) = match files
    Nil        => {n: n, bad: bad}
    Cons(h, t) => let z = sc_z3(cfg, h) in sc_z3_all(cfg, t, n + (if z == "unsat" then 1 else 0), bad + (if z != "unsat" and z != "none" then h + ": z3 " + z + "; " else ""))
fn sc_corpus(cfg, dir) = if dir == "" then {err: "", json: ""} else let files = sc_smt2(dir) in let wi = fs_write_sync(cfg.tmp + "/corpus.in", "@dir " + dir + "\n") in let q = sc_input(cfg.root + "/build/bin/lsmt", Nil, cfg.tmp + "/corpus.in", cfg.tmp + "/corpus.json", 1200000) in let t0 = os_monotonic_ns() in let z = sc_z3_all(cfg, files, 0, "") in let zms = (os_monotonic_ns() - t0) / 1000000 in if sc_len(files) == 0 then {err: "@corpus " + dir + " has no .smt2 file", json: ""} else if q.status != 0 or sc_field(q.out, "unsat") != sc_len(files) then {err: "the lsmt binary did not prove the corpus " + dir + ": " + sc_jesc(q.out), json: ""} else if z.bad != "" then {err: "z3 did not prove the corpus " + dir + ": " + sc_jesc(z.bad), json: ""} else {err: "", json: ",\"corpus\":{\"dir\":\"" + sc_jesc(dir) + "\",\"files\":" + str(sc_len(files)) + ",\"lsmt_unsat\":" + str(sc_field(q.out, "unsat")) + ",\"lsmt_binary_ms\":" + str(sc_field(q.out, "elapsed_ms")) + ",\"z3_unsat\":" + str(z.n) + ",\"z3_ms\":" + str(zms) + "}"}

## --- exhaustive control of the comparison rules (R4, R6) that needs no solver: every conjunction of three atoms
## `x OP a` / `a OP x`, OP in < <= > >= = !=, a in 0..2 (36 atoms, 46656 scripts). The truth is computed here by
## trying every x in -4..7 (all constants are in 0..2, so a model exists iff one exists in that range).
fn sc_at_text(k) = let o = k % 6 in let a = str(k / 6 % 3) in let l = if k / 18 == 0 then "x" else a in let r = if k / 18 == 0 then a else "x" in if o == 5 then "(not (= " + l + " " + r + "))" else "(" + (if o == 0 then "<" else if o == 1 then "<=" else if o == 2 then ">" else if o == 3 then ">=" else "=") + " " + l + " " + r + ")"
fn sc_at_val(k, x) = let o = k % 6 in let a = k / 6 % 3 in let l = if k / 18 == 0 then x else a in let r = if k / 18 == 0 then a else x in if o == 0 then sc_b(l < r) else if o == 1 then sc_b(l <= r) else if o == 2 then sc_b(l > r) else if o == 3 then sc_b(l >= r) else if o == 4 then sc_b(l == r) else sc_b(l != r)
fn sc_tri_sat(i, j, k, x) = if x > 7 then 0 else if sc_at_val(i, x) == 1 and sc_at_val(j, x) == 1 and sc_at_val(k, x) == 1 then 1 else sc_tri_sat(i, j, k, x + 1)
fn sc_theory(t, ns, nu) = if t >= 46656 then {err: "", ns: ns, nu: nu} else let i = t / 1296 in let j = t / 36 % 36 in let k = t % 36 in let body = "(assert (and " + sc_at_text(i) + " " + sc_at_text(j) + " " + sc_at_text(k) + "))" in let v = (lsmt_solve_text("(set-logic QF_UFNIA)\n(declare-const x Int)\n" + body + "\n(check-sat)\n")).verdict in let sat = sc_tri_sat(i, j, k, 0 - 4) in if sat == 1 and v != "unknown" then {err: "UNSOUND (comparison rules): lsmt answered `" + v + "` on the satisfiable " + body, ns: ns, nu: nu} else if sat == 0 and v != "unsat" then {err: "lsmt answered `" + v + "` on " + body + ", which has no integer model (the single-base bound rule is expected to be complete here)", ns: ns, nu: nu} else sc_theory(t + 1, ns + sat, nu + 1 - sat)
## the same for the common-factor rule (R7) and negative constants: every conjunction of two atoms out of 96,
## `x OP a`, `a OP x`, `(* 2 x) OP a`, `a OP (* 3 x)` with a in -1..2 (9216 scripts), truth by trying x in -6..8
fn sc_p_lit(a) = if a < 0 then "(- " + str(0 - a) + ")" else str(a)
fn sc_p_text(k) = let o = k % 6 in let a = sc_p_lit(k / 6 % 4 - 1) in let fm = k / 24 in let xs = if fm == 2 then "(* 2 x)" else if fm == 3 then "(* 3 x)" else "x" in let l = if fm % 2 == 0 then xs else a in let r = if fm % 2 == 0 then a else xs in if o == 5 then "(not (= " + l + " " + r + "))" else "(" + (if o == 0 then "<" else if o == 1 then "<=" else if o == 2 then ">" else if o == 3 then ">=" else "=") + " " + l + " " + r + ")"
fn sc_p_val(k, x) = let o = k % 6 in let a = k / 6 % 4 - 1 in let fm = k / 24 in let xv = if fm == 2 then 2 * x else if fm == 3 then 3 * x else x in let l = if fm % 2 == 0 then xv else a in let r = if fm % 2 == 0 then a else xv in if o == 0 then sc_b(l < r) else if o == 1 then sc_b(l <= r) else if o == 2 then sc_b(l > r) else if o == 3 then sc_b(l >= r) else if o == 4 then sc_b(l == r) else sc_b(l != r)
fn sc_pair_sat(i, j, x) = if x > 8 then 0 else if sc_p_val(i, x) == 1 and sc_p_val(j, x) == 1 then 1 else sc_pair_sat(i, j, x + 1)
fn sc_pairs(t, ns, nu) = if t >= 9216 then {err: "", ns: ns, nu: nu} else let i = t / 96 in let j = t % 96 in let body = "(assert (and " + sc_p_text(i) + " " + sc_p_text(j) + "))" in let v = (lsmt_solve_text("(set-logic QF_UFNIA)\n(declare-const x Int)\n" + body + "\n(check-sat)\n")).verdict in let sat = sc_pair_sat(i, j, 0 - 6) in if sat == 1 and v != "unknown" then {err: "UNSOUND (comparison rules): lsmt answered `" + v + "` on the satisfiable " + body, ns: ns, nu: nu} else if sat == 0 and v != "unsat" then {err: "lsmt answered `" + v + "` on " + body + ", which has no integer model (the single-base rules are expected to be complete here)", ns: ns, nu: nu} else sc_pairs(t + 1, ns + sat, nu + 1 - sat)
fn sc_fail(msg) = ctfail("smt cert gate failed: " + msg + "\n")
fn sc_main(input) = let root = sc_get(input, "root") in if root == "" then ctfail("smt cert gate requires @root\n") else let tmp = sc_or(sc_get(input, "tmp"), "/tmp/lume-smt-gate." + str(os_getpid())) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp + "/fresh", Nil))) in let z3 = if sc_get(input, "solver") == "none" then "" else sc_solver() in let cfg = {root: root, tmp: tmp, z3: z3, cham: (if sc_get(input, "chameleon") == "1" then 1 else 0), sites: toint(sc_or(sc_get(input, "sites"), "2"))} in if z3 == "" and sc_get(input, "require_z3") == "1" then sc_fail("@require_z3 1 was given and no z3 is installed (/usr/bin/z3, /usr/local/bin/z3)") else if fs_path_exists(root + "/build/bin/lsmt") == 0 or fs_path_exists(root + "/build/bin/ltv") == 0 then sc_fail("build/bin/lsmt and build/bin/ltv are required (./lume build compiler/stage1/lsmt.src -o build/bin/lsmt ; ./lume build compiler/stage1/ltv.src -o build/bin/ltv)") else let ind = sc_indep(cfg) in if ind.err != "" then sc_fail(ind.err) else let fx = sc_fixed(cfg) in if fx.err != "" then sc_fail(fx.err) else let th = sc_theory(0, 0, 0) in if th.err != "" then sc_fail(th.err) else let tp = sc_pairs(0, 0, 0) in if tp.err != "" then sc_fail(tp.err) else let fr = sc_fresh(cfg) in if fr.err != "" then sc_fail(fr.err) else let nfresh = sc_len(fr.files) in if fr.n != nfresh then sc_fail("lsmt proved " + str(fr.n) + " of " + str(nfresh) + " fresh certificates") else if z3 != "" and fr.nz != nfresh then sc_fail("z3 proved " + str(fr.nz) + " of " + str(nfresh) + " fresh certificates") else let first = fs_read_file(sc_nth(fr.files, 0)) in let fg = sc_forged(cfg, first) + sc_trunc(first, count(first), 1, "") in if fg != "" then sc_fail(fg) else let cl = sc_cli(cfg, sc_nth(fr.files, 0)) in if cl != "" then sc_fail(cl) else let mu = sc_mutants(cfg, fr.files, {tab: Nil, inc: Nil, nbad: 0, why: "", cur: ""}) in let tot = sc_sum(mu.tab, {n: 0, zs: 0, zu: 0, ze: 0, zk: 0, rj: 0, bu: 0, lu: 0, xu: 0, fg: 0, bad: 0}) in if mu.nbad > 0 then sc_fail(mu.why) else if tot.n < 300 then sc_fail("only " + str(tot.n) + " mutants were generated (300 are required)") else if z3 != "" and tot.zs < 150 then sc_fail("only " + str(tot.zs) + " mutants are sat for z3: the mutation set proves nothing") else let cc = sc_class_check(mu.tab, sc_classes(), z3) in if cc != "" then sc_fail(cc) else let co = sc_corpus(cfg, sc_get(input, "corpus")) in if co.err != "" then sc_fail(co.err) else let clean = os_run("/bin/rm", Cons("-rf", Cons(tmp, Nil))) in "{\"ok\":true,\"gate\":\"smt_cert\",\"external_solver\":\"" + (if z3 == "" then "none" else z3) + "\",\"external_solver_ran\":" + (if z3 == "" then "false" else "true") + ",\"lsmt_bundle_functions\":" + str(ind.nf) + ",\"fixed_controls\":{\"tiny_unsat_proved\":" + str(fx.nu) + ",\"tiny_sat_not_proved\":" + str(fx.ns) + ",\"true_but_beyond_lsmt_unknown\":" + str(fx.nb) + ",\"malformed_or_unsupported\":" + str(fx.nm) + ",\"forged_controls\":17,\"truncations\":15,\"comparison_triples_sat_not_proved\":" + str(th.ns) + ",\"comparison_triples_unsat_proved\":" + str(th.nu) + ",\"scaled_pairs_sat_not_proved\":" + str(tp.ns) + ",\"scaled_pairs_unsat_proved\":" + str(tp.nu) + "},\"fresh_certificates\":" + str(nfresh) + ",\"lsmt_unsat\":" + str(fr.n) + ",\"lsmt_completeness_percent\":" + str(fr.n * 100 / nfresh) + ",\"z3_unsat\":" + str(fr.nz) + ",\"lsmt_binary_ms\":" + str(fr.ms) + ",\"modules\":[" + fr.per + "],\"mutants\":" + str(tot.n) + ",\"z3_sat\":" + str(tot.zs) + ",\"z3_unsat_equivalent\":" + str(tot.zu) + ",\"z3_error\":" + str(tot.ze) + ",\"z3_unknown\":" + str(tot.zk) + ",\"sat_rejected_by_lsmt\":" + str(tot.rj) + ",\"unsat_by_both\":" + str(tot.bu) + ",\"unsat_by_z3_only\":" + str(tot.lu) + ",\"lsmt_unsat_z3_unknown\":" + str(tot.xu) + ",\"forged_by_shape\":" + str(tot.fg) + ",\"unsound\":" + str(tot.bad) + ",\"unsat_by_z3_only_list\":[" + sc_join(sc_rev(mu.inc, Nil), ",") + "],\"mutation_table\":[" + sc_tab_json(mu.tab) + "]" + co.json + "}"

print sc_main(readall())
