## multi_arch_gate.src -- acceptance gate of the certified AArch64 / RISC-V kernel back ends
## (compiler/stage1/larm64.src, lriscv.src, ltv_multiarch.src; wired into compiler/stage1/ltarget.src).
##   printf '@root %s\n' "$PWD" | build/bin/multi_arch_gate
## What it checks, on every run:
##   1. Encoders against official encodings. The tables at the end of this file hold, for 52 A64 and 55 RISC-V
##      instructions, the word LLVM's integrated assembler (clang 21.1.8, --target=aarch64-linux-gnu /
##      --target=riscv64 -march=rv64im) emits for the listed assembly text; each must equal the word our encoder
##      builds from the fields. When /usr/bin/clang is installed the listing is assembled again, the `.text` of the
##      object is read natively and compared word for word (live differential); the same is attempted with
##      aarch64-linux-gnu-as / riscv64-linux-gnu-as when they exist, and their absence is reported, not hidden.
##   2. Containers: every field of the ELF headers and program headers of the emitted images, read back byte by byte
##      (e_machine 183 / 243, entry, PT_LOAD R+X and RW), `readelf -h` when present, the flat ROM image against the
##      ELF ROM segment, and the bytes build/bin/ltarget answers for each new triple against the in-process compile.
##   3. Execution equivalence over a corpus of kernels: native x86-64 (build/bin/lumec + build/bin/lasm), AArch64
##      (qemu-aarch64), RV64 (qemu-riscv64, Linux variant, plus the bare image's exit status) and RV32IM bare-metal on
##      the LumePuter interpreter (`rv_*` of lsafety_envelope.src), all against the reference semantics of lkir.src.
##      Trapping calls (division by zero, overflow, contract) must trap on every executor.
##   4. Translation validation: ltv_multiarch.src must validate every function of every corpus kernel on the three
##      images, and kill single-bit mutants of three functions per ISA (at least 95%; the survivors are counted and
##      split into never-executed words and re-encodings the validator proves equivalent).
## The emulators are started through `/bin/sh -c 'ulimit -s 8192; exec qemu-...'`: a Lume process raises its own stack
## limit to 4 GiB, qemu's helper threads would inherit that as their stack size and fail to start under a memory cap.
## Real level: qemu user mode and the LumePuter are emulators on this host; no AArch64 or RISC-V silicon is involved,
## and the bare AArch64 image is checked structurally and validated but not executed (no system emulator installed).
use larm64
use lriscv
use ltv_multiarch
use lsafety_envelope

fn mg_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else mg_line_end(s, i + 1)
fn mg_get_at(s, key, i) = if i >= count(s) then "" else let e = mg_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else mg_get_at(s, key, e + 1)
fn mg_chomp(s) = let n = count(s) in if n > 0 and (at(s, n - 1) == "\n" or at(s, n - 1) == "\r") then mg_chomp(slice(s, 0, n - 1)) else s
fn mg_has_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else mg_has_at(text, part, i + 1)
fn mg_has(text, part) = mg_has_at(text, part, 0)
fn mg_wait(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn mg_run(bin, args, out) = let st = os_run_capture_timeout(bin, args, out, out + ".err", 60000) in {rc: mg_wait(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn mg_fail(msg) = ctfail("multi arch gate failed: " + msg + "\n")
fn mg_write_bin(path, bytes) = if fs_write_hex_file(path, kir_hex(bytes)) != 1 then mg_fail("cannot write " + path) else os_run("/bin/chmod", Cons("+x", Cons(path, Nil)))
fn mg_rd(path, off, n) = if n <= 0 then 0 else fs_read_byte(path, off) + 256 * mg_rd(path, off + 1, n - 1)

## --- 1. encoder vectors ---------------------------------------------------------------------------------------------
fn mg_vec_static(vs, isa, n) = match vs
    Nil        => n
    Cons(h, t) => if h.g != h.w then mg_fail(isa + " encoder: '" + h.a + "' is " + kir_hex8(h.w) + " in the official encoding, the encoder built " + kir_hex8(h.g)) else mg_vec_static(t, isa, n + 1)
fn mg_vec_asm(vs) = match vs
    Nil        => ""
    Cons(h, t) => h.a + "\n" + mg_vec_asm(t)
## offset of the first executable PROGBITS section of a little-endian ELF64 relocatable object
fn mg_text_off(path, shoff, entsz, i, n) = if i >= n then 0 - 1 else let sh = shoff + i * entsz in if mg_rd(path, sh + 4, 4) == 1 and bit_and(mg_rd(path, sh + 8, 4), 4) == 4 then mg_rd(path, sh + 24, 8) else mg_text_off(path, shoff, entsz, i + 1, n)
fn mg_vec_live_cmp(vs, path, off, isa, tool, n) = match vs
    Nil        => n
    Cons(h, t) => if mg_rd(path, off, 4) != h.g then mg_fail(isa + " encoder vs " + tool + ": '" + h.a + "' assembles to " + kir_hex8(mg_rd(path, off, 4)) + ", the encoder built " + kir_hex8(h.g)) else mg_vec_live_cmp(t, path, off + 4, isa, tool, n + 1)
fn mg_vec_live(cfg, vs, isa, tool, bin, args) = let s = cfg.tmp + "/vec_" + isa + ".s" in let o = cfg.tmp + "/vec_" + isa + ".o" in let w = fs_write_sync(s, mg_vec_asm(vs)) in let r = mg_run(bin, kir_app(args, Cons(s, Cons("-o", Cons(o, Nil)))), cfg.tmp + "/vec_" + isa + ".log") in if r.rc != 0 then mg_fail(tool + " rejected the " + isa + " vector listing: " + r.err) else let off = mg_text_off(o, mg_rd(o, 40, 8), mg_rd(o, 58, 2), 0, mg_rd(o, 60, 2)) in if off < 0 then mg_fail("no .text in the object " + tool + " produced") else mg_vec_live_cmp(vs, o, off, isa, tool, 0)
fn mg_vectors(cfg) = let na = mg_vec_static(mg_a64_vectors(), "A64", 0) in let nr = mg_vec_static(mg_rv_vectors(), "RISC-V", 0) in let clang = fs_path_exists("/usr/bin/clang") in let la = if clang == 1 then mg_vec_live(cfg, mg_a64_vectors(), "a64", "clang (LLVM integrated assembler)", "/usr/bin/clang", Cons("--target=aarch64-linux-gnu", Cons("-c", Nil))) else 0 in let lr = if clang == 1 then mg_vec_live(cfg, mg_rv_vectors(), "rv", "clang (LLVM integrated assembler)", "/usr/bin/clang", Cons("--target=riscv64", Cons("-march=rv64im", Cons("-mno-relax", Cons("-c", Nil))))) else 0 in let ga = if fs_path_exists("/usr/bin/aarch64-linux-gnu-as") == 1 then mg_vec_live(cfg, mg_a64_vectors(), "a64gnu", "aarch64-linux-gnu-as", "/usr/bin/aarch64-linux-gnu-as", Nil) else 0 - 1 in let gr = if fs_path_exists("/usr/bin/riscv64-linux-gnu-as") == 1 then mg_vec_live(cfg, mg_rv_vectors(), "rvgnu", "riscv64-linux-gnu-as", "/usr/bin/riscv64-linux-gnu-as", Cons("-march=rv64im", Cons("-mno-relax", Nil))) else 0 - 1 in str(na) + " A64 + " + str(nr) + " RISC-V official encoding vectors identical; " + (if clang == 1 then "live against clang: " + str(la) + " + " + str(lr) + " words identical" else "clang not installed") + "; " + (if ga < 0 and gr < 0 then "GNU cross assembler not installed" else "GNU as: " + str(ga) + " + " + str(gr) + " words identical")

## --- 2. containers ----------------------------------------------------------------------------------------------------
fn mg_want(path, what, off, n, v) = let g = mg_rd(path, off, n) in if g != v then mg_fail(path + ": " + what + " is " + str(g) + ", expected " + str(v)) else 1
fn mg_readelf(path, word) = if fs_path_exists("/usr/bin/readelf") == 0 then 0 else let r = mg_run("/usr/bin/readelf", Cons("-h", Cons(path, Nil)), path + ".readelf") in if r.rc != 0 or mg_has(r.out, word) == 0 then mg_fail("readelf -h does not report " + word + " for " + path + ": " + r.out + r.err) else 1
fn mg_ident(path, class) = mg_want(path, "ELF magic", 0, 4, 1179403647) + mg_want(path, "EI_CLASS", 4, 1, class) + mg_want(path, "EI_DATA", 5, 1, 1) + mg_want(path, "EI_VERSION", 6, 1, 1) + mg_want(path, "e_type", 16, 2, 2) + mg_want(path, "e_version", 20, 4, 1)
fn mg_ph64(path, at0, flags, off, vaddr, filesz, memsz) = mg_want(path, "p_type", at0, 4, 1) + mg_want(path, "p_flags", at0 + 4, 4, flags) + mg_want(path, "p_offset", at0 + 8, 8, off) + mg_want(path, "p_vaddr", at0 + 16, 8, vaddr) + mg_want(path, "p_paddr", at0 + 24, 8, vaddr) + mg_want(path, "p_filesz", at0 + 32, 8, filesz) + mg_want(path, "p_memsz", at0 + 40, 8, memsz)
fn mg_ph32(path, at0, flags, off, vaddr, filesz, memsz) = mg_want(path, "p_type", at0, 4, 1) + mg_want(path, "p_offset", at0 + 4, 4, off) + mg_want(path, "p_vaddr", at0 + 8, 4, vaddr) + mg_want(path, "p_paddr", at0 + 12, 4, vaddr) + mg_want(path, "p_filesz", at0 + 16, 4, filesz) + mg_want(path, "p_memsz", at0 + 20, 4, memsz) + mg_want(path, "p_flags", at0 + 24, 4, flags)
fn mg_hdr64(path, machine, entry, phnum) = mg_ident(path, 2) + mg_want(path, "e_machine", 18, 2, machine) + mg_want(path, "e_entry", 24, 8, entry) + mg_want(path, "e_phoff", 32, 8, 64) + mg_want(path, "e_flags", 48, 4, 0) + mg_want(path, "e_ehsize", 52, 2, 64) + mg_want(path, "e_phentsize", 54, 2, 56) + mg_want(path, "e_phnum", 56, 2, phnum)
fn mg_hdr32(path, entry) = mg_ident(path, 1) + mg_want(path, "e_machine", 18, 2, 243) + mg_want(path, "e_entry", 24, 4, entry) + mg_want(path, "e_phoff", 28, 4, 52) + mg_want(path, "e_flags", 36, 4, 0) + mg_want(path, "e_ehsize", 40, 2, 52) + mg_want(path, "e_phentsize", 42, 2, 32) + mg_want(path, "e_phnum", 44, 2, 2)
fn mg_same_from(pa, oa, pb, ob, n) = if n <= 0 then 1 else if fs_read_byte(pa, oa) != fs_read_byte(pb, ob) then 0 else mg_same_from(pa, oa + 1, pb, ob + 1, n - 1)
## the bytes build/bin/ltarget answers for `triple` are the bytes of the in-process compile
fn mg_ltarget(cfg, triple, src, bytes) = let req = cfg.tmp + "/lt.in" in let w = fs_write_sync(req, "@compile " + triple + "\n" + src) in let st = os_run_input_capture_timeout(cfg.ltarget, Nil, req, cfg.tmp + "/lt.out", cfg.tmp + "/lt.err", 60000) in if mg_wait(st) != 0 then mg_fail("build/bin/ltarget failed on " + triple + ": " + fs_read_file(cfg.tmp + "/lt.err")) else if mg_chomp(fs_read_file(cfg.tmp + "/lt.out")) != "HEX:0:" + kir_hex(bytes) then mg_fail("build/bin/ltarget answers different bytes for " + triple + " than the in-process back end") else 1
fn mg_ltarget_err(cfg, triple) = let req = cfg.tmp + "/lt.in" in let w = fs_write_sync(req, "@compile " + triple + "\nfn f(xs) = count(xs)\nprint f(1)\n") in let st = os_run_input_capture_timeout(cfg.ltarget, Nil, req, cfg.tmp + "/lt.out", cfg.tmp + "/lt.err", 60000) in if mg_has(fs_read_file(cfg.tmp + "/lt.out"), "ERR:[T0901]") == 0 then mg_fail("build/bin/ltarget did not refuse a kernel outside the fragment for " + triple) else 1
## the lumec front end stands before the lowering: a kernel inside the fragment that lkir.src alone compiles (its
## contract would only trap at run time) but whose call lumec refutes statically gets `ERR:[T0902]` and no bytes
fn mg_front_src() = "fn g(x: int) -> int requires x >= 0 and x <= 10 ensures result <= 20 = x * 2\nprint g(11)\n"
fn mg_ltarget_front(cfg, triple) = let alone = la64_compile(mg_front_src(), "linux") in if alone.err != "" then mg_fail("the front-end fixture is not inside the kernel fragment: " + alone.err) else let req = cfg.tmp + "/lt.in" in let w = fs_write_sync(req, "@compile " + triple + "\n" + mg_front_src()) in let st = os_run_input_capture_timeout(cfg.ltarget, Nil, req, cfg.tmp + "/lt.out", cfg.tmp + "/lt.err", 60000) in let out = fs_read_file(cfg.tmp + "/lt.out") in if mg_has(out, "ERR:[T0902]") == 0 or mg_has(out, "[V0001]") == 0 or mg_has(out, "HEX:") == 1 then mg_fail("build/bin/ltarget lowered for " + triple + " a kernel that the lumec front end refutes: " + out) else 1
fn mg_containers(cfg) = let src = "fn sq(x: int) -> int requires x >= 0 ensures result >= 0 = x * x\nprint sq(12)\n" in let al = la64_compile(src, "linux") in let ab = la64_compile(src, "bare") in let r3 = lrv_compile(src, 32, "bare") in let r6 = lrv_compile(src, 64, "bare") in let rl = lrv_compile(src, 64, "linux") in if al.err != "" or ab.err != "" or r3.err != "" or r6.err != "" or rl.err != "" then mg_fail("container kernel did not compile: " + al.err + ab.err + r3.err + r6.err + rl.err) else let pa = cfg.tmp + "/c_a64.elf" in let pb = cfg.tmp + "/c_a64b.elf" in let p3 = cfg.tmp + "/c_rv32.elf" in let p6 = cfg.tmp + "/c_rv64.elf" in let pbin = cfg.tmp + "/c_rv32.bin" in let w = mg_write_bin(pa, al.bytes) + mg_write_bin(pb, ab.bytes) + mg_write_bin(p3, r3.elf) + mg_write_bin(p6, r6.elf) + mg_write_bin(pbin, r3.bin) in let na = 4 * kir_len(al.words) in let nb = 4 * kir_len(ab.words) in let n3 = 4 * kir_len(r3.words) in let n6 = 4 * kir_len(r6.words) in let c1 = mg_hdr64(pa, 183, 4194304 + 120, 1) + mg_ph64(pa, 64, 5, 0, 4194304, 120 + na, 120 + na) + mg_readelf(pa, "AArch64") in let c2 = mg_hdr64(pb, 183, 262144 + 176, 2) + mg_ph64(pb, 64, 5, 0, 262144, 176 + nb, 176 + nb) + mg_ph64(pb, 120, 6, 0, 524288, 0, 16384) + mg_readelf(pb, "AArch64") in let c3 = mg_hdr32(p3, 262144) + mg_ph32(p3, 52, 5, 4096, 262144, n3, n3) + mg_ph32(p3, 84, 6, 0, 524288, 0, 16384) + mg_readelf(p3, "RISC-V") in let c4 = mg_hdr64(p6, 243, 262144, 2) + mg_ph64(p6, 64, 5, 4096, 262144, n6, n6) + mg_ph64(p6, 120, 6, 0, 524288, 0, 16384) + mg_readelf(p6, "RISC-V") in let c5 = if mg_same_from(p3, 4096, pbin, 0, n3) == 1 and fs_read_byte(pbin, n3) < 0 and mg_rd(pbin, 0, 4) == lrv_lui(2, 132) then 1 else mg_fail("the flat RV32 ROM image is not the ROM segment of the ELF, or does not start with `lui sp, 0x84`") in let c6 = mg_ltarget(cfg, "aarch64-linux-gnu", src, al.bytes) + mg_ltarget(cfg, "aarch64-elf", src, ab.bytes) + mg_ltarget(cfg, "riscv32-none-elf", src, r3.elf) + mg_ltarget(cfg, "riscv32-none-bin", src, r3.bin) + mg_ltarget(cfg, "riscv64-none-elf", src, r6.elf) + mg_ltarget(cfg, "riscv64-none-bin", src, r6.bin) + mg_ltarget(cfg, "riscv64-linux-gnu", src, rl.elf) + mg_ltarget_err(cfg, "aarch64-linux-gnu") + mg_ltarget_err(cfg, "riscv32-none-elf") + mg_ltarget_front(cfg, "aarch64-linux-gnu") + mg_ltarget_front(cfg, "riscv64-linux-gnu") + mg_ltarget_front(cfg, "riscv32-none-bin") in "5 images, " + str(c1 + c2 + c3 + c4) + " header / program-header fields and readelf reports, flat ROM == ELF ROM segment, 7 triples byte-identical through build/bin/ltarget (sizes: aarch64-linux-gnu " + str(120 + na) + " B, aarch64-elf " + str(176 + nb) + " B, riscv32-none-elf " + str(4096 + n3) + " B, riscv32-none-bin " + str(n3) + " B, riscv64-none-elf " + str(4096 + n6) + " B); lumec front end before lowering: a kernel whose contract lumec refutes [V0001] is refused with [T0902] on 3 triples although lkir.src alone compiles it"

## --- 3. execution equivalence -----------------------------------------------------------------------------------------
fn mg_case(nm, src, calls) = {nm: nm, src: src, calls: calls}
fn mg_corpus() = Cons(mg_case("arith", "fn arith(a: int, b: int, c: int) -> int = a * b + c - (a - c) * 2\n", Cons("arith(3, 4, 5)", Cons("arith(0 - 7, 9, 100)", Cons("arith(0, 0, 0)", Cons("arith(46340, 46340, 0 - 1)", Nil))))), Cons(mg_case("nested", "fn sgn3(x: int, y: int) -> int = if x < y then (if x < 0 then 0 - 1 else 1) else if x == y then 0 else (if y >= 10 then 2 else 3)\n", Cons("sgn3(0 - 4, 2)", Cons("sgn3(1, 2)", Cons("sgn3(5, 5)", Cons("sgn3(50, 10)", Cons("sgn3(7, 0 - 3)", Nil)))))), Cons(mg_case("fib", "fn fib(n: int) -> int = if n < 2 then n else fib(n - 1) + fib(n - 2)\n", Cons("fib(0)", Cons("fib(1)", Cons("fib(15)", Nil)))), Cons(mg_case("gcd", "fn gcd(a: int, b: int) -> int = if b == 0 then a else gcd(b, a % b)\n", Cons("gcd(48, 18)", Cons("gcd(17, 5)", Cons("gcd(0, 9)", Cons("gcd(1071, 462)", Nil))))), Cons(mg_case("ackermann", "fn ack(m: int, n: int) -> int = if m <= 0 then n + 1 else if n <= 0 then ack(m - 1, 1) else ack(m - 1, ack(m, n - 1))\n", Cons("ack(2, 3)", Cons("ack(1, 5)", Cons("ack(0, 0)", Nil)))), Cons(mg_case("divmod", "fn dm(a: int, b: int) -> int = a / b * 1000 + a % b\n", Cons("dm(0 - 7, 2)", Cons("dm(7, 0 - 2)", Cons("dm(0 - 7, 0 - 2)", Cons("dm(100, 7)", Cons("dm(0 - 2000000, 3)", Nil)))))), Cons(mg_case("compare", "fn cmps(a: int, b: int) -> int = (if a < b then 1 else 0) + (if a <= b then 2 else 0) + (if a > b then 4 else 0) + (if a >= b then 8 else 0) + (if a == b then 16 else 0) + (if a != b then 32 else 0)\n", Cons("cmps(0 - 5, 3)", Cons("cmps(3, 0 - 5)", Cons("cmps(4, 4)", Cons("cmps(0 - 2147483647, 2147483647)", Nil))))), mg_corpus2())))))))
fn mg_corpus2() = Cons(mg_case("poly", "fn poly(x: int) -> int = let a = x * x in let b = a * x in b - 3 * a + 2 * x - 7\n", Cons("poly(0)", Cons("poly(5)", Cons("poly(0 - 11)", Cons("poly(1000)", Nil))))), Cons(mg_case("logic", "fn inr(x: int, lo: int, hi: int) -> int = if x >= lo and x <= hi or x == 0 - 1 then 1 else 0\n", Cons("inr(5, 1, 9)", Cons("inr(0, 1, 9)", Cons("inr(0 - 1, 1, 9)", Cons("inr(9, 1, 9)", Cons("inr(10, 1, 9)", Nil)))))), Cons(mg_case("contract", "fn clamp(x: int, lo: int, hi: int) -> int requires lo <= hi ensures result >= lo and result <= hi = if x < lo then lo else if x > hi then hi else x\n", Cons("clamp(5, 0, 3)", Cons("clamp(0 - 4, 0, 3)", Cons("clamp(2, 0, 3)", Nil)))), Cons(mg_case("mutual", "fn ev(n: int) -> int = if n == 0 then 1 else od(n - 1)\nfn od(n: int) -> int = if n == 0 then 0 else ev(n - 1)\n", Cons("ev(10)", Cons("ev(7)", Cons("od(7)", Nil)))), Cons(mg_case("power", "fn pw(b: int, e: int) -> int = if e == 0 then 1 else b * pw(b, e - 1)\n", Cons("pw(2, 30)", Cons("pw(0 - 3, 9)", Cons("pw(7, 0)", Nil)))), Cons(mg_case("collatz", "fn col(n: int, s: int) -> int = if n == 1 then s else if n % 2 == 0 then col(n / 2, s + 1) else col(3 * n + 1, s + 1)\n", Cons("col(27, 0)", Cons("col(1, 0)", Nil))), Cons(mg_case("constants", "fn big(x: int) -> int = x + 2147480000 - 2147480000 + 123456789\n", Cons("big(0)", Cons("big(3000)", Cons("big(0 - 77)", Nil)))), Nil)))))))
## calls that must trap on every executor (st: 1 contract, 2 overflow, 3 division by zero, at 64 bits), and one that
## overflows only the 32-bit domain: there RV32 must trap while the 64-bit executors return the value
fn mg_traps() = Cons(mg_case("div0", "fn dz(a: int, b: int) -> int = a / b\n", Cons("dz(5, 0)", Nil)), Cons(mg_case("mod0", "fn mz(a: int, b: int) -> int = a % b\n", Cons("mz(5, 3 - 3)", Nil)), Cons(mg_case("mul-overflow", "fn sq(x: int) -> int = x * x\n", Cons("sq(4294967296)", Nil)), Cons(mg_case("add-overflow", "fn inc(x: int) -> int = x + 9223372036854775807\n", Cons("inc(1)", Nil)), Cons(mg_case("sub-overflow", "fn dec(x: int) -> int = 0 - 9223372036854775807 - x\n", Cons("dec(2)", Nil)), Cons(mg_case("min-div-minus-one", "fn d(a: int, b: int) -> int = a / b\n", Cons("d(0 - 9223372036854775807 - 1, 0 - 1)", Nil)), Cons(mg_case("contract", "fn clamp(x: int, lo: int, hi: int) -> int requires lo <= hi ensures result >= lo and result <= hi = if x < lo then lo else if x > hi then hi else x\n", Cons("clamp(1, 5, 2)", Nil)), Cons(mg_case("i32-only-overflow", "fn m(a: int, b: int) -> int = a * b\n", Cons("m(65536, 65536)", Nil)), Nil))))))))
fn mg_prints(calls) = match calls
    Nil        => ""
    Cons(h, t) => "print " + h + "\n" + mg_prints(t)
fn mg_first_print(p) = match p.prints
    Nil        => KNum(0)
    Cons(h, t) => h
fn mg_ref(src, call, bits) = let p = kir_parse(src + "print " + call + "\n") in if p.err != "" then mg_fail("corpus kernel does not parse: " + p.err) else kir_ev(p.fns, mg_first_print(p), Nil, 20000, bits)
fn mg_expect(src, calls) = match calls
    Nil        => ""
    Cons(h, t) => let r = mg_ref(src, h, 64) in if r.st != 0 then mg_fail("corpus call " + h + " traps in the reference semantics") else str(r.v) + "\n" + mg_expect(src, t)
fn mg_qemu(emu, image, out) = mg_run("/bin/sh", Cons("-c", Cons("ulimit -s 8192; exec " + emu + " " + image, Nil)), out)
## native x86-64: the real lumec + lasm, the kernel as an ordinary Lume program. A contract lumec refutes at compile
## time ([V0001], a constant call that violates `requires`) counts as the native side refusing the call (status 3).
fn mg_x86(cfg, tag, src) = let sp = cfg.tmp + "/" + tag + ".src" in let w = fs_write_sync(sp, src) in let c = os_run_input_capture_timeout(cfg.lumec, Nil, sp, cfg.tmp + "/" + tag + ".s", cfg.tmp + "/" + tag + ".cerr", 120000) in if mg_wait(c) != 0 and mg_has(fs_read_file(cfg.tmp + "/" + tag + ".cerr"), "[V0001]") == 1 then {rc: 3, out: "", err: "refuted at compile time"} else if mg_wait(c) != 0 then mg_fail("lumec rejected corpus kernel " + tag + ": " + fs_read_file(cfg.tmp + "/" + tag + ".cerr")) else let a = mg_run(cfg.lasm, Cons("--strict", Cons(cfg.tmp + "/" + tag + ".s", Nil)), cfg.tmp + "/" + tag + ".x86") in if a.rc != 0 then mg_fail("lasm rejected the x86-64 code of " + tag + ": " + a.err) else let m = os_run("/bin/chmod", Cons("+x", Cons(cfg.tmp + "/" + tag + ".x86", Nil))) in mg_run(cfg.tmp + "/" + tag + ".x86", Nil, cfg.tmp + "/" + tag + ".x86.out")
fn mg_a64(cfg, tag, src) = let r = la64_compile(src, "linux") in if r.err != "" then mg_fail("AArch64 back end rejected " + tag + ": " + r.err) else let w = mg_write_bin(cfg.tmp + "/" + tag + ".a64", r.bytes) in mg_qemu("/usr/bin/qemu-aarch64", cfg.tmp + "/" + tag + ".a64", cfg.tmp + "/" + tag + ".a64.out")
fn mg_rv64(cfg, tag, src, mode) = let r = lrv_compile(src, 64, mode) in if r.err != "" then mg_fail("RV64 back end rejected " + tag + ": " + r.err) else let w = mg_write_bin(cfg.tmp + "/" + tag + ".rv64" + mode, r.elf) in mg_qemu("/usr/bin/qemu-riscv64", cfg.tmp + "/" + tag + ".rv64" + mode, cfg.tmp + "/" + tag + ".rv64.out")
## RV32IM bare-metal on the LumePuter: {st: 0 value / 1..3 trap / 8 refused at compile time / 9 other, v}
fn mg_cause_st(cause) = if cause == "ebreak_contract_violation" then 1 else if cause == "ebreak_integer_overflow" then 2 else if cause == "ebreak_division_by_zero" then 3 else 9
fn mg_lumeputer(src, call) = let r = lrv_compile(src + "print " + call + "\n", 32, "bare") in if r.err != "" then {st: if mg_has(r.err, "outside the 32-bit domain") == 1 then 8 else 9, v: 0, cyc: 0, why: r.err} else let b = se_b_exec(r.words, 4000000, rv_no_inj()) in if b.ok == 1 then {st: 0, v: b.v, cyc: b.cycles, why: ""} else {st: mg_cause_st(b.cause), v: 0, cyc: b.cycles, why: b.cause}
fn mg_mod256(v) = (v % 256 + 256) % 256
## one value call on the monitor machine and on the bare RV64 image (exit status = low 8 bits of a0)
fn mg_bare_calls(cfg, c, calls, i, cyc) = match calls
    Nil        => cyc
    Cons(h, t) => let rf = mg_ref(c.src, h, 32) in let lp = mg_lumeputer(c.src, h) in let rb = mg_rv64(cfg, c.nm + "_b" + str(i), c.src + "print " + h + "\n", "bare") in let r64 = mg_ref(c.src, h, 64) in if rf.st != 0 or lp.st != 0 or lp.v != rf.v then mg_fail("RV32IM on the LumePuter: " + h + " gives " + (if lp.st == 0 then str(lp.v) else "trap " + lp.why) + ", the reference semantics " + (if rf.st == 0 then str(rf.v) else "a trap")) else if rb.rc != mg_mod256(r64.v) then mg_fail("bare RV64 image: " + h + " exits with status " + str(rb.rc) + ", expected " + str(mg_mod256(r64.v))) else mg_bare_calls(cfg, c, t, i + 1, cyc + lp.cyc)
fn mg_exec_case(cfg, c) = let src = c.src + mg_prints(c.calls) in let want = mg_expect(c.src, c.calls) in let x = mg_x86(cfg, c.nm, src) in let a = mg_a64(cfg, c.nm, src) in let r = mg_rv64(cfg, c.nm, src, "linux") in if x.rc != 0 or x.out != want then mg_fail("x86-64 native run of '" + c.nm + "' printed [" + x.out + "] (status " + str(x.rc) + "), the reference semantics [" + want + "]") else if a.out != want then mg_fail("AArch64 run of '" + c.nm + "' printed [" + a.out + "] (status " + str(a.rc) + "), x86-64 printed [" + want + "]") else if r.out != want then mg_fail("RV64 run of '" + c.nm + "' printed [" + r.out + "] (status " + str(r.rc) + "), x86-64 printed [" + want + "]") else mg_bare_calls(cfg, c, c.calls, 0, 0)
fn mg_exec(cfg, cs, n, calls, cyc) = match cs
    Nil        => {n: n, calls: calls, cyc: cyc}
    Cons(h, t) => mg_exec(cfg, t, n + 1, calls + kir_len(h.calls), cyc + mg_exec_case(cfg, h))
fn mg_hd(xs) = match xs
    Nil        => ""
    Cons(h, t) => h
fn mg_trap_case(cfg, c) = let call = mg_hd(c.calls) in let src = c.src + "print " + call + "\n" in let r64 = mg_ref(c.src, call, 64) in let r32 = mg_ref(c.src, call, 32) in let lp = mg_lumeputer(c.src, call) in if r32.st == 0 or lp.st != r32.st and lp.st != 8 then mg_fail("trap '" + c.nm + "': RV32IM on the LumePuter ended with " + (if lp.st == 0 then "the value " + str(lp.v) else lp.why) + ", the 32-bit reference semantics with trap " + str(r32.st)) else let x = mg_x86(cfg, "t_" + c.nm, src) in let a = mg_a64(cfg, "t_" + c.nm, src) in let r = mg_rv64(cfg, "t_" + c.nm, src, "linux") in if r64.st == 0 then (if x.out != str(r64.v) + "\n" or a.out != x.out or r.out != x.out then mg_fail("'" + c.nm + "' is a value at 64 bits (" + str(r64.v) + ") but the executors printed x86-64 [" + x.out + "] AArch64 [" + a.out + "] RV64 [" + r.out + "]") else 1) else if x.rc == 0 or x.out != "" then mg_fail("trap '" + c.nm + "': the x86-64 native run did not trap (status " + str(x.rc) + ", output [" + x.out + "])") else if a.rc != 3 or a.out != "" then mg_fail("trap '" + c.nm + "': the AArch64 run did not trap (status " + str(a.rc) + ", output [" + a.out + "])") else if r.rc != 3 or r.out != "" then mg_fail("trap '" + c.nm + "': the RV64 run did not trap (status " + str(r.rc) + ", output [" + r.out + "])") else 1
fn mg_trap_cases(cfg, cs, n) = match cs
    Nil        => n
    Cons(h, t) => mg_trap_cases(cfg, t, n + mg_trap_case(cfg, h))

## --- 4. translation validation and mutants -----------------------------------------------------------------------------
fn mg_tv_one(c, isa, bits, p, im) = if im.err != "" then mg_fail("back end rejected '" + c.nm + "' for validation: " + im.err) else let r = tvm_validate(p, im.words, im.syms, isa, bits) in if r.ok == 0 then mg_fail("ltv_multiarch rejected the " + isa + (if isa == "rv" then str(bits) else "") + " code of '" + c.nm + "': " + r.why) else r
fn mg_tv_case(c) = let p = kir_parse(c.src + mg_prints(c.calls)) in let a = mg_tv_one(c, "a64", 64, p, la64_image(p, "linux", 0)) in let r6 = mg_tv_one(c, "rv", 64, p, lrv_image(p, 64, "bare")) in let i3 = lrv_image(p, 32, "bare") in let r3 = if mg_has(i3.err, "outside the 32-bit domain") == 1 then {ok: 1, n: 0, paths: 0, why: ""} else mg_tv_one(c, "rv", 32, p, i3) in {fns: a.n + r6.n + r3.n, paths: a.paths + r6.paths + r3.paths}
fn mg_tv(cs, fns, paths) = match cs
    Nil        => {fns: fns, paths: paths}
    Cons(h, t) => let r = mg_tv_case(h) in mg_tv(t, fns + r.fns, paths + r.paths)
fn mg_find_case(cs, nm) = match cs
    Nil        => mg_case("", "", Nil)
    Cons(h, t) => if h.nm == nm then h else mg_find_case(t, nm)
fn mg_madd(a, b) = {total: a.total + b.total, killed: a.killed + b.killed, dead: a.dead + b.dead}
fn mg_mut_fn(cnm, fnm) = let c = mg_find_case(mg_corpus(), cnm) in let p = kir_parse(c.src + mg_prints(c.calls)) in let a = la64_image(p, "linux", 0) in let r6 = lrv_image(p, 64, "bare") in let r3 = lrv_image(p, 32, "bare") in {a: tvm_mutants(p, a.words, a.syms, "a64", 64, fnm), r6: tvm_mutants(p, r6.words, r6.syms, "rv", 64, fnm), r3: tvm_mutants(p, r3.words, r3.syms, "rv", 32, fnm)}
fn mg_mut_show(tag, m) = if m.killed * 100 < m.total * 95 then mg_fail(tag + ": only " + str(m.killed) + " of " + str(m.total) + " single-bit mutants are rejected by ltv_multiarch") else tag + " " + str(m.killed) + "/" + str(m.total) + " killed (" + str(m.total - m.killed) + " survivors proven equivalent: " + str(m.dead) + " in never-executed words, " + str(m.total - m.killed - m.dead) + " equivalent re-encodings)"
fn mg_mutants() = let g = mg_mut_fn("gcd", "gcd") in let q = mg_mut_fn("poly", "poly") in let k = mg_mut_fn("contract", "clamp") in mg_mut_show("AArch64", mg_madd(mg_madd(g.a, q.a), k.a)) + "; " + mg_mut_show("RV64", mg_madd(mg_madd(g.r6, q.r6), k.r6)) + "; " + mg_mut_show("RV32", mg_madd(mg_madd(g.r3, q.r3), k.r3))

fn mg_main(input) = let root = mg_get_at(input, "root", 0) in if root == "" then mg_fail("requires @root") else let tmp = "/tmp/lume-multi-arch-" + str(os_getpid()) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil))) in let cfg = {tmp: tmp, lumec: root + "/build/bin/lumec", lasm: root + "/build/bin/lasm", ltarget: root + "/build/bin/ltarget"} in if fs_path_exists("/usr/bin/qemu-aarch64") == 0 or fs_path_exists("/usr/bin/qemu-riscv64") == 0 then mg_fail("qemu-aarch64 and qemu-riscv64 (user mode) are required") else let v = mg_vectors(cfg) in let c = mg_containers(cfg) in let e = mg_exec(cfg, mg_corpus(), 0, 0, 0) in let t = mg_trap_cases(cfg, mg_traps(), 0) in let tv = mg_tv(kir_app(mg_corpus(), mg_traps()), 0, 0) in let mu = mg_mutants() in let rm = os_run("/bin/rm", Cons("-rf", Cons(tmp, Nil))) in "OK: multi-arch gate: " + v + ". Containers: " + c + ". Execution: " + str(e.n) + " kernels, " + str(e.calls) + " calls with the same result on x86-64 native, AArch64 (qemu-aarch64), RV64 (qemu-riscv64, Linux and bare image) and RV32IM bare-metal on the LumePuter (" + str(e.cyc) + " monitor cycles), all equal to the reference semantics; " + str(t) + " trap / domain cases agree on every executor. Translation validation: " + str(tv.fns) + " function images validated (" + str(tv.paths) + " paths) over AArch64, RV64 and RV32. Mutants: " + mu

## --- official encodings: assembly text, the word clang 21.1.8 emits for it, the word our encoder builds --------------
fn mg_a64_vectors() = Cons({a: "stp x29, x30, [sp, #-16]!", w: 2847898621, g: la64_stp_pre(29, 30, 31, 0 - 16)}, Cons({a: "ldp x29, x30, [sp], #16", w: 2831252477, g: la64_ldp_post(29, 30, 31, 16)}, Cons({a: "ret", w: 3596551104, g: la64_ret()}, Cons({a: "svc #0", w: 3556769793, g: la64_svc(0)}, Cons({a: "nop", w: 3573751839, g: la64_nop()}, Cons({a: "movz x0, #42", w: 3531605312, g: la64_movz(0, 42, 0)}, Cons({a: "movz x9, #0x8000, lsl #48", w: 3538944009, g: la64_movz(9, 32768, 3)}, Cons({a: "movz x17, #65535, lsl #16", w: 3535798257, g: la64_movz(17, 65535, 1)}, Cons({a: "movk x1, #0xffff, lsl #48", w: 4076863457, g: la64_movk(1, 65535, 3)}, Cons({a: "movk x0, #0x1234, lsl #32", w: 4072818304, g: la64_movk(0, 4660, 2)}, Cons({a: "movk x2, #1", w: 4068474914, g: la64_movk(2, 1, 0)}, Cons({a: "add x0, x1, x2", w: 2332164128, g: la64_add(0, 1, 2)}, Cons({a: "add x29, sp, #0", w: 2432697341, g: la64_add_imm(29, 31, 0)}, Cons({a: "add sp, sp, #16", w: 2432713727, g: la64_add_imm(31, 31, 16)}, Cons({a: "add sp, sp, #4080", w: 2436875263, g: la64_add_imm(31, 31, 4080)}, Cons({a: "add x0, x2, #0", w: 2432696384, g: la64_add_imm(0, 2, 0)}, Cons({a: "sub sp, sp, #48", w: 3506488319, g: la64_sub_imm(31, 31, 48)}, Cons({a: "sub x3, x4, x5", w: 3406102659, g: la64_sub(3, 4, 5)}, Cons({a: "sub x0, x1, x2", w: 3405905952, g: la64_sub(0, 1, 2)}, Cons({a: "adds x0, x1, x0", w: 2868903968, g: la64_adds(0, 1, 0)}, Cons({a: "subs x0, x1, x0", w: 3942645792, g: la64_subs(0, 1, 0)}, Cons({a: "cmp x1, x0", w: 3942645823, g: la64_cmp(1, 0)}, Cons({a: "cmp x0, #0", w: 4043309087, g: la64_cmp_imm(0, 0)}, Cons({a: "cmp x11, #0", w: 4043309439, g: la64_cmp_imm(11, 0)}, Cons({a: "cmp x3, x2, asr #63", w: 3951230079, g: la64_cmp_asr(3, 2, 63)}, Cons({a: "mul x0, x1, x2", w: 2600631328, g: la64_mul(0, 1, 2)}, Cons({a: "mul x2, x4, x0", w: 2600500354, g: la64_mul(2, 4, 0)}, Cons({a: "msub x14, x13, x12, x11", w: 2601299374, g: la64_msub(14, 13, 12, 11)}, Cons({a: "smulh x3, x1, x0", w: 2604694563, g: la64_smulh(3, 1, 0)}, Cons({a: "sdiv x0, x1, x2", w: 2596408352, g: la64_sdiv(0, 1, 2)}, Cons({a: "sdiv x4, x1, x0", w: 2596277284, g: la64_sdiv(4, 1, 0)}, Cons({a: "cset x0, eq", w: 2594117600, g: la64_cset(0, 0)}, Cons({a: "cset x0, ne", w: 2594113504, g: la64_cset(0, 1)}, Cons({a: "cset x0, lt", w: 2594154464, g: la64_cset(0, 11)}, Cons({a: "cset x0, ge", w: 2594158560, g: la64_cset(0, 10)}, Cons({a: "cset x0, gt", w: 2594166752, g: la64_cset(0, 12)}, Cons({a: "cset x0, le", w: 2594162656, g: la64_cset(0, 13)}, Cons({a: "str x0, [sp, #-16]!", w: 4162785248, g: la64_str_pre(0, 31, 0 - 16)}, Cons({a: "ldr x1, [sp], #16", w: 4165011425, g: la64_ldr_post(1, 31, 16)}, Cons({a: "ldr x0, [sp, #32]", w: 4181726176, g: la64_ldr(0, 31, 32)}, Cons({a: "ldr x0, [sp, #32760]", w: 4185915360, g: la64_ldr(0, 31, 32760)}, Cons({a: "str x5, [sp, #8]", w: 4177528805, g: la64_str(5, 31, 8)}, Cons({a: "strb w12, [x10, #-1]!", w: 941620556, g: la64_strb_pre(12, 10, 0 - 1)}, Cons({a: "b .+16", w: 335544324, g: la64_b(4)}, Cons({a: "bl .-4", w: 2550136831, g: la64_bl(0 - 1)}, Cons({a: "b.eq .+8", w: 1409286208, g: la64_bcond(0, 2)}, Cons({a: "b.ne .+8", w: 1409286209, g: la64_bcond(1, 2)}, Cons({a: "b.vs .-8", w: 1426063302, g: la64_bcond(6, 0 - 2)}, Cons({a: "b.lt .+12", w: 1409286251, g: la64_bcond(11, 3)}, Cons({a: "b.ge .+12", w: 1409286250, g: la64_bcond(10, 3)}, Cons({a: "b.gt .-12", w: 1426063276, g: la64_bcond(12, 0 - 3)}, Cons({a: "b.le .+1048572", w: 1417674733, g: la64_bcond(13, 262143)}, Nil))))))))))))))))))))))))))))))))))))))))))))))))))))
fn mg_rv_vectors() = Cons({a: "addi a0, zero, 42", w: 44041491, g: lrv_addi(10, 0, 42)}, Cons({a: "addi sp, sp, -16", w: 4278255891, g: lrv_addi(2, 2, 0 - 16)}, Cons({a: "addi sp, sp, 2047", w: 2146500883, g: lrv_addi(2, 2, 2047)}, Cons({a: "addi a7, zero, 93", w: 97519763, g: lrv_addi(17, 0, 93)}, Cons({a: "addiw a0, a0, -1", w: 4294247707, g: lrv_addiw(10, 10, 0 - 1)}, Cons({a: "lui t0, 0x12345", w: 305418935, g: lrv_lui(5, 74565)}, Cons({a: "lui sp, 0x84", w: 540983, g: lrv_lui(2, 132)}, Cons({a: "auipc a0, 1", w: 5399, g: lrv_auipc(10, 1)}, Cons({a: "slti t2, a0, 0", w: 336787, g: lrv_slti(7, 10, 0)}, Cons({a: "sltiu a0, t1, 1", w: 1258771, g: lrv_sltiu(10, 6, 1)}, Cons({a: "xori a0, a0, 1", w: 1393939, g: lrv_xori(10, 10, 1)}, Cons({a: "ori a0, a0, 7", w: 7693587, g: lrv_ori(10, 10, 7)}, Cons({a: "andi a0, a0, 255", w: 267744531, g: lrv_andi(10, 10, 255)}, Cons({a: "slli a0, a0, 12", w: 12915987, g: lrv_slli(10, 10, 12)}, Cons({a: "slli t1, t1, 63", w: 66261779, g: lrv_slli(6, 6, 63)}, Cons({a: "srli a0, a0, 3", w: 3495187, g: lrv_srli(10, 10, 3)}, Cons({a: "srai t4, t1, 31", w: 1106468499, g: lrv_srai(29, 6, 31)}, Cons({a: "srai t4, t1, 63", w: 1140022931, g: lrv_srai(29, 6, 63)}, Cons({a: "add a0, a1, a2", w: 12944691, g: lrv_add(10, 11, 12)}, Cons({a: "add t1, t0, a0", w: 10650419, g: lrv_add(6, 5, 10)}, Cons({a: "sub t0, t1, t2", w: 1081279155, g: lrv_sub(5, 6, 7)}, Cons({a: "sub a0, t0, t1", w: 1080198451, g: lrv_sub(10, 5, 6)}, Cons({a: "slt a0, a1, a2", w: 12952883, g: lrv_slt(10, 11, 12)}, Cons({a: "slt t4, t1, t0", w: 5451443, g: lrv_slt(29, 6, 5)}, Cons({a: "sltu a0, zero, a0", w: 10499379, g: lrv_sltu(10, 0, 10)}, Cons({a: "xor t1, t0, a0", w: 10666803, g: lrv_xor(6, 5, 10)}, Cons({a: "or a0, a0, a1", w: 11887923, g: lrv_or(10, 10, 11)}, Cons({a: "and a0, a0, a1", w: 11892019, g: lrv_and(10, 10, 11)}, Cons({a: "mul a0, a0, a1", w: 45417779, g: lrv_mul(10, 10, 11)}, Cons({a: "mul t1, t3, a0", w: 44958515, g: lrv_mul(6, 28, 10)}, Cons({a: "mulh t2, t0, a0", w: 44209075, g: lrv_mulh(7, 5, 10)}, Cons({a: "div a0, a0, a1", w: 45434163, g: lrv_div(10, 10, 11)}, Cons({a: "div t3, t0, a0", w: 44224051, g: lrv_div(28, 5, 10)}, Cons({a: "rem a0, a0, a1", w: 45442355, g: lrv_rem(10, 10, 11)}, Cons({a: "beq a0, a1, .+8", w: 11863139, g: lrv_beq(10, 11, 8)}, Cons({a: "beq t2, t4, .+8", w: 30639203, g: lrv_beq(7, 29, 8)}, Cons({a: "bne a0, zero, .-4", w: 4261748451, g: lrv_bne(10, 0, 0 - 4)}, Cons({a: "bne a0, zero, .+8", w: 332899, g: lrv_bne(10, 0, 8)}, Cons({a: "blt a0, a1, .+16", w: 11880547, g: lrv_blt(10, 11, 16)}, Cons({a: "bge zero, t0, .+8", w: 5264483, g: lrv_bge(0, 5, 8)}, Cons({a: "bge t3, zero, .-4096", w: 2148421731, g: lrv_bge(28, 0, 0 - 4096)}, Cons({a: "jal ra, .+2048", w: 1048815, g: lrv_jal(1, 2048)}, Cons({a: "jal zero, .-8", w: 4288671855, g: lrv_jal(0, 0 - 8)}, Cons({a: "jal zero, .+1048574", w: 2147479663, g: lrv_jal(0, 1048574)}, Cons({a: "jalr zero, 0(ra)", w: 32871, g: lrv_jalr(0, 1, 0)}, Cons({a: "lw a0, 8(sp)", w: 8463619, g: lrv_lw(10, 2, 8)}, Cons({a: "sw a0, 8(sp)", w: 10560547, g: lrv_sw(10, 2, 8)}, Cons({a: "ld a0, 8(sp)", w: 8467715, g: lrv_ld(10, 2, 8)}, Cons({a: "sd a0, 8(sp)", w: 10564643, g: lrv_sd(10, 2, 8)}, Cons({a: "sd ra, 0(sp)", w: 1126435, g: lrv_sd(1, 2, 0)}, Cons({a: "ld t0, 2040(sp)", w: 2139173507, g: lrv_ld(5, 2, 2040)}, Cons({a: "sb t1, 0(a1)", w: 6651939, g: lrv_sb(6, 11, 0)}, Cons({a: "sw ra, -4(sp)", w: 4262538787, g: lrv_sw(1, 2, 0 - 4)}, Cons({a: "ecall", w: 115, g: lrv_ecall()}, Cons({a: "ebreak", w: 1048691, g: lrv_ebreak()}, Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))

print mg_main(readall())
