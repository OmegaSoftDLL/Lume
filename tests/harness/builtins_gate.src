## builtins_gate.src -- the builtins of the compiler sources agree with compiler/stage1/builtins_table.src.
##
## Input: `@root <repository root>` on the first line, then optionally `@mode check` (the default), `@mode gen` or
## `@mode table`.
##   check  lists every disagreement between the table and name_flow.src, 06b_phase3.src, lcaas.src, the runtime text
##          (runtime_core.lume, rt/*.src + runtime_lume.lume, 05_codegen.src), the reference docs and
##          builtins_regress_ok.src, and fails when there is one.
##   gen    rewrites the list functions of name_flow.src, 06b_phase3.src (kprim_eff0, kprim_eff_rt) and lcaas.src
##          (cs_kprim_eff) from the table, then checks.
##   table  prints a table rebuilt from the current sources (the first audit; review it by hand before using it).
use builtins_sync

fn bg_field(input, key) = bg_field_at(bs_lines(input), key)
fn bg_field_at(lines, key) = match lines
    Nil        => ""
    Cons(h, t) => if bs_starts(h, key) == 1 then slice(h, count(key), count(h)) else bg_field_at(t, key)
fn bg_report(msgs) = "builtins gate failed: " + str(bs_len(msgs, 0)) + " disagreement(s) between builtins_table.src and the sources\n" + bs_join(msgs, "\n") + "\n"
fn bg_check(root) = let msgs = bs_check(root) in if bs_isnil(msgs) == 1 then "OK: " + str(bs_len(bs_table(root), 0)) + " builtins agree across builtins_table.src, name_flow, 06b_phase3, lcaas, the runtime text, the reference and builtins_regress_ok" else ctfail(bg_report(msgs))
fn bg_main(input) = let root = bg_field(input, "@root ") in let mode = bg_field(input, "@mode ") in if root == "" then ctfail("builtins gate requires @root\n") else if mode == "table" then bs_table_text(root) else if mode == "gen" then bs_gen(root) + "\n" + bg_check(root) else bg_check(root)

print bg_main(readall())
