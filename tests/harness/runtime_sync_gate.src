## runtime_sync_gate.src -- the code generators and front-ends must not drift apart in silence.
##
## 1. The hosted runtime has one source: `compiler/stage1/runtime_core.lume`. Neither code generator may define
##    a copy, and the assembly both of them emit must contain the very same `alloc:` .. `_start` runtime text.
## 2. Every program in tests/conformance/stage1/surfaces (the language all three share: the seed checker has no
##    `type` declarations) must behave identically through each surface:
##    `lumec`, the ML-core oracle on the C seed (`lume0 run data_asm_cc.lume`), and the `lcaas` oracle.
fn rs_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slicen(text, count(text), i, i + count(part)) == part then 1 else rs_contains_at(text, part, i + 1)
fn rs_contains(text, part) = rs_contains_at(text, part, 0)
fn rs_find(text, part, i) = if i + count(part) > count(text) then 0 - 1 else if slicen(text, count(text), i, i + count(part)) == part then i else rs_find(text, part, i + 1)
fn rs_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else rs_line_end(s, i + 1)
fn rs_lines(s, i) = if i >= count(s) then Nil else let e = rs_line_end(s, i) in Cons(slice(s, i, e), rs_lines(s, e + 1))
fn rs_run(path, args, out) = os_run_capture_timeout(path, args, out, out + ".err", 300000)
fn rs_input(path, input, out) = os_run_input_capture_timeout(path, Nil, input, out, out + ".err", 300000)
fn rs_dir(root) = root + "/tests/conformance/stage1/surfaces"
fn rs_seed(root) = root + "/bootstrap/lume0/lume0"

## no second copy of the runtime
fn rs_no_copy(text, nm, marker) = if rs_contains(text, marker) == 1 then nm + " must not define the runtime: " + marker + " belongs in runtime_core.lume" else ""
fn rs_join(a, b) = if a != "" then a else b
fn rs_single_source(root) = let cg = fs_read_file(root + "/compiler/stage1/lume/05_codegen.src") in let ag = fs_read_file(root + "/compiler/stage1/data_asmgen.lume") in rs_join(rs_no_copy(cg, "05_codegen.src", "fn runtime_tail("), rs_join(rs_no_copy(cg, "05_codegen.src", "fn runtime_mem_tail("), rs_join(rs_no_copy(ag, "data_asmgen.lume", "fn runtime_tail("), rs_join(rs_no_copy(ag, "data_asmgen.lume", "fn runtime_mem_tail("), if rs_contains(ag, "use runtime_core") == 1 then "" else "data_asmgen.lume does not use runtime_core"))))

## the part of an assembly file from the runtime entry up to, not including, `marker`
fn rs_cut(text, start, marker) = let a = rs_find(text, start, 0) in if a < 0 then "" else let b = rs_find(text, marker, a) in if b < 0 then "" else slice(text, a, b)
fn rs_same_runtime(root, tmp) = let probe = tmp + "/probe.src" in let w = fs_write_sync(probe, "print 1\n") in let a = tmp + "/probe_lumec.s" in let b = tmp + "/probe_seed.s" in let st1 = rs_input(root + "/build/bin/lumec", probe, a) in let st2 = rs_run(rs_seed(root), Cons("run", Cons(root + "/compiler/stage1/data_asm_cc.lume", Cons(probe, Cons(b, Nil)))), b + ".log") in if st1 != 0 or st2 != 0 then "cannot compile the runtime probe" else let ra = rs_cut(fs_read_file(a), "alloc:\n", "lec_bad:\n") in let rb = rs_cut(fs_read_file(b), "alloc:\n", "lec_bad:\n") in if count(ra) < 10000 then "runtime text not found in lumec output" else if ra != rb then "lumec and the ML-core oracle emit different runtimes" else ""

fn rs_native(root, name, tmp) = let src = rs_dir(root) + "/" + name + ".src" in let s = tmp + "/" + name + ".s" in let st = rs_input(root + "/build/bin/lumec", src, s) in if st != 0 then "lumec rejected " + name + ": " + fs_read_file(s + ".err") else rs_exec(root, s, tmp + "/" + name + ".native")
fn rs_exec(root, s, elf) = let a = rs_run(root + "/build/bin/lasm", Cons("--strict", Cons(s, Nil)), elf) in let m = rs_run("/bin/chmod", Cons("+x", Cons(elf, Nil)), elf + ".chmod") in if a != 0 then "assembly failed for " + s else let r = rs_run(elf, Nil, elf + ".out") in if r != 0 then "execution failed for " + elf else ""
fn rs_stage0(root, name, tmp) = let src = rs_dir(root) + "/" + name + ".src" in let s = tmp + "/" + name + ".seed.s" in let st = rs_run(rs_seed(root), Cons("run", Cons(root + "/compiler/stage1/data_asm_cc.lume", Cons(src, Cons(s, Nil)))), s + ".log") in if st != 0 then "the seed rejected " + name + ": " + fs_read_file(s + ".log.err") else rs_exec(root, s, tmp + "/" + name + ".seed")
fn rs_oracle(root, name, tmp) = let src = rs_dir(root) + "/" + name + ".src" in let out = tmp + "/" + name + ".caas" in let w = fs_write_sync(out + ".in", "@mode check\n" + fs_read_file(src)) in let st = rs_input(root + "/build/bin/lcaas", out + ".in", out) in if rs_contains(fs_read_file(out), "\"diagnostics\":[]") == 0 then "lcaas rejected " + name + ": " + slice(fs_read_file(out), 0, 200) else ""
fn rs_program(root, name, tmp) = let want = fs_read_file(rs_dir(root) + "/" + name + ".expected") in let e1 = rs_native(root, name, tmp) in if e1 != "" then e1 else let e2 = rs_stage0(root, name, tmp) in if e2 != "" then e2 else let e3 = rs_oracle(root, name, tmp) in if e3 != "" then e3 else if fs_read_file(tmp + "/" + name + ".native.out") != want then name + ": lumec output differs from the expected output" else if fs_read_file(tmp + "/" + name + ".seed.out") != want then name + ": the seed output differs from the expected output" else ""
fn rs_programs(root, names, tmp, n) = match names
    Nil        => {err: "", n: n}
    Cons(h, t) => if h == "" then rs_programs(root, t, tmp, n) else let e = rs_program(root, h, tmp) in if e != "" then {err: e, n: n} else rs_programs(root, t, tmp, n + 1)
fn rs_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, rs_line_end(input, 0))
fn rs_main(root) = let tmp = root + "/build/runtime-sync-gate" in let c = rs_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil)), root + "/build/runtime-sync-gate.mkdir") in let e0 = rs_single_source(root) in if e0 != "" then ctfail("runtime sync gate failed: " + e0 + "\n") else let e1 = rs_same_runtime(root, tmp) in if e1 != "" then ctfail("runtime sync gate failed: " + e1 + "\n") else let r = rs_programs(root, rs_lines(fs_read_file(rs_dir(root) + "/MANIFEST"), 0), tmp, 0) in if r.err != "" then ctfail("runtime sync gate failed: " + r.err + "\n") else "OK: one runtime source, identical emitted runtime, " + str(r.n) + " programs agree across lumec, the seed and lcaas"
fn rs_dispatch(input) = let root = rs_root(input) in if root == "" then ctfail("runtime sync gate requires @root\n") else rs_main(root)

print rs_dispatch(readall())
