## tv_rt_gate.src -- mutation gate for the runtime-helper verifier (compiler/stage1/ltv_rt.src).
##
## A verifier that accepts everything passes every positive test, so this gate measures it against the machine:
##   1. a fixture that drives every integer helper through ordinary Lume expressions on a boundary matrix (0, +-1,
##      the 2^62 and 2^63 neighbours, immediate and boxed operands, distinct cells and the same cell, divisor 0,
##      INT64_MIN / -1) is compiled by the real lumec and assembled by lasm; ltv_rt must VERIFY every helper of the
##      emitted text, and the gate prints the symbolic paths and discharged obligations per helper;
##   2. the specification is tested against the machine and the language: an evaluator of the specification written
##      here from first principles (case-split addition, checked / wrapping double-and-add multiplication, long
##      division on non-positive magnitudes; no `*`, `/`, `%` or wrapping operator is used to compute an expected
##      value) must predict the complete output of the native fixture, trap messages included;
##   3. every instruction line of every helper region is mutated by every operator that applies (flip / swap a
##      condition, add <-> sub, swap operands or registers, change an immediate or a displacement, drop the
##      instruction, replace `call mkint` by a plain move, redirect a trap, swap div / mod). Each mutant is assembled
##      and run on the same matrix: a mutant whose output or exit status differs from the original is PROVEN
##      behaviour-changing and the verifier must reject it. One such mutant accepted is an UNSOUND ACCEPTANCE: the
##      gate fails and prints it. A rejected mutant that behaves like the original on the matrix is counted as
##      "rejected, same on matrix" (the verifier is conservative, or the matrix cannot reach the path from Lume
##      source); an accepted one with the same behaviour is listed for audit;
##   4. hand-written wrong variants of the helpers (the classic defects: `lea` followed by `jo`, a missing
##      INT64_MIN / -1 guard, a box for a value that fits 63 bits, a dropped overflow test, a clobbered callee-saved
##      register, a value kept in %r10 across the allocator, ...) must each be rejected.
## The fixture contains no string concatenation, comparison or equality, so its observable behaviour depends on the
## helpers only through their integer paths (a trap is reported by one character of its message).
##
## stdin: @root <repo>   [@stride <n>: test every n-th mutant, default 1]   [@tmp <dir>, default /tmp/lume-tv-rt-gate.<pid>]

use ltv_rt

fn rg_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else rg_line_end(s, i + 1)
fn rg_get_at(s, key, i) = if i >= count(s) then "" else let e = rg_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else rg_get_at(s, key, e + 1)
fn rg_get(s, key) = rg_get_at(s, key, 0)
fn rg_or(v, d) = if v == "" then d else v
fn rg_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn rg_index_c(text, part, c, n, m, i) = if i + m > n then 0 - 1 else if at(text, i) == c and slicen(text, n, i, i + m) == part then i else rg_index_c(text, part, c, n, m, i + 1)
fn rg_index(text, part, i) = if count(part) == 0 then i else rg_index_c(text, part, at(part, 0), count(text), count(part), i)
fn rg_has(text, part) = if rg_index(text, part, 0) >= 0 then 1 else 0
fn rg_starts(s, pre) = if count(s) >= count(pre) and slice(s, 0, count(pre)) == pre then 1 else 0
fn rg_rep1(s, pat, rep) = let i = rg_index(s, pat, 0) in if i < 0 then s else slice(s, 0, i) + rep + slice(s, i + count(pat), count(s))
fn rg_repall(s, pat, rep, i) = let j = rg_index(s, pat, i) in if j < 0 then s else rg_repall(slice(s, 0, j) + rep + slice(s, j + count(pat), count(s)), pat, rep, j + count(rep))
fn rg_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + rg_len(t)
fn rg_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, rg_app(t, ys))
fn rg_revacc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => rg_revacc(t, Cons(h, acc))
fn rg_join(xs) = match xs
    Nil        => ""
    Cons(h, t) => h + rg_join(t)
fn rg_run(bin, args, out, ms) = let st = os_run_capture_timeout(bin, args, out, out + ".err", ms) in {status: rg_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn rg_input(bin, args, inp, out, ms) = let st = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", ms) in {status: rg_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}

## --- the boundary matrix ---
fn rg_min() = 0 - 9223372036854775807 - 1
fn rg_max() = 9223372036854775807
fn rg_p62() = 4611686018427387904
fn rg_vals() = Cons(0, Cons(1, Cons(0 - 1, Cons(2, Cons(0 - 2, Cons(7, Cons(0 - 7, Cons(3037000500, Cons(0 - 3037000500, Cons(4294967296, Cons(rg_p62() - 1, Cons(rg_p62(), Cons(rg_p62() + 1, Cons(0 - rg_p62(), Cons(0 - rg_p62() - 1, Cons(0 - rg_p62() + 1, Cons(rg_max(), Cons(rg_max() - 1, Cons(rg_min(), Cons(rg_min() + 1, Nil))))))))))))))))))))
## quantifier ranges {a, b, t}: `forall_range(i, a, b, i != t)` calls cmpv and __rt_qnext on every step
fn rg_q(a, b, t) = {a: a, b: b, t: t}
fn rg_quants() = Cons(rg_q(rg_max() - 2, rg_max(), rg_max()), Cons(rg_q(rg_max() - 2, rg_max(), 3), Cons(rg_q(rg_max(), rg_max(), rg_max()), Cons(rg_q(rg_max() - 1, rg_max(), rg_max() - 1), Cons(rg_q(rg_p62() - 2, rg_p62() + 1, rg_p62()), Cons(rg_q(rg_p62() - 2, rg_p62() + 1, rg_p62() + 1), Cons(rg_q(rg_p62() - 2, rg_p62() + 1, 5), Cons(rg_q(0 - rg_p62() - 2, 0 - rg_p62() + 1, 0 - rg_p62() - 1), Cons(rg_q(0 - rg_p62() - 2, 0 - rg_p62() + 1, 0 - rg_p62()), Cons(rg_q(rg_min(), rg_min() + 2, rg_min() + 1), Cons(rg_q(rg_min(), rg_min() + 2, rg_min()), Cons(rg_q(rg_min(), rg_min() + 2, 9), Cons(rg_q(5, 3, 4), Cons(rg_q(0, 3, 3), Cons(rg_q(0 - 2, 2, 0), Cons(rg_q(0 - 2, 2, 3), Nil))))))))))))))))
fn rg_nbin() = 12
fn rg_nun() = 13

## --- the fixture: generated so that the literals of the program are the values of the matrix ---
fn rg_lit(v) = if v == rg_min() then "(0 - 9223372036854775807 - 1)" else if v < 0 then "(0 - " + str(0 - v) + ")" else str(v)
fn rg_src_vals(vs) = match vs
    Nil        => "Nil"
    Cons(v, t) => "Cons(" + rg_lit(v) + ", " + rg_src_vals(t) + ")"
fn rg_src_head() = "fn vals() = " + rg_src_vals(rg_vals()) + "\nfn cmps(a, b) = (if a < b then 1 else 0) + (if a <= b then 2 else 0) + (if a > b then 4 else 0) + (if a >= b then 8 else 0) + (if a != b then 16 else 0)\nfn op(k, a, b) = if k == 0 then a + b else if k == 1 then a - b else if k == 2 then a * b else if k == 3 then a / b else if k == 4 then a % b else if k == 5 then a +% b else if k == 6 then a -% b else if k == 7 then a *% b else if k == 8 then cmps(a, b) else if k == 9 then (if a == b then 1 else 0) else if k == 10 then bit_and(a, b) else if k == 11 then (if a then 1 else 0) + (if b then 2 else 0) else if k == 12 then a + 1 else if k == 13 then a - 1 else if k == 14 then 0 - a else if k == 15 then (if a < 3 then 1 else 0) + (if a == 7 then 2 else 0) + (if a >= 0 - 7 then 4 else 0) + (if a != 4611686018427387904 then 8 else 0) + (if a > 4611686018427387903 then 16 else 0) else if k == 16 then a * a else if k == 17 then a + a else if k == 18 then a - a else if k == 19 then (if a == a then 1 else 0) else if k == 20 then a / a else if k == 21 then cmps(a, a) else if k == 22 then a *% a else if k == 23 then a % a else bit_not(a)\nfn one(k, a, b) = if __lume_try_begin() == 0 then let r = op(k, a, b) in let z = __lume_try_end() in r else at(__lume_try_msg(), 6)\nfn row(k, a, bs) = match bs\n    Nil        => Nil\n    Cons(b, t) => Cons(one(k, a, b), row(k, a, t))\nfn urow(k, xs) = match xs\n    Nil        => Nil\n    Cons(a, t) => Cons(one(k, a, a), urow(k, t))\nfn q(a, b, t) = if forall_range(i, a, b, i != t) then 1 else 0\n"
fn rg_src_rows(k, vs) = match vs
    Nil        => Nil
    Cons(v, t) => Cons("print row(" + str(k) + ", " + rg_lit(v) + ", vals())\n", rg_src_rows(k, t))
fn rg_src_bin(k) = if k >= rg_nbin() then Nil else Cons(rg_join(rg_src_rows(k, rg_vals())), rg_src_bin(k + 1))
fn rg_src_un(k) = if k >= rg_nbin() + rg_nun() then Nil else Cons("print urow(" + str(k) + ", vals())\n", rg_src_un(k + 1))
fn rg_src_q(qs) = match qs
    Nil        => Nil
    Cons(h, t) => Cons("print q(" + rg_lit(h.a) + ", " + rg_lit(h.b) + ", " + rg_lit(h.t) + ")\n", rg_src_q(t))
fn rg_source() = rg_src_head() + rg_join(rg_src_bin(0)) + rg_join(rg_src_un(rg_nbin())) + rg_join(rg_src_q(rg_quants()))

## --- the specification, evaluated concretely. A result is {t: 0 value v | 1 the overflow trap | 2 the
##     division-by-zero trap}. Only comparisons and additions / subtractions that cannot overflow are used. ---
fn rg_v(v) = {t: 0, v: v}
fn rg_ovf() = {t: 1, v: 0}
fn rg_dz() = {t: 2, v: 0}
fn rg_add(a, b) = if a >= 0 and b >= 0 then (if a > rg_max() - b then rg_ovf() else rg_v(a + b)) else if a < 0 and b < 0 then (if a < rg_min() - b then rg_ovf() else rg_v(a + b)) else rg_v(a + b)
fn rg_sub(a, b) = if b == rg_min() then (if a >= 0 then rg_ovf() else rg_v(a - b)) else rg_add(a, 0 - b)
## a + b modulo 2^64: an overflowing sum of two non-negatives is (a - 2^63) + (b - 2^63), of two negatives (a + 2^63) + (b + 2^63)
fn rg_wadd(a, b) = if a >= 0 and b >= 0 and a > rg_max() - b then (a + rg_min()) + (b + rg_min()) else if a < 0 and b < 0 and a < rg_min() - b then (a - rg_min()) + (b - rg_min()) else a + b
fn rg_wsub(a, b) = if b == rg_min() then rg_wadd(a, rg_min()) else rg_wadd(a, 0 - b)
## long division on non-positive magnitudes (every i64 has one): n <= 0, d <= -2; quotient >= 0, remainder in (d, 0]
fn rg_dbl(n, t, m) = if t >= n - t then rg_dbl(n, t + t, m + m) else {t: t, m: m}
fn rg_ndiv(n, d) = if n > d then 0 else let r = rg_dbl(n, d, 1) in r.m + rg_ndiv(n - r.t, d)
fn rg_nrem(n, d) = if n > d then n else rg_nrem(n - rg_dbl(n, d, 1).t, d)
fn rg_nmag(x) = if x > 0 then 0 - x else x
## truncating division: the quotient rounds toward zero, the remainder has the sign of the dividend
fn rg_tdiv(a, b) = if b == 0 then rg_dz() else if b == 0 - 1 then (if a == rg_min() then rg_ovf() else rg_v(0 - a)) else if b == 1 then rg_v(a) else let q = rg_ndiv(rg_nmag(a), rg_nmag(b)) in rg_v(if (a < 0 and b > 0) or (a > 0 and b < 0) then 0 - q else q)
fn rg_tmod(a, b) = if b == 0 then rg_dz() else if b == 0 - 1 then (if a == rg_min() then rg_ovf() else rg_v(0)) else if b == 1 then rg_v(0) else let r = rg_nrem(rg_nmag(a), rg_nmag(b)) in rg_v(if a > 0 then 0 - r else r)
fn rg_half(b) = rg_ndiv(0 - b, 0 - 2)
fn rg_cadd(x, y) = if x.t != 0 then x else if y.t != 0 then y else rg_add(x.v, y.v)
## x * b for b >= 1 by double-and-add: every partial value has the sign of x and a magnitude not above the product's,
## so the first overflow is an overflow of the product
fn rg_cm(x, b) = if b == 1 then x else let h = rg_half(b) in let d = rg_cm(rg_cadd(x, x), h) in if h + h == b then d else rg_cadd(x, d)
fn rg_mul(a, b) = if a == 0 or b == 0 then rg_v(0) else if b > 0 then rg_cm(rg_v(a), b) else if b == rg_min() then (if a == 1 then rg_v(rg_min()) else rg_ovf()) else if a == rg_min() then rg_ovf() else rg_cm(rg_v(0 - a), 0 - b)
fn rg_wm(x, b) = if b == 1 then x else let h = rg_half(b) in let d = rg_wm(rg_wadd(x, x), h) in if h + h == b then d else rg_wadd(x, d)
fn rg_wneg(x) = if x == rg_min() then x else 0 - x
fn rg_odd(a) = if rg_nrem(rg_nmag(a), 0 - 2) != 0 then 1 else 0
fn rg_wmul(a, b) = if a == 0 or b == 0 then 0 else if b > 0 then rg_wm(a, b) else if b == rg_min() then (if rg_odd(a) == 1 then rg_min() else 0) else rg_wneg(rg_wm(a, 0 - b))
fn rg_cmps(a, b) = (if a < b then 1 else 0) + (if a <= b then 2 else 0) + (if a > b then 4 else 0) + (if a >= b then 8 else 0) + (if a != b then 16 else 0)
fn rg_spec(k, a, b) = if k == 0 then rg_add(a, b) else if k == 1 then rg_sub(a, b) else if k == 2 then rg_mul(a, b) else if k == 3 then rg_tdiv(a, b) else if k == 4 then rg_tmod(a, b) else if k == 5 then rg_v(rg_wadd(a, b)) else if k == 6 then rg_v(rg_wsub(a, b)) else if k == 7 then rg_v(rg_wmul(a, b)) else if k == 8 then rg_v(rg_cmps(a, b)) else if k == 9 then rg_v(if a == b then 1 else 0) else if k == 10 then rg_v(bit_and(a, b)) else if k == 11 then rg_v((if a != 0 then 1 else 0) + (if b != 0 then 2 else 0)) else if k == 12 then rg_add(a, 1) else if k == 13 then rg_sub(a, 1) else if k == 14 then rg_sub(0, a) else if k == 15 then rg_v((if a < 3 then 1 else 0) + (if a == 7 then 2 else 0) + (if a >= 0 - 7 then 4 else 0) + (if a != rg_p62() then 8 else 0) + (if a > rg_p62() - 1 then 16 else 0)) else if k == 16 then rg_mul(a, a) else if k == 17 then rg_add(a, a) else if k == 18 then rg_sub(a, a) else if k == 19 then rg_v(1) else if k == 20 then rg_tdiv(a, a) else if k == 21 then rg_v(rg_cmps(a, a)) else if k == 22 then rg_v(rg_wmul(a, a)) else if k == 23 then rg_tmod(a, a) else rg_v(0 - 1 - a)
## what the fixture prints for a result: the value, or the 7th character of the trap message
fn rg_show(r) = if r.t == 0 then str(r.v) else if r.t == 1 then "i" else "d"
fn rg_exp_row(k, a, bs) = match bs
    Nil        => "Nil"
    Cons(b, t) => "Cons(" + rg_show(rg_spec(k, a, b)) + ", " + rg_exp_row(k, a, t) + ")"
fn rg_exp_urow(k, xs) = match xs
    Nil        => "Nil"
    Cons(a, t) => "Cons(" + rg_show(rg_spec(k, a, a)) + ", " + rg_exp_urow(k, t) + ")"
fn rg_exp_rows(k, vs) = match vs
    Nil        => Nil
    Cons(v, t) => Cons(rg_exp_row(k, v, rg_vals()) + "\n", rg_exp_rows(k, t))
fn rg_exp_bin(k) = if k >= rg_nbin() then Nil else Cons(rg_join(rg_exp_rows(k, rg_vals())), rg_exp_bin(k + 1))
fn rg_exp_un(k) = if k >= rg_nbin() + rg_nun() then Nil else Cons(rg_exp_urow(k, rg_vals()) + "\n", rg_exp_un(k + 1))
fn rg_exp_q(qs) = match qs
    Nil        => Nil
    Cons(h, t) => Cons((if h.a <= h.t and h.t <= h.b then "0" else "1") + "\n", rg_exp_q(t))
fn rg_expected() = rg_join(rg_exp_bin(0)) + rg_join(rg_exp_un(rg_nbin())) + rg_join(rg_exp_q(rg_quants()))
## the first line where two outputs differ, for the failure message
fn rg_diff_at(x, y, i, ln) = if i >= count(x) or i >= count(y) then ln else if at(x, i) != at(y, i) then ln else rg_diff_at(x, y, i + 1, if at(x, i) == "\n" then ln + 1 else ln)
fn rg_nth_line(s, n, i) = if i >= count(s) then "<end of output>" else let e = rg_line_end(s, i) in if n <= 1 then slice(s, i, e) else rg_nth_line(s, n - 1, e + 1)

## --- the helper regions of the assembly text: {nm, from, upto}: the lines from the label `from` to the label `upto` ---
fn rg_r(nm, from, upto) = {nm: nm, from: from, upto: upto}
fn rg_regions() = Cons(rg_r("mkint", "mkint", "__rt_uint"), Cons(rg_r("__rt_uint", "__rt_uint", "__rt_cond"), Cons(rg_r("__rt_cond", "__rt_cond", "__rt_uidx"), Cons(rg_r("__rt_ustk", "__rt_ustk", "__rt_un2"), Cons(rg_r("__rt_un2", "__rt_un2", "__rt_ustr_stk"), Cons(rg_r("__rt_isstr", "__rt_isstr", "__rt_sv1"), Cons(rg_r("__rt_idiv", "__rt_idiv", "__rt_imod"), Cons(rg_r("__rt_imod", "__rt_imod", "__lume_rec_update"), Cons(rg_r("trap stubs", "__rt_div0", "__rt_no_match"), Cons(rg_r("cmpv", "cmpv", "addv"), Cons(rg_r("addv", "addv", "addvs"), Cons(rg_r("__rt_sub", "__rt_sub", "__rt_mul"), Cons(rg_r("__rt_mul", "__rt_mul", "__rt_div"), Cons(rg_r("__rt_div", "__rt_div", "__rt_mod"), Cons(rg_r("__rt_mod", "__rt_mod", "__rt_wadd"), Cons(rg_r("__rt_wadd", "__rt_wadd", "__rt_wsub"), Cons(rg_r("__rt_wsub", "__rt_wsub", "__rt_wmul"), Cons(rg_r("__rt_wmul", "__rt_wmul", "__rt_qnext"), Cons(rg_r("__rt_qnext", "__rt_qnext", "io_read_byte"), Cons(rg_r("eqv", "eqv", "eqvs"), Cons(rg_r("eqv0", "eqv0", "printval"), Nil)))))))))))))))))))))
fn rg_nl(s, n, i) = if i >= n then n else if at(s, i) == "\n" then i else rg_nl(s, n, i + 1)
fn rg_line_at(s, n, i, hdr) = if i >= n then 0 - 1 else let e = rg_nl(s, n, i) in if at(s, i) != " " and slicen(s, n, i, e) == hdr then i else rg_line_at(s, n, e + 1, hdr)
fn rg_lines(s, n, i) = if i >= n then Nil else let e = rg_nl(s, n, i) in Cons(slicen(s, n, i, e), rg_lines(s, n, e + 1))
fn rg_unlines(ls) = match ls
    Nil        => Nil
    Cons(h, t) => Cons(h + "\n", rg_unlines(t))

## --- mutation operators: each returns replacements {cls, ls} for one instruction line ---
fn rg_m(cls, l) = {cls: cls, ls: Cons(l, Nil)}
fn rg_op(l) = let t = slice(l, 4, count(l)) in let sp = tvr_find(t, " ", 0) in if sp < 0 then t else slice(t, 0, sp)
fn rg_args(l) = let t = slice(l, 4, count(l)) in let sp = tvr_find(t, " ", 0) in if sp < 0 then "" else slice(t, sp + 1, count(t))
fn rg_with_op(l, op) = let a = rg_args(l) in "    " + op + (if a == "" then "" else " " + a)
fn rg_pairs() = Cons({a: "jo", b: "jno", c: "cc-flip"}, Cons({a: "jno", b: "jo", c: "cc-flip"}, Cons({a: "je", b: "jne", c: "cc-flip"}, Cons({a: "jne", b: "je", c: "cc-flip"}, Cons({a: "jz", b: "jnz", c: "cc-flip"}, Cons({a: "jnz", b: "jz", c: "cc-flip"}, Cons({a: "jl", b: "jge", c: "cc-flip"}, Cons({a: "jge", b: "jl", c: "cc-flip"}, Cons({a: "jg", b: "jle", c: "cc-flip"}, Cons({a: "jle", b: "jg", c: "cc-flip"}, Cons({a: "jc", b: "jnc", c: "cc-flip"}, Cons({a: "jnc", b: "jc", c: "cc-flip"}, Cons({a: "jl", b: "jg", c: "cc-swap"}, Cons({a: "jg", b: "jl", c: "cc-swap"}, Cons({a: "jl", b: "jle", c: "cc-edge"}, Cons({a: "jg", b: "jge", c: "cc-edge"}, Cons({a: "jge", b: "jg", c: "cc-edge"}, Cons({a: "jle", b: "jl", c: "cc-edge"}, Cons({a: "addq", b: "subq", c: "add-sub"}, Cons({a: "subq", b: "addq", c: "add-sub"}, Cons({a: "incq", b: "decq", c: "add-sub"}, Cons({a: "imulq", b: "addq", c: "add-sub"}, Cons({a: "sete", b: "setne", c: "cc-flip"}, Cons({a: "andq", b: "orq", c: "and-or"}, Cons({a: "orq", b: "andq", c: "and-or"}, Cons({a: "testq", b: "cmpq", c: "test-cmp"}, Cons({a: "cmpq", b: "testq", c: "test-cmp"}, Cons({a: "movq", b: "leaq", c: "mov-lea"}, Nil))))))))))))))))))))))))))))
fn rg_m_ops(l, op, ps) = match ps
    Nil        => Nil
    Cons(p, t) => if p.a == op and (p.c != "mov-lea" or rg_has(l, "(%") == 1) then Cons(rg_m(p.c, rg_with_op(l, p.b)), rg_m_ops(l, op, t)) else rg_m_ops(l, op, t)
## `op %x, %y` -> `op %y, %x`
fn rg_m_swap(l, op) = let a = rg_args(l) in let c = rg_index(a, ", ", 0) in if c < 0 or (op != "subq" and op != "cmpq" and op != "movq" and op != "imulq") then Nil else let x = slice(a, 0, c) in let y = slice(a, c + 2, count(a)) in if rg_starts(x, "%") == 1 and rg_starts(y, "%") == 1 and x != y then Cons(rg_m("operand-swap", "    " + op + " " + y + ", " + x), Nil) else Nil
fn rg_swap2(l, x, y) = rg_repall(rg_repall(rg_repall(l, x, "%r__", 0), y, x, 0), "%r__", y, 0)
fn rg_m_regs(l) = let a = rg_swap2(l, "%rdi", "%rsi") in let b = rg_swap2(l, "%rax", "%rcx") in let c = rg_swap2(l, "%rax", "%rdx") in rg_app(if a != l then Cons(rg_m("reg-swap", a), Nil) else Nil, rg_app(if b != l then Cons(rg_m("reg-swap", b), Nil) else Nil, if c != l then Cons(rg_m("reg-swap", c), Nil) else Nil))
fn rg_num_end(s, i) = if i < count(s) and ((at(s, i) >= "0" and at(s, i) <= "9") or at(s, i) == "-") then rg_num_end(s, i + 1) else i
## `$K` -> `$(K+d)`
fn rg_m_imm1(l, d) = let i = rg_index(l, "$", 0) in if i < 0 then Nil else let e = rg_num_end(l, i + 1) in let t = slice(l, i + 1, e) in if tvr_isint(t) == 0 or count(t) > 12 then Nil else Cons(rg_m("imm", slice(l, 0, i + 1) + str(tvr_int(t) + d) + slice(l, e, count(l))), Nil)
fn rg_m_imm(l) = rg_app(rg_m_imm1(l, 1), rg_m_imm1(l, 0 - 1))
fn rg_disp_start(l, p) = if p > 0 and ((at(l, p - 1) >= "0" and at(l, p - 1) <= "9") or at(l, p - 1) == "-") then rg_disp_start(l, p - 1) else p
## `D(%r)` -> `(D+d)(%r)`, an absent D being 0
fn rg_m_disp1(l, d, cls) = let p = rg_index(l, "(%", 0) in if p < 0 or rg_has(l, "(%rip)") == 1 then Nil else let b = rg_disp_start(l, p) in let t = slice(l, b, p) in if t != "" and tvr_isint(t) == 0 then Nil else let v = (if t == "" then 0 else tvr_int(t)) + d in Cons(rg_m(cls, slice(l, 0, b) + (if v == 0 then "" else str(v)) + slice(l, p, count(l))), Nil)
fn rg_m_disp(l, op) = if op == "leaq" then rg_app(rg_m_disp1(l, 1, "lea-disp"), rg_app(rg_m_disp1(l, 0 - 1, "lea-disp"), rg_app(rg_m_disp1(l, 2, "lea-disp"), rg_m_disp1(l, 0 - 2, "lea-disp")))) else rg_app(rg_m_disp1(l, 8, "offset"), rg_m_disp1(l, 0 - 8, "offset"))
fn rg_m_mkint(l) = if l == "    call mkint" then Cons(rg_m("no-mkint", "    movq %rdi, %rax"), Nil) else if l == "    jmp mkint" then Cons({cls: "no-mkint", ls: Cons("    movq %rdi, %rax", Cons("    ret", Nil))}, Nil) else Nil
fn rg_m_trap1(l, x, y) = if rg_starts(l, "    j") == 1 and rg_has(l, " " + x) == 1 and count(l) == rg_index(l, " " + x, 0) + count(x) + 1 then Cons(rg_m("trap-redirect", rg_rep1(l, " " + x, " " + y)), Nil) else Nil
fn rg_m_trap(l) = rg_app(rg_m_trap1(l, "__rt_ovf", "__rt_div0"), rg_app(rg_m_trap1(l, "__rt_div0", "__rt_ovf"), rg_app(rg_m_trap1(l, "__rt_not_int", "__rt_ovf"), rg_m_trap1(l, "__rt_not_bool", "__rt_not_int"))))
fn rg_m_call(l) = if l == "    call __rt_idiv" then Cons(rg_m("div-mod", "    call __rt_imod"), Nil) else if l == "    call __rt_imod" then Cons(rg_m("div-mod", "    call __rt_idiv"), Nil) else if l == "    call __rt_uint" then Cons(rg_m("no-unbox", "    sarq $1, %rax"), Nil) else Nil
fn rg_muts(l) = if rg_starts(l, "    ") == 0 or rg_starts(l, "    .") == 1 then Nil else let op = rg_op(l) in Cons({cls: "drop", ls: Nil}, rg_app(rg_m_ops(l, op, rg_pairs()), rg_app(rg_m_swap(l, op), rg_app(rg_m_regs(l), rg_app(rg_m_imm(l), rg_app(rg_m_disp(l, op), rg_app(rg_m_mkint(l), rg_app(rg_m_trap(l), rg_m_call(l)))))))))
## every mutant of a region: {cls, at: line index, was: original line, ls: the region's lines after the mutation}
fn rg_line_muts(ms, before_rev, l, after, i) = match ms
    Nil        => Nil
    Cons(m, t) => Cons({cls: m.cls, at: i, was: l, now: rg_join(rg_unlines(m.ls)), ls: rg_revacc(before_rev, rg_app(m.ls, after))}, rg_line_muts(t, before_rev, l, after, i))
fn rg_region_muts(before_rev, ls, i) = match ls
    Nil        => Nil
    Cons(l, t) => rg_app(rg_line_muts(rg_muts(l), before_rev, l, t, i), rg_region_muts(Cons(l, before_rev), t, i + 1))

## --- one mutant: verify, assemble, run ---
## st = {err, n, changed, eq_rej, eq_acc, noasm, log: accepted mutants with the same behaviour, tab: per-region rows}
fn rg_st(err, n, changed, eq_rej, eq_acc, noasm, log, tab) = {err: err, n: n, changed: changed, eq_rej: eq_rej, eq_acc: eq_acc, noasm: noasm, log: log, tab: tab}
fn rg_beh(elf, out) = let r = rg_run(elf, Nil, out, 4000) in str(r.status) + ":" + r.out + ":" + r.err
fn rg_shown(s) = rg_repall(s, "\n", " | ", 0)
fn rg_mutant(cfg, reg, pre, post, m, base, st) = let text = pre + rg_join(rg_unlines(m.ls)) + post in let v = tvr_verify_asm(text) in let sp = cfg.tmp + "/m.s" in let w = fs_write_sync(sp, text) in let a = rg_run(cfg.lasm, Cons("--strict", Cons(sp, Nil)), cfg.tmp + "/m.elf", 120000) in let what = reg + " line " + str(m.at) + " [" + m.cls + "]: `" + m.was + "` -> `" + (if m.now == "" then "<deleted>" else rg_shown(m.now)) + "`" in if a.status != 0 then rg_st("", st.n + 1, st.changed, st.eq_rej, st.eq_acc, st.noasm + 1, st.log, st.tab) else let ch = os_run("/bin/chmod", Cons("+x", Cons(cfg.tmp + "/m.elf", Nil))) in let differs = if rg_beh(cfg.tmp + "/m.elf", cfg.tmp + "/m.run") != base then 1 else 0 in if differs == 1 and v.ok == 1 then rg_st("UNSOUND ACCEPTANCE: ltv_rt verified a mutant whose native behaviour differs from the original: " + what, st.n, st.changed, st.eq_rej, st.eq_acc, st.noasm, st.log, st.tab) else if differs == 1 then rg_st("", st.n + 1, st.changed + 1, st.eq_rej, st.eq_acc, st.noasm, st.log, st.tab) else if v.ok == 0 then rg_st("", st.n + 1, st.changed, st.eq_rej + 1, st.eq_acc, st.noasm, st.log, st.tab) else rg_st("", st.n + 1, st.changed, st.eq_rej, st.eq_acc + 1, st.noasm, Cons(what + "\n", st.log), st.tab)
fn rg_mutants(cfg, reg, pre, post, ms, k, base, st) = match ms
    Nil        => st
    Cons(m, t) => if st.err != "" then st else if k % cfg.stride != 0 then rg_mutants(cfg, reg, pre, post, t, k + 1, base, st) else rg_mutants(cfg, reg, pre, post, t, k + 1, base, rg_mutant(cfg, reg, pre, post, m, base, st))
fn rg_region(cfg, asm, r, base, st) = let n = count(asm) in let b = rg_line_at(asm, n, 0, r.from + ":") in if b < 0 then rg_st("the label " + r.from + " is missing from the assembly", st.n, st.changed, st.eq_rej, st.eq_acc, st.noasm, st.log, st.tab) else let e = rg_line_at(asm, n, b, r.upto + ":") in if e < 0 or e - b > 6000 then rg_st("the region of " + r.nm + " does not end at " + r.upto + " (the runtime layout changed: update rg_regions)", st.n, st.changed, st.eq_rej, st.eq_acc, st.noasm, st.log, st.tab) else let ls = rg_lines(asm, e, b) in let s2 = rg_mutants(cfg, r.nm, slicen(asm, n, 0, b), slicen(asm, n, e, n), rg_region_muts(Nil, ls, 0), 0, base, rg_st(st.err, 0, 0, 0, 0, 0, st.log, st.tab)) in rg_st(s2.err, st.n + s2.n, st.changed + s2.changed, st.eq_rej + s2.eq_rej, st.eq_acc + s2.eq_acc, st.noasm + s2.noasm, s2.log, Cons({nm: r.nm, lines: rg_len(ls) - 1, n: s2.n, changed: s2.changed, eq_rej: s2.eq_rej, eq_acc: s2.eq_acc, noasm: s2.noasm}, st.tab))
fn rg_all_regions(cfg, asm, rs, base, st) = match rs
    Nil        => st
    Cons(r, t) => if st.err != "" then st else rg_all_regions(cfg, asm, t, base, rg_region(cfg, asm, r, base, st))
fn rg_tab_show(tab) = match tab
    Nil        => ""
    Cons(h, t) => rg_tab_show(t) + "  " + h.nm + ": " + str(h.lines) + " lines, " + str(h.n) + " mutants, " + str(h.changed) + " behaviour-changing (all rejected), " + str(h.eq_rej) + " rejected with the same behaviour on the matrix, " + str(h.eq_acc) + " accepted with the same behaviour, " + str(h.noasm) + " not assemblable, unsound acceptances 0\n"
fn rg_tab_zero(tab, names) = match names
    Nil        => ""
    Cons(nm, t) => if rg_tab_changed(tab, nm) == 0 then nm else rg_tab_zero(tab, t)
fn rg_tab_changed(tab, nm) = match tab
    Nil        => 0
    Cons(h, t) => if h.nm == nm then h.changed else rg_tab_changed(t, nm)
## the regions the fixture reaches from Lume source: each must have behaviour-changing mutants, so none passes by being empty
fn rg_reached() = Cons("__rt_ustk", Cons("mkint", Cons("__rt_uint", Cons("__rt_cond", Cons("__rt_un2", Cons("__rt_isstr", Cons("__rt_idiv", Cons("__rt_imod", Cons("trap stubs", Cons("cmpv", Cons("addv", Cons("__rt_sub", Cons("__rt_mul", Cons("__rt_div", Cons("__rt_mod", Cons("__rt_wadd", Cons("__rt_wsub", Cons("__rt_wmul", Cons("__rt_qnext", Cons("eqv", Cons("eqv0", Nil)))))))))))))))))))))

## --- hand-written wrong helpers: {nm, pat, rep}; the verifier must reject each ---
fn rg_t(nm, pat, rep) = {nm: nm, pat: pat, rep: rep}
fn rg_targets() = Cons(rg_t("addv fast path: lea followed by jo (lea sets no flags)", "    leaq -1(%rdi), %rax\n    addq %rsi, %rax\n    jo .Lrt_av_big\n", "    movq %rsi, %rax\n    leaq -1(%rax,%rdi), %rax\n    jo .Lrt_av_big\n"), Cons(rg_t("addv fast path: adds both tagged words", "    leaq -1(%rdi), %rax\n    addq %rsi, %rax\n    jo .Lrt_av_big\n", "    movq %rdi, %rax\n    addq %rsi, %rax\n    jo .Lrt_av_big\n"), Cons(rg_t("mkint: always the immediate form (drops the 64th bit)", "    addq %rax, %rax\n    jo .Lrt_mkint_box\n    incq %rax\n", "    addq %rax, %rax\n    incq %rax\n"), Cons(rg_t("mkint: always boxes (a boxed value that fits 63 bits escapes)", "    jo .Lrt_mkint_box\n", "    jmp .Lrt_mkint_box\n"), Cons(rg_t("mkint: payload kept in %r10 across the allocator", "    movq %rdi, %r11\n    movq $16, %rdi\n    call __lume_alloc_a\n    movq $3, (%rax)\n    movq %r11, 8(%rax)\n", "    movq %rdi, %r10\n    movq $16, %rdi\n    call __lume_alloc_a\n    movq $3, (%rax)\n    movq %r10, 8(%rax)\n"), Cons(rg_t("mkint: cell header is not the integer kind", "    movq $3, (%rax)\n    movq %r11, 8(%rax)\n", "    movq $5, (%rax)\n    movq %r11, 8(%rax)\n"), Cons(rg_t("mkint: allocates 8 bytes for a 16-byte cell", "    movq $16, %rdi\n    call __lume_alloc_a\n    movq $3, (%rax)\n", "    movq $8, %rdi\n    call __lume_alloc_a\n    movq $3, (%rax)\n"), Cons(rg_t("__rt_idiv: no INT64_MIN / -1 guard (#DE)", "    cmpq $-1, %rcx\n    jne .Lrt_rdv1\n    movq %rax, %rdx\n    subq $1, %rdx\n    jo __rt_ovf\n", ""), Cons(rg_t("__rt_idiv: no divisor-zero test (#DE)", "__rt_idiv:\n    testq %rcx, %rcx\n    je __rt_div0\n", "__rt_idiv:\n"), Cons(rg_t("__rt_imod: returns the quotient", "    idivq %rcx\n    movq %rdx, %rax\n    ret\n", "    idivq %rcx\n    ret\n"), Cons(rg_t("__rt_idiv: divides without cqto (stale %rdx)", ".Lrt_rdv1:\n    cqto\n", ".Lrt_rdv1:\n"), Cons(rg_t("__rt_sub: no overflow test", "    subq %rax, %rdi\n    jo __rt_ovf\n    jmp mkint\n", "    subq %rax, %rdi\n    jmp mkint\n"), Cons(rg_t("__rt_mul: clobbers the callee-saved %rbx", "    imulq %rcx, %rax\n    jo __rt_ovf\n", "    movq %rcx, %rbx\n    imulq %rbx, %rax\n    jo __rt_ovf\n"), Cons(rg_t("cmpvi: decides the order by the sign of a wrapping subtraction", "    cmpq %rax, %rdi\n    jl cmpvlt\n    jg cmpvgt\n    xorq %rax, %rax\n    ret\ncmpvlt:\n", "    subq %rax, %rdi\n    js cmpvlt\n    jg cmpvgt\n    xorq %rax, %rax\n    ret\ncmpvlt:\n"), Cons(rg_t("eqv: compares the words only (two cells with equal values are unequal)", "eqv:\n    cmpq %rdi, %rsi\n    je .Lrt_eqv1\n", "eqv:\n    cmpq %rdi, %rsi\n    je .Lrt_eqv1\n    jmp eqv0\n"), Cons(rg_t("eqvi: compares the header instead of the payload", "    movq 8(%rdi), %rax\n    cmpq 8(%rsi), %rax\n    sete %al\n", "    movq (%rdi), %rax\n    cmpq (%rsi), %rax\n    sete %al\n"), Cons(rg_t("__rt_uint: returns the pointer of a boxed operand", "    cmpb $3, (%rax)\n    jne __rt_not_int\n    movq 8(%rax), %rax\n    ret\n__rt_cond:\n", "    cmpb $3, (%rax)\n    jne __rt_not_int\n    ret\n__rt_cond:\n"), Cons(rg_t("__rt_ovf: prints the division message", "    leaq __rt_ovf_msg(%rip), %r8\n", "    leaq __rt_dzero_msg(%rip), %r8\n"), Cons(rg_t("__rt_qnext: no end test (wraps past 2^63-1)", "    cmpq %rcx, %rax\n    je .Lrt_qn0\n    leaq 1(%rax), %rdi\n", "    leaq 1(%rax), %rdi\n"), Cons(rg_t("__rt_wadd: traps on overflow like addv", "__rt_wadd:\n    movq %rdi, %rax\n    call __rt_uint\n    movq %rax, %rdi\n    movq %rsi, %rax\n    call __rt_uint\n    addq %rax, %rdi\n    jmp mkint\n", "__rt_wadd:\n    movq %rdi, %rax\n    call __rt_uint\n    movq %rax, %rdi\n    movq %rsi, %rax\n    call __rt_uint\n    addq %rax, %rdi\n    jo __rt_ovf\n    jmp mkint\n"), Cons(rg_t("allocator fast path: clobbers %r11 (the register mkint keeps live)", "    pushq %r11\n    movq (%rax), %r11\n    notq %r11\n    movq %r11, (%r10)\n    popq %r11\n", "    movq (%rax), %r11\n    notq %r11\n    movq %r11, (%r10)\n"), Nil)))))))))))))))))))))
## r = {err, n, same: variants that behave like the original on the matrix, log}
fn rg_target(cfg, asm, t, base, r) = if rg_index(asm, t.pat, 0) < 0 then {err: "the site of the wrong variant `" + t.nm + "` is not in the assembly (update rg_targets)", n: r.n, same: r.same, log: r.log} else let text = rg_rep1(asm, t.pat, t.rep) in let v = tvr_verify_asm(text) in if v.ok == 1 then {err: "ltv_rt VERIFIED the wrong variant `" + t.nm + "`", n: r.n, same: r.same, log: r.log} else let sp = cfg.tmp + "/t.s" in let w = fs_write_sync(sp, text) in let a = rg_run(cfg.lasm, Cons("--strict", Cons(sp, Nil)), cfg.tmp + "/t.elf", 120000) in if a.status != 0 then {err: "lasm rejected the wrong variant `" + t.nm + "`: " + a.err, n: r.n, same: r.same, log: r.log} else let ch = os_run("/bin/chmod", Cons("+x", Cons(cfg.tmp + "/t.elf", Nil))) in let differs = if rg_beh(cfg.tmp + "/t.elf", cfg.tmp + "/t.run") != base then 1 else 0 in {err: "", n: r.n + 1, same: r.same + 1 - differs, log: Cons("  rejected: " + t.nm + " (" + (if differs == 1 then "native behaviour differs" else "same behaviour on the matrix") + "): " + v.err + "\n", r.log)}
fn rg_targets_run(cfg, asm, ts, base, r) = match ts
    Nil        => r
    Cons(t, rest) => if r.err != "" then r else rg_targets_run(cfg, asm, rest, base, rg_target(cfg, asm, t, base, r))
fn rg_helpers_show(rs) = match rs
    Nil        => ""
    Cons(r, t) => "  " + r.nm + ": " + str(r.nc) + " input cases, " + str(r.np) + " symbolic paths, " + str(r.nob) + " obligations discharged\n" + rg_helpers_show(t)
fn rg_names(xs) = match xs
    Nil        => ""
    Cons(h, t) => h + (if tvr_isnil(t) == 1 then "" else ", ") + rg_names(t)
fn rg_main(input) = let root = rg_get(input, "root") in if root == "" then ctfail("tv_rt gate requires @root\n") else let tmp = rg_or(rg_get(input, "tmp"), "/tmp/lume-tv-rt-gate." + str(os_getpid())) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil))) in let cfg = {root: root, tmp: tmp, lasm: root + "/build/bin/lasm", stride: toint(rg_or(rg_get(input, "stride"), "1"))} in let w = fs_write_sync(tmp + "/fixture.src", rg_source()) in let c = rg_input(root + "/build/bin/lumec", Nil, tmp + "/fixture.src", tmp + "/fixture.s", 300000) in if c.status != 0 then ctfail("tv_rt gate failed: lumec rejected the fixture: " + c.err + "\n") else let a = rg_run(cfg.lasm, Cons("--strict", Cons(tmp + "/fixture.s", Nil)), tmp + "/fixture.elf", 120000) in if a.status != 0 then ctfail("tv_rt gate failed: lasm rejected the fixture: " + a.err + "\n") else let ch = os_run("/bin/chmod", Cons("+x", Cons(tmp + "/fixture.elf", Nil))) in let asm = fs_read_file(tmp + "/fixture.s") in let v = tvr_verify_asm_full(asm) in if v.ok != 1 then ctfail("tv_rt gate failed: ltv_rt rejected the unmutated helpers: " + v.err + "\n") else let native = rg_run(tmp + "/fixture.elf", Nil, tmp + "/base.run", 20000) in let want = rg_expected() in if native.status != 0 or native.err != "" then ctfail("tv_rt gate failed: the fixture did not run cleanly: status " + str(native.status) + " " + native.err + "\n") else if native.out != want then (let ln = rg_diff_at(native.out, want, 0, 1) in ctfail("tv_rt gate failed: the specification disagrees with the native binary at output line " + str(ln) + ":\n  native: " + rg_nth_line(native.out, ln, 0) + "\n  spec:   " + rg_nth_line(want, ln, 0) + "\n")) else let canon = tvr_canon_run(asm) in if rg_names(tvr_canon_names(canon, 0)) != "eqv" then ctfail("tv_rt gate failed: the helpers that rely on the canonical-form invariant are no longer exactly `eqv`: " + rg_names(tvr_canon_names(canon, 0)) + "\n") else let base = str(native.status) + ":" + native.out + ":" + native.err in let tg = rg_targets_run(cfg, asm, rg_targets(), base, {err: "", n: 0, same: 0, log: Nil}) in if tg.err != "" then ctfail("tv_rt gate failed: " + tg.err + "\n") else let st = rg_all_regions(cfg, asm, rg_regions(), base, rg_st("", 0, 0, 0, 0, 0, Nil, Nil)) in if st.err != "" then ctfail("tv_rt gate failed: " + st.err + "\n") else let zero = rg_tab_zero(st.tab, rg_reached()) in if cfg.stride == 1 and zero != "" then ctfail("tv_rt gate failed: no mutant of " + zero + " changed the behaviour of the fixture, so its rejections measure nothing\n") else if cfg.stride == 1 and st.changed < 600 then ctfail("tv_rt gate failed: only " + str(st.changed) + " behaviour-changing mutants\n") else let mk2 = os_run("/bin/mkdir", Cons("-p", Cons(root + "/build/certification", Nil))) in let wl = fs_write_sync(root + "/build/certification/tv_rt_gate_accepted_same_behaviour.txt", rg_join(rg_revacc(st.log, Nil))) in "tv_rt gate passed: ltv_rt verified " + str(v.n_helpers) + " helpers of the emitted runtime (" + str(v.n_paths) + " symbolic paths, " + str(v.n_obl) + " obligations)\n" + rg_helpers_show(v.results) + "specification vs machine: " + str(rg_nbin() * rg_len(rg_vals()) * rg_len(rg_vals()) + rg_nun() * rg_len(rg_vals()) + rg_len(rg_quants())) + " boundary vectors, the specification evaluator predicts the native output exactly\ncanonical-form invariant: relied on by " + rg_names(tvr_canon_names(canon, 0)) + "; not needed by " + rg_names(tvr_canon_names(canon, 1)) + "\nwrong variants: " + str(tg.n) + " hand-written defects, all rejected (" + str(tg.n - tg.same) + " change the native behaviour of the fixture)\n" + rg_join(rg_revacc(tg.log, Nil)) + "mutation: " + str(st.n) + " mutants (stride " + str(cfg.stride) + "), " + str(st.changed) + " behaviour-changing, all " + str(st.changed) + " rejected; " + str(st.eq_rej) + " rejected with the same behaviour on the matrix; " + str(st.eq_acc) + " accepted with the same behaviour; " + str(st.noasm) + " not assemblable; unsound acceptances: 0\n" + rg_tab_show(st.tab) + "the accepted mutants with the same behaviour are listed in build/certification/tv_rt_gate_accepted_same_behaviour.txt\n"

print rg_main(readall())
