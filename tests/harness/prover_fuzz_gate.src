## prover_fuzz_gate.src -- stand-alone driver for the false-theorem fuzzer (tests/harness/prover_fuzz.src).
## Runs BOTH a deterministic regression campaign (`@n`, default 200, from `@seed`, default 20261110) AND a dynamic fresh
## CSPRNG campaign seeded from `/dev/urandom` (`@urandom_n`, default max(12, n / 4), disable only with `@urandom 0`),
## spanning all 6 domains: integer/bit/div arithmetic, records & shadowing, canonical arrays, separation/heap models,
## nested quantifiers (`forall_range` <-> `exists_range` off-by-one), and algebraic `law` declarations.
## Every campaign also runs domain 6 (pf6_*, n / 4 cases) and the fixed Wave 14 audit cases of prover_fuzz.src.
##   printf '@root %s\n@n 200\n@seed 20261110\n' "$PWD" | build/bin/prover_fuzz_gate
## Optional lines: `@lumec <path>`, `@lasm <path>`, `@lcaas <path>`, `@urandom_n <count>`, `@urandom <0|1>`.
use prover_fuzz

fn pg_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else pg_line_end(s, i + 1)
fn pg_get_at(s, key, i) = if i >= count(s) then "" else let e = pg_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else pg_get_at(s, key, e + 1)
fn pg_get(s, key) = pg_get_at(s, key, 0)
fn pg_or(v, d) = if v == "" then d else v
fn pg_un_default(n) = let q = n / 4 in if n < 12 then 6 else if q < 12 then 12 else if q > 48 then 48 else q
fn pg_main(input) = let root = pg_get(input, "root") in if root == "" then ctfail("prover fuzz gate requires @root\n") else let tmp = root + "/build/prover-fuzz-" + str(os_getpid()) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil))) in let d = pf_cfg(root, tmp) in let cfg = {tmp: tmp, lumec: pg_or(pg_get(input, "lumec"), d.lumec), lasm: pg_or(pg_get(input, "lasm"), d.lasm), lcaas: pg_or(pg_get(input, "lcaas"), d.lcaas)} in let n = toint(pg_or(pg_get(input, "n"), "200")) in let seed = toint(pg_or(pg_get(input, "seed"), "20261110")) in let st = pf_fuzz(cfg, n, seed) in if st.err != "" then let rm1 = os_run("/bin/rm", Cons("-rf", Cons(tmp, Nil))) in ctfail("prover fuzz gate failed (fixed seed " + str(seed) + "): " + st.err + "\n") else let uon = toint(pg_or(pg_get(input, "urandom"), "1")) in let un = if uon == 0 then 0 else toint(pg_or(pg_get(input, "urandom_n"), str(pg_un_default(n)))) in let useed = if un > 0 then pf_urandom_seed() else 0 in let ust = if un > 0 then pf_fuzz(cfg, un, useed) else {err: "", traps: 0, rejects: 0, kt: 0} in let rm2 = os_run("/bin/rm", Cons("-rf", Cons(tmp, Nil))) in if ust.err != "" then ctfail("prover fuzz gate failed (/dev/urandom seed " + str(useed) + "): " + ust.err + "\n") else "OK: " + str(n + un) + " fuzz cases (" + str(n) + " fixed from seed " + str(seed) + " + " + str(un) + " fresh from /dev/urandom seed " + str(useed) + ") across 6 domains (int/bits/div, records+shadowing, canonical arrays, separation/heap, nested quantifiers, laws), plus " + str(pf6_n(n) + (if un > 0 then pf6_n(un) else 0)) + " cases of domain 6 (wrapping operators, negative and variable divisors, contract-carrying callees, 2^40 coefficients, total fn with lexicographic measures) and " + str(pf6_count()) + " fixed Wave 14 audit cases per campaign: " + str(st.traps + ust.traps) + " false theorems stopped by their runtime check, " + str(st.rejects + ust.rejects) + " refuted at compile time, 0 proven by lumec / lcaas / the lcert kernel (" + str(st.kt + ust.kt) + " true controls re-derived by the kernel)"

print pg_main(readall())
