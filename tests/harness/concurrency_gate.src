## concurrency_gate.src -- acceptance gate of Lume's linear concurrency, deadlock-free DAG & multi-worker engine.
##   printf '@root %s\n' "$PWD" | build/bin/concurrency_gate
## Verifies in 100% native Lume:
##   1. [E0305] linear channel move / use-after-send rejection (exit 3, zero asm emitted, lumec + lcaas parity);
##   2. [E0306] cyclic lock/actor wait-for DAG & lock-rank violation rejection (exit 3, zero asm emitted, lumec + lcaas);
##   3. Valid linear channel relay, strict ascending lock-rank nesting, and diamond actor DAG compile & execute cleanly;
##   4. SPSC lock-free ring-buffer wraparound conservation & runtime DAG cycle detector (`use lconcurrency`);
##   5. Concurrent multi-worker execution stress across 6 and 8 parallel native Lume ELF64 OS worker processes;
##   6. QF_LIA formal proof verification of all contracts, conservation laws, and @bound budgets in `lconcurrency.src`.
use lconcurrency

fn cg_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else cg_line_end(s, i + 1)

fn cg_get_at(s, key, i) =
    if i >= count(s) then ""
    else
        let e = cg_line_end(s, i) in
        let n = count(key) in
        if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e)
        else cg_get_at(s, key, e + 1)

fn cg_root(input) =
    let r = cg_get_at(input, "root", 0) in
    if r != "" then r
    else if fs_path_exists("./build/bin/lumec") == 1 then "."
    else ""

fn cg_contains_at(text, part, i) =
    if i + count(part) > count(text) then 0
    else if slice(text, i, i + count(part)) == part then 1
    else cg_contains_at(text, part, i + 1)

fn cg_contains(text, part) = cg_contains_at(text, part, 0)

fn cg_count_occ_at(text, part, i, acc) =
    if count(part) == 0 or i + count(part) > count(text) then acc
    else if slice(text, i, i + count(part)) == part then cg_count_occ_at(text, part, i + count(part), acc + 1)
    else cg_count_occ_at(text, part, i + 1, acc)

fn cg_wait_exit(raw) =
    if raw < 0 or raw % 256 == 127 then 1
    else if raw % 256 == 0 then raw / 256
    else 128 + raw % 128

fn cg_input(path, in_path, out_path) =
    os_run_input_capture_timeout(path, Nil, in_path, out_path, out_path + ".err", 60000)

fn cg_run(path, args, out_path) =
    os_run_capture_timeout(path, args, out_path, out_path + ".err", 60000)

fn cg_compile_inline(root, tmp, name, src) =
    let sp = tmp + "/" + name + ".src" in
    let ap = tmp + "/" + name + ".s" in
    let w = fs_write_sync(sp, src) in
    let st = cg_input(root + "/build/bin/lumec", sp, ap) in
    {exit_code: cg_wait_exit(st), asm_path: ap, asm_body: fs_read_file(ap), err: fs_read_file(ap + ".err")}

fn cg_oracle_inline(root, tmp, name, mode, src) =
    let ip = tmp + "/" + name + ".caas.in" in
    let op = tmp + "/" + name + ".caas.out" in
    let w = fs_write_sync(ip, "@mode " + mode + "\n" + src) in
    let st = cg_input(root + "/build/bin/lcaas", ip, op) in
    fs_read_file(op)

fn cg_expect_reject(root, tmp, name, code, src) =
    let c = cg_compile_inline(root, tmp, name, src) in
    if c.exit_code != 3 then
        ctfail("concurrency gate failed [" + name + "]: expected lumec exit 3, got " + str(c.exit_code) + " (" + c.err + ")\n")
    else if count(c.asm_body) != 0 then
        ctfail("concurrency gate failed [" + name + "]: expected zero assembly emitted on [" + code + "], got " + str(count(c.asm_body)) + " bytes\n")
    else if cg_contains(c.err, "[" + code + "]") == 0 then
        ctfail("concurrency gate failed [" + name + "]: lumec stderr missing [" + code + "]: " + c.err + "\n")
    else
        let orc = cg_oracle_inline(root, tmp, name, "check", src) in
        if cg_contains(orc, "\"code\":\"" + code + "\"") == 0 then
            ctfail("concurrency gate failed [" + name + "]: lcaas oracle missing " + code + ": " + slice(orc, 0, 240) + "\n")
        else 1

fn cg_expect_run(root, tmp, name, want_out, src) =
    let c = cg_compile_inline(root, tmp, name, src) in
    if c.exit_code != 0 then
        ctfail("concurrency gate failed [" + name + "]: lumec rejected valid program: " + c.err + "\n")
    else if count(c.asm_body) == 0 then
        ctfail("concurrency gate failed [" + name + "]: lumec emitted empty assembly\n")
    else
        let orc = cg_oracle_inline(root, tmp, name, "check", src) in
        if cg_contains(orc, "\"ok\":true") == 0 then
            ctfail("concurrency gate failed [" + name + "]: lcaas rejected valid program: " + slice(orc, 0, 240) + "\n")
        else
            let elf = tmp + "/" + name + ".elf" in
            let ast = cg_wait_exit(cg_run(root + "/build/bin/lasm", Cons("--strict", Cons(c.asm_path, Nil)), elf)) in
            if ast != 0 then
                ctfail("concurrency gate failed [" + name + "]: lasm --strict failed (" + str(ast) + ")\n")
            else
                let ch = cg_run("/bin/chmod", Cons("+x", Cons(elf, Nil)), elf + ".chmod") in
                let rst = cg_wait_exit(cg_run(elf, Nil, elf + ".out")) in
                let got = fs_read_file(elf + ".out") in
                if rst != 0 then
                    ctfail("concurrency gate failed [" + name + "]: binary exited with " + str(rst) + "\n")
                else if got != want_out + "\n" then
                    ctfail("concurrency gate failed [" + name + "]: expected '" + want_out + "', got '" + got + "'\n")
                else 1

## 1. [E0305] linear channel move / use-after-send checks
fn cg_check_e0305(root, tmp) =
    let c1 = cg_expect_reject(root, tmp, "e0305_direct_use_after_send", "E0305",
        "fn chan_send_linear(ch, x) = x\n" +
        "fn bad_sender() =\n" +
        "    let msg = {id: 42, val: 99} in\n" +
        "    let _sent = chan_send_linear(1, msg) in\n" +
        "    msg.val\n" +
        "print bad_sender()\n") in
    let c2 = cg_expect_reject(root, tmp, "e0305_alias_use_after_send", "E0305",
        "fn chan_send_linear(ch, x) = x\n" +
        "fn bad_alias() =\n" +
        "    let msg = {id: 42, val: 99} in\n" +
        "    let alias_msg = msg in\n" +
        "    let _sent = chan_send_linear(1, alias_msg) in\n" +
        "    msg.id\n" +
        "print bad_alias()\n") in
    let c3 = cg_expect_reject(root, tmp, "e0305_double_channel_send", "E0305",
        "fn chan_send_linear(ch, x) = x\n" +
        "fn bad_double() =\n" +
        "    let tok = Cons(7, Cons(8, Nil)) in\n" +
        "    let _s1 = chan_send_linear(1, tok) in\n" +
        "    chan_send_linear(2, tok)\n" +
        "print bad_double()\n") in
    let c4 = cg_expect_reject(root, tmp, "e0305_interproc_forward_reuse", "E0305",
        "fn chan_send_linear(ch, x) = x\n" +
        "fn relay(ch, pkt) = chan_send_linear(ch, pkt)\n" +
        "fn bad_caller() =\n" +
        "    let pkt = {tag: 11, body: 77} in\n" +
        "    let _r = relay(1, pkt) in\n" +
        "    pkt.body\n" +
        "print bad_caller()\n") in
    c1 + c2 + c3 + c4

## 2. [E0306] cyclic lock/channel/actor wait-for graph & lock-rank violation checks
fn cg_check_e0306(root, tmp) =
    let c1 = cg_expect_reject(root, tmp, "e0306_lock_rank_inversion", "E0306",
        "fn lock_acquire(k) = k\n" +
        "fn lock_release(k) = 0\n" +
        "fn invert() =\n" +
        "    let _a = lock_acquire(2) in\n" +
        "    let _b = lock_acquire(1) in\n" +
        "    let _c = lock_release(1) in\n" +
        "    lock_release(2)\n" +
        "print invert()\n") in
    let c2 = cg_expect_reject(root, tmp, "e0306_interproc_lock_cycle", "E0306",
        "fn lock_acquire(k) = k\n" +
        "fn lock_release(k) = 0\n" +
        "fn inner() =\n" +
        "    let _a = lock_acquire(1) in\n" +
        "    lock_release(1)\n" +
        "fn outer() =\n" +
        "    let _x = lock_acquire(3) in\n" +
        "    let _y = inner() in\n" +
        "    lock_release(3)\n" +
        "print outer()\n") in
    let c3 = cg_expect_reject(root, tmp, "e0306_unreleased_lock_leak", "E0306",
        "fn lock_acquire(k) = k\n" +
        "fn leak() = lock_acquire(1)\n" +
        "print leak()\n") in
    let c4 = cg_expect_reject(root, tmp, "e0306_actor_wait_cycle", "E0306",
        "fn actor_link(a, b) = a + b\n" +
        "fn wire_ring() =\n" +
        "    let _e1 = actor_link(0, 1) in\n" +
        "    let _e2 = actor_link(1, 2) in\n" +
        "    actor_link(2, 0)\n" +
        "print wire_ring()\n") in
    c1 + c2 + c3 + c4

## 3. Valid linear concurrency + strict lock rank + acyclic actor topology compilation & execution
fn cg_check_valid_programs(root, tmp) =
    let v1 = cg_expect_run(root, tmp, "valid_linear_pipeline_and_locks", "1042",
        "fn chan_send_linear(ch, x) = {ch: ch, payload: x}\n" +
        "fn lock_acquire(k) = k\n" +
        "fn lock_release(k) = 0\n" +
        "fn actor_link(a, b) = a + b\n" +
        "fn critical_step(v) =\n" +
        "    let _l1 = lock_acquire(1) in\n" +
        "    let _l2 = lock_acquire(2) in\n" +
        "    let res = v + 1000 in\n" +
        "    let _u2 = lock_release(2) in\n" +
        "    let _u1 = lock_release(1) in\n" +
        "    res\n" +
        "fn run_pipeline() =\n" +
        "    let _g1 = actor_link(0, 1) in\n" +
        "    let _g2 = actor_link(0, 2) in\n" +
        "    let _g3 = actor_link(1, 3) in\n" +
        "    let _g4 = actor_link(2, 3) in\n" +
        "    let m1 = {v: 42} in\n" +
        "    let hop1 = chan_send_linear(1, m1) in\n" +
        "    let m2 = {v: critical_step(hop1.payload.v)} in\n" +
        "    let hop2 = chan_send_linear(2, m2) in\n" +
        "    hop2.payload.v\n" +
        "print run_pipeline()\n") in
    let v2 = cg_expect_run(root, tmp, "valid_branch_linear_move", "77",
        "fn chan_send_linear(ch, x) = x\n" +
        "fn route(flag) =\n" +
        "    let pkt = {code: 77} in\n" +
        "    if flag == 1 then (chan_send_linear(1, pkt)).code else (chan_send_linear(2, pkt)).code\n" +
        "print route(1)\n") in
    v1 + v2

## 4. In-process SPSC ring-buffer wraparound stress & DAG runtime check
fn cg_spsc_stress_loop(ring, i, n, acc) =
    if i >= n then {ring: ring, acc: acc}
    else
        let p = spsc_ring_push(ring, i * 3 + 1) in
        if p.ok != 1 then ctfail("concurrency gate failed: SPSC push failed at step " + str(i) + "\n")
        else
            let g = spsc_ring_pop(p.ring) in
            if g.ok != 1 or g.val != i * 3 + 1 then ctfail("concurrency gate failed: SPSC FIFO mismatch at step " + str(i) + "\n")
            else cg_spsc_stress_loop(g.ring, i + 1, n, acc + g.val)

fn cg_check_inproc_spsc_and_dag() =
    let r0 = spsc_ring_new(8) in
    let st = cg_spsc_stress_loop(r0, 0, 256, 0) in
    if spsc_ring_occupancy(st.ring.head, st.ring.tail, 8) != 0 then
        ctfail("concurrency gate failed: SPSC occupancy non-zero after balanced 256 wraparound cycles\n")
    else if spsc_ring_free_slots(st.ring.head, st.ring.tail, 8) != 7 then
        ctfail("concurrency gate failed: SPSC conservation law violated after wraparound\n")
    else
        let ok_dag = dag_graph_acyclic_ok(Cons({a: 0, b: 1}, Cons({a: 1, b: 3}, Cons({a: 0, b: 2}, Cons({a: 2, b: 3}, Nil))))) in
        let cyc_dag = dag_graph_acyclic_ok(Cons({a: 0, b: 1}, Cons({a: 1, b: 2}, Cons({a: 2, b: 0}, Nil)))) in
        let tok = linear_msg_pack(12, 7) in
        let val = linear_msg_consume(1, tok) in
        let rel = linear_token_relinquish(1) in
        if ok_dag != 1 or cyc_dag != 0 or val != 12 * 1024 + 8 or rel != 0 then
            ctfail("concurrency gate failed: DAG or linear token invariant mismatch\n")
        else 4

## 5. Multi-worker concurrent execution stress across 6 and 8 native Lume ELF64 worker processes
fn cg_build_worker_elf(root, tmp) =
    let wsrc =
        "fn w_parse_neg(s, i, n, acc) = if i >= n then acc else w_parse_neg(s, i + 1, n, acc * 10 - (ord(at(s, i)) - 48))\n" +
        "fn w_parse(s) = 0 - w_parse_neg(s, 0, count(s), 0)\n" +
        "fn w_kernel(lo: int, hi: int, acc: int) -> int = if lo >= hi then acc else w_kernel(lo + 1, hi, acc + (lo * lo + 3 * lo + 7))\n" +
        "let lo = if os_arg_count() >= 2 then w_parse(os_arg_at(1)) else 0\n" +
        "let hi = if os_arg_count() >= 3 then w_parse(os_arg_at(2)) else 0\n" +
        "print w_kernel(lo, hi, 0)\n" in
    let c = cg_compile_inline(root, tmp, "conc_worker", wsrc) in
    if c.exit_code != 0 then ctfail("concurrency gate failed: worker compile error: " + c.err + "\n")
    else
        let elf = tmp + "/conc_worker.elf" in
        let ast = cg_wait_exit(cg_run(root + "/build/bin/lasm", Cons("--strict", Cons(c.asm_path, Nil)), elf)) in
        if ast != 0 then ctfail("concurrency gate failed: worker lasm error\n")
        else
            let ch = cg_run("/bin/chmod", Cons("+x", Cons(elf, Nil)), elf + ".chmod") in
            elf

fn cg_check_parallel_workers(root, tmp) =
    let welf = cg_build_worker_elf(root, tmp) in
    let total = 2400 in
    let expected = parallel_ref_kernel(0, total, 0) in
    let parts6 = parallel_make_partitions(total, 6) in
    let parts8 = parallel_make_partitions(total, 8) in
    let r6a = parallel_dispatch_partitions(tmp + "/run6a", welf, parts6) in
    let r6b = parallel_dispatch_partitions(tmp + "/run6b", welf, parts6) in
    let r8a = parallel_dispatch_partitions(tmp + "/run8a", welf, parts8) in
    let r8b = parallel_dispatch_partitions(tmp + "/run8b", welf, parts8) in
    if r6a.ok != 1 or r6b.ok != 1 or r8a.ok != 1 or r8b.ok != 1 then
        ctfail("concurrency gate failed: parallel worker dispatch failed\n")
    else if r6a.workers != 6 or r8a.workers != 8 then
        ctfail("concurrency gate failed: unexpected worker count\n")
    else if r6a.sum != expected or r6b.sum != expected or r8a.sum != expected or r8b.sum != expected then
        ctfail("concurrency gate failed: parallel worker reduction race/mismatch: expected " + str(expected) + ", got " + str(r6a.sum) + " / " + str(r8a.sum) + "\n")
    else if r6a.transcript != r6b.transcript or r8a.transcript != r8b.transcript then
        ctfail("concurrency gate failed: non-deterministic per-partition transcript across concurrent runs\n")
    else 4

## 6. QF_LIA proof & WCET budget verification of `compiler/stage1/lconcurrency.src`
fn cg_check_lconcurrency_proofs(root, tmp) =
    let lconc_path = root + "/compiler/stage1/lconcurrency.src" in
    let src = fs_read_file(lconc_path) in
    let c = cg_compile_inline(root, tmp, "lconcurrency_lib_check", src + "\nprint spsc_ring_advance_slot(3, 4)\n") in
    if c.exit_code != 0 then
        ctfail("concurrency gate failed: lumec failed on lconcurrency.src: " + c.err + "\n")
    else
        let rep = cg_oracle_inline(root, tmp, "lconcurrency_prove", "check", src) in
        let n_proven = cg_count_occ_at(rep, "\"status\":\"proven\"", 0, 0) in
        let n_wcet = cg_count_occ_at(rep, "\"status\":\"budget_checked\"", 0, 0) in
        let n_refuted = cg_count_occ_at(rep, "\"status\":\"refuted\"", 0, 0) in
        let n_rt = cg_count_occ_at(rep, "\"status\":\"runtime_checked\"", 0, 0) in
        if cg_contains(rep, "\"ok\":true") == 0 or cg_contains(rep, "\"diagnostics\":[]") == 0 then
            ctfail("concurrency gate failed: lcaas prove rejected lconcurrency.src: " + slice(rep, 0, 300) + "\n")
        else if n_refuted != 0 or n_rt != 0 then
            ctfail("concurrency gate failed: lconcurrency.src has unproven obligations (refuted=" + str(n_refuted) + ", runtime_checked=" + str(n_rt) + ")\n")
        else if n_proven < 20 or n_wcet < 12 then
            ctfail("concurrency gate failed: expected >=20 proven QF_LIA obligations and >=12 WCET budgets, got proven=" + str(n_proven) + ", wcet=" + str(n_wcet) + "\n")
        else {proven: n_proven, wcet: n_wcet}

fn cg_main(input) =
    let root = cg_root(input) in
    if root == "" then ctfail("concurrency gate requires @root\n")
    else
        let t0 = os_monotonic_ns() in
        let tmp = "/tmp/lume-concurrency-gate." + str(os_getpid()) in
        let mk = cg_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil)), tmp + ".mkdir") in
        let n_e305 = cg_check_e0305(root, tmp) in
        let n_e306 = cg_check_e0306(root, tmp) in
        let n_valid = cg_check_valid_programs(root, tmp) in
        let n_spsc = cg_check_inproc_spsc_and_dag() in
        let n_par = cg_check_parallel_workers(root, tmp) in
        let pr = cg_check_lconcurrency_proofs(root, tmp) in
        let rm = cg_run("/bin/rm", Cons("-rf", Cons(tmp, Cons(tmp + ".mkdir", Cons(tmp + ".mkdir.err", Nil)))), "/tmp/lume-cg-rm." + str(os_getpid())) in
        let rm2 = os_run("/bin/rm", Cons("-f", Cons("/tmp/lume-cg-rm." + str(os_getpid()), Cons("/tmp/lume-cg-rm." + str(os_getpid()) + ".err", Nil)))) in
        let ms = (os_monotonic_ns() - t0) / 1000000 in
        "OK: concurrency gate: " + str(n_e305) + " [E0305] linear-move rejections, " + str(n_e306) + " [E0306] cycle/lock-rank rejections, " + str(n_valid) + " compiled linear pipelines, " + str(n_spsc) + " SPSC/DAG invariants, " + str(n_par) + " multi-worker (6x & 8x ELF64) deterministic barrier runs, " + str(pr.proven) + " QF_LIA obligations + " + str(pr.wcet) + " @bound budgets proven in " + str(ms) + " ms"

print cg_main(readall())
