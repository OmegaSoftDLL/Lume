## realtime_gate.src -- acceptance gate of the hard real-time build options of lumec (Domain #116).
##   printf '@root %s\n' "$PWD" | build/bin/realtime_gate
## What it checks, on every run, with the real build/bin/lumec, lasm, lcaas and lume_driver:
##   1. `@no_alloc` rejections ([E0210], exit 3, no assembly, the same code from the lcaas oracle): a record, a
##      constructor with fields, an allocating builtin, a callee that is not `@no_alloc` (the property is transitive),
##      a parameter without proven bounds (a boxed argument would make every operation allocate), an untyped
##      signature, a recursive call that is not in tail position (unbounded stack).
##   2. `@no_alloc` kernels that are accepted run and MEASURE zero allocations: the program reads `heap_stats()`
##      around 200000 calls of three `@no_alloc` functions (branching, multiplication under proven bounds, a tail
##      recursion of depth 100000) and the allocation counter must move by exactly the one record `heap_stats()`
##      itself returns. A control loop that builds a list must move the same counter by at least its length, so a
##      counter that does not count cannot pass.
##   3. `--keep-proven-checks` / `--critical`: the default build elides the run-time check of a proven `ensures`,
##      the two flags keep it (same bytes for both spellings), the program computes the same value either way, and
##      the `requires` check traps in all three builds.
##   4. (Wave 14) Worst-case stack depth in bytes: build/bin/lstack (compiler/stage1/lstack.src) computes, on the
##      emitted assembly, the exact maximum stack depth of ten `@no_alloc` kernels (three-deep call nest, runtime calls
##      for `/` `%`, inline bit operations, a stack-passed 7th parameter, a tail loop). The same binary is then run with
##      stack painting around each kernel call and the natively measured high-water mark must be <= the static number
##      on every vector and EQUAL to it on the worst-case vectors; mutants of the assembly (larger frame, extra push,
##      deeper callee) must move bound and measurement by exactly the injected bytes; mutants without a bound
##      (non-tail self call, call cycles of 2 and 3, indirect call / jump, unbalanced push, non-constant %rsp, jump out
##      of the function, a trap routine that returns) must be rejected with the right diagnostic.
##   5. (Wave 14) [E0210] at source level: mutual recursion through cycles of length 2 and 3+, a self call hidden
##      behind `let` / a condition / an argument / `or` / `requires` / an unproven `ensures`, a `/` whose quotient can
##      leave the immediate range, and a kept (`--keep-proven-checks`) ensures check that calls a function that is not
##      `@no_alloc` or re-enters the function. The last two were holes of the Wave 12 check, closed in
##      06b_phase3.src (`na_e`, `na_chk_fn`).
##   6. (Wave 14) Latency jitter: min / p50 / p99 / p99.9 / p99.99 / max of one kernel call over 200000 calls, with
##      os_monotonic_ns() and with cpu_rdtsc(), 0 allocations inside the timed loops, the timer overhead measured by an
##      empty region. Section 6 below states the histogram resolution and the two sanity ceilings.
##   7. constant-time kernels (`@secret` + `@no_alloc`, Wave 14): the [C0011] / [E0210] source rules with lcaas parity,
##      zero allocations over 600000 kernel calls, the fail-closed entry guard on a boxed argument, and no ensures
##      check under --keep-proven-checks (see section 7 below).
##   The numbers are also written to build/certification/realtime_gate_summary.json.
## Real level: "zero allocations" is measured on the hosted runtime for the calls made here and is a consequence of
## the static check, not a proof about every path. The stack bound is computed statically on the emitted text and is
## exact for that text, but its "proven paths" form is CONDITIONAL on the [E0210] range proofs (lstack lists every
## slow-path edge it removed and why; over all syntactic paths the bound is "unbounded" whenever a slow path can box);
## trap paths are excluded (the process aborts, and `ctfail` can allocate its message), asynchronous signal frames
## are not modelled, and the native cross-check observes stack WRITES (a reserved slot that is never stored to is
## only seen in the frame-touched build). The latency figures are a measurement on a non-real-time general-purpose
## kernel under a hypervisor: they characterise the generated code and this host, they are NOT a WCET proof, and the
## timer overhead (about the same size as a kernel call) is reported, not subtracted. `@bound` remains the
## cycle-budget check.

fn rg_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else rg_line_end(s, i + 1)
fn rg_get_at(s, key, i) = if i >= count(s) then "" else let e = rg_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else rg_get_at(s, key, e + 1)
fn rg_index(text, part, i) = if i + count(part) > count(text) then 0 - 1 else if slice(text, i, i + count(part)) == part then i else rg_index(text, part, i + 1)
fn rg_has(text, part) = if rg_index(text, part, 0) >= 0 then 1 else 0
fn rg_count(text, part, i, acc) = let j = rg_index(text, part, i) in if j < 0 then acc else rg_count(text, part, j + count(part), acc + 1)
fn rg_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn rg_fail(msg) = ctfail("realtime gate failed: " + msg + "\n")
fn rg_run(bin, args, out) = let st = os_run_capture_timeout(bin, args, out, out + ".err", 120000) in {status: rg_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn rg_input(bin, args, inp, out) = let st = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", 120000) in {status: rg_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn rg_lumec(cfg, name, args, src) = let sp = cfg.tmp + "/" + name + ".src" in let w = fs_write_sync(sp, src) in rg_input(cfg.root + "/build/bin/lumec", args, sp, cfg.tmp + "/" + name + ".s")
fn rg_link(cfg, name) = let a = rg_run(cfg.root + "/build/bin/lasm", Cons("--strict", Cons(cfg.tmp + "/" + name + ".s", Nil)), cfg.tmp + "/" + name + ".elf") in if a.status != 0 then rg_fail("[" + name + "] lasm --strict failed: " + a.err) else os_run("/bin/chmod", Cons("+x", Cons(cfg.tmp + "/" + name + ".elf", Nil)))

## --- 1. [E0210] rejections ----------------------------------------------------------------------------------------
fn rg_reject(cfg, name, phrase, src) = let c = rg_lumec(cfg, name, Nil, src) in if c.status != 3 then rg_fail("[" + name + "] expected lumec exit 3, got " + str(c.status) + ": " + c.err) else if count(c.out) != 0 then rg_fail("[" + name + "] assembly was emitted for a rejected `@no_alloc` function") else if rg_has(c.err, "[E0210]") == 0 or rg_has(c.err, phrase) == 0 then rg_fail("[" + name + "] the diagnostic is not [E0210] with '" + phrase + "': " + c.err) else let ip = cfg.tmp + "/" + name + ".caas.in" in let w = fs_write_sync(ip, "@mode check\n" + src) in let o = rg_input(cfg.root + "/build/bin/lcaas", Nil, ip, cfg.tmp + "/" + name + ".caas.out") in if rg_has(o.out, "E0210") == 0 then rg_fail("[" + name + "] the lcaas oracle does not report E0210: " + slice(o.out, 0, if count(o.out) > 300 then 300 else count(o.out))) else 1
fn rg_rejections(cfg) = rg_reject(cfg, "na_record", "record or closure value", "@no_alloc\nfn r(a: int) -> int requires a >= 0 and a <= 10 = let p = {x: a, y: a} in p.x\nprint r(1)\n") + rg_reject(cfg, "na_constructor", "constructor 'Cons'", "@no_alloc\nfn r(a: int) -> int requires a >= 0 and a <= 10 = match Cons(a, Nil)\n    Nil => 0\n    Cons(h, t) => h\nprint r(1)\n") + rg_reject(cfg, "na_builtin", "call of 'str', which may allocate", "@no_alloc\nfn r(a: int) -> int requires a >= 0 and a <= 10 = count(str(a))\nprint r(1)\n") + rg_reject(cfg, "na_callee", "call of 'helper', which is not `@no_alloc`", "fn helper(a: int) -> int = a + 1\n@no_alloc\nfn r(a: int) -> int requires a >= 0 and a <= 10 = helper(a)\nprint r(1)\n") + rg_reject(cfg, "na_unbounded", "has no proven bounds", "@no_alloc\nfn r(a: int, b: int) -> int = a * b\nprint r(1, 2)\n") + rg_reject(cfg, "na_untyped", "untyped parameters or result", "@no_alloc\nfn r(a) = a + 1\nprint r(1)\n") + rg_reject(cfg, "na_nontail", "non-tail recursive call", "@no_alloc\nfn f(n: int) -> int requires n >= 0 and n <= 1000 = if n == 0 then 0 else 1 + f(n - 1)\nprint f(3)\n")

## --- 2. accepted kernels: measured allocations --------------------------------------------------------------------
fn rg_kernels() = "@no_alloc\nfn clampi(x: int, lo: int, hi: int) -> int requires lo >= 0 - 1000000 and hi <= 1000000 and lo <= hi and x >= 0 - 1000000000 and x <= 1000000000 ensures result >= lo and result <= hi = if x < lo then lo else if x > hi then hi else x\n@no_alloc\nfn step(a: int, b: int) -> int requires a >= 0 and a <= 1000 and b >= 0 and b <= 1000 ensures result >= 0 = a * b + 7\n@no_alloc\nfn sumto(n: int, acc: int) -> int requires n >= 0 and n <= 100000 and acc >= 0 and acc <= 10000000000 = if n == 0 then acc else sumto(n - 1, acc + n)\n"
fn rg_measure_src() = "use arena\n" + rg_kernels() + "fn loop_na(i, acc) = if i == 0 then acc else loop_na(i - 1, (acc + clampi(i, 0, 100) + step(i % 1000, 3)) % 1000003)\nfn boxy(i, acc) = if i == 0 then acc else boxy(i - 1, Cons(i, acc))\nfn len(xs, n) = match xs\n    Nil        => n\n    Cons(h, t) => len(t, n + 1)\nfn allocs_now() = (heap_stats()).allocs\nfn measure() = let a = allocs_now() in let r = loop_na(200000, 0) in let s = sumto(100000, 0) in let b = allocs_now() in let l = boxy(1000, Nil) in let c = allocs_now() in str(b - a) + \" \" + str(r) + \" \" + str(s) + \" \" + str(len(l, 0)) + \" \" + (if c - b >= 1000 then \"control-counted\" else \"control-not-counted\")\nprint measure()\n"
## the same arithmetic computed by the gate itself (no `@no_alloc`), as the expected values
fn rg_clampi(x, lo, hi) = if x < lo then lo else if x > hi then hi else x
fn rg_loop(i, acc) = if i == 0 then acc else rg_loop(i - 1, (acc + rg_clampi(i, 0, 100) + (i % 1000 * 3 + 7)) % 1000003)
fn rg_measure(cfg) = let sp = cfg.tmp + "/measure.src" in let w = fs_write_sync(sp, rg_measure_src()) in let b = rg_run(cfg.root + "/build/bin/lume_driver", Cons("build", Cons(sp, Cons("-o", Cons(cfg.tmp + "/measure.elf", Nil)))), cfg.tmp + "/measure.build") in if b.status != 0 then rg_fail("the measurement program did not build: " + b.out + b.err) else let r = rg_run(cfg.tmp + "/measure.elf", Nil, cfg.tmp + "/measure.out") in let want = "1 " + str(rg_loop(200000, 0)) + " 5000050000 1000 control-counted\n" in if r.status != 0 then rg_fail("the measurement program exited with " + str(r.status) + ": " + r.err) else if r.out != want then rg_fail("allocation measurement: got '" + r.out + "', expected '" + want + "' (first field: allocations across 200000 calls of clampi / step and one sumto of depth 100000; exactly 1 is the record heap_stats() returns)") else 1
fn rg_proofs(cfg) = let sp = cfg.tmp + "/kernels.src" in let w = fs_write_sync(sp, rg_kernels() + "print step(2, 3)\n") in let o = rg_input(cfg.root + "/build/bin/lcaas", Nil, sp, cfg.tmp + "/kernels.prove") in if o.status != 0 or rg_has(o.out, "\"status\":\"refuted\"") == 1 or rg_has(o.out, "\"name\":\"step\",\"kind\":\"contract\",\"status\":\"proven\"") == 0 or rg_has(o.out, "\"name\":\"clampi\",\"kind\":\"contract\",\"status\":\"proven\"") == 0 then rg_fail("the contracts of the `@no_alloc` kernels `clampi` and `step` are not proven: " + slice(o.out, 0, if count(o.out) > 400 then 400 else count(o.out)) + o.err) else rg_count(o.out, "\"status\":\"proven\"", 0, 0)

## --- 3. --keep-proven-checks / --critical ------------------------------------------------------------------------------
fn rg_kp_src() = "fn kp(x: int) -> int requires x >= 0 and x <= 100 ensures result >= x = x + 1\nprint kp(toint(os_arg_at(1)))\n"
fn rg_kp_msg() = "runtime contract violation (ensures) in 'kp'"
fn rg_kp_run(cfg, name, arg) = rg_run(cfg.tmp + "/" + name + ".elf", Cons(arg, Nil), cfg.tmp + "/" + name + ".run")
fn rg_kp_one(cfg, name) = let l = rg_link(cfg, name) in let ok = rg_kp_run(cfg, name, "5") in let bad = rg_kp_run(cfg, name, "101") in if ok.status != 0 or ok.out != "6\n" then rg_fail("[" + name + "] kp(5) gave status " + str(ok.status) + " and '" + ok.out + "'") else if bad.status == 0 or bad.status >= 128 or rg_has(bad.err, "runtime contract violation (requires) in 'kp'") == 0 then rg_fail("[" + name + "] kp(101) did not stop on its requires check: status " + str(bad.status) + " " + bad.err) else 1
fn rg_keep_proven(cfg) = let p = rg_lumec(cfg, "kp_default", Nil, rg_kp_src()) in let k = rg_lumec(cfg, "kp_keep", Cons("--keep-proven-checks", Nil), rg_kp_src()) in let c = rg_lumec(cfg, "kp_critical", Cons("--critical", Nil), rg_kp_src()) in if p.status != 0 or k.status != 0 or c.status != 0 then rg_fail("lumec rejected the keep-proven fixture: " + p.err + k.err + c.err) else if rg_has(p.out, rg_kp_msg()) == 1 then rg_fail("the default build still carries the run-time check of the proven ensures of kp (nothing to keep)") else if rg_has(k.out, rg_kp_msg()) == 0 then rg_fail("--keep-proven-checks did not keep the run-time check of the proven ensures of kp") else if c.out != k.out then rg_fail("--critical and --keep-proven-checks emit different assembly") else if count(k.out) <= count(p.out) then rg_fail("the kept check added no code") else rg_kp_one(cfg, "kp_default") + rg_kp_one(cfg, "kp_keep") + rg_kp_one(cfg, "kp_critical")

## ====================================================================================================================
## Wave 14 sections 4-6 (stack bound, [E0210] recursion / range holes, latency jitter). Entry point: rg_w14(cfg).
## ====================================================================================================================
## --- text helpers for large texts (`slicen`: no strlen per call) ---------------------------------------------------
fn rg_eol(t, n, i) = if i >= n or at(t, i) == "\n" then i else rg_eol(t, n, i + 1)
fn rg_find(t, n, p, m, i) = if i + m > n then 0 - 1 else if at(t, i) != at(p, 0) then rg_find(t, n, p, m, i + 1) else if slicen(t, n, i, i + m) == p then i else rg_find(t, n, p, m, i + 1)
fn rg_pos(t, p, i) = rg_find(t, count(t), p, count(p), i)
fn rg_in(t, p) = if rg_pos(t, p, 0) >= 0 then 1 else 0
fn rg_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => rg_rev(t, Cons(h, acc))
fn rg_pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => rg_pairs2(a, t)
fn rg_pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, rg_pairs(r))
fn rg_nil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn rg_one(xs) = match xs
    Nil        => 1
    Cons(h, t) => rg_nil(t)
fn rg_join(xs) = match xs
    Nil        => ""
    Cons(a, t) => if rg_one(xs) == 1 then a else rg_join(rg_pairs(xs))
fn rg_sep(xs, sep) = match xs
    Nil        => Nil
    Cons(a, t) => if rg_one(xs) == 1 then Cons(a, Nil) else Cons(a, Cons(sep, rg_sep(t, sep)))
fn rg_digits(s, n, i, acc) = if i < n and at(s, i) >= "0" and at(s, i) <= "9" then rg_digits(s, n, i + 1, acc * 10 + ord(at(s, i)) - 48) else acc
fn rg_wend(l, n, i) = if i >= n or at(l, i) == " " then i else rg_wend(l, n, i + 1)
fn rg_wd_at(l, n, i, k) = let e = rg_wend(l, n, i) in if k == 0 then slice(l, i, e) else if e >= n then "" else rg_wd_at(l, n, e + 1, k - 1)
fn rg_wd(l, k) = rg_wd_at(l, count(l), 0, k)
fn rg_wn(l, k) = let w = rg_wd(l, k) in if w == "" then 0 - 1 else toint(w)
## the output line that starts with `label `
fn rg_row(out, label) = let s = "\n" + out in let p = rg_pos(s, "\n" + label + " ", 0) in if p < 0 then "" else slice(s, p + 1, rg_eol(s, count(s), p + 1))
## a routine of the emitted text: from its label to the next global label
fn rg_fn_lo(t, nm) = let p = rg_pos(t, "\n" + nm + ":\n", 0) in if p < 0 then rg_fail("no routine '" + nm + "' in the emitted assembly") else p + 1
fn rg_fn_hi(t, n, i) = if i >= n then n else let c = at(t, i) in if c != " " and c != "\n" and (c != "." or at(t, i + 1) != "L") then i else rg_fn_hi(t, n, rg_eol(t, n, i) + 1)
fn rg_fn_text(t, nm) = let n = count(t) in let lo = rg_fn_lo(t, nm) in slicen(t, n, lo, rg_fn_hi(t, n, rg_eol(t, n, lo) + 1))
## replace the first occurrence of `old` inside routine `fnm`
fn rg_mut(t, fnm, old, neu) = let n = count(t) in let lo = rg_fn_lo(t, fnm) in let hi = rg_fn_hi(t, n, rg_eol(t, n, lo) + 1) in let p = rg_find(t, hi, old, count(old), lo) in if p < 0 then rg_fail("mutation site '" + old + "' not found in '" + fnm + "'") else slicen(t, n, 0, p) + neu + slicen(t, n, p + count(old), n)

## --- 4. static worst-case stack bound (build/bin/lstack) against the natively measured high-water mark -------------
## The kernels: the three of section 2, a leaf whose deepest point is a runtime call (`/`, `%`), a three-deep nest
## qtop -> qmid -> qleaf with temporaries pushed across the calls, the inline bit operations, and a 7-parameter
## function (one stack-passed argument) with its caller.
fn rg_st_kernels() = rg_kernels() + "@no_alloc\nfn qleaf(a: int, b: int) -> int requires a >= 0 and a <= 1000 and b >= 1 and b <= 1000 ensures result >= 0 and result <= 2000 = a / b + a % b\n@no_alloc\nfn qsel(a: int, b: int) -> int requires a >= 0 and a <= 2100000 and b >= 0 and b <= 2100000 ensures result >= 0 and result <= 2100000 = if a < b then a else b\n@no_alloc\nfn qmid(a: int, b: int) -> int requires a >= 0 and a <= 1000 and b >= 1 and b <= 1000 ensures result >= 0 and result <= 2100000 = qsel(a + b, qsel(a * b, qleaf(a, b)))\n@no_alloc\nfn qtop(x: int) -> int requires x >= 1 and x <= 5 = let y = qmid(x, x) in let c = clampi(y, 0, 100) in if (x * 3) < qmid(c + 1, x) then x + x * c else 0 - x\n@no_alloc\nfn bits(a: int, b: int) -> int requires a >= 0 and a <= 1000 and b >= 1 and b <= 1000 = bit_xor(bit_and(a, b), bit_or(bit_shl(a, 2), bit_shr(bit_not(a), 1)))\n@no_alloc\nfn wide(a: int, b: int, c: int, d: int, e: int, f: int, g: int) -> int requires a >= 0 and a <= 10 and b >= 0 and b <= 10 and c >= 0 and c <= 10 and d >= 0 and d <= 10 and e >= 0 and e <= 10 and f >= 0 and f <= 10 and g >= 1 and g <= 10 = a + (b + (c + (d + (e + (f + g)))))\n@no_alloc\nfn wcall(x: int) -> int requires x >= 1 and x <= 5 = let w = wide(x, x, x, x, x, x, x + 1) in if w == 8 then 1 else 0\n"
fn rg_k(nm, ps) = {nm: nm, ps: ps}
fn rg_st_ks() = Cons(rg_k("clampi", "x, lo, hi"), Cons(rg_k("step", "a, b"), Cons(rg_k("sumto", "n, acc"), Cons(rg_k("qleaf", "a, b"), Cons(rg_k("qsel", "a, b"), Cons(rg_k("qmid", "a, b"), Cons(rg_k("qtop", "x"), Cons(rg_k("bits", "a, b"), Cons(rg_k("wide", "a, b, c, d, e, f, g"), Cons(rg_k("wcall", "x"), Nil))))))))))
## test vectors: a tag that starts with `w` marks a vector that executes the deepest path of its kernel
fn rg_v(k, tag, args) = {k: k, tag: tag, args: args}
fn rg_st_vs() = Cons(rg_v("clampi", "w", "5, 0, 3"), Cons(rg_v("clampi", "w2", "2, 0, 3"), Cons(rg_v("clampi", "w3", "0 - 7, 0, 3"), Cons(rg_v("step", "w", "3, 4"), Cons(rg_v("step", "w2", "1000, 1000"), Cons(rg_v("sumto", "n0", "0, 0"), Cons(rg_v("sumto", "w", "1, 0"), Cons(rg_v("sumto", "w100000", "100000, 0"), Cons(rg_v("qleaf", "w", "7, 2"), Cons(rg_v("qleaf", "w2", "1000, 1"), Cons(rg_v("qsel", "w", "1, 2"), Cons(rg_v("qsel", "w2", "2, 1"), Cons(rg_v("qmid", "w", "7, 2"), Cons(rg_v("qtop", "w", "2"), Cons(rg_v("qtop", "w2", "5"), Cons(rg_v("qtop", "w3", "1"), Cons(rg_v("bits", "w", "5, 3"), Cons(rg_v("wide", "w", "1, 2, 3, 4, 5, 6, 7"), Cons(rg_v("wcall", "w", "1"), Cons(rg_v("wcall", "w2", "5"), Nil))))))))))))))))))))
fn rg_st_drivers(ks) = match ks
    Nil        => Nil
    Cons(k, t) => Cons("fn dr_" + k.nm + "(" + k.ps + ") = " + k.nm + "(" + k.ps + ")\n", rg_st_drivers(t))
fn rg_st_shows(vs) = match vs
    Nil        => Nil
    Cons(v, t) => Cons("show(\"" + v.k + ":" + v.tag + "\", dr_" + v.k + "(" + v.args + "))", rg_st_shows(t))
fn rg_len(xs, n) = match xs
    Nil        => n
    Cons(h, t) => rg_len(t, n + 1)
## the measurement program: every kernel is called through `dr_<kernel>`; the word at static_arena_addr() receives the
## high-water mark, the next word the number of scans (both stay 0 in the uninstrumented build)
fn rg_st_src() = rg_st_kernels() + "fn hw_take() = let a = static_arena_addr() in let v = mmio_volatile_read64(a) in let z = mmio_volatile_write64(a, 0) in v\nfn hw_scans() = mmio_volatile_read64(static_arena_addr() + 8)\nfn show(nm, r) = nm + \" \" + str(r) + \" \" + str(hw_take()) + \"\\n\"\n" + rg_join(rg_st_drivers(rg_st_ks())) + "print " + rg_join(rg_sep(rg_st_shows(rg_st_vs()), " + ")) + "\nprint \"scans \" + str(hw_scans()) + \" 0\"\n"
## Stack painting (test-only assembly, appended to the emitted text). `__stk_paint` runs just before the `call` of the
## kernel: it fills the 4096 bytes below the return-address slot of the coming call with a sentinel word (only %r10 /
## %r11 are used: the argument registers and the stack arguments are untouched). `__stk_scan` runs just after the
## kernel returned: it walks up from the lowest painted word to the first word that no longer holds the sentinel; the
## distance from there to the kernel's entry %rsp is the number of bytes the kernel (and everything it called) wrote
## below its entry %rsp. It keeps the maximum in the first word of the static arena and counts the scans in the second.
fn rg_st_paint() = 4096
fn rg_st_asm() = "    .section .text\n__stk_paint:\n    leaq -8(%rsp), %r10\n    leaq -" + str(rg_st_paint() + 8) + "(%rsp), %r11\n.Lstk_p1:\n    movq $1515870810, (%r10)\n    subq $8, %r10\n    cmpq %r11, %r10\n    jg .Lstk_p1\n    ret\n__stk_scan:\n    leaq -" + str(rg_st_paint()) + "(%rsp), %r10\n.Lstk_s1:\n    cmpq %rsp, %r10\n    jge .Lstk_s2\n    cmpq $1515870810, (%r10)\n    jne .Lstk_s2\n    addq $8, %r10\n    jmp .Lstk_s1\n.Lstk_s2:\n    movq %rsp, %r11\n    subq %r10, %r11\n    incq .Lrt_static_arena+8(%rip)\n    cmpq .Lrt_static_arena(%rip), %r11\n    jle .Lstk_s3\n    movq %r11, .Lrt_static_arena(%rip)\n.Lstk_s3:\n    ret\n"
fn rg_st_instr(t, ks) = match ks
    Nil        => t + rg_st_asm()
    Cons(k, r) => rg_st_instr(rg_mut(t, "dr_" + k.nm, "    call " + k.nm + "\n", "    call __stk_paint\n    call " + k.nm + "\n    call __stk_scan\n"), r)
## Frame touch (test-only): painting sees WRITES, and a frame can end in a slot the function never stores to (frames
## are rounded to 16 bytes). After every `subq $N, %rsp` of a kernel a store to the new stack top is inserted, so the
## whole %rsp excursion becomes visible and the measured mark can be compared with the bound itself. The slot is
## either unused or written before it is read, and `movq` leaves the flags alone; the results are compared anyway.
fn rg_is_sub(l) = let m = count(l) in if m > 17 and slice(l, 0, 10) == "    subq $" and slice(l, m - 7, m) == ", %rsp\n" then 1 else 0
fn rg_touch_lines(t, n, i, hi, acc) = if i >= hi then acc else let e = rg_eol(t, n, i) in let l = slicen(t, n, i, e + 1) in rg_touch_lines(t, n, e + 1, hi, if rg_is_sub(l) == 1 then Cons("    movq %rax, (%rsp)\n", Cons(l, acc)) else Cons(l, acc))
fn rg_touch1(t, fnm) = let n = count(t) in let lo = rg_fn_lo(t, fnm) in let hi = rg_fn_hi(t, n, rg_eol(t, n, lo) + 1) in slicen(t, n, 0, lo) + rg_join(rg_rev(rg_touch_lines(t, n, lo, hi, Nil), Nil)) + slicen(t, n, hi, n)
fn rg_st_touch(t, ks) = match ks
    Nil        => t
    Cons(k, r) => rg_st_touch(rg_touch1(t, k.nm), r)
## lstack on a given assembly text; the JSON of one function
fn rg_lstack(cfg, name, asm) = let ap = cfg.tmp + "/" + name + ".s" in let w = fs_write_sync(ap, asm) in let ip = cfg.tmp + "/" + name + ".lstack.in" in let w2 = fs_write_sync(ip, "@root " + cfg.root + "\n@src " + cfg.tmp + "/stack.src\n@asm " + ap + "\n") in rg_input(cfg.root + "/build/bin/lstack", Nil, ip, cfg.tmp + "/" + name + ".lstack.json")
fn rg_jnum(j, nm, key) = let p = rg_pos(j, "{\"name\":\"" + nm + "\",\"status\":\"bounded\"", 0) in if p < 0 then 0 - 1 else let q = rg_pos(j, "\"" + key + "\":", p) in if q < 0 then 0 - 1 else let v = q + count(key) + 3 in if at(j, v) >= "0" and at(j, v) <= "9" then rg_digits(j, count(j), v, 0) else 0 - 1
fn rg_st_bound(j, nm) = rg_jnum(j, nm, "max_stack_bytes_proven_paths")
fn rg_st_written(j, nm) = rg_jnum(j, nm, "max_written_bytes_proven_paths")
fn rg_st_native(cfg, name) = let l = rg_link(cfg, name) in let r = rg_run(cfg.tmp + "/" + name + ".elf", Nil, cfg.tmp + "/" + name + ".out") in if r.status != 0 then rg_fail("[" + name + "] the stack measurement program exited with " + str(r.status) + ": " + r.err) else r.out
fn rg_st_used(out, v) = rg_wn(rg_row(out, v.k + ":" + v.tag), 2)
## every vector: same result as the uninstrumented build, something was measured, measured <= written <= bound, and a
## worst-case vector measures exactly the static "written" number (exact == 1: exactly the bound itself)
fn rg_st_vecs(vs, base, out, j, name, exact) = match vs
    Nil        => 0
    Cons(v, t) => let lb = v.k + ":" + v.tag in let b = rg_row(base, lb) in let m = rg_row(out, lb) in let w = rg_st_written(j, v.k) in let bd = rg_st_bound(j, v.k) in let u = rg_wn(m, 2) in if b == "" or m == "" then rg_fail("[" + name + "] no output row for vector " + lb) else if rg_wd(b, 1) != rg_wd(m, 1) then rg_fail("[" + name + "] vector " + lb + " computes " + rg_wd(m, 1) + " in the instrumented build and " + rg_wd(b, 1) + " in the plain build") else if rg_wn(b, 2) != 0 then rg_fail("[" + name + "] the uninstrumented build reports a non-zero high-water mark for " + lb) else if w <= 0 or bd <= 0 or w > bd then rg_fail("[" + name + "] lstack gave no usable bound for '" + v.k + "' (written " + str(w) + ", bound " + str(bd) + ")") else if u <= 0 or u >= rg_st_paint() then rg_fail("[" + name + "] nothing measured, or the painted region was exhausted, for " + lb + ": " + str(u)) else if u > w then rg_fail("[" + name + "] UNSOUND: vector " + lb + " used " + str(u) + " bytes of stack, the static bound says at most " + str(w) + " written / " + str(bd) + " reserved") else if at(v.tag, 0) == "w" and u != w then rg_fail("[" + name + "] not exact: worst-case vector " + lb + " used " + str(u) + " bytes, the static analysis computed " + str(w)) else if exact == 1 and w != bd then rg_fail("[" + name + "] with every frame touched the written depth of '" + v.k + "' must be its bound: " + str(w) + " != " + str(bd)) else 1 + rg_st_vecs(t, base, out, j, name, exact)
fn rg_st_same_bounds(ks, j0, j1, name) = match ks
    Nil        => 0
    Cons(k, t) => if rg_st_bound(j0, k.nm) != rg_st_bound(j1, k.nm) or rg_st_bound(j1, k.nm) <= 0 then rg_fail("[" + name + "] the bound of '" + k.nm + "' changed: " + str(rg_st_bound(j0, k.nm)) + " -> " + str(rg_st_bound(j1, k.nm))) else 1 + rg_st_same_bounds(t, j0, j1, name)
fn rg_st_eqcount(ks, j, n) = match ks
    Nil        => n
    Cons(k, t) => rg_st_eqcount(t, j, if rg_st_written(j, k.nm) == rg_st_bound(j, k.nm) then n + 1 else n)
## negative control: a mutation of the emitted text must move the bound of the kernels on the mutated path by exactly
## `delta`, must leave the other kernels alone, and the natively measured mark must move by the same amount
fn rg_st_d1(j0, j1, out0, out1, nm, delta, name) = let v = rg_v(nm, "w", "") in if rg_st_bound(j1, nm) - rg_st_bound(j0, nm) != delta then rg_fail("[" + name + "] the bound of '" + nm + "' moved by " + str(rg_st_bound(j1, nm) - rg_st_bound(j0, nm)) + ", the mutation injected " + str(delta)) else if rg_st_written(j1, nm) - rg_st_written(j0, nm) != delta then rg_fail("[" + name + "] the written depth of '" + nm + "' moved by " + str(rg_st_written(j1, nm) - rg_st_written(j0, nm)) + ", the mutation injected " + str(delta)) else if rg_st_used(out1, v) - rg_st_used(out0, v) != delta then rg_fail("[" + name + "] the measured high-water mark of '" + nm + "' moved by " + str(rg_st_used(out1, v) - rg_st_used(out0, v)) + ", the mutation injected " + str(delta)) else 1
fn rg_st_delta(cfg, name, mt, j0, out0, delta) = let o = rg_lstack(cfg, name, mt) in if o.status != 0 then rg_fail("[" + name + "] lstack rejected a mutant that only deepens the stack: " + o.err) else let out1 = rg_st_native(cfg, name) in rg_st_d1(j0, o.out, out0, out1, "qleaf", delta, name) + rg_st_d1(j0, o.out, out0, out1, "qmid", delta, name) + rg_st_d1(j0, o.out, out0, out1, "qtop", delta, name) + rg_st_d1(j0, o.out, out0, out1, "clampi", 0, name) + rg_st_d1(j0, o.out, out0, out1, "sumto", 0, name) + rg_st_d1(j0, o.out, out0, out1, "wcall", 0, name)
## negative control: a mutant with no stack bound is rejected (exit 3) for the right function with the right reason
fn rg_st_rej(cfg, name, mt, fnm, phrase) = let o = rg_lstack(cfg, name, mt) in if o.status != 3 then rg_fail("[" + name + "] lstack must reject this mutant with exit 3, got " + str(o.status) + ": " + o.err) else if rg_in(o.out, "{\"name\":\"" + fnm + "\",\"status\":\"rejected\"") == 0 then rg_fail("[" + name + "] the report does not mark '" + fnm + "' rejected") else if rg_in(o.err, "lstack: rejected '" + fnm + "': ") == 0 or rg_in(o.err, phrase) == 0 then rg_fail("[" + name + "] the diagnostic for '" + fnm + "' does not say '" + phrase + "': " + slice(o.err, 0, if count(o.err) > 600 then 600 else count(o.err))) else 1
fn rg_st_rejs(cfg, t) = rg_st_rej(cfg, "x_selfcall", rg_mut(t, "sumto", "    jmp .Ltail_sumto\n", "    call sumto\n"), "sumto", "call cycle sumto -> sumto (self recursion that is not a tail jump)") + rg_st_rej(cfg, "x_cycle2", rg_mut(t, "qleaf", "    call __rt_mod\n", "    call qmid\n"), "qleaf", "call cycle qleaf -> qmid -> qleaf (mutual recursion)") + rg_st_rej(cfg, "x_cycle3", rg_mut(t, "qleaf", "    call __rt_mod\n", "    call qtop\n"), "qleaf", "call cycle qleaf -> qtop -> qmid -> qleaf (mutual recursion)") + rg_st_rej(cfg, "x_cycle3_top", rg_mut(t, "qleaf", "    call __rt_mod\n", "    call qtop\n"), "qtop", "call cycle") + rg_st_rej(cfg, "x_indirect", rg_mut(t, "qleaf", "    call __rt_mod\n", "    call *%rax\n"), "qleaf", "indirect call `call *%rax`") + rg_st_rej(cfg, "x_indirect_jmp", rg_mut(t, "sumto", "    jmp .Ltail_sumto\n", "    jmp *%rax\n"), "sumto", "indirect jump `jmp *%rax`") + rg_st_rej(cfg, "x_tail_push", rg_mut(t, "sumto", "    jmp .Ltail_sumto\n", "    pushq %rax\n    jmp .Ltail_sumto\n"), "sumto", "unbalanced stack at a join") + rg_st_rej(cfg, "x_ret_push", rg_mut(t, "qsel", "    popq %rbp\n    ret\n", "    popq %rbp\n    pushq %rax\n    ret\n"), "qsel", "`ret` with 8 bytes still on the stack") + rg_st_rej(cfg, "x_dynamic", rg_mut(t, "clampi", "    movq %rsp, %rbp\n", "    movq %rsp, %rbp\n    subq %rax, %rsp\n"), "clampi", "non-constant stack adjustment `subq %rax, %rsp`") + rg_st_rej(cfg, "x_jump_out", rg_mut(t, "step", "    movq %rbp, %rsp\n", "    jmp .Ltail_clampi\n    movq %rbp, %rsp\n"), "step", "jump out of the function") + rg_st_rej(cfg, "x_trap_returns", rg_mut(t, "ctfail", "    jz __rt_not_str\n", "    jz __rt_not_str\n    ret\n"), "clampi", "the trap table says it never returns, but a `ret` is reachable")
## the "proven paths" bound is not a list of trusted names: break ONE guard pattern and its slow path is counted again
fn rg_st_guard(cfg, t, j0) = let o = rg_lstack(cfg, "x_guard_cmp", rg_mut(t, "clampi", "    testb $1, %al\n", "    testb $3, %al\n")) in let allp = rg_jnum(j0, "clampi", "max_stack_bytes_all_paths") in if o.status != 0 then rg_fail("[x_guard_cmp] lstack rejected the mutant: " + o.err) else if allp <= rg_st_bound(j0, "clampi") then rg_fail("the all-paths bound of clampi (" + str(allp) + ") is not above its proven-paths bound (" + str(rg_st_bound(j0, "clampi")) + ")") else if rg_st_bound(o.out, "clampi") != allp then rg_fail("[x_guard_cmp] with one tag test no longer recognised the proven-paths bound of clampi must be the cmpv slow path (" + str(allp) + "), got " + str(rg_st_bound(o.out, "clampi"))) else let o2 = rg_lstack(cfg, "x_guard_mul", rg_mut(t, "step", "    jo .Lb", "    jc .Lb")) in if o2.status != 0 then rg_fail("[x_guard_mul] lstack rejected the mutant: " + o2.err) else if rg_st_bound(o2.out, "step") <= rg_st_bound(j0, "step") or rg_in(o2.out, "{\"callee\":\"__rt_mul\",\"depth_at_call\":40,\"call_sites\":1,\"on_proven_paths\":true") == 0 then rg_fail("[x_guard_mul] with the overflow test of the multiplication no longer recognised, __rt_mul must be on the proven paths of step and raise its bound above " + str(rg_st_bound(j0, "step")) + ", got " + str(rg_st_bound(o2.out, "step"))) else 2
fn rg_st_report(ks, j, out, outt) = match ks
    Nil        => Nil
    Cons(k, t) => Cons({nm: k.nm, bound: rg_st_bound(j, k.nm), written: rg_st_written(j, k.nm), used: rg_st_used(out, rg_v(k.nm, "w", "")), usedt: rg_st_used(outt, rg_v(k.nm, "w", ""))}, rg_st_report(t, j, out, outt))
fn rg_st_msg(rs) = match rs
    Nil        => Nil
    Cons(r, t) => Cons(r.nm + " " + str(r.bound) + "/" + str(r.used) + "/" + str(r.usedt), rg_st_msg(t))
fn rg_st_json(rs) = match rs
    Nil        => Nil
    Cons(r, t) => Cons("{\"kernel\":\"" + r.nm + "\",\"static_bound_bytes\":" + str(r.bound) + ",\"static_written_bytes\":" + str(r.written) + ",\"measured_high_water_bytes\":" + str(r.used) + ",\"measured_high_water_bytes_frames_touched\":" + str(r.usedt) + "}", rg_st_json(t))
fn rg_stack(cfg) = if fs_path_exists(cfg.root + "/build/bin/lstack") == 0 then rg_fail("build/bin/lstack is missing (./lume build compiler/stage1/lstack.src -o build/bin/lstack)") else let ks = rg_st_ks() in let vs = rg_st_vs() in let c = rg_lumec(cfg, "stack", Nil, rg_st_src()) in if c.status != 0 then rg_fail("lumec rejected the stack kernels: " + c.err) else let base = rg_st_native(cfg, "stack") in let it = rg_st_instr(c.out, ks) in let o = rg_lstack(cfg, "stack_instr", it) in if o.status != 0 then rg_fail("lstack rejected the stack kernels: " + o.out + o.err) else let j = o.out in let out = rg_st_native(cfg, "stack_instr") in let nv = rg_st_vecs(vs, base, out, j, "stack_instr", 0) in if rg_wn(rg_row(out, "scans"), 1) != rg_len(vs, 0) then rg_fail("the instrumented build ran " + rg_wd(rg_row(out, "scans"), 1) + " scans for " + str(rg_len(vs, 0)) + " vectors") else if rg_wn(rg_row(base, "scans"), 1) != 0 then rg_fail("the plain build ran scans") else let sw = fs_write_sync(cfg.tmp + "/stack.self.in", "@root " + cfg.root + "\n@src " + cfg.tmp + "/stack.src\n") in let sf = rg_input(cfg.root + "/build/bin/lstack", Nil, cfg.tmp + "/stack.self.in", cfg.tmp + "/stack.self.json") in if sf.status != 0 or rg_in(sf.out, "\"discharged_by\":\"lumec [E0210] accepted the function") == 0 then rg_fail("lstack on the source alone (it compiles with lumec itself) failed: " + sf.err) else let ns = rg_st_same_bounds(ks, j, sf.out, "stack_self") in let tt = rg_st_touch(it, ks) in let ot = rg_lstack(cfg, "stack_touch", tt) in if ot.status != 0 then rg_fail("lstack rejected the frame-touched build: " + ot.err) else let outt = rg_st_native(cfg, "stack_touch") in let nb = rg_st_same_bounds(ks, j, ot.out, "stack_touch") in let nt = rg_st_vecs(vs, base, outt, ot.out, "stack_touch", 1) in if rg_st_used(out, rg_v("sumto", "w", "")) != rg_st_used(out, rg_v("sumto", "w100000", "")) or rg_st_used(outt, rg_v("sumto", "w100000", "")) != rg_st_bound(j, "sumto") then rg_fail("the tail loop of 100000 iterations does not use the stack of one iteration") else if rg_in(j, "\"frame_reused\":true") == 0 or rg_in(j, "\"frame_reused\":false") == 1 then rg_fail("lstack did not prove the frame reuse of the self tail jump of sumto") else if rg_in(j, "{\"name\":\"qtop\",\"status\":\"bounded\"") == 0 or rg_in(j, "\"max_stack_bytes_all_paths\":\"unbounded\"") == 0 or rg_in(j, "__lume_alloc_a (heap allocator / collector)") == 0 or rg_in(j, "\"assumes\":\"A1 ") == 0 or rg_in(j, "\"assumes\":\"A2 ") == 0 then rg_fail("the lstack report lacks the all-paths / proven-paths distinction or the assumption list") else let d1 = rg_st_delta(cfg, "m_frame", rg_mut(it, "qleaf", "    subq $32, %rsp\n", "    subq $48, %rsp\n"), j, out, 16) in let d2 = rg_st_delta(cfg, "m_push", rg_mut(it, "qleaf", "    call __rt_mod\n", "    pushq %r11\n    call __rt_mod\n    popq %r11\n"), j, out, 8) in let d3 = rg_st_delta(cfg, "m_callee", rg_mut(it, "__rt_mod", "    call __rt_imod\n", "    pushq %r11\n    pushq %r11\n    pushq %r11\n    call __rt_imod\n    popq %r11\n    popq %r11\n    popq %r11\n"), j, out, 24) in let d4 = rg_st_delta(cfg, "m_shallow", rg_mut(it, "qleaf", "    call __rt_div\n", "    pushq %r11\n    call __rt_div\n    popq %r11\n"), j, out, 0) in let rj = rg_st_rejs(cfg, it) in let gd = rg_st_guard(cfg, it, j) in let rs = rg_st_report(ks, j, out, outt) in {msg: "lstack: static worst-case stack bound of " + str(rg_len(ks, 0)) + " @no_alloc kernels against the stack-painted high-water mark of " + str(nv) + " vectors, bytes as static bound/measured/measured with every frame touched: " + rg_join(rg_sep(rg_st_msg(rs), ", ")) + " (measured <= bound on every vector, measured == the statically computed written depth on every worst-case vector, == the bound itself for " + str(rg_st_eqcount(ks, j, 0)) + " kernels as emitted and for all " + str(nb) + " once the frames are touched; a tail loop of 100000 iterations uses the stack of one); 4 stack mutants (frame +16, push +8 on the deepest path, callee +24, push on a shallower path +0) move bound and measurement by exactly the injected bytes; " + str(rj) + " mutants rejected (non-tail self call, call cycles of 2 and 3, indirect call / jump, push before the tail jump, push before ret, non-constant %rsp, jump out of the function, a trap routine that can return); a broken tag test or overflow test brings its slow path (cmpv, __rt_mul) back into the proven-paths bound", json: "[" + rg_join(rg_sep(rg_st_json(rs), ",")) + "]", d: d1 + d2 + d3 + d4 + gd + nt + ns}

## --- 5. [E0210] at source level: recursion cycles, hidden non-tail self calls, `/` range, kept ensures checks ------
fn rg_p1k() = "requires n >= 0 and n <= 1000"
fn rg_rejections2(cfg) = rg_reject(cfg, "na_cycle2", "mutual recursion with 'b'", "@no_alloc\nfn a(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else b(n - 1)\n@no_alloc\nfn b(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else a(n - 1)\nprint a(3)\n") + rg_reject(cfg, "na_cycle3", "mutual recursion with 'b'", "@no_alloc\nfn a(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else b(n - 1)\n@no_alloc\nfn b(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else c(n - 1)\n@no_alloc\nfn c(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else a(n - 1)\nprint a(3)\n") + rg_reject(cfg, "na_cycle3_inner", "mutual recursion with 'c' (unbounded stack) in 'b'", "@no_alloc\nfn a(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else b(n - 1)\n@no_alloc\nfn b(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else c(n - 1)\n@no_alloc\nfn c(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else d(n - 1)\n@no_alloc\nfn d(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else b(n - 1)\nprint a(3)\n") + rg_reject(cfg, "na_self_let", "non-tail recursive call", "@no_alloc\nfn f(n: int) -> int " + rg_p1k() + " = let r = f(n) in r\nprint f(3)\n") + rg_reject(cfg, "na_self_cond", "non-tail recursive call", "@no_alloc\nfn f(n: int) -> int " + rg_p1k() + " = if f(n) == 0 then 1 else 2\nprint f(3)\n") + rg_reject(cfg, "na_self_arg", "non-tail recursive call 'g(...)'", "@no_alloc\nfn g(a: int, b: int) -> int requires a >= 0 and a <= 1000 and b >= 0 and b <= 1000 = if a == 0 then b else g(a - 1, g(a - 1, b))\nprint g(3, 1)\n") + rg_reject(cfg, "na_self_callarg", "non-tail recursive call", "@no_alloc\nfn id(n: int) -> int " + rg_p1k() + " ensures result == n = n\n@no_alloc\nfn f(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else id(f(n - 1))\nprint f(3)\n") + rg_reject(cfg, "na_self_or", "non-tail recursive call", "@no_alloc\nfn f(n: int) -> bool " + rg_p1k() + " = n == 0 or f(n - 1)\nprint f(3)\n") + rg_reject(cfg, "na_self_requires", "non-tail recursive call", "@no_alloc\nfn f(n: int) -> int requires n >= 0 and n <= 1000 and (n == 0 or f(n - 1) == 0) = 0\nprint f(3)\n") + rg_reject(cfg, "na_self_ensures", "an unproven 'ensures' wraps the recursive call", "@no_alloc\nfn f(n: int) -> int " + rg_p1k() + " ensures n >= 0 = if n == 0 then 0 else f(n - 1)\nprint f(3)\n") + rg_reject(cfg, "na_div_range", "'a / b' is not proven to stay inside the 63-bit immediate range", "@no_alloc\nfn qd(a: int, b: int) -> int requires a >= 0 - 4611686018427387903 - 1 and a <= 0 and b >= 0 - 1 and b <= 0 - 1 = a / b\nprint qd(0 - 4, 0 - 1)\n")
## a self call in tail position stays accepted and is a jump in the emitted text, whatever wraps it syntactically
fn rg_tail_ok(cfg, name, src) = let c = rg_lumec(cfg, name, Nil, src) in if c.status != 0 then rg_fail("[" + name + "] a tail-recursive `@no_alloc` function was rejected: " + c.err) else let ft = rg_fn_text(c.out, "f") in if rg_in(ft, "    jmp .Ltail_f\n") == 0 or rg_in(ft, "    call f\n") == 1 then rg_fail("[" + name + "] the self tail call is not lowered to `jmp .Ltail_f`") else 1
fn rg_tails(cfg) = rg_tail_ok(cfg, "tail_paren", "@no_alloc\nfn f(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else (f(n - 1))\nprint f(3)\n") + rg_tail_ok(cfg, "tail_match", "@no_alloc\nfn f(n: int) -> int " + rg_p1k() + " = match n\n    0 => 0\n    _ => f(n - 1)\nprint f(3)\n") + rg_tail_ok(cfg, "tail_let", "@no_alloc\nfn f(n: int) -> int " + rg_p1k() + " = if n == 0 then 0 else let m = n - 1 in f(m)\nprint f(3)\n")
## `--keep-proven-checks` / `--critical` keep the run-time check of a PROVEN ensures: that check is code of the function.
## Before Wave 14 it was not examined, so it could call a function that is not `@no_alloc` or re-enter the function.
fn rg_kept(cfg, name, phrase, callee, src) = let d = rg_lumec(cfg, name + "_default", Nil, src) in let k = rg_lumec(cfg, name + "_keep", Cons("--keep-proven-checks", Nil), src) in let c = rg_lumec(cfg, name + "_critical", Cons("--critical", Nil), src) in if d.status != 0 then rg_fail("[" + name + "] the default build (proven ensures check elided) must be accepted: " + d.err) else if rg_in(rg_fn_text(d.out, "f"), "    call " + callee + "\n") == 1 then rg_fail("[" + name + "] the default build calls '" + callee + "' from the `@no_alloc` function") else if k.status != 3 or c.status != 3 or count(k.out) != 0 or count(c.out) != 0 then rg_fail("[" + name + "] [E0210] hole: with the ensures check kept, `@no_alloc` f calls '" + callee + "' and lumec accepted it (exit " + str(k.status) + " / " + str(c.status) + ")") else if rg_has(k.err, "[E0210]") == 0 or rg_has(k.err, phrase) == 0 or rg_has(c.err, phrase) == 0 then rg_fail("[" + name + "] the diagnostic is not [E0210] with '" + phrase + "': " + k.err) else 1
fn rg_kepts(cfg) = rg_kept(cfg, "kept_callee", "call of 'h', which is not `@no_alloc`", "h", "fn h(x: int) -> int = count(str(x))\n@no_alloc\nfn f(n: int) -> int requires n >= 0 and n <= 100000 ensures h(n) == 0 or result == n = n\nprint f(3)\n") + rg_kept(cfg, "kept_self", "non-tail recursive call 'f(...)'", "f", "@no_alloc\nfn f(n: int) -> int requires n >= 0 and n <= 100000 ensures (n > 0 and f(n - 1) == n + 5) or result == n = n\nprint f(3)\n")

## --- 6. latency jitter of `@no_alloc` kernels ------------------------------------------------------------------------
## What is measured: the wall-clock time of ONE call of a kernel, 200000 times, between two reads of a timer; once with
## os_monotonic_ns() (clock_gettime(CLOCK_MONOTONIC) through a real `syscall`) and once with cpu_rdtsc() (cycles).
## The timed region allocates nothing: the samples go into a fixed histogram in the 64 KiB static arena (raw
## mmio_volatile_read64 / write64, no heap), and heap_stats() around each loop must move by exactly the one record it
## returns itself. Histogram resolution: 4096 bins; a sample below 3072 (ns or cycles) has its own bin, so min / p50 /
## p99 / ... are EXACT order statistics there; from 3072 up the bins are 1024 wide (reported as the upper edge of the
## bin, i.e. rounded up by at most 1023) up to 1050623, and everything above shares the last bin, for which the exact
## max is reported (an upper bound). min and max are tracked exactly on the side, and a percentile is never reported
## above the exact max. Percentile p is the
## ceil(p * n)-th smallest sample. The timer overhead is measured by the same loop with an empty region ("empty") and
## reported; it is NOT subtracted from the kernel rows.
## What it is not: this runs on a general-purpose, non-real-time kernel under a hypervisor (WSL2), on a shared machine.
## It characterises the generated code plus this host at this moment. It is not a WCET bound and proves nothing about
## the worst case; the tail percentiles (p99.99, max) are dominated by preemption and are reported, not asserted.
## Asserted: every loop took exactly n samples, 0 allocations, ordered percentiles, and two ceilings on the
## os_monotonic_ns rows of the kernels: p50 <= 20000 ns and p99 <= 1000000 ns. The region is a few dozen instructions
## plus one timer syscall (well under 1 us on any x86-64 host), so p50 above 20 us means the kernel itself regressed
## pathologically (a system call, a collection or a page fault on every call); p99 above 1 ms would need 2000 of the
## 200000 samples to lose the CPU for a millisecond each, i.e. 2 s of preemption inside a loop that runs for about
## 0.1 s. A control (sumto(2000, 0): 2000 loop iterations inside the region) must read at least 2000 cycles above the
## empty region, so a timer that does not time cannot pass.
fn rg_jit_n() = 200000
fn rg_jit_loop(nm, e) = "fn jn_" + nm + "(i, a) = if i == 0 then 0 else let t0 = os_monotonic_ns() in let r = " + e + " in let t1 = os_monotonic_ns() in let z = hadd(a, t1 - t0) in jn_" + nm + "(i - 1, a)\nfn jc_" + nm + "(i, a) = if i == 0 then 0 else let t0 = cpu_rdtsc() in let r = " + e + " in let t1 = cpu_rdtsc() in let z = hadd(a, t1 - t0) in jc_" + nm + "(i - 1, a)\nfn rn_" + nm + "(a, n) = let z = hreset(a) in let s0 = allocs_now() in let r = jn_" + nm + "(n, a) in let s1 = allocs_now() in report(\"" + nm + "\", \"ns\", n, a, s1 - s0)\nfn rc_" + nm + "(a, n) = let z = hreset(a) in let s0 = allocs_now() in let r = jc_" + nm + "(n, a) in let s1 = allocs_now() in report(\"" + nm + "\", \"cycles\", n, a, s1 - s0)\n"
fn rg_jit_runs(nms, n) = match nms
    Nil        => Nil
    Cons(h, t) => Cons("print rn_" + h + "(static_arena_addr(), " + str(n) + ") + rc_" + h + "(static_arena_addr(), " + str(n) + ")\n", rg_jit_runs(t, n))
fn rg_jit_kernels() = Cons("empty", Cons("clampi", Cons("step", Cons("sumto64", Nil))))
fn rg_jit_src() = "use arena\n" + rg_kernels() + "fn allocs_now() = (heap_stats()).allocs\nfn hz(a, i, n) = if i >= n then 0 else let z = mmio_volatile_write64(a + i * 8, 0) in hz(a, i + 1, n)\nfn hbin(dt) = if dt < 0 then 0 else if dt < 3072 then dt else let k = 3072 + (dt - 3072) / 1024 in if k > 4095 then 4095 else k\nfn hval(b) = if b < 3072 then b else if b >= 4095 then 4000000000000000000 else 3072 + (b - 3071) * 1024 - 1\nfn hadd(a, d0) = let dt = if d0 < 0 then 0 else d0 in let zb = if d0 < 0 then mmio_volatile_write64(a + 24, mmio_volatile_read64(a + 24) + 1) else 0 in let p = a + 128 + hbin(dt) * 8 in let z = mmio_volatile_write64(p, mmio_volatile_read64(p) + 1) in let z2 = if dt > mmio_volatile_read64(a + 8) then mmio_volatile_write64(a + 8, dt) else 0 in if dt < mmio_volatile_read64(a + 16) then mmio_volatile_write64(a + 16, dt) else 0\nfn hrank(a, b, need, cum) = let c = cum + mmio_volatile_read64(a + 128 + b * 8) in if c >= need or b >= 4095 then b else hrank(a, b + 1, need, c)\nfn htotal(a, b, cum) = if b > 4095 then cum else htotal(a, b + 1, cum + mmio_volatile_read64(a + 128 + b * 8))\nfn hpct(a, need) = let v = hval(hrank(a, 0, need, 0)) in let mx = mmio_volatile_read64(a + 8) in if v > mx then mx else v\nfn hreset(a) = let z = hz(a, 0, 4112) in mmio_volatile_write64(a + 16, 4000000000000000000)\nfn report(nm, tm, n, a, allocs) = nm + \" \" + tm + \" \" + str(htotal(a, 0, 0)) + \" \" + str(mmio_volatile_read64(a + 16)) + \" \" + str(hpct(a, (n + 1) / 2)) + \" \" + str(hpct(a, n - n / 100)) + \" \" + str(hpct(a, n - n / 1000)) + \" \" + str(hpct(a, n - n / 10000)) + \" \" + str(mmio_volatile_read64(a + 8)) + \" \" + str(allocs) + \" \" + str(mmio_volatile_read64(a + 24)) + \"\\n\"\n" + rg_jit_loop("empty", "0") + rg_jit_loop("clampi", "clampi(i % 2000 - 500, 0, 100)") + rg_jit_loop("step", "step(i % 1000, 3)") + rg_jit_loop("sumto64", "sumto(64, 0)") + rg_jit_loop("control", "sumto(2000, 0)") + rg_join(rg_jit_runs(rg_jit_kernels(), rg_jit_n())) + "print rn_control(static_arena_addr(), 20000) + rc_control(static_arena_addr(), 20000)\n"
## a row: name timer samples min p50 p99 p99.9 p99.99 max allocations backwards (a negative difference of two timer
## reads is counted and booked as 0; it must not happen with os_monotonic_ns, and is only reported for the TSC)
fn rg_jit_row(out, nm, tm, n, ceil) = let l = rg_row(out, nm + " " + tm) in if l == "" then rg_fail("no jitter row for " + nm + " " + tm) else if rg_wn(l, 2) != n then rg_fail("jitter " + nm + " " + tm + ": the histogram holds " + rg_wd(l, 2) + " samples, expected " + str(n)) else if rg_wn(l, 9) != 1 then rg_fail("jitter " + nm + " " + tm + ": " + rg_wd(l, 9) + " heap allocations inside the timed loop (exactly 1 is the record heap_stats() returns)") else if tm == "ns" and rg_wn(l, 10) != 0 then rg_fail("jitter " + nm + ": os_monotonic_ns() went backwards " + rg_wd(l, 10) + " times") else if rg_wn(l, 3) < 0 or rg_wn(l, 3) > rg_wn(l, 4) or rg_wn(l, 4) > rg_wn(l, 5) or rg_wn(l, 5) > rg_wn(l, 6) or rg_wn(l, 6) > rg_wn(l, 7) or rg_wn(l, 7) > rg_wn(l, 8) then rg_fail("jitter " + nm + " " + tm + ": the percentiles are not ordered: " + l) else if ceil == 1 and rg_wn(l, 4) > 20000 then rg_fail("jitter " + nm + ": p50 of one call is " + rg_wd(l, 4) + " ns, above the 20000 ns sanity ceiling: " + l) else if ceil == 1 and rg_wn(l, 5) > 1000000 then rg_fail("jitter " + nm + ": p99 of one call is " + rg_wd(l, 5) + " ns, above the 1000000 ns sanity ceiling: " + l) else l
fn rg_jit_fmt(l) = rg_wd(l, 0) + " " + rg_wd(l, 1) + " min " + rg_wd(l, 3) + " p50 " + rg_wd(l, 4) + " p99 " + rg_wd(l, 5) + " p99.9 " + rg_wd(l, 6) + " p99.99 " + rg_wd(l, 7) + " max " + rg_wd(l, 8) + " jitter(p99.99-p50) " + str(rg_wn(l, 7) - rg_wn(l, 4))
fn rg_jit_json1(l) = "{\"kernel\":\"" + rg_wd(l, 0) + "\",\"timer\":\"" + rg_wd(l, 1) + "\",\"samples\":" + rg_wd(l, 2) + ",\"min\":" + rg_wd(l, 3) + ",\"p50\":" + rg_wd(l, 4) + ",\"p99\":" + rg_wd(l, 5) + ",\"p99_9\":" + rg_wd(l, 6) + ",\"p99_99\":" + rg_wd(l, 7) + ",\"max\":" + rg_wd(l, 8) + ",\"jitter_p99_99_minus_p50\":" + str(rg_wn(l, 7) - rg_wn(l, 4)) + ",\"heap_allocations_in_timed_loop\":" + str(rg_wn(l, 9) - 1) + ",\"timer_went_backwards\":" + rg_wd(l, 10) + "}"
fn rg_jit_rows(out, nms) = match nms
    Nil        => Nil
    Cons(h, t) => Cons(rg_jit_row(out, h, "ns", rg_jit_n(), if h == "empty" then 0 else 1), Cons(rg_jit_row(out, h, "cycles", rg_jit_n(), 0), rg_jit_rows(out, t)))
fn rg_map_fmt(ls) = match ls
    Nil        => Nil
    Cons(l, t) => Cons(rg_jit_fmt(l), rg_map_fmt(t))
fn rg_map_json(ls) = match ls
    Nil        => Nil
    Cons(l, t) => Cons(rg_jit_json1(l), rg_map_json(t))
fn rg_jitter(cfg) = let sp = cfg.tmp + "/jitter.src" in let w = fs_write_sync(sp, rg_jit_src()) in let b = rg_run(cfg.root + "/build/bin/lume_driver", Cons("build", Cons(sp, Cons("-o", Cons(cfg.tmp + "/jitter.elf", Nil)))), cfg.tmp + "/jitter.build") in if b.status != 0 then rg_fail("the jitter program did not build: " + b.out + b.err) else let r = rg_run(cfg.tmp + "/jitter.elf", Nil, cfg.tmp + "/jitter.out") in if r.status != 0 then rg_fail("the jitter program exited with " + str(r.status) + ": " + r.err) else let rows = rg_jit_rows(r.out, rg_jit_kernels()) in let cn = rg_jit_row(r.out, "control", "ns", 20000, 0) in let cc = rg_jit_row(r.out, "control", "cycles", 20000, 0) in let en = rg_row(r.out, "empty ns") in let ec = rg_row(r.out, "empty cycles") in if rg_wn(cc, 4) < rg_wn(ec, 4) + 2000 then rg_fail("jitter control: 2000 loop iterations inside the timed region read p50 " + rg_wd(cc, 4) + " cycles against " + rg_wd(ec, 4) + " for the empty region: the cycle timer does not time") else if rg_wn(cn, 4) <= rg_wn(en, 4) then rg_fail("jitter control: 2000 loop iterations inside the timed region read p50 " + rg_wd(cn, 4) + " ns against " + rg_wd(en, 4) + " for the empty region: the ns timer does not time") else {msg: "latency of one call over " + str(rg_jit_n()) + " calls per kernel and timer, 0 heap allocations inside every timed loop, exact order statistics below 3072 and 1024-wide bins above (timer overhead = the `empty` rows, not subtracted; a non-real-time kernel under a hypervisor: a measurement of this host, not a WCET bound): " + rg_join(rg_sep(rg_map_fmt(rows), "; ")) + "; control sumto(2000) p50 " + rg_wd(cn, 4) + " ns / " + rg_wd(cc, 4) + " cycles", json: "[" + rg_join(rg_sep(rg_map_json(Cons(cn, Cons(cc, rows))), ",")) + "]"}

fn rg_w14(cfg) = let r2 = rg_rejections2(cfg) in let tl = rg_tails(cfg) in let kd = rg_kepts(cfg) in let st = rg_stack(cfg) in let jt = rg_jitter(cfg) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(cfg.root + "/build/certification", Nil))) in let w = fs_write_sync(cfg.root + "/build/certification/realtime_gate_summary.json", "{\"gate\":\"realtime_gate\",\"stack_unit\":\"bytes below the %rsp at kernel entry\",\"stack\":" + st.json + ",\"jitter_iterations\":" + str(rg_jit_n()) + ",\"jitter_resolution\":\"exact below 3072 (ns or cycles); 1024-wide bins, reported as the upper edge, from 3072 to 1050623; larger samples share one bin, reported as the exact max; min and max exact\",\"jitter_host_note\":\"measured on a non-real-time general-purpose kernel under a hypervisor; it characterises the generated code and this host, it is not a WCET proof\",\"jitter\":" + jt.json + "}\n") in "; " + str(r2) + " more [E0210] rejections (mutual recursion through cycles of 2, 3 and an inner cycle; a self call hidden behind let, a condition, an argument, a callee argument, `or`, a requires clause, an unproven ensures; `/` whose quotient can leave the immediate range), " + str(tl) + " tail forms still lowered to a jump, " + str(kd) + " kept-ensures holes closed (--keep-proven-checks / --critical no longer let a proven ensures call a non-@no_alloc function or re-enter the function); " + st.msg + "; " + jt.msg

## --- 7. constant-time kernels: `@secret` + `@no_alloc` (Wave 14) -------------------------------------------------
## A kernel is lowered to straight-line code on immediate words. The gate checks the source rules through BOTH the
## compiler and the lcaas oracle ([C0011]; an operation that is not proven in range is [E0210]), that 200000 kernel
## calls allocate nothing and compute the values the gate computes itself with ordinary arithmetic, that a kernel
## called with an argument that is not an immediate dies instead of computing (status 139: the load of the entry
## guard faults), and that a proven `ensures` of a kernel emits no check under --keep-proven-checks / --critical
## either (a run-time check would be a branch on a secret), so all three builds are the same bytes.
fn rg_reject_code(cfg, name, code, phrase, src) = let c = rg_lumec(cfg, name, Nil, src) in if c.status != 3 then rg_fail("[" + name + "] expected lumec exit 3, got " + str(c.status) + ": " + c.err) else if count(c.out) != 0 then rg_fail("[" + name + "] assembly was emitted for a rejected constant-time kernel") else if rg_has(c.err, "[" + code + "]") == 0 or rg_has(c.err, phrase) == 0 then rg_fail("[" + name + "] the diagnostic is not [" + code + "] with '" + phrase + "': " + c.err) else let ip = cfg.tmp + "/" + name + ".caas.in" in let w = fs_write_sync(ip, "@mode check\n" + src) in let o = rg_input(cfg.root + "/build/bin/lcaas", Nil, ip, cfg.tmp + "/" + name + ".caas.out") in if rg_has(o.out, "\"code\":\"" + code + "\"") == 0 or rg_has(o.out, phrase) == 0 then rg_fail("[" + name + "] the lcaas oracle does not report " + code + " with '" + phrase + "': " + slice(o.out, 0, if count(o.out) > 400 then 400 else count(o.out))) else 1
fn rg_ct_h() = "@secret\n@no_alloc\n"
fn rg_ct_rejections(cfg) = rg_reject_code(cfg, "ct_requires", "C0011", "a 'requires' clause", rg_ct_h() + "fn k(a: int) -> int requires a >= 0 = bit_and(a, 255)\nprint k(1)\n") + rg_reject_code(cfg, "ct_ensures", "C0011", "an 'ensures' clause that is not proven", rg_ct_h() + "fn k(a: int) -> int ensures result >= 300 = bit_and(a, 255)\nprint k(1)\n") + rg_reject_code(cfg, "ct_shift", "C0011", "'bit_shr' with a shift amount that is not an integer literal", rg_ct_h() + "fn k(a: int, s: int) -> int = bit_shr(a, s)\nprint k(1, 2)\n") + rg_reject_code(cfg, "ct_callee", "C0011", "the call of 'h', which is not a constant-time kernel", "fn h(a: int) -> int = a\n" + rg_ct_h() + "fn k(a: int) -> int = h(a)\nprint k(1)\n") + rg_reject_code(cfg, "ct_recursion", "C0011", "the recursive call 'k(...)'", rg_ct_h() + "fn k(a: int) -> int = k(bit_and(a, 1))\nprint k(1)\n") + rg_reject_code(cfg, "ct_mutual", "C0011", "mutual recursion with 'j'", rg_ct_h() + "fn k(a: int) -> int = j(a)\n" + rg_ct_h() + "fn j(a: int) -> int = k(a)\nprint k(1)\n") + rg_reject_code(cfg, "ct_cond", "C0011", "a conditional expression (`if`), even on public values", rg_ct_h() + "fn k(a: int) -> int = if 1 == 1 then a else 0\nprint k(1)\n") + rg_reject_code(cfg, "ct_compare", "C0011", "the operator '<'", rg_ct_h() + "fn k(a: int, b: int) -> int = bit_and(a, 1) + (a < b)\nprint k(1, 2)\n") + rg_reject_code(cfg, "ct_builtin", "C0011", "the call of 'count'", rg_ct_h() + "fn k(a: int) -> int = count(str(a))\nprint k(1)\n") + rg_reject_code(cfg, "ct_bool", "C0011", "not typed `int`", rg_ct_h() + "fn k(a: bool) -> int = 1\nprint k(true)\n") + rg_reject_code(cfg, "ct_range", "E0210", "'a + b' is not proven to stay inside the 63-bit immediate range", rg_ct_h() + "fn k(a: int, b: int) -> int = a + b\nprint k(1, 2)\n") + rg_reject_code(cfg, "ct_shl_range", "E0210", "'bit_shl(bit_and(a, 4294967295), 40)' is not proven to stay inside the 63-bit immediate range", rg_ct_h() + "fn k(a: int) -> int = bit_shl(bit_and(a, 4294967295), 40)\nprint k(1)\n")
fn rg_ct_kernels() = rg_ct_h() + "fn add32(a: int, b: int) -> int = bit_and(bit_and(a, 4294967295) + bit_and(b, 4294967295), 4294967295)\n" + rg_ct_h() + "fn cswap(mask: int, x: int, y: int) -> int = ct_select(mask, y, x)\n" + rg_ct_h() + "fn eqk(a: int, b: int) -> int = ct_eq(a, b)\n"
fn rg_ct_measure_src() = "use arena\n" + rg_ct_kernels() + "fn lp(i, acc) = if i == 0 then acc else lp(i - 1, add32(acc + eqk(i % 3, 0), cswap(0 - (i % 2), i, 7)))\nfn allocs_now() = (heap_stats()).allocs\nfn measure() = let a = allocs_now() in let r = lp(200000, 0) in let b = allocs_now() in str(b - a) + \" \" + str(r)\nprint measure()\n"
## the same loop with ordinary arithmetic, as the expected value
fn rg_ct_lp(i, acc) = if i == 0 then acc else rg_ct_lp(i - 1, (acc + (if i % 3 == 0 then 1 else 0) + (if i % 2 == 1 then 7 else i)) % 4294967296)
fn rg_ct_measure(cfg) = let sp = cfg.tmp + "/ctmeasure.src" in let w = fs_write_sync(sp, rg_ct_measure_src()) in let b = rg_run(cfg.root + "/build/bin/lume_driver", Cons("build", Cons(sp, Cons("-o", Cons(cfg.tmp + "/ctmeasure.elf", Nil)))), cfg.tmp + "/ctmeasure.build") in if b.status != 0 then rg_fail("the constant-time measurement program did not build: " + b.out + b.err) else let r = rg_run(cfg.tmp + "/ctmeasure.elf", Nil, cfg.tmp + "/ctmeasure.out") in let want = "1 " + str(rg_ct_lp(200000, 0)) + "\n" in if r.status != 0 then rg_fail("the constant-time measurement program exited with " + str(r.status) + ": " + r.err) else if r.out != want then rg_fail("constant-time kernels: got '" + r.out + "', expected '" + want + "' (first field: allocations across 600000 kernel calls; exactly 1 is the record heap_stats() returns)") else 1
fn rg_ct_guard(cfg) = let c = rg_lumec(cfg, "ctguard", Nil, rg_ct_kernels() + "print add32(toint(os_arg_at(1)), 1)\n") in if c.status != 0 then rg_fail("lumec rejected the guard fixture: " + c.err) else let l = rg_link(cfg, "ctguard") in let ok = rg_run(cfg.tmp + "/ctguard.elf", Cons("5", Nil), cfg.tmp + "/ctguard.run") in let top = rg_run(cfg.tmp + "/ctguard.elf", Cons("4611686018427387903", Nil), cfg.tmp + "/ctguard.run") in let boxed = rg_run(cfg.tmp + "/ctguard.elf", Cons("4611686018427387904", Nil), cfg.tmp + "/ctguard.run") in if ok.status != 0 or ok.out != "6\n" then rg_fail("add32(5, 1) gave status " + str(ok.status) + " and '" + ok.out + "'") else if top.status != 0 or top.out != "0\n" then rg_fail("add32(2^62 - 1, 1) gave status " + str(top.status) + " and '" + top.out + "'") else if boxed.status != 139 or count(boxed.out) != 0 then rg_fail("a kernel called with the boxed argument 2^62 did not die on its entry guard: status " + str(boxed.status) + ", stdout '" + boxed.out + "'") else 1
fn rg_ct_kp_src() = rg_ct_h() + "fn kq(a: int) -> int ensures result >= 0 and result <= 255 = bit_and(a, 255)\nprint kq(toint(os_arg_at(1)))\n"
fn rg_ct_keep(cfg) = let p = rg_lumec(cfg, "ctkp_default", Nil, rg_ct_kp_src()) in let k = rg_lumec(cfg, "ctkp_keep", Cons("--keep-proven-checks", Nil), rg_ct_kp_src()) in let c = rg_lumec(cfg, "ctkp_critical", Cons("--critical", Nil), rg_ct_kp_src()) in if p.status != 0 or k.status != 0 or c.status != 0 then rg_fail("lumec rejected the kernel with a proven ensures: " + p.err + k.err + c.err) else if k.out != p.out or c.out != p.out then rg_fail("--keep-proven-checks / --critical changed the code of a constant-time kernel (a kept ensures check would branch on a secret)") else if rg_has(p.out, "(ensures) in 'kq'") == 1 then rg_fail("the kernel kq carries a run-time ensures check") else let l = rg_link(cfg, "ctkp_keep") in let r = rg_run(cfg.tmp + "/ctkp_keep.elf", Cons("300", Nil), cfg.tmp + "/ctkp_keep.run") in if r.status != 0 or r.out != "44\n" then rg_fail("kq(300) gave status " + str(r.status) + " and '" + r.out + "'") else 1
## the bit facts the prover gained with the kernels (06b_phase3.src vct_bit_hyps): bounds that hold are proven, bounds
## that do not hold are NOT proven (refuted with a counterexample where the evaluator reaches one, otherwise left to a
## run-time check) -- a rule that proved a false bound would make a kernel emit unchecked wrong code
fn rg_ct_proof_src() = "fn m32(a: int, b: int) -> int ensures result >= 0 and result <= 8589934590 = bit_and(a, 4294967295) + bit_and(b, 4294967295)\nfn x8(a: int, b: int) -> int ensures result >= 0 and result <= 255 = bit_xor(bit_and(a, 255), bit_and(b, 255))\nfn o16(a: int, b: int) -> int ensures result >= 0 and result <= 65535 = bit_or(bit_and(a, 65535), bit_and(b, 4095))\nfn e1(a: int, b: int) -> int ensures result >= 0 and result <= 1 = ct_eq(a, b)\nfn s8(m: int, a: int, b: int) -> int ensures result >= 0 and result <= 255 = ct_select(m, bit_and(a, 255), bit_and(b, 255))\nfn bad1(a: int) -> int ensures result <= 254 = bit_and(a, 255)\nfn bad2(a: int, b: int) -> int ensures result <= 255 = bit_or(bit_and(a, 255), b)\nfn bad3(a: int, b: int) -> int ensures result == 1 = ct_eq(a, b)\nfn bad4(m: int, a: int, b: int) -> int ensures result <= 255 = ct_select(m, bit_and(a, 255), b)\nfn bad5(a: int, b: int) -> int ensures result <= 255 = bit_xor(bit_and(a, 255), bit_and(b, 511))\nfn bad6(a: int) -> int ensures result >= 0 = bit_and(a, 0 - 256)\nprint m32(1, 2)\n"
fn rg_ct_st(out, nm, st) = rg_has(out, "\"name\":\"" + nm + "\",\"kind\":\"contract\",\"status\":\"" + st + "\"")
fn rg_ct_proofs(cfg) = let sp = cfg.tmp + "/ctproofs.src" in let w = fs_write_sync(sp, rg_ct_proof_src()) in let o = rg_input(cfg.root + "/build/bin/lcaas", Nil, sp, cfg.tmp + "/ctproofs.out") in if rg_ct_st(o.out, "m32", "proven") == 0 or rg_ct_st(o.out, "x8", "proven") == 0 or rg_ct_st(o.out, "o16", "proven") == 0 or rg_ct_st(o.out, "e1", "proven") == 0 or rg_ct_st(o.out, "s8", "proven") == 0 then rg_fail("a true bit bound is not proven (bit_and mask, xor / or of masked values, ct_eq, ct_select): " + slice(o.out, 0, if count(o.out) > 600 then 600 else count(o.out)) + o.err) else if rg_ct_st(o.out, "bad1", "refuted") == 0 or rg_ct_st(o.out, "bad3", "refuted") == 0 then rg_fail("a false bit bound with a small counterexample is not refuted (bad1: bit_and(a, 255) <= 254; bad3: ct_eq(a, b) == 1)") else if rg_ct_st(o.out, "bad2", "proven") == 1 or rg_ct_st(o.out, "bad4", "proven") == 1 or rg_ct_st(o.out, "bad5", "proven") == 1 or rg_ct_st(o.out, "bad6", "proven") == 1 or rg_ct_st(o.out, "bad1", "proven") == 1 or rg_ct_st(o.out, "bad3", "proven") == 1 then rg_fail("UNSOUND: a false bit bound is reported proven") else if rg_ct_st(o.out, "bad2", "runtime_checked") == 0 or rg_ct_st(o.out, "bad4", "runtime_checked") == 0 or rg_ct_st(o.out, "bad5", "runtime_checked") == 0 or rg_ct_st(o.out, "bad6", "runtime_checked") == 0 then rg_fail("a false bit bound is neither refuted nor left to a run-time check") else 11
fn rg_ct(cfg) = let rj = rg_ct_rejections(cfg) in let pf = rg_ct_proofs(cfg) in let ms = rg_ct_measure(cfg) in let gd = rg_ct_guard(cfg) in let kp = rg_ct_keep(cfg) in "constant-time kernels (@secret + @no_alloc): " + str(rj) + " source rejections with lumec / lcaas parity (10 [C0011]: requires, unproven ensures, variable shift, call of a non-kernel, recursion, mutual recursion, conditional, comparison, builtin, non-int parameter; 2 [E0210]: sum and shift not proven in range); " + str(pf) + " bit-bound contracts through the prover (5 true bounds proven; 6 false bounds not proven: 2 refuted with a counterexample, 4 left to a run-time check); 600000 kernel calls with 0 heap allocations and the expected value; a boxed argument dies on the entry guard (status 139) while immediates compute; a proven ensures emits no check under --keep-proven-checks / --critical (3 identical builds)"

fn rg_main(input) = let root = rg_get_at(input, "root", 0) in if root == "" then rg_fail("requires @root") else let tmp = "/tmp/lume-realtime-gate." + str(os_getpid()) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil))) in let cfg = {root: root, tmp: tmp} in let rj = rg_rejections(cfg) in let pr = rg_proofs(cfg) in let ms = rg_measure(cfg) in let kp = rg_keep_proven(cfg) in let w14 = rg_w14(cfg) in let ck = rg_ct(cfg) in let rm = os_run("/bin/rm", Cons("-rf", Cons(tmp, Nil))) in "OK: realtime gate: " + str(rj) + " [E0210] rejections (record, constructor, allocating builtin, callee that is not @no_alloc, unbounded parameter, untyped signature, non-tail recursion; lumec exit 3, no assembly, lcaas parity); 3 @no_alloc kernels (" + str(pr) + " contracts proven, none refuted) ran 200000 calls and a tail recursion of depth 100000 with 0 heap allocations measured by heap_stats (control loop of 1000 cells counted); --keep-proven-checks and --critical keep the ensures check the default build elides (identical assembly for both flags, " + str(kp) + " builds agree on the value and trap on requires)" + w14 + "; " + ck

print rg_main(readall())
