## realtime_gate.src -- acceptance gate of the hard real-time build options of lumec (Domain #116).
##   printf '@root %s\n' "$PWD" | build/bin/realtime_gate
## What it checks, on every run, with the real build/bin/lumec, lasm, lcaas and lume_driver:
##   1. `@no_alloc` rejections ([E0210], exit 3, no assembly, the same code from the lcaas oracle): a record, a
##      constructor with fields, an allocating builtin, a callee that is not `@no_alloc` (the property is transitive),
##      a parameter without proven bounds (a boxed argument would make every operation allocate), an untyped
##      signature, a recursive call that is not in tail position (unbounded stack).
##   2. `@no_alloc` kernels that are accepted run and MEASURE zero allocations: the program reads `heap_stats()`
##      around 200000 calls of three `@no_alloc` functions (branching, multiplication under proven bounds, a tail
##      recursion of depth 100000) and the allocation counter must move by exactly the one record `heap_stats()`
##      itself returns. A control loop that builds a list must move the same counter by at least its length, so a
##      counter that does not count cannot pass.
##   3. `--keep-proven-checks` / `--critical`: the default build elides the run-time check of a proven `ensures`,
##      the two flags keep it (same bytes for both spellings), the program computes the same value either way, and
##      the `requires` check traps in all three builds.
##   4. constant-time kernels (`@secret` + `@no_alloc`, Wave 14): the [C0011] / [E0210] source rules with lcaas parity,
##      zero allocations over 600000 kernel calls, the fail-closed entry guard on a boxed argument, and no ensures
##      check under --keep-proven-checks (see section 4 below).
## Real level: "zero allocations" is measured on the hosted runtime for the calls made here and is a consequence of
## the static check, not a proof about every path; the stack bound is the tail-call lowering (constant frames), no
## worst-case stack depth in bytes is computed, and no timing is measured: `@bound` is the cycle-budget check.

fn rg_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else rg_line_end(s, i + 1)
fn rg_get_at(s, key, i) = if i >= count(s) then "" else let e = rg_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else rg_get_at(s, key, e + 1)
fn rg_index(text, part, i) = if i + count(part) > count(text) then 0 - 1 else if slice(text, i, i + count(part)) == part then i else rg_index(text, part, i + 1)
fn rg_has(text, part) = if rg_index(text, part, 0) >= 0 then 1 else 0
fn rg_count(text, part, i, acc) = let j = rg_index(text, part, i) in if j < 0 then acc else rg_count(text, part, j + count(part), acc + 1)
fn rg_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn rg_fail(msg) = ctfail("realtime gate failed: " + msg + "\n")
fn rg_run(bin, args, out) = let st = os_run_capture_timeout(bin, args, out, out + ".err", 120000) in {status: rg_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn rg_input(bin, args, inp, out) = let st = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", 120000) in {status: rg_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn rg_lumec(cfg, name, args, src) = let sp = cfg.tmp + "/" + name + ".src" in let w = fs_write_sync(sp, src) in rg_input(cfg.root + "/build/bin/lumec", args, sp, cfg.tmp + "/" + name + ".s")
fn rg_link(cfg, name) = let a = rg_run(cfg.root + "/build/bin/lasm", Cons("--strict", Cons(cfg.tmp + "/" + name + ".s", Nil)), cfg.tmp + "/" + name + ".elf") in if a.status != 0 then rg_fail("[" + name + "] lasm --strict failed: " + a.err) else os_run("/bin/chmod", Cons("+x", Cons(cfg.tmp + "/" + name + ".elf", Nil)))

## --- 1. [E0210] rejections ----------------------------------------------------------------------------------------
fn rg_reject(cfg, name, phrase, src) = let c = rg_lumec(cfg, name, Nil, src) in if c.status != 3 then rg_fail("[" + name + "] expected lumec exit 3, got " + str(c.status) + ": " + c.err) else if count(c.out) != 0 then rg_fail("[" + name + "] assembly was emitted for a rejected `@no_alloc` function") else if rg_has(c.err, "[E0210]") == 0 or rg_has(c.err, phrase) == 0 then rg_fail("[" + name + "] the diagnostic is not [E0210] with '" + phrase + "': " + c.err) else let ip = cfg.tmp + "/" + name + ".caas.in" in let w = fs_write_sync(ip, "@mode check\n" + src) in let o = rg_input(cfg.root + "/build/bin/lcaas", Nil, ip, cfg.tmp + "/" + name + ".caas.out") in if rg_has(o.out, "E0210") == 0 then rg_fail("[" + name + "] the lcaas oracle does not report E0210: " + slice(o.out, 0, if count(o.out) > 300 then 300 else count(o.out))) else 1
fn rg_rejections(cfg) = rg_reject(cfg, "na_record", "record or closure value", "@no_alloc\nfn r(a: int) -> int requires a >= 0 and a <= 10 = let p = {x: a, y: a} in p.x\nprint r(1)\n") + rg_reject(cfg, "na_constructor", "constructor 'Cons'", "@no_alloc\nfn r(a: int) -> int requires a >= 0 and a <= 10 = match Cons(a, Nil)\n    Nil => 0\n    Cons(h, t) => h\nprint r(1)\n") + rg_reject(cfg, "na_builtin", "call of 'str', which may allocate", "@no_alloc\nfn r(a: int) -> int requires a >= 0 and a <= 10 = count(str(a))\nprint r(1)\n") + rg_reject(cfg, "na_callee", "call of 'helper', which is not `@no_alloc`", "fn helper(a: int) -> int = a + 1\n@no_alloc\nfn r(a: int) -> int requires a >= 0 and a <= 10 = helper(a)\nprint r(1)\n") + rg_reject(cfg, "na_unbounded", "has no proven bounds", "@no_alloc\nfn r(a: int, b: int) -> int = a * b\nprint r(1, 2)\n") + rg_reject(cfg, "na_untyped", "untyped parameters or result", "@no_alloc\nfn r(a) = a + 1\nprint r(1)\n") + rg_reject(cfg, "na_nontail", "non-tail recursive call", "@no_alloc\nfn f(n: int) -> int requires n >= 0 and n <= 1000 = if n == 0 then 0 else 1 + f(n - 1)\nprint f(3)\n")

## --- 2. accepted kernels: measured allocations --------------------------------------------------------------------
fn rg_kernels() = "@no_alloc\nfn clampi(x: int, lo: int, hi: int) -> int requires lo >= 0 - 1000000 and hi <= 1000000 and lo <= hi and x >= 0 - 1000000000 and x <= 1000000000 ensures result >= lo and result <= hi = if x < lo then lo else if x > hi then hi else x\n@no_alloc\nfn step(a: int, b: int) -> int requires a >= 0 and a <= 1000 and b >= 0 and b <= 1000 ensures result >= 0 = a * b + 7\n@no_alloc\nfn sumto(n: int, acc: int) -> int requires n >= 0 and n <= 100000 and acc >= 0 and acc <= 10000000000 = if n == 0 then acc else sumto(n - 1, acc + n)\n"
fn rg_measure_src() = "use arena\n" + rg_kernels() + "fn loop_na(i, acc) = if i == 0 then acc else loop_na(i - 1, (acc + clampi(i, 0, 100) + step(i % 1000, 3)) % 1000003)\nfn boxy(i, acc) = if i == 0 then acc else boxy(i - 1, Cons(i, acc))\nfn len(xs, n) = match xs\n    Nil        => n\n    Cons(h, t) => len(t, n + 1)\nfn allocs_now() = (heap_stats()).allocs\nfn measure() = let a = allocs_now() in let r = loop_na(200000, 0) in let s = sumto(100000, 0) in let b = allocs_now() in let l = boxy(1000, Nil) in let c = allocs_now() in str(b - a) + \" \" + str(r) + \" \" + str(s) + \" \" + str(len(l, 0)) + \" \" + (if c - b >= 1000 then \"control-counted\" else \"control-not-counted\")\nprint measure()\n"
## the same arithmetic computed by the gate itself (no `@no_alloc`), as the expected values
fn rg_clampi(x, lo, hi) = if x < lo then lo else if x > hi then hi else x
fn rg_loop(i, acc) = if i == 0 then acc else rg_loop(i - 1, (acc + rg_clampi(i, 0, 100) + (i % 1000 * 3 + 7)) % 1000003)
fn rg_measure(cfg) = let sp = cfg.tmp + "/measure.src" in let w = fs_write_sync(sp, rg_measure_src()) in let b = rg_run(cfg.root + "/build/bin/lume_driver", Cons("build", Cons(sp, Cons("-o", Cons(cfg.tmp + "/measure.elf", Nil)))), cfg.tmp + "/measure.build") in if b.status != 0 then rg_fail("the measurement program did not build: " + b.out + b.err) else let r = rg_run(cfg.tmp + "/measure.elf", Nil, cfg.tmp + "/measure.out") in let want = "1 " + str(rg_loop(200000, 0)) + " 5000050000 1000 control-counted\n" in if r.status != 0 then rg_fail("the measurement program exited with " + str(r.status) + ": " + r.err) else if r.out != want then rg_fail("allocation measurement: got '" + r.out + "', expected '" + want + "' (first field: allocations across 200000 calls of clampi / step and one sumto of depth 100000; exactly 1 is the record heap_stats() returns)") else 1
fn rg_proofs(cfg) = let sp = cfg.tmp + "/kernels.src" in let w = fs_write_sync(sp, rg_kernels() + "print step(2, 3)\n") in let o = rg_input(cfg.root + "/build/bin/lcaas", Nil, sp, cfg.tmp + "/kernels.prove") in if o.status != 0 or rg_has(o.out, "\"status\":\"refuted\"") == 1 or rg_has(o.out, "\"name\":\"step\",\"kind\":\"contract\",\"status\":\"proven\"") == 0 or rg_has(o.out, "\"name\":\"clampi\",\"kind\":\"contract\",\"status\":\"proven\"") == 0 then rg_fail("the contracts of the `@no_alloc` kernels `clampi` and `step` are not proven: " + slice(o.out, 0, if count(o.out) > 400 then 400 else count(o.out)) + o.err) else rg_count(o.out, "\"status\":\"proven\"", 0, 0)

## --- 3. --keep-proven-checks / --critical ------------------------------------------------------------------------------
fn rg_kp_src() = "fn kp(x: int) -> int requires x >= 0 and x <= 100 ensures result >= x = x + 1\nprint kp(toint(os_arg_at(1)))\n"
fn rg_kp_msg() = "runtime contract violation (ensures) in 'kp'"
fn rg_kp_run(cfg, name, arg) = rg_run(cfg.tmp + "/" + name + ".elf", Cons(arg, Nil), cfg.tmp + "/" + name + ".run")
fn rg_kp_one(cfg, name) = let l = rg_link(cfg, name) in let ok = rg_kp_run(cfg, name, "5") in let bad = rg_kp_run(cfg, name, "101") in if ok.status != 0 or ok.out != "6\n" then rg_fail("[" + name + "] kp(5) gave status " + str(ok.status) + " and '" + ok.out + "'") else if bad.status == 0 or bad.status >= 128 or rg_has(bad.err, "runtime contract violation (requires) in 'kp'") == 0 then rg_fail("[" + name + "] kp(101) did not stop on its requires check: status " + str(bad.status) + " " + bad.err) else 1
fn rg_keep_proven(cfg) = let p = rg_lumec(cfg, "kp_default", Nil, rg_kp_src()) in let k = rg_lumec(cfg, "kp_keep", Cons("--keep-proven-checks", Nil), rg_kp_src()) in let c = rg_lumec(cfg, "kp_critical", Cons("--critical", Nil), rg_kp_src()) in if p.status != 0 or k.status != 0 or c.status != 0 then rg_fail("lumec rejected the keep-proven fixture: " + p.err + k.err + c.err) else if rg_has(p.out, rg_kp_msg()) == 1 then rg_fail("the default build still carries the run-time check of the proven ensures of kp (nothing to keep)") else if rg_has(k.out, rg_kp_msg()) == 0 then rg_fail("--keep-proven-checks did not keep the run-time check of the proven ensures of kp") else if c.out != k.out then rg_fail("--critical and --keep-proven-checks emit different assembly") else if count(k.out) <= count(p.out) then rg_fail("the kept check added no code") else rg_kp_one(cfg, "kp_default") + rg_kp_one(cfg, "kp_keep") + rg_kp_one(cfg, "kp_critical")

## --- 4. constant-time kernels: `@secret` + `@no_alloc` (Wave 14) -------------------------------------------------
## A kernel is lowered to straight-line code on immediate words. The gate checks the source rules through BOTH the
## compiler and the lcaas oracle ([C0011]; an operation that is not proven in range is [E0210]), that 200000 kernel
## calls allocate nothing and compute the values the gate computes itself with ordinary arithmetic, that a kernel
## called with an argument that is not an immediate dies instead of computing (status 139: the load of the entry
## guard faults), and that a proven `ensures` of a kernel emits no check under --keep-proven-checks / --critical
## either (a run-time check would be a branch on a secret), so all three builds are the same bytes.
fn rg_reject_code(cfg, name, code, phrase, src) = let c = rg_lumec(cfg, name, Nil, src) in if c.status != 3 then rg_fail("[" + name + "] expected lumec exit 3, got " + str(c.status) + ": " + c.err) else if count(c.out) != 0 then rg_fail("[" + name + "] assembly was emitted for a rejected constant-time kernel") else if rg_has(c.err, "[" + code + "]") == 0 or rg_has(c.err, phrase) == 0 then rg_fail("[" + name + "] the diagnostic is not [" + code + "] with '" + phrase + "': " + c.err) else let ip = cfg.tmp + "/" + name + ".caas.in" in let w = fs_write_sync(ip, "@mode check\n" + src) in let o = rg_input(cfg.root + "/build/bin/lcaas", Nil, ip, cfg.tmp + "/" + name + ".caas.out") in if rg_has(o.out, "\"code\":\"" + code + "\"") == 0 or rg_has(o.out, phrase) == 0 then rg_fail("[" + name + "] the lcaas oracle does not report " + code + " with '" + phrase + "': " + slice(o.out, 0, if count(o.out) > 400 then 400 else count(o.out))) else 1
fn rg_ct_h() = "@secret\n@no_alloc\n"
fn rg_ct_rejections(cfg) = rg_reject_code(cfg, "ct_requires", "C0011", "a 'requires' clause", rg_ct_h() + "fn k(a: int) -> int requires a >= 0 = bit_and(a, 255)\nprint k(1)\n") + rg_reject_code(cfg, "ct_ensures", "C0011", "an 'ensures' clause that is not proven", rg_ct_h() + "fn k(a: int) -> int ensures result >= 300 = bit_and(a, 255)\nprint k(1)\n") + rg_reject_code(cfg, "ct_shift", "C0011", "'bit_shr' with a shift amount that is not an integer literal", rg_ct_h() + "fn k(a: int, s: int) -> int = bit_shr(a, s)\nprint k(1, 2)\n") + rg_reject_code(cfg, "ct_callee", "C0011", "the call of 'h', which is not a constant-time kernel", "fn h(a: int) -> int = a\n" + rg_ct_h() + "fn k(a: int) -> int = h(a)\nprint k(1)\n") + rg_reject_code(cfg, "ct_recursion", "C0011", "the recursive call 'k(...)'", rg_ct_h() + "fn k(a: int) -> int = k(bit_and(a, 1))\nprint k(1)\n") + rg_reject_code(cfg, "ct_mutual", "C0011", "mutual recursion with 'j'", rg_ct_h() + "fn k(a: int) -> int = j(a)\n" + rg_ct_h() + "fn j(a: int) -> int = k(a)\nprint k(1)\n") + rg_reject_code(cfg, "ct_cond", "C0011", "a conditional expression (`if`), even on public values", rg_ct_h() + "fn k(a: int) -> int = if 1 == 1 then a else 0\nprint k(1)\n") + rg_reject_code(cfg, "ct_compare", "C0011", "the operator '<'", rg_ct_h() + "fn k(a: int, b: int) -> int = bit_and(a, 1) + (a < b)\nprint k(1, 2)\n") + rg_reject_code(cfg, "ct_builtin", "C0011", "the call of 'count'", rg_ct_h() + "fn k(a: int) -> int = count(str(a))\nprint k(1)\n") + rg_reject_code(cfg, "ct_bool", "C0011", "not typed `int`", rg_ct_h() + "fn k(a: bool) -> int = 1\nprint k(true)\n") + rg_reject_code(cfg, "ct_range", "E0210", "'a + b' is not proven to stay inside the 63-bit immediate range", rg_ct_h() + "fn k(a: int, b: int) -> int = a + b\nprint k(1, 2)\n") + rg_reject_code(cfg, "ct_shl_range", "E0210", "'bit_shl(bit_and(a, 4294967295), 40)' is not proven to stay inside the 63-bit immediate range", rg_ct_h() + "fn k(a: int) -> int = bit_shl(bit_and(a, 4294967295), 40)\nprint k(1)\n")
fn rg_ct_kernels() = rg_ct_h() + "fn add32(a: int, b: int) -> int = bit_and(bit_and(a, 4294967295) + bit_and(b, 4294967295), 4294967295)\n" + rg_ct_h() + "fn cswap(mask: int, x: int, y: int) -> int = ct_select(mask, y, x)\n" + rg_ct_h() + "fn eqk(a: int, b: int) -> int = ct_eq(a, b)\n"
fn rg_ct_measure_src() = "use arena\n" + rg_ct_kernels() + "fn lp(i, acc) = if i == 0 then acc else lp(i - 1, add32(acc + eqk(i % 3, 0), cswap(0 - (i % 2), i, 7)))\nfn allocs_now() = (heap_stats()).allocs\nfn measure() = let a = allocs_now() in let r = lp(200000, 0) in let b = allocs_now() in str(b - a) + \" \" + str(r)\nprint measure()\n"
## the same loop with ordinary arithmetic, as the expected value
fn rg_ct_lp(i, acc) = if i == 0 then acc else rg_ct_lp(i - 1, (acc + (if i % 3 == 0 then 1 else 0) + (if i % 2 == 1 then 7 else i)) % 4294967296)
fn rg_ct_measure(cfg) = let sp = cfg.tmp + "/ctmeasure.src" in let w = fs_write_sync(sp, rg_ct_measure_src()) in let b = rg_run(cfg.root + "/build/bin/lume_driver", Cons("build", Cons(sp, Cons("-o", Cons(cfg.tmp + "/ctmeasure.elf", Nil)))), cfg.tmp + "/ctmeasure.build") in if b.status != 0 then rg_fail("the constant-time measurement program did not build: " + b.out + b.err) else let r = rg_run(cfg.tmp + "/ctmeasure.elf", Nil, cfg.tmp + "/ctmeasure.out") in let want = "1 " + str(rg_ct_lp(200000, 0)) + "\n" in if r.status != 0 then rg_fail("the constant-time measurement program exited with " + str(r.status) + ": " + r.err) else if r.out != want then rg_fail("constant-time kernels: got '" + r.out + "', expected '" + want + "' (first field: allocations across 600000 kernel calls; exactly 1 is the record heap_stats() returns)") else 1
fn rg_ct_guard(cfg) = let c = rg_lumec(cfg, "ctguard", Nil, rg_ct_kernels() + "print add32(toint(os_arg_at(1)), 1)\n") in if c.status != 0 then rg_fail("lumec rejected the guard fixture: " + c.err) else let l = rg_link(cfg, "ctguard") in let ok = rg_run(cfg.tmp + "/ctguard.elf", Cons("5", Nil), cfg.tmp + "/ctguard.run") in let top = rg_run(cfg.tmp + "/ctguard.elf", Cons("4611686018427387903", Nil), cfg.tmp + "/ctguard.run") in let boxed = rg_run(cfg.tmp + "/ctguard.elf", Cons("4611686018427387904", Nil), cfg.tmp + "/ctguard.run") in if ok.status != 0 or ok.out != "6\n" then rg_fail("add32(5, 1) gave status " + str(ok.status) + " and '" + ok.out + "'") else if top.status != 0 or top.out != "0\n" then rg_fail("add32(2^62 - 1, 1) gave status " + str(top.status) + " and '" + top.out + "'") else if boxed.status != 139 or count(boxed.out) != 0 then rg_fail("a kernel called with the boxed argument 2^62 did not die on its entry guard: status " + str(boxed.status) + ", stdout '" + boxed.out + "'") else 1
fn rg_ct_kp_src() = rg_ct_h() + "fn kq(a: int) -> int ensures result >= 0 and result <= 255 = bit_and(a, 255)\nprint kq(toint(os_arg_at(1)))\n"
fn rg_ct_keep(cfg) = let p = rg_lumec(cfg, "ctkp_default", Nil, rg_ct_kp_src()) in let k = rg_lumec(cfg, "ctkp_keep", Cons("--keep-proven-checks", Nil), rg_ct_kp_src()) in let c = rg_lumec(cfg, "ctkp_critical", Cons("--critical", Nil), rg_ct_kp_src()) in if p.status != 0 or k.status != 0 or c.status != 0 then rg_fail("lumec rejected the kernel with a proven ensures: " + p.err + k.err + c.err) else if k.out != p.out or c.out != p.out then rg_fail("--keep-proven-checks / --critical changed the code of a constant-time kernel (a kept ensures check would branch on a secret)") else if rg_has(p.out, "(ensures) in 'kq'") == 1 then rg_fail("the kernel kq carries a run-time ensures check") else let l = rg_link(cfg, "ctkp_keep") in let r = rg_run(cfg.tmp + "/ctkp_keep.elf", Cons("300", Nil), cfg.tmp + "/ctkp_keep.run") in if r.status != 0 or r.out != "44\n" then rg_fail("kq(300) gave status " + str(r.status) + " and '" + r.out + "'") else 1
## the bit facts the prover gained with the kernels (06b_phase3.src vct_bit_hyps): bounds that hold are proven, bounds
## that do not hold are NOT proven (refuted with a counterexample where the evaluator reaches one, otherwise left to a
## run-time check) -- a rule that proved a false bound would make a kernel emit unchecked wrong code
fn rg_ct_proof_src() = "fn m32(a: int, b: int) -> int ensures result >= 0 and result <= 8589934590 = bit_and(a, 4294967295) + bit_and(b, 4294967295)\nfn x8(a: int, b: int) -> int ensures result >= 0 and result <= 255 = bit_xor(bit_and(a, 255), bit_and(b, 255))\nfn o16(a: int, b: int) -> int ensures result >= 0 and result <= 65535 = bit_or(bit_and(a, 65535), bit_and(b, 4095))\nfn e1(a: int, b: int) -> int ensures result >= 0 and result <= 1 = ct_eq(a, b)\nfn s8(m: int, a: int, b: int) -> int ensures result >= 0 and result <= 255 = ct_select(m, bit_and(a, 255), bit_and(b, 255))\nfn bad1(a: int) -> int ensures result <= 254 = bit_and(a, 255)\nfn bad2(a: int, b: int) -> int ensures result <= 255 = bit_or(bit_and(a, 255), b)\nfn bad3(a: int, b: int) -> int ensures result == 1 = ct_eq(a, b)\nfn bad4(m: int, a: int, b: int) -> int ensures result <= 255 = ct_select(m, bit_and(a, 255), b)\nfn bad5(a: int, b: int) -> int ensures result <= 255 = bit_xor(bit_and(a, 255), bit_and(b, 511))\nfn bad6(a: int) -> int ensures result >= 0 = bit_and(a, 0 - 256)\nprint m32(1, 2)\n"
fn rg_ct_st(out, nm, st) = rg_has(out, "\"name\":\"" + nm + "\",\"kind\":\"contract\",\"status\":\"" + st + "\"")
fn rg_ct_proofs(cfg) = let sp = cfg.tmp + "/ctproofs.src" in let w = fs_write_sync(sp, rg_ct_proof_src()) in let o = rg_input(cfg.root + "/build/bin/lcaas", Nil, sp, cfg.tmp + "/ctproofs.out") in if rg_ct_st(o.out, "m32", "proven") == 0 or rg_ct_st(o.out, "x8", "proven") == 0 or rg_ct_st(o.out, "o16", "proven") == 0 or rg_ct_st(o.out, "e1", "proven") == 0 or rg_ct_st(o.out, "s8", "proven") == 0 then rg_fail("a true bit bound is not proven (bit_and mask, xor / or of masked values, ct_eq, ct_select): " + slice(o.out, 0, if count(o.out) > 600 then 600 else count(o.out)) + o.err) else if rg_ct_st(o.out, "bad1", "refuted") == 0 or rg_ct_st(o.out, "bad3", "refuted") == 0 then rg_fail("a false bit bound with a small counterexample is not refuted (bad1: bit_and(a, 255) <= 254; bad3: ct_eq(a, b) == 1)") else if rg_ct_st(o.out, "bad2", "proven") == 1 or rg_ct_st(o.out, "bad4", "proven") == 1 or rg_ct_st(o.out, "bad5", "proven") == 1 or rg_ct_st(o.out, "bad6", "proven") == 1 or rg_ct_st(o.out, "bad1", "proven") == 1 or rg_ct_st(o.out, "bad3", "proven") == 1 then rg_fail("UNSOUND: a false bit bound is reported proven") else if rg_ct_st(o.out, "bad2", "runtime_checked") == 0 or rg_ct_st(o.out, "bad4", "runtime_checked") == 0 or rg_ct_st(o.out, "bad5", "runtime_checked") == 0 or rg_ct_st(o.out, "bad6", "runtime_checked") == 0 then rg_fail("a false bit bound is neither refuted nor left to a run-time check") else 11
fn rg_ct(cfg) = let rj = rg_ct_rejections(cfg) in let pf = rg_ct_proofs(cfg) in let ms = rg_ct_measure(cfg) in let gd = rg_ct_guard(cfg) in let kp = rg_ct_keep(cfg) in "constant-time kernels (@secret + @no_alloc): " + str(rj) + " source rejections with lumec / lcaas parity (10 [C0011]: requires, unproven ensures, variable shift, call of a non-kernel, recursion, mutual recursion, conditional, comparison, builtin, non-int parameter; 2 [E0210]: sum and shift not proven in range); " + str(pf) + " bit-bound contracts through the prover (5 true bounds proven; 6 false bounds not proven: 2 refuted with a counterexample, 4 left to a run-time check); 600000 kernel calls with 0 heap allocations and the expected value; a boxed argument dies on the entry guard (status 139) while immediates compute; a proven ensures emits no check under --keep-proven-checks / --critical (3 identical builds)"

fn rg_main(input) = let root = rg_get_at(input, "root", 0) in if root == "" then rg_fail("requires @root") else let tmp = "/tmp/lume-realtime-gate." + str(os_getpid()) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil))) in let cfg = {root: root, tmp: tmp} in let rj = rg_rejections(cfg) in let pr = rg_proofs(cfg) in let ms = rg_measure(cfg) in let kp = rg_keep_proven(cfg) in let ck = rg_ct(cfg) in let rm = os_run("/bin/rm", Cons("-rf", Cons(tmp, Nil))) in "OK: realtime gate: " + str(rj) + " [E0210] rejections (record, constructor, allocating builtin, callee that is not @no_alloc, unbounded parameter, untyped signature, non-tail recursion; lumec exit 3, no assembly, lcaas parity); 3 @no_alloc kernels (" + str(pr) + " contracts proven, none refuted) ran 200000 calls and a tail recursion of depth 100000 with 0 heap allocations measured by heap_stats (control loop of 1000 cells counted); --keep-proven-checks and --critical keep the ensures check the default build elides (identical assembly for both flags, " + str(kp) + " builds agree on the value and trap on requires); " + ck

print rg_main(readall())
