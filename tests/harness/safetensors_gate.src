## safetensors_gate.src -- gate of the verified neural cartridges (compiler/stage1/lneural_cartridge.src).
##   printf '@root %s\n' "$PWD" | build/bin/safetensors_gate
## Optional lines: `@keep 1` leaves the cartridges in build/safetensors-gate/ (by default each file is deleted once it
## has been checked); `@lcaas off` skips the certificate step (the OK line says so, and the metadata then records that
## no certificate was supplied).
## For every case (a Lume source with a `/ pure` integer entry function and proven contracts):
##   1. certificate: build/bin/lcaas `@mode certify` on the source; the certificate kernel (lcert.src, linked into the
##      cartridge compiler) must re-derive every obligation, and the verdict goes into the cartridge metadata;
##   2. compile to build/safetensors-gate/<name>.safetensors (fs_write_hex_file);
##   3. the file is read back byte by byte with fs_read_byte and checked field by field HERE, independently of the
##      loader: header length, JSON header, the five tensors with their dtype / shape / data_offsets, the metadata, the
##      SHA-256 of the tensor bytes (also against /usr/bin/sha256sum when present), the ROM words against the RV32IM
##      compiler, the weights against the block specification. fs_read_byte opens the file for each byte, which takes
##      minutes per file on the Windows-mounted checkout, so the bytes are read from a copy under /tmp that
##      fs_files_equal proves identical to the file in build/safetensors-gate/;
##   4. the strict loader accepts the bytes and the forward pass (matrix arithmetic over the weights of the file) is
##      run for every argument vector and must agree exactly with (a) the native x86-64 program built from the same
##      source by build/bin/lumec + build/bin/lasm, (b) the LumePuter emulator (rv_*) running the ROM of the file with
##      the same input cells -- value, halt/trap cause and cycle count -- and (c) the envelope's own monitor run
##      (se_b_run, arguments baked into its stub);
##   5. trap vectors (contract violation, division by zero): the native program must die and the forward pass must trap
##      with the same cause as the emulator;
##   6. tampering: one weight byte flipped on disk -> hash mismatch; ROM words flipped with every hash recomputed -> the
##      file loads and the run traps or returns a value the native program does not; ballast entry lowered with the
##      hashes recomputed -> the guard trips; a down-projection weight changed with the hashes recomputed -> trap or
##      wrong value; header length / first byte / data_offsets / truncation -> rejected.
## The tool binary (build/bin/lneural_cartridge, stdin protocol) must produce the same bytes as the library call.
## A reference load with the Python `safetensors` package is done only when that package is already installed.
use lneural_cartridge

fn sg_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else sg_line_end(s, i + 1)
fn sg_get_at(s, key, i) = if i >= count(s) then "" else let e = sg_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else sg_get_at(s, key, e + 1)
fn sg_get(s, key) = sg_get_at(s, key, 0)
fn sg_run(bin, args, out) = se_wait_exit(os_run_capture_timeout(bin, args, out, out + ".err", 120000))
fn sg_in(bin, inp, out) = se_wait_exit(os_run_input_capture_timeout(bin, Nil, inp, out, out + ".err", 300000))
fn sg_ms() = os_monotonic_ns() / 1000000
fn sg_l2(a, b) = Cons(a, Cons(b, Nil))
fn sg_l3(a, b, c) = Cons(a, Cons(b, Cons(c, Nil)))
fn sg_l1(a) = Cons(a, Nil)

## --- the cases: {name, entry, src, vecs (in-domain argument vectors), traps (vectors on which both sides must trap)} ---
fn sg_case(name, entry, src, vecs, traps) = {name: name, entry: entry, src: src, vecs: vecs, traps: traps}
fn sg_c_affine() = sg_case("affine", "affine", "fn affine(x: int, y: int) -> int / pure requires x >= 0 - 100000 and x <= 100000 and y >= 0 - 100000 and y <= 100000 ensures result == 3 * x - 2 * y + 7 = 3 * x - 2 * y + 7\n", Cons(sg_l2(0, 0), Cons(sg_l2(5, 9), Cons(sg_l2(0 - 100000, 100000), Cons(sg_l2(99999, 0 - 77777), Cons(sg_l2(0 - 1, 0 - 1), Nil))))), Cons(sg_l2(100001, 0), Cons(sg_l2(0, 0 - 100001), Nil)))
fn sg_c_clamp() = sg_case("clamp_nested", "ctl", "fn clampv(x: int, lo: int, hi: int) -> int / pure requires lo <= hi ensures result >= lo and result <= hi = if x < lo then lo else if x > hi then hi else x\nfn ctl(err: int, kp: int, lim: int) -> int / pure = if lim < 0 then 0 - 1 else if err < 0 then (if kp > 8 then clampv(err * 8, 0 - lim, lim) else clampv(err * kp, 0 - lim, lim)) else if err == 0 then 0 else clampv(err * kp + 1, 0 - lim, lim)\n", Cons(sg_l3(0, 3, 50), Cons(sg_l3(7, 3, 50), Cons(sg_l3(700, 3, 50), Cons(sg_l3(0 - 7, 3, 50), Cons(sg_l3(0 - 9000, 12, 4000), Cons(sg_l3(5, 2, 0 - 1), Cons(sg_l3(0 - 3, 20, 1000000), Nil))))))), Nil)
fn sg_c_fib() = sg_case("fib_recursion", "fibn", "fn idn(n: int) -> int / pure requires n >= 0 ensures result == n = n\nfn fib(n: int) -> int / pure = if n < 2 then n else fib(n - 1) + fib(n - 2)\nfn fibn(n: int) -> int / pure = if n < 0 then 0 - 1 else fib(idn(n))\n", Cons(sg_l1(0), Cons(sg_l1(1), Cons(sg_l1(2), Cons(sg_l1(7), Cons(sg_l1(12), Cons(sg_l1(15), Cons(sg_l1(0 - 4), Nil))))))), Nil)
fn sg_c_gcd() = sg_case("gcd_recursion", "gcdabs", "fn absv(x: int) -> int / pure ensures result >= 0 = if x < 0 then 0 - x else x\nfn gcd(a: int, b: int) -> int / pure = if b == 0 then a else gcd(b, a % b)\nfn gcdabs(a: int, b: int) -> int / pure = gcd(absv(a), absv(b))\n", Cons(sg_l2(48, 18), Cons(sg_l2(0 - 48, 18), Cons(sg_l2(17, 0 - 5), Cons(sg_l2(0, 9), Cons(sg_l2(1071, 462), Cons(sg_l2(0 - 2147483647, 2147483647), Cons(sg_l2(832040, 514229), Nil))))))), Nil)
fn sg_c_divmod() = sg_case("divmod_negative", "dm", "fn sgn(x: int) -> int / pure ensures result >= 0 - 1 and result <= 1 = if x < 0 then 0 - 1 else if x > 0 then 1 else 0\nfn dm(a: int, b: int) -> int / pure = (a / b) * 1000 + a % b + sgn(a) * 100000 + sgn(b) * 1000000\n", Cons(sg_l2(17, 5), Cons(sg_l2(0 - 17, 5), Cons(sg_l2(17, 0 - 5), Cons(sg_l2(0 - 17, 0 - 5), Cons(sg_l2(0, 7), Cons(sg_l2(0 - 1, 2), Cons(sg_l2(100000, 0 - 3), Cons(sg_l2(0 - 100000, 7), Nil)))))))), Cons(sg_l2(5, 0), Cons(sg_l2(0 - 5, 0), Nil)))
fn sg_c_bits() = sg_case("bitwise_mix", "mixb", "fn twice(x: int) -> int / pure ensures result == x + x = 2 * x\nfn mixb(a: int, b: int) -> int / pure = bit_xor(bit_and(a, b), bit_or(a, 255)) + twice(bit_and(bit_xor(a, b), 65535)) - bit_or(b, 0 - 256)\n", Cons(sg_l2(0, 0), Cons(sg_l2(255, 256), Cons(sg_l2(0 - 1, 1), Cons(sg_l2(305419896, 0 - 19088744), Cons(sg_l2(0 - 2147483648, 2147483647), Cons(sg_l2(65535, 0 - 65536), Cons(sg_l2(123456789, 987654321), Nil))))))), Nil)
fn sg_c_collatz() = sg_case("collatz_recursion", "collatz", "fn bump(x: int) -> int / pure requires x >= 0 and x <= 1000000 ensures result == x + 1 = x + 1\nfn steps(n: int, acc: int) -> int / pure = if n <= 1 then acc else if n % 2 == 0 then steps(n / 2, acc + 1) else steps(3 * n + 1, acc + 1)\nfn collatz(n: int) -> int / pure = steps(n, bump(0) - 1)\n", Cons(sg_l1(1), Cons(sg_l1(2), Cons(sg_l1(6), Cons(sg_l1(7), Cons(sg_l1(27), Cons(sg_l1(97), Cons(sg_l1(0 - 5), Nil))))))), Nil)
fn sg_c_logic() = sg_case("short_circuit_logic", "classify", "fn inrange(x: int, lo: int, hi: int) -> int / pure ensures result == 0 or result == 1 = if x >= lo and x <= hi then 1 else 0\nfn classify(x: int, y: int) -> int / pure = if inrange(x, 0, 9) == 1 and inrange(y, 0, 9) == 1 then x * 10 + y else if x < 0 or y < 0 then (if x != y then 0 - 1 else 0 - 2) else if x >= 100 or y >= 100 or x == y then 1000 else 100 + x - y\n", Cons(sg_l2(3, 4), Cons(sg_l2(9, 9), Cons(sg_l2(0 - 1, 5), Cons(sg_l2(0 - 3, 0 - 3), Cons(sg_l2(50, 20), Cons(sg_l2(20, 20), Cons(sg_l2(150, 2), Cons(sg_l2(12, 99), Nil)))))))), Nil)
fn sg_c_horner() = sg_case("horner_mul", "poly", "fn sat(x: int) -> int / pure ensures result >= 0 - 1000 and result <= 1000 = if x < 0 - 1000 then 0 - 1000 else if x > 1000 then 1000 else x\nfn poly(x: int) -> int / pure = let t = sat(x) in ((2 * t - 3) * t + 5) * t - 7\n", Cons(sg_l1(0), Cons(sg_l1(1), Cons(sg_l1(0 - 1), Cons(sg_l1(37), Cons(sg_l1(0 - 999), Cons(sg_l1(1000), Cons(sg_l1(123456), Nil))))))), Nil)
fn sg_cases() = Cons(sg_c_affine(), Cons(sg_c_clamp(), Cons(sg_c_fib(), Cons(sg_c_gcd(), Cons(sg_c_divmod(), Cons(sg_c_bits(), Cons(sg_c_collatz(), Cons(sg_c_logic(), Cons(sg_c_horner(), Nil)))))))))

## --- step 1: certificate ------------------------------------------------------------------------------------------
fn sg_cert(cfg, cs) = if cfg.certon == 0 then "" else let inp = cfg.tmp + "/" + cs.name + ".certify.in" in let out = cfg.tmp + "/" + cs.name + ".cert.json" in let w = fs_write_sync(inp, "@mode certify\n@sha256 " + sha256_hex(cs.src) + "\n" + cs.src) in let st = sg_in(cfg.lcaas, inp, out) in let txt = fs_read_file(out) in if st != 0 and txt == "" then ctfail("safetensors gate failed: lcaas certify died on case " + cs.name + ": " + fs_read_file(out + ".err") + "\n") else slice(txt, 0, sg_line_end(txt, 0))

## --- step 3: independent structure check of the bytes read back from disk ----------------------------------------------
fn sg_take(bs, n, acc) = match bs
    Nil        => lnc_rev(acc, Nil)
    Cons(h, t) => if n <= 0 then lnc_rev(acc, Nil) else sg_take(t, n - 1, Cons(h, acc))
fn sg_list_eq(a, b) = match a
    Nil         => lnc_len(b, 0) == 0
    Cons(h, t)  => sg_list_eq2(h, t, b)
fn sg_list_eq2(h, t, b) = match b
    Nil          => 0
    Cons(h2, t2) => if h == h2 then sg_list_eq(t, t2) else 0
fn sg_u32s(bs, n, acc) = if n <= 0 then lnc_rev(acc, Nil) else sg_u32s(lnc_drop(bs, 4), n - 1, Cons(lnc_u_le(bs, 4, 1, 0), acc))
fn sg_tensor_is(hdr, name, dtype, shape, b, e) = let t = lj_get(hdr, name) in let off = lj_get(t, "data_offsets") in if t.kind != "object" then "tensor " + name + " is missing from the header" else if (lj_get(t, "dtype")).text != dtype then "tensor " + name + " dtype is " + (lj_get(t, "dtype")).text + ", expected " + dtype else if lnc_shape_str((lj_get(t, "shape")).items) != shape then "tensor " + name + " shape is [" + lnc_shape_str((lj_get(t, "shape")).items) + "], expected [" + shape + "]" else if lnc_nth_item(off.items, 0) != b or lnc_nth_item(off.items, 1) != e or lnc_len(off.items, 0) != 2 then "tensor " + name + " data_offsets are [" + str(lnc_nth_item(off.items, 0)) + "," + str(lnc_nth_item(off.items, 1)) + "], expected [" + str(b) + "," + str(e) + "]" else ""
fn sg_j(a, b) = if a != "" then a else b
fn sg_sha_ext(cfg, cs, path, buflen) = if fs_path_exists("/usr/bin/sha256sum") == 0 or fs_path_exists("/usr/bin/tail") == 0 or fs_path_exists("/bin/sh") == 0 then "" else let out = cfg.tmp + "/" + cs.name + ".sha.out" in let st = sg_run("/bin/sh", sg_l2("-c", "/usr/bin/tail -c " + str(buflen) + " '" + path + "' | /usr/bin/sha256sum"), out) in let txt = fs_read_file(out) in if st != 0 or count(txt) < 64 then "?" else slice(txt, 0, 64)
fn sg_tail_checks(md, buf, rom, romn) = if count(lnc_meta(md.fields, "cartridge_sha256")) != 64 then "cartridge_sha256 is missing" else if sg_list_eq(sg_u32s(lnc_drop(buf, 147456), romn, Nil), rom) == 0 then "deltanet_rom differs from the RV32IM program compiled from the source" else if sg_list_eq(sg_take(buf, 147456, Nil), lnc_dense(lnc_gate_spec(), 127, 128, 128, 0, lnc_dense(lnc_up_spec(), 127, 128, 128, 0, lnc_dense(lnc_down_spec(), 15, 16, 128, 1, Nil)))) == 0 then "SwiGLU projection tensors differ from the block specification" else ""
## "" when the file is exactly the documented layout
fn sg_structure(cfg, cs, bytes, rom, cert, tpath) = let n = lnc_len(bytes, 0) in let hn = lnc_u_le(bytes, 8, 1, 0) in let romn = lnc_len(rom, 0) in let buflen = 147584 + 4 * romn in if n < 16 then "file is shorter than 16 bytes" else if hn % 8 != 0 then "header length " + str(hn) + " is not a multiple of 8" else if n != 8 + hn + buflen then "file size " + str(n) + " != 8 + " + str(hn) + " + " + str(buflen) else if lnc_nth(bytes, 8) != 123 then "header does not start with '{'" else let hdr = lj_parse(lnc_str_of_bytes(lnc_drop(bytes, 8), hn)) in if hdr.ok == 0 or hdr.kind != "object" then "header is not a JSON object: " + hdr.text else let md = lj_get(hdr, "__metadata__") in let buf = lnc_drop(bytes, 8 + hn) in let e1 = sg_j(sg_tensor_is(hdr, "swiglu_gate_proj", "I32", "128,128", 0, 65536), sg_j(sg_tensor_is(hdr, "swiglu_up_proj", "I32", "128,128", 65536, 131072), sg_j(sg_tensor_is(hdr, "swiglu_down_proj", "I64", "16,128", 131072, 147456), sg_j(sg_tensor_is(hdr, "deltanet_rom", "U32", str(romn), 147456, 147456 + 4 * romn), sg_tensor_is(hdr, "ballast_rmsnorm_guard", "I64", "16", 147456 + 4 * romn, buflen))))) in if e1 != "" then e1 else if lnc_len(hdr.fields, 0) != 6 then "header has " + str(lnc_len(hdr.fields, 0)) + " entries, expected __metadata__ + 5 tensors" else if md.kind != "object" or lnc_meta_all_str(md.fields) == 0 then "__metadata__ is not a string -> string object" else let tsha = lnc_sha256_bytes(buf) in let ext = sg_sha_ext(cfg, cs, tpath, buflen) in if lnc_meta(md.fields, "tensors_sha256") != tsha then "tensors_sha256 in the metadata is not the SHA-256 of the tensor bytes" else if ext != "" and ext != tsha then "native SHA-256 of the tensor bytes (" + tsha + ") differs from /usr/bin/sha256sum (" + ext + ")" else if lnc_meta(md.fields, "source_sha256") != sha256_hex(cs.src) then "source_sha256 does not match the source" else if lnc_meta(md.fields, "entry") != cs.entry or lnc_meta(md.fields, "format") != "lume-neural-cartridge-v1" then "metadata entry / format are wrong" else if cfg.certon == 0 then (if lnc_meta(md.fields, "lcert_kernel_verified") != "false" or lnc_meta(md.fields, "lcert_certificate_hash") != "none" then "metadata claims a certificate although none was supplied" else sg_tail_checks(md, buf, rom, romn)) else if lnc_meta(md.fields, "lcert_kernel_verified") != "true" then "metadata says the certificate kernel did not verify the source: " + lnc_meta(md.fields, "proof_status") else if lnc_meta(md.fields, "lcert_certificate_hash") != lk_jstr(cert, "certificate_hash") or count(lnc_meta(md.fields, "lcert_certificate_hash")) != 71 then "metadata certificate hash is not the hash of the lcaas certificate" else if toint(lnc_meta(md.fields, "lcert_proven_count")) < 1 then "metadata reports no proven obligation" else sg_tail_checks(md, buf, rom, romn)

## --- steps 4 and 5: forward pass against the native program and the emulator -----------------------------------------
fn sg_native_build(cfg, cs, arity) = let tag = cfg.tmp + "/" + cs.name + ".native" in let w = fs_write_sync(tag + ".src", se_a_prog(cs.src, cs.entry, arity)) in let c = sg_in(cfg.lumec, tag + ".src", tag + ".s") in if c != 0 then ctfail("safetensors gate failed: lumec rejected case " + cs.name + ": " + fs_read_file(tag + ".s.err") + "\n") else let a = sg_run(cfg.lasm, sg_l2("--strict", tag + ".s"), tag + ".elf") in if a != 0 then ctfail("safetensors gate failed: lasm rejected case " + cs.name + "\n") else let m = os_run("/bin/chmod", sg_l2("+x", tag + ".elf")) in tag
fn sg_emu_ram(m, ram, args, i) = match args
    Nil        => ram
    Cons(h, t) => sg_emu_ram(m, rv_tset(ram, m.ramhalf, i, rv_w32(h)), t, i + 1)
## the emulator on the ROM of the file, arguments in the input cells
fn sg_emu(romlist, args, budget) = let m = rv_machine(romlist, 12) in let r = rv_run(m, 262144, m.reg0, sg_emu_ram(m, m.ram0, args, 0), 0, budget, rv_no_inj()) in if r.st == 1 then {ok: 1, v: rv_s32(rv_rd(r.x, 10)), cycles: r.cyc, cause: ""} else {ok: 0, v: 0, cycles: r.cyc, cause: r.cause}
fn sg_show(xs) = se_join_ints(xs)
fn sg_vec(cfg, cs, cart, prog, tag, args) = let f = lnc_forward(cart, args) in let e = sg_emu(cart.romlist, args, lnc_default_budget()) in let o = se_b_run(prog, cs.entry, args, lnc_default_budget(), rv_no_inj()) in let a = se_a_run(tag, args, 20000) in let msg = if f.ok != 1 then "forward pass trapped on " + cs.name + "(" + sg_show(args) + "): " + f.cause else if a.ok != 1 then "native program failed on " + cs.name + "(" + sg_show(args) + "): " + a.reason + " " + a.detail else if f.v != a.v then "forward pass " + str(f.v) + " != native x86-64 " + str(a.v) + " on " + cs.name + "(" + sg_show(args) + ")" else if e.ok != 1 or e.v != f.v or e.cycles != f.cycles then "forward pass (" + str(f.v) + ", " + str(f.cycles) + " cycles) != LumePuter emulator on the same ROM (" + str(e.v) + ", " + str(e.cycles) + " cycles, " + e.cause + ") on " + cs.name + "(" + sg_show(args) + ")" else if o.ok != 1 or o.v != f.v then "forward pass " + str(f.v) + " != envelope monitor " + str(o.v) + " " + o.cause + " on " + cs.name + "(" + sg_show(args) + ")" else "" in {err: msg, cyc: f.cycles}
fn sg_vecs(cfg, cs, cart, prog, tag, vecs, st) = match vecs
    Nil        => st
    Cons(h, t) => let e = sg_vec(cfg, cs, cart, prog, tag, h) in if e.err != "" then ctfail("safetensors gate failed: " + e.err + "\n") else sg_vecs(cfg, cs, cart, prog, tag, t, {n: st.n + 1, cyc: st.cyc + e.cyc})
fn sg_trap(cfg, cs, cart, tag, args) = let f = lnc_forward(cart, args) in let e = sg_emu(cart.romlist, args, lnc_default_budget()) in let a = se_a_run(tag, args, 20000) in if f.ok != 0 then "forward pass returned " + str(f.v) + " on the trap vector " + cs.name + "(" + sg_show(args) + ")" else if a.ok != 0 then "native program returned " + str(a.v) + " on the trap vector " + cs.name + "(" + sg_show(args) + ")" else if e.ok != 0 or e.cause != f.cause or e.cycles != f.cycles then "forward pass trap '" + f.cause + "' != emulator trap '" + e.cause + "' on " + cs.name + "(" + sg_show(args) + ")" else if f.cause != "ebreak_contract_violation" and f.cause != "ebreak_division_by_zero" then "unexpected trap cause '" + f.cause + "' on " + cs.name + "(" + sg_show(args) + ")" else ""
fn sg_traps(cfg, cs, cart, tag, vecs, n) = match vecs
    Nil        => n
    Cons(h, t) => let e = sg_trap(cfg, cs, cart, tag, h) in if e != "" then ctfail("safetensors gate failed: " + e + "\n") else sg_traps(cfg, cs, cart, tag, t, n + 1)

## --- step 6: tampering -------------------------------------------------------------------------------------------------
fn sg_set(bs, i, v) = match bs
    Nil        => Nil
    Cons(h, t) => if i == 0 then Cons(v, t) else Cons(h, sg_set(t, i - 1, v))
fn sg_flip(bs, i, mask) = match bs
    Nil        => Nil
    Cons(h, t) => if i == 0 then Cons(bit_xor(h, mask), t) else Cons(h, sg_flip(t, i - 1, mask))
## a file rebuilt around changed tensor bytes with tensors_sha256 and cartridge_sha256 recomputed
fn sg_rehash(cart, tb, romn) = let mf = cart.meta in let hdr = lnc_header(cart.entry, str(cart.arity), lnc_meta(mf, "source_sha256"), lnc_sha256_bytes(tb), lnc_cert_of_meta(mf), romn) in lnc_le(count(hdr), 8, lnc_bytes_of_str(hdr, tb))
fn sg_rom_file(cart, rom) = sg_rehash(cart, lnc_tensor_bytes(rom), lnc_len(rom, 0))
## 1 when the run of `c2` is observably wrong on some vector: a trap, or a value the native program does not print
fn sg_wrong(cfg, cs, c2, tag, vecs) = match vecs
    Nil        => 0
    Cons(h, t) => let f = lnc_forward(c2, h) in if f.ok == 0 then 1 else if f.v != (se_a_run(tag, h, 20000)).v then 1 else sg_wrong(cfg, cs, c2, tag, t)
fn sg_rom_flip(cfg, cs, cart, tag, idx, bit, must) = let c2 = lnc_load(sg_rom_file(cart, rc_rom_flip(cart.romlist, idx, bit))) in if c2.err != "" then ctfail("safetensors gate failed: a ROM flip with recomputed hashes was rejected by the loader on " + cs.name + ": " + c2.err + "\n") else let wr = sg_wrong(cfg, cs, c2, tag, cs.vecs) in if must == 1 and wr == 0 then ctfail("safetensors gate failed: flipping bit " + str(bit) + " of ROM word " + str(idx) + " of " + cs.name + " (hashes recomputed) changed no result and tripped no trap\n") else wr
fn sg_find_word(rom, w, i) = match rom
    Nil        => 0 - 1
    Cons(h, t) => if h == w then i else sg_find_word(t, w, i + 1)
## ADD / SUB / MUL words of the program body: flipping funct7 bit 5 turns ADD into SUB and back
fn sg_alu_flips(cfg, cs, cart, tag, rom, i, done, hit) = match rom
    Nil        => {done: done, hit: hit}
    Cons(h, t) => if done >= 3 then {done: done, hit: hit} else if h % 128 == 51 and h / 4096 % 8 == 0 and (h / 33554432 == 0 or h / 33554432 == 32) then sg_alu_flips(cfg, cs, cart, tag, t, i + 1, done + 1, hit + sg_rom_flip(cfg, cs, cart, tag, i, 30, 0)) else sg_alu_flips(cfg, cs, cart, tag, t, i + 1, done, hit)
fn sg_expect_rej(cs, what, c, needle) = if c.err == "" then ctfail("safetensors gate failed: " + what + " of " + cs.name + " was accepted by the loader\n") else if needle != "" and se_has(c.err, needle) == 0 then ctfail("safetensors gate failed: " + what + " of " + cs.name + " was rejected for another reason: " + c.err + "\n") else 1
fn sg_replace(s, pat, rep, i) = if i + count(pat) > count(s) then s else if slice(s, i, i + count(pat)) == pat then slice(s, 0, i) + rep + slice(s, i + count(pat), count(s)) else sg_replace(s, pat, rep, i + 1)
fn sg_hdr_edit(bytes, hn, pat, rep) = let h2 = sg_replace(lnc_str_of_bytes(lnc_drop(bytes, 8), hn), pat, rep, 0) in lnc_le(count(h2), 8, lnc_bytes_of_str(h2, lnc_drop(bytes, 8 + hn)))
fn sg_write_bytes(path, bytes) = if fs_write_hex_file(path, lnc_hex(bytes)) != 1 then ctfail("safetensors gate failed: cannot write " + path + "\n") else 1
## returns {rejects, romflips, aluflips, aluhits}
fn sg_tamper(cfg, cs, cart, bytes, tag) = let n = lnc_len(bytes, 0) in let hn = cart.header_len in let romn = cart.romn in let tb = lnc_drop(bytes, 8 + hn) in let tp = cfg.tmp + "/" + cs.name + ".tampered.safetensors" in let w1 = sg_write_bytes(tp, sg_flip(bytes, 8 + hn + 131072 + 8 * (3 * 128 + 36), 2)) in let r1 = sg_expect_rej(cs, "a weight byte flipped on disk", lnc_load_file(tp), "hash mismatch") in let r2 = sg_expect_rej(cs, "a ROM byte flipped without rehash", lnc_load(sg_flip(bytes, 8 + hn + 147456 + 5, 16)), "hash mismatch") in let r3 = sg_expect_rej(cs, "a metadata edit (entry renamed)", lnc_load(sg_hdr_edit(bytes, hn, "\"entry\":\"" + cs.entry + "\"", "\"entry\":\"" + cs.entry + "x\"")), "hash chain") in let r4 = sg_expect_rej(cs, "a header length field raised by 8", lnc_load(sg_set(bytes, 0, (lnc_nth(bytes, 0) + 8) % 256)), "") in let r5 = sg_expect_rej(cs, "a file truncated by 8 bytes", lnc_load(sg_take(bytes, n - 8, Nil)), "") in let r6 = sg_expect_rej(cs, "a file cut inside the header", lnc_load(sg_take(bytes, 100, Nil)), "bad header length") in let r7 = sg_expect_rej(cs, "a header that does not start with '{'", lnc_load(sg_set(bytes, 8, 91)), "does not start") in let r8 = sg_expect_rej(cs, "overlapping data_offsets", lnc_load(sg_hdr_edit(bytes, hn, "\"data_offsets\":[65536,131072]", "\"data_offsets\":[65528,131064]")), "") in let r9 = sg_expect_rej(cs, "a tensor declared with the wrong dtype", lnc_load(sg_hdr_edit(bytes, hn, "\"dtype\":\"U32\"", "\"dtype\":\"F32\"")), "must be U32") in let r10 = sg_expect_rej(cs, "a shape that disagrees with data_offsets", lnc_load(sg_hdr_edit(bytes, hn, "\"shape\":[16,128]", "\"shape\":[16,127]")), "span") in let r11 = sg_expect_rej(cs, "a missing tensor", lnc_load(sg_hdr_edit(bytes, hn, "\"ballast_rmsnorm_guard\"", "\"ballast_rmsnorm_guarD\"")), "missing tensor") in let f1 = sg_rom_flip(cfg, cs, cart, tag, 0, 7, 1) in let f2 = sg_rom_flip(cfg, cs, cart, tag, sg_find_word(cart.romlist, rv_addi(17, 0, 93), 0), 20, 1) in let al = sg_alu_flips(cfg, cs, cart, tag, cart.romlist, 0, 0, 0) in let cb = lnc_load(sg_rehash(cart, sg_set(sg_set(tb, 147456 + 4 * romn + 3 * 8, 1), 147456 + 4 * romn + 3 * 8 + 4, 0), romn)) in let fb = if cb.err != "" then ctfail("safetensors gate failed: a lowered ballast entry with recomputed hashes was rejected by the loader on " + cs.name + ": " + cb.err + "\n") else lnc_forward(cb, sg_first(cs.vecs)) in let cd = lnc_load(sg_rehash(cart, sg_set(tb, 131072 + 8 * (3 * 128 + 36), 3), romn)) in let wd = if cd.err != "" then ctfail("safetensors gate failed: a changed down-projection weight with recomputed hashes was rejected by the loader on " + cs.name + ": " + cd.err + "\n") else sg_wrong(cfg, cs, cd, tag, cs.vecs) in if fb.ok != 0 or fb.cause != "ballast_rmsnorm_guard" then ctfail("safetensors gate failed: ballast entry of the ADD channel lowered to 1 on " + cs.name + ", but the guard did not trip (" + fb.cause + ")\n") else if wd == 0 then ctfail("safetensors gate failed: the ADD row of the down projection was changed on " + cs.name + " (hashes recomputed) and every result stayed right\n") else {rejects: 11, romflips: f1 + f2, aluflips: al.done, aluhits: al.hit}
fn sg_first(vecs) = match vecs
    Nil        => Nil
    Cons(h, t) => h

## --- optional reference loader ---------------------------------------------------------------------------------------
fn sg_py_have(cfg) = if fs_path_exists("/usr/bin/python3") == 0 then 0 else if sg_run("/usr/bin/python3", sg_l2("-c", "import safetensors, numpy"), cfg.tmp + "/py.probe") == 0 then 1 else 0
fn sg_py_load(cfg, cs, path, romn) = let out = cfg.tmp + "/" + cs.name + ".py.out" in let st = sg_run("/usr/bin/python3", sg_l3("-c", "import sys\nfrom safetensors.numpy import load_file\nt = load_file(sys.argv[1])\nprint(','.join(sorted(k + ':' + str(v.dtype) + ':' + 'x'.join(str(d) for d in v.shape) for k, v in t.items())))\n", path), out) in let want = "ballast_rmsnorm_guard:int64:16,deltanet_rom:uint32:" + str(romn) + ",swiglu_down_proj:int64:16x128,swiglu_gate_proj:int32:128x128,swiglu_up_proj:int32:128x128\n" in if st != 0 or fs_read_file(out) != want then ctfail("safetensors gate failed: the reference Python loader does not read " + path + " as expected: " + fs_read_file(out) + fs_read_file(out + ".err") + "\n") else 1

## --- one case ------------------------------------------------------------------------------------------------------------
fn sg_one(cfg, cs, py) = let t0 = sg_ms() in let cert = sg_cert(cfg, cs) in let r = lnc_compile(cs.src, cs.entry, cert) in if r.err != "" then ctfail("safetensors gate failed: case " + cs.name + " did not compile: " + r.err + "\n") else let path = cfg.dir + "/" + cs.name + ".safetensors" in let tpath = cfg.tmp + "/" + cs.name + ".safetensors" in let w = sg_write_bytes(path, r.bytes) in let cp = sg_run("/bin/cp", sg_l3("-f", path, tpath), cfg.tmp + "/cp.out") in if cp != 0 or fs_files_equal(path, tpath) != 1 then ctfail("safetensors gate failed: cannot stage " + path + " for byte reads\n") else let t1 = sg_ms() in let bytes = lnc_read_file(tpath) in if sg_list_eq(bytes, r.bytes) == 0 then ctfail("safetensors gate failed: " + path + " read back from disk differs from the compiled bytes\n") else let prog = nf_late(lumec_expand(cs.src)) in let rr = lnc_rom(prog, cs.entry) in let se = sg_structure(cfg, cs, bytes, rr.rom, cert, tpath) in if se != "" then ctfail("safetensors gate failed: structure of " + path + ": " + se + "\n") else let cart = lnc_load(bytes) in if cart.err != "" then ctfail("safetensors gate failed: the loader rejected " + path + ": " + cart.err + "\n") else let zp = if py == 1 then sg_py_load(cfg, cs, path, cart.romn) else 0 in let tag = sg_native_build(cfg, cs, cart.arity) in let t2 = sg_ms() in let vs = sg_vecs(cfg, cs, cart, prog, tag, cs.vecs, {n: 0, cyc: 0}) in let tr = sg_traps(cfg, cs, cart, tag, cs.traps, 0) in let t3 = sg_ms() in let tm = sg_tamper(cfg, cs, cart, bytes, tag) in let t4 = sg_ms() in let zk = if cfg.keep == 1 then 0 else fs_remove(path) in {name: cs.name, size: lnc_len(bytes, 0), romn: cart.romn, vecs: vs.n, cyc: vs.cyc, traps: tr, rejects: tm.rejects, romflips: tm.romflips, aluflips: tm.aluflips, aluhits: tm.aluhits, ms_compile: t1 - t0, ms_load: t2 - t1, ms_fwd: t3 - t2, ms_tamper: t4 - t3, bytes: r.bytes, cert: cert}
fn sg_acc0() = {n: 0, vecs: 0, cyc: 0, traps: 0, rejects: 0, romflips: 0, aluflips: 0, aluhits: 0, size: 0, minsize: 0, maxsize: 0, ms_compile: 0, ms_load: 0, ms_fwd: 0, ms_tamper: 0, detail: ""}
fn sg_add(a, r) = {n: a.n + 1, vecs: a.vecs + r.vecs, cyc: a.cyc + r.cyc, traps: a.traps + r.traps, rejects: a.rejects + r.rejects, romflips: a.romflips + r.romflips, aluflips: a.aluflips + r.aluflips, aluhits: a.aluhits + r.aluhits, size: a.size + r.size, minsize: if a.n == 0 or r.size < a.minsize then r.size else a.minsize, maxsize: if r.size > a.maxsize then r.size else a.maxsize, ms_compile: a.ms_compile + r.ms_compile, ms_load: a.ms_load + r.ms_load, ms_fwd: a.ms_fwd + r.ms_fwd, ms_tamper: a.ms_tamper + r.ms_tamper, detail: a.detail + (if a.detail == "" then "" else ", ") + r.name + " " + str(r.size) + " B / " + str(r.romn) + " ROM words"}
## the stand-alone tool must answer the stdin protocol with exactly the bytes of the library call
fn sg_tool(cfg, cs, r) = let inp = cfg.tmp + "/tool.in" in let out = cfg.tmp + "/tool.out" in let w = fs_write_sync(inp, "@compile safetensors\n@entry " + cs.entry + "\n@cert " + r.cert + "\n" + cs.src) in let st = sg_in(cfg.tool, inp, out) in let txt = fs_read_file(out) in let want = "HEX:" + str(r.size) + ":" + lnc_hex(r.bytes) + "\n" in if st != 0 or txt != want then ctfail("safetensors gate failed: build/bin/lneural_cartridge answered the protocol with something else than the library bytes (exit " + str(st) + ", " + str(count(txt)) + " chars, starts '" + slice(txt, 0, 60) + "')\n") else let w2 = fs_write_sync(inp, "@compile safetensors\nfn f(x: int) -> int = x + 1\n") in let st2 = sg_in(cfg.tool, inp, out) in if se_starts(fs_read_file(out), "ERR:") == 0 then ctfail("safetensors gate failed: build/bin/lneural_cartridge did not answer ERR: for a source without a `/ pure` function\n") else 1
fn sg_all(cfg, cases, py, acc, first) = match cases
    Nil        => acc
    Cons(h, t) => let r = sg_one(cfg, h, py) in let zt = if first == 1 then sg_tool(cfg, h, r) else 0 in sg_all(cfg, t, py, sg_add(acc, r), 0)
fn sg_main(input) = let root = sg_get(input, "root") in if root == "" then ctfail("safetensors gate requires @root\n") else let cfg = {root: root, dir: root + "/build/safetensors-gate", tmp: "/tmp/lume-safetensors-gate-" + str(os_getpid()), lumec: root + "/build/bin/lumec", lasm: root + "/build/bin/lasm", lcaas: root + "/build/bin/lcaas", certon: if sg_get(input, "lcaas") == "off" then 0 else 1, keep: if sg_get(input, "keep") == "1" then 1 else 0, tool: root + "/build/bin/lneural_cartridge"} in let m1 = os_run("/bin/mkdir", sg_l3("-p", cfg.dir, cfg.tmp)) in if fs_path_exists(cfg.tool) == 0 then ctfail("safetensors gate failed: build/bin/lneural_cartridge is missing (./lume build compiler/stage1/lneural_cartridge.src -o build/bin/lneural_cartridge)\n") else let py = sg_py_have(cfg) in let t0 = sg_ms() in let a = sg_all(cfg, sg_cases(), py, sg_acc0(), 1) in let t1 = sg_ms() in let rm = os_run("/bin/rm", sg_l2("-rf", cfg.tmp)) in "OK: " + str(a.n) + " verified Lume functions compiled to .safetensors cartridges in build/safetensors-gate/ (" + str(a.minsize) + " .. " + str(a.maxsize) + " B each, " + str(a.size) + " B total; tensors swiglu_gate_proj I32[128,128], swiglu_up_proj I32[128,128], swiglu_down_proj I64[16,128], deltanet_rom U32[n], ballast_rmsnorm_guard I64[16]); every file re-read byte by byte and validated field by field; " + (if cfg.certon == 1 then "kernel-verified lcert certificate embedded in each" else "CERTIFICATE STEP SKIPPED (@lcaas off): metadata records that no certificate was supplied") + "; forward pass over the file weights (SwiGLU K=128 + Gated DeltaNet) == native x86-64 == LumePuter emulator on " + str(a.vecs) + "/" + str(a.vecs) + " argument vectors (100.0% bit-exact, " + str(a.cyc) + " RV32IM cycles, cycle counts and trap causes identical to the emulator), " + str(a.traps) + " trap vectors agreed; tampering: " + str(a.rejects) + " damaged files rejected, " + str(a.romflips) + " reset-stub ROM flips with recomputed hashes all trapped or changed the result, " + str(a.aluhits) + " of " + str(a.aluflips) + " ADD/SUB opcode flips observable, " + str(a.n) + " lowered ballast entries tripped the guard, " + str(a.n) + " changed down-projection weights exposed; tool protocol == library bytes; " + (if py == 1 then "reference loader: python safetensors loaded every file" else "reference loader not installed (no python3 safetensors package on this host)") + "; time: certify+compile+write " + str(a.ms_compile) + " ms, read+validate+load+native build " + str(a.ms_load) + " ms, forward+native+emulator " + str(a.ms_fwd) + " ms, tamper " + str(a.ms_tamper) + " ms, total " + str(t1 - t0) + " ms [" + a.detail + "]"

print sg_main(readall())
