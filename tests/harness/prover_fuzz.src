## prover_fuzz.src -- adversarial false-theorem generator with a brute-force oracle (Pillar 2 of the audit gate).
##
## Every case draws random expressions/structures over a bounded integer box, evaluates them natively on every point of
## the box (the brute-force oracle), and derives contracts/laws that are FALSE at a concrete counterexample in the box
## alongside TRUE controls that hold across the entire box. Six domains are exercised on every campaign:
##   0. integers / `if` / `let` / `/` / `%` / `bit_and` / `bit_shl` / `bit_shr`;
##   1. records (`{a: ..., b: ...}`, `.a` / `.b` projection, nested records, and parameter `a` shadowing field `.a`);
##   2. canonical arrays (`array_new`, `array_store`, `array_get` / `array_select` with overwritten slots and out-of-sync indices);
##   3. separation / heap models (`heap_new`, `heap_write`, `points_to`, `heap_read`, `sep_conj`, `sep_valid`, `sep_disjoint`);
##   4. nested quantifiers (`forall_range` inside `exists_range` and `exists_range` inside `forall_range` with off-by-one bounds);
##   5. algebraic `law` declarations failing at concrete counterexamples (both sampler-visible and blinded).
## Across all 6 domains, 0 false theorems may be proven by `lumec`, `lcaas @mode prove`, or the `lcert` kernel.
use lcert

fn pf_prng(s) = (s * 1103515245 + 12345) % 2147483648
fn pf_pick(s, n) = s / 65536 % n
fn pf_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn pf_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else pf_contains_at(text, part, i + 1)
fn pf_contains(text, part) = pf_contains_at(text, part, 0)
fn pf_run(bin, args, out) = let st = os_run_capture_timeout(bin, args, out, out + ".err", 60000) in {status: pf_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn pf_input(bin, args, inp, out) = let st = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", 120000) in {status: pf_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err")}

## Fresh CSPRNG seed from /dev/urandom (4 bytes -> positive 31-bit seed in 1 .. 2147483647).
fn pf_urandom_seed() = let b0 = fs_read_byte("/dev/urandom", 0) in let b1 = fs_read_byte("/dev/urandom", 1) in let b2 = fs_read_byte("/dev/urandom", 2) in let b3 = fs_read_byte("/dev/urandom", 3) in if b0 < 0 or b1 < 0 or b2 < 0 or b3 < 0 then 1 + os_monotonic_ns() % 2147483646 else 1 + (b0 + b1 * 256 + b2 * 65536 + (b3 % 127) * 16777216) % 2147483646

## --- expressions: PC const, PX / PY parameters, PV let-bound, arithmetic, PIf(op, a, b, then, else), PLet(depth, value, body)
fn pf_small(s) = let k = pf_pick(s, 4) in if k == 0 then 2 else if k == 1 then 3 else if k == 2 then 5 else 7
fn pf_mask(s) = let k = pf_pick(s, 4) in if k == 0 then 1 else if k == 1 then 3 else if k == 2 then 7 else 15
fn pf_leaf(s, nlet) = let k = pf_pick(s, 5) in let s2 = pf_prng(s) in if k == 0 then {s: s2, e: PC(pf_pick(s2, 19) - 9)} else if k == 1 or k == 2 then {s: s2, e: PX} else if k == 3 or nlet <= 0 then {s: s2, e: PY} else {s: s2, e: PV(pf_pick(s2, nlet))}
fn pf_gen(s, depth, nlet) = let s1 = pf_prng(s) in if depth <= 0 then pf_leaf(s1, nlet) else pf_gen_k(s1, pf_pick(s1, 13), depth, nlet)
fn pf_gen_k(s, k, depth, nlet) = if k >= 12 then pf_leaf(s, nlet) else if k == 9 then pf_gen_let(s, depth, nlet) else if k == 7 or k == 8 then pf_gen_if(s, depth, nlet) else let l = pf_gen(s, depth - 1, nlet) in if k == 5 then {s: pf_prng(l.s), e: PDiv(l.e, pf_small(l.s))} else if k == 6 then {s: pf_prng(l.s), e: PMod(l.e, pf_small(l.s))} else if k == 10 then {s: pf_prng(l.s), e: PAnd(l.e, pf_mask(l.s))} else if k == 11 then {s: pf_prng(l.s), e: if pf_pick(l.s, 2) == 0 then PShl(l.e, 1 + pf_pick(pf_prng(l.s), 2)) else PShr(l.e, 1)} else let r = pf_gen(l.s, depth - 1, nlet) in if k <= 1 then {s: r.s, e: PAdd(l.e, r.e)} else if k == 2 then {s: r.s, e: PSub(l.e, r.e)} else {s: r.s, e: PMul(l.e, r.e)}
fn pf_gen_let(s, depth, nlet) = let a = pf_gen(s, depth - 1, nlet) in let b = pf_gen(a.s, depth - 1, nlet + 1) in {s: b.s, e: PLet(nlet, a.e, b.e)}
fn pf_gen_if(s, depth, nlet) = let c1 = pf_gen(s, depth - 2, nlet) in let c2 = pf_gen(c1.s, depth - 2, nlet) in let t = pf_gen(c2.s, depth - 1, nlet) in let e = pf_gen(t.s, depth - 1, nlet) in {s: pf_prng(e.s), e: PIf(pf_pick(e.s, 5), c1.e, c2.e, t.e, e.e)}

## Linear-friendly subexpressions for structured theories so true controls are QF_LIA-provable while false ones fail.
fn pf_lin_expr(s) = let s1 = pf_prng(s) in let s2 = pf_prng(s1) in let s3 = pf_prng(s2) in let cx = (pf_pick(s1, 5) - 2) in let cy = (pf_pick(s2, 5) - 2) in let c0 = pf_pick(s3, 13) - 6 in let cx2 = if cx == 0 and cy == 0 then 1 else cx in {s: s3, cx: cx2, cy: cy, c0: c0}
fn pf_lin_eval(le, x, y) = le.cx * x + le.cy * y + le.c0
fn pf_lin_show(le, xnm, ynm) = "((" + pf_lit(le.cx) + " * " + xnm + ") + (" + pf_lit(le.cy) + " * " + ynm + ") + " + pf_lit(le.c0) + ")"
fn pf_lin_sx(le, xnm, ynm) = "(+ (+ (* " + str(le.cx) + " " + xnm + ") (* " + str(le.cy) + " " + ynm + ")) " + str(le.c0) + ")"

fn pf_lit(c) = if c < 0 then "(0 - " + str(0 - c) + ")" else str(c)
fn pf_op(op) = if op == 0 then "<" else if op == 1 then "<=" else if op == 2 then "==" else if op == 3 then ">=" else "!="
fn pf_show_v(e, xnm) = match e
    PC(c)                => pf_lit(c)
    PX                   => xnm
    PY                   => "y"
    PV(d)                => "t" + str(d)
    PAdd(a, b)           => "(" + pf_show_v(a, xnm) + " + " + pf_show_v(b, xnm) + ")"
    PSub(a, b)           => "(" + pf_show_v(a, xnm) + " - " + pf_show_v(b, xnm) + ")"
    PMul(a, b)           => "(" + pf_show_v(a, xnm) + " * " + pf_show_v(b, xnm) + ")"
    PDiv(a, k)           => "(" + pf_show_v(a, xnm) + " / " + str(k) + ")"
    PMod(a, k)           => "(" + pf_show_v(a, xnm) + " % " + str(k) + ")"
    PAnd(a, k)           => "bit_and(" + pf_show_v(a, xnm) + ", " + str(k) + ")"
    PShl(a, k)           => "bit_shl(" + pf_show_v(a, xnm) + ", " + str(k) + ")"
    PShr(a, k)           => "bit_shr(" + pf_show_v(a, xnm) + ", " + str(k) + ")"
    PIf(op, a, b, t, e2) => "(if " + pf_show_v(a, xnm) + " " + pf_op(op) + " " + pf_show_v(b, xnm) + " then " + pf_show_v(t, xnm) + " else " + pf_show_v(e2, xnm) + ")"
    PLet(d, a, b)        => "(let t" + str(d) + " = " + pf_show_v(a, xnm) + " in " + pf_show_v(b, xnm) + ")"
fn pf_show(e) = pf_show_v(e, "x")

## the same expression as an S-expression proof term (the syntax lcaas emits and the kernel reads)
fn pf_sx_v(e, xnm) = match e
    PC(c)                => str(c)
    PX                   => xnm
    PY                   => "y"
    PV(d)                => "t" + str(d)
    PAdd(a, b)           => "(+ " + pf_sx_v(a, xnm) + " " + pf_sx_v(b, xnm) + ")"
    PSub(a, b)           => "(- " + pf_sx_v(a, xnm) + " " + pf_sx_v(b, xnm) + ")"
    PMul(a, b)           => "(* " + pf_sx_v(a, xnm) + " " + pf_sx_v(b, xnm) + ")"
    PDiv(a, k)           => "(/ " + pf_sx_v(a, xnm) + " " + str(k) + ")"
    PMod(a, k)           => "(% " + pf_sx_v(a, xnm) + " " + str(k) + ")"
    PAnd(a, k)           => "(bit_and " + pf_sx_v(a, xnm) + " " + str(k) + ")"
    PShl(a, k)           => "(bit_shl " + pf_sx_v(a, xnm) + " " + str(k) + ")"
    PShr(a, k)           => "(bit_shr " + pf_sx_v(a, xnm) + " " + str(k) + ")"
    PIf(op, a, b, t, e2) => "(if (" + pf_op(op) + " " + pf_sx_v(a, xnm) + " " + pf_sx_v(b, xnm) + ") " + pf_sx_v(t, xnm) + " " + pf_sx_v(e2, xnm) + ")"
    PLet(d, a, b)        => "(let t" + str(d) + " " + pf_sx_v(a, xnm) + " " + pf_sx_v(b, xnm) + ")"
fn pf_sx(e) = pf_sx_v(e, "x")

fn pf_claim_sx_v(k, a, pt, b, xnm) = if k == 0 then "(>= " + b + " " + str(a.mn) + ")" else if k == 1 then "(<= " + b + " " + str(a.mx) + ")" else if k == 2 then "(<= " + b + " " + str(a.mx - 1) + ")" else if k == 3 then "(>= " + b + " " + str(a.mn + 1) + ")" else if k == 4 then "(!= " + b + " " + str(pt.v) + ")" else if k == 5 then "(<= (- " + b + " " + xnm + ") " + str(a.rm - 1) + ")" else if k == 6 then "(or (or (!= " + xnm + " " + str(pt.x) + ") (!= y " + str(pt.y) + ")) (!= " + b + " " + str(pt.v) + "))" else if a.df == 1 then "(== " + b + " " + xnm + ")" else "(> " + b + " " + str(a.mn) + ")"
fn pf_claim_sx(k, a, pt, b) = pf_claim_sx_v(k, a, pt, b, "x")
fn pf_box_sx_v(bx, xnm) = "(and (>= " + xnm + " " + str(bx.xlo) + ") (<= " + xnm + " " + str(bx.xhi) + ") (>= y " + str(bx.ylo) + ") (<= y " + str(bx.yhi) + "))"
fn pf_term_v(k, cs, xnm) = "(implies " + pf_box_sx_v(cs.bx, xnm) + " " + pf_claim_sx_v(k, cs.a, cs.pt, cs.bsx, xnm) + ")"
fn pf_term(k, cs) = pf_term_v(k, cs, "x")
fn pf_kernel_false_v(k, cs, tag, xnm) = if k > 7 then "" else if lk_prove_term(pf_term_v(k, cs, xnm)) == 1 then "UNSOUND (lcert kernel): false theorem " + pf_name(k) + " of " + tag + " was re-derived from its proof term: " + pf_term_v(k, cs, xnm) else pf_kernel_false_v(k + 1, cs, tag, xnm)
fn pf_kernel_false(k, cs, tag) = pf_kernel_false_v(k, cs, tag, "x")
fn pf_kernel_true_v(cs, xnm) = lk_prove_term(pf_term_v(0, cs, xnm)) + lk_prove_term(pf_term_v(1, cs, xnm))
fn pf_kernel_true(cs) = pf_kernel_true_v(cs, "x")

fn pf_env(d, env) = match env
    Nil        => 0
    Cons(h, t) => if h.d == d then h.v else pf_env(d, t)
fn pf_cmp(op, a, b) = if op == 0 then a < b else if op == 1 then a <= b else if op == 2 then a == b else if op == 3 then a >= b else a != b
## the oracle: the gate's own native arithmetic (trapping + - *, truncating / and %, 64-bit two's complement bit ops)
fn pf_eval(e, x, y, env) = match e
    PC(c)                => c
    PX                   => x
    PY                   => y
    PV(d)                => pf_env(d, env)
    PAdd(a, b)           => pf_eval(a, x, y, env) + pf_eval(b, x, y, env)
    PSub(a, b)           => pf_eval(a, x, y, env) - pf_eval(b, x, y, env)
    PMul(a, b)           => pf_eval(a, x, y, env) * pf_eval(b, x, y, env)
    PDiv(a, k)           => pf_eval(a, x, y, env) / k
    PMod(a, k)           => pf_eval(a, x, y, env) % k
    PAnd(a, k)           => bit_and(pf_eval(a, x, y, env), k)
    PShl(a, k)           => bit_shl(pf_eval(a, x, y, env), k)
    PShr(a, k)           => bit_shr(pf_eval(a, x, y, env), k)
    PIf(op, a, b, t, e2) => if pf_cmp(op, pf_eval(a, x, y, env), pf_eval(b, x, y, env)) then pf_eval(t, x, y, env) else pf_eval(e2, x, y, env)
    PLet(d, a, b)        => pf_eval(b, x, y, Cons({d: d, v: pf_eval(a, x, y, env)}, env))

## --- exhaustive scan of the box: minimum, maximum, maximum of (e - x), and a point where e != x, each with its witness
fn pf_acc0() = {n: 0, mn: 0, mnx: 0, mny: 0, mx: 0, mxx: 0, mxy: 0, rm: 0, rx: 0, ry: 0, df: 0, dx: 0, dy: 0}
fn pf_acc(a, x, y, v) = let first = if a.n == 0 then 1 else 0 in let lo = if first == 1 or v < a.mn then 1 else 0 in let hi = if first == 1 or v > a.mx then 1 else 0 in let rel = if first == 1 or v - x > a.rm then 1 else 0 in let dif = if a.df == 0 and v != x then 1 else 0 in {n: a.n + 1, mn: if lo == 1 then v else a.mn, mnx: if lo == 1 then x else a.mnx, mny: if lo == 1 then y else a.mny, mx: if hi == 1 then v else a.mx, mxx: if hi == 1 then x else a.mxx, mxy: if hi == 1 then y else a.mxy, rm: if rel == 1 then v - x else a.rm, rx: if rel == 1 then x else a.rx, ry: if rel == 1 then y else a.ry, df: if dif == 1 then 1 else a.df, dx: if dif == 1 then x else a.dx, dy: if dif == 1 then y else a.dy}
fn pf_scan_y(e, x, y, yhi, a) = if y > yhi then a else pf_scan_y(e, x, y + 1, yhi, pf_acc(a, x, y, pf_eval(e, x, y, Nil)))
fn pf_scan(e, x, bx, a) = if x > bx.xhi then a else pf_scan(e, x + 1, bx, pf_scan_y(e, x, bx.ylo, bx.yhi, a))
fn pf_box(s) = let s1 = pf_prng(s) in let s2 = pf_prng(s1) in let s3 = pf_prng(s2) in let s4 = pf_prng(s3) in let xlo = if pf_pick(s1, 3) == 0 then 0 else pf_pick(s1, 11) - 5 in let ylo = if pf_pick(s3, 3) == 0 then 1 else pf_pick(s3, 11) - 5 in {s: s4, xlo: xlo, xhi: xlo + 2 + pf_pick(s2, 9), ylo: ylo, yhi: ylo + 2 + pf_pick(s4, 9)}

## --- contracts. k = 0, 1 are TRUE (the controls); k >= 2 are FALSE at the returned point (cx, cy).
fn pf_claim_v(k, a, pt, xnm) = if k == 0 then {c: "result >= " + pf_lit(a.mn), cx: pt.x, cy: pt.y} else if k == 1 then {c: "result <= " + pf_lit(a.mx), cx: pt.x, cy: pt.y} else if k == 2 then {c: "result <= " + pf_lit(a.mx - 1), cx: a.mxx, cy: a.mxy} else if k == 3 then {c: "result >= " + pf_lit(a.mn + 1), cx: a.mnx, cy: a.mny} else if k == 4 then {c: "result != " + pf_lit(pt.v), cx: pt.x, cy: pt.y} else if k == 5 then {c: "result - " + xnm + " <= " + pf_lit(a.rm - 1), cx: a.rx, cy: a.ry} else if k == 6 then {c: xnm + " != " + pf_lit(pt.x) + " or y != " + pf_lit(pt.y) + " or result != " + pf_lit(pt.v), cx: pt.x, cy: pt.y} else if a.df == 1 then {c: "result == " + xnm, cx: a.dx, cy: a.dy} else {c: "result > " + pf_lit(a.mn), cx: a.mnx, cy: a.mny}
fn pf_claim(k, a, pt) = pf_claim_v(k, a, pt, "x")
fn pf_name(k) = if k == 0 then "c_lo" else if k == 1 then "c_hi" else "f" + str(k)
fn pf_reqs_v(bx, xnm) = xnm + " >= " + pf_lit(bx.xlo) + " and " + xnm + " <= " + pf_lit(bx.xhi) + " and y >= " + pf_lit(bx.ylo) + " and y <= " + pf_lit(bx.yhi)
fn pf_reqs(bx) = pf_reqs_v(bx, "x")
fn pf_blind_fn_v(k, bx, claim, body, form, xnm) = "fn " + pf_name(k) + "(" + xnm + ": int, y: int, z: int) -> int requires z <= 0 - 1 and " + pf_reqs_v(bx, xnm) + " ensures " + claim + " = " + (if form == 0 then "let w0 = bit_and(z, 0) in " + body else body + " + bit_and(z, 0)") + "\n"
fn pf_blind_fns_v(k, cs, xnm) = if k > 7 then "" else pf_blind_fn_v(k, cs.bx, (pf_claim_v(k, cs.a, cs.pt, xnm)).c, cs.body, (cs.form + k) % 2, xnm) + pf_blind_fns_v(k + 1, cs, xnm)
fn pf_blind_pick_v(k, cs, xnm) = if k > 7 then "0" else let cl = pf_claim_v(k, cs.a, cs.pt, xnm) in "if sel == " + str(k) + " then " + pf_name(k) + "(" + pf_lit(cl.cx) + ", " + pf_lit(cl.cy) + ", 0 - 1) else " + pf_blind_pick_v(k + 1, cs, xnm)
fn pf_blind_src_p(prol, cs, xnm) = prol + pf_blind_fns_v(0, cs, xnm) + "fn pick(sel: int) -> int = " + pf_blind_pick_v(0, cs, xnm) + "\nprint pick(toint(os_arg_at(1)))\n"
fn pf_plain_src_p(prol, k, cs, xnm) = let cl = pf_claim_v(k, cs.a, cs.pt, xnm) in prol + "fn g(" + xnm + ": int, y: int) -> int requires " + pf_reqs_v(cs.bx, xnm) + " ensures " + cl.c + " = " + cs.body + "\nprint g(" + pf_lit(cl.cx) + ", " + pf_lit(cl.cy) + ")\n"

fn pf_proven_kind(out, name, kind) = pf_contains(out, "\"name\":\"" + name + "\",\"kind\":\"" + kind + "\",\"status\":\"proven\"")
fn pf_proven(out, name) = pf_proven_kind(out, name, "contract")
fn pf_syntax(text) = if pf_contains(text, "P0001") == 1 or pf_contains(text, "P0002") == 1 then 1 else 0
fn pf_caas(cfg, tag, src) = let inp = cfg.tmp + "/" + tag + ".prove.in" in let w = fs_write_sync(inp, "@mode prove\n" + src) in pf_input(cfg.lcaas, Nil, inp, cfg.tmp + "/" + tag + ".prove.out")
fn pf_caas_false(out, k, tag) = if k > 7 then "" else if pf_proven(out, pf_name(k)) == 1 then "UNSOUND (lcaas): false theorem " + pf_name(k) + " of " + tag + " is reported as proven" else pf_caas_false(out, k + 1, tag)

## run selector k of the blinded program: the controls must print the oracle's value, a false theorem must die on its check
fn pf_exec_val(cfg, tag, k, want_v) = let r = pf_run(cfg.tmp + "/" + tag + ".elf", Cons(str(k), Nil), cfg.tmp + "/" + tag + ".run" + str(k)) in if k <= 1 then (if r.status != 0 or r.out != str(want_v) + "\n" then "control " + pf_name(k) + " of " + tag + " (a TRUE contract) did not print the oracle value " + str(want_v) + ": status " + str(r.status) + " out " + r.out + r.err else "") else if r.status == 0 then "UNSOUND (lumec): false theorem " + pf_name(k) + " of " + tag + " ran to completion at its counterexample (the compiler proved it and elided the check), printed " + r.out else if pf_contains(r.err, "runtime contract violation (ensures)") == 0 then "false theorem " + pf_name(k) + " of " + tag + " died for another reason: " + r.err else ""
fn pf_exec_all(cfg, tag, k, cs) = if k > 7 then "" else let e = pf_exec_val(cfg, tag, k, cs.pt.v) in if e != "" then e else pf_exec_all(cfg, tag, k + 1, cs)
fn pf_build(cfg, tag, src) = let sp = cfg.tmp + "/" + tag + ".src" in let w = fs_write_sync(sp, src) in let c = pf_input(cfg.lumec, Nil, sp, cfg.tmp + "/" + tag + ".s") in if c.status != 0 then {ok: 0, err: c.err} else let a = pf_run(cfg.lasm, Cons("--strict", Cons(cfg.tmp + "/" + tag + ".s", Nil)), cfg.tmp + "/" + tag + ".elf") in if a.status != 0 then {ok: 0 - 1, err: a.err} else let m = os_run("/bin/chmod", Cons("+x", Cons(cfg.tmp + "/" + tag + ".elf", Nil))) in {ok: 1, err: ""}

fn pf_blind_case_p(cfg, tag, prol, cs, xnm) = let src = pf_blind_src_p(prol, cs, xnm) in let b = pf_build(cfg, tag, src) in let p = pf_caas(cfg, tag, src) in let ce = pf_caas_false(p.out, 2, tag) in if ce != "" then {err: ce, traps: 0, rejects: 0} else if b.ok < 0 then {err: "lasm rejected compiler output for " + tag + ": " + b.err, traps: 0, rejects: 0} else if b.ok == 0 then (if pf_syntax(b.err) == 1 or pf_contains(b.err, "[V0001]") == 0 then {err: "lumec rejected blinded case " + tag + " without [V0001]: " + b.err, traps: 0, rejects: 0} else {err: "", traps: 0, rejects: 1}) else let e = pf_exec_all(cfg, tag, 0, cs) in {err: e, traps: if e == "" then 6 else 0, rejects: 0}
fn pf_plain_src_run(cfg, tag, src) = let b = pf_build(cfg, tag, src) in let p = pf_caas(cfg, tag, src) in if pf_proven(p.out, "g") == 1 then {err: "UNSOUND (lcaas): false theorem g of " + tag + " is reported as proven", traps: 0, rejects: 0} else if b.ok < 0 then {err: "lasm rejected compiler output for " + tag + ": " + b.err, traps: 0, rejects: 0} else if b.ok == 0 then (if pf_syntax(b.err) == 1 or pf_contains(b.err, "[V0001]") == 0 then {err: "lumec rejected false theorem " + tag + " without [V0001]: " + b.err, traps: 0, rejects: 0} else {err: "", traps: 0, rejects: 1}) else let r = pf_run(cfg.tmp + "/" + tag + ".elf", Nil, cfg.tmp + "/" + tag + ".run") in if r.status == 0 then {err: "UNSOUND (lumec): false theorem g of " + tag + " ran to completion at its counterexample, printed " + r.out, traps: 0, rejects: 0} else if pf_contains(r.err, "runtime contract violation (ensures)") == 0 then {err: "false theorem g of " + tag + " died for another reason: " + r.err, traps: 0, rejects: 0} else {err: "", traps: 1, rejects: 0}
fn pf_plain_case_p(cfg, tag, prol, k, cs, xnm) = pf_plain_src_run(cfg, tag, pf_plain_src_p(prol, k, cs, xnm))

fn pf_point(s, bx, e) = let s1 = pf_prng(s) in let x = bx.xlo + pf_pick(s, bx.xhi - bx.xlo + 1) in let y = bx.ylo + pf_pick(s1, bx.yhi - bx.ylo + 1) in {x: x, y: y, v: pf_eval(e, x, y, Nil)}

## --- Domain 0: integers / if / let / div / mod / bit_* -----------------------------------------------------------------
fn pf_arith_case(cfg, idx, seed) = let g = pf_gen(seed, 2 + pf_pick(seed, 2), 0) in let bx = pf_box(g.s) in let a = pf_scan(g.e, bx.xlo, bx, pf_acc0()) in let pt = pf_point(bx.s, bx, g.e) in let cs = {bx: bx, a: a, pt: pt, body: pf_show(g.e), bsx: pf_sx(g.e), form: idx % 2} in let ke = pf_kernel_false(2, cs, "pf" + str(idx)) in if ke != "" then {err: ke, traps: 0, rejects: 0, kt: 0} else let r1 = pf_blind_case_p(cfg, "pf" + str(idx) + "b", "", cs, "x") in if r1.err != "" then {err: r1.err + "\n  program: " + cfg.tmp + "/pf" + str(idx) + "b.src", traps: 0, rejects: 0, kt: 0} else let r2 = pf_plain_case_p(cfg, "pf" + str(idx) + "p", "", 2 + idx % 6, cs, "x") in if r2.err != "" then {err: r2.err + "\n  program: " + cfg.tmp + "/pf" + str(idx) + "p.src", traps: 0, rejects: 0, kt: 0} else {err: "", traps: r1.traps + r2.traps, rejects: r1.rejects + r2.rejects, kt: pf_kernel_true(cs)}

## --- Domain 1: records ({a: ..., b: ...}, .a / .b projections, nested records, shadowing field `a` vs param `a`) -------
fn pf_rec_prol() = "type RPair = {a: int, b: int}\n"
fn pf_rec_eval(kind, l1, l2, a, y) = let v1 = pf_lin_eval(l1, a, y) in let v2 = pf_lin_eval(l2, a, y) in if kind == 0 then v1 + v2 - a else if kind == 1 then (v2 + 1) + v1 - v2 else if kind == 2 then (if v1 <= v2 then v1 - v2 + a else v2 - v1 + a) else (v1 + a) - v2
fn pf_rec_body(kind, l1, l2) = let s1 = pf_lin_show(l1, "a", "y") in let s2 = pf_lin_show(l2, "a", "y") in if kind == 0 then "(let r = {a: " + s1 + ", b: " + s2 + "} in r.a + r.b - a)" else if kind == 1 then "(let r = RPair {a: " + s1 + ", b: " + s2 + "} in let a = r.b in ({a: a + 1, b: r.a}).a + r.a - a)" else if kind == 2 then "(let r = (if " + s1 + " <= " + s2 + " then {a: " + s1 + ", b: " + s2 + "} else {a: " + s2 + ", b: " + s1 + "}) in r.a - r.b + a)" else "(({a: " + s1 + " + a, b: " + s2 + " - y}).a - ({a: y, b: " + s2 + "}).b)"
fn pf_rec_bsx(kind, l1, l2) = let x1 = pf_lin_sx(l1, "a", "y") in let x2 = pf_lin_sx(l2, "a", "y") in if kind == 0 then "(- (+ " + x1 + " " + x2 + ") a)" else if kind == 1 then "(- (+ (+ " + x2 + " 1) " + x1 + ") " + x2 + ")" else if kind == 2 then "(if (<= " + x1 + " " + x2 + ") (+ (- " + x1 + " " + x2 + ") a) (+ (- " + x2 + " " + x1 + ") a))" else "(- (+ " + x1 + " a) " + x2 + ")"
fn pf_rec_scan_y(kind, l1, l2, x, y, yhi, acc) = if y > yhi then acc else pf_rec_scan_y(kind, l1, l2, x, y + 1, yhi, pf_acc(acc, x, y, pf_rec_eval(kind, l1, l2, x, y)))
fn pf_rec_scan(kind, l1, l2, x, bx, acc) = if x > bx.xhi then acc else pf_rec_scan(kind, l1, l2, x + 1, bx, pf_rec_scan_y(kind, l1, l2, x, bx.ylo, bx.yhi, acc))
fn pf_rec_field_kernel(bx, tag) = let hyp = "(and (>= (field p a) " + str(bx.xlo) + ") (<= (field p a) " + str(bx.xhi) + ") (>= (field p b) " + str(bx.ylo) + ") (<= (field p b) " + str(bx.yhi) + "))" in let tf1 = "(implies " + hyp + " (<= (+ (field p a) (field p b)) " + str(bx.xhi + bx.yhi - 1) + "))" in let tf2 = "(implies " + hyp + " (== (field p a) (+ (field p a) 1)))" in let tt1 = "(implies " + hyp + " (<= (+ (field p a) (field p b)) " + str(bx.xhi + bx.yhi) + "))" in if lk_prove_term(tf1) == 1 then {err: "UNSOUND (lcert kernel): false record field bound in " + tag + ": " + tf1, kt: 0} else if lk_prove_term(tf2) == 1 then {err: "UNSOUND (lcert kernel): false record field identity in " + tag + ": " + tf2, kt: 0} else {err: "", kt: lk_prove_term(tt1)}
fn pf_rec_ret_plain(cfg, tag, bx, l1, l2, a) = let s1 = pf_lin_show(l1, "a", "y") in let s2 = pf_lin_show(l2, "a", "y") in let cx = if a.df == 1 then a.dx else a.mxx in let cy = if a.df == 1 then a.dy else a.mxy in let v1 = pf_lin_eval(l1, cx, cy) in let bad_ens = if v1 != cx then "result.a == a" else "result.a <= " + pf_lit(v1 - 1) in let src = pf_rec_prol() + "fn g(a: int, y: int) -> RPair requires " + pf_reqs_v(bx, "a") + " ensures " + bad_ens + " = RPair {a: " + s1 + ", b: " + s2 + "}\nprint (g(" + pf_lit(cx) + ", " + pf_lit(cy) + ")).a\n" in pf_plain_src_run(cfg, tag, src)
fn pf_rec_case(cfg, idx, seed) = let l1 = pf_lin_expr(seed) in let l2 = pf_lin_expr(l1.s) in let bx = pf_box(l2.s) in let kind = pf_pick(bx.s, 4) in let a = pf_rec_scan(kind, l1, l2, bx.xlo, bx, pf_acc0()) in let px = bx.xlo + pf_pick(bx.s, bx.xhi - bx.xlo + 1) in let py = bx.ylo + pf_pick(pf_prng(bx.s), bx.yhi - bx.ylo + 1) in let pt = {x: px, y: py, v: pf_rec_eval(kind, l1, l2, px, py)} in let cs = {bx: bx, a: a, pt: pt, body: pf_rec_body(kind, l1, l2), bsx: pf_rec_bsx(kind, l1, l2), form: idx % 2} in let tag = "pf" + str(idx) + "rec" in let ke = pf_kernel_false_v(2, cs, tag, "a") in if ke != "" then {err: ke, traps: 0, rejects: 0, kt: 0} else let fk = pf_rec_field_kernel(bx, tag) in if fk.err != "" then {err: fk.err, traps: 0, rejects: 0, kt: 0} else let r1 = pf_blind_case_p(cfg, tag + "b", pf_rec_prol(), cs, "a") in if r1.err != "" then {err: r1.err + "\n  program: " + cfg.tmp + "/" + tag + "b.src", traps: 0, rejects: 0, kt: 0} else let r2 = if idx % 2 == 0 then pf_rec_ret_plain(cfg, tag + "p", bx, l1, l2, a) else pf_plain_case_p(cfg, tag + "p", pf_rec_prol(), 2 + idx % 6, cs, "a") in if r2.err != "" then {err: r2.err + "\n  program: " + cfg.tmp + "/" + tag + "p.src", traps: 0, rejects: 0, kt: 0} else {err: "", traps: r1.traps + r2.traps, rejects: r1.rejects + r2.rejects, kt: pf_kernel_true_v(cs, "a") + fk.kt}

## --- Domain 2: canonical arrays (array_new, array_store, array_get / array_select, overwritten & out-of-sync slots) ----
fn pf_arr_prol() = "type Arr = enum\n    | ArrConst(int)\n    | ArrWrite(Arr, int, int)\nfn array_new(v: int) -> Arr = ArrConst(v)\nfn array_store(a: Arr, i: int, v: int) -> Arr = ArrWrite(a, i, v)\nfn array_select(a: Arr, i: int) -> int = match a\n    ArrConst(v) => v\n    ArrWrite(base, k, v) => if i == k then v else array_select(base, i)\nfn array_get(a: Arr, i: int) -> int = array_select(a, i)\n"
fn pf_arr_eval(kind, d0, off, l1, l2, x, y) = let v1 = pf_lin_eval(l1, x, y) in let v2 = pf_lin_eval(l2, x, y) + 11 in if kind == 0 then v2 else if kind == 1 then (if y == x then v1 else d0) else if kind == 2 then d0 else if x == y then v2 else v1
fn pf_arr_body(kind, get_nm, d0, off, l1, l2) = let s1 = pf_lin_show(l1, "x", "y") in let s2 = "(" + pf_lin_show(l2, "x", "y") + " + 11)" in let d = pf_lit(d0) in let xo = "(x + " + pf_lit(off) + ")" in if kind == 0 then "(let arr = array_store(array_store(array_new(" + d + "), " + xo + ", " + s1 + "), " + xo + ", " + s2 + ") in " + get_nm + "(arr, " + xo + "))" else if kind == 1 then "(let arr = array_store(array_new(" + d + "), x, " + s1 + ") in " + get_nm + "(arr, y))" else if kind == 2 then "(let arr = array_store(array_store(array_new(" + d + "), x, " + s1 + "), x + 1, " + s2 + ") in " + get_nm + "(arr, x + 2))" else "(let arr = array_store(array_store(array_new(" + d + "), x, " + s1 + "), y, " + s2 + ") in " + get_nm + "(arr, x))"
fn pf_arr_bsx(kind, d0, off, l1, l2) = let x1 = pf_lin_sx(l1, "x", "y") in let x2 = "(+ " + pf_lin_sx(l2, "x", "y") + " 11)" in let xo = "(+ x " + str(off) + ")" in if kind == 0 then "(array_select (array_store (array_store (array_new " + str(d0) + ") " + xo + " " + x1 + ") " + xo + " " + x2 + ") " + xo + ")" else if kind == 1 then "(array_select (array_store (array_new " + str(d0) + ") x " + x1 + ") y)" else if kind == 2 then "(array_select (array_store (array_store (array_new " + str(d0) + ") x " + x1 + ") (+ x 1) " + x2 + ") (+ x 2))" else "(array_select (array_store (array_store (array_new " + str(d0) + ") x " + x1 + ") y " + x2 + ") x)"
fn pf_arr_scan_y(kind, d0, off, l1, l2, x, y, yhi, acc) = if y > yhi then acc else pf_arr_scan_y(kind, d0, off, l1, l2, x, y + 1, yhi, pf_acc(acc, x, y, pf_arr_eval(kind, d0, off, l1, l2, x, y)))
fn pf_arr_scan(kind, d0, off, l1, l2, x, bx, acc) = if x > bx.xhi then acc else pf_arr_scan(kind, d0, off, l1, l2, x + 1, bx, pf_arr_scan_y(kind, d0, off, l1, l2, x, bx.ylo, bx.yhi, acc))
fn pf_arr_ov_y(kind, d0, off, l1, l2, x, y, yhi) = if y > yhi then {ok: 0, x: 0, y: 0} else if pf_arr_eval(kind, d0, off, l1, l2, x, y) != pf_lin_eval(l1, x, y) then {ok: 1, x: x, y: y} else pf_arr_ov_y(kind, d0, off, l1, l2, x, y + 1, yhi)
fn pf_arr_ov(kind, d0, off, l1, l2, x, bx) = if x > bx.xhi then {ok: 0, x: 0, y: 0} else let r = pf_arr_ov_y(kind, d0, off, l1, l2, x, bx.ylo, bx.yhi) in if r.ok == 1 then r else pf_arr_ov(kind, d0, off, l1, l2, x + 1, bx)
fn pf_arr_extra_kernel(bx, d0, l1, l2, tag) = let x1 = pf_lin_sx(l1, "x", "y") in let x2 = "(+ " + pf_lin_sx(l2, "x", "y") + " 11)" in let hyp = pf_box_sx_v(bx, "x") in let f_ov = "(implies " + hyp + " (== (array_select (array_store (array_store (array_new " + str(d0) + ") x 3) x 9) x) 3))" in let f_idx = "(implies " + hyp + " (== (array_select (array_store (array_new 0) x 7) (+ x 1)) 7))" in let t_row = "(implies " + hyp + " (== (array_select (array_store (array_new " + str(d0) + ") x " + x1 + ") x) " + x1 + "))" in let t_frm = "(implies " + hyp + " (== (array_select (array_store (array_store (array_new " + str(d0) + ") x " + x1 + ") (+ x 1) " + x2 + ") x) " + x1 + "))" in if lk_prove_term(f_ov) == 1 then {err: "UNSOUND (lcert kernel): proved overwritten array slot in " + tag, kt: 0} else if lk_prove_term(f_idx) == 1 then {err: "UNSOUND (lcert kernel): proved out-of-sync array index in " + tag, kt: 0} else {err: "", kt: lk_prove_term(t_row) + lk_prove_term(t_frm)}
fn pf_arr_case(cfg, idx, seed) = let l1 = pf_lin_expr(seed) in let l2 = pf_lin_expr(l1.s) in let bx0 = pf_box(l2.s) in let bx = {s: bx0.s, xlo: bx0.xlo, xhi: bx0.xhi, ylo: bx0.xlo, yhi: bx0.xhi} in let s1 = pf_prng(bx.s) in let kind = pf_pick(s1, 4) in let d0 = pf_pick(pf_prng(s1), 9) - 4 in let off = pf_pick(s1, 5) - 2 in let get_nm = if idx % 2 == 0 then "array_get" else "array_select" in let a = pf_arr_scan(kind, d0, off, l1, l2, bx.xlo, bx, pf_acc0()) in let px = bx.xlo + pf_pick(s1, bx.xhi - bx.xlo + 1) in let py = bx.ylo + pf_pick(pf_prng(s1), bx.yhi - bx.ylo + 1) in let pt = {x: px, y: py, v: pf_arr_eval(kind, d0, off, l1, l2, px, py)} in let cs = {bx: bx, a: a, pt: pt, body: pf_arr_body(kind, get_nm, d0, off, l1, l2), bsx: pf_arr_bsx(kind, d0, off, l1, l2), form: idx % 2} in let tag = "pf" + str(idx) + "arr" in let ke = pf_kernel_false(2, cs, tag) in if ke != "" then {err: ke, traps: 0, rejects: 0, kt: 0} else let ak = pf_arr_extra_kernel(bx, d0, l1, l2, tag) in if ak.err != "" then {err: ak.err, traps: 0, rejects: 0, kt: 0} else let r1 = pf_blind_case_p(cfg, tag + "b", pf_arr_prol(), cs, "x") in if r1.err != "" then {err: r1.err + "\n  program: " + cfg.tmp + "/" + tag + "b.src", traps: 0, rejects: 0, kt: 0} else let ov = pf_arr_ov(kind, d0, off, l1, l2, bx.xlo, bx) in let r2 = if ov.ok == 1 then pf_plain_src_run(cfg, tag + "p", pf_arr_prol() + "fn g(x: int, y: int) -> int requires " + pf_reqs(bx) + " ensures result == " + pf_lin_show(l1, "x", "y") + " = " + cs.body + "\nprint g(" + pf_lit(ov.x) + ", " + pf_lit(ov.y) + ")\n") else pf_plain_case_p(cfg, tag + "p", pf_arr_prol(), 2 + idx % 6, cs, "x") in if r2.err != "" then {err: r2.err + "\n  program: " + cfg.tmp + "/" + tag + "p.src", traps: 0, rejects: 0, kt: 0} else {err: "", traps: r1.traps + r2.traps, rejects: r1.rejects + r2.rejects, kt: pf_kernel_true(cs) + ak.kt}

## --- Domain 3: separation / heap models (heap_new, heap_write, points_to, heap_read, sep_conj, sep_valid, sep_disjoint)
fn pf_heap_prol_base() = "type SepHeap = enum\n    | SepPts(int, int)\n    | SepJoin(SepHeap, SepHeap)\n    | SepWrite(SepHeap, int, int)\nfn points_to(p: int, v: int) -> SepHeap = SepPts(p, v)\nfn sep_conj(h1: SepHeap, h2: SepHeap) -> SepHeap = SepJoin(h1, h2)\nfn sep_disjoint(p: int, q: int) -> int = if p != q then 1 else 0\nfn heap_write(h: SepHeap, p: int, v: int) -> SepHeap = SepWrite(h, p, v)\nfn heap_read(h: SepHeap, p: int) -> int = match h\n    SepPts(q, v) => if p == q then v else 0\n    SepJoin(h1, h2) => let r1 = heap_read(h1, p) in if r1 != 0 then r1 else heap_read(h2, p)\n    SepWrite(base, q, v) => if p == q then v else heap_read(base, p)\nfn sep_dom(h: SepHeap) -> int = match h\n    SepPts(p, v) => p\n    SepJoin(h1, h2) => sep_dom(h1)\n    SepWrite(base, p, v) => sep_dom(base)\nfn sep_valid(h: SepHeap) -> int = match h\n    SepPts(p, v) => 1\n    SepJoin(h1, h2) => if sep_dom(h1) != sep_dom(h2) and sep_valid(h1) == 1 and sep_valid(h2) == 1 then 1 else 0\n    SepWrite(base, p, v) => sep_valid(base)\n"
fn pf_heap_prol(use_hnew) = pf_heap_prol_base() + (if use_hnew == 1 then "fn heap_new(p: int, v: int) -> SepHeap = SepPts(p, v)\n" else "")
fn pf_heap_spec(k, hc, sh, gap, v1, v2) = let p1 = "(x + " + pf_lit(sh) + ")" in let p2 = "(y + " + pf_lit(sh) + ")" in let pd = "(x + " + pf_lit(sh + gap) + ")" in let s1 = str(v1) in let s2 = str(v2) in if k == 0 then {c: "result == 1", b: "sep_valid(sep_conj(points_to(" + p1 + ", " + s1 + "), points_to(" + pd + ", " + s2 + ")))", want: 1} else if k == 1 then {c: "result == " + s1, b: "heap_read(heap_write(" + hc + "(" + p1 + ", " + s1 + "), " + pd + ", " + s2 + "), " + p1 + ")", want: v1} else if k == 2 then {c: "result == " + s1, b: "heap_read(heap_write(" + hc + "(" + p1 + ", " + s1 + "), " + p2 + ", " + s2 + "), " + p1 + ")", want: v2} else if k == 3 then {c: "result == 1", b: "sep_valid(sep_conj(" + hc + "(" + p1 + ", " + s1 + "), points_to(" + p2 + ", " + s2 + ")))", want: 0} else if k == 4 then {c: "result == 1", b: "sep_disjoint(" + p1 + ", " + p2 + ")", want: 0} else if k == 5 then {c: "result == " + s1, b: "heap_read(heap_write(" + hc + "(" + p1 + ", " + s1 + "), " + p1 + ", " + s2 + "), " + p1 + ")", want: v2} else if k == 6 then {c: "result == " + s1, b: "heap_read(sep_conj(points_to(" + p1 + ", " + s1 + "), points_to(" + pd + ", " + s2 + ")), " + pd + ")", want: v2} else {c: "result == " + s1, b: "heap_read(heap_write(heap_write(" + hc + "(" + p1 + ", " + s1 + "), " + pd + ", " + s2 + "), " + p2 + ", " + str(v2 + 3) + "), " + p1 + ")", want: v2 + 3}
fn pf_heap_fns(k, bx, hc, sh, gap, v1, v2) = if k > 7 then "" else let sp = pf_heap_spec(k, hc, sh, gap, v1, v2) in pf_blind_fn_v(k, bx, sp.c, sp.b, k % 2, "x") + pf_heap_fns(k + 1, bx, hc, sh, gap, v1, v2)
fn pf_heap_pick(k, cx) = if k > 7 then "0" else "if sel == " + str(k) + " then " + pf_name(k) + "(" + pf_lit(cx) + ", " + pf_lit(cx) + ", 0 - 1) else " + pf_heap_pick(k + 1, cx)
fn pf_heap_exec(cfg, tag, k, v1) = if k > 7 then "" else let want = if k == 0 then 1 else v1 in let e = pf_exec_val(cfg, tag, k, want) in if e != "" then e else pf_heap_exec(cfg, tag, k + 1, v1)
fn pf_heap_kernel(bx, sh, gap, v1, v2, tag) = let hyp = pf_box_sx_v(bx, "x") in let p1 = "(+ x " + str(sh) + ")" in let p2 = "(+ y " + str(sh) + ")" in let pd = "(+ x " + str(sh + gap) + ")" in let s1 = str(v1) in let s2 = str(v2) in let f1 = "(implies " + hyp + " (== (heap_read (heap_write (heap_new " + p1 + " " + s1 + ") " + p2 + " " + s2 + ") " + p1 + ") " + s1 + "))" in let f2 = "(implies " + hyp + " (== (heap_read (heap_write (points_to " + p1 + " " + s1 + ") " + p2 + " " + s2 + ") " + p1 + ") " + s1 + "))" in let f3 = "(implies " + hyp + " (sep_valid (sep_conj (heap_new " + p1 + " " + s1 + ") (points_to " + p2 + " " + s2 + "))))" in let f4 = "(implies " + hyp + " (sep_disjoint " + p1 + " " + p2 + "))" in let f5 = "(implies " + hyp + " (== (heap_read (heap_write (heap_new " + p1 + " " + s1 + ") " + p1 + " " + s2 + ") " + p1 + ") " + s1 + "))" in let t1 = "(implies " + hyp + " (sep_valid (sep_conj (heap_new " + p1 + " " + s1 + ") (points_to " + pd + " " + s2 + "))))" in let t2 = "(implies " + hyp + " (== (heap_read (heap_write (heap_new " + p1 + " " + s1 + ") " + pd + " " + s2 + ") " + p1 + ") " + s1 + "))" in if lk_prove_term(f1) == 1 or lk_prove_term(f2) == 1 or lk_prove_term(f3) == 1 or lk_prove_term(f4) == 1 or lk_prove_term(f5) == 1 then {err: "UNSOUND (lcert kernel): proved aliased/overwritten separation-logic obligation in " + tag, kt: 0} else {err: "", kt: lk_prove_term(t1) + lk_prove_term(t2)}
fn pf_heap_case(cfg, idx, seed) = let bx0 = pf_box(seed) in let bx = {s: bx0.s, xlo: bx0.xlo, xhi: bx0.xhi, ylo: bx0.xlo, yhi: bx0.xhi} in let s1 = pf_prng(bx.s) in let s2 = pf_prng(s1) in let s3 = pf_prng(s2) in let sh = pf_pick(s1, 7) - 3 in let gap = 1 + pf_pick(s2, 4) in let v1 = 1 + pf_pick(s2, 9) in let v2 = 12 + pf_pick(s3, 9) in let use_hnew = (idx / 6) % 2 in let hc = if use_hnew == 1 then "heap_new" else "points_to" in let cx = bx.xlo + 1 in let tag = "pf" + str(idx) + "heap" in let hk = pf_heap_kernel(bx, sh, gap, v1, v2, tag) in if hk.err != "" then {err: hk.err, traps: 0, rejects: 0, kt: 0} else let bsrc = pf_heap_prol(use_hnew) + pf_heap_fns(0, bx, hc, sh, gap, v1, v2) + "fn pick(sel: int) -> int = " + pf_heap_pick(0, cx) + "\nprint pick(toint(os_arg_at(1)))\n" in let b = pf_build(cfg, tag + "b", bsrc) in let p = pf_caas(cfg, tag + "b", bsrc) in let ce = pf_caas_false(p.out, 2, tag + "b") in if ce != "" then {err: ce, traps: 0, rejects: 0, kt: 0} else if b.ok < 0 then {err: "lasm rejected heap case " + tag + "b: " + b.err, traps: 0, rejects: 0, kt: 0} else let r1 = if b.ok == 0 then (if pf_syntax(b.err) == 1 or pf_contains(b.err, "[V0001]") == 0 then {err: "lumec rejected blinded heap case " + tag + "b without [V0001]: " + b.err, traps: 0, rejects: 0} else {err: "", traps: 0, rejects: 1}) else (let ex = pf_heap_exec(cfg, tag + "b", 0, v1) in {err: ex, traps: if ex == "" then 6 else 0, rejects: 0}) in if r1.err != "" then {err: r1.err, traps: 0, rejects: 0, kt: 0} else let pk = 2 + (idx / 6) % 6 in let sp = pf_heap_spec(pk, hc, sh, gap, v1, v2) in let psrc = pf_heap_prol(use_hnew) + "fn g(x: int, y: int) -> int requires " + pf_reqs(bx) + " ensures " + sp.c + " = " + sp.b + "\nprint g(" + pf_lit(cx) + ", " + pf_lit(cx) + ")\n" in let r2 = pf_plain_src_run(cfg, tag + "p", psrc) in if r2.err != "" then {err: r2.err, traps: 0, rejects: 0, kt: 0} else {err: "", traps: r1.traps + r2.traps, rejects: r1.rejects + r2.rejects, kt: hk.kt}

## --- Domain 4: nested quantifiers (forall_range <-> exists_range with off-by-one bounds) --------------------------------
fn pf_q_pred(qk, i, j) = if qk == 0 then (if i <= j then 1 else 0) else if qk == 1 then (if j == i then 1 else 0) else if qk == 2 then (if i <= j then 1 else 0) else if qk == 3 then (if j == i then 1 else 0) else if qk == 4 then (if j <= i then 1 else 0) else if qk == 5 then (if i < j then 1 else 0) else if qk == 6 then (if j > i then 1 else 0) else if i >= j then 1 else 0
fn pf_q_inner_all(qk, i, j, jhi) = if j > jhi then 1 else if pf_q_pred(qk, i, j) == 0 then 0 else pf_q_inner_all(qk, i, j + 1, jhi)
fn pf_q_inner_ex(qk, i, j, jhi) = if j > jhi then 0 else if pf_q_pred(qk, i, j) == 1 then 1 else pf_q_inner_ex(qk, i, j + 1, jhi)
fn pf_q_outer_ex_all(qk, i, ihi, jlo, jhi) = if i > ihi then 0 else if pf_q_inner_all(qk, i, jlo, jhi) == 1 then 1 else pf_q_outer_ex_all(qk, i + 1, ihi, jlo, jhi)
fn pf_q_outer_all_ex(qk, i, ihi, x, span) = if i > ihi then 1 else let jlo = if qk == 1 then i else if qk == 4 then x + 1 else if qk == 6 then i + 1 else x in let jhi = if qk == 3 then x + span - 1 else x + span in if pf_q_inner_ex(qk, i, jlo, jhi) == 0 then 0 else pf_q_outer_all_ex(qk, i + 1, ihi, x, span)
fn pf_q_oracle(qk, x, span) = if qk == 0 then pf_q_outer_ex_all(0, x, x + span, x, x + span) else if qk == 2 then pf_q_outer_ex_all(2, x + 1, x + span, x, x + span) else if qk == 5 then pf_q_outer_ex_all(5, x, x + span, x, x + span) else if qk == 7 then pf_q_outer_ex_all(7, x, x + span - 1, x, x + span) else pf_q_outer_all_ex(qk, x, x + span, x, span)
fn pf_q_oracle_ok(qk, x, xhi, span, want) = if x > xhi then 1 else if pf_q_oracle(qk, x, span) != want then 0 else pf_q_oracle_ok(qk, x + 1, xhi, span, want)
fn pf_q_all_oracles(k, bx, span) = if k > 7 then "" else let want = if k <= 1 then 1 else 0 in if pf_q_oracle_ok(k, bx.xlo, bx.xhi, span, want) == 0 then "internal nested-quantifier oracle mismatch on k=" + str(k) else pf_q_all_oracles(k + 1, bx, span)
fn pf_q_src_claim(k, span) = let sp = str(span) in let sp1 = str(span - 1) in if k == 0 then "exists_range(i, x, x + " + sp + ", forall_range(j, x, x + " + sp + ", i <= j and result == x + y))" else if k == 1 then "forall_range(i, x, x + " + sp + ", exists_range(j, i, x + " + sp + ", j == i and result == x + y))" else if k == 2 then "exists_range(i, x + 1, x + " + sp + ", forall_range(j, x, x + " + sp + ", i <= j))" else if k == 3 then "forall_range(i, x, x + " + sp + ", exists_range(j, x, x + " + sp1 + ", j == i))" else if k == 4 then "forall_range(i, x, x + " + sp + ", exists_range(j, x + 1, x + " + sp + ", j <= i))" else if k == 5 then "exists_range(i, x, x + " + sp + ", forall_range(j, x, x + " + sp + ", i < j))" else if k == 6 then "forall_range(i, x, x + " + sp + ", exists_range(j, i + 1, x + " + sp + ", j > i))" else "exists_range(i, x, x + " + sp1 + ", forall_range(j, x, x + " + sp + ", i >= j))"
fn pf_q_sx_claim(k, span) = let sp = str(span) in let sp1 = str(span - 1) in if k == 0 then "(exists_range i x (+ x " + sp + ") (forall_range j x (+ x " + sp + ") (<= i j)))" else if k == 1 then "(forall_range i x (+ x " + sp + ") (exists_range j i (+ x " + sp + ") (== j i)))" else if k == 2 then "(exists_range i (+ x 1) (+ x " + sp + ") (forall_range j x (+ x " + sp + ") (<= i j)))" else if k == 3 then "(forall_range i x (+ x " + sp + ") (exists_range j x (+ x " + sp1 + ") (== j i)))" else if k == 4 then "(forall_range i x (+ x " + sp + ") (exists_range j (+ x 1) (+ x " + sp + ") (<= j i)))" else if k == 5 then "(exists_range i x (+ x " + sp + ") (forall_range j x (+ x " + sp + ") (< i j)))" else if k == 6 then "(forall_range i x (+ x " + sp + ") (exists_range j (+ i 1) (+ x " + sp + ") (> j i)))" else "(exists_range i x (+ x " + sp1 + ") (forall_range j x (+ x " + sp + ") (>= i j)))"
fn pf_q_fns(k, bx, span) = if k > 7 then "" else pf_blind_fn_v(k, bx, pf_q_src_claim(k, span), "(x + y)", k % 2, "x") + pf_q_fns(k + 1, bx, span)
fn pf_q_pick(k, cx, cy) = if k > 7 then "0" else "if sel == " + str(k) + " then " + pf_name(k) + "(" + pf_lit(cx) + ", " + pf_lit(cy) + ", 0 - 1) else " + pf_q_pick(k + 1, cx, cy)
fn pf_q_exec(cfg, tag, k, want) = if k > 7 then "" else let e = pf_exec_val(cfg, tag, k, want) in if e != "" then e else pf_q_exec(cfg, tag, k + 1, want)
fn pf_q_kernel(k, bx, span, tag) = if k > 7 then "" else let tm = "(implies " + pf_box_sx_v(bx, "x") + " " + pf_q_sx_claim(k, span) + ")" in if lk_prove_term(tm) == 1 then "UNSOUND (lcert kernel): proved false nested-quantifier theorem k=" + str(k) + " in " + tag + ": " + tm else pf_q_kernel(k + 1, bx, span, tag)
fn pf_quant_case(cfg, idx, seed) = let bx = pf_box(seed) in let span = 2 + pf_pick(bx.s, 4) in let oe = pf_q_all_oracles(0, bx, span) in if oe != "" then {err: oe, traps: 0, rejects: 0, kt: 0} else let tag = "pf" + str(idx) + "quant" in let ke = pf_q_kernel(2, bx, span, tag) in if ke != "" then {err: ke, traps: 0, rejects: 0, kt: 0} else let kt0 = lk_prove_term("(implies " + pf_box_sx_v(bx, "x") + " " + pf_q_sx_claim(0, span) + ")") + lk_prove_term("(implies " + pf_box_sx_v(bx, "x") + " " + pf_q_sx_claim(1, span) + ")") in let cx = bx.xlo + 1 in let cy = bx.ylo + 1 in let bsrc = pf_q_fns(0, bx, span) + "fn pick(sel: int) -> int = " + pf_q_pick(0, cx, cy) + "\nprint pick(toint(os_arg_at(1)))\n" in let b = pf_build(cfg, tag + "b", bsrc) in let p = pf_caas(cfg, tag + "b", bsrc) in let ce = pf_caas_false(p.out, 2, tag + "b") in if ce != "" then {err: ce, traps: 0, rejects: 0, kt: 0} else if b.ok < 0 then {err: "lasm rejected nested-quantifier case " + tag + "b: " + b.err, traps: 0, rejects: 0, kt: 0} else let r1 = if b.ok == 0 then (if pf_syntax(b.err) == 1 or pf_contains(b.err, "[V0001]") == 0 then {err: "lumec rejected blinded nested-quantifier case " + tag + "b without [V0001]: " + b.err, traps: 0, rejects: 0} else {err: "", traps: 0, rejects: 1}) else (let ex = pf_q_exec(cfg, tag + "b", 0, cx + cy) in {err: ex, traps: if ex == "" then 6 else 0, rejects: 0}) in if r1.err != "" then {err: r1.err, traps: 0, rejects: 0, kt: 0} else let pk = 2 + (idx / 6) % 6 in let psrc = "fn g(x: int, y: int) -> int requires " + pf_reqs(bx) + " ensures " + pf_q_src_claim(pk, span) + " = x + y\nprint g(" + pf_lit(cx) + ", " + pf_lit(cy) + ")\n" in let r2 = pf_plain_src_run(cfg, tag + "p", psrc) in if r2.err != "" then {err: r2.err, traps: 0, rejects: 0, kt: 0} else {err: "", traps: r1.traps + r2.traps, rejects: r1.rejects + r2.rejects, kt: kt0}

## --- Domain 5: algebraic `law` declarations failing at concrete counterexample points -----------------------------------
fn pf_law_expr_claim(k, a, pt, body) = if k == 0 then "(" + body + ") >= " + pf_lit(a.mn) else if k == 1 then "(" + body + ") <= " + pf_lit(a.mx) else if k == 2 then "(" + body + ") <= " + pf_lit(a.mx - 1) else if k == 3 then "(" + body + ") >= " + pf_lit(a.mn + 1) else if k == 4 then "(" + body + ") != " + pf_lit(pt.v) else if k == 5 then "(" + body + ") - x <= " + pf_lit(a.rm - 1) else if k == 6 then "x != " + pf_lit(pt.x) + " or y != " + pf_lit(pt.y) + " or (" + body + ") != " + pf_lit(pt.v) else if a.df == 1 then "(" + body + ") == x" else "(" + body + ") > " + pf_lit(a.mn)
fn pf_law_name(k) = if k == 0 then "law_lo" else if k == 1 then "law_hi" else "law_f" + str(k)
fn pf_law_decls(k, cs, blinded) = if k > 7 then "" else let b = if blinded == 1 then "(" + cs.body + " + bit_and(z, 0))" else cs.body in let pre = if blinded == 1 then "z <= 0 - 1 and " + pf_reqs(cs.bx) else pf_reqs(cs.bx) in let ps = if blinded == 1 then "(x: int, y: int, z: int)" else "(x: int, y: int)" in "law " + pf_law_name(k) + ps + " = if " + pre + " then " + pf_law_expr_claim(k, cs.a, cs.pt, b) + " else 1 == 1\n" + pf_law_decls(k + 1, cs, blinded)
fn pf_law_caas_false(out, k, tag) = if k > 7 then "" else if pf_proven_kind(out, pf_law_name(k), "law") == 1 then "UNSOUND (lcaas): false law " + pf_law_name(k) + " of " + tag + " is reported as proven" else pf_law_caas_false(out, k + 1, tag)
fn pf_law_term(k, cs) = "(implies (and) (if " + pf_box_sx_v(cs.bx, "x") + " " + pf_claim_sx(k, cs.a, cs.pt, cs.bsx) + " (== 1 1)))"
fn pf_law_kernel_false(k, cs, tag) = if k > 7 then "" else if lk_prove_term(pf_law_term(k, cs)) == 1 then "UNSOUND (lcert kernel): proved false law " + pf_law_name(k) + " of " + tag + ": " + pf_law_term(k, cs) else pf_law_kernel_false(k + 1, cs, tag)
fn pf_law_case(cfg, idx, seed) = let g = pf_gen(seed, 2 + pf_pick(seed, 2), 0) in let bx = pf_box(g.s) in let a = pf_scan(g.e, bx.xlo, bx, pf_acc0()) in let pt = pf_point(bx.s, bx, g.e) in let cs = {bx: bx, a: a, pt: pt, body: pf_show(g.e), bsx: pf_sx(g.e), form: idx % 2} in let tag = "pf" + str(idx) + "law" in let ke = pf_law_kernel_false(2, cs, tag) in if ke != "" then {err: ke, traps: 0, rejects: 0, kt: 0} else let kt0 = lk_prove_term(pf_law_term(0, cs)) + lk_prove_term(pf_law_term(1, cs)) in let p_unb = pf_caas(cfg, tag + "u", pf_law_decls(0, cs, 0) + "print 0\n") in let eu = pf_law_caas_false(p_unb.out, 2, tag + "u") in if eu != "" then {err: eu, traps: 0, rejects: 0, kt: 0} else let b_src = pf_law_decls(0, cs, 1) + pf_blind_src_p("", cs, "x") in let p_bl = pf_caas(cfg, tag + "b", b_src) in let eb = pf_law_caas_false(p_bl.out, 2, tag + "b") in if eb != "" then {err: eb, traps: 0, rejects: 0, kt: 0} else let ec = pf_caas_false(p_bl.out, 2, tag + "b") in if ec != "" then {err: ec, traps: 0, rejects: 0, kt: 0} else let b = pf_build(cfg, tag + "b", b_src) in if b.ok < 0 then {err: "lasm rejected blinded law case " + tag + "b: " + b.err, traps: 0, rejects: 0, kt: 0} else let r1 = if b.ok == 0 then (if pf_syntax(b.err) == 1 or pf_contains(b.err, "[V0001]") == 0 then {err: "lumec rejected blinded law case " + tag + "b without [V0001]: " + b.err, traps: 0, rejects: 0} else {err: "", traps: 0, rejects: 1}) else (let ex = pf_exec_all(cfg, tag + "b", 0, cs) in {err: ex, traps: if ex == "" then 6 else 0, rejects: 0}) in if r1.err != "" then {err: r1.err, traps: 0, rejects: 0, kt: 0} else let ref_src = "law bad_pt(u: int, v: int) = let x = u + " + pf_lit(pt.x) + " in let y = v + " + pf_lit(pt.y) + " in if u == 0 and v == 0 then (" + cs.body + ") != " + pf_lit(pt.v) + " else 1 == 1\nprint 0\n" in let br = pf_build(cfg, tag + "r", ref_src) in let pr = pf_caas(cfg, tag + "r", ref_src) in if pf_proven_kind(pr.out, "bad_pt", "law") == 1 then {err: "UNSOUND (lcaas): false point law bad_pt of " + tag + "r reported as proven", traps: 0, rejects: 0, kt: 0} else if br.ok < 0 or (br.ok == 0 and (pf_syntax(br.err) == 1 or pf_contains(br.err, "[V0001]") == 0)) then {err: "lumec rejected law bad_pt of " + tag + "r without [V0001]: ok=" + str(br.ok) + " err=" + br.err, traps: 0, rejects: 0, kt: 0} else let l1 = pf_lin_expr(bx.s) in let lv = pf_lin_eval(l1, pt.x, pt.y) in let lin_src = "law bad_lin(u: int, v: int) = let x = u + " + pf_lit(pt.x) + " in let y = v + " + pf_lit(pt.y) + " in if u == 0 and v == 0 then " + pf_lin_show(l1, "x", "y") + " != " + pf_lit(lv) + " else 1 == 1\nprint 0\n" in let bl = pf_build(cfg, tag + "l", lin_src) in let pl = pf_caas(cfg, tag + "l", lin_src) in if pf_proven_kind(pl.out, "bad_lin", "law") == 1 then {err: "UNSOUND (lcaas): false point law bad_lin of " + tag + "l reported as proven", traps: 0, rejects: 0, kt: 0} else if bl.ok != 0 or pf_syntax(bl.err) == 1 or pf_contains(bl.err, "[V0001]") == 0 then {err: "UNSOUND (lumec): false law bad_lin of " + tag + "l was not refuted with [V0001]: ok=" + str(bl.ok) + " err=" + bl.err, traps: 0, rejects: 0, kt: 0} else {err: "", traps: r1.traps, rejects: r1.rejects + 1 + (if br.ok == 0 then 1 else 0), kt: kt0}

## --- multi-domain campaign loop -----------------------------------------------------------------------------------------
fn pf_case(cfg, idx, seed) = let dom = idx % 6 in if dom == 0 then pf_arith_case(cfg, idx, seed) else if dom == 1 then pf_rec_case(cfg, idx, seed) else if dom == 2 then pf_arr_case(cfg, idx, seed) else if dom == 3 then pf_heap_case(cfg, idx, seed) else if dom == 4 then pf_quant_case(cfg, idx, seed) else pf_law_case(cfg, idx, seed)
fn pf_loop(cfg, idx, n, seed, st) = if idx >= n then st else let r = pf_case(cfg, idx, seed) in if r.err != "" then {err: r.err + " (case " + str(idx) + ", domain " + str(idx % 6) + ", seed " + str(seed) + ")", traps: st.traps, rejects: st.rejects, kt: st.kt} else pf_loop(cfg, idx + 1, n, pf_prng(pf_prng(seed) + idx), {err: "", traps: st.traps + r.traps, rejects: st.rejects + r.rejects, kt: st.kt + r.kt})

## pf_fuzz: n cases from `seed`. Fails on the first unsound verdict; also fails when fewer than 3 runtime checks per case
## fired on average (the blinded programs were not exercising the prover) or when the kernel re-derived fewer than one
## true control in eight (it was rejecting everything).
fn pf_fuzz(cfg, n, seed) = let st = pf_loop(cfg, 0, n, seed, {err: "", traps: 0, rejects: 0, kt: 0}) in if st.err != "" then st else if st.traps < n * 3 then {err: "false-theorem fuzzer is vacuous: only " + str(st.traps) + " runtime checks fired over " + str(n) + " cases (" + str(st.rejects) + " compile-time refutations)", traps: st.traps, rejects: st.rejects, kt: st.kt} else if st.kt * 4 < n then {err: "false-theorem fuzzer is vacuous for the kernel: it re-derived only " + str(st.kt) + " of " + str(2 * n) + " true controls", traps: st.traps, rejects: st.rejects, kt: st.kt} else st
fn pf_cfg(root, tmp) = {tmp: tmp, lumec: root + "/build/bin/lumec", lasm: root + "/build/bin/lasm", lcaas: root + "/build/bin/lcaas"}
