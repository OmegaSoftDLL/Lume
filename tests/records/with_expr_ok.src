## with_expr_ok.src -- a record update `{e with f: v}` takes any expression before `with` (a call, a field, a
## parenthesized or nested update), as well as a plain name; the field check T2101 applies to all of them.

fn base() = {a: 1, b: {c: 2}}
fn test_with_after_a_name() = let r = base() in let u = {r with a: 5} in u.a == 5 and u.b.c == 2
fn test_with_after_a_call() = let u = {base() with a: 5} in u.a == 5 and u.b.c == 2
fn test_with_after_a_field() = let r = base() in let u = {r.b with c: 7} in u.c == 7
fn test_with_after_parentheses() = {(base()) with a: 6}.a == 6
fn test_with_nested_updates() = let u = {{base() with a: 9} with b: {c: 3}} in u.a == 9 and u.b.c == 3
fn test_with_evaluates_the_base_once() = let u = {base() with a: 1 + 1} in u.a == 2 and base().a == 1
