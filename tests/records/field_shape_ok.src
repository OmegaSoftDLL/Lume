## field_shape_ok.src -- the record field check (T2101) follows a record's shape through a function with parameters,
## both branches of an if (the same fields) and a nominal record; these valid reads must compile, and a misspelled
## field in any of them is refused at compile time ("this value has no field 'valeu' (it has fields ok, value, err)").

fn mk(a) = {x: a, y: 2}
fn ok_rec(s) = {ok: 1, value: s, err: ""}
fn get(s) = if s == "" then {ok: 0, value: "", err: "empty"} else ok_rec(s)
fn either(c) = if c == 1 then {a: 1} else {b: 2}
fn test_reads_through_a_function_with_parameters() = mk(5).x == 5 and mk(5).y == 2
fn test_reads_through_both_branches_of_an_if() = get("v").value == "v" and get("").err == "empty" and get("v").ok == 1
## branches of different shapes: unknown to the check, read at run time as before
fn test_branches_of_different_shapes_stay_unchecked() = either(1).a == 1
