## linear_imm_ok.src -- [E0305] moves a record sent with chan_send_linear, but an immediate (a small int, a bool) that
## went into it or was read out of it is a copy: the sender keeps it. A heap part, an alias or a computed int (it may
## be a boxed cell) still moves with the record; examples/diagnostics/E0305_* shows the rejected form.
fn chan_send_linear(ch, x) = x

fn copied_in() =
    let v = 99 in
    let msg = {id: 42, val: v} in
    let _sent = chan_send_linear(1, msg) in
    v

fn read_out() =
    let msg = {id: 42, val: 99, ok: true} in
    let v = msg.val in
    let b = msg.ok in
    let _sent = chan_send_linear(1, msg) in
    if b then v else 0

fn test_an_int_put_into_the_message_stays_with_the_sender() = copied_in() == 99
fn test_an_int_and_a_bool_read_out_before_the_send_stay() = read_out() == 99
