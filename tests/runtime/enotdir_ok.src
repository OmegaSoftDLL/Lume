## enotdir_ok.src -- a path whose existing component is a file fails with ENOTDIR (-20) and a path under a missing
## directory with ENOENT (-2), the same on Linux and on Windows (the Win64 layer maps ERROR_PATH_NOT_FOUND by walking
## the prefixes of the path). The keychain relies on it: a broken store must never read as "entry absent".

fn cz(p) = buf_addr(buf_from_str(p + chr(0)))
fn setup() = fs_write_sync("enotdir_probe_file", "x")
fn test_open_under_a_file_is_enotdir() = let s = setup() in sys_call(2, cz("enotdir_probe_file/a.txt"), 0, 0, 0, 0) == 0 - 20
fn test_open_under_a_missing_dir_is_enoent() = sys_call(2, cz("enotdir_probe_missing/a.txt"), 0, 0, 0, 0) == 0 - 2
fn test_unlink_under_a_file_is_enotdir() = let s = setup() in sys_call(87, cz("enotdir_probe_file/a.txt"), 0, 0, 0, 0) == 0 - 20
fn test_mkdir_under_a_file_is_enotdir() = let s = setup() in sys_call(83, cz("enotdir_probe_file/d"), 448, 0, 0, 0) == 0 - 20
fn test_deep_path_under_a_file_is_enotdir() = let s = setup() in sys_call(2, cz("enotdir_probe_file/x/y/z.txt"), 0, 0, 0, 0) == 0 - 20
fn test_cleanup() = fs_remove("enotdir_probe_file") == 1
