## deep_recursion_ok.src -- recursion that is not a tail call: the runtime reserves a large stack at start on Linux and
## on Windows, so a million levels (a list of a million items built by plain recursion) run; far beyond (tens of
## millions of levels of a small function) the program stops with "lume: stack overflow (recursion too deep)", exit 12.
fn build(n) = if n == 0 then Nil else Cons(n, build(n - 1))
fn len(xs, k) = match xs
    Nil        => k
    Cons(h, t) => len(t, k + 1)
fn sum_rec(xs) = match xs
    Nil        => 0
    Cons(h, t) => h + sum_rec(t)
fn test_a_million_levels_of_plain_recursion() = len(build(1000000), 0) == 1000000
fn test_folding_back_up_a_deep_list() = sum_rec(build(200000)) == 20000100000
