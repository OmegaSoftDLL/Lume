{
  "name": "Lume v1.1.0 Sovereign Development Environment (Zero-C & OmniProof v3)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "postCreateCommand": "bash scripts/install.sh || true; grep -qxF 'export PATH=\"$HOME/.lume/bin:${containerWorkspaceFolder}/build/bin:$PATH\"' ~/.bashrc || echo 'export PATH=\"$HOME/.lume/bin:${containerWorkspaceFolder}/build/bin:$PATH\"' >> ~/.bashrc; ./lume --version",
  "customizations": {
    "vscode": {
      "settings": {
        "workbench.colorTheme": "Dracula Lume Sovereign",
        "files.eol": "\n",
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      },
      "extensions": [
        "./editors/vscode-lume"
      ]
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.lume/bin:${containerWorkspaceFolder}/build/bin:${containerEnv:PATH}"
  }
}
