# Lume v1.0.0 Capstone — Pix Fraud Graph Tracer & BACEN MED Recovery Engine
# Inspired by @sandeco/pix-golpe (SPEC.md Sections 3 & 4: Temporal BFS,
# Suspicion Scoring 0.4*rep + 0.5*rapidez + 0.1*pequeno, Laranja & Saque)
# Zero-Float Basis-Point Arithmetic + QF_LIA Formal Proof (Lume Verified ✓)
# ============================================================================

const JANELA_SEGUNDOS: int = 86400
const PROF_MAX: int = 5
const VALOR_MIN_CENTAVOS: int = 200000
const LIMIAR_LARANJA_BPS: int = 6000
const LIMIAR_REPASSE_SAQUE_BPS: int = 3000

fn clamp_bps(val: int, lo: int, hi: int) -> int
  requires lo <= hi
  ensures result >= lo and result <= hi
= if val < lo then lo else if val > hi then hi else val

# Step A: Temporal Window & Minimum Value Filter (ts in [cv, cv + 86400])
fn pix_edge_in_window(ts: int, cv: int, valor_cents: int, prof: int) -> int
  requires cv >= 0 and prof >= 0
  ensures result >= 0 and result <= 1
= if prof >= 5 then 0
  else if ts < cv then 0
  else if ts > cv + 86400 then 0
  else if valor_cents < 200000 then 0
  else 1

# Step B: Exact Basis-Point Suspicion Score (0..10000 bps == 0.0000..1.0000)
# Formula: 40% * repasse_bps + 50% * rapidez_bps + 10% * pequeno_bps
fn pix_suspicion_bps(repasse_bps: int, rapidez_bps: int, in_deg: int) -> int
  requires repasse_bps >= 0 and repasse_bps <= 10000 and rapidez_bps >= 0 and rapidez_bps <= 10000 and in_deg >= 0
  ensures result >= 0 and result <= 10000
= let pequeno_bps = if in_deg < 50 then 10000 else 0 in
  (4 * repasse_bps + 5 * rapidez_bps + pequeno_bps) / 10

# Step B Helper: Rapidez score in basis points from delta_t = primeiro_out - cv
fn pix_rapidez_bps(delta_seconds: int) -> int
  requires delta_seconds >= 0
  ensures result >= 0 and result <= 10000
= if delta_seconds >= 3600 then 0
  else ((3600 - delta_seconds) * 10000) / 3600

# Step D: Account Role Classification
# Returns: 2 = Laranja (Money Mule), 1 = Conta de Saque (Cash-out), 0 = Normal
fn pix_classify_node(suspeita_bps: int, repasse_bps: int, de_laranja_count: int) -> int
  requires suspeita_bps >= 0 and suspeita_bps <= 10000 and repasse_bps >= 0 and repasse_bps <= 10000 and de_laranja_count >= 0
  ensures result >= 0 and result <= 2
= if suspeita_bps >= 6000 then 2
  else if de_laranja_count >= 3 and repasse_bps < 3000 then 1
  else 0

# BACEN MED (Mecanismo Especial de Devolucao) Precautionary Freeze
# Guarantees we never freeze more than the remaining victim loss or account balance
fn pix_med_freeze_cents(remaining_loss_cents: int, mule_balance_cents: int) -> int
  requires remaining_loss_cents >= 0 and mule_balance_cents >= 0
  ensures result >= 0 and result <= remaining_loss_cents and result <= mule_balance_cents
= if mule_balance_cents < remaining_loss_cents then mule_balance_cents else remaining_loss_cents

# Universal Algebraic Laws Proven by QF_LIA & Checked by lcert
law pix_med_conservation_law(loss: int, bal: int) =
  if loss >= 0 and bal >= 0 then
    let frozen = pix_med_freeze_cents(loss, bal) in
    frozen + (loss - frozen) == loss
  else 1 == 1

law pix_med_cap_law(loss: int, bal: int) =
  if loss >= 0 and bal >= 0 then
    pix_med_freeze_cents(loss, bal) <= loss
  else 1 == 1

# Real Multi-Hop Fraud Ring Simulation & Verification
fn test_pix_fraud_ring_trace() =
  # Hop 1: Laranja_A receives R$ 50,000.00 (5,000,000 cents) and forwards 95% in 180s (in_deg = 12)
  let rap_a = pix_rapidez_bps(180) in
  let susp_a = pix_suspicion_bps(9500, rap_a, 12) in
  let role_a = pix_classify_node(susp_a, 9500, 1) in

  # Hop 2: Laranja_B forwards 90% in 360s (in_deg = 8)
  let rap_b = pix_rapidez_bps(360) in
  let susp_b = pix_suspicion_bps(9000, rap_b, 8) in
  let role_b = pix_classify_node(susp_b, 9000, 2) in

  # Hop 3: Cash-out account (Saque) receives from 3 laranjas and holds funds (repasse = 10% = 1000 bps)
  let susp_saque = pix_suspicion_bps(1000, 0, 60) in
  let role_saque = pix_classify_node(susp_saque, 1000, 3) in

  # Execute BACEN MED Precautionary Block across the traced ring for R$ 50,000.00 victim claim
  let victim_claim = 5000000 in
  let freeze_a = pix_med_freeze_cents(victim_claim, 1200000) in
  let rem_after_a = victim_claim - freeze_a in
  let freeze_b = pix_med_freeze_cents(rem_after_a, 1800000) in
  let rem_after_b = rem_after_a - freeze_b in
  let freeze_saque = pix_med_freeze_cents(rem_after_b, 3500000) in
  let total_recovered = freeze_a + freeze_b + freeze_saque in

  role_a == 2 and role_b == 2 and role_saque == 1 and total_recovered == 5000000

print f"[PIX-TRACE] Laranja_A_bps={pix_suspicion_bps(9500, pix_rapidez_bps(180), 12)} Laranja_B_bps={pix_suspicion_bps(9000, pix_rapidez_bps(360), 8)} Saque_role={pix_classify_node(pix_suspicion_bps(1000, 0, 60), 1000, 3)} MED_Recovered_Cents={pix_med_freeze_cents(5000000, 1200000) + pix_med_freeze_cents(3800000, 1800000) + pix_med_freeze_cents(2000000, 3500000)}"
