## 4. Buffer, DocTabView & Dual-View State Machine (`Notepad_plus.cpp` 4226-5208)
## ============================================================================

fn npp_make_buffer(id, file_name, full_path, text, dirty, untitled) =
  {id: id, file_name: file_name, full_path: full_path, text: text, dirty: dirty, untitled: untitled, readonly: 0, monitoring: 0, pinned: 0, lang_type: "L_CPP", uni_mode: 1, eol_mode: 0, bookmarks: Nil}

fn npp_find_buffer(buffers, id) = match buffers
  Nil => npp_make_buffer(-1, "new 1", "new 1", "", 0, 1)
  Cons(b, rest) => if b.id == id then b else npp_find_buffer(rest, id)

fn npp_update_buffer(buffers, updated) = match buffers
  Nil => Cons(updated, Nil)
  Cons(b, rest) => if b.id == updated.id then Cons(updated, rest) else Cons(b, npp_update_buffer(rest, updated))

fn npp_count_dirty_in_tabs(tabs, buffers) = match tabs
  Nil => 0
  Cons(bid, rest) =>
    let b = npp_find_buffer(buffers, bid) in
    (if b.dirty == 1 then 1 else 0) + npp_count_dirty_in_tabs(rest, buffers)

## `Notepad_plus::setTitle()` (`Notepad_plus.cpp` lines 4226-4261)
## Exact title bar synthesis: `[*]<fileName|fullPath> - Notepad++[ [Administrator]][ - <titleBarAdd>]`
fn npp_format_title(buf, short_titlebar, is_admin, title_bar_add) =
  let dirty_prefix = if buf.dirty == 1 then "*" else "" in
  let name_part = if short_titlebar == 1 then buf.file_name else buf.full_path in
  let admin_part = if is_admin == 1 then " [Administrator]" else "" in
  let extra_part = if title_bar_add != "" then " - " + title_bar_add else "" in
  dirty_prefix + name_part + " - Notepad++" + admin_part + extra_part

## `Notepad_plus::loadBufferIntoView(BufferID id, int whichOne, bool dontClose)` (`Notepad_plus.cpp` lines 4787-4824)
## Replaces a single clean untitled tab at index 0 to prevent tab flicker, otherwise appends `id`.
fn npp_load_buffer_into_tab_list(tabs, buffers, id, dont_close) =
  if npp_list_index_of(tabs, id) != -1 then {tabs: tabs, active_index: npp_list_index_of(tabs, id), replaced_clean_untitled: 0}
  else if dont_close == 0 and npp_list_len(tabs) == 1 then
    let first_id = npp_list_at(tabs, 0) in
    let first_buf = npp_find_buffer(buffers, first_id) in
    if first_buf.dirty == 0 and first_buf.untitled == 1 then
      {tabs: Cons(id, Nil), active_index: 0, replaced_clean_untitled: 1}
    else
      let next_tabs = npp_list_append(tabs, id) in
      {tabs: next_tabs, active_index: npp_list_len(next_tabs) - 1, replaced_clean_untitled: 0}
  else
    let next_tabs = npp_list_append(tabs, id) in
    {tabs: next_tabs, active_index: npp_list_len(next_tabs) - 1, replaced_clean_untitled: 0}

## `Notepad_plus::removeBufferFromView(BufferID id, int whichOne)` (`Notepad_plus.cpp` lines 4826-4901)
## Enforces Notepad++'s core tab invariants:
## 1. Cannot close the last tab if it is already a clean untitled "new 1" document.
## 2. If closing the only tab (which was a real file or dirty), replaces it at slot 0 with a fresh `new_empty_id`.
## 3. Otherwise removes the tab and shifts `active_index` safely (`active - 1` when closing the last index).
fn npp_remove_buffer_from_tab_list(tabs, active_index, buffers, id, new_empty_id) =
  let idx = npp_list_index_of(tabs, id) in
  if idx == -1 then {removed: 0, tabs: tabs, active_index: active_index}
  else
    let n = npp_list_len(tabs) in
    let buf = npp_find_buffer(buffers, id) in
    if n == 1 and buf.dirty == 0 and buf.untitled == 1 and npp_startswith(buf.file_name, "new ") == 1 then
      {removed: 0, tabs: tabs, active_index: active_index}
    else if n == 1 then
      {removed: 1, tabs: Cons(new_empty_id, Nil), active_index: 0}
    else
      let next_tabs = npp_list_remove_at(tabs, idx) in
      let next_active =
        if active_index == idx then
          (if idx == n - 1 then idx - 1 else idx)
        else if active_index > idx then active_index - 1
        else active_index
      in
      {removed: 1, tabs: next_tabs, active_index: next_active}

## `Notepad_plus::docGotoAnotherEditView(FileTransferMode mode)` (`Notepad_plus.cpp` lines 5044-5138)
## Clones (`transfer_clone()`) or Moves (`transfer_move()`) the active buffer to the other view,
## auto-activating the destination view and hiding the source view if its last tab was moved away.
fn npp_doc_goto_another_view(state, transfer_mode, fallback_empty_id) =
  let src_view = state.active_view in
  let dst_view = npp_other_from_view(src_view) in
  let src_tabs = if src_view == 0 then state.main_tabs else state.sub_tabs in
  let src_active = if src_view == 0 then state.main_active else state.sub_active in
  let dst_tabs = if dst_view == 0 then state.main_tabs else state.sub_tabs in
  let dst_visible = npp_view_visible(state.win_status, dst_view) in
  if transfer_mode == 2 and npp_list_len(src_tabs) == 1 and dst_visible == 0 then state
  else
    let cur_buf_id = npp_list_at(src_tabs, src_active) in
    let loaded = npp_load_buffer_into_tab_list(dst_tabs, state.buffers, cur_buf_id, 0) in
    let new_win_status = if dst_visible == 0 then win_both_active() else state.win_status in
    let after_src =
      if transfer_mode == 2 then
        npp_remove_buffer_from_tab_list(src_tabs, src_active, state.buffers, cur_buf_id, fallback_empty_id)
      else
        {removed: 0, tabs: src_tabs, active_index: src_active}
    in
    if src_view == 0 then
      {win_status: new_win_status, active_view: dst_view, main_tabs: after_src.tabs, main_active: after_src.active_index, sub_tabs: loaded.tabs, sub_active: loaded.active_index, buffers: state.buffers}
    else
      {win_status: new_win_status, active_view: dst_view, main_tabs: loaded.tabs, main_active: loaded.active_index, sub_tabs: after_src.tabs, sub_active: after_src.active_index, buffers: state.buffers}

## ============================================================================
## 5. Text Transformation Algorithms (`Notepad_plus.cpp` lines 1460-1832)
## ============================================================================

fn npp_repeat_spaces(n) =
  if n <= 0 then "" else " " + npp_repeat_spaces(n - 1)

## `Notepad_plus::wsTabConvert(spaceTab whichWay)` (`Notepad_plus.cpp` lines 1460-1644)
## Converts tabs to spaces (`tab2Space`) or spaces to tabs (`space2TabLeading` / `space2TabAll`)
## respecting tab-stop column alignment (`tab_width`, default 4) and UTF-8 continuation bytes.
fn npp_tab_to_space_line(line, i, n, col, tab_width) =
  if i >= n then ""
  else
    let c = at(line, i) in
    if c == "\t" then
      let spaces_needed = tab_width - (col % tab_width) in
      npp_repeat_spaces(spaces_needed) + npp_tab_to_space_line(line, i + 1, n, col + spaces_needed, tab_width)
    else
      let next_col = if ord(c) >= 128 and ord(c) < 192 then col else col + 1 in
      c + npp_tab_to_space_line(line, i + 1, n, next_col, tab_width)

fn npp_count_run_spaces(line, i, n) =
  if i >= n then 0
  else if at(line, i) == " " then 1 + npp_count_run_spaces(line, i + 1, n)
  else 0

fn npp_space_to_tab_line(line, i, col, tab_width, only_leading, seen_non_space) =
  let n = count(line) in
  if i >= n then ""
  else
    let c = at(line, i) in
    if c == " " and (only_leading == 0 or seen_non_space == 0) then
      let run = npp_count_run_spaces(line, i, n) in
      let dist_to_stop = tab_width - (col % tab_width) in
      if run >= dist_to_stop and dist_to_stop >= 2 then
        "\t" + npp_space_to_tab_line(line, i + dist_to_stop, col + dist_to_stop, tab_width, only_leading, seen_non_space)
      else
        " " + npp_space_to_tab_line(line, i + 1, col + 1, tab_width, only_leading, seen_non_space)
    else
      let is_non_ws = if c == " " or c == "\t" then seen_non_space else 1 in
      let next_col = if c == "\t" then col + (tab_width - (col % tab_width)) else col + 1 in
      c + npp_space_to_tab_line(line, i + 1, next_col, tab_width, only_leading, is_non_ws)

fn npp_ws_tab_convert_lines(lines, mode, tab_width) = match lines
  Nil => Nil
  Cons(line, rest) =>
    let converted =
      if mode == 0 then npp_tab_to_space_line(line, 0, count(line), 0, tab_width)
      else if mode == 1 then npp_space_to_tab_line(line, 0, 0, tab_width, 1, 0)
      else npp_space_to_tab_line(line, 0, 0, tab_width, 0, 0)
    in
    Cons(converted, npp_ws_tab_convert_lines(rest, mode, tab_width))

fn npp_ws_tab_convert(text, mode, tab_width) =
  npp_join_lines(npp_ws_tab_convert_lines(npp_split_lines(text), mode, tab_width), "\n")

## `Notepad_plus::doTrim(trimOp whichPart)` (`Notepad_plus.cpp` lines 1646-1700)
fn npp_trim_one_line(line, which_part) =
  let n = count(line) in
  if which_part == 0 then npp_ltrim_line(line, 0, n)
  else if which_part == 1 then npp_rtrim_line(line, n)
  else if which_part == 2 then
    let l = npp_ltrim_line(line, 0, n) in
    npp_rtrim_line(l, count(l))
  else line

fn npp_trim_lines(lines, which_part) = match lines
  Nil => Nil
  Cons(h, t) => Cons(npp_trim_one_line(h, which_part), npp_trim_lines(t, which_part))

fn npp_do_trim(text, which_part) =
  npp_join_lines(npp_trim_lines(npp_split_lines(text), which_part), "\n")

## `Notepad_plus::eol2ws()` (`Notepad_plus.cpp` lines 1702-1712)
fn npp_eol_to_ws(text) =
  npp_join_lines(npp_split_lines(text), " ")

## `Notepad_plus::removeEmptyLine(bool isBlankContained)` (`Notepad_plus.cpp` lines 1714-1752)
fn npp_filter_empty_lines(lines, is_blank_contained) = match lines
  Nil => Nil
  Cons(h, t) =>
    let check_str = if is_blank_contained == 1 then npp_ltrim_line(h, 0, count(h)) else h in
    if count(check_str) == 0 then npp_filter_empty_lines(t, is_blank_contained)
    else Cons(h, npp_filter_empty_lines(t, is_blank_contained))

fn npp_remove_empty_lines(text, is_blank_contained) =
  npp_join_lines(npp_filter_empty_lines(npp_split_lines(text), is_blank_contained), "\n")

## `Notepad_plus::removeDuplicateLines()` (`Notepad_plus.cpp` lines 1754-1831)
## Removes consecutive duplicate lines (including the final line without trailing EOL).
fn npp_dedup_consecutive_go(lines, prev, has_prev) = match lines
  Nil => Nil
  Cons(h, t) =>
    if has_prev == 1 and h == prev then npp_dedup_consecutive_go(t, prev, 1)
    else Cons(h, npp_dedup_consecutive_go(t, h, 1))

fn npp_remove_duplicate_lines(text) =
  npp_join_lines(npp_dedup_consecutive_go(npp_split_lines(text), "", 0), "\n")

