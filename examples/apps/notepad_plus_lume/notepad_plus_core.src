## 6. Block & Stream Comment Engine (`Notepad_plus.cpp` lines 5407-5806)
## ============================================================================

fn npp_line_indent_pos(line, i, n) =
  if i >= n then n
  else if npp_is_ws_char(at(line, i)) then npp_line_indent_pos(line, i + 1, n)
  else i

fn npp_block_comment_line(line, symbol, mode) =
  let n = count(line) in
  let indent_pos = npp_line_indent_pos(line, 0, n) in
  if indent_pos == n then line
  else
    let indent_str = slice(line, 0, indent_pos) in
    let body_str = slice(line, indent_pos, n) in
    let sym_with_sp = symbol + " " in
    let has_sym_sp = npp_startswith(body_str, sym_with_sp) in
    let has_sym = npp_startswith(body_str, symbol) in
    if mode == 1 then
      if has_sym_sp == 1 then indent_str + slice(body_str, count(sym_with_sp), count(body_str))
      else if has_sym == 1 then indent_str + slice(body_str, count(symbol), count(body_str))
      else line
    else if mode == 2 then
      if has_sym_sp == 1 then indent_str + slice(body_str, count(sym_with_sp), count(body_str))
      else if has_sym == 1 then indent_str + slice(body_str, count(symbol), count(body_str))
      else indent_str + sym_with_sp + body_str
    else
      indent_str + sym_with_sp + body_str

fn npp_block_comment_lines(lines, symbol, mode) = match lines
  Nil => Nil
  Cons(h, t) => Cons(npp_block_comment_line(h, symbol, mode), npp_block_comment_lines(t, symbol, mode))

fn npp_do_block_comment(text, is_readonly, symbol, mode) =
  if is_readonly == 1 or symbol == "" then text
  else npp_join_lines(npp_block_comment_lines(npp_split_lines(text), symbol, mode), "\n")

## `Notepad_plus::doStreamComment()` (`Notepad_plus.cpp` lines 5714-5806)
fn npp_do_stream_comment(text, is_readonly, comment_start, comment_end, line_fallback) =
  if is_readonly == 1 then text
  else if comment_start == "" or comment_end == "" then
    npp_do_block_comment(text, is_readonly, line_fallback, cm_comment())
  else
    comment_start + " " + text + " " + comment_end

## ============================================================================
## 7. Brace Matching & Auto-Indentation (`Notepad_plus.cpp` lines 3650-3949)
##    Fixes the unimplemented forward branch in C++ `findMachedBracePos` (line 3696)!
## ============================================================================

fn npp_find_brace_backward(text, i, end_pos, target_sym, matched_sym, balance) =
  if i < end_pos then -1
  else
    let c = at(text, i) in
    if c == target_sym then
      (if balance == 0 then i else npp_find_brace_backward(text, i - 1, end_pos, target_sym, matched_sym, balance - 1))
    else if c == matched_sym then
      npp_find_brace_backward(text, i - 1, end_pos, target_sym, matched_sym, balance + 1)
    else
      npp_find_brace_backward(text, i - 1, end_pos, target_sym, matched_sym, balance)

fn npp_find_brace_forward(text, i, end_pos, target_sym, matched_sym, balance) =
  if i > end_pos or i >= count(text) then -1
  else
    let c = at(text, i) in
    if c == target_sym then
      (if balance == 0 then i else npp_find_brace_forward(text, i + 1, end_pos, target_sym, matched_sym, balance - 1))
    else if c == matched_sym then
      npp_find_brace_forward(text, i + 1, end_pos, target_sym, matched_sym, balance + 1)
    else
      npp_find_brace_forward(text, i + 1, end_pos, target_sym, matched_sym, balance)

fn npp_find_matched_brace_pos(text, start_pos, end_pos, target_sym, matched_sym) =
  if start_pos == end_pos or count(text) == 0 then -1
  else if start_pos > end_pos then
    npp_find_brace_backward(text, start_pos, end_pos, target_sym, matched_sym, 0)
  else
    npp_find_brace_forward(text, start_pos, end_pos, target_sym, matched_sym, 0)

## `Notepad_plus::isConditionExprLine` (`Notepad_plus.cpp` lines 3650-3671)
fn npp_is_condition_expr_line(line) =
  let trimmed = npp_trim_one_line(line, 2) in
  if trimmed == "else" then 1
  else if (npp_startswith(trimmed, "if ") == 1 or npp_startswith(trimmed, "if(") == 1 or npp_startswith(trimmed, "else if ") == 1 or npp_startswith(trimmed, "for ") == 1 or npp_startswith(trimmed, "for(") == 1 or npp_startswith(trimmed, "while ") == 1 or npp_startswith(trimmed, "while(") == 1) and npp_endswith(trimmed, ")") == 1 then 1
  else 0

## `Notepad_plus::maintainIndentation(wchar_t ch)` (`Notepad_plus.cpp` lines 3702-3949)
fn npp_compute_auto_indent(prev_line, prev_indent, tab_width, lang_type) =
  let trimmed = npp_trim_one_line(prev_line, 2) in
  if count(trimmed) == 0 then 0
  else if npp_endswith(trimmed, "{") == 1 then prev_indent + tab_width
  else if lang_type == "L_PYTHON" and npp_endswith(trimmed, ":") == 1 then prev_indent + tab_width
  else if (lang_type == "L_C" or lang_type == "L_CPP" or lang_type == "L_JAVA") and npp_is_condition_expr_line(prev_line) == 1 then prev_indent + tab_width
  else prev_indent

## ============================================================================
## 8. UTF-8 Codepoint Counting & StatusBar Formatting (`Notepad_plus.cpp` 4308-4566)
##    Fixes C++ line 4368 buffer over-read on truncated trailing UTF-8 sequences!
## ============================================================================

fn npp_utf8_extra_bytes(lead_byte: int) -> int
  requires lead_byte >= 192 and lead_byte <= 255
  ensures result >= 1 and result <= 3
  = let hi = (lead_byte - 192) / 16 in
    if hi <= 1 then 1
    else if hi == 2 then 2
    else 3

fn npp_count_utf8_chars_go(s, pos, endpos, acc) =
  if pos >= endpos then acc
  else
    let ch = at(s, pos) in
    let b = ord(ch) in
    if ch == "\n" or ch == "\r" or (b >= 128 and b < 192) then
      npp_count_utf8_chars_go(s, pos + 1, endpos, acc)
    else if b >= 192 and b <= 255 then
      let step = 1 + npp_utf8_extra_bytes(b) in
      let next_pos = if pos + step > endpos then endpos else pos + step in
      npp_count_utf8_chars_go(s, next_pos, endpos, acc + 1)
    else
      npp_count_utf8_chars_go(s, pos + 1, endpos, acc + 1)

fn npp_get_current_doc_char_count(text, uni_mode) =
  npp_count_utf8_chars_go(text, 0, count(text), 0)

## `Notepad_plus::updateStatusBar()` (`Notepad_plus.cpp` lines 4464-4566)
fn npp_format_status_bar(doc_len, line_count, cur_line, cur_col, sel_chars, sel_lines) =
  let size_section = "length: " + str(doc_len) + "    lines: " + str(line_count) in
  let sel_part =
    if sel_chars <= 0 then "Pos: " + str(cur_col)
    else "Sel: " + str(sel_chars) + " | " + str(sel_lines)
  in
  let pos_section = "Ln: " + str(cur_line) + "    Col: " + str(cur_col) + "    " + sel_part in
  size_section + " || " + pos_section + " || INS"

## ============================================================================
## 9. Bookmark Engine (`Notepad_plus.h` 534-568, `Notepad_plus.cpp` 5210-5232)
## ============================================================================

fn npp_bookmark_present(bookmarks, lineno) =
  if npp_list_index_of(bookmarks, lineno) != -1 then 1 else 0

fn npp_bookmark_toggle(bookmarks, lineno) =
  let idx = npp_list_index_of(bookmarks, lineno) in
  if idx != -1 then npp_list_remove_at(bookmarks, idx)
  else npp_list_append(bookmarks, lineno)

fn npp_bookmark_next_scan(bookmarks, cur_line, forward_scan, best) = match bookmarks
  Nil => best
  Cons(ln, rest) =>
    if forward_scan == 1 then
      let next_best = if ln > cur_line and (best == -1 or ln < best) then ln else best in
      npp_bookmark_next_scan(rest, cur_line, forward_scan, next_best)
    else
      let next_best = if ln < cur_line and (best == -1 or ln > best) then ln else best in
      npp_bookmark_next_scan(rest, cur_line, forward_scan, next_best)

## `Notepad_plus::bookmarkNext(bool forwardScan)` (`Notepad_plus.cpp` lines 5210-5232)
## Scans forward (`lineno + 1 .. end`) with wrap-around retry from `0`, or backward with wrap-around from `maxLine`.
fn npp_bookmark_next(bookmarks, cur_line, forward_scan, total_lines) =
  let direct = npp_bookmark_next_scan(bookmarks, cur_line, forward_scan, -1) in
  if direct != -1 then direct
  else if forward_scan == 1 then
    npp_bookmark_next_scan(bookmarks, -1, 1, -1)
  else
    npp_bookmark_next_scan(bookmarks, total_lines + 1, 0, -1)

## ============================================================================
## 10. URL Hotspot Scanner (`Notepad_plus.cpp` lines 3438-3542)
## ============================================================================

fn npp_is_url_trailing_punct(c) =
  c == "." or c == "," or c == ":" or c == ";" or c == "?" or c == "!" or c == "#"

fn npp_strip_url_trailing(url) =
  let n = count(url) in
  if n <= 8 then url
  else if npp_is_url_trailing_punct(at(url, n - 1)) then npp_strip_url_trailing(slice(url, 0, n - 1))
  else if at(url, n - 1) == ")" and npp_startswith(url, "(") == 0 then slice(url, 0, n - 1)
  else url

fn npp_extract_url_at(text, start) =
  let rest = slice(text, start, count(text)) in
  if npp_startswith(rest, "https://") == 1 or npp_startswith(rest, "http://") == 1 then
    let sp = npp_line_end(rest, 0, count(rest)) in
    npp_strip_url_trailing(slice(rest, 0, sp))
  else ""

