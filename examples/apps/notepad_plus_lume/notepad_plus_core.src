## `Notepad_plus::otherFromView(int whichOne)` (`Notepad_plus.h` line 464)
fn npp_other_from_view(which_one: int) -> int
  requires which_one == 0 or which_one == 1
  ensures (result == 0 or result == 1) and result != which_one
  = if which_one == 0 then 1 else 0

law npp_other_view_involution(v: int) =
  if v == 0 or v == 1 then 1 - (1 - v) == v else 1 == 1

## `Notepad_plus::viewVisible(int whichOne)` & `bothActive()` (`Notepad_plus.cpp` line 4710, `Notepad_plus.h` line 452)
fn npp_view_visible(win_status: int, which_one: int) -> int
  requires win_status >= 1 and win_status <= 7 and (which_one == 0 or which_one == 1)
  ensures result == 0 or result == 1
  = if which_one == 0 then (if win_status == 1 or win_status == 3 or win_status == 5 or win_status == 7 then 1 else 0)
    else (if win_status == 2 or win_status == 3 or win_status == 6 or win_status == 7 then 1 else 0)

fn npp_both_active(win_status: int) -> int
  requires win_status >= 1 and win_status <= 7
  ensures result == 0 or result == 1
  = if win_status == 3 or win_status == 7 then 1 else 0

## `Notepad_plus::canHideView(int whichOne)` (`Notepad_plus.cpp` lines 4764-4774)
## Proven invariant: A view can only be hidden if BOTH views are active, and the target view
## has exactly 1 tab which is clean (`dirty == 0`) and untitled (`untitled == 1`).
fn npp_can_hide_view(win_status: int, which_one: int, tab_count: int, first_dirty: int, first_untitled: int) -> int
  requires win_status >= 1 and win_status <= 7 and (which_one == 0 or which_one == 1) and tab_count >= 1
  ensures result == 0 or (result == 1 and tab_count == 1 and first_dirty == 0 and first_untitled == 1)
  = if win_status != 3 and win_status != 7 then 0
    else if tab_count == 1 and first_dirty == 0 and first_untitled == 1 then 1
    else 0

## `Notepad_plus::getBOMSize(UniMode u)` (`Notepad_plus.cpp` lines 4425-4437)
fn npp_get_bom_size(uni_mode: int) -> int
  requires uni_mode >= 0 and uni_mode <= 7
  ensures result == 0 or result == 2 or result == 3
  = if uni_mode == 2 or uni_mode == 3 then 2
    else if uni_mode == 1 then 3
    else 0

## `Notepad_plus::isFormatUnicode(UniMode u)` (`Notepad_plus.cpp` lines 4420-4423)
fn npp_is_format_unicode(uni_mode: int) -> int
  requires uni_mode >= 0 and uni_mode <= 7
  ensures result == 0 or result == 1
  = if uni_mode != 0 and uni_mode != 5 and uni_mode != 1 and uni_mode != 4 then 1 else 0

## `Notepad_plus::getTaskListInfo` status priority (`Notepad_plus.cpp` line 5910):
## `b->isMonitoringOn() ? tb_monitored : (b->isReadOnly() ? tb_ro : (b->isDirty() ? tb_unsaved : tb_saved))`
fn npp_buffer_tb_status(is_monitoring: int, is_readonly: int, is_dirty: int) -> int
  requires (is_monitoring == 0 or is_monitoring == 1) and (is_readonly == 0 or is_readonly == 1) and (is_dirty == 0 or is_dirty == 1)
  ensures result >= 0 and result <= 3
  = if is_monitoring == 1 then 3
    else if is_readonly == 1 then 2
    else if is_dirty == 1 then 1
    else 0

## `isSenderTrusted` (`NppBigSwitch.cpp` lines 128-187)
## Formally verified security gate for `WM_COPYDATA` IPC:
## 1. Sender window must be valid (`hwnd_valid == 1`).
## 2. Sender PID must be non-zero and strictly different from `self_pid` (blocks same-process spoofing).
## 3. Mandatory Integrity Level must be `>= SECURITY_MANDATORY_MEDIUM_RID` (`8192`, blocks Low-IL sandboxes).
## 4. Executable image path must match our own binary (`same_image_path == 1`).
fn npp_is_sender_trusted(hwnd_valid: int, sender_pid: int, self_pid: int, integrity_rid: int, same_image_path: int) -> int
  requires sender_pid >= 0 and self_pid > 0 and integrity_rid >= 0
  ensures result == 0 or (result == 1 and hwnd_valid == 1 and sender_pid != self_pid and integrity_rid >= 8192 and same_image_path == 1)
  = if hwnd_valid != 1 then 0
    else if sender_pid == 0 or sender_pid == self_pid then 0
    else if integrity_rid < 8192 then 0
    else if same_image_path != 1 then 0
    else 1

## `Notepad_plus::syncZoom` invariant (`Notepad_plus.cpp` lines 5816-5828)
fn npp_sync_sub_zoom(zoom_sync: int, both_visible: int, main_zoom: int, sub_zoom: int) -> int
  requires (zoom_sync == 0 or zoom_sync == 1) and (both_visible == 0 or both_visible == 1)
  ensures (zoom_sync == 1 and both_visible == 1 and result == main_zoom) or ((zoom_sync == 0 or both_visible == 0) and result == sub_zoom)
  = if zoom_sync == 1 and both_visible == 1 then main_zoom else sub_zoom

## ============================================================================
## 3. List & String Manipulation Helpers (Zero-Pointer Value Semantics)
## ============================================================================

fn npp_list_len(xs) = match xs
  Nil => 0
  Cons(h, t) => 1 + npp_list_len(t)

fn npp_list_at(xs, idx) = match xs
  Nil => -1
  Cons(h, t) => if idx <= 0 then h else npp_list_at(t, idx - 1)

fn npp_list_index_of_go(xs, target, i) = match xs
  Nil => -1
  Cons(h, t) => if h == target then i else npp_list_index_of_go(t, target, i + 1)

fn npp_list_index_of(xs, target) = npp_list_index_of_go(xs, target, 0)

fn npp_list_set(xs, idx, val) = match xs
  Nil => Nil
  Cons(h, t) => if idx == 0 then Cons(val, t) else Cons(h, npp_list_set(t, idx - 1, val))

fn npp_list_append(xs, val) = match xs
  Nil => Cons(val, Nil)
  Cons(h, t) => Cons(h, npp_list_append(t, val))

fn npp_list_remove_at(xs, idx) = match xs
  Nil => Nil
  Cons(h, t) => if idx == 0 then t else Cons(h, npp_list_remove_at(t, idx - 1))

fn npp_startswith(s, prefix) =
  let ns = count(s) in
  let np = count(prefix) in
  if ns < np then 0 else if slice(s, 0, np) == prefix then 1 else 0

fn npp_endswith(s, suffix) =
  let ns = count(s) in
  let nf = count(suffix) in
  if ns < nf then 0 else if slice(s, ns - nf, ns) == suffix then 1 else 0

fn npp_is_ws_char(c) = c == " " or c == "\t"

fn npp_ltrim_line(s, i, n) =
  if i >= n then ""
  else if npp_is_ws_char(at(s, i)) then npp_ltrim_line(s, i + 1, n)
  else slice(s, i, n)

fn npp_rtrim_line(s, n) =
  if n <= 0 then ""
  else if npp_is_ws_char(at(s, n - 1)) then npp_rtrim_line(s, n - 1)
  else slice(s, 0, n)

fn npp_line_end(s, i, n) =
  if i >= n then n
  else if at(s, i) == "\n" then i
  else npp_line_end(s, i + 1, n)

fn npp_split_lines_go(s, i, n) =
  if i > n then Nil
  else let e = npp_line_end(s, i, n) in
  let raw_line = slice(s, i, e) in
  let clean_line = if count(raw_line) > 0 and at(raw_line, count(raw_line) - 1) == "\r" then slice(raw_line, 0, count(raw_line) - 1) else raw_line in
  if e == n then Cons(clean_line, Nil)
  else Cons(clean_line, npp_split_lines_go(s, e + 1, n))

fn npp_split_lines(s) =
  if count(s) == 0 then Cons("", Nil)
  else npp_split_lines_go(s, 0, count(s))

fn npp_join_lines(lines, eol) = match lines
  Nil => ""
  Cons(h, t) => match t
    Nil => h
    Cons(h2, t2) => h + eol + npp_join_lines(t, eol)

