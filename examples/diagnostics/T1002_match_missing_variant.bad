## T1002 -- a match that leaves a constructor of the type out.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; T1002_match_missing_variant.fixed.src is the corrected program)
## fix: add an arm for every constructor (or a final _ arm)
type C = enum Red | Green | Blue
fn f(c: C) -> int = match c { Red => 1, Green => 2 }
print f(Red)
