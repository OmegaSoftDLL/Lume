## T0400 -- an impl that leaves out a method of its trait.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; T0400_impl_missing_method.fixed.src is the corrected program)
## fix: write every method the trait lists
type Metric = record base: int, weight: int
trait Summary { fn score(m: Metric) -> int
 fn scaled(m: Metric, factor: int) -> int }
impl Summary for Metric { fn score(m: Metric) -> int = m.base }
print 0
