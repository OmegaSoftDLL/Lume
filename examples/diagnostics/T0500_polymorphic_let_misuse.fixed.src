## T0500 fixed -- pass the value of the right type.
## command: lume build gives no T0500 here; lume test runs the test_ functions
fn need_int(x: int) -> int = x + 1
fn good_poly() -> int = let id = fn(x) => x in let n = id(10) in let s = id("hello") in need_int(n) + count(s)
fn test_poly() = good_poly() == 16
