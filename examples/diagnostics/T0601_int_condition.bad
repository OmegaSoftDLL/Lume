## T0601 -- an int used where a condition (bool) is needed: nothing converts silently.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; T0601_int_condition.fixed.src is the corrected program)
## fix: compare explicitly: a != 0
fn f(a: int) -> int = if a then 1 else 0
print f(1)
