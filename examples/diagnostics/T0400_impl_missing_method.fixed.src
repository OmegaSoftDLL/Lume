## T0400 fixed -- write every method the trait lists.
## command: lume build gives no T0400 here; lume test runs the test_ functions
type Metric = record base: int, weight: int
trait Summary { fn score(m: Metric) -> int
 fn scaled(m: Metric, factor: int) -> int }
impl Summary for Metric { fn score(m: Metric) -> int = m.base
 fn scaled(m: Metric, factor: int) -> int = m.base * factor }
fn test_score() = let m = Metric{base: 2, weight: 3} in m.score() == 2 and m.scaled(5) == 10
