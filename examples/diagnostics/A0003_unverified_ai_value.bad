## A0003 -- the value of an llm fn returned by a pub fn without verification.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; A0003_unverified_ai_value.fixed.src is the corrected program)
## fix: verify it before it leaves (or keep the function private)
llm fn ask_ai(x: int) -> int = x + 10
pub fn ship(x: int) -> int = ask_ai(x)
print ship(5)
