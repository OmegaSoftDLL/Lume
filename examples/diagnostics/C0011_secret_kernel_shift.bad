## C0011 -- a constant-time (@secret @no_alloc) kernel that shifts by a variable amount.
## command: lume check   (this file shows the diagnostic: the gate runs a copy named .src; C0011_secret_kernel_shift.fixed.src is the corrected program)
## fix: shift by a constant
@secret
@no_alloc
fn k(a: int, s: int) -> int = bit_shr(a, s)
print k(1, 2)
