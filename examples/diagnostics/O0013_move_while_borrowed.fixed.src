## O0013 fixed -- end the borrow first, or clone.
## command: lume build gives no O0013 here; lume test runs the test_ functions
fn peek(x: str) -> int = 1
fn eat(own x: str) -> int = 1
fn run() -> int = let s = "a" in let r = borrow(s) in let p = peek(r) in p + eat(own s)
fn test_run() = run() == 2
