## T0401 -- a method called on a type that has no impl of it.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; T0401_method_without_impl.fixed.src is the corrected program)
## fix: call it on a type with an impl, or write the impl
type Metric = record base: int
type Other = record v: int
trait Summary { fn score(m: Metric) -> int }
impl Summary for Metric { fn score(m: Metric) -> int = m.base }
fn bad(o: Other) -> int = o.score()
print 0
