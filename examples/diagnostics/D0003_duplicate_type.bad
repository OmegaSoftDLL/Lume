## D0003 -- two types with one name.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; D0003_duplicate_type.fixed.src is the corrected program)
## fix: give the second type its own name
type Size = enum Small | Big
type Size = enum Tiny | Huge
fn n(s: Size) -> int = match s
    Small => 1
    Big   => 2
print n(Big)
