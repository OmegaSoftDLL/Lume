## P0004 -- an attribute name the compiler does not know (here a typo of @no_alloc).
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; P0004_unknown_attribute.fixed.src is the corrected program)
## fix: spell a known attribute
@no_aloc
fn f(x: int) -> int = x + 1
print f(1)
