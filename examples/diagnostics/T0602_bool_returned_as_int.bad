## T0602 -- a function declared -> int answers a comparison (bool).
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; T0602_bool_returned_as_int.fixed.src is the corrected program)
## fix: declare -> bool, or answer if a < 3 then 1 else 0
fn small(a: int) -> int = a < 3
print small(1)
