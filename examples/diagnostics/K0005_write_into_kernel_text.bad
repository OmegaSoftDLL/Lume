## K0005 -- a physical write into the protected kernel text/rodata range [32768..262143].
## command: lume check   (this file shows the diagnostic: the gate runs a copy named .src; K0005_write_into_kernel_text.fixed.src is the corrected program)
## fix: write outside the protected range
fn bad_wx(off: int) = let base = 32768 in mmio_volatile_write64(base + off, 42)
