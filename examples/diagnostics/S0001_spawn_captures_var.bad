## S0001 -- a 'var' captured by spawn.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; S0001_spawn_captures_var.fixed.src is the corrected program)
## fix: pass an owned copy (a let), or a channel
fn bad_mut() -> int = var x = 10 in scope s in spawn(x + 1)
print bad_mut()
