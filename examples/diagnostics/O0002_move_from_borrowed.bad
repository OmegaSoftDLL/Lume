## O0002 -- a borrowed parameter moved away.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; O0002_move_from_borrowed.fixed.src is the corrected program)
## fix: take the parameter as 'own', or clone it
fn consume(own x: int) -> int = x
fn inspect(f: int) -> int = consume(own f)
print inspect(10)
