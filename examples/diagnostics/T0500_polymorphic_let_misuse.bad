## T0500 -- a generic let function used at str where an int is needed.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; T0500_polymorphic_let_misuse.fixed.src is the corrected program)
## fix: pass the value of the right type
fn need_int(x: int) -> int = x + 1
fn bad_poly() -> int = let id = fn(x) => x in let n = id(10) in let s = id("hello") in need_int(s)
print bad_poly()
