## T0401 fixed -- call it on a type with an impl, or write the impl.
## command: lume build gives no T0401 here; lume test runs the test_ functions
type Metric = record base: int
trait Summary { fn score(m: Metric) -> int }
impl Summary for Metric { fn score(m: Metric) -> int = m.base }
fn good(m: Metric) -> int = m.score()
fn test_good() = good(Metric{base: 4}) == 4
