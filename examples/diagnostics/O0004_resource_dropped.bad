## O0004 -- a resource that is never released.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; O0004_resource_dropped.fixed.src is the corrected program)
## fix: release it (here close_h), return it, or pass it on
resource type H = record fd: int
fn close_h(own h: H) -> int = h.fd
fn run() -> int = let h = H{fd: 3} in 7
print run()
