## T0603 -- an int passed to a bool parameter.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; T0603_argument_type.fixed.src is the corrected program)
## fix: pass a comparison
fn g(p: bool) -> int = if p then 1 else 0
fn f(a: int) -> int = g(a)
print f(2)
