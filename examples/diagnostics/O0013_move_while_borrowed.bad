## O0013 -- a value moved while a borrow of it is still used.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; O0013_move_while_borrowed.fixed.src is the corrected program)
## fix: end the borrow first, or clone
fn peek(x: str) -> int = 1
fn eat(own x: str) -> int = 1
fn run() -> int = let s = "a" in let r = borrow(s) in let n = eat(own s) in peek(r) + n
print run()
