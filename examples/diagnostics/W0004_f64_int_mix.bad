## W0004 -- an operator mixes an f64 and an int: the int is converted at run time, and the warning asks to say so.
## command: lume agent check   (this file shows the diagnostic: the gate runs a copy named .src; W0004_f64_int_mix.fixed.src is the corrected program)
## fix: write f64(n) for the int
use math
fn twice(x: f64) -> f64 = x * 2
fn test_twice() = twice(f64(3)) == f64(6)
