## O0010 -- an immutable let passed to a 'mut' parameter.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; O0010_immutable_to_mut.fixed.src is the corrected program)
## fix: declare it with 'var'
fn bump(mut x: int) -> int = x + 1
fn bad() -> int = let a = 10 in bump(mut a)
print bad()
