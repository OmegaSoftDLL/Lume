## O0011 -- one value borrowed as mut and read in the same call.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; O0011_conflicting_borrows.fixed.src is the corrected program)
## fix: read it into a temporary first
fn transfer(mut dst: int, src: int) -> int = dst + src
fn bad() -> int = var x = 5 in transfer(mut x, x)
print bad()
