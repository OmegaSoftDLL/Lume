## E0305 fixed -- read what you need before sending it (an int read out is a copy).
## command: lume build gives no E0305 here; lume test runs the test_ functions
fn chan_send_linear(ch, x) = x
fn good_sender() =
    let msg = {id: 42, val: 99} in
    let v = msg.val in
    let _sent = chan_send_linear(1, msg) in
    v
fn test_sender() = good_sender() == 99
