## E0305 -- a linear message used after it was sent.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; E0305_linear_used_after_send.fixed.src is the corrected program)
## fix: read what you need before sending it (an int read out is a copy)
fn chan_send_linear(ch, x) = x
fn bad_sender() =
    let msg = {id: 42, val: 99} in
    let _sent = chan_send_linear(1, msg) in
    msg.val
print bad_sender()
