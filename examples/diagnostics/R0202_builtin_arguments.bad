## R0202 -- a builtin called with the wrong number of arguments.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; R0202_builtin_arguments.fixed.src is the corrected program)
## fix: slice takes (s, from, to): the reference lists every builtin with its exact signature
fn tail(s: str) -> str = slice(s, 1)
print tail("abc")
