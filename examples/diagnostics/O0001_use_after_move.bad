## O0001 -- a value used after it was moved.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; O0001_use_after_move.fixed.src is the corrected program)
## fix: borrow it, or clone it before the move
fn consume(own x: int) -> int = x
fn bad() -> int = let f = 42 in let c = consume(own f) in f
print bad()
