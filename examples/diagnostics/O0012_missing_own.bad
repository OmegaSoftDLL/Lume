## O0012 -- an 'own' parameter given an argument without 'own'.
## command: lume build   (this file shows the diagnostic: the gate runs a copy named .src; O0012_missing_own.fixed.src is the corrected program)
## fix: write 'own' at the call
fn consume(own x: int) -> int = x
fn bad() -> int = let f = 42 in consume(f)
print bad()
