## O0004 fixed -- release it (here close_h), return it, or pass it on.
## command: lume build gives no O0004 here; lume test runs the test_ functions
resource type H = record fd: int
fn close_h(own h: H) -> int = h.fd
fn run() -> int = let h = H{fd: 3} in close_h(own h) + 4
fn test_run() = run() == 7
