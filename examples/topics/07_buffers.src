## 07_buffers.src -- byte buffers: buf_new, buf_get / buf_set, slices, and the bit writer used by codecs.
## Run: lume test examples/topics/07_buffers.src

fn fill(b: buf, i: int, n: int) -> int = if i >= n then n else let w = buf_set(b, i, i * 3 % 256) in fill(b, i + 1, n)
fn sum_bytes(b: buf, i: int, acc: int) -> int = if i >= buf_len(b) then acc else sum_bytes(b, i + 1, acc + buf_get(b, i))

fn test_new_and_len() = buf_len(buf_new(16)) == 16 and buf_get(buf_new(4), 0) == 0
fn test_fill() = let b = buf_new(10) in let n = fill(b, 0, 10) in sum_bytes(b, 0, 0) == 135
## an index outside the buffer stops the program with "byte buffer index or range out of bounds": check first
fn get_or(b: buf, i: int, d: int) -> int = if i < 0 or i >= buf_len(b) then d else buf_get(b, i)
fn test_checked_read() = get_or(buf_new(4), 9, 0 - 1) == 0 - 1 and get_or(buf_new(4), 1, 0 - 1) == 0
## buf_bits_write(b, pos, value, n) writes n bits MSB first at bit position pos and answers the new position
fn test_bits() = let b = buf_new(2) in let p = buf_bits_write(b, 0, 5, 3) in let q = buf_bits_write(b, p, 1, 1) in q == 4 and buf_get(b, 0) == 176
