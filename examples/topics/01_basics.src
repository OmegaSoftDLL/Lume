## 01_basics.src -- values, let, if, functions and recursion. Run: lume test examples/topics/01_basics.src
## Every fn whose name starts with test_ is a test: it must answer true.

## a function is one expression; `let ... in` names a value; `if` always has an else
fn area(w: int, h: int) -> int = w * h
fn clamp(x: int, lo: int, hi: int) -> int = if x < lo then lo else if x > hi then hi else x
fn describe(n: int) -> str = let kind = (if n % 2 == 0 then "even" else "odd") in str(n) + " is " + kind

## repetition is recursion; a call in tail position does not grow the stack
fn sum_to(n: int, acc: int) -> int = if n == 0 then acc else sum_to(n - 1, acc + n)
fn fact(n: int) -> int = if n <= 1 then 1 else n * fact(n - 1)

fn test_area() = area(3, 4) == 12
fn test_clamp() = clamp(15, 0, 10) == 10 and clamp(0 - 5, 0, 10) == 0 and clamp(7, 0, 10) == 7
fn test_describe() = describe(4) == "4 is even" and describe(7) == "7 is odd"
fn test_sum_to() = sum_to(100000, 0) == 5000050000
fn test_fact() = fact(10) == 3628800
## integer division truncates; % keeps the sign of the left operand
fn test_division() = 7 / 2 == 3 and 7 % 3 == 1 and (0 - 7) / 2 == 0 - 3
