## 02_lists.src -- lists, pattern matching and the seq module (loops without hand-written recursion).
## Run: lume test examples/topics/02_lists.src
use seq

## a list is Nil or Cons(head, tail); [1, 2, 3] is Cons(1, Cons(2, Cons(3, Nil)))
fn total(xs) = match xs
    Nil        => 0
    Cons(h, t) => h + total(t)
fn firsts(xs, n) = match xs
    Nil        => Nil
    Cons(h, t) => if n == 0 then Nil else Cons(h, firsts(t, n - 1))

fn test_match() = total([1, 2, 3, 4]) == 10 and total(Nil) == 0
fn test_firsts() = firsts([5, 6, 7], 2) == [5, 6]
## map / filter / fold with anonymous functions fn(x) => ...
fn test_seq() = seq_map([1, 2, 3], fn(x) => x * 10) == [10, 20, 30] and seq_filter([1, 2, 3, 4], fn(x) => x % 2 == 0) == [2, 4] and seq_fold([1, 2, 3], 0, fn(a, x) => a + x) == 6
## seq_loop(a, b, acc, f): for i in a..b-1, acc = f(i, acc)
fn test_loop() = seq_loop(0, 10, 0, fn(i, acc) => acc + i * i) == 285
fn test_range() = seq_range(3, 6) == [3, 4, 5] and seq_len(seq_range(0, 1000)) == 1000
