## 03_records.src -- records: literals, fields, updates with `with`, records returned by functions.
## Run: lume test examples/topics/03_records.src

fn point(x: int, y: int) = {x: x, y: y}
fn moved(p, dx: int) = {p with x: p.x + dx}
fn bbox(a, b) = {lo: point(if a.x < b.x then a.x else b.x, if a.y < b.y then a.y else b.y), hi: point(if a.x > b.x then a.x else b.x, if a.y > b.y then a.y else b.y)}

fn test_fields() = let p = point(2, 3) in p.x == 2 and p.y == 3
## `with` builds a new record; the old one is unchanged
fn test_update() = let p = point(1, 1) in let q = moved(p, 4) in q.x == 5 and q.y == 1 and p.x == 1
fn test_nested() = let b = bbox(point(5, 1), point(2, 8)) in b.lo.x == 2 and b.lo.y == 1 and b.hi.x == 5 and b.hi.y == 8
fn test_equality() = point(1, 2) == point(1, 2) and point(1, 2) != point(2, 1)
