## 08_floats.src -- f64: parameters typed f64, `use math`, explicit conversions.
## Run: lume test examples/topics/08_floats.src
use math

fn hyp(a: f64, b: f64) -> f64 = sqrt(a * a + b * b)
fn mean(xs, acc: f64, n: int) -> f64 = match xs
    Nil        => if n == 0 then f64(0) else acc / f64(n)
    Cons(h, t) => mean(t, acc + h, n + 1)

fn test_hyp() = hyp(3.0, 4.0) == f64(5)
## int and f64 never mix silently: f64(n) converts, f64_int(x) truncates back
fn test_conversions() = f64(7) / f64(2) == tofloat("3.5") and f64_int(tofloat("3.9")) == 3
fn test_mean() = mean([f64(1), f64(2), f64(6)], f64(0), 0) == f64(3)
fn test_round_trip() = str(tofloat("0.1")) == "0.1" and floor(tofloat("2.7")) == f64(2)
