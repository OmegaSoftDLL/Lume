## 05_strings.src -- strings: length, slices, characters, conversion to and from numbers.
## Run: lume test examples/topics/05_strings.src

fn shout(s: str) -> str = s + "!"
## count(s) is the length, at(s, i) the character i, slice(s, a, b) the characters a..b-1
fn reverse(s: str, i: int, acc: str) -> str = if i >= count(s) then acc else reverse(s, i + 1, at(s, i) + acc)
fn digits(s: str, i: int, acc: int) -> int = if i >= count(s) then acc else digits(s, i + 1, acc * 10 + ord(at(s, i)) - 48)

fn test_concat() = shout("hi") == "hi!"
fn test_slices() = slice("lumedesk", 0, 4) == "lume" and at("abc", 1) == "b" and count("") == 0
fn test_reverse() = reverse("abc", 0, "") == "cba"
## str(n) and toint(s) convert; ord / chr go between characters and codes
fn test_numbers() = str(42) == "42" and toint("123") == 123 and digits("907", 0, 0) == 907 and ord("A") == 65 and chr(97) == "a"
## strings compare by content and order
fn test_compare() = "abc" == "abc" and "abc" < "abd"
