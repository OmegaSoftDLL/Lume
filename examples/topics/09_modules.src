## 09_modules.src -- modules: `use NAME` brings a module from the project or the standard library, `use std/NAME`
## always the standard one, `use NAME as X` keeps its names apart as X.name. Run: lume test examples/topics/09_modules.src
use std/seq
use math as m

fn test_std_seq() = seq_sum([1, 2, 3]) == 6
fn test_alias() = m.sqrt(f64(81)) == f64(9)
