## 10_files.src -- files: write, read, test for existence, remove. Functions that touch the system carry an effect
## (`/ {io}`, `/ {fs}`), checked by the compiler. Run: lume test examples/topics/10_files.src

fn tmp_path() -> str = (if os_getenv("TMPDIR") != "" then os_getenv("TMPDIR") else "/tmp") + "/lume_example_10.txt"
fn save(path: str, text: str) -> int / {fs} = fs_write_sync(path, text)

fn test_write_read() = let p = tmp_path() in let w = save(p, "line 1\nline 2\n") in let r = fs_read_file(p) in let z = fs_remove(p) in r == "line 1\nline 2\n"
fn test_missing() = fs_path_exists("/no/such/lume/file") == 0
