## 04_types.src -- enum types with payloads, match over constructors, records with an invariant.
## Run: lume test examples/topics/04_types.src

type Shape = enum Circle(int) | Rect(int, int) | Dot
fn area(s: Shape) -> int = match s
    Circle(r)  => 3 * r * r
    Rect(w, h) => w * h
    Dot        => 0

## a result type: Ok with a value or Err with a message
type Parsed = enum Ok(int) | Err(str)
fn parse_digit(c: str) -> Parsed = if c >= "0" and c <= "9" then Ok(ord(c) - 48) else Err("not a digit: " + c)
fn or_zero(p: Parsed) -> int = match p
    Ok(n)  => n
    Err(m) => 0

fn test_area() = area(Circle(2)) == 12 and area(Rect(3, 5)) == 15 and area(Dot) == 0
fn test_result() = or_zero(parse_digit("7")) == 7 and or_zero(parse_digit("x")) == 0
fn test_err_message() = match parse_digit("x")
    Ok(n)  => false
    Err(m) => m == "not a digit: x"
