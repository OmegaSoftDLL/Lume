## 06_contracts.src -- requires / ensures. `lume prove examples/topics/06_contracts.src` proves them; a contract the
## prover cannot decide is checked at run time. Run: lume test examples/topics/06_contracts.src

fn abs_val(x: int) -> int
    ensures result >= 0
    = if x < 0 then 0 - x else x

fn safe_div(a: int, b: int) -> int
    requires b != 0
    = a / b

fn max3(a: int, b: int, c: int) -> int
    ensures result >= a and result >= b and result >= c
    = let m = (if a > b then a else b) in if m > c then m else c

## builtins have contracts the prover knows too: buf_bits_write answers p + n or -1. The requires bound p so that the
## clause itself cannot overflow (p + 3 past the largest int would stop the program, and the prover sees that)
fn put3(b: buf, p: int, v: int) -> int
    requires p >= 0 and p <= 1000000000
    ensures result == p + 3 or result == 0 - 1
    = buf_bits_write(b, p, v, 3)

fn test_abs() = abs_val(0 - 9) == 9 and abs_val(4) == 4
fn test_div() = safe_div(10, 3) == 3
fn test_max3() = max3(1, 9, 4) == 9 and max3(7, 2, 3) == 7
fn test_put3() = put3(buf_new(4), 0, 5) == 3
