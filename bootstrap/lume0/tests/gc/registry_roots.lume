fn churn(n: int) -> int
    var i = 0
    var total = 0
    while i < n
        let s = "abcdefghijklmnopqrstuvwxyz0123456789"
        total = total + (s + s + s + s).len()
        i = i + 1
    total

fn main()
    let p = P(1)
    let c = churn(1500000)
    io.println(p.m0() + p.m50() + p.m100() + p.m150() + p.m200() + p.m250())
    io.println(c)
