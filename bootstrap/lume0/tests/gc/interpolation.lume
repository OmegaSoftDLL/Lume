# An interpolated value may be far longer than the literal, and an interpolated expression's AST keeps
# pointing at its source text across collections.
use std.io

fn pad(n: int) -> str
    var s = "x"
    var i = 0
    while i < n
        s = s + s
        i = i + 1
    s

fn main()
    let big = pad(16)
    var total = 0
    var i = 0
    while i < 40
        let t = "<{big}|{big}>"
        total = total + t.len()
        i = i + 1
    var j = 0
    var last = ""
    while j < 300000
        last = "v={[j, j + 1][1]}"
        j = j + 1
    io.println(total)
    io.println(last)
