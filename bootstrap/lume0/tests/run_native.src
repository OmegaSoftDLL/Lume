fn nt_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else nt_line_end(text, i + 1)

fn nt_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, nt_line_end(input, 0))

fn nt_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else nt_contains_at(text, part, i + 1)

fn nt_contains(text, part) = nt_contains_at(text, part, 0)

fn nt_run(path, args, out) = os_run_capture_timeout(path, args, out, out + ".err", 120000)

fn nt_seed(root, args, out) = nt_run(root + "/bootstrap/lume0/lume0", args, out)

fn nt_driver(root, args, out) = nt_run(root + "/build/bin/lume_driver", args, out)

fn nt_process_problem(label, status, out) = if status == 0 then "" else label + " failed with native status " + str(status) + "\nstdout:\n" + fs_read_file(out) + "\nstderr:\n" + fs_read_file(out + ".err") + "\n"

fn nt_output_problem(label, status, out, expected) = let process = nt_process_problem(label, status, out) in if process != "" then process else if fs_files_equal(out, expected) != 1 then label + " output differs from " + expected + "\nactual:\n" + fs_read_file(out) + "\nexpected:\n" + fs_read_file(expected) else ""

fn nt_check_case(root, name) = let source = root + "/examples/" + name + ".lume" in let out = root + "/build/native-test/check-" + name + ".out" in let checked = nt_seed(root, Cons("check", Cons(source, Nil)), out) in let problem = nt_process_problem("seed check " + name, checked, out) in if problem != "" then problem else let parsed = nt_seed(root, Cons("parse", Cons(source, Nil)), root + "/build/native-test/parse-" + name + ".out") in nt_process_problem("seed parse " + name, parsed, root + "/build/native-test/parse-" + name + ".out")

fn nt_check_cases(root, names) = match names
    Nil        => ""
    Cons(h, t) => let problem = nt_check_case(root, h) in if problem != "" then problem else nt_check_cases(root, t)

fn nt_stage0_case(root, name) = let source = root + "/examples/" + name + ".lume" in let expected = root + "/tests/conformance/stage0/" + name + ".expected" in let out = root + "/build/native-test/run-" + name + ".out" in let status = nt_seed(root, Cons("run", Cons(source, Nil)), out) in let problem = nt_output_problem("seed run " + name, status, out, expected) in if problem != "" then problem else let encoded = root + "/build/native-test/" + name + ".lbe" in let emitted = nt_seed(root, Cons("emit", Cons(source, Cons(encoded, Nil))), root + "/build/native-test/emit-" + name + ".out") in let emit_problem = nt_process_problem("seed LBE emit " + name, emitted, root + "/build/native-test/emit-" + name + ".out") in if emit_problem != "" then emit_problem else let lbe_out = root + "/build/native-test/lbe-" + name + ".out" in let executed = nt_seed(root, Cons("run", Cons(encoded, Nil)), lbe_out) in nt_output_problem("seed LBE run " + name, executed, lbe_out, expected)

fn nt_stage0_cases(root, names) = match names
    Nil        => ""
    Cons(h, t) => let problem = nt_stage0_case(root, h) in if problem != "" then problem else nt_stage0_cases(root, t)

fn nt_token_case(root, name) = let source = root + "/bootstrap/lume0/tests/lexer/" + name + ".lume" in let expected = root + "/bootstrap/lume0/tests/lexer/" + name + ".tokens" in let out = root + "/build/native-test/tokens-" + name + ".out" in let status = nt_seed(root, Cons("tokens", Cons(source, Nil)), out) in nt_output_problem("seed tokens " + name, status, out, expected)

fn nt_token_cases(root, names) = match names
    Nil        => ""
    Cons(h, t) => let problem = nt_token_case(root, h) in if problem != "" then problem else nt_token_cases(root, t)

fn nt_negative_seed(root, relative, code) = let source = root + "/bootstrap/lume0/tests/" + relative in let out = root + "/build/native-test/negative-" + code + ".out" in let status = nt_seed(root, Cons("check", Cons(source, Cons("--json", Nil))), out) in if status == 0 then "seed accepted negative fixture " + relative else if nt_contains(fs_read_file(out), "\"code\":\"" + code + "\"") == 0 then "seed emitted the wrong diagnostic for " + relative + "\n" + fs_read_file(out) + fs_read_file(out + ".err") else ""

fn nt_negative_seeds(root) = let lexer = nt_negative_seed(root, "lexer/bad_escape.lume", "L0021") in if lexer != "" then lexer else let parser = nt_negative_seed(root, "parser/bad_fn.lume", "P0040") in if parser != "" then parser else nt_negative_seed(root, "resolve/bad_undefined_var.lume", "R0200")

fn nt_native_build(root) = let binary = root + "/build/native-test/nfib" in let out = root + "/build/native-test/native-build.out" in let status = nt_driver(root, Cons("build", Cons(root + "/compiler/stage1/nfib.src", Cons("-o", Cons(binary, Nil)))), out) in let problem = nt_process_problem("native driver build nfib", status, out) in if problem != "" then problem else let run_out = root + "/build/native-test/native-nfib.out" in let executed = nt_run(binary, Nil, run_out) in nt_output_problem("native nfib execution", executed, run_out, root + "/tests/conformance/stage1/nfib_asm.expected")

fn nt_native_tests(root) = let out = root + "/build/native-test/native-ltest.out" in let status = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/sample_test.src", Nil)), out) in nt_output_problem("native driver test discovery", status, out, root + "/tests/conformance/stage1/ltest_pass_asm.expected")

fn nt_negative_native(root) = let source = root + "/build/native-test/failing_test.src" in let written = fs_write_sync(source, "fn test_ok() = 2 + 2 == 4\nfn test_broken() = 2 + 2 == 5\n") in if written != 1 then "native negative test fixture could not be written" else let out = root + "/build/native-test/native-ltest-fail.out" in let status = nt_driver(root, Cons("test", Cons(source, Nil)), out) in if status == 0 then "native driver accepted a failing Lume test" else let output = fs_read_file(out) in if nt_contains(output, "FAIL test_broken") == 0 or nt_contains(output, "1 passed, 1 failed") == 0 then "native driver failure output is incomplete\n" + output + fs_read_file(out + ".err") else ""

## --- Wave 1 toolchain soundness (#428): negative gates that FAIL if the bug returns. Each writes
## a bad source, runs the native toolchain's lumec/lasm pipeline on it, and requires a non-zero
## exit PLUS the specific diagnostic; accepting the source (or failing without the diagnostic) is
## a regression to the silent wrong-code incidents of #417 (undefined call), #423 (unbound
## interpolation variable), and the #417 merge (duplicated `else else`).
fn nt_soundness_negative(root, name, source_text, expect) = let source = root + "/build/native-test/" + name + ".src" in let written = fs_write_sync(source, source_text) in if written != 1 then name + " fixture could not be written" else let out = root + "/build/native-test/" + name + ".out" in let status = nt_driver(root, Cons("build", Cons(source, Cons("-o", Cons(root + "/build/native-test/" + name + ".bin", Nil)))), out) in if status == 0 then name + ": native toolchain accepted bad source (expected a compile error)" else let output = fs_read_file(out + ".err") in if nt_contains(output, expect) == 0 then name + ": expected '" + expect + "' in stderr, got:\n" + output else ""

fn nt_negative_soundness(root) = let undef_call = nt_soundness_negative(root, "w1_undefined_call", "fn helper() = 1\nprint helper() + missing_callee(2)\n", "missing_callee") in if undef_call != "" then undef_call else let undef_var = nt_soundness_negative(root, "w1_unbound_interpolation", "fn row() = \"effect row / {{ffi}} done\"\nprint row()\n", "ffi") in if undef_var != "" then undef_var else let else_else = nt_soundness_negative(root, "w1_else_else", "fn main() = if 1 == 1 then 1 else else 2\nprint main()\n", "P0002") in if else_else != "" then else_else else let then_then = nt_soundness_negative(root, "w1_then_then", "fn main() = if 1 == 1 then then 2 else 3\nprint main()\n", "P0002") in if then_then != "" then then_then else let arena_pure = nt_soundness_negative(root, "w2_arena_in_pure", "pub fn leak() / pure = __lume_arena_new(1024)\nprint 0\n", "E0200") in if arena_pure != "" then arena_pure else let w14_0 = nt_soundness_negative(root, "w14_pure_callee_defined_above", "fn w(i) = fs_path_exists(\"/x\")
fn k2() = w(1)
fn top() / pure = k2()
print 1
", "E0200") in if w14_0 != "" then w14_0 else let w14_1 = nt_soundness_negative(root, "w14_pure_reads_the_clock", "pub fn leak(x: int) -> int / pure = let z = os_monotonic_ns() in x
print 0
", "E0200") in if w14_1 != "" then w14_1 else let w14_2 = nt_soundness_negative(root, "w14_total_over_untyped_values", "total fn t(a, b) terminates (b - a) = if a < b then t(a + 1, b) else 0
print t(1, 2)
", "A0002") in if w14_2 != "" then w14_2 else let w14_3 = nt_soundness_negative(root, "w14_total_recursion_in_requires", "total fn t(n: int) -> int requires t(n) > 0 = 1
print 1
", "A0002") in if w14_3 != "" then w14_3 else let w14_4 = nt_soundness_negative(root, "w14_bound_counts_match_arms", "type IntList = enum Nil | Cons(int, IntList)
fn slow(n: int) -> int = if n <= 0 then 0 else 1 + slow(n - 1)
@bound(cycles: 20)
fn g(xs: IntList) -> int = match xs
    Nil        => 0
    Cons(h, t) => slow(h)
print g(Cons(1000, Nil))
", "V0002") in if w14_4 != "" then w14_4 else let w14_5 = nt_soundness_negative(root, "w14_number_glued_to_a_name", "fn abc() = 7
print 12abc
", "L0003") in if w14_5 != "" then w14_5 else ""

fn nt_wave2_gates(root) = let cap_out = root + "/build/native-test/w2-capsule.out" in let cap_st = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/capsule_ok.src", Nil)), cap_out) in let cap_prob = nt_process_problem("Wave 2 capsule_ok", cap_st, cap_out) in if cap_prob != "" then cap_prob else let ar_out = root + "/build/native-test/w2-arena.out" in let ar_st = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/arena_ok.src", Nil)), ar_out) in let ar_prob = nt_process_problem("Wave 2 arena_ok", ar_st, ar_out) in if ar_prob != "" then ar_prob else let by_out = root + "/build/native-test/w2-bytes.out" in let by_st = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/bytes_ok.src", Nil)), by_out) in let by_prob = nt_process_problem("Wave 2 bytes_ok", by_st, by_out) in if by_prob != "" then by_prob else let w2_src = root + "/build/native-test/w2_runtime_probe.src" in let w2_bin = root + "/build/native-test/w2_runtime_probe" in let w2_code = "fn tco_sum(n, acc) = if n <= 0 then acc else tco_sum(n - 1, acc + 1)\nfn box_loop(i, acc) = if i <= 0 then acc else box_loop(i - 1, (i % 500))\nfn main_ok() = let s1 = __lume_heap_stats() in let b = box_loop(500, 0) in let s2 = __lume_heap_stats() in let t = tco_sum(100000, 0) in let rss = os_self_maxrss_kb() in let env_out = \"" + root + "/build/native-test/w2_env.out\" in let env_err = \"" + root + "/build/native-test/w2_env.err\" in let rc = os_run_capture_timeout(\"/usr/bin/env\", Nil, env_out, env_err, 10000) in let crss = os_last_child_maxrss_kb() in if s2.used - s1.used <= 128 and t == 100000 and rss > 0 and rc == 0 and crss >= 0 and count(fs_read_file(env_out)) > 0 then 1 else 0\nprint main_ok()\n" in let w2_w = fs_write_sync(w2_src, w2_code) in let w2_b_out = root + "/build/native-test/w2-build.out" in let w2_bst = nt_driver(root, Cons("build", Cons("--memory", Cons(w2_src, Cons("-o", Cons(w2_bin, Nil))))), w2_b_out) in let w2_bprob = nt_process_problem("Wave 2 runtime probe build", w2_bst, w2_b_out) in if w2_bprob != "" then w2_bprob else if nt_contains(fs_read_file(w2_b_out + ".err"), "[memory:build]") == 0 then "Wave 2 build --memory did not emit [memory:build] telemetry" else let w2_r_out = root + "/build/native-test/w2-run.out" in let w2_rst = nt_run(w2_bin, Nil, w2_r_out) in let w2_rprob = nt_process_problem("Wave 2 runtime probe run", w2_rst, w2_r_out) in if w2_rprob != "" then w2_rprob else if fs_read_file(w2_r_out) != "1\n" then "Wave 2 runtime probe returned unexpected output: " + fs_read_file(w2_r_out) else ""

fn nt_wave3_gates(root) = let llm_out = root + "/build/native-test/w3-llm-eval.out" in let llm_st = nt_driver(root, Cons("test", Cons(root + "/scripts/llm_gen_eval.src", Nil)), llm_out) in let llm_prob = nt_process_problem("Wave 3 llm_gen_eval", llm_st, llm_out) in if llm_prob != "" then llm_prob else let lsym = root + "/build/native-test/w3_sample.lsym" in let lsym_w = fs_write_sync(lsym, "{\"lsym_version\":1,\"symbols\":{\"F1\":{\"name\":\"compute_license\",\"line\":3,\"addr\":\"0x401000\"}},\"trap_table\":{\"E#1\":\"[V0001] contract violation\"}}\n") in let sym_out = root + "/build/native-test/w3-symbolize.out" in let sym_st = nt_driver(root, Cons("symbolize", Cons(lsym, Cons("0x401008", Nil))), sym_out) in let sym_prob = nt_process_problem("Wave 3 lume symbolize", sym_st, sym_out) in if sym_prob != "" then sym_prob else if nt_contains(fs_read_file(sym_out), "\"ok\":true") == 0 or nt_contains(fs_read_file(sym_out), "\"name\":\"compute_license\"") == 0 then "Wave 3 lume symbolize output missing resolved function name:\n" + fs_read_file(sym_out) else ""

fn nt_wave4_gates(root) = let p35_out = root + "/build/native-test/w4-p35.out" in let p35_st = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/p35_ok.src", Nil)), p35_out) in let p35_prob = nt_process_problem("Wave 4 p35_ok", p35_st, p35_out) in if p35_prob != "" then p35_prob else let lpr_out = root + "/build/native-test/w4-lprotect.out" in let lpr_st = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/lprotect.src", Nil)), lpr_out) in let lpr_prob = nt_process_problem("Wave 4 lprotect", lpr_st, lpr_out) in if lpr_prob != "" then lpr_prob else let zc_out = root + "/build/native-test/w4-zeroc.out" in let zc_st = nt_driver(root, Cons("test", Cons(root + "/scripts/zero_c.src", Nil)), zc_out) in let zc_prob = nt_process_problem("Wave 4 zero_c", zc_st, zc_out) in if zc_prob != "" then zc_prob else let emb_asset = root + "/build/native-test/w4_asset.txt" in let emb_w = fs_write_sync(emb_asset, "LUME_W4_ASSET_OK") in let emb_neg = nt_soundness_negative(root, "w4_embed_no_cap", "fn bad() = comptime embed(\"" + emb_asset + "\")\nprint bad()\n", "E0200") in if emb_neg != "" then emb_neg else let sch_neg = nt_soundness_negative(root, "w4_schema_undeclared", "fn bad() = comptime table_schema(MissingRow)\nprint bad()\n", "D0273") in if sch_neg != "" then sch_neg else let w4_src = root + "/build/native-test/w4_comptime_ok.src" in let w4_bin = root + "/build/native-test/w4_comptime_ok" in let w4_code = "@capability fs\ntype InvoiceRow = record id: int, amount: int\nfn get_asset() = comptime embed(\"" + emb_asset + "\")\nfn get_schema() = comptime table_schema(InvoiceRow)\nprint get_asset() + \"|\" + get_schema()\n" in let w4_w = fs_write_sync(w4_src, w4_code) in let w4_bout = root + "/build/native-test/w4-build.out" in let w4_bst = nt_driver(root, Cons("build", Cons(w4_src, Cons("-o", Cons(w4_bin, Nil)))), w4_bout) in let w4_bprob = nt_process_problem("Wave 4 comptime embed/table_schema build", w4_bst, w4_bout) in if w4_bprob != "" then w4_bprob else let w4_rout = root + "/build/native-test/w4-run.out" in let w4_rst = nt_run(w4_bin, Nil, w4_rout) in let w4_rprob = nt_process_problem("Wave 4 comptime embed/table_schema run", w4_rst, w4_rout) in if w4_rprob != "" then w4_rprob else if fs_read_file(w4_rout) != "LUME_W4_ASSET_OK|InvoiceRow(id:int,amount:int)\n" then "Wave 4 unexpected comptime output: " + fs_read_file(w4_rout) else ""

fn nt_test_suite(root, rel) = let out = root + "/build/native-test/w5-suite.out" in let st = nt_driver(root, Cons("test", Cons(root + "/" + rel, Nil)), out) in nt_process_problem("Wave 5 test " + rel, st, out)

fn nt_test_suites(root, rels) = match rels
    Nil        => ""
    Cons(h, t) => let prob = nt_test_suite(root, h) in if prob != "" then prob else nt_test_suites(root, t)

fn nt_wave5_gates(root) = let suites = nt_test_suites(root, Cons("compiler/stage1/async_rt.src", Cons("compiler/stage1/db.src", Cons("compiler/stage1/nn.src", Cons("compiler/stage1/net.src", Cons("compiler/stage1/gui.src", Cons("compiler/stage1/media.src", Cons("compiler/stage1/levidence.src", Cons("acceptance/matrix_assertions.src", Cons("scripts/docs_ci.src", Nil)))))))))) in if suites != "" then suites else let tl_bin = root + "/build/native-test/w5_track_l_domains_ok" in let tl_bout = root + "/build/native-test/w5-tl-build.out" in let tl_bst = nt_driver(root, Cons("build", Cons(root + "/compiler/stage1/track_l_domains_ok.src", Cons("-o", Cons(tl_bin, Nil)))), tl_bout) in let tl_bprob = nt_process_problem("Wave 5 track_l_domains_ok build", tl_bst, tl_bout) in if tl_bprob != "" then tl_bprob else let tl_rout = root + "/build/native-test/w5-tl-run.out" in let tl_rst = nt_run(tl_bin, Nil, tl_rout) in nt_output_problem("Wave 5 track_l_domains_ok run", tl_rst, tl_rout, root + "/tests/conformance/stage1/track_l_domains_ok_asm.expected")

fn nt_wave6_gates(root) = let suites = nt_test_suites(root, Cons("compiler/stage1/interop.src", Cons("compiler/stage1/los.src", Nil))) in if suites != "" then suites else let sc_src = root + "/build/native-test/w6_shortcircuit.src" in let sc_bin = root + "/build/native-test/w6_shortcircuit" in let sc_code = "fn safe_div(a, b) = if b != 0 and (a / b) > 2 then 1 else 0\nfn safe_or(a, b) = if a == 1 or (10 / b) > 0 then 1 else 0\nfn ct_sc() = comptime(if (0 and (1 / 0 == 1)) == 0 and (1 or (1 / 0 == 1)) == 1 then 1 else 0)\nprint str(safe_div(10, 0)) + \"|\" + str(safe_div(10, 2)) + \"|\" + str(safe_or(1, 0)) + \"|\" + str(ct_sc())\n" in let sc_w = fs_write_sync(sc_src, sc_code) in let sc_bout = root + "/build/native-test/w6-sc-build.out" in let sc_bst = nt_driver(root, Cons("build", Cons(sc_src, Cons("-o", Cons(sc_bin, Nil)))), sc_bout) in let sc_bprob = nt_process_problem("Wave 6 short-circuit build", sc_bst, sc_bout) in if sc_bprob != "" then sc_bprob else let sc_rout = root + "/build/native-test/w6-sc-run.out" in let sc_rst = nt_run(sc_bin, Nil, sc_rout) in let sc_rprob = nt_process_problem("Wave 6 short-circuit run", sc_rst, sc_rout) in if sc_rprob != "" then sc_rprob else if fs_read_file(sc_rout) != "0|1|1|1\n" then "Wave 6 short-circuit unexpected output: " + fs_read_file(sc_rout) else let sk_out = root + "/build/native-test/w6-skeleton.out" in let sk_st = nt_driver(root, Cons("agent", Cons("skeleton", Cons(root + "/compiler/stage1/los.src", Nil))), sk_out) in let sk_prob = nt_process_problem("Wave 6 agent skeleton", sk_st, sk_out) in if sk_prob != "" then sk_prob else if nt_contains(fs_read_file(sk_out), "\"mode\":\"skeleton\"") == 0 then "Wave 6 agent skeleton missing mode" else let cg_spec = root + "/build/native-test/w6_cegis.src" in let cg_w = fs_write_sync(cg_spec, "@cegis affine_fee 2 9 5 21\n") in let cg_out = root + "/build/native-test/w6-cegis.out" in let cg_st = nt_driver(root, Cons("agent", Cons("cegis", Cons(cg_spec, Nil))), cg_out) in let cg_prob = nt_process_problem("Wave 6 agent cegis", cg_st, cg_out) in if cg_prob != "" then cg_prob else if nt_contains(fs_read_file(cg_out), "\"synthesized_expr\":\"4 * x + 1\"") == 0 or nt_contains(fs_read_file(cg_out), "\"proof_status\":\"proven\"") == 0 then "Wave 6 agent cegis unexpected output: " + fs_read_file(cg_out) else ""

fn nt_wave7_gates(root) = let suites = nt_test_suites(root, Cons("compiler/stage1/map.src", Cons("compiler/stage1/ltarget.src", Nil))) in if suites != "" then suites else let w7_src = root + "/build/native-test/w7_lang.src" in let w7_bin = root + "/build/native-test/w7_lang" in let w7_code = "law w7_inv(x: int) = x + 1 > x\nfn sum8(a, b, c, d, e, f, g, h) = a + b + c + d + e + f + g + h\nfn classify(xs) = let tag = match xs { Nil => 10 | Cons(x, _) => x + 20 } in tag * 2\nprint str(sum8(1, 2, 3, 4, 5, 6, 7, 8)) + \"|\" + str(classify(Cons(5, Nil)))\n" in let w7_w = fs_write_sync(w7_src, w7_code) in let w7_bout = root + "/build/native-test/w7-lang-build.out" in let w7_bst = nt_driver(root, Cons("build", Cons(w7_src, Cons("-o", Cons(w7_bin, Nil)))), w7_bout) in let w7_bprob = nt_process_problem("Wave 7 8-arg + braced match build", w7_bst, w7_bout) in if w7_bprob != "" then w7_bprob else let w7_rout = root + "/build/native-test/w7-lang-run.out" in let w7_rst = nt_run(w7_bin, Nil, w7_rout) in let w7_rprob = nt_process_problem("Wave 7 8-arg + braced match run", w7_rst, w7_rout) in if w7_rprob != "" then w7_rprob else if fs_read_file(w7_rout) != "36|50\n" then "Wave 7 lang unexpected output: " + fs_read_file(w7_rout) else let tr_out = root + "/build/native-test/w7-trace.out" in let tr_st = nt_driver(root, Cons("trace", Cons(w7_src, Nil)), tr_out) in let tr_prob = nt_process_problem("Wave 7 lume trace", tr_st, tr_out) in if tr_prob != "" then tr_prob else if nt_contains(fs_read_file(tr_out), "\"mode\":\"trace\"") == 0 then "Wave 7 lume trace missing mode" else let sv_old = root + "/build/native-test/w7_old.src" in let sv_new = root + "/build/native-test/w7_new.src" in let z1 = fs_write_sync(sv_old, "pub fn calc(x) = x + 1\n") in let z2 = fs_write_sync(sv_new, "pub fn calc(x) = x + 1\npub fn extra(y) = y * 2\n") in let sv_out = root + "/build/native-test/w7-semver.out" in let sv_st = nt_driver(root, Cons("diff-semver", Cons(sv_old, Cons(sv_new, Nil))), sv_out) in let sv_prob = nt_process_problem("Wave 7 lume diff-semver", sv_st, sv_out) in if sv_prob != "" then sv_prob else if nt_contains(fs_read_file(sv_out), "\"semver_bump\":\"minor\"") == 0 then "Wave 7 diff-semver expected minor bump:\n" + fs_read_file(sv_out) else let pf_out = root + "/build/native-test/w7-patchfn.out" in let pf_st = nt_driver(root, Cons("patch-fn", Cons(sv_old, Cons("calc", Cons("pub fn calc(x) = x + 10", Nil)))), pf_out) in let pf_prob = nt_process_problem("Wave 7 lume patch-fn", pf_st, pf_out) in if pf_prob != "" then pf_prob else if nt_contains(fs_read_file(pf_out), "\"status\":\"applied\"") == 0 then "Wave 7 patch-fn expected applied:\n" + fs_read_file(pf_out) else let lcaps = root + "/build/native-test/w7.lcaps" in let cs_out = root + "/build/native-test/w7-cap-seal.out" in let cs_st = nt_driver(root, Cons("capsule", Cons("seal", Cons(w7_src, Cons("-o", Cons(lcaps, Nil))))), cs_out) in let cs_prob = nt_process_problem("Wave 7 capsule seal v2", cs_st, cs_out) in if cs_prob != "" then cs_prob else let cr_out = root + "/build/native-test/w7-cap-replay.out" in let cr_st = nt_driver(root, Cons("capsule", Cons("replay", Cons(lcaps, Nil))), cr_out) in let cr_prob = nt_process_problem("Wave 7 capsule replay v2", cr_st, cr_out) in if cr_prob != "" then cr_prob else if nt_contains(fs_read_file(cr_out), "\"proof_verified\":true") == 0 then "Wave 7 capsule replay v2 missing proof_verified:\n" + fs_read_file(cr_out) else ""

fn nt_wave8_gates(root) = let gen_suite = nt_test_suites(root, Cons("compiler/stage1/lgenesis.src", Nil)) in if gen_suite != "" then gen_suite else let gen_out = root + "/build/native-test/w8-genesis.out" in let gen_st = nt_driver(root, Cons("genesis", Cons("omega_vault", Cons("autonomous-treasury", Nil))), gen_out) in let gen_prob = nt_process_problem("Wave 8 lume genesis", gen_st, gen_out) in if gen_prob != "" then gen_prob else if nt_contains(fs_read_file(gen_out), "\"targets_ready\":8") == 0 or nt_contains(fs_read_file(gen_out), "\"proof_status\":\"proven\"") == 0 then "Wave 8 lume genesis missing targets_ready/proof_status:\n" + fs_read_file(gen_out) else let heal_src = root + "/build/native-test/w8_broken.src" in let z1 = fs_write_sync(heal_src, "fn withdraw(x: int) -> int\n  ensures result >= 0\n  = x - 5\n") in let heal_out = root + "/build/native-test/w8-heal.out" in let heal_st = nt_driver(root, Cons("heal", Cons(heal_src, Nil)), heal_out) in let heal_prob = nt_process_problem("Wave 8 lume heal", heal_st, heal_out) in if heal_prob != "" then heal_prob else if nt_contains(fs_read_file(heal_out), "\"healed\":true") == 0 or nt_contains(fs_read_file(heal_out), "\"proof_status\":\"proven\"") == 0 then "Wave 8 lume heal did not heal/prove:\n" + fs_read_file(heal_out) else let eq_spec = root + "/build/native-test/w8_spec.src" in let eq_fast = root + "/build/native-test/w8_fast.src" in let z2 = fs_write_sync(eq_spec, "pub fn quad(x: int) -> int = x + x + x + x\n") in let z3 = fs_write_sync(eq_fast, "pub fn quad(x: int) -> int = x * 4\n") in let eq_out = root + "/build/native-test/w8-equiv.out" in let eq_st = nt_driver(root, Cons("equiv", Cons(eq_spec, Cons(eq_fast, Nil))), eq_out) in let eq_prob = nt_process_problem("Wave 8 lume equiv", eq_st, eq_out) in if eq_prob != "" then eq_prob else if nt_contains(fs_read_file(eq_out), "\"equivalent\":true") == 0 then "Wave 8 lume equiv expected equivalent:true:\n" + fs_read_file(eq_out) else let mp_src = root + "/build/native-test/w8_legacy.sql" in let z4 = fs_write_sync(mp_src, "CREATE TABLE ledger_entries (id BIGINT PRIMARY KEY, amount BIGINT NOT NULL);\n") in let mp_out = root + "/build/native-test/w8-morph.out" in let mp_st = nt_driver(root, Cons("morph", Cons(mp_src, Nil)), mp_out) in let mp_prob = nt_process_problem("Wave 8 lume morph", mp_st, mp_out) in if mp_prob != "" then mp_prob else if nt_contains(fs_read_file(mp_out), "\"source_lang\":\"sql\"") == 0 or nt_contains(fs_read_file(mp_out), "\"proof_status\":\"proven\"") == 0 then "Wave 8 lume morph unexpected output:\n" + fs_read_file(mp_out) else let nk_out = root + "/build/native-test/w8-neural.out" in let nk_st = nt_driver(root, Cons("neural-kernel", Cons(eq_fast, Nil)), nk_out) in let nk_prob = nt_process_problem("Wave 8 lume neural-kernel", nk_st, nk_out) in if nk_prob != "" then nk_prob else if nt_contains(fs_read_file(nk_out), "\"silicon_3way_equivalence\":true") == 0 then "Wave 8 lume neural-kernel missing silicon_3way_equivalence:\n" + fs_read_file(nk_out) else ""

fn nt_wave9_gates(root) = let sn_suite = nt_test_suites(root, Cons("compiler/stage1/lsentience.src", Nil)) in if sn_suite != "" then sn_suite else let w9_src = root + "/build/native-test/w9_sentient.src" in let z0 = fs_write_sync(w9_src, "law l_pos(x: int) = x + 1 > x\npub fn compute(x: int) -> int requires x >= 0 ensures result >= 0 = x + 0 + (x - x) * 1\n") in let awk_out = root + "/build/native-test/w9-awaken.out" in let awk_st = nt_driver(root, Cons("awaken", Cons(w9_src, Nil)), awk_out) in let awk_prob = nt_process_problem("Wave 9 lume awaken", awk_st, awk_out) in if awk_prob != "" then awk_prob else if nt_contains(fs_read_file(awk_out), "\"sentient_state\":\"awakened\"") == 0 or nt_contains(fs_read_file(awk_out), "\"conjecture_proven\":true") == 0 then "Wave 9 lume awaken unexpected output:\n" + fs_read_file(awk_out) else let con_out = root + "/build/native-test/w9-consult.out" in let con_st = nt_driver(root, Cons("consult", Cons(w9_src, Nil)), con_out) in let con_prob = nt_process_problem("Wave 9 lume consult", con_st, con_out) in if con_prob != "" then con_prob else if nt_contains(fs_read_file(con_out), "\"sentient_state\":\"alive\"") == 0 then "Wave 9 lume consult unexpected output:\n" + fs_read_file(con_out) else let ma_out = root + "/build/native-test/w9-morph-ast.out" in let ma_st = nt_driver(root, Cons("morph-ast", Cons(w9_src, Nil)), ma_out) in let ma_prob = nt_process_problem("Wave 9 lume morph-ast", ma_st, ma_out) in if ma_prob != "" then ma_prob else if nt_contains(fs_read_file(ma_out), "\"egraph_fixed_point\":true") == 0 then "Wave 9 lume morph-ast unexpected output:\n" + fs_read_file(ma_out) else let qt_out = root + "/build/native-test/w9-quantum.out" in let qt_st = nt_driver(root, Cons("quantum", Cons(w9_src, Nil)), qt_out) in let qt_prob = nt_process_problem("Wave 9 lume quantum", qt_st, qt_out) in if qt_prob != "" then qt_prob else if nt_contains(fs_read_file(qt_out), "\"bell_entanglement_fidelity_pct\":100") == 0 then "Wave 9 lume quantum unexpected output:\n" + fs_read_file(qt_out) else let dna_out = root + "/build/native-test/w9-dna.out" in let dna_st = nt_driver(root, Cons("bio-dna", Cons(w9_src, Nil)), dna_out) in let dna_prob = nt_process_problem("Wave 9 lume bio-dna", dna_st, dna_out) in if dna_prob != "" then dna_prob else if nt_contains(fs_read_file(dna_out), "\"homopolymer_free\":true") == 0 or nt_contains(fs_read_file(dna_out), "\"lossless_roundtrip\":true") == 0 then "Wave 9 lume bio-dna unexpected output:\n" + fs_read_file(dna_out) else let tmr_out = root + "/build/native-test/w9-tmr.out" in let tmr_st = nt_driver(root, Cons("cosmic-tmr", Cons(w9_src, Nil)), tmr_out) in let tmr_prob = nt_process_problem("Wave 9 lume cosmic-tmr", tmr_st, tmr_out) in if tmr_prob != "" then tmr_prob else if nt_contains(fs_read_file(tmr_out), "\"seu_single_event_upset_masked\":true") == 0 then "Wave 9 lume cosmic-tmr unexpected output:\n" + fs_read_file(tmr_out) else let hol_out = root + "/build/native-test/w9-hologram.out" in let hol_st = nt_driver(root, Cons("hologram", Cons(w9_src, Nil)), hol_out) in let hol_prob = nt_process_problem("Wave 9 lume hologram", hol_st, hol_out) in if hol_prob != "" then hol_prob else if nt_contains(fs_read_file(hol_out), "\"holographic_recall_verified\":true") == 0 then "Wave 9 lume hologram unexpected output:\n" + fs_read_file(hol_out) else let chr_out = root + "/build/native-test/w9-chronos.out" in let chr_st = nt_driver(root, Cons("chronos", Cons(w9_src, Nil)), chr_out) in let chr_prob = nt_process_problem("Wave 9 lume chronos", chr_st, chr_out) in if chr_prob != "" then chr_prob else if nt_contains(fs_read_file(chr_out), "\"reversible_dagger_verified\":true") == 0 then "Wave 9 lume chronos unexpected output:\n" + fs_read_file(chr_out) else let on_out = root + "/build/native-test/w9-omeganet.out" in let on_st = nt_driver(root, Cons("omega-net", Cons(w9_src, Nil)), on_out) in let on_prob = nt_process_problem("Wave 9 lume omega-net", on_st, on_out) in if on_prob != "" then on_prob else if nt_contains(fs_read_file(on_out), "\"effective_depth\":\"infinite\"") == 0 or nt_contains(fs_read_file(on_out), "\"banach_lipschitz_contractive\":true") == 0 then "Wave 9 lume omega-net unexpected output:\n" + fs_read_file(on_out) else let llm_out = root + "/build/native-test/w9-llmforge.out" in let llm_st = nt_driver(root, Cons("llm-forge", Cons(w9_src, Nil)), llm_out) in let llm_prob = nt_process_problem("Wave 9 lume llm-forge", llm_st, llm_out) in if llm_prob != "" then llm_prob else if nt_contains(fs_read_file(llm_out), "\"loss_converged\":true") == 0 or nt_contains(fs_read_file(llm_out), "\"constitutional_qflia_verified\":true") == 0 then "Wave 9 lume llm-forge unexpected output:\n" + fs_read_file(llm_out) else let hv_out = root + "/build/native-test/w9-hive.out" in let hv_st = nt_driver(root, Cons("hive", Cons(w9_src, Nil)), hv_out) in let hv_prob = nt_process_problem("Wave 9 lume hive", hv_st, hv_out) in if hv_prob != "" then hv_prob else if nt_contains(fs_read_file(hv_out), "\"superlinear_intelligence_synergy\":true") == 0 or nt_contains(fs_read_file(hv_out), "\"byzantine_poison_attempts_rejected\":1") == 0 then "Wave 9 lume hive unexpected output:\n" + fs_read_file(hv_out) else let ea_out = root + "/build/native-test/w9-evolve-all.out" in let ea_st = nt_driver(root, Cons("evolve-all", Cons(w9_src, Nil)), ea_out) in let ea_prob = nt_process_problem("Wave 9 lume evolve-all", ea_st, ea_out) in if ea_prob != "" then ea_prob else if nt_contains(fs_read_file(ea_out), "\"zero_entropy\":true") == 0 or nt_contains(fs_read_file(ea_out), "\"targets_sharded\":27") == 0 then "Wave 9 lume evolve-all unexpected output:\n" + fs_read_file(ea_out) else ""

fn nt_lasm_strict(root) = let asm = root + "/build/native-test/w1_undefined_symbol.s" in let written = fs_write_sync(asm, "    .section .text\n_start:\n    call missing_fn\n    ret\n") in if written != 1 then "lasm strict fixture could not be written" else let strict_out = root + "/build/native-test/w1_lasm_strict.elf" in let strict_status = nt_run(root + "/build/bin/lasm", Cons("--strict", Cons(asm, Nil)), strict_out) in if strict_status == 0 then "lasm --strict accepted an undefined call target (expected [L0001])" else let err = fs_read_file(strict_out + ".err") in if nt_contains(err, "missing_fn") == 0 or nt_contains(err, "L0001") == 0 then "lasm --strict error must name the symbol with [L0001], got:\n" + err else let lenient_out = root + "/build/native-test/w1_lasm_lenient.elf" in let lenient_status = nt_run(root + "/build/bin/lasm", Cons(asm, Nil), lenient_out) in if lenient_status != 0 then "lasm default (compat) mode rejected the undefined-call fixture; byte-compat with the old address-0 resolution must be preserved" else if fs_files_equal(strict_out, lenient_out) == 1 then "lasm --strict still emitted an ELF for the undefined-call fixture" else ""

## --- Wave 14: front end vs specification (docs/03-specification.md section 19), runtime leftovers, clause definedness ---
## Every case goes through the real pipeline (lume_driver build -> lumec -> lasm -> run). A positive case pins the
## output; a negative case pins the diagnostic code that the real analysis prints; a trap case pins the run-time message.
fn w14_first(xs) = match xs
    Nil        => ""
    Cons(h, t) => if h != "" then h else w14_first(t)
fn w14_build(root, name, src, flags) = let source = root + "/build/native-test/" + name + ".src" in let w = fs_write_sync(source, src) in let out = root + "/build/native-test/" + name + ".build" in let st = nt_driver(root, lk14_app(Cons("build", flags), Cons(source, Cons("-o", Cons(root + "/build/native-test/" + name + ".bin", Nil)))), out) in {st: st, err: fs_read_file(out + ".err") + fs_read_file(out), bin: root + "/build/native-test/" + name + ".bin"}
fn lk14_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, lk14_app(t, ys))
fn w14_exec(root, name, b) = let out = root + "/build/native-test/" + name + ".run" in let st = nt_run(b.bin, Nil, out) in {st: st, out: fs_read_file(out), err: fs_read_file(out + ".err")}
fn w14_pos_f(root, name, src, flags, want) = let b = w14_build(root, name, src, flags) in if b.st != 0 then name + ": the build failed:\n" + b.err else let r = w14_exec(root, name, b) in if r.st != 0 then name + ": the program stopped (status " + str(r.st) + "): " + r.err else if r.out != want then name + ": printed\n" + r.out + "expected\n" + want else ""
fn w14_pos(root, name, src, want) = w14_pos_f(root, name, src, Nil, want)
fn w14_trap_f(root, name, src, flags, want_out, want_err) = let b = w14_build(root, name, src, flags) in if b.st != 0 then name + ": the build failed:\n" + b.err else let r = w14_exec(root, name, b) in if r.st == 0 then name + ": the program ran to the end and printed\n" + r.out + "(expected it to stop with: " + want_err + ")" else if nt_contains(r.err, want_err) == 0 then name + ": stopped without '" + want_err + "': " + r.err else if r.out != want_out then name + ": printed\n" + r.out + "before stopping, expected\n" + want_out else ""
fn w14_trap(root, name, src, want_out, want_err) = w14_trap_f(root, name, src, Nil, want_out, want_err)
fn w14_neg(root, name, src, expect) = nt_soundness_negative(root, name, src, expect)
fn w14_neg2(root, name, src, e1, e2) = let a = nt_soundness_negative(root, name, src, e1) in if a != "" then a else nt_soundness_negative(root, name + "_b", src, e2)
## the fixtures of tests/conformance/stage1/fail_closed that this wave added: `<CODE>_<name>.src` is rejected with [CODE]
fn w14_fixture(root, file, code) = let b = nt_driver(root, Cons("build", Cons(root + "/tests/conformance/stage1/fail_closed/" + file, Cons("-o", Cons(root + "/build/native-test/w14_fx.bin", Nil)))), root + "/build/native-test/w14_fx.out") in let err = fs_read_file(root + "/build/native-test/w14_fx.out.err") in if b == 0 then file + ": accepted (expected [" + code + "])" else if nt_contains(err, "[" + code + "]") == 0 then file + ": rejected without [" + code + "]: " + err else ""
fn w14_fixtures(root) = w14_first(Cons(w14_fixture(root, "P0003_two_statements.src", "P0003"), Cons(w14_fixture(root, "P0003_two_functions.src", "P0003"), Cons(w14_fixture(root, "L0004_unterminated_block_comment.src", "L0004"), Cons(w14_fixture(root, "L0003_uppercase_radix_prefix.src", "L0003"), Cons(w14_fixture(root, "L0003_trailing_underscore.src", "L0003"), Cons(w14_fixture(root, "L0003_radix_underscore.src", "L0003"), Cons(w14_fixture(root, "L0003_digit_glued_to_name.src", "L0003"), Cons(w14_fixture(root, "P0004_unknown_attribute.src", "P0004"), Cons(w14_fixture(root, "P0004_misspelt_no_alloc.src", "P0004"), Cons(w14_fixture(root, "P0004_attribute_dropped.src", "P0004"), Cons(w14_fixture(root, "T0601_int_condition.src", "T0601"), Cons(w14_fixture(root, "T0602_bool_returned_as_int.src", "T0602"), Cons(w14_fixture(root, "T0603_bool_argument_for_int.src", "T0603"), Cons(w14_fixture(root, "T0604_decimal_plus_int.src", "T0604"), Cons(w14_fixture(root, "T0605_let_annotation.src", "T0605"), Cons(w14_fixture(root, "T0606_branch_types.src", "T0606"), Cons(w14_fixture(root, "T0607_int_clause.src", "T0607"), Cons(w14_fixture(root, "C0012_shift_count_literal.src", "C0012"), Nil)))))))))))))))))))
fn w14_not_precedence(root) = w14_pos(root, "w14_not_precedence", "fn lt(a, b) = if not a < b then 1 else 0\nfn both(a, b, c) = if not a == b and c == 1 then 1 else 0\nfn dbl(a, b) = if not not a < b then 1 else 0\nfn opnd(a, b) = if a == not b then 1 else 0\nprint str(lt(1, 2)) + str(lt(2, 1)) + str(both(1, 2, 1)) + str(both(1, 1, 1)) + str(both(1, 2, 0)) + str(dbl(1, 2)) + str(dbl(2, 1)) + str(opnd(0, 5)) + str(opnd(1, 5))\nprint not 0 < 2\n", "011001010\n0\n")
fn w14_statement_rule(root) = w14_first(Cons(w14_pos(root, "w14_stmt_cont", "fn f(a, b) = a\n    + b\nfn g(a, b) = a\n    - b\n    * 2\nfn h(a,\n     b) = a *\n    b\nprint f(1, 2)\nprint g(10, 3)\nprint h(4, 5)\n", "3\n4\n20\n"), Cons(w14_neg2(root, "w14_stmt_two", "print 1 2\n", "P0003", "line 1, col 9"), Cons(w14_neg(root, "w14_stmt_two_fns", "fn f() = 1 fn g() = 2\nprint f() + g()\n", "P0003"), Cons(w14_neg(root, "w14_stmt_expr_after_fn", "fn f(x) = x + 1 f(2)\n", "P0003"), Cons(w14_neg(root, "w14_stmt_stray_paren", "fn f(x) = x + 1\nprint f(2))\n", "P0002"), Nil))))))
fn w14_block_comment(root) = w14_first(Cons(w14_pos(root, "w14_block_ok", "#[ a block comment\n   over two lines ]#\nfn f(x) = x #[ inline ]# + 1\n#[ outer #[ nested ]# still outer\nfn hidden() = 99\n]#\n## a line comment with #[ in it stays a line comment\nprint f(41) #[ trailing ]#\n", "42\n"), Cons(w14_neg2(root, "w14_block_open", "fn f() = 1\n#[ never closed\nprint f()\n", "L0004", "line 2, col 1"), Cons(w14_neg(root, "w14_block_hides_fn", "#[\nfn hidden() = 99\n]#\nprint hidden()\n", "hidden"), Nil))))
fn w14_int_literals(root) = w14_first(Cons(w14_pos(root, "w14_lit_ok", "print 0x1F + 0b11 + 0o17 + 1_000 + 0xF_F\n", "1304\n"), Cons(w14_neg(root, "w14_lit_upper_x", "print 0X1F\n", "L0003"), Cons(w14_neg(root, "w14_lit_upper_b", "print 0B11\n", "L0003"), Cons(w14_neg(root, "w14_lit_upper_o", "print 0O17\n", "L0003"), Cons(w14_neg(root, "w14_lit_trail", "print 1_\n", "L0003"), Cons(w14_neg(root, "w14_lit_double", "print 1__0\n", "L0003"), Cons(w14_neg(root, "w14_lit_hex_lead", "print 0x_F\n", "L0003"), Cons(w14_neg(root, "w14_lit_hex_trail", "print 0xF_\n", "L0003"), Cons(w14_neg(root, "w14_lit_hex_double", "print 0x1__F\n", "L0003"), Cons(w14_neg(root, "w14_lit_glued", "fn f(a, b) = 2a + b\nprint f(1, 2)\n", "L0003"), Cons(w14_neg(root, "w14_lit_bad_hex_digit", "print 0x1G\n", "L0003"), Nil))))))))))))
## the last case is the control: the same conditions and returns in functions that are NOT fully annotated compile
