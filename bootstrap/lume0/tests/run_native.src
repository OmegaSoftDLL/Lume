fn nt_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else nt_line_end(text, i + 1)

fn nt_root(input) = if count(input) < 6 or slice(input, 0, 6) != "@root " then "" else slice(input, 6, nt_line_end(input, 0))

fn nt_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else nt_contains_at(text, part, i + 1)

fn nt_contains(text, part) = nt_contains_at(text, part, 0)

fn nt_run(path, args, out) = os_run_capture_timeout(path, args, out, out + ".err", 120000)

fn nt_seed(root, args, out) = nt_run(root + "/bootstrap/lume0/lume0", args, out)

fn nt_driver(root, args, out) = nt_run(root + "/build/bin/lume_driver", args, out)

fn nt_process_problem(label, status, out) = if status == 0 then "" else label + " failed with native status " + str(status) + "\nstdout:\n" + fs_read_file(out) + "\nstderr:\n" + fs_read_file(out + ".err") + "\n"

fn nt_output_problem(label, status, out, expected) = let process = nt_process_problem(label, status, out) in if process != "" then process else if fs_files_equal(out, expected) != 1 then label + " output differs from " + expected + "\nactual:\n" + fs_read_file(out) + "\nexpected:\n" + fs_read_file(expected) else ""

fn nt_check_case(root, name) = let source = root + "/examples/" + name + ".lume" in let out = root + "/build/native-test/check-" + name + ".out" in let checked = nt_seed(root, Cons("check", Cons(source, Nil)), out) in let problem = nt_process_problem("seed check " + name, checked, out) in if problem != "" then problem else let parsed = nt_seed(root, Cons("parse", Cons(source, Nil)), root + "/build/native-test/parse-" + name + ".out") in nt_process_problem("seed parse " + name, parsed, root + "/build/native-test/parse-" + name + ".out")

fn nt_check_cases(root, names) = match names
    Nil        => ""
    Cons(h, t) => let problem = nt_check_case(root, h) in if problem != "" then problem else nt_check_cases(root, t)

fn nt_stage0_case(root, name) = let source = root + "/examples/" + name + ".lume" in let expected = root + "/tests/conformance/stage0/" + name + ".expected" in let out = root + "/build/native-test/run-" + name + ".out" in let status = nt_seed(root, Cons("run", Cons(source, Nil)), out) in let problem = nt_output_problem("seed run " + name, status, out, expected) in if problem != "" then problem else let encoded = root + "/build/native-test/" + name + ".lbe" in let emitted = nt_seed(root, Cons("emit", Cons(source, Cons(encoded, Nil))), root + "/build/native-test/emit-" + name + ".out") in let emit_problem = nt_process_problem("seed LBE emit " + name, emitted, root + "/build/native-test/emit-" + name + ".out") in if emit_problem != "" then emit_problem else let lbe_out = root + "/build/native-test/lbe-" + name + ".out" in let executed = nt_seed(root, Cons("run", Cons(encoded, Nil)), lbe_out) in nt_output_problem("seed LBE run " + name, executed, lbe_out, expected)

fn nt_stage0_cases(root, names) = match names
    Nil        => ""
    Cons(h, t) => let problem = nt_stage0_case(root, h) in if problem != "" then problem else nt_stage0_cases(root, t)

fn nt_token_case(root, name) = let source = root + "/bootstrap/lume0/tests/lexer/" + name + ".lume" in let expected = root + "/bootstrap/lume0/tests/lexer/" + name + ".tokens" in let out = root + "/build/native-test/tokens-" + name + ".out" in let status = nt_seed(root, Cons("tokens", Cons(source, Nil)), out) in nt_output_problem("seed tokens " + name, status, out, expected)

fn nt_token_cases(root, names) = match names
    Nil        => ""
    Cons(h, t) => let problem = nt_token_case(root, h) in if problem != "" then problem else nt_token_cases(root, t)

fn nt_negative_seed(root, relative, code) = let source = root + "/bootstrap/lume0/tests/" + relative in let out = root + "/build/native-test/negative-" + code + ".out" in let status = nt_seed(root, Cons("check", Cons(source, Cons("--json", Nil))), out) in if status == 0 then "seed accepted negative fixture " + relative else if nt_contains(fs_read_file(out), "\"code\":\"" + code + "\"") == 0 then "seed emitted the wrong diagnostic for " + relative + "\n" + fs_read_file(out) + fs_read_file(out + ".err") else ""

fn nt_negative_seeds(root) = let lexer = nt_negative_seed(root, "lexer/bad_escape.lume", "L0021") in if lexer != "" then lexer else let parser = nt_negative_seed(root, "parser/bad_fn.lume", "P0040") in if parser != "" then parser else nt_negative_seed(root, "resolve/bad_undefined_var.lume", "R0200")

fn nt_native_build(root) = let binary = root + "/build/native-test/nfib" in let out = root + "/build/native-test/native-build.out" in let status = nt_driver(root, Cons("build", Cons(root + "/compiler/stage1/nfib.src", Cons("-o", Cons(binary, Nil)))), out) in let problem = nt_process_problem("native driver build nfib", status, out) in if problem != "" then problem else let run_out = root + "/build/native-test/native-nfib.out" in let executed = nt_run(binary, Nil, run_out) in nt_output_problem("native nfib execution", executed, run_out, root + "/tests/conformance/stage1/nfib_asm.expected")

fn nt_native_tests(root) = let out = root + "/build/native-test/native-ltest.out" in let status = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/sample_test.src", Nil)), out) in nt_output_problem("native driver test discovery", status, out, root + "/tests/conformance/stage1/ltest_pass_asm.expected")

fn nt_negative_native(root) = let source = root + "/build/native-test/failing_test.src" in let written = fs_write_sync(source, "fn test_ok() = 2 + 2 == 4\nfn test_broken() = 2 + 2 == 5\n") in if written != 1 then "native negative test fixture could not be written" else let out = root + "/build/native-test/native-ltest-fail.out" in let status = nt_driver(root, Cons("test", Cons(source, Nil)), out) in if status == 0 then "native driver accepted a failing Lume test" else let output = fs_read_file(out) in if nt_contains(output, "FAIL test_broken") == 0 or nt_contains(output, "1 passed, 1 failed") == 0 then "native driver failure output is incomplete\n" + output + fs_read_file(out + ".err") else ""

## --- Wave 1 toolchain soundness (#428): negative gates that FAIL if the bug returns. Each writes
## a bad source, runs the native toolchain's lumec/lasm pipeline on it, and requires a non-zero
## exit PLUS the specific diagnostic; accepting the source (or failing without the diagnostic) is
## a regression to the silent wrong-code incidents of #417 (undefined call), #423 (unbound
## interpolation variable), and the #417 merge (duplicated `else else`).
fn nt_soundness_negative(root, name, source_text, expect) = let source = root + "/build/native-test/" + name + ".src" in let written = fs_write_sync(source, source_text) in if written != 1 then name + " fixture could not be written" else let out = root + "/build/native-test/" + name + ".out" in let status = nt_driver(root, Cons("build", Cons(source, Cons("-o", Cons(root + "/build/native-test/" + name + ".bin", Nil)))), out) in if status == 0 then name + ": native toolchain accepted bad source (expected a compile error)" else let output = fs_read_file(out + ".err") in if nt_contains(output, expect) == 0 then name + ": expected '" + expect + "' in stderr, got:\n" + output else ""

fn nt_negative_soundness(root) = let undef_call = nt_soundness_negative(root, "w1_undefined_call", "fn helper() = 1\nprint helper() + missing_callee(2)\n", "missing_callee") in if undef_call != "" then undef_call else let undef_var = nt_soundness_negative(root, "w1_unbound_interpolation", "fn row() = \"effect row / {{ffi}} done\"\nprint row()\n", "ffi") in if undef_var != "" then undef_var else let else_else = nt_soundness_negative(root, "w1_else_else", "fn main() = if 1 == 1 then 1 else else 2\nprint main()\n", "P0002") in if else_else != "" then else_else else let then_then = nt_soundness_negative(root, "w1_then_then", "fn main() = if 1 == 1 then then 2 else 3\nprint main()\n", "P0002") in if then_then != "" then then_then else let arena_pure = nt_soundness_negative(root, "w2_arena_in_pure", "pub fn leak() / pure = __lume_arena_new(1024)\nprint 0\n", "E0200") in if arena_pure != "" then arena_pure else ""

fn nt_wave2_gates(root) = let cap_out = root + "/build/native-test/w2-capsule.out" in let cap_st = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/capsule_ok.src", Nil)), cap_out) in let cap_prob = nt_process_problem("Wave 2 capsule_ok", cap_st, cap_out) in if cap_prob != "" then cap_prob else let ar_out = root + "/build/native-test/w2-arena.out" in let ar_st = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/arena_ok.src", Nil)), ar_out) in let ar_prob = nt_process_problem("Wave 2 arena_ok", ar_st, ar_out) in if ar_prob != "" then ar_prob else let by_out = root + "/build/native-test/w2-bytes.out" in let by_st = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/bytes_ok.src", Nil)), by_out) in let by_prob = nt_process_problem("Wave 2 bytes_ok", by_st, by_out) in if by_prob != "" then by_prob else let w2_src = root + "/build/native-test/w2_runtime_probe.src" in let w2_bin = root + "/build/native-test/w2_runtime_probe" in let w2_code = "fn tco_sum(n, acc) = if n <= 0 then acc else tco_sum(n - 1, acc + 1)\nfn box_loop(i, acc) = if i <= 0 then acc else box_loop(i - 1, (i % 500))\nfn main_ok() = let s1 = __lume_heap_stats() in let b = box_loop(500, 0) in let s2 = __lume_heap_stats() in let t = tco_sum(100000, 0) in let rss = os_self_maxrss_kb() in let env_out = \"" + root + "/build/native-test/w2_env.out\" in let env_err = \"" + root + "/build/native-test/w2_env.err\" in let rc = os_run_capture_timeout(\"/usr/bin/env\", Nil, env_out, env_err, 10000) in let crss = os_last_child_maxrss_kb() in if s2.used - s1.used <= 128 and t == 100000 and rss > 0 and rc == 0 and crss >= 0 and count(fs_read_file(env_out)) > 0 then 1 else 0\nprint main_ok()\n" in let w2_w = fs_write_sync(w2_src, w2_code) in let w2_b_out = root + "/build/native-test/w2-build.out" in let w2_bst = nt_driver(root, Cons("build", Cons("--memory", Cons(w2_src, Cons("-o", Cons(w2_bin, Nil))))), w2_b_out) in let w2_bprob = nt_process_problem("Wave 2 runtime probe build", w2_bst, w2_b_out) in if w2_bprob != "" then w2_bprob else if nt_contains(fs_read_file(w2_b_out + ".err"), "[memory:build]") == 0 then "Wave 2 build --memory did not emit [memory:build] telemetry" else let w2_r_out = root + "/build/native-test/w2-run.out" in let w2_rst = nt_run(w2_bin, Nil, w2_r_out) in let w2_rprob = nt_process_problem("Wave 2 runtime probe run", w2_rst, w2_r_out) in if w2_rprob != "" then w2_rprob else if fs_read_file(w2_r_out) != "1\n" then "Wave 2 runtime probe returned unexpected output: " + fs_read_file(w2_r_out) else ""

fn nt_wave3_gates(root) = let llm_out = root + "/build/native-test/w3-llm-eval.out" in let llm_st = nt_driver(root, Cons("test", Cons(root + "/scripts/llm_gen_eval.src", Nil)), llm_out) in let llm_prob = nt_process_problem("Wave 3 llm_gen_eval", llm_st, llm_out) in if llm_prob != "" then llm_prob else let lsym = root + "/build/native-test/w3_sample.lsym" in let lsym_w = fs_write_sync(lsym, "{\"lsym_version\":1,\"symbols\":{\"F1\":{\"name\":\"compute_license\",\"line\":3,\"addr\":\"0x401000\"}},\"trap_table\":{\"E#1\":\"[V0001] contract violation\"}}\n") in let sym_out = root + "/build/native-test/w3-symbolize.out" in let sym_st = nt_driver(root, Cons("symbolize", Cons(lsym, Cons("0x401008", Nil))), sym_out) in let sym_prob = nt_process_problem("Wave 3 lume symbolize", sym_st, sym_out) in if sym_prob != "" then sym_prob else if nt_contains(fs_read_file(sym_out), "\"ok\":true") == 0 or nt_contains(fs_read_file(sym_out), "\"name\":\"compute_license\"") == 0 then "Wave 3 lume symbolize output missing resolved function name:\n" + fs_read_file(sym_out) else ""

fn nt_wave4_gates(root) = let p35_out = root + "/build/native-test/w4-p35.out" in let p35_st = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/p35_ok.src", Nil)), p35_out) in let p35_prob = nt_process_problem("Wave 4 p35_ok", p35_st, p35_out) in if p35_prob != "" then p35_prob else let lpr_out = root + "/build/native-test/w4-lprotect.out" in let lpr_st = nt_driver(root, Cons("test", Cons(root + "/compiler/stage1/lprotect.src", Nil)), lpr_out) in let lpr_prob = nt_process_problem("Wave 4 lprotect", lpr_st, lpr_out) in if lpr_prob != "" then lpr_prob else let zc_out = root + "/build/native-test/w4-zeroc.out" in let zc_st = nt_driver(root, Cons("test", Cons(root + "/scripts/zero_c.src", Nil)), zc_out) in let zc_prob = nt_process_problem("Wave 4 zero_c", zc_st, zc_out) in if zc_prob != "" then zc_prob else let emb_asset = root + "/build/native-test/w4_asset.txt" in let emb_w = fs_write_sync(emb_asset, "LUME_W4_ASSET_OK") in let emb_neg = nt_soundness_negative(root, "w4_embed_no_cap", "fn bad() = comptime embed(\"" + emb_asset + "\")\nprint bad()\n", "E0200") in if emb_neg != "" then emb_neg else let sch_neg = nt_soundness_negative(root, "w4_schema_undeclared", "fn bad() = comptime table_schema(MissingRow)\nprint bad()\n", "D0273") in if sch_neg != "" then sch_neg else let w4_src = root + "/build/native-test/w4_comptime_ok.src" in let w4_bin = root + "/build/native-test/w4_comptime_ok" in let w4_code = "@capability fs\ntype InvoiceRow = record id: int, amount: int\nfn get_asset() = comptime embed(\"" + emb_asset + "\")\nfn get_schema() = comptime table_schema(InvoiceRow)\nprint get_asset() + \"|\" + get_schema()\n" in let w4_w = fs_write_sync(w4_src, w4_code) in let w4_bout = root + "/build/native-test/w4-build.out" in let w4_bst = nt_driver(root, Cons("build", Cons(w4_src, Cons("-o", Cons(w4_bin, Nil)))), w4_bout) in let w4_bprob = nt_process_problem("Wave 4 comptime embed/table_schema build", w4_bst, w4_bout) in if w4_bprob != "" then w4_bprob else let w4_rout = root + "/build/native-test/w4-run.out" in let w4_rst = nt_run(w4_bin, Nil, w4_rout) in let w4_rprob = nt_process_problem("Wave 4 comptime embed/table_schema run", w4_rst, w4_rout) in if w4_rprob != "" then w4_rprob else if fs_read_file(w4_rout) != "LUME_W4_ASSET_OK|InvoiceRow(id:int,amount:int)\n" then "Wave 4 unexpected comptime output: " + fs_read_file(w4_rout) else ""

fn nt_lasm_strict(root) = let asm = root + "/build/native-test/w1_undefined_symbol.s" in let written = fs_write_sync(asm, "    .section .text\n_start:\n    call missing_fn\n    ret\n") in if written != 1 then "lasm strict fixture could not be written" else let strict_out = root + "/build/native-test/w1_lasm_strict.elf" in let strict_status = nt_run(root + "/build/bin/lasm", Cons("--strict", Cons(asm, Nil)), strict_out) in if strict_status == 0 then "lasm --strict accepted an undefined call target (expected [L0001])" else let err = fs_read_file(strict_out + ".err") in if nt_contains(err, "missing_fn") == 0 or nt_contains(err, "L0001") == 0 then "lasm --strict error must name the symbol with [L0001], got:\n" + err else let lenient_out = root + "/build/native-test/w1_lasm_lenient.elf" in let lenient_status = nt_run(root + "/build/bin/lasm", Cons(asm, Nil), lenient_out) in if lenient_status != 0 then "lasm default (compat) mode rejected the undefined-call fixture; byte-compat with the old address-0 resolution must be preserved" else if fs_files_equal(strict_out, lenient_out) == 1 then "lasm --strict still emitted an ELF for the undefined-call fixture" else ""

fn nt_main(root) = let made = fs_mkdir(root + "/build/native-test") in if made != 1 then "cannot create native test artifact directory" else let checked = nt_check_cases(root, Cons("01_hello", Cons("02_basics", Cons("03_records_enums", Cons("04_errors_optionals", Cons("05_collections_closures", Cons("06_traits_generics", Cons("07_contracts_defer", Cons("08_shell_script", Cons("09_stdlib", Nil)))))))))) in if checked != "" then checked else let tokens = nt_token_cases(root, Cons("literals", Cons("indent", Nil))) in if tokens != "" then tokens else let stage0 = nt_stage0_cases(root, Cons("01_hello", Cons("02_basics", Cons("03_records_enums", Cons("04_errors_optionals", Cons("05_collections_closures", Cons("06_traits_generics", Cons("07_contracts_defer", Cons("09_stdlib", Nil))))))))) in if stage0 != "" then stage0 else let negative = nt_negative_seeds(root) in if negative != "" then negative else let built = nt_native_build(root) in if built != "" then built else let tested = nt_native_tests(root) in if tested != "" then tested else let ltestfail = nt_negative_native(root) in if ltestfail != "" then ltestfail else let soundness = nt_negative_soundness(root) in if soundness != "" then soundness else let wave2 = nt_wave2_gates(root) in if wave2 != "" then wave2 else let wave3 = nt_wave3_gates(root) in if wave3 != "" then wave3 else let wave4 = nt_wave4_gates(root) in if wave4 != "" then wave4 else nt_lasm_strict(root)

fn nt_dispatch(input) = let root = nt_root(input) in if root == "" then ctfail("native test runner requires @root\n") else let problem = nt_main(root) in if problem != "" then ctfail("native test runner failed: " + problem + "\n") else "PASS: bounded native Lume test gate (seed checks, Stage 0, LBE, native build, test discovery, and toolchain-soundness negatives)"

print nt_dispatch(readall())
