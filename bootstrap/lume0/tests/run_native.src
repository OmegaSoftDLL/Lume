fn w14_pure_ctfail_total_mutual(root) = w14_first(Cons(w14_pos(root, "w14_pure_ctfail", "fn f(x: int) -> int / pure = if x < 0 then ctfail(\"neg\\n\") else x\nprint f(3)\n", "3\n"), Cons(w14_trap(root, "w14_pure_ctfail_stops", "fn f(x: int) -> int / pure = if x < 0 then ctfail(\"w14 neg\\n\") else x\nprint f(0 - 3)\n", "", "w14 neg"), Cons(w14_neg2(root, "w14_total_mutual", "total fn ev(n: int) -> int requires n >= 0 = if n == 0 then 1 else od(n - 1)\ntotal fn od(n: int) -> int requires n >= 0 = if n == 0 then 0 else ev(n - 1)\nprint ev(4)\n", "A0002", "mutual recursion"), Cons(w14_pos(root, "w14_total_direct", "total fn dn(n: int) -> int requires n >= 0 terminates (n) = if n == 0 then 0 else dn(n - 1)\nprint dn(4)\n", "0\n"), Nil)))))
fn w14_shift_src(last) = "fn sl(a, k) = bit_shl(a, k)\nfn sr(a, k) = bit_shr(a, k)\nfn vl(a, k) = bv_shl(a, k)\nfn vr(a, k) = bv_shr(a, k)\nprint str(sl(1, 63)) + \" \" + str(sl(1, 0)) + \" \" + str(sr(0 - 8, 1)) + \" \" + str(sr(0 - 8, 63)) + \" \" + str(sr(8, 63)) + \" \" + str(bit_shl(3, 62)) + \" \" + str(vl(1, 4)) + \" \" + str(vr(0 - 16, 2)) + \" \" + str(bit_shr(0 - 8, 1))\n" + last
fn w14_shift_out() = "-9223372036854775808 1 -4 -1 0 -4611686018427387904 16 -4 -4\n"
fn w14_shift_range(root) = w14_first(Cons(w14_pos(root, "w14_shift_ok", w14_shift_src("print sl(5, 62)\n"), w14_shift_out() + "4611686018427387904\n"), Cons(w14_trap(root, "w14_shift_64", w14_shift_src("print sl(1, 64)\n"), w14_shift_out(), "lume: shift count outside 0..63"), Cons(w14_trap(root, "w14_shift_neg", w14_shift_src("print sr(8, 0 - 1)\n"), w14_shift_out(), "lume: shift count outside 0..63"), Cons(w14_trap(root, "w14_shift_bv_65", w14_shift_src("print vr(8, 65)\n"), w14_shift_out(), "lume: shift count outside 0..63"), Cons(w14_trap(root, "w14_shift_bv_neg", w14_shift_src("print vl(8, 0 - 64)\n"), w14_shift_out(), "lume: shift count outside 0..63"), Cons(w14_neg2(root, "w14_shift_lit_64", "print bit_shl(1, 64)\n", "C0012", "outside 0..63"), Cons(w14_neg(root, "w14_shift_lit_shr_64", "fn f(a) = bit_shr(a, 64)\nprint f(1)\n", "C0012"), Cons(w14_shift_asm(root), Nil)))))))))
## The standalone routines `bit_shl:` / `bit_shr:` are never called by generated code; what they would do is pinned on
## the emitted text: the guard in both, and an arithmetic `sarq` (no `shrq`) in bit_shr.
fn w14_cut(s, from, upto) = let a = w14_find(s, from, 0) in if a < 0 then "" else let b = w14_find(s, upto, a) in if b < 0 then slice(s, a, count(s)) else slice(s, a, b)
fn w14_find(s, pat, i) = if i + count(pat) > count(s) then 0 - 1 else if slice(s, i, i + count(pat)) == pat then i else w14_find(s, pat, i + 1)
fn w14_shift_asm(root) = let src = root + "/build/native-test/w14_shift_asm.src" in let w = fs_write_sync(src, "fn s(a, k) = bit_shr(a, k)\nprint s(8, 1)\n") in let asm = root + "/build/native-test/w14_shift_asm.s" in let st = os_run_input_capture_timeout(root + "/build/bin/lumec", Nil, src, asm, asm + ".err", 120000) in let t = fs_read_file(asm) in let shr = w14_cut(t, "\nbit_shr:\n", "\nmem_copy:\n") in let shl = w14_cut(t, "\nbit_shl:\n", "\nbit_shr:\n") in if shr == "" or shl == "" then "w14_shift_asm: the routines bit_shl / bit_shr are not in the emitted runtime" else if nt_contains(shr, "    sarq %cl, %rax\n") == 0 or nt_contains(shr, "shrq") == 1 then "w14_shift_asm: bit_shr is not an arithmetic shift:\n" + shr else if nt_contains(shr, "    cmpq $63, %rcx\n    jg __rt_shc\n    cmpq $0, %rcx\n    jl __rt_shc\n") == 0 or nt_contains(shl, "    cmpq $63, %rcx\n    jg __rt_shc\n    cmpq $0, %rcx\n    jl __rt_shc\n") == 0 then "w14_shift_asm: a standalone shift routine has no range guard" else ""
fn w14_emit_byte(root) = w14_first(Cons(w14_pos(root, "w14_emit_ok", "fn big(k) = 4611686018427387904 + k\nfn go() = let a = emit(65) in let b = emit(big(66)) in let c = emit(256 + 67) in let d = emit(10) in 0\nprint go()\n", "ABC\n0\n"), Cons(w14_trap(root, "w14_emit_list", "fn go() = let a = emit(65) in let b = emit(Cons(1, Nil)) in let c = emit(10) in 0\nprint go()\n", "", "arithmetic needs integers"), Cons(w14_trap(root, "w14_emit_record", "fn go() = let a = emit(65) in let b = emit({x: 1}) in let c = emit(10) in 0\nprint go()\n", "", "arithmetic needs integers"), Cons(w14_isr_asm(root), Nil)))))
## the interrupt stub gives the interrupted code its callee-saved registers back (the string path uses r12..r14)
fn w14_isr_asm(root) = let src = root + "/build/native-test/w14_isr_asm.src" in let w = fs_write_sync(src, "@interrupt(irq: 32)\n@bound(cycles: 32)\nfn tick(n: int) -> int = n + 1\n@freestanding\nfn kernel_boot_entry() -> int = cpu_irq32_count()\n") in let asm = root + "/build/native-test/w14_isr_asm.s" in let st = os_run_input_capture_timeout(root + "/build/bin/lumec", Nil, src, asm, asm + ".err", 120000) in let stub = w14_cut(fs_read_file(asm), "\n__isr_hw_32:\n", "    iretq\n") in if stub == "" then "w14_isr_asm: no __isr_hw_32 stub in the kernel image text: " + fs_read_file(asm + ".err") else if nt_contains(stub, "    pushq %rbx\n    pushq %r12\n    pushq %r13\n    pushq %r14\n    pushq %r15\n") == 0 or nt_contains(stub, "    popq %r15\n    popq %r14\n    popq %r13\n    popq %r12\n    popq %rbx\n") == 0 then "w14_isr_asm: the interrupt stub does not save and restore %rbx, %r12..%r15:\n" + stub else if w14_find(stub, "pushq %r12", 0) > w14_find(stub, "call tick", 0) or w14_find(stub, "popq %r12", 0) < w14_find(stub, "call tick", 0) then "w14_isr_asm: the registers are not saved around the handler call:\n" + stub else ""
## A clause whose own evaluation stops the program is never `proven`: the default build and --keep-proven-checks stop
## at the same place on the same input, and print the same value on the inputs where the clause evaluates.
fn w14_clause_one(root, name, src, good_out, bad_err) = w14_first(Cons(w14_trap_f(root, name + "_d", src, Nil, good_out, bad_err), Cons(w14_trap_f(root, name + "_k", src, Cons("--keep-proven-checks", Nil), good_out, bad_err), Nil)))
## a proof that needs the declared types guards every declared parameter with `p - 0`, a `bool` one included: the
## operator check used to refuse that guard ([T0001] `bool - int`) and the function did not compile
fn w14_bool_guard_src() = "fn k(p0: int, p1: bool) -> int ensures result >= p0 = if p1 then p0 else p0 + 0\nfn m(p0: int, p1: bool, p2: int, p3: int) -> int ensures result == ((let x2 = (p2 + 2) in (p2 - 775)) + (-(if (7 <= 8) then p0 else p2))) = (let x2 = p2+2 in p2 - 775) + -if 7 <= 8 then p0 else p2\nprint k(5, true)\nprint m(1, false, 10, 0)\n"
fn w14_clause_definedness(root) = w14_first(Cons(w14_clause_one(root, "w14_cl_type", "fn g(x) ensures x - 0 == x = x\nprint g(5)\nprint g(\"s\")\n", "5\n", "arithmetic needs integers"), Cons(w14_clause_one(root, "w14_cl_ovf", "fn g(x: int) -> int ensures x * x >= 0 = x\nprint g(3)\nprint g(4000000000)\n", "3\n", "integer overflow"), Cons(w14_clause_one(root, "w14_cl_div", "fn g(x: int, y: int) -> int ensures x / y * 0 == 0 = x\nprint g(4, 2)\nprint g(4, 0)\n", "4\n", "division by zero"), Cons(w14_clause_one(root, "w14_cl_shift", "fn g(x: int, k: int) -> int ensures bit_shl(x, k) == bit_shl(x, k) = x\nprint g(4, 2)\nprint g(4, 64)\n", "4\n", "shift count outside 0..63"), Cons(w14_pos_f(root, "w14_cl_proven_k", "fn inc(x: int) -> int requires x >= 0 and x <= 1000 ensures result == x + 1 and result >= 1 = x + 1\nprint inc(41)\n", Cons("--keep-proven-checks", Nil), "42\n"), Cons(w14_pos(root, "w14_cl_proven_d", "fn inc(x: int) -> int requires x >= 0 and x <= 1000 ensures result == x + 1 and result >= 1 = x + 1\nprint inc(41)\n", "42\n"), Cons(w14_pos(root, "w14_cl_bool_param_guard", w14_bool_guard_src(), "5\n-766\n"), Cons(w14_pos_f(root, "w14_cl_bool_param_guard_k", w14_bool_guard_src(), Cons("--keep-proven-checks", Nil), "5\n-766\n"), Nil)))))))))
fn nt_wave14_gates(root) = w14_first(Cons(w14_fixtures(root), Cons(w14_not_precedence(root), Cons(w14_statement_rule(root), Cons(w14_block_comment(root), Cons(w14_int_literals(root), Cons(w14_strict_types(root), Cons(w14_attributes(root), Cons(w14_pure_ctfail_total_mutual(root), Cons(w14_shift_range(root), Cons(w14_emit_byte(root), Cons(w14_clause_definedness(root), Nil))))))))))))

fn nt_main(root) = let made = fs_mkdir(root + "/build/native-test") in if made != 1 then "cannot create native test artifact directory" else let checked = nt_check_cases(root, Cons("01_hello", Cons("02_basics", Cons("03_records_enums", Cons("04_errors_optionals", Cons("05_collections_closures", Cons("06_traits_generics", Cons("07_contracts_defer", Cons("08_shell_script", Cons("09_stdlib", Nil)))))))))) in if checked != "" then checked else let tokens = nt_token_cases(root, Cons("literals", Cons("indent", Nil))) in if tokens != "" then tokens else let stage0 = nt_stage0_cases(root, Cons("01_hello", Cons("02_basics", Cons("03_records_enums", Cons("04_errors_optionals", Cons("05_collections_closures", Cons("06_traits_generics", Cons("07_contracts_defer", Cons("09_stdlib", Nil))))))))) in if stage0 != "" then stage0 else let negative = nt_negative_seeds(root) in if negative != "" then negative else let built = nt_native_build(root) in if built != "" then built else let tested = nt_native_tests(root) in if tested != "" then tested else let ltestfail = nt_negative_native(root) in if ltestfail != "" then ltestfail else let soundness = nt_negative_soundness(root) in if soundness != "" then soundness else let wave2 = nt_wave2_gates(root) in if wave2 != "" then wave2 else let wave3 = nt_wave3_gates(root) in if wave3 != "" then wave3 else let wave4 = nt_wave4_gates(root) in if wave4 != "" then wave4 else let wave5 = nt_wave5_gates(root) in if wave5 != "" then wave5 else let wave6 = nt_wave6_gates(root) in if wave6 != "" then wave6 else let wave7 = nt_wave7_gates(root) in if wave7 != "" then wave7 else let wave8 = nt_wave8_gates(root) in if wave8 != "" then wave8 else let wave9 = nt_wave9_gates(root) in if wave9 != "" then wave9 else let wave14 = nt_wave14_gates(root) in if wave14 != "" then wave14 else nt_lasm_strict(root)

fn nt_dispatch(input) = let root = nt_root(input) in if root == "" then ctfail("native test runner requires @root\n") else let problem = nt_main(root) in if problem != "" then ctfail("native test runner failed: " + problem + "\n") else "PASS: bounded native Lume test gate (seed checks, Stage 0, LBE, native build, test discovery, and toolchain-soundness negatives)"

print nt_dispatch(readall())
