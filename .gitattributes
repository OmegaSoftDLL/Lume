# Prose and specifications are documentation, not code.
*.md        linguist-documentation
*.ebnf      linguist-documentation
docs/**     linguist-documentation
grammar/**  linguist-documentation

# Enforce LF line endings on Lume sources and scripts (never CRLF; #438).
*.src               text eol=lf
*.lume              text eol=lf
*.mesh              text eol=lf
*.blk               text eol=lf
*.intent            text eol=lf
*.bundle            text eol=lf
*.expected          text eol=lf
*.sh                text eol=lf
lume                text eol=lf
compiler/stage1/**  text eol=lf
scripts/**          text eol=lf

# Everything else that git treats as text is LF too (#438).
*.md                text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.json              text eol=lf
*.toml              text eol=lf
*.c                 text eol=lf
*.h                 text eol=lf
Makefile            text eol=lf

