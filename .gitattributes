* text=auto eol=lf

# Lume is this repository's language. GitHub Linguist counts .lume/.src/.blk as Lume.
# The C bootstrap seed is disposable — it exists only until Lume self-hosts — so it,
# and the build/test/CI scaffolding, are marked vendored and are not counted as the
# project's language. The goal is a repo that reads as what it is: Lume.
*.lume linguist-language=Lume linguist-detectable=true
*.src  linguist-language=Lume linguist-detectable=true
*.blk  linguist-language=Lume linguist-detectable=true

# Disposable bootstrap seed (C) + build/test/CI/packaging scaffolding: not the project language.
bootstrap/** linguist-vendored
Formula/**   linguist-vendored
evolve/**    linguist-vendored
acceptance/** linguist-vendored
*.c  linguist-vendored
*.h  linguist-vendored
*.s  linguist-vendored
*.S  linguist-vendored
*.rb linguist-vendored
*.sig linguist-vendored
*.pub linguist-vendored
*.der linguist-vendored
*.bundle linguist-vendored
*.expected linguist-vendored
*.tokens linguist-vendored
*.sha256 linguist-vendored
*.toml linguist-vendored
*.json linguist-vendored
*.lock linguist-vendored
*.txt linguist-vendored
*.mesh linguist-vendored
*.intent linguist-vendored
Makefile     linguist-vendored
**/Makefile  linguist-vendored
lume         linguist-vendored
bin/**       linguist-vendored
VERSION      linguist-vendored
CITATION.cff linguist-vendored
**/MANIFEST  linguist-vendored
*.html       linguist-vendored
*.svg        linguist-vendored
*.sh  linguist-vendored
.github/**  linguist-vendored
*.yml  linguist-vendored
*.yaml linguist-vendored
