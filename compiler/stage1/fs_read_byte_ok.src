## fs_read_byte_ok.src -- exact bytes of a text and of a binary file (an ELF-like header with a NUL), missing paths and
## bad offsets; every fixture is made here, so the file passes from any working directory.
fn frb_fixture() = fs_write_sync("fs_read_byte_probe", "A\n")
fn frb_binary() = fs_write_sync("fs_read_byte_bin_probe", chr(127) + "ELF" + chr(2) + chr(1) + chr(1) + chr(0) + "rest")

fn test_fs_read_byte_first() = let written = frb_fixture() in written == 1 and fs_read_byte("fs_read_byte_probe", 0) == 65

fn test_fs_read_byte_second() = let written = frb_fixture() in written == 1 and fs_read_byte("fs_read_byte_probe", 1) == 10

fn test_fs_read_byte_out_of_range() = let written = frb_fixture() in let b = fs_read_byte("fs_read_byte_probe", 2) in let z = fs_remove("fs_read_byte_probe") in written == 1 and b == 0 - 1

fn test_fs_read_byte_missing() = fs_read_byte("definitely_missing_byte_dir/definitely_missing_byte_probe", 0) == 0 - 1

fn test_fs_read_byte_negative_offset() = let written = frb_binary() in written == 1 and fs_read_byte("fs_read_byte_bin_probe", 0 - 1) == 0 - 1

fn test_fs_read_byte_native_nul() = let written = frb_binary() in written == 1 and fs_read_byte("fs_read_byte_bin_probe", 7) == 0

fn test_fs_read_byte_native_header() = let written = frb_binary() in let b = fs_read_byte("fs_read_byte_bin_probe", 0) in let z = fs_remove("fs_read_byte_bin_probe") in written == 1 and b == 127
