## lqualify.src -- tool qualification battery and dossier generator (`lume qualify`).
##
## It runs the evidence a tool-qualification effort needs and writes it down, in build/certification/:
##   TOR_TOOL_OPERATIONAL_REQUIREMENTS.md, TQP_TOOL_QUALIFICATION_PLAN.md, RTM_TRACEABILITY_MATRIX.json / .md,
##   QUALIFICATION_EVIDENCE.json (hash-chained), QUALIFICATION_EVIDENCE.sig.json (detached Ed25519 signature),
##   QUALIFICATION_SIGNING_KEY.pub, QUALIFICATION_SIGNING_CERT.der (self-signed X.509 v3 certificate of that key),
##   QUALIFICATION_DOSSIER.md. The machine-readable summaries the gates write there (safety_envelope_gate_summary.json,
##   realtime_gate_summary.json, synergy_gate_summary.json with its signed manifest, ...) are hash-linked into the
##   evidence chain (q_gate_sums).
## Nothing in those files is asserted by this program on its own authority: every "pass" is the exit status and the
## output of a real run made here (a probe program compiled and executed, a gate binary, a tool report), and every file
## named in the matrix is read from disk and hashed. The run fails (non-zero exit, the JSON summary still on stdout) when
##   * a probe or a gate fails,
##   * a requirement is not fully traced: every low-level requirement needs a parent high-level requirement, a source
##     file that exists, a passing positive test, a passing negative test and a passing mutation gate or proof
##     (rtm_requirement_fully_traced below, the Domain #114 kernel, proven by lumec); every high-level requirement
##     needs a child; every probe and every gate needs a requirement that cites it,
##   * the matrix checker does not reject a deliberately orphaned copy of the matrix (its own negative control),
##   * the translation validator rejects a function of a certified module, a module holds an obligation that is only
##     runtime-checked or refuted, or a coverage witness disagrees with the real machine,
##   * a certified module has an uncovered coverage obligation: all four certified modules are in the MC/DC-qualified
##     set (q_modules), and `q_mc_ok` is the rule (the P-MCDC-NEG-UNCOVERED probe applies it to a real lmcdc report).
##
## What this is NOT. It is the tool developer's own evidence package, organised along DO-330 (TQL-1), DO-178C (DAL A),
## IEC 61508-3 (tool class T3) and IEC 62304 (class C). It is not a qualification: that is granted per project by the
## certification authority or assessor, needs verification independent of the developer, and needs the operational
## requirements of the actual project. The dossier says so on its first page and lists the open items.
##
## stdin: @root <repo>   [@quick 1: sampled gates, the dossier is marked NOT FOR CREDIT]   [@skip-gates 1: probes and
##        module batteries only, the result is INCOMPLETE and the exit status non-zero]
##        [@sign-key <path>: file holding the Ed25519 seed, created when absent]
##        or: @verify <directory>   [@root <repo>]   [@now <seconds since 1970>]: re-check the hash chain, the signature
##        and the X.509 certificate of the signing key of a written package (the certificate must validate as its own
##        trust anchor at `now`, the host's time by default, and certify the key of the signature file)
## A gate whose binary (or a tool binary it needs) is absent is built from its source first (q_gate_src, q_gate_deps);
## a missing emulator fails the gate. Wave 14: gates G-TVRT, G-SMT, G-SCALE, G-SYNERGY, G-CLI; the probes of
## q_probes_h / _i / _j; requirements HLR-10 and the LLRs of q_llrs_f / _g.
use fs_sha256_file
use lcrypto_tls

## --- helpers ---
fn q_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else q_line_end(s, i + 1)
fn q_get_at(s, key, i) = if i >= count(s) then "" else let e = q_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else q_get_at(s, key, e + 1)
fn q_get(s, key) = q_get_at(s, key, 0)
fn q_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn q_index(text, part, i) = if i + count(part) > count(text) then 0 - 1 else if slice(text, i, i + count(part)) == part then i else q_index(text, part, i + 1)
fn q_has(text, part) = if q_index(text, part, 0) >= 0 then 1 else 0
fn q_join(xs) = match xs
    Nil        => ""
    Cons(h, t) => h + q_join(t)
fn q_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + q_len(t)
fn q_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, q_app(t, ys))
fn q_mem(xs, x) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else q_mem(t, x)
fn q_jesc1(c) = if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then "\\n" else if c == "\t" then " " else if c == "\r" then "" else c
fn q_jesc_at(s, i, n) = if i >= n then Nil else Cons(q_jesc1(at(s, i)), q_jesc_at(s, i + 1, n))
fn q_jesc(s) = q_join(q_jesc_at(s, 0, count(s)))
fn q_chomp(s) = if count(s) > 0 and at(s, count(s) - 1) == "\n" then q_chomp(slice(s, 0, count(s) - 1)) else s
fn q_last_line_at(s, i) = if i <= 0 then 0 else if at(s, i - 1) == "\n" then i else q_last_line_at(s, i - 1)
fn q_last_line(s) = let t = q_chomp(s) in let l = slice(t, q_last_line_at(t, count(t)), count(t)) in if count(l) > 900 then slice(l, 0, 900) + " ..." else l
fn q_digits_end(s, i) = if i < count(s) and at(s, i) >= "0" and at(s, i) <= "9" then q_digits_end(s, i + 1) else i
fn q_num(s, i, n, acc) = if i >= n then acc else q_num(s, i + 1, n, acc * 10 + (ord(at(s, i)) - 48))
## the integer that follows "key": in a JSON report (0 when the key is absent)
fn q_field(out, key) = let i = q_index(out, "\"" + key + "\":", 0) in if i < 0 then 0 else let b = i + count(key) + 3 in q_num(out, b, q_digits_end(out, b), 0)
fn q_count(text, part, i, acc) = let j = q_index(text, part, i) in if j < 0 then acc else q_count(text, part, j + count(part), acc + 1)
fn q_rep1(s, pat, rep, from) = let i = q_index(s, pat, from) in if i < 0 then s else slice(s, 0, i) + rep + slice(s, i + count(pat), count(s))
fn q_run(bin, args, out, ms) = let t0 = os_monotonic_ns() in let st = os_run_capture_timeout(bin, args, out, out + ".err", ms) in {status: q_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err"), ms: (os_monotonic_ns() - t0) / 1000000}
fn q_input(bin, args, inp, out, ms) = let t0 = os_monotonic_ns() in let st = os_run_input_capture_timeout(bin, args, inp, out, out + ".err", ms) in {status: q_wait_exit(st), out: fs_read_file(out), err: fs_read_file(out + ".err"), ms: (os_monotonic_ns() - t0) / 1000000}
fn q_request(bin, request, base, ms) = let w = fs_write_sync(base + ".in", request) in q_input(bin, Nil, base + ".in", base + ".out", ms)
fn q_bool(b) = if b == 1 then "true" else "false"
fn q_mark(b) = if b == 1 then "PASS" else "FAIL"

## --- Domain #114 kernels (mirrored in compiler/stage1/lstd.src and lchameleon.src, where their laws are proven) ---
@bound(32)
fn rtm_requirement_fully_traced(parent_links: int, source_files: int, positive_tests: int, negative_tests: int, mutants_or_proofs: int) -> int / pure requires parent_links >= 0 and source_files >= 0 and positive_tests >= 0 and negative_tests >= 0 and mutants_or_proofs >= 0 ensures result == 0 or result == 1 = if parent_links >= 1 and source_files >= 1 and positive_tests >= 1 and negative_tests >= 1 and mutants_or_proofs >= 1 then 1 else 0

## --- probes: {id, kind, src, arg, exp}. Each is a real program or request; `kind` says how it is run and judged ---
fn q_p(id, kind, src, arg, exp) = {id: id, kind: kind, src: src, arg: arg, exp: exp}
fn q_src_con() = "fn g(x: int) -> int requires x >= 0 and x <= 10 ensures result <= 20 = x * 2\nprint g(toint(os_arg_at(1)))\n"
fn q_src_sq(req) = "fn sq(x: int, y: int) -> int requires " + req + " ensures result >= 0 = x * y\nprint sq(3, 4)\n"
fn q_src_tv() = "fn tq(x: int, y: int) -> int requires x >= 0 and y >= 1 = if x <= y then x + y * 2 else (x - y) / y\nprint tq(3, 4)\n"
fn q_src_dose() = "@bound(cycles: 32)\nfn dose(req: int, lim: int) -> int / pure requires lim >= 0 and lim <= 50000 and req >= 0 - 1000000 and req <= 1000000 ensures result >= 0 and result <= lim = if req < 0 then 0 else if req > lim then lim else req\n"
fn q_src_vote(ens) = "fn vote(a_ok: int, b_ok: int, cert_ok: int, out_a: int, out_b: int) -> int / pure requires a_ok >= 0 and a_ok <= 1 and b_ok >= 0 and b_ok <= 1 and cert_ok >= 0 and cert_ok <= 1 ensures " + ens + " = if a_ok == 1 and b_ok == 1 and cert_ok == 1 and out_a == out_b then 1 else 0\nprint vote(1, 1, 1, 7, 7)\n"
fn q_src_list() = "fn mk(n: int, acc: [int]) -> [int] = if n <= 0 then acc else mk(n - 1, Cons(n, acc))\nfn ln(xs: [int], a: int) -> int = match xs\n    Nil => a\n    Cons(h, t) => ln(t, a + 1)\nprint ln(mk(toint(os_arg_at(1)), Nil), 0)\n"
fn q_probes_a() = Cons(q_p("P-LEX-POS", "run", "## lexer probe: comment, integers, string escapes\nfn f(x: int) -> int = x * 2 + 1\nprint str(f(20)) + \":\" + \"q\\\"z\"\n", "", "41:q\"z\n"), Cons(q_p("P-LEX-NEG", "reject", "print \"abc\n", "", "[L0001]"), Cons(q_p("P-PAR-POS", "run", "fn g(a: int, b: int) -> int = let t = if a > b then a - b else b - a in if t == 0 or a < 0 and b < 0 then 0 else t * 3\nprint g(7, 2)\n", "", "15\n"), Cons(q_p("P-PAR-NEG", "reject", "fn f( = 1\nprint f()\n", "", "[P0002]"), Cons(q_p("P-TYP-POS", "run", "fn h(x: int, s: str) -> str = s + str(x)\nprint h(4, \"n=\")\n", "", "n=4\n"), Cons(q_p("P-TYP-NEG", "reject", "fn f(x: int) -> int = x + 1\nprint f(\"a\")\n", "", "[T0001]"), Cons(q_p("P-CON-POS", "run", q_src_con(), "5", "10\n"), Cons(q_p("P-CON-NEG-STATIC", "reject", "fn g(x: int) -> int requires x >= 0 and x <= 10 ensures result <= 20 = x * 2\nprint g(11)\n", "", "[V0001]"), Cons(q_p("P-CON-NEG-RUNTIME", "trap", q_src_con(), "11", "runtime contract violation (requires) in 'g'"), Cons(q_p("P-CON-NEG-ENSURES", "reject", "fn mk_next(x: int) -> int requires x >= 0 and x <= 1000 ensures result > x = x - 1\nprint mk_next(7)\n", "", "[V0001]"), Nil))))))))))
fn q_probes_b() = Cons(q_p("P-PUR-POS", "run", "fn pf() -> int / pure = 41 + 1\nprint pf()\n", "", "42\n"), Cons(q_p("P-PUR-NEG", "reject", "fn pf() -> int / pure = fs_path_exists(\"a\")\nprint pf()\n", "", "[E0200]"), Cons(q_p("P-SEC-POS", "run", "fn pick_k(k: int) -> int = if k == 0 then 1 else 2\nprint pick_k(5)\n", "", "2\n"), Cons(q_p("P-SEC-NEG", "reject", "@secret fn pick_k(k: int) -> int = if k == 0 then 1 else 2\nprint pick_k(5)\n", "", "[C0009]"), Cons(q_p("P-OWN-POS", "run", "fn consume(own xs: [int]) -> int = match xs\n    Nil => 0\n    Cons(h, t) => h\nfn once(own xs: [int]) -> int = consume(own xs) + 1\nprint once(own Cons(1, Nil))\n", "", "2\n"), Cons(q_p("P-OWN-NEG", "reject", "fn consume(own xs: [int]) -> int = match xs\n    Nil => 0\n    Cons(h, t) => h\nfn twice(own xs: [int]) -> int = consume(own xs) + consume(own xs)\nprint twice(own Cons(1, Nil))\n", "", "[O0001]"), Cons(q_p("P-PRV-LIA-POS", "proven", "fn g(x: int, y: int) -> int requires x >= 0 and y >= 0 ensures result >= x = x + y\nprint g(1, 2)\n", "g", ""), Cons(q_p("P-PRV-LIA-NEG", "notproven", "fn g(x: int, y: int) -> int requires x >= 0 ensures result >= x = x + y\nprint g(1, 2)\n", "g", ""), Cons(q_p("P-PRV-NIA-POS", "proven", q_src_sq("x >= 0 and y >= 0"), "sq", ""), Cons(q_p("P-PRV-NIA-NEG", "notproven", q_src_sq("x >= 0"), "sq", ""), Nil))))))))))
fn q_probes_c() = Cons(q_p("P-CRT-POS", "cert-ok", q_src_sq("x >= 0 and y >= 0"), "", ""), Cons(q_p("P-CRT-NEG", "cert-bad", q_src_sq("x >= 0 and y >= 0"), "(>= result 0)", "(>= result 1)"), Cons(q_p("P-TV-POS", "tv-ok", q_src_tv(), "tq", ""), Cons(q_p("P-TV-NEG-ARITH", "tv-bad", q_src_tv(), "tq", "    addq %rsi, %rax=>    subq %rsi, %rax"), Cons(q_p("P-TV-NEG-BRANCH", "tv-bad", q_src_tv(), "tq", "    jg .=>    jge ."), Cons(q_p("P-TV-NEG-FRAME", "tv-bad", q_src_tv(), "tq", "    movq %rbp, %rsp=>    movq %rbp, %rbp"), Cons(q_p("P-ASM-POS", "run", "fn s(n: int, acc: int) -> int = if n <= 0 then acc else s(n - 1, acc + n)\nprint s(100, 0)\n", "", "5050\n"), Cons(q_p("P-ASM-NEG", "asm-bad", "    movq $1, %rax\n    bogusq %rax, %rbx\n", "", "[L0001]"), Cons(q_p("P-FFI-POS", "adapt-ok", "int64_t ok_sum(int64_t a, int64_t b);\n", "", "unverified[int]"), Cons(q_p("P-FFI-NEG", "adapt-bad", "int64_t bad(const char *t, ...);\n", "", "I0003"), Nil))))))))))
fn q_probes_d() = Cons(q_p("P-RTE-POS", "run", "fn a(x: int, y: int) -> int = x / y + x % y\nprint a(0 - 7, 2)\n", "", "-4\n"), Cons(q_p("P-RTE-NEG-OVERFLOW", "trap", "fn a(x: int) -> int = x + 1\nprint a(toint(os_arg_at(1)))\n", "9223372036854775807", "integer overflow"), Cons(q_p("P-RTE-NEG-DIVZERO", "trap", "fn d(x: int) -> int = 10 / x\nprint d(toint(os_arg_at(1)))\n", "0", "division by zero"), Cons(q_p("P-MEM-POS", "gc-ok", q_src_list(), "20000", "20000\n"), Cons(q_p("P-MEM-NEG", "oom", q_src_list(), "2000000", "heap cap exceeded"), Cons(q_p("P-WCET-POS", "run", "@bound(cycles: 40)\nfn w(x: int) -> int = x * x + 1\nprint w(3)\n", "", "10\n"), Cons(q_p("P-WCET-NEG", "reject", "@bound(cycles: 4)\nfn w(x: int) -> int = x * x * x * x * x * x * x * x * x * x * x * x + x * x * x * x * x * x\nprint w(2)\n", "", "[V0002]"), Cons(q_p("P-ENV-POS", "env-ok", q_src_dose(), "dose", "700,500"), Cons(q_p("P-ENV-NEG-SEU", "env-bad", q_src_dose(), "dose", "@inject a_bit:3"), Cons(q_p("P-ENV-NEG-WCET", "env-bad", q_src_dose(), "dose", "@budget 5"), Nil))))))))))
## Sources of the coverage-analyzer probes. Each one is a regression test of lmcdc itself:
##   search   outcomes only reachable through a literal above 2^30 (`v > 1000000000000`), through a recursive callee
##            (`it`) and through a neighbour at distance 2 (`c <= 1000 and a > c` needs a = 1002): all must be covered;
##   dead     a branch that no input takes and the kernel cannot refute (nonlinear): must stay UNCOVERED;
##   nested   two decisions (`a > 0`, `b > 0`) inside a condition of a third: all three must be obligations (12);
##   path     under `lo <= x and x <= hi` the outcome `x < lo` is impossible: the kernel must prove it from the
##            enclosing condition (2 infeasible, listed with their proof term), and nothing is uncovered;
##   shadow   `let x` rebinds the parameter `requires` constrains (`shadow_k`) or the variable an enclosing condition
##            constrains (`path_rebound`); the false outcome is taken at y = 500, which the search does not reach: it
##            must be uncovered, never "infeasible" on the strength of `x >= 10`, which speaks about the other `x`;
##   lawhyp   the HYPOTHESIS of a law, false at y = 500 only, and a function merely named `law_*`: uncovered, never
##            "theorem-false" (only the two conclusions `1 == 1` and `2 == 2` are: 4 obligations);
##   ens      an `ensures` the prover did not discharge and that is false at y = 500: uncovered, never "theorem-false".
fn q_src_mc_search() = "fn it(n: int, g: int, k: int) -> int = if k <= 0 or g <= 0 then g else let nx = (g + n / g) / 2 in if nx >= g then g else it(n, nx, k - 1)\nfn rt(n: int) -> int = if n <= 0 then 0 else if n < 4 then 1 else it(n, n / 2 + 1, 64)\nfn clamp(v: int) -> int requires v >= 0 = if v > 1000000000000 then 1000000000000 else v\nlaw gap2(a: int, c: int) = if c >= 0 and c <= 1000 and a > c then clamp(a) >= 0 else 1 == 1\n"
fn q_src_mc_dead() = "fn dz(x: int) -> int = let p = x * (180 - x) in let d = 40500 - p in if d <= 0 then 0 else (4000 * p + d / 2) / d\n"
fn q_src_mc_shadow() = "fn shadow_k(x: int, y: int) -> int requires x >= 10 = let x = y * y - 1001 * y + 250500 in if x >= 1 then 1 else 0\nfn path_rebound(x: int, y: int) -> int = if x >= 10 then (let x = y * y - 1001 * y + 250500 in if x >= 1 then 1 else 0) else 2\n"
fn q_src_mc_nested() = "fn nest(a: int, b: int) -> int = if (if a > 0 then 1 else 0) + (if b > 0 then 1 else 0) >= 2 then 1 else 0\n"
fn q_src_mc_path() = "fn pc(x: int, lo: int, hi: int) -> int = if lo <= x and x <= hi then (if x < lo then 1 else 2) else 3\n"
fn q_src_mc_lawhyp() = "law hidden_hyp(y: int) = if y * y - 1001 * y + 250500 >= 1 then 1 == 1 else 2 == 2\nfn law_named_by_user(y: int) -> int = if y * y - 1001 * y + 250500 >= 1 then 1 else 0\n"
fn q_src_mc_ens() = "fn ens_unproved(y: int) -> int ensures result * result - 1001 * result + 250500 >= 1 = y\n"
fn q_probes_e() = Cons(q_p("P-MCDC-POS", "mcdc-ok", q_src_dose(), "", ""), Cons(q_p("P-MCDC-NEG", "mcdc-gap", "fn dead(x: int) -> int requires x >= 0 = if x < 0 - 5 then 1 else 2\n", "", ""), Cons(q_p("P-MCDC-POS-SEARCH", "mcdc-ok", q_src_mc_search(), "", ""), Cons(q_p("P-MCDC-NEG-UNCOVERED", "mcdc-fail", q_src_mc_dead(), "", ""), Cons(q_p("P-MCDC-POS-NESTED", "mcdc-exact-ok", q_src_mc_nested(), "", "decisions=3;obligations=12;covered=12;uncovered=0;"), Cons(q_p("P-MCDC-POS-PATH", "mcdc-exact-ok", q_src_mc_path(), "", "obligations=10;covered=8;infeasible_proved_by_kernel=2;uncovered=0;"), Cons(q_p("P-MCDC-NEG-SHADOW", "mcdc-exact", q_src_mc_shadow(), "", "obligations=16;covered=12;infeasible_proved_by_kernel=0;uncovered=4;"), Cons(q_p("P-MCDC-NEG-LAWHYP", "mcdc-exact", q_src_mc_lawhyp(), "", "theorem_false_unreachable=4;infeasible_proved_by_kernel=0;uncovered=6;"), Cons(q_p("P-MCDC-NEG-ENSURES", "mcdc-exact", q_src_mc_ens(), "", "theorem_false_unreachable=0;infeasible_proved_by_kernel=0;uncovered=2;"), Cons(q_p("P-DOM-POS", "proven", q_src_vote("result == 0 or result == 1"), "vote", ""), Cons(q_p("P-DOM-NEG", "notproven", q_src_vote("result == 1"), "vote", ""), Cons(q_p("P-BOOT-POS", "seed-ok", "", "", ""), Cons(q_p("P-BOOT-NEG", "seed-bad", "", "", ""), Nil)))))))))))))
## Wave 12 probes: machine-level constant time, DWARF line tables, the proof cache, linear concurrency, the
## cryptography that signs this evidence, the multi-ISA kernel back ends and the neural cartridges
fn q_src_ct() = "@secret\n@no_alloc\nfn ctsel(mask: int, a: int, b: int) -> int = bit_xor(a, bit_and(mask, bit_xor(a, b)))\n@secret fn ctadd(k: int, m: int) -> int = k + m\nprint 0\n"
fn q_src_pc(ens) = "fn pa(x: int) -> int requires x >= 0 ensures result >= 1 = x + 1\nfn pb(x: int) -> int requires x >= 0 ensures result >= " + ens + " = pa(x) + 1\nprint pb(1)\n"
fn q_src_kernel() = "fn sq(x: int) -> int requires x >= 0 ensures result >= 0 = x * x\nprint sq(12)\n"
fn q_src_front() = "fn g(x: int) -> int requires x >= 0 and x <= 10 ensures result <= 20 = x * 2\nprint g(11)\n"
fn q_probes_f() = Cons(q_p("P-CT-POS", "tv-ok", q_src_ct(), "ctsel", ""), Cons(q_p("P-CT-NEG", "tv-reject", q_src_ct(), "ctadd", "[C0010]"), Cons(q_p("P-DBG-POS", "dwarf-ok", "fn dq(x: int) -> int = x * 3 + 1\nprint dq(13)\n", "", "40\n"), Cons(q_p("P-DBG-NEG", "asm-bad", "    .section .text\n_start:\n    .loc 9 1 0\n    ret\n", "", "[L0001]"), Cons(q_p("P-PCH-POS", "pcache-ok", q_src_pc("2"), "", ""), Cons(q_p("P-PCH-NEG-TAMPER", "pcache-tamper", q_src_pc("2"), "", "[PC0002]"), Cons(q_p("P-PCH-NEG-FALSE", "pcache-false", q_src_pc("9"), "", "[PC0003]"), Nil)))))))
fn q_probes_g() = Cons(q_p("P-CONC-POS", "run", "fn chan_send_linear(ch, x) = x\nfn route(flag) =\n    let pkt = {code: 77} in\n    if flag == 1 then (chan_send_linear(1, pkt)).code else (chan_send_linear(2, pkt)).code\nprint route(1)\n", "", "77\n"), Cons(q_p("P-CONC-NEG-MOVE", "reject", "fn chan_send_linear(ch, x) = x\nfn bad_double() =\n    let tok = Cons(7, Cons(8, Nil)) in\n    let _s1 = chan_send_linear(1, tok) in\n    chan_send_linear(2, tok)\nprint bad_double()\n", "", "E0305"), Cons(q_p("P-CONC-NEG-RANK", "reject", "fn lock_acquire(k) = k\nfn lock_release(k) = 0\nfn invert() =\n    let _a = lock_acquire(2) in\n    let _b = lock_acquire(1) in\n    let _c = lock_release(1) in\n    lock_release(2)\nprint invert()\n", "", "E0306"), Cons(q_p("P-CRY-POS", "kat-ok", "", "", ""), Cons(q_p("P-CRY-NEG", "kat-bad", "", "", ""), Cons(q_p("P-MARCH-POS", "target-ok", q_src_kernel(), "aarch64-linux-gnu", "HEX:0:7f454c46"), Cons(q_p("P-MARCH-NEG-FRONT", "target-bad", q_src_front(), "riscv64-linux-gnu", "ERR:[T0902]"), Cons(q_p("P-MARCH-NEG-FRAG", "target-bad", "fn f(xs) = count(xs)\nprint f(1)\n", "riscv32-none-elf", "ERR:[T0901]"), Cons(q_p("P-STN-POS", "cart-ok", q_src_dose(), "", ""), Cons(q_p("P-STN-NEG", "cart-bad", "fn f(s: str) -> int / pure = count(s)\n", "", "ERR:"), Cons(q_p("P-RT-POS", "run", "@no_alloc\nfn step(a: int, b: int) -> int requires a >= 0 and a <= 1000 and b >= 0 and b <= 1000 ensures result >= 0 = a * b + 7\nprint step(5, 3)\n", "", "22\n"), Cons(q_p("P-RT-NEG-CALLEE", "reject", "fn helper(a: int) -> int = a + 1\n@no_alloc\nfn r(a: int) -> int requires a >= 0 and a <= 10 = helper(a)\nprint r(1)\n", "", "[E0210]"), Cons(q_p("P-RT-NEG-BOUNDS", "reject", "@no_alloc\nfn r(a: int, b: int) -> int = a * b\nprint r(1, 2)\n", "", "[E0210]"), Cons(q_p("P-CRTSRC-POS", "certsrc-ok", "fn cs(x: int, y: int) -> int requires x >= 0 and y >= 0 ensures result >= x = x + y\n", "", ""), Cons(q_p("P-CRTSRC-NEG", "certsrc-bad", "fn cs(x: int, y: int) -> int requires x >= 0 and y >= 0 ensures result >= x = x + y\n", "fn cs(x: int, y: int) -> int requires x >= 0 and y >= 0 ensures result >= x + 1 = x + y\n", "K0010"), Cons(q_p("P-CAP-POS", "run", "fn g(a: int) -> int = let t = a in t\nfn f(t: int) -> int requires t >= 0 ensures result == t + 1 = let y = g(1) in y + t\nprint f(5)\n", "", "6\n"), Cons(q_p("P-CAP-NEG", "reject", "fn g(a: int) -> int = let t = a in t\nfn f(t: int) -> int requires t >= 0 ensures result == 2 = let y = g(1) in y + t\nprint f(5)\n", "", "[V0001]"), Nil)))))))))))))))))
## Wave 14 probes: the clean-room monitor channel and the split bundle, the static stack bound, the runtime-helper
## verifier, the native SMT-LIB checker, constant-time kernels, X.509 and the entropy health check, the prover fix for
## the wrapping SIMD lanes, the [E0210] hole of kept checks, the chain of hashes between the tools, the driver and the
## proof service. Expected numbers (stack bytes) were taken from a real run of the tools, not chosen.
fn q_src_ctk() = "@secret\n@no_alloc\nfn ctk_add32(a: int, b: int) -> int = bit_and(bit_and(a, 4294967295) + bit_and(b, 4294967295), 4294967295)\n@secret\n@no_alloc\nfn ctk_step(acc: int, a: int, b: int) -> int = bit_or(acc, bit_xor(ctk_add32(a, 0), ctk_add32(b, 0)))\n"
fn q_src_stk() = "@no_alloc\nfn stk_leaf(a: int) -> int requires a >= 0 and a <= 1000 ensures result >= 0 = a * 3\n@no_alloc\nfn stk_top(a: int, b: int) -> int requires a >= 0 and a <= 1000 and b >= 0 and b <= 1000 = stk_leaf(a) + stk_leaf(b)\nprint stk_top(2, 3)\n"
fn q_src_simd(req, ens) = "fn g(a: int, b: int) -> int requires " + req + " ensures " + ens + " = simd_add4_i64(a, b)\nprint g(toint(os_arg_at(1)), 0)\n"
fn q_src_keep() = "fn h(x: int) -> int = count(str(x))\n@no_alloc\nfn f(n: int) -> int requires n >= 0 and n <= 100000 ensures h(n) == 0 or result == n = n\nprint f(3)\n"
fn q_src_chain(k) = "fn ch(x: int, y: int) -> int requires x >= 0 and x <= 1000 and y >= 0 and y <= 1000 ensures result >= x and result <= " + k + " = x + y\n"
fn q_probes_h() = Cons(q_p("P-ENVX-POS-INDEP", "env-indep", "", "", ""), Cons(q_p("P-ENVX-NEG-ASRC", "env-inj", q_src_dose(), "dose", "a_src:swap:0=>a_trap"), Cons(q_p("P-ENVX-NEG-BSRC", "env-inj", q_src_dose(), "dose", "b_src:branch:0=>lockstep_mismatch"), Cons(q_p("P-ENVX-NEG-BCG", "env-inj", q_src_dose(), "dose", "b_cg:reg:0=>b_ebreak_contract_violation"), Cons(q_p("P-SPLIT-POS", "split-ok", q_src_dose(), "dose", "700,500=>500"), Cons(q_p("P-SPLIT-NEG", "split-bad", q_src_dose(), "dose", ""), Cons(q_p("P-STK-POS", "stack-ok", q_src_stk(), "stk_top", "80"), Cons(q_p("P-STK-NEG", "stack-bad", q_src_stk(), "stk_leaf", ".Ltail_stk_leaf:\n=>.Ltail_stk_leaf:\n    call stk_leaf\n"), Cons(q_p("P-KEEP-POS", "run", q_src_keep(), "", "3\n"), Cons(q_p("P-KEEP-NEG", "reject-flag", q_src_keep(), "--keep-proven-checks", "[E0210]"), Nil))))))))))
fn q_probes_i() = Cons(q_p("P-TVRT-POS", "tvrt-ok", q_src_tv(), "", ""), Cons(q_p("P-TVRT-NEG", "tvrt-bad", q_src_tv(), "addv", "    jo .Lrt_av_big\n=>    jno .Lrt_av_big\n"), Cons(q_p("P-SMT-POS", "smt-ok", q_src_tv(), "tq", ""), Cons(q_p("P-SMT-NEG", "smt-bad", q_src_tv(), "tq", "(assert false)"), Cons(q_p("P-CTK-POS", "ctk-ok", q_src_ctk(), "ctk_step", "ctk_add32"), Cons(q_p("P-CTK-NEG", "reject", "@secret\n@no_alloc\nfn ctk_pick(m: int, a: int, b: int) -> int = if 1 == 1 then bit_xor(b, bit_and(m, bit_xor(a, b))) else a\nprint 0\n", "", "[C0011]"), Cons(q_p("P-X509-POS", "x509-ok", "", "", ""), Cons(q_p("P-X509-NEG", "x509-bad", "", "", ""), Cons(q_p("P-ENT-POS", "entropy-ok", "", "", ""), Cons(q_p("P-ENT-NEG", "entropy-bad", "", "", ""), Nil))))))))))
fn q_probes_j() = Cons(q_p("P-SIMD-POS", "proven", q_src_simd("a >= 0 and a <= 100 and b >= 0 and b <= 100", "result == 4 * (a + b)"), "g", ""), Cons(q_p("P-SIMD-NEG-STATIC", "unproven", q_src_simd("a >= 0 requires b >= 0", "result >= 0"), "g", ""), Cons(q_p("P-SIMD-NEG-RUNTIME", "trap", q_src_simd("a >= 0 requires b >= 0", "result >= 0"), "2305843009213693952", "runtime contract violation (ensures) in 'g'"), Cons(q_p("P-CHAIN-POS", "chain-ok", q_src_chain("2000"), "ch", ""), Cons(q_p("P-CHAIN-NEG", "chain-bad", q_src_chain("2000"), "ch", q_src_chain("2001")), Cons(q_p("P-CLI-POS", "cli-ok", "", "", ""), Cons(q_p("P-CLI-NEG", "cli-bad", "", "no-such-command-of-lume", "unknown native driver command"), Cons(q_p("P-CAAS-POS", "caas-ok", "fn f(x: int) -> int requires x >= 0 ensures result >= 1 = x + 1\nprint f(1)\n", "", ""), Cons(q_p("P-CAAS-NEG", "caas-bad", "fn f(x: int) -> int = x + 1\nprint f(\"a\")\n", "", "T2001"), Nil)))))))))
fn q_probes() = q_app(q_probes_a(), q_app(q_probes_b(), q_app(q_probes_c(), q_app(q_probes_d(), q_app(q_probes_e(), q_app(q_probes_f(), q_app(q_probes_g(), q_app(q_probes_h(), q_app(q_probes_i(), q_probes_j())))))))))

## --- probe execution ---
fn q_res(id, ok, note) = {id: id, ok: ok, note: if ok == 1 then "" else note}
fn q_build(cfg, base, src) = let w = fs_write_sync(base + ".src", src) in let c = q_input(cfg.bin + "/lumec", Nil, base + ".src", base + ".s", 120000) in if c.status != 0 then {ok: 0, err: "lumec: " + c.err} else let a = q_run(cfg.bin + "/lasm", Cons("--strict", Cons(base + ".s", Nil)), base + ".elf", 120000) in if a.status != 0 then {ok: 0, err: "lasm: " + a.err} else let m = os_run("/bin/chmod", Cons("+x", Cons(base + ".elf", Nil))) in {ok: 1, err: ""}
fn q_argv(arg) = if arg == "" then Nil else Cons(arg, Nil)
fn q_do_run(cfg, p, base) = let b = q_build(cfg, base, p.src) in if b.ok == 0 then q_res(p.id, 0, b.err) else let r = q_run(base + ".elf", q_argv(p.arg), base + ".run", 60000) in q_res(p.id, if r.status == 0 and r.out == p.exp then 1 else 0, "status " + str(r.status) + " stdout " + r.out + r.err)
fn q_do_reject(cfg, p, base) = let w = fs_write_sync(base + ".src", p.src) in let c = q_input(cfg.bin + "/lumec", Nil, base + ".src", base + ".s", 120000) in q_res(p.id, if c.status != 0 and q_has(c.err, p.exp) == 1 and fs_read_byte(base + ".s", 0) < 0 then 1 else 0, "lumec status " + str(c.status) + ": " + c.err)
fn q_do_trap(cfg, p, base) = let b = q_build(cfg, base, p.src) in if b.ok == 0 then q_res(p.id, 0, b.err) else let r = q_run(base + ".elf", q_argv(p.arg), base + ".run", 60000) in q_res(p.id, if r.status != 0 and r.status < 128 and q_has(r.err, p.exp) == 1 then 1 else 0, "status " + str(r.status) + " stderr " + r.err)
fn q_do_env(cfg, p, base, setting, want_ok) = let b = q_build(cfg, base, p.src) in if b.ok == 0 then q_res(p.id, 0, b.err) else let r = q_run("/usr/bin/env", Cons(setting, Cons(base + ".elf", q_argv(p.arg))), base + ".run", 120000) in q_res(p.id, if want_ok == 1 then (if r.status == 0 and r.out == p.exp then 1 else 0) else (if r.status != 0 and r.status < 128 and q_has(r.err, p.exp) == 1 then 1 else 0), "status " + str(r.status) + " " + r.out + r.err)
fn q_proven(out, nm) = q_has(out, "\"name\":\"" + nm + "\",\"kind\":\"contract\",\"status\":\"proven\"")
fn q_do_prove(cfg, p, base, want) = let w = fs_write_sync(base + ".src", p.src) in let r = q_input(cfg.bin + "/lcaas", Nil, base + ".src", base + ".json", 120000) in q_res(p.id, if want == 1 then q_proven(r.out, p.arg) else (if q_proven(r.out, p.arg) == 0 and q_has(r.out, "\"status\":\"refuted\"") == 1 then 1 else 0), "lcaas: " + slice(r.out, 0, if count(r.out) > 500 then 500 else count(r.out)))
fn q_do_cert(cfg, p, base, tamper) = let rq = q_request(cfg.bin + "/lcaas", "@mode certify\n" + p.src, base + ".certify", 120000) in if rq.status != 0 or q_has(rq.out, "\"ok\":true") == 0 then q_res(p.id, 0, "lcaas certify: " + rq.out + rq.err) else let cert = if tamper == 1 then q_rep1(rq.out, p.arg, p.exp, 0) else rq.out in if tamper == 1 and cert == rq.out then q_res(p.id, 0, "the certificate has no '" + p.arg + "' to tamper with") else let v = q_request(cfg.bin + "/lcert", cert, base + ".verify", 120000) in q_res(p.id, if tamper == 0 then (if q_has(v.out, "\"ok\":true") == 1 and q_has(v.out, "\"kernel_verified\":true") == 1 then 1 else 0) else (if q_has(v.out, "\"ok\":false") == 1 then 1 else 0), "lcert: " + v.out)
fn q_split_at(s) = q_index(s, "=>", 0)
fn q_do_tv(cfg, p, base, mutate) = let w = fs_write_sync(base + ".src", p.src) in let c = q_input(cfg.bin + "/lumec", Nil, base + ".src", base + ".s", 120000) in if c.status != 0 then q_res(p.id, 0, "lumec: " + c.err) else let asm = fs_read_file(base + ".s") in let at0 = q_index(asm, "\n" + p.arg + ":\n", 0) in let k = q_split_at(p.exp) in let asm2 = if mutate == 1 then q_rep1(asm, slice(p.exp, 0, k), slice(p.exp, k + 2, count(p.exp)), at0) else asm in if mutate == 1 and asm2 == asm then q_res(p.id, 0, "the mutation site is not in the emitted assembly") else let w2 = fs_write_sync(base + ".m.s", asm2) in let v = q_request(cfg.bin + "/ltv", "@root " + cfg.root + "\n@src " + base + ".src\n@asm " + base + ".m.s\n@fn " + p.arg + "\n@out " + cfg.tmp + "/proofs\n", base + ".ltv", 120000) in q_res(p.id, if mutate == 0 then (if v.status == 0 and q_has(v.out, "\"status\":\"validated\"") == 1 then 1 else 0) else (if v.status != 0 and q_has(v.out, "\"status\":\"rejected\"") == 1 then 1 else 0), "ltv status " + str(v.status) + ": " + slice(v.out, 0, if count(v.out) > 600 then 600 else count(v.out)))
fn q_do_asm_bad(cfg, p, base) = let w = fs_write_sync(base + ".s", p.src) in let a = q_run(cfg.bin + "/lasm", Cons("--strict", Cons(base + ".s", Nil)), base + ".elf", 120000) in q_res(p.id, if a.status != 0 and q_has(a.err, p.exp) == 1 then 1 else 0, "lasm status " + str(a.status) + ": " + a.err)
fn q_do_adapt(cfg, p, base, want_ok) = let w = fs_write_sync(base + ".h", p.src) in let r = q_run(cfg.bin + "/lume_driver", Cons("adapt", Cons("c", Cons(base + ".h", Nil))), base + ".adapt", 120000) in q_res(p.id, if want_ok == 1 then (if r.status == 0 and q_has(r.out, p.exp) == 1 then 1 else 0) else (if r.status != 0 and q_has(r.out, "\"code\":\"" + p.exp + "\"") == 1 then 1 else 0), "adapt status " + str(r.status) + ": " + slice(r.out, 0, if count(r.out) > 400 then 400 else count(r.out)))
fn q_do_envelope(cfg, p, base, want_commit) = let w = fs_write_sync(base + ".src", p.src) in let extra = if want_commit == 1 then "@args " + p.exp + "\n" else "@args 700,500\n" + p.exp + "\n" in let r = q_request(cfg.bin + "/lsafety_envelope", "@root " + cfg.root + "\n@src " + base + ".src\n@fn " + p.arg + "\n" + extra + "@log " + base + ".events.jsonl\n@work " + cfg.tmp + "/envelope\n@reset 1\n", base + ".env", 300000) in q_res(p.id, if want_commit == 1 then (if r.status == 0 and q_has(r.out, "\"state\":\"VerifiedActuatorCommit\",\"value\":500") == 1 and q_has(r.out, "\"cert_ok\":1") == 1 then 1 else 0) else (if r.status != 0 and q_has(r.out, "\"state\":\"SAFE_STATE_TRIP\"") == 1 and q_has(r.out, "VerifiedActuatorCommit") == 0 then 1 else 0), "envelope status " + str(r.status) + ": " + slice(r.out, 0, if count(r.out) > 900 then 900 else count(r.out)) + r.err)
## The module rule of structural coverage, shared by q_module and by the P-MCDC probes: the report of a module of the
## MC/DC-qualified set (mcdc = 1: every certified module) passes only when lmcdc exited 0 (no witness disagrees with
## the real machine), at least one witness ran on the real binary, and NO obligation is uncovered.
fn q_mc_ok(status, out, mcdc) = if status == 0 and (mcdc == 0 or q_field(out, "uncovered") == 0) and q_field(out, "native_witnesses_agreeing") > 0 then 1 else 0
## spec: "field=value;field=value;" -- every named field of the lmcdc report must have exactly that value
fn q_mc_expect(out, spec, i) = if i >= count(spec) then 1 else let e = q_index(spec, "=", i) in let z = q_index(spec, ";", i) in if e < 0 or z < e then 0 else if q_field(out, slice(spec, i, e)) == toint(slice(spec, e + 1, z)) then q_mc_expect(out, spec, z + 1) else 0
## mode 1: fully covered, and the module rule accepts the report. mode 0: an infeasible or uncovered outcome is listed,
## not counted as covered. mode 2: an obligation is uncovered and the module rule REJECTS the report for that reason
## alone (the same report passes with mcdc = 0). mode 3: the classification counts are exactly those of p.exp, and
## the module rule rejects the report. mode 4: the counts are exactly those of p.exp, and the module rule accepts it.
fn q_do_mcdc(cfg, p, base, mode) = let w = fs_write_sync(base + ".src", p.src) in let r = q_request(cfg.bin + "/lmcdc", "@root " + cfg.root + "\n@src " + base + ".src\n@exec 1\n", base + ".mcdc", 300000) in q_res(p.id, if mode == 1 then (if r.status == 0 and q_field(r.out, "uncovered") == 0 and q_field(r.out, "obligations") > 0 and q_field(r.out, "native_witnesses_agreeing") > 0 and q_field(r.out, "native_contract_traps_confirmed") > 0 and q_mc_ok(r.status, r.out, 1) == 1 then 1 else 0) else if mode == 2 then (if r.status == 0 and q_field(r.out, "uncovered") > 0 and q_mc_ok(r.status, r.out, 1) == 0 and q_mc_ok(r.status, r.out, 0) == 1 then 1 else 0) else if mode == 3 then (if r.status == 0 and q_field(r.out, "native_witnesses_agreeing") > 0 and p.exp != "" and q_mc_expect(r.out, p.exp, 0) == 1 and q_mc_ok(r.status, r.out, 1) == 0 then 1 else 0) else if mode == 4 then (if r.status == 0 and p.exp != "" and q_mc_expect(r.out, p.exp, 0) == 1 and q_mc_ok(r.status, r.out, 1) == 1 then 1 else 0) else (if r.status == 0 and q_field(r.out, "uncovered") + q_field(r.out, "infeasible_proved_by_kernel") > 0 and q_field(r.out, "covered") < q_field(r.out, "obligations") then 1 else 0), "lmcdc status " + str(r.status) + ": " + slice(r.out, 0, if count(r.out) > 600 then 600 else count(r.out)))
## the frozen seed: every line of SEED_FREEZE.sha256 is `<sha256>  <path>`; the file on disk must hash to it
fn q_seed_lines(root, text, i, tamper, acc) = if i >= count(text) then acc else let e = q_line_end(text, i) in if e - i < 67 then q_seed_lines(root, text, e + 1, tamper, acc) else let want = slice(text, i, i + 64) in let path = slice(text, i + 66, e) in let got = if tamper == 1 and acc.n == 0 then lc_sha256(fs_read_file(root + "/" + path) + " ") else fs_sha256_file(root + "/" + path) in q_seed_lines(root, text, e + 1, tamper, {n: acc.n + 1, bad: acc.bad + (if got == want then 0 else 1)})
fn q_do_seed(cfg, p, tamper) = let r = q_seed_lines(cfg.root, fs_read_file(cfg.root + "/bootstrap/lume0/SEED_FREEZE.sha256"), 0, tamper, {n: 0, bad: 0}) in q_res(p.id, if tamper == 0 then (if r.n >= 10 and r.bad == 0 then 1 else 0) else (if r.bad == 1 then 1 else 0), "seed freeze: " + str(r.n) + " files, " + str(r.bad) + " mismatching")
## ltv must reject the function as compiled by the real lumec, for the stated reason
fn q_do_tv_reject(cfg, p, base) = let w = fs_write_sync(base + ".src", p.src) in let v = q_request(cfg.bin + "/ltv", "@root " + cfg.root + "\n@src " + base + ".src\n@fn " + p.arg + "\n@out " + cfg.tmp + "/proofs\n", base + ".ltv", 120000) in q_res(p.id, if v.status != 0 and q_has(v.out, "\"name\":\"" + p.arg + "\",\"status\":\"rejected\",\"reason\":\"" + p.exp) == 1 then 1 else 0, "ltv status " + str(v.status) + ": " + slice(v.out, 0, if count(v.out) > 600 then 600 else count(v.out)))
## `lumec --dwarf` + lasm: the program still runs and readelf decodes a line table that names the source file
fn q_do_dwarf(cfg, p, base) = let w = fs_write_sync(base + ".src", p.src) in let c = q_input(cfg.bin + "/lumec", Cons("--emit-asm", Cons("--dwarf", Cons(base + ".src", Cons(base + ".src", Nil)))), base + ".src", base + ".s", 120000) in if c.status != 0 then q_res(p.id, 0, "lumec --dwarf: " + c.err) else let a = q_run(cfg.bin + "/lasm", Cons("--strict", Cons(base + ".s", Nil)), base + ".elf", 120000) in if a.status != 0 then q_res(p.id, 0, "lasm: " + a.err) else let m = os_run("/bin/chmod", Cons("+x", Cons(base + ".elf", Nil))) in let r = q_run(base + ".elf", Nil, base + ".run", 60000) in let s = q_run("/usr/bin/readelf", Cons("--debug-dump=decodedline", Cons(base + ".elf", Nil)), base + ".lines", 60000) in q_res(p.id, if r.status == 0 and r.out == p.exp and q_has(c.out, ".loc 1 ") == 1 and s.status == 0 and q_has(s.out, p.id + ".src") == 1 then 1 else 0, "run status " + str(r.status) + " " + r.out + "; readelf status " + str(s.status) + ": " + slice(s.out, 0, if count(s.out) > 300 then 300 else count(s.out)) + s.err)
## the proof cache. mode 0: store then check, every function a hit; mode 1: one stored record overwritten, the check
## must refuse it; mode 2: a module with a false contract must not be stored at all
fn q_pc(cfg, cmd, src, dir, out) = q_run(cfg.bin + "/lproof_cache", Cons(cmd, Cons(src, Cons(dir, Nil))), out, 120000)
fn q_do_pcache(cfg, p, base, mode) = let w = fs_write_sync(base + ".src", p.src) in let dir = base + ".cache" in let clean = os_run("/bin/rm", Cons("-rf", Cons(dir, Nil))) in let st = q_pc(cfg, "store", base + ".src", dir, base + ".store") in if mode == 2 then q_res(p.id, if st.status != 0 and q_has(st.err, p.exp) == 1 and fs_path_exists(dir + "/proofs") == 0 then 1 else 0, "store status " + str(st.status) + ": " + st.out + st.err) else if st.status != 0 or q_field(st.out, "stored") < 1 then q_res(p.id, 0, "store status " + str(st.status) + ": " + st.out + st.err) else if mode == 0 then (let ck = q_pc(cfg, "check", base + ".src", dir, base + ".check") in q_res(p.id, if ck.status == 0 and q_has(ck.out, "\"all_cached\":true") == 1 and q_field(ck.out, "hits") >= 1 and q_field(ck.out, "hits") == q_field(ck.out, "total") and q_field(ck.out, "misses") == 0 then 1 else 0, "check status " + str(ck.status) + ": " + ck.out + ck.err)) else let ls = q_run("/bin/ls", Cons(dir + "/proofs", Nil), base + ".ls", 10000) in let first = slice(ls.out, 0, q_line_end(ls.out, 0)) in let tw = if first == "" then 0 else fs_write_sync(dir + "/proofs/" + first, "tampered=1\n") in let ck = q_pc(cfg, "check", base + ".src", dir, base + ".check") in q_res(p.id, if first != "" and ck.status != 0 and q_has(ck.err, p.exp) == 1 then 1 else 0, "check after overwriting " + first + ": status " + str(ck.status) + " " + ck.out + ck.err)
## the multi-ISA kernel back ends through the real ltarget binary: bytes for a kernel lumec accepts, a diagnostic and
## no bytes otherwise
fn q_do_target(cfg, p, base, want_ok) = let r = q_request(cfg.bin + "/ltarget", "@compile " + p.arg + "\n" + p.src, base + ".lt", 120000) in q_res(p.id, if want_ok == 1 then (if r.status == 0 and q_index(r.out, p.exp, 0) == 0 then 1 else 0) else (if q_index(r.out, p.exp, 0) == 0 and q_has(r.out, "HEX:") == 0 then 1 else 0), "ltarget status " + str(r.status) + ": " + slice(r.out, 0, if count(r.out) > 400 then 400 else count(r.out)) + r.err)
## a neural cartridge: the reply is a safetensors file (8 length bytes, then a JSON header) or a refusal
fn q_do_cart(cfg, p, base, want_ok) = let r = q_request(cfg.bin + "/lneural_cartridge", "@compile safetensors\n" + p.src, base + ".stn", 300000) in let head = slice(r.out, 0, if count(r.out) > 64 then 64 else count(r.out)) in q_res(p.id, if want_ok == 1 then (if r.status == 0 and q_index(r.out, "HEX:", 0) == 0 and q_has(head, "7b22") == 1 then 1 else 0) else (if q_index(r.out, "ERR:", 0) == 0 then 1 else 0), "lneural_cartridge status " + str(r.status) + ": " + head + r.err)
## the primitives that sign this evidence, run in this process: official vectors, then a signature made here that
## must stop verifying when the message, the signature or the key is altered
fn q_do_kat(p, want_ok) = if want_ok == 1 then (let k = lct_kat_join(lct_kat_sha256(), lct_kat_ed25519_quick()) in q_res(p.id, if k.err == "" and k.n == lct_kat_expected("sha256") + lct_kat_expected("ed25519_quick") then 1 else 0, "known-answer tests: " + str(k.n) + " passed; " + k.err)) else let seed = lct_sha256(lct_str_to_bytes("lqualify negative control seed")) in let pk = lct_ed25519_public_key(seed) in let msg = lct_str_to_bytes("qualification evidence") in let sig = lct_ed25519_sign(seed, msg) in let good = lct_ed25519_verify(pk, msg, sig) in let b1 = lct_ed25519_verify(pk, lct_str_to_bytes("qualification evidencf"), sig) in let b2 = lct_ed25519_verify(pk, msg, lct_flip(sig, 40, 1)) in let b3 = lct_ed25519_verify(lct_flip(pk, 5, 16), msg, sig) in q_res(p.id, if good == 1 and b1 == 0 and b2 == 0 and b3 == 0 then 1 else 0, "Ed25519 verify: genuine " + str(good) + ", altered message " + str(b1) + ", altered signature " + str(b2) + ", altered key " + str(b3))
## certificate-to-source binding: lcaas certifies p.src; `lcert --check-source` must bind every obligation to that
## file, and must refuse the same certificate against p.arg (a source that differs in one contract constant)
fn q_do_certsrc(cfg, p, base, want_ok) = let w = fs_write_sync(base + ".src", p.src) in let rq = q_request(cfg.bin + "/lcaas", "@mode certify\n" + p.src, base + ".certify", 120000) in if rq.status != 0 or q_has(rq.out, "\"ok\":true") == 0 then q_res(p.id, 0, "lcaas certify: " + rq.out + rq.err) else let other = fs_write_sync(base + ".other.src", p.arg) in let wc = fs_write_sync(base + ".cert.json", rq.out) in let v = q_input(cfg.bin + "/lcert", Cons("--check-source", Cons(if want_ok == 1 then base + ".src" else base + ".other.src", Nil)), base + ".cert.json", base + ".bind", 120000) in let plain = q_input(cfg.bin + "/lcert", Nil, base + ".cert.json", base + ".plain", 120000) in q_res(p.id, if want_ok == 1 then (if q_has(v.out, "\"ok\":true") == 1 and q_has(v.out, "\"checked\":true") == 1 and q_has(v.out, "\"unbound\":[]") == 1 then 1 else 0) else (if q_has(v.out, "\"ok\":false") == 1 and q_has(v.out, p.exp) == 1 and q_has(plain.out, "\"ok\":true") == 1 then 1 else 0), "lcert --check-source: " + slice(v.out, 0, if count(v.out) > 600 then 600 else count(v.out)) + v.err)
fn q_probe2(cfg, p, base) = if p.kind == "certsrc-ok" then q_do_certsrc(cfg, p, base, 1) else if p.kind == "certsrc-bad" then q_do_certsrc(cfg, p, base, 0) else if p.kind == "tv-reject" then q_do_tv_reject(cfg, p, base) else if p.kind == "dwarf-ok" then q_do_dwarf(cfg, p, base) else if p.kind == "pcache-ok" then q_do_pcache(cfg, p, base, 0) else if p.kind == "pcache-tamper" then q_do_pcache(cfg, p, base, 1) else if p.kind == "pcache-false" then q_do_pcache(cfg, p, base, 2) else if p.kind == "target-ok" then q_do_target(cfg, p, base, 1) else if p.kind == "target-bad" then q_do_target(cfg, p, base, 0) else if p.kind == "cart-ok" then q_do_cart(cfg, p, base, 1) else if p.kind == "cart-bad" then q_do_cart(cfg, p, base, 0) else if p.kind == "kat-ok" then q_do_kat(p, 1) else if p.kind == "kat-bad" then q_do_kat(p, 0) else q_probe3(cfg, p, base)
## --- Wave 14 probe kinds ---
fn q_find(text, part, i) = if i + count(part) > count(text) then 0 - 1 else if at(text, i) == at(part, 0) and slice(text, i, i + count(part)) == part then i else q_find(text, part, i + 1)
fn q_field_at(out, key, at0) = let i = q_index(out, "\"" + key + "\":", at0) in if i < 0 then 0 - 1 else let b = i + count(key) + 3 in let e = q_digits_end(out, b) in if e == b then 0 - 1 else q_num(out, b, e, 0)
fn q_clip(s, n) = if count(s) > n then slice(s, 0, n) else s
fn q_near(text, anchor, part, span) = let i = q_index(text, anchor, 0) in if i < 0 then 0 else q_has(slice(text, i, if i + span > count(text) then count(text) else i + span), part)
## the modules a tool binary was bundled from (`## --- module <name> ---` lines of build/bin/<tool>.bundled.src): the
## monitor channel's tool may link no compiler module; ltv, which does link the compiler, is the control of the scan
fn q_mods_at(b, i, acc) = let j = q_find(b, "## --- module ", i) in if j < 0 then acc else let e = q_line_end(b, j) in q_mods_at(b, e, acc + slice(b, j + 14, e - 4) + " ")
fn q_mods(cfg, tool) = q_mods_at(fs_read_file(cfg.bin + "/" + tool + ".bundled.src"), 0, " ")
fn q_do_indep(cfg, p) = let me = q_mods(cfg, "lsafety_envelope") in let tv = q_mods(cfg, "ltv") in q_res(p.id, if me != " " and q_has(me, " lumec ") == 0 and q_has(me, " lcaas ") == 0 and q_has(me, " lrv32_lowered ") == 0 and q_has(tv, " lumec ") == 1 then 1 else 0, "modules of the lsafety_envelope bundle:" + me + "; of the ltv bundle (control, must list lumec):" + q_clip(tv, 200))
## one injected fault (p.exp = `<injection>=><trip reason>`): the same request without the injection must commit
fn q_env_req(cfg, p, base, tag, extra) = q_request(cfg.bin + "/lsafety_envelope", "@root " + cfg.root + "\n@src " + base + ".src\n@fn " + p.arg + "\n@args 700,500\n" + extra + "@log " + base + "." + tag + ".jsonl\n@work " + cfg.tmp + "/envelope\n@reset 1\n", base + "." + tag, 300000)
fn q_do_env_inj(cfg, p, base) = let k = q_split_at(p.exp) in let inj = slice(p.exp, 0, k) in let reason = slice(p.exp, k + 2, count(p.exp)) in let w = fs_write_sync(base + ".src", p.src) in let c = q_env_req(cfg, p, base, "ctl", "") in let r = q_env_req(cfg, p, base, "inj", "@inject " + inj + "\n") in q_res(p.id, if c.status == 0 and q_has(c.out, "\"state\":\"VerifiedActuatorCommit\",\"value\":500") == 1 and r.status == 2 and q_has(r.out, "\"inject\":\"" + inj + "\"") == 1 and q_has(r.out, "\"state\":\"SAFE_STATE_TRIP\",\"value\":null") == 1 and q_has(r.out, "\"reason\":\"" + reason + "\"") == 1 and q_has(r.out, "VerifiedActuatorCommit") == 0 then 1 else 0, "control status " + str(c.status) + "; injected status " + str(r.status) + ": " + q_clip(r.out, 700) + r.err)
## the split bundle: export, re-hash against the manifest, one voted request on the in-tool monitor; the negative
## alters one digit of an artifact hash in the manifest
fn q_env_cli(cfg, base, tag, body) = q_request(cfg.bin + "/lsafety_envelope", "@root " + cfg.root + "\n" + body, base + "." + tag, 300000)
fn q_flip_digit(s, i) = if i < 0 or i >= count(s) then s else slice(s, 0, i) + (if at(s, i) == "0" then "1" else "0") + slice(s, i + 1, count(s))
fn q_do_split(cfg, p, base, want_ok) = let w = fs_write_sync(base + ".src", p.src) in let d = base + ".split" in let z = os_run("/bin/rm", Cons("-rf", Cons(d, Cons(base + ".split.jsonl", Nil)))) in let ex = q_env_cli(cfg, base, "spx", "@src " + base + ".src\n@fn " + p.arg + "\n@split " + d + "\n") in let vf = q_env_cli(cfg, base, "spv", "@mode split-verify\n@manifest " + d + "/manifest.json\n") in if ex.status != 0 or q_has(ex.out, "\"mode\":\"split-export\",\"ok\":true") == 0 or vf.status != 0 or q_has(vf.out, "\"mode\":\"split-verify\",\"ok\":true") == 0 then q_res(p.id, 0, "split export / verify: " + q_clip(ex.out, 300) + ex.err + q_clip(vf.out, 300) + vf.err) else if want_ok == 1 then (let k = q_split_at(p.exp) in let run = q_env_cli(cfg, base, "spr", "@mode split-run\n@manifest " + d + "/manifest.json\n@seq 1\n@args " + slice(p.exp, 0, k) + "\n@cmd_a " + d + "/channel_a_x86_64.elf\n@cmd_b lumeputer:" + d + "/channel_b_riscv_bare.bin\n@log " + base + ".split.jsonl\n@reset 1\n") in q_res(p.id, if run.status == 0 and q_has(run.out, "\"state\":\"VerifiedActuatorCommit\",\"value\":" + slice(p.exp, k + 2, count(p.exp)) + ",\"reason\":\"ok\"") == 1 then 1 else 0, "split-run status " + str(run.status) + ": " + q_clip(run.out, 600) + run.err)) else let man = fs_read_file(d + "/manifest.json") in let i = q_index(man, "\"channel_b_riscv_bare\":{", 0) in let j = if i < 0 then 0 - 1 else q_index(man, "\"sha256\":\"", i) in let m2 = q_flip_digit(man, if j < 0 then 0 - 1 else j + 10) in let w2 = fs_write_sync(d + "/manifest.json", m2) in let bad = q_env_cli(cfg, base, "spv2", "@mode split-verify\n@manifest " + d + "/manifest.json\n") in q_res(p.id, if m2 != man and bad.status == 2 and q_has(bad.out, "\"mode\":\"split-verify\",\"ok\":false") == 1 and q_has(bad.out, "channel_b_riscv_bare") == 1 then 1 else 0, "split-verify of an altered manifest: status " + str(bad.status) + ": " + q_clip(bad.out, 600) + bad.err)
## static stack bound. positive: the bound of p.arg is exactly p.exp bytes. negative: p.exp = `<asm>=><asm>` inserts a
## non-tail self call in the emitted text; lstack must give no bound (the unmodified text is the control)
fn q_do_stack(cfg, p, base, want_ok) = let w = fs_write_sync(base + ".src", p.src) in if want_ok == 1 then (let r = q_request(cfg.bin + "/lstack", "@root " + cfg.root + "\n@src " + base + ".src\n", base + ".stk", 120000) in let i = q_index(r.out, "\"name\":\"" + p.arg + "\",\"status\":\"bounded\"", 0) in q_res(p.id, if r.status == 0 and i >= 0 and q_field_at(r.out, "max_stack_bytes_proven_paths", i) == toint(p.exp) then 1 else 0, "lstack status " + str(r.status) + ", expected " + p.exp + " bytes for " + p.arg + ": " + q_clip(r.out, 500) + r.err)) else let c = q_input(cfg.bin + "/lumec", Nil, base + ".src", base + ".s", 120000) in if c.status != 0 then q_res(p.id, 0, "lumec: " + c.err) else let asm = fs_read_file(base + ".s") in let k = q_split_at(p.exp) in let asm2 = q_rep1(asm, slice(p.exp, 0, k), slice(p.exp, k + 2, count(p.exp)), 0) in let w2 = fs_write_sync(base + ".m.s", asm2) in let ctl = q_request(cfg.bin + "/lstack", "@root " + cfg.root + "\n@src " + base + ".src\n@asm " + base + ".s\n", base + ".stk0", 120000) in let r = q_request(cfg.bin + "/lstack", "@root " + cfg.root + "\n@src " + base + ".src\n@asm " + base + ".m.s\n", base + ".stk", 120000) in q_res(p.id, if asm2 != asm and ctl.status == 0 and r.status == 3 and q_has(r.out, "\"name\":\"" + p.arg + "\",\"status\":\"rejected\"") == 1 and q_has(r.out + r.err, "call cycle") == 1 then 1 else 0, "lstack control status " + str(ctl.status) + ", mutated status " + str(r.status) + ": " + q_clip(r.out, 500) + r.err)
## the runtime-helper verifier on the text lumec emitted for p.src; the negative inverts one test of helper p.arg
fn q_do_tvrt(cfg, p, base, want_ok) = let w = fs_write_sync(base + ".src", p.src) in let c = q_input(cfg.bin + "/lumec", Nil, base + ".src", base + ".s", 120000) in if c.status != 0 then q_res(p.id, 0, "lumec: " + c.err) else let asm = fs_read_file(base + ".s") in let k = q_split_at(p.exp) in let at0 = if want_ok == 1 then 0 else q_find(asm, "\n" + p.arg + ":\n", 0) in let asm2 = if want_ok == 1 or at0 < 0 then asm else q_rep1(asm, slice(p.exp, 0, k), slice(p.exp, k + 2, count(p.exp)), at0) in let w2 = fs_write_sync(base + ".m.s", asm2) in let r = q_request(cfg.bin + "/ltv_rt", "@asm " + base + ".m.s\n", base + ".rt", 300000) in q_res(p.id, if want_ok == 1 then (if r.status == 0 and q_has(r.out, "\"ok\":true") == 1 and q_field(r.out, "helpers_rejected") == 0 and q_field(r.out, "helpers") > 0 and q_field(r.out, "helpers_verified") == q_field(r.out, "helpers") then 1 else 0) else (if asm2 != asm and r.status != 0 and q_has(r.out, "\"ok\":false") == 1 and q_has(r.out, "\"rejections\":[{\"name\":\"" + p.arg + "\"") == 1 then 1 else 0), "ltv_rt status " + str(r.status) + ": " + q_clip(r.out, 500) + r.err)
## the native SMT-LIB checker on the certificate ltv writes for p.arg; the negative replaces the claim by p.exp
fn q_ls_smt(ls, i) = if i >= count(ls) then "" else let e = q_line_end(ls, i) in if e - i > 5 and slice(ls, e - 5, e) == ".smt2" then slice(ls, i, e) else q_ls_smt(ls, e + 1)
fn q_smt_claim() = "(assert (not (and (= trap_ast trap_x86) (=> (not trap_ast) (and ret_x86 (= val_ast val_x86))))))"
fn q_do_smt(cfg, p, base, want_ok) = let w = fs_write_sync(base + ".src", p.src) in let d = base + ".proofs" in let z = os_run("/bin/rm", Cons("-rf", Cons(d, Nil))) in let v = q_request(cfg.bin + "/ltv", "@root " + cfg.root + "\n@src " + base + ".src\n@fn " + p.arg + "\n@out " + d + "\n", base + ".ltv", 120000) in let ls = q_run("/bin/ls", Cons(d, Nil), base + ".ls", 10000) in let f = q_ls_smt(ls.out, 0) in if v.status != 0 or f == "" then q_res(p.id, 0, "ltv wrote no .smt2 certificate (status " + str(v.status) + "): " + q_clip(v.out, 400)) else let s0 = q_request(cfg.bin + "/lsmt", "@dir " + d + "\n", base + ".smt0", 120000) in let good = if s0.status == 0 and q_has(s0.out, "\"ok\":true") == 1 and q_field(s0.out, "files") == 1 and q_field(s0.out, "unsat") == 1 then 1 else 0 in if want_ok == 1 then q_res(p.id, good, "lsmt status " + str(s0.status) + ": " + q_clip(s0.out, 500) + s0.err) else let old = fs_read_file(d + "/" + f) in let neu = q_rep1(old, q_smt_claim(), p.exp, 0) in let w2 = fs_write_sync(d + "/" + f, neu) in let s1 = q_request(cfg.bin + "/lsmt", "@dir " + d + "\n", base + ".smt1", 120000) in q_res(p.id, if good == 1 and neu != old and s1.status != 0 and q_has(s1.out, "\"ok\":false") == 1 and q_field(s1.out, "unsat") == 0 and q_field(s1.out, "forged") == 1 then 1 else 0, "lsmt on the forged certificate: status " + str(s1.status) + ": " + q_clip(s1.out, 500) + s1.err)
## constant-time kernels: validated as such, and [C0010] closed over the call p.arg -> p.exp
fn q_do_ctk(cfg, p, base) = let w = fs_write_sync(base + ".src", p.src) in let v = q_request(cfg.bin + "/ltv", "@root " + cfg.root + "\n@src " + base + ".src\n@out " + cfg.tmp + "/proofs\n", base + ".ltv", 120000) in q_res(p.id, if v.status == 0 and q_field(v.out, "constant_time_kernels") == 2 and q_field(v.out, "constant_time_kernels_validated") == 2 and q_field(v.out, "rejected") == 0 and q_near(v.out, "\"name\":\"" + p.arg + "\",\"status\":\"validated\"", "\"secret\":true,\"constant_time_kernel\":true,\"ct_checked_transitively\":true,\"ct_callees_inspected\":[\"" + p.exp + "\"]", 500) == 1 then 1 else 0, "ltv status " + str(v.status) + ": " + q_clip(v.out, 700))
## a contract the prover must NOT report proven and must leave as a run-time check
fn q_do_unproven(cfg, p, base) = let w = fs_write_sync(base + ".src", p.src) in let r = q_input(cfg.bin + "/lcaas", Nil, base + ".src", base + ".json", 120000) in q_res(p.id, if q_proven(r.out, p.arg) == 0 and q_has(r.out, "\"name\":\"" + p.arg + "\",\"kind\":\"contract\",\"status\":\"runtime_checked\"") == 1 then 1 else 0, "lcaas: " + q_clip(r.out, 500))
## lumec with one flag (p.arg) must refuse p.src with p.exp and emit nothing
fn q_do_reject_flag(cfg, p, base) = let w = fs_write_sync(base + ".src", p.src) in let c = q_input(cfg.bin + "/lumec", Cons(p.arg, Nil), base + ".src", base + ".s", 120000) in q_res(p.id, if c.status != 0 and q_has(c.err, p.exp) == 1 and fs_read_byte(base + ".s", 0) < 0 then 1 else 0, "lumec " + p.arg + " status " + str(c.status) + ": " + c.err)
## the chain of hashes between the tools: the certificate (lcaas), the binding (lcert --check-source) and the
## translation validation (ltv, on the text lumec emitted) must name ONE source and ONE assembly. The negative gives
## the certificate and the assembly of p.src to the tools together with p.exp, a source that differs in one constant
fn q_do_chain(cfg, p, base, want_ok) = let w = fs_write_sync(base + ".src", p.src) in let w1 = fs_write_sync(base + ".other.src", if want_ok == 1 then p.src else p.exp) in let rq = q_request(cfg.bin + "/lcaas", "@mode certify\n" + p.src, base + ".certify", 120000) in let wc = fs_write_sync(base + ".cert.json", rq.out) in let c = q_input(cfg.bin + "/lumec", Nil, base + ".src", base + ".s", 120000) in if rq.status != 0 or q_has(rq.out, "\"ok\":true") == 0 or c.status != 0 then q_res(p.id, 0, "lcaas certify / lumec: " + q_clip(rq.out, 300) + rq.err + c.err) else let v = q_input(cfg.bin + "/lcert", Cons("--check-source", Cons(base + ".other.src", Nil)), base + ".cert.json", base + ".bind", 120000) in let tv = q_request(cfg.bin + "/ltv", "@root " + cfg.root + "\n@src " + base + ".other.src\n@asm " + base + ".s\n@out " + cfg.tmp + "/proofs\n", base + ".ltv", 120000) in let same_src = if "sha256:" + q_jstr(tv.out, "source_sha256") == q_jstr(rq.out, "source_hash") then 1 else 0 in let same_asm = if q_jstr(tv.out, "asm_sha256") == fs_sha256_file(base + ".s") and q_jstr(tv.out, "asm_sha256") != "" then 1 else 0 in q_res(p.id, if want_ok == 1 then (if q_has(v.out, "\"ok\":true") == 1 and q_has(v.out, "\"unbound\":[]") == 1 and tv.status == 0 and q_has(tv.out, "\"name\":\"" + p.arg + "\",\"status\":\"validated\"") == 1 and same_src == 1 and same_asm == 1 then 1 else 0) else (if q_has(v.out, "\"ok\":false") == 1 and q_has(v.out, "K0010") == 1 and same_src == 0 and same_asm == 1 then 1 else 0), "lcert: " + q_clip(v.out, 300) + "; ltv status " + str(tv.status) + ", same source " + str(same_src) + ", same assembly " + str(same_asm))
## the driver: it answers its version and lists its commands; an unknown command is an error, not a silent success
fn q_do_cli(cfg, p, base, want_ok) = if want_ok == 1 then (let v = q_run(cfg.bin + "/lume_driver", Cons("--version", Nil), base + ".ver", 60000) in let h = q_run(cfg.bin + "/lume_driver", Cons("help", Cons("--json", Nil)), base + ".help", 60000) in q_res(p.id, if v.status == 0 and q_index(v.out, "lume " + q_chomp(fs_read_file(cfg.root + "/VERSION")), 0) == 0 and h.status == 0 and q_has(h.out, "qualify") == 1 and q_has(h.out, "verify-cert") == 1 and q_has(h.out, "safety-envelope") == 1 then 1 else 0, "lume --version: " + v.out + v.err + "; help --json status " + str(h.status))) else let r = q_run(cfg.bin + "/lume_driver", Cons(p.arg, Nil), base + ".bad", 60000) in q_res(p.id, if r.status != 0 and q_has(r.out + r.err, p.exp) == 1 then 1 else 0, "lume " + p.arg + ": status " + str(r.status) + " " + q_clip(r.out + r.err, 300))
## the proof service: a JSON verdict for a valid program, and the compiler's diagnostic (not an abort) for an invalid one
fn q_do_caas(cfg, p, base, want_ok) = let r = q_request(cfg.bin + "/lcaas", "@mode check\n" + p.src, base + ".caas", 60000) in q_res(p.id, if want_ok == 1 then (if r.status == 0 and q_index(r.out, "{\"ok\":true,\"diagnostics\":[]", 0) == 0 then 1 else 0) else (if q_index(r.out, "{\"ok\":false,\"diagnostics\":[{\"code\":\"" + p.exp + "\"", 0) == 0 then 1 else 0), "lcaas @mode check status " + str(r.status) + ": " + q_clip(r.out, 400) + r.err)
## X.509 path validation and the entropy health check, run in this process (lcrypto_tls is linked in: it signs the
## evidence). The chain leaf <- intermediate <- root is the library's fixed test chain (made with OpenSSL); `own` is a
## certificate this tool builds itself with q_cert_make
fn q_x_now() = 1794398400
fn q_x_chain() = Cons(lct_x509v_leaf(), Cons(lct_x509v_inter(), Nil))
fn q_x_anchors() = Cons(lct_x509_anchor_cert(lct_x509v_root()), Nil)
fn q_x_refused(r) = if r.ok == 0 and r.err != 0 and lct_len(r.leaf_key) == 0 then 1 else 0
fn q_do_x509(p, want_ok) = let seed = lct_sha256(lct_str_to_bytes("lqualify x509 probe seed")) in let mine = q_cert_make(seed) in let pkhex = lct_bytes_to_hex(lct_ed25519_public_key(seed)) in if want_ok == 1 then (let r = lct_x509_verify_chain(q_x_chain(), q_x_anchors(), q_x_now()) in let s = q_cert_check(mine, pkhex, q_cert_nb() + 86400) in q_res(p.id, if r.ok == 1 and r.depth == 2 and lct_len(r.leaf_key) == 32 and s.ok == 1 then 1 else 0, "library chain: " + lct_x509_err_name(r.err) + "; own certificate: " + s.why)) else let leaf = lct_x509v_leaf() in let a = lct_x509_verify_chain(Cons(lct_flip(leaf, lct_len(leaf) - 1, 1), Cons(lct_x509v_inter(), Nil)), q_x_anchors(), q_x_now()) in let b = lct_x509_verify_chain(q_x_chain(), q_x_anchors(), 1893456000) in let c = lct_x509_verify_chain(q_x_chain(), Cons(lct_x509_anchor_cert(lct_x509v_selfleaf()), Nil), q_x_now()) in let d = q_cert_check(lct_flip(mine, lct_len(mine) - 1, 1), pkhex, q_cert_nb() + 86400) in let e = q_cert_check(mine, lct_bytes_to_hex(lct_ed25519_public_key(lct_sha256(seed))), q_cert_nb() + 86400) in let f = q_cert_check(mine, pkhex, q_cert_na() + 1) in q_res(p.id, if q_x_refused(a) == 1 and a.err == 50 and q_x_refused(b) == 1 and b.err == 43 and q_x_refused(c) == 1 and c.err == 51 and d.ok == 0 and e.ok == 0 and f.ok == 0 then 1 else 0, "forged leaf signature: " + str(a.err) + " (want 50), expired: " + str(b.err) + " (want 43), other anchor: " + str(c.err) + " (want 51); own certificate altered / other key / after notAfter accepted: " + str(d.ok) + " " + str(e.ok) + " " + str(f.ok))
fn q_do_entropy(p, want_ok) = if want_ok == 1 then (let r = lct_random_bytes_checked(512) in let k = lct_ed25519_keygen() in q_res(p.id, if r.ok == 1 and lct_len(r.bytes) == 512 and lct_entropy_check(r.bytes, 512) == 0 and k.ok == 1 and lct_len(k.seed) == 32 and lct_len(k.pk) == 32 then 1 else 0, "checked draw: ok " + str(r.ok) + ", defect " + lct_entropy_err_name(r.err) + "; keygen ok " + str(k.ok))) else let r = lct_random_bytes_checked(512) in let z = lct_entropy_check(lct_zeros(512), 512) in let s = lct_entropy_check(lct_repeat(165, 512, Nil), 512) in let sh = lct_entropy_check(lct_zeros(100), 512) in let rep = if r.ok == 1 then lct_entropy_check2(r.bytes, r.bytes, 512) else 0 - 1 in q_res(p.id, if z == 2 and s == 3 and sh == 1 and rep == 6 then 1 else 0, "all-zero block: " + str(z) + " (want 2), constant block: " + str(s) + " (want 3), short read: " + str(sh) + " (want 1), repeated read: " + str(rep) + " (want 6)")
fn q_probe3(cfg, p, base) = if p.kind == "env-indep" then q_do_indep(cfg, p) else if p.kind == "env-inj" then q_do_env_inj(cfg, p, base) else if p.kind == "split-ok" then q_do_split(cfg, p, base, 1) else if p.kind == "split-bad" then q_do_split(cfg, p, base, 0) else if p.kind == "stack-ok" then q_do_stack(cfg, p, base, 1) else if p.kind == "stack-bad" then q_do_stack(cfg, p, base, 0) else if p.kind == "tvrt-ok" then q_do_tvrt(cfg, p, base, 1) else if p.kind == "tvrt-bad" then q_do_tvrt(cfg, p, base, 0) else if p.kind == "smt-ok" then q_do_smt(cfg, p, base, 1) else if p.kind == "smt-bad" then q_do_smt(cfg, p, base, 0) else if p.kind == "ctk-ok" then q_do_ctk(cfg, p, base) else if p.kind == "unproven" then q_do_unproven(cfg, p, base) else if p.kind == "reject-flag" then q_do_reject_flag(cfg, p, base) else if p.kind == "chain-ok" then q_do_chain(cfg, p, base, 1) else if p.kind == "chain-bad" then q_do_chain(cfg, p, base, 0) else if p.kind == "cli-ok" then q_do_cli(cfg, p, base, 1) else if p.kind == "cli-bad" then q_do_cli(cfg, p, base, 0) else if p.kind == "caas-ok" then q_do_caas(cfg, p, base, 1) else if p.kind == "caas-bad" then q_do_caas(cfg, p, base, 0) else if p.kind == "x509-ok" then q_do_x509(p, 1) else if p.kind == "x509-bad" then q_do_x509(p, 0) else if p.kind == "entropy-ok" then q_do_entropy(p, 1) else if p.kind == "entropy-bad" then q_do_entropy(p, 0) else q_res(p.id, 0, "unknown probe kind " + p.kind)
fn q_probe(cfg, p) = let base = cfg.tmp + "/" + p.id in if p.kind == "run" then q_do_run(cfg, p, base) else if p.kind == "reject" then q_do_reject(cfg, p, base) else if p.kind == "trap" then q_do_trap(cfg, p, base) else if p.kind == "gc-ok" then q_do_env(cfg, p, base, "LUME_GC_STRESS=3", 1) else if p.kind == "oom" then q_do_env(cfg, p, base, "LUME_HEAP_CAP=1048576", 0) else if p.kind == "proven" then q_do_prove(cfg, p, base, 1) else if p.kind == "notproven" then q_do_prove(cfg, p, base, 0) else if p.kind == "cert-ok" then q_do_cert(cfg, p, base, 0) else if p.kind == "cert-bad" then q_do_cert(cfg, p, base, 1) else if p.kind == "tv-ok" then q_do_tv(cfg, p, base, 0) else if p.kind == "tv-bad" then q_do_tv(cfg, p, base, 1) else if p.kind == "asm-bad" then q_do_asm_bad(cfg, p, base) else if p.kind == "adapt-ok" then q_do_adapt(cfg, p, base, 1) else if p.kind == "adapt-bad" then q_do_adapt(cfg, p, base, 0) else if p.kind == "env-ok" then q_do_envelope(cfg, p, base, 1) else if p.kind == "env-bad" then q_do_envelope(cfg, p, base, 0) else if p.kind == "mcdc-ok" then q_do_mcdc(cfg, p, base, 1) else if p.kind == "mcdc-gap" then q_do_mcdc(cfg, p, base, 0) else if p.kind == "mcdc-fail" then q_do_mcdc(cfg, p, base, 2) else if p.kind == "mcdc-exact" then q_do_mcdc(cfg, p, base, 3) else if p.kind == "mcdc-exact-ok" then q_do_mcdc(cfg, p, base, 4) else if p.kind == "seed-ok" then q_do_seed(cfg, p, 0) else if p.kind == "seed-bad" then q_do_seed(cfg, p, 1) else q_probe2(cfg, p, base)
fn q_run_probes(cfg, ps) = match ps
    Nil        => Nil
    Cons(p, t) => Cons(q_probe(cfg, p), q_run_probes(cfg, t))
fn q_res_ok(rs, id) = match rs
    Nil        => 0 - 1
    Cons(r, t) => if r.id == id then r.ok else q_res_ok(t, id)

## --- gates: {id, title, bin, args, extra stdin lines, need}; a gate passes when its binary exits 0 and its output
##     carries the text `need` ---
fn q_g(id, title, bin, args, extra, need) = {id: id, title: title, bin: bin, args: args, extra: extra, need: need}
fn q_gates_b() = Cons(q_g("G-DWARF-CACHE", "DWARF v4 line tables read back by readelf and addr2line; incremental proof cache: warm hits under 30 ms, invalidation, tamper and false-theorem refusal", "dwarf_cache_gate", Nil, "", "proof-cache verified"), Cons(q_g("G-CONC", "linear concurrency: [E0305] use-after-send and [E0306] lock-rank / wait-cycle rejections, deterministic multi-worker runs", "concurrency_gate", Nil, "", "OK: concurrency gate"), Cons(q_g("G-CRYPTO", "cryptography and TLS 1.3: official vectors, forged tag / signature / record / handshake rejections", "crypto_tls_gate", Nil, "", "OK: crypto/TLS gate"), Cons(q_g("G-MARCH", "AArch64 / RV64 / RV32 kernel back ends: official encodings, qemu and LumePuter execution equivalence, translation validation and mutants, lumec front end before lowering", "multi_arch_gate", Nil, "", "OK: multi-arch gate"), Cons(q_g("G-SAFETENSORS", "neural cartridges: .safetensors written and read back, forward pass == native == LumePuter, tampered files rejected", "safetensors_gate", Nil, "", "OK:"), Cons(q_g("G-REALTIME", "hard real-time options: [E0210] `@no_alloc` rejections, zero allocations measured on the accepted kernels, --keep-proven-checks keeps the checks of proven contracts, static worst-case stack bytes (lstack) equal to the painted high-water mark, latency jitter, constant-time kernel rules", "realtime_gate", Nil, "", "OK: realtime gate"), Cons(q_g("G-CERTSRC", "certificate-to-source binding: forged, re-hashed certificates that the plain kernel accepts are refused by lcert --check-source", "cert_source_gate", Nil, "", "OK: cert_source_gate"), Nil)))))))
fn q_gates(quick) = q_app(q_gates_a(quick), q_app(q_gates_b(), q_gates_c()))
## Wave 14 gates. G-SMT requires the external solver whenever one is installed (`@require_z3 1`); the evidence records
## whether it ran (q_gate_more). G-SYNERGY is the end-to-end chain with its cross-module tamper matrix.
fn q_gates_c() = Cons(q_g("G-TVRT", "runtime-helper verifier: every integer helper of the emitted runtime verified by ltv_rt, every behaviour-changing mutant of a helper rejected", "tv_rt_gate", Nil, "", "unsound acceptances: 0"), Cons(q_g("G-SMT", "SMT-LIB certificates: every .smt2 that ltv exports is `unsat` for the native checker lsmt (and for the external solver when one is installed); no forged or sat mutant accepted", "smt_cert_gate", Nil, if fs_path_exists("/usr/bin/z3") == 1 then "@require_z3 1\n" else "", "{\"ok\":true,\"gate\":\"smt_cert\""), Cons(q_g("G-SCALE", "proof service complexity: no mode of lcaas adds a term of higher degree to the run time of the compiler alone", "lcaas_scale_gate", Nil, "", "lcaas scale gate ok: "), Cons(q_g("G-SYNERGY", "cross-module synergy: one kernel module through prove, proof-cache, certify, verify-cert, stack, build --critical -g, tv / tv-rt / smt-check, mcdc, safety-envelope (split bundle, three instruction sets, cartridge), signed manifest under an X.509 chain, boundary contract; every row of the tamper matrix refused by the downstream tool", "synergy_gate", Nil, "", "OK: synergy gate: stages:"), Cons(q_g("G-CLI", "driver acceptance and CLI parity: every announced command is dispatched; help, manuals, README and SKILL agree with the dispatch table", "native_driver_gate", Nil, "", "cli_parity_gate passed"), Nil)))))
## The source a gate binary is built from when build/bin/<gate> is absent, what a gate needs besides its own binary
## (tool binaries, built from compiler/stage1/<name>.src when absent; emulators as absolute paths, which are never
## built: a missing one FAILS the gate), and the machine-readable files a gate writes under build/certification/.
## Those files are deleted before the gate runs and hashed after it: the SHA-256 goes into the `gates` section of the
## evidence, which is a link of the hash chain, so the signature covers them. A listed file that the gate did not
## write fails the gate.
fn q_gate_src(root, bin) = if bin == "native_driver_gate" then "tests/cli/driver_gate.src" else if fs_path_exists(root + "/tests/harness/" + bin + ".src") == 1 then "tests/harness/" + bin + ".src" else ""
fn q_emulators() = q_s3("/usr/bin/qemu-system-riscv32", "/usr/bin/qemu-aarch64", "/usr/bin/qemu-riscv64")
fn q_gate_deps(id) = if id == "G-REALTIME" then q_s2("lstack", "lcaas") else if id == "G-MARCH" then q_app(q_s2("lsafety_envelope", "ltarget"), q_emulators()) else if id == "G-ENV" then q_s2("lsafety_envelope", "ltv") else if id == "G-TVRT" then q_s1("ltv_rt") else if id == "G-SMT" then q_s2("lsmt", "ltv") else if id == "G-SCALE" then q_s1("lcaas") else if id == "G-SYNERGY" then q_app(q_s5("lcaas", "lcert", "lproof_cache", "lstack", "ltv"), q_app(q_s5("ltv_rt", "lsmt", "lmcdc", "lsafety_envelope", "lneural_cartridge"), q_emulators())) else if id == "G-CLI" then q_app(q_s5("lcli", "lmod", "lprotect", "ltarget", "lcaas"), q_app(q_s5("lcert", "lfmt", "ltest", "lmesh", "ldoc"), q_s5("leconomy", "levolve", "lsha", "lregistry", "lchameleon"))) else Nil
fn q_gate_sums(id) = if id == "G-ENV" then q_s1("safety_envelope_gate_summary.json") else if id == "G-REALTIME" then q_s1("realtime_gate_summary.json") else if id == "G-SYNERGY" then q_s3("synergy_gate_summary.json", "synergy_gate_evidence.manifest", "synergy_gate_evidence.sig.json") else if id == "G-TVRT" then q_s1("tv_rt_gate_accepted_same_behaviour.txt") else Nil
fn q_build_bin(cfg, name, src) = if src == "" or fs_path_exists(cfg.root + "/" + src) == 0 then "build/bin/" + name + " is not built and there is no source to build it from; " else let r = q_run(cfg.bin + "/lume_driver", Cons("build", Cons(cfg.root + "/" + src, Cons("-o", Cons(cfg.bin + "/" + name, Nil)))), cfg.tmp + "/build_" + name, 3600000) in if r.status == 0 and fs_path_exists(cfg.bin + "/" + name) == 1 then "" else "build/bin/" + name + " could not be built from " + src + " (status " + str(r.status) + "): " + q_clip(r.out + r.err, 300) + "; "
fn q_ensure(cfg, name) = if at(name, 0) == "/" then (if fs_path_exists(name) == 1 then "" else name + " is not installed; ") else if fs_path_exists(cfg.bin + "/" + name) == 1 then "" else q_build_bin(cfg, name, "compiler/stage1/" + name + ".src")
fn q_ensure_all(cfg, ns) = match ns
    Nil        => ""
    Cons(h, t) => q_ensure(cfg, h) + q_ensure_all(cfg, t)
fn q_sums_rm(cfg, fs) = match fs
    Nil        => 0
    Cons(h, t) => os_run("/bin/rm", Cons("-f", Cons(cfg.root + "/build/certification/" + h, Nil))) + q_sums_rm(cfg, t)
fn q_sums_have(cfg, fs) = match fs
    Nil        => 1
    Cons(h, t) => if fs_path_exists(cfg.root + "/build/certification/" + h) == 1 then q_sums_have(cfg, t) else 0
fn q_sums_json(cfg, fs) = match fs
    Nil        => ""
    Cons(h, t) => "{\"file\":\"build/certification/" + h + "\",\"sha256\":\"" + (if fs_path_exists(cfg.root + "/build/certification/" + h) == 1 then fs_sha256_file(cfg.root + "/build/certification/" + h) else "") + "\"}" + (if q_len(t) == 0 then "" else ",") + q_sums_json(cfg, t)
## extra evidence fields of a gate: for G-SMT, which external solver the gate found and whether it ran
fn q_gate_more(id, out) = if id == "G-SMT" then ",\"external_solver\":\"" + q_jesc(q_jstr(out, "external_solver")) + "\",\"external_solver_ran\":" + (if q_has(out, "\"external_solver_ran\":true") == 1 then "true" else "false") else ""
fn q_gate(cfg, g) = let bin = cfg.bin + "/" + g.bin in let pre = q_ensure_all(cfg, q_gate_deps(g.id)) + (if fs_path_exists(bin) == 1 then "" else q_build_bin(cfg, g.bin, q_gate_src(cfg.root, g.bin))) in if pre != "" then {id: g.id, title: g.title, ok: 0, status: 127, ms: 0, line: "not run: " + pre, sha: "", sums: "", more: ""} else let base = cfg.tmp + "/" + g.id in let z = q_sums_rm(cfg, q_gate_sums(g.id)) in let w = fs_write_sync(base + ".in", "@root " + cfg.root + "\n" + g.extra) in let r = q_input(bin, g.args, base + ".in", base + ".out", 14400000) in let have = q_sums_have(cfg, q_gate_sums(g.id)) in {id: g.id, title: g.title, ok: if r.status == 0 and q_has(r.out, g.need) == 1 and have == 1 then 1 else 0, status: r.status, ms: r.ms, line: q_last_line(if r.status == 0 then r.out else r.out + r.err) + (if have == 1 then "" else " [the gate did not write its summary file under build/certification]"), sha: fs_sha256_file(bin), sums: q_sums_json(cfg, q_gate_sums(g.id)), more: q_gate_more(g.id, r.out)}
fn q_gates_a(quick) = Cons(q_g("G-BOOT", "self-hosting fixpoint: stage 2 == stage 3 bit for bit (lume_make bootstrap)", "lume_make", Cons("bootstrap", Nil), "", "stage 2 == stage 3"), Cons(q_g("G-TESTS", "native conformance suite (lume_make test)", "lume_make", Cons("test", Nil), "", "PASS"), Cons(q_g("G-SELFPROVE", "domain proof batteries (lume self-prove --json)", "lume_driver", Cons("self-prove", Cons("--json", Nil)), "", "\"ok\":true"), Cons(q_g("G-LASM", "lasm against GNU as: byte-identical encodings, invalid lines rejected", "lasm_gate", Nil, "", "byte-identical"), Cons(q_g("G-PFUZZ", "false-theorem fuzzer: lumec, lcaas and the lcert kernel prove no false contract", "prover_fuzz_gate", Nil, if quick == 1 then "@n 20\n@seed 20261110\n" else "@n 120\n@seed 20261110\n", "OK:"), Cons(q_g("G-TV", "codegen mutation gate: ltv rejects every behaviour-changing assembly mutant", "tv_gate", Nil, if quick == 1 then "@stride 25\n" else "", "0 unsound acceptances"), Cons(q_g("G-SOAK", "soak battle: collector stress, OS fault injection, concurrent determinism, telemetry ledger", "soak_battle_gate", Nil, if quick == 1 then "@rounds 1\n" else "", "OK:"), Cons(q_g("G-ENV", "lockstep safety envelope: RV32IM known answers, clean-room channel B (no compiler function in its tool), cross-detection matrix of front-end and code-generator mutants, split bundle frames, fault injection, zero false negatives", "safety_envelope_gate", Nil, "", "0 false negatives"), Cons(q_g("G-AUDIT", "audit gate: 4-way differential fuzzer, mutation kills, seed-vs-self diverse double compilation", "claude_audit_gate", Nil, "", "OK:"), Nil)))))))))
fn q_run_gates(cfg, gs) = match gs
    Nil        => Nil
    Cons(g, t) => Cons(q_gate(cfg, g), q_run_gates(cfg, t))
fn q_skip_gates(gs) = match gs
    Nil        => Nil
    Cons(g, t) => Cons({id: g.id, title: g.title, ok: 0, status: 0 - 1, ms: 0, line: "not run (@skip-gates)", sha: "", sums: "", more: ""}, q_skip_gates(t))
fn q_gate_ok(rs, id) = match rs
    Nil        => 0 - 1
    Cons(r, t) => if r.id == id then r.ok else q_gate_ok(t, id)

## --- module batteries: translation validation, coverage and proof status of the certified modules ---
## mcdc = 1: the module belongs to the MC/DC-qualified set and may have no uncovered obligation (q_mc_ok). All four
## certified modules are in the set: one uncovered obligation in any of them fails the module and the qualification.
fn q_m(path, mcdc) = {path: path, mcdc: mcdc}
fn q_modules() = Cons(q_m("compiler/stage1/lstd.src", 1), Cons(q_m("examples/safety_envelope/critical_kernels.src", 1), Cons(q_m("compiler/stage1/lchameleon.src", 1), Cons(q_m("compiler/stage1/lsentience.src", 1), Nil))))
fn q_module(cfg, m, k) = let base = cfg.tmp + "/M" + str(k) in let src = cfg.root + "/" + m.path in let b = q_run(cfg.bin + "/lume_driver", Cons("bundle", Cons(src, Nil)), base + ".bundle", 600000) in let bundled = q_chomp(b.out) in if b.status != 0 or fs_path_exists(bundled) == 0 then {path: m.path, mcdc: m.mcdc, ok: 0, note: "cannot bundle: " + b.out + b.err, sha: "", tv: "", mc: "", proven: 0, budget: 0, runtime: 0, refuted: 0, tv_ms: 0, mc_ms: 0, pr_ms: 0} else let tv = q_request(cfg.bin + "/ltv", "@root " + cfg.root + "\n@src " + bundled + "\n@exec 1\n", base + ".tv", 3600000) in let mc = q_request(cfg.bin + "/lmcdc", "@root " + cfg.root + "\n@src " + bundled + "\n@exec 1\n", base + ".mcdc", 3600000) in let pr = q_input(cfg.bin + "/lcaas", Nil, bundled, base + ".prove", 3600000) in let runtime = q_count(pr.out, "\"status\":\"runtime_checked\"", 0, 0) in let refuted = q_count(pr.out, "\"status\":\"refuted\"", 0, 0) in let tv_ok = if tv.status == 0 and q_field(tv.out, "rejected") == 0 and q_field(tv.out, "validated") > 0 and q_field(tv.out, "native_vectors") > 0 and q_tvint_ok(tv.out) == 1 then 1 else 0 in let mc_ok = q_mc_ok(mc.status, mc.out, m.mcdc) in let pr_ok = if pr.status == 0 and runtime == 0 and refuted == 0 and q_count(pr.out, "\"status\":\"proven\"", 0, 0) > 0 then 1 else 0 in {path: m.path, mcdc: m.mcdc, ok: if tv_ok == 1 and mc_ok == 1 and pr_ok == 1 then 1 else 0, note: (if tv_ok == 0 then "translation validation failed: " + slice(tv.out, 0, if count(tv.out) > 400 then 400 else count(tv.out)) + tv.err + " " else "") + (if mc_ok == 0 then "coverage failed: " + slice(mc.out, 0, if count(mc.out) > 400 then 400 else count(mc.out)) + mc.err + " " else "") + (if pr_ok == 0 then "proof status: " + str(runtime) + " runtime_checked, " + str(refuted) + " refuted, lcaas status " + str(pr.status) else ""), sha: fs_sha256_file(src), tv: tv.out, mc: mc.out, proven: q_count(pr.out, "\"status\":\"proven\"", 0, 0), budget: q_count(pr.out, "\"status\":\"budget_checked\"", 0, 0), runtime: runtime, refuted: refuted, tv_ms: tv.ms, mc_ms: mc.ms, pr_ms: pr.ms}
fn q_run_modules(cfg, ms, k) = match ms
    Nil        => Nil
    Cons(m, t) => Cons(q_module(cfg, m, k), q_run_modules(cfg, t, k + 1))
fn q_mods_ok(ms) = match ms
    Nil        => 1
    Cons(m, t) => if m.ok == 1 then q_mods_ok(t) else 0
fn q_mods_sum(ms, key) = match ms
    Nil        => 0
    Cons(m, t) => (if key == "proven" then m.proven else if key == "budget" then m.budget else if key == "runtime" then m.runtime else if key == "refuted" then m.refuted else if q_has(key, "mc:") == 1 then q_field(m.mc, slice(key, 3, count(key))) else q_field(m.tv, key)) + q_mods_sum(t, key)

## --- requirements. HLR: {id, text}. LLR: {id, title, hlrs, files, pos, neg, ev} ---
fn q_h(id, text) = {id: id, text: text}
fn q_hlrs() = Cons(q_h("HLR-01", "The tool chain shall not produce object code whose behaviour differs from the semantics of its source without that being detected before the code is used."), Cons(q_h("HLR-02", "No contract shall be reported as proven unless it holds; a contract that is not proven shall stay checked at run time or stop the build (fail-closed)."), Cons(q_h("HLR-03", "Isolation properties stated in the source shall be enforced at compile time: pure code performs no I/O, secret data does not steer control flow, foreign data enters as unverified."), Cons(q_h("HLR-04", "Generated programs shall be memory safe: no use of a moved or freed value, and heap integrity independent of when the collector runs."), Cons(q_h("HLR-05", "Every failure of a generated program (arithmetic overflow, division by zero, contract violation, resource exhaustion, exceeded cycle budget) shall be a diagnosed stop, never a silent wrong value."), Cons(q_h("HLR-06", "The tool chain shall be reproducible from its sources and free of influence from an unreviewed binary: self-compilation reaches a bit-identical fixpoint and a diverse double compilation agrees."), Cons(q_h("HLR-07", "A critical output shall be released only when two dissimilar computation channels agree exactly, inside a cycle budget, under a valid translation certificate; any other outcome latches the safe state."), Cons(q_h("HLR-08", "Every certified kernel shall be proven against its contract, translation-validated, covered to decision and MC/DC level by tests that ran on the real binary, and traceable to these requirements."), Cons(q_h("HLR-09", "Object code shall be traceable to its source lines, and every proof, cache and qualification record shall be bound to the exact artifacts it was produced from: a stale, altered, forged or unsigned record is rejected."), Cons(q_h("HLR-10", "The verification tools shall compose into one chain that is reachable through one driver: each tool consumes the artifact the previous one produced, bound to it by hash, and a corruption of any artifact is refused by the tool that consumes it."), Nil))))))))))
fn q_l(id, title, hlrs, files, pos, neg, ev) = {id: id, title: title, hlrs: hlrs, files: files, pos: pos, neg: neg, ev: ev}
fn q_s1(a) = Cons(a, Nil)
fn q_s2(a, b) = Cons(a, Cons(b, Nil))
fn q_s3(a, b, c) = Cons(a, Cons(b, Cons(c, Nil)))
fn q_llrs_a() = Cons(q_l("LLR-LEX-01", "The lexer accepts the token grammar and stops on a malformed token with a diagnostic and no output.", q_s1("HLR-01"), q_s1("compiler/stage1/lume/01_lexer.src"), q_s1("P-LEX-POS"), q_s1("P-LEX-NEG"), q_s2("G-AUDIT", "G-SOAK")), Cons(q_l("LLR-PAR-01", "The parser builds the AST of well-formed programs and stops on a syntax error with a located diagnostic and no output.", q_s1("HLR-01"), q_s2("compiler/stage1/lume/02_parser.src", "compiler/stage1/lume/04_parser_decls.src"), q_s1("P-PAR-POS"), q_s1("P-PAR-NEG"), q_s2("G-AUDIT", "G-SOAK")), Cons(q_l("LLR-TYP-01", "The type checker rejects ill-typed programs before code generation.", q_s1("HLR-01"), q_s1("compiler/stage1/lume/06_typecheck.src"), q_s1("P-TYP-POS"), q_s1("P-TYP-NEG"), q_s2("G-AUDIT", "G-TESTS")), Cons(q_l("LLR-CON-01", "Contracts are fail-closed: a refuted requires/ensures stops the build with [V0001]; an undecided one stays as a run-time check that traps.", q_s1("HLR-02"), q_s1("compiler/stage1/lume/06b_phase3.src"), q_s1("P-CON-POS"), q_s3("P-CON-NEG-STATIC", "P-CON-NEG-RUNTIME", "P-CON-NEG-ENSURES"), q_s2("G-PFUZZ", "G-AUDIT")), Cons(q_l("LLR-PUR-01", "A function declared `/ pure` that reaches an I/O primitive is rejected with [E0200].", q_s1("HLR-03"), q_s1("compiler/stage1/lume/06b_phase3.src"), q_s1("P-PUR-POS"), q_s1("P-PUR-NEG"), q_s1("G-AUDIT")), Cons(q_l("LLR-SEC-01", "A branch whose condition depends on a `@secret` value is rejected with [C0009].", q_s1("HLR-03"), q_s1("compiler/stage1/lume/06b_phase3.src"), q_s1("P-SEC-POS"), q_s1("P-SEC-NEG"), q_s1("G-AUDIT")), Cons(q_l("LLR-OWN-01", "Ownership is linear: a value moved with `own` cannot be used again ([O0001]).", q_s1("HLR-04"), q_s1("compiler/stage1/lume/06b_phase3.src"), q_s1("P-OWN-POS"), q_s1("P-OWN-NEG"), q_s1("G-AUDIT")), Cons(q_l("LLR-MEM-01", "The collector does not change program results however often it runs, and heap exhaustion is a diagnosed stop.", q_s2("HLR-04", "HLR-05"), q_s1("compiler/stage1/runtime_core.lume"), q_s1("P-MEM-POS"), q_s1("P-MEM-NEG"), q_s1("G-SOAK")), Nil))))))))
fn q_llrs_b() = Cons(q_l("LLR-PRV-01", "The QF_LIA decision procedure reports `proven` only for valid linear contracts and refutes invalid ones with a counterexample.", q_s1("HLR-02"), q_s2("compiler/stage1/lume/06b_phase3.src", "compiler/stage1/lcaas.src"), q_s1("P-PRV-LIA-POS"), q_s1("P-PRV-LIA-NEG"), q_s1("G-PFUZZ")), Cons(q_l("LLR-PRV-02", "The QF_NIA extension reports `proven` only for valid non-linear contracts.", q_s1("HLR-02"), q_s1("compiler/stage1/lume/06b_phase3.src"), q_s1("P-PRV-NIA-POS"), q_s1("P-PRV-NIA-NEG"), q_s1("G-PFUZZ")), Cons(q_l("LLR-CRT-01", "The certificate kernel re-derives every proven obligation independently of the compiler and rejects a tampered certificate.", q_s1("HLR-02"), q_s1("compiler/stage1/lcert.src"), q_s1("P-CRT-POS"), q_s1("P-CRT-NEG"), q_s1("G-PFUZZ")), Cons(q_l("LLR-LTV-01", "The translation validator accepts a function only when its x86-64 code has the trap behaviour, value, effects and frame discipline of its AST, and rejects every other code.", q_s1("HLR-01"), q_s2("compiler/stage1/ltv.src", "compiler/stage1/lume/05_codegen.src"), q_s1("P-TV-POS"), q_s3("P-TV-NEG-ARITH", "P-TV-NEG-BRANCH", "P-TV-NEG-FRAME"), q_s1("G-TV")), Cons(q_l("LLR-ASM-01", "The assembler encodes every accepted instruction as GNU as does and rejects what it does not know with [L0001].", q_s1("HLR-01"), q_s1("compiler/stage1/lasm.src"), q_s1("P-ASM-POS"), q_s1("P-ASM-NEG"), q_s1("G-LASM")), Cons(q_l("LLR-FFI-01", "A foreign declaration is bound only when its ABI is supported; results enter as `unverified`; anything else is refused with [I0003].", q_s1("HLR-03"), q_s2("compiler/stage1/lchameleon.src", "compiler/stage1/interop.src"), q_s1("P-FFI-POS"), q_s1("P-FFI-NEG"), q_s1("G-AUDIT")), Cons(q_l("LLR-RTE-01", "Integer overflow and division by zero stop the program with a diagnostic and a non-zero status.", q_s1("HLR-05"), q_s1("compiler/stage1/runtime_core.lume"), q_s1("P-RTE-POS"), q_s2("P-RTE-NEG-OVERFLOW", "P-RTE-NEG-DIVZERO"), q_s1("G-SOAK")), Cons(q_l("LLR-WCET-01", "A function whose structural cycle cost exceeds its `@bound` is rejected with [V0002].", q_s2("HLR-05", "HLR-07"), q_s1("compiler/stage1/lume/06b_phase3.src"), q_s1("P-WCET-POS"), q_s1("P-WCET-NEG"), q_s1("G-ENV")), Nil))))))))
fn q_llrs_c() = Cons(q_l("LLR-BOOT-01", "The compiler compiled by itself is bit-identical to the compiler that compiled it, the frozen seed matches its recorded hashes, and the seed-built and self-built compilers agree.", q_s1("HLR-06"), q_s2("scripts/bootstrap.src", "bootstrap/lume0/SEED_FREEZE.sha256"), q_s1("P-BOOT-POS"), q_s1("P-BOOT-NEG"), q_s2("G-BOOT", "G-AUDIT")), Cons(q_l("LLR-ENV-01", "The lockstep voter commits a value only when the x86-64 channel and the LumePuter RV32IM monitor agree inside the cycle budget under a valid certificate; every other case latches SAFE_STATE_TRIP.", q_s1("HLR-07"), q_s1("compiler/stage1/lsafety_envelope.src"), q_s1("P-ENV-POS"), q_s2("P-ENV-NEG-SEU", "P-ENV-NEG-WCET"), q_s1("G-ENV")), Cons(q_l("LLR-MCD-01", "The coverage analyzer reports an obligation as covered only with a witness the real binary confirms, and reports unreachable outcomes instead of hiding them: every decision is an obligation, nested ones included; an outcome without a witness is classified only as the false conclusion of a declared law or as infeasible with a kernel proof, and is uncovered otherwise; a certified module with an uncovered obligation fails the qualification.", q_s1("HLR-08"), q_s1("compiler/stage1/lmcdc.src"), q_app(q_s2("P-MCDC-POS", "P-MCDC-POS-SEARCH"), q_s2("P-MCDC-POS-NESTED", "P-MCDC-POS-PATH")), q_s5("P-MCDC-NEG", "P-MCDC-NEG-UNCOVERED", "P-MCDC-NEG-SHADOW", "P-MCDC-NEG-LAWHYP", "P-MCDC-NEG-ENSURES"), q_s1("M-MCDC")), Cons(q_l("LLR-DOM-01", "Every domain kernel of the certified modules is proven against its contract (no obligation left runtime-checked or refuted) and translation-validated.", q_s1("HLR-08"), q_s3("compiler/stage1/lstd.src", "compiler/stage1/lchameleon.src", "stdlib/std.lume"), q_s1("P-DOM-POS"), q_s1("P-DOM-NEG"), q_s3("G-SELFPROVE", "M-TV", "M-PROVE")), Cons(q_l("LLR-QUA-01", "The traceability checker accepts a requirement only with a parent, a source file, a positive test, a negative test and a mutation gate or proof, and rejects an orphaned matrix.", q_s1("HLR-08"), q_s1("compiler/stage1/lqualify.src"), q_s1("S-RTM-POS"), q_s1("S-RTM-NEG"), q_s1("M-PROVE")), Nil)))))
fn q_s5(a, b, c, d, e) = Cons(a, Cons(b, q_s3(c, d, e)))
fn q_llrs_d() = Cons(q_l("LLR-SEC-02", "The translation validator rejects a `@secret` function when its emitted code, or the code of any routine it reaches by call or jmp (user function or runtime helper), holds a conditional branch, a division or a memory access outside its frame ([C0010]).", q_s1("HLR-03"), q_s1("compiler/stage1/ltv.src"), q_s1("P-CT-POS"), q_s1("P-CT-NEG"), q_s1("G-TV")), Cons(q_l("LLR-DBG-01", "With `--dwarf` the compiler and the assembler emit DWARF v4 line and symbol information that maps code addresses to source lines; a line directive that names an undeclared file is rejected with [L0001].", q_s1("HLR-09"), q_s2("compiler/stage1/lume/07_driver.src", "compiler/stage1/lasm.src"), q_s1("P-DBG-POS"), q_s1("P-DBG-NEG"), q_s1("G-DWARF-CACHE")), Cons(q_l("LLR-PCH-01", "The incremental proof cache answers `hit` for a function only when its body, contracts, callee interfaces and prover version digest to a stored record whose seal verifies; a tampered record is refused with [PC0002] and a module the prover refutes is never stored ([PC0003]).", q_s2("HLR-02", "HLR-09"), q_s1("compiler/stage1/lproof_cache.src"), q_s1("P-PCH-POS"), q_s2("P-PCH-NEG-TAMPER", "P-PCH-NEG-FALSE"), q_s1("G-DWARF-CACHE")), Cons(q_l("LLR-CONC-01", "A value sent through a linear channel cannot be used again ([E0305]); a lock acquisition that breaks the rank order or closes a wait-for cycle is rejected ([E0306]); both before code generation.", q_s1("HLR-04"), q_s2("compiler/stage1/lume/06b_phase3.src", "compiler/stage1/lconcurrency.src"), q_s1("P-CONC-POS"), q_s2("P-CONC-NEG-MOVE", "P-CONC-NEG-RANK"), q_s1("G-CONC")), Cons(q_l("LLR-RT-01", "A `@no_alloc` function is accepted only when it and every function it calls can reach no heap allocation: scalar typed parameters with proven bounds, arithmetic proven inside the immediate range, no heap value, recursion in tail position only ([E0210] otherwise).", q_s1("HLR-05"), q_s1("compiler/stage1/lume/06b_phase3.src"), q_s1("P-RT-POS"), q_s2("P-RT-NEG-CALLEE", "P-RT-NEG-BOUNDS"), q_s1("G-REALTIME")), Cons(q_l("LLR-CRT-02", "With `--check-source` the certificate kernel reads the contracts of the source itself and accepts a certificate only when its hash is that file's and every obligation is, term for term, an obligation of that file; anything it cannot bind is a refusal ([K0010]..[K0017]).", q_s2("HLR-02", "HLR-09"), q_s2("compiler/stage1/lcert.src", "compiler/stage1/lcaas.src"), q_s2("P-CRTSRC-POS", "P-CAP-POS"), q_s2("P-CRTSRC-NEG", "P-CAP-NEG"), q_s1("G-CERTSRC")), Nil))))))
fn q_llrs_e() = Cons(q_l("LLR-CRY-01", "The cryptographic primitives that seal and sign evidence (SHA-256, HMAC, HKDF, ChaCha20-Poly1305, Ed25519, X25519, the TLS 1.3 key schedule, record layer and handshake) reproduce the official vectors and reject every forged tag, signature, record and handshake message.", q_s1("HLR-09"), q_s2("compiler/stage1/lcrypto_tls.src", "stdlib/crypto.lume"), q_s1("P-CRY-POS"), q_s1("P-CRY-NEG"), q_s1("G-CRYPTO")), Cons(q_l("LLR-MARCH-01", "A kernel is lowered to AArch64, RV64 or RV32 only after the lumec front end accepted it ([T0902] otherwise) and only inside the integer kernel fragment ([T0901] otherwise); the emitted words are translation-validated and behave like the x86-64 code.", q_s1("HLR-01"), q_s5("compiler/stage1/larm64.src", "compiler/stage1/lriscv.src", "compiler/stage1/lkir.src", "compiler/stage1/ltv_multiarch.src", "compiler/stage1/ltarget.src"), q_s1("P-MARCH-POS"), q_s2("P-MARCH-NEG-FRONT", "P-MARCH-NEG-FRAG"), q_s1("G-MARCH")), Cons(q_l("LLR-STN-01", "A neural cartridge is produced only for the monitor fragment, and its forward pass is accepted only when the tensor hash and the ballast guard hold and the result equals the native and the LumePuter results.", q_s1("HLR-07"), q_s1("compiler/stage1/lneural_cartridge.src"), q_s1("P-STN-POS"), q_s1("P-STN-NEG"), q_s1("G-SAFETENSORS")), Cons(q_l("LLR-SIG-01", "The evidence file is hash-chained section by section and carries a detached Ed25519 signature over its SHA-256 and its chain head; the signature does not verify for an altered section.", q_s1("HLR-09"), q_s2("compiler/stage1/lqualify.src", "compiler/stage1/lcrypto_tls.src"), q_s1("S-SIG-POS"), q_s1("S-SIG-NEG"), q_s1("G-CRYPTO")), Nil))))
## Wave 14 requirements
fn q_llrs_f() = Cons(q_l("LLR-ENV-02", "Channel B of the envelope is produced by a clean-room front end and code generator whose tool links no compiler module; a defect modelled in the front end or the code generator of ONE channel (a source mutant compiled by that channel only, a corrupted instruction of channel B) latches SAFE_STATE_TRIP.", q_s1("HLR-07"), q_s1("compiler/stage1/lsafety_envelope.src"), q_s1("P-ENVX-POS-INDEP"), q_s3("P-ENVX-NEG-ASRC", "P-ENVX-NEG-BSRC", "P-ENVX-NEG-BCG"), q_s1("G-ENV")), Cons(q_l("LLR-ENV-03", "The split bundle (channel programs and manifest) records the SHA-256 of every artifact; split-verify refuses a bundle whose artifact or manifest hash differs, and a voted request commits only on agreeing, fresh, well-formed frames.", q_s2("HLR-07", "HLR-09"), q_s2("compiler/stage1/lsafety_envelope.src", "docs/41-safety-envelope-split-bundle.md"), q_s1("P-SPLIT-POS"), q_s1("P-SPLIT-NEG"), q_s2("G-ENV", "G-MARCH")), Cons(q_l("LLR-RT-02", "The worst-case stack depth of a `@no_alloc` function is computed in bytes on the emitted text over every path that remains under the proven ranges; text without a bound (a call cycle that is not a tail jump) is rejected.", q_s1("HLR-05"), q_s1("compiler/stage1/lstack.src"), q_s1("P-STK-POS"), q_s1("P-STK-NEG"), q_s1("G-REALTIME")), Cons(q_l("LLR-RT-03", "A run-time check kept by --keep-proven-checks / --critical is code of the function: a kept check that calls a function that is not `@no_alloc` is rejected with [E0210].", q_s1("HLR-05"), q_s1("compiler/stage1/lume/06b_phase3.src"), q_s1("P-KEEP-POS"), q_s1("P-KEEP-NEG"), q_s1("G-REALTIME")), Cons(q_l("LLR-LTV-02", "The emitted machine code of every integer runtime helper is verified against its specification for all inputs of the modelled cases; a helper whose code differs from the specification is rejected.", q_s1("HLR-01"), q_s2("compiler/stage1/ltv_rt.src", "compiler/stage1/runtime_core.lume"), q_s1("P-TVRT-POS"), q_s1("P-TVRT-NEG"), q_s1("G-TVRT")), Cons(q_l("LLR-LTV-03", "Every SMT-LIB certificate the translation validator exports is checked by a native decision procedure that shares no code with it; a certificate that is not the stated claim, or whose claim is not refuted, is not accepted.", q_s2("HLR-01", "HLR-09"), q_s1("compiler/stage1/lsmt.src"), q_s1("P-SMT-POS"), q_s1("P-SMT-NEG"), q_s1("G-SMT")), Cons(q_l("LLR-SEC-03", "A function that is both `@secret` and `@no_alloc` is lowered to straight-line code over immediate integers: a conditional, a call of a function that is not such a kernel, or an operation without a proven range is a compile error ([C0011] / [E0210]); the validator re-derives the ranges and applies [C0010] to every routine the kernel reaches.", q_s1("HLR-03"), q_s3("compiler/stage1/lume/06b_phase3.src", "compiler/stage1/lume/05_codegen.src", "compiler/stage1/ltv.src"), q_s1("P-CTK-POS"), q_s1("P-CTK-NEG"), q_s2("G-TV", "G-REALTIME")), Nil)))))))
fn q_llrs_g() = Cons(q_l("LLR-CRY-02", "X.509 v3 path validation for Ed25519 chains accepts a path only when every signature, validity period, CA constraint and the pinned trust anchor hold, and returns no key otherwise; random bytes and generated keys are released only when the OS entropy health check finds no dead, stuck or repeating source.", q_s1("HLR-09"), q_s1("compiler/stage1/lcrypto_tls.src"), q_s2("P-X509-POS", "P-ENT-POS"), q_s2("P-X509-NEG", "P-ENT-NEG"), q_s1("G-CRYPTO")), Cons(q_l("LLR-PRV-03", "The wrapping SIMD lane intrinsics are modelled as 4 * (a + b) only when the lane range is entailed; without it a contract over them is not reported proven and stays a run-time check that traps.", q_s1("HLR-02"), q_s2("compiler/stage1/lume/06b_phase3.src", "compiler/stage1/lcaas.src"), q_s1("P-SIMD-POS"), q_s2("P-SIMD-NEG-STATIC", "P-SIMD-NEG-RUNTIME"), q_s1("G-PFUZZ")), Cons(q_l("LLR-SIG-02", "The key that signs the evidence is certified by a self-signed X.509 v3 certificate written with the package; `@verify` accepts a package only when that certificate validates as its own trust anchor and certifies the signing key; a new signing key is generated only when the OS entropy health check passes.", q_s1("HLR-09"), q_s2("compiler/stage1/lqualify.src", "compiler/stage1/lcrypto_tls.src"), q_s1("S-CERT-POS"), q_s1("S-CERT-NEG"), q_s1("G-CRYPTO")), Cons(q_l("LLR-SYN-01", "The certificate, the source binding, the object code and its translation validation name one source and one assembly by SHA-256; along the whole chain (proof cache, certificate, assembly, SMT-LIB certificates, runtime helpers, stack bound, coverage, envelope, split bundle, cartridge, signed manifest) a corrupted artifact is refused by the tool that consumes it.", q_s2("HLR-10", "HLR-09"), q_s2("tests/harness/synergy_gate.src", "examples/synergy/critical_pipeline.src"), q_s1("P-CHAIN-POS"), q_s1("P-CHAIN-NEG"), q_s1("G-SYNERGY")), Cons(q_l("LLR-CLI-01", "Every step of the chain is a command of one driver whose help, manuals and dispatch table cannot drift apart; an unknown command is an error.", q_s1("HLR-10"), q_s2("compiler/stage1/lume_driver.src", "compiler/stage1/lcli.src"), q_s1("P-CLI-POS"), q_s1("P-CLI-NEG"), q_s1("G-CLI")), Cons(q_l("LLR-CAAS-01", "The proof service runs the passes of the compiler in process: it answers with the diagnostic of the compiler for an invalid program instead of aborting, and none of its modes adds a term of higher degree to the run time of the compiler alone.", q_s2("HLR-10", "HLR-02"), q_s1("compiler/stage1/lcaas.src"), q_s1("P-CAAS-POS"), q_s1("P-CAAS-NEG"), q_s1("G-SCALE")), Nil))))))
fn q_llrs() = q_app(q_llrs_a(), q_app(q_llrs_b(), q_app(q_llrs_c(), q_app(q_llrs_d(), q_app(q_llrs_e(), q_app(q_llrs_f(), q_llrs_g()))))))

## --- the matrix check. ev = {probes, gates, mods_ok, tv_ok, mc_ok, pr_ok, self_pos, self_neg} ---
fn q_ev_ok(ev, id) = if id == "M-TV" or id == "M-MCDC" or id == "M-PROVE" then ev.mods_ok else if id == "S-RTM-POS" then ev.self_pos else if id == "S-RTM-NEG" then ev.self_neg else if id == "S-SIG-POS" then ev.sig_pos else if id == "S-SIG-NEG" then ev.sig_neg else if id == "S-CERT-POS" then ev.cert_pos else if id == "S-CERT-NEG" then ev.cert_neg else let g = q_gate_ok(ev.gates, id) in if g >= 0 then g else let p = q_res_ok(ev.probes, id) in if p >= 0 then p else 0
fn q_count_ok(ev, ids) = match ids
    Nil        => 0
    Cons(h, t) => (if q_ev_ok(ev, h) == 1 then 1 else 0) + q_count_ok(ev, t)
fn q_hlr_known(hs, id) = match hs
    Nil        => 0
    Cons(h, t) => if h.id == id then 1 else q_hlr_known(t, id)
fn q_count_hlrs(hs, ids) = match ids
    Nil        => 0
    Cons(h, t) => q_hlr_known(hs, h) + q_count_hlrs(hs, t)
fn q_count_files(root, fs) = match fs
    Nil        => 0
    Cons(h, t) => fs_path_exists(root + "/" + h) + q_count_files(root, t)
## a requirement is traced when the kernel accepts the counts AND nothing it cites is missing or failing
fn q_llr_traced(cfg, hs, ev, l) = if rtm_requirement_fully_traced(q_count_hlrs(hs, l.hlrs), q_count_files(cfg.root, l.files), q_count_ok(ev, l.pos), q_count_ok(ev, l.neg), q_count_ok(ev, l.ev)) == 1 and q_count_hlrs(hs, l.hlrs) == q_len(l.hlrs) and q_count_files(cfg.root, l.files) == q_len(l.files) and q_count_ok(ev, l.pos) == q_len(l.pos) and q_count_ok(ev, l.neg) == q_len(l.neg) and q_count_ok(ev, l.ev) == q_len(l.ev) then 1 else 0
fn q_untraced(cfg, hs, ev, ls) = match ls
    Nil        => Nil
    Cons(l, t) => if q_llr_traced(cfg, hs, ev, l) == 1 then q_untraced(cfg, hs, ev, t) else Cons(l.id, q_untraced(cfg, hs, ev, t))
fn q_hlr_has_child(ls, id) = match ls
    Nil        => 0
    Cons(l, t) => if q_mem(l.hlrs, id) == 1 then 1 else q_hlr_has_child(t, id)
fn q_childless(hs, ls) = match hs
    Nil        => Nil
    Cons(h, t) => if q_hlr_has_child(ls, h.id) == 1 then q_childless(t, ls) else Cons(h.id, q_childless(t, ls))
fn q_cited(ls, id) = match ls
    Nil        => 0
    Cons(l, t) => if q_mem(l.pos, id) == 1 or q_mem(l.neg, id) == 1 or q_mem(l.ev, id) == 1 then 1 else q_cited(t, id)
fn q_uncited_probes(ps, ls) = match ps
    Nil        => Nil
    Cons(p, t) => if q_cited(ls, p.id) == 1 then q_uncited_probes(t, ls) else Cons(p.id, q_uncited_probes(t, ls))
fn q_uncited_gates(gs, ls) = match gs
    Nil        => Nil
    Cons(g, t) => if q_cited(ls, g.id) == 1 then q_uncited_gates(t, ls) else Cons(g.id, q_uncited_gates(t, ls))
fn q_rtm_check(cfg, hs, ls, ev) = {untraced: q_untraced(cfg, hs, ev, ls), childless: q_childless(hs, ls), uncited: q_app(q_uncited_probes(ev.probes, ls), q_uncited_gates(ev.gates, ls))}
fn q_rtm_clean(r) = if q_len(r.untraced) == 0 and q_len(r.childless) == 0 and q_len(r.uncited) == 0 then 1 else 0
## negative control: the same matrix with the parent of its first requirement removed and the negative tests of its
## second one removed must come back with exactly those two requirements untraced and one childless HLR at most
fn q_orphan(ls) = match ls
    Cons(a, r1) => q_orphan2(a, r1)
    _           => ls
fn q_orphan2(a, r1) = match r1
    Cons(b, r2) => Cons(q_l(a.id, a.title, q_s1("HLR-99"), a.files, a.pos, a.neg, a.ev), Cons(q_l(b.id, b.title, b.hlrs, b.files, b.pos, Nil, b.ev), r2))
    _           => Cons(a, r1)
fn q_first2(ls) = match ls
    Cons(a, r1) => q_first2b(a, r1)
    _           => Nil
fn q_first2b(a, r1) = match r1
    Cons(b, r2) => q_s2(a.id, b.id)
    _           => Nil
fn q_same(xs, ys) = match xs
    Nil        => q_len(ys) == 0
    Cons(h, t) => q_same2(h, t, ys)
fn q_same2(h, t, ys) = match ys
    Nil        => 0
    Cons(g, u) => if h == g then q_same(t, u) else 0

## --- rendering ---
fn q_strs_json(xs) = match xs
    Nil        => ""
    Cons(h, t) => "\"" + q_jesc(h) + "\"" + (if q_len(t) == 0 then "" else ",") + q_strs_json(t)
fn q_strs_md(xs) = match xs
    Nil        => ""
    Cons(h, t) => h + (if q_len(t) == 0 then "" else ", ") + q_strs_md(t)
fn q_ids_json(ev, xs) = match xs
    Nil        => ""
    Cons(h, t) => "{\"id\":\"" + h + "\",\"pass\":" + q_bool(q_ev_ok(ev, h)) + "}" + (if q_len(t) == 0 then "" else ",") + q_ids_json(ev, t)
fn q_ids_md(ev, xs) = match xs
    Nil        => ""
    Cons(h, t) => h + " " + q_mark(q_ev_ok(ev, h)) + (if q_len(t) == 0 then "" else "<br>") + q_ids_md(ev, t)
fn q_files_json(root, fs) = match fs
    Nil        => ""
    Cons(h, t) => "{\"path\":\"" + h + "\",\"exists\":" + q_bool(fs_path_exists(root + "/" + h)) + ",\"sha256\":\"" + (if fs_path_exists(root + "/" + h) == 1 then fs_sha256_file(root + "/" + h) else "") + "\"}" + (if q_len(t) == 0 then "" else ",") + q_files_json(root, t)
fn q_hlr_children(ls, id) = match ls
    Nil        => Nil
    Cons(l, t) => if q_mem(l.hlrs, id) == 1 then Cons(l.id, q_hlr_children(t, id)) else q_hlr_children(t, id)
fn q_hlrs_json(hs, ls) = match hs
    Nil        => ""
    Cons(h, t) => "{\"id\":\"" + h.id + "\",\"text\":\"" + q_jesc(h.text) + "\",\"llrs\":[" + q_strs_json(q_hlr_children(ls, h.id)) + "]}" + (if q_len(t) == 0 then "" else ",") + q_hlrs_json(t, ls)
fn q_llrs_json(cfg, hs, ev, ls) = match ls
    Nil        => ""
    Cons(l, t) => "{\"id\":\"" + l.id + "\",\"title\":\"" + q_jesc(l.title) + "\",\"hlrs\":[" + q_strs_json(l.hlrs) + "],\"files\":[" + q_files_json(cfg.root, l.files) + "],\"positive\":[" + q_ids_json(ev, l.pos) + "],\"negative\":[" + q_ids_json(ev, l.neg) + "],\"mutation_or_proof\":[" + q_ids_json(ev, l.ev) + "],\"fully_traced\":" + q_bool(q_llr_traced(cfg, hs, ev, l)) + "}" + (if q_len(t) == 0 then "" else ",") + q_llrs_json(cfg, hs, ev, t)
fn q_hlrs_md(hs, ls) = match hs
    Nil        => ""
    Cons(h, t) => "| " + h.id + " | " + h.text + " | " + q_strs_md(q_hlr_children(ls, h.id)) + " |\n" + q_hlrs_md(t, ls)
fn q_llrs_md(cfg, hs, ev, ls) = match ls
    Nil        => ""
    Cons(l, t) => "| " + l.id + " | " + l.title + " | " + q_strs_md(l.hlrs) + " | " + q_strs_md(l.files) + " | " + q_ids_md(ev, l.pos) + " | " + q_ids_md(ev, l.neg) + " | " + q_ids_md(ev, l.ev) + " | " + (if q_llr_traced(cfg, hs, ev, l) == 1 then "TRACED" else "**NOT TRACED**") + " |\n" + q_llrs_md(cfg, hs, ev, t)
fn q_probes_json(ps, rs) = match ps
    Nil        => ""
    Cons(p, t) => "{\"id\":\"" + p.id + "\",\"kind\":\"" + p.kind + "\",\"pass\":" + q_bool(q_res_ok(rs, p.id)) + ",\"note\":\"" + q_jesc(q_note(rs, p.id)) + "\"}" + (if q_len(t) == 0 then "" else ",") + q_probes_json(t, rs)
fn q_note(rs, id) = match rs
    Nil        => ""
    Cons(r, t) => if r.id == id then (if count(r.note) > 700 then slice(r.note, 0, 700) else r.note) else q_note(t, id)
fn q_probes_md(ps, rs) = match ps
    Nil        => ""
    Cons(p, t) => "| " + p.id + " | " + p.kind + " | " + q_mark(q_res_ok(rs, p.id)) + " |\n" + q_probes_md(t, rs)
fn q_gates_json(gs) = match gs
    Nil        => ""
    Cons(g, t) => "{\"id\":\"" + g.id + "\",\"title\":\"" + q_jesc(g.title) + "\",\"pass\":" + q_bool(g.ok) + ",\"exit_status\":" + str(g.status) + ",\"duration_ms\":" + str(g.ms) + ",\"binary_sha256\":\"" + g.sha + "\",\"summary_files\":[" + g.sums + "]" + g.more + ",\"output\":\"" + q_jesc(g.line) + "\"}" + (if q_len(t) == 0 then "" else ",") + q_gates_json(t)
fn q_gates_md(gs) = match gs
    Nil        => ""
    Cons(g, t) => "### " + g.id + " -- " + g.title + "\n\n- result: **" + q_mark(g.ok) + "** (exit status " + str(g.status) + ", " + str(g.ms / 1000) + " s)\n- binary sha256: `" + g.sha + "`\n" + (if g.sums == "" then "" else "- files written under build/certification/, hash-linked into the evidence chain: `" + g.sums + "`\n") + (if g.more == "" then "" else "- recorded: `" + slice(g.more, 1, count(g.more)) + "`\n") + "- output: `" + g.line + "`\n\n" + q_gates_md(t)
fn q_mods_json(ms) = match ms
    Nil        => ""
    Cons(m, t) => "{\"module\":\"" + m.path + "\",\"sha256\":\"" + m.sha + "\",\"pass\":" + q_bool(m.ok) + ",\"mcdc_qualified_set\":" + q_bool(m.mcdc) + ",\"note\":\"" + q_jesc(m.note) + "\",\"proof_status\":{\"proven\":" + str(m.proven) + ",\"budget_checked\":" + str(m.budget) + ",\"runtime_checked\":" + str(m.runtime) + ",\"refuted\":" + str(m.refuted) + "},\"translation_validation\":" + (if m.tv == "" then "null" else q_chomp(m.tv)) + ",\"structural_coverage\":" + (if m.mc == "" then "null" else q_chomp(m.mc)) + ",\"duration_ms\":{\"ltv\":" + str(m.tv_ms) + ",\"lmcdc\":" + str(m.mc_ms) + ",\"lcaas\":" + str(m.pr_ms) + "}" + "}" + (if q_len(t) == 0 then "" else ",") + q_mods_json(t)
fn q_mods_md(ms) = match ms
    Nil        => ""
    Cons(m, t) => "| `" + m.path + "` | " + q_mark(m.ok) + " | " + str(q_field(m.tv, "validated")) + " / " + str(q_field(m.tv, "rejected")) + " / " + str(q_field(m.tv, "unsupported")) + " | " + str(q_field(m.tv, "native_vectors")) + " | " + str(m.proven) + " / " + str(m.budget) + " / " + str(m.runtime) + " / " + str(m.refuted) + " | " + str(q_field(m.mc, "obligations")) + " | " + str(q_field(m.mc, "covered")) + " | " + str(q_field(m.mc, "theorem_false_unreachable")) + " | " + str(q_field(m.mc, "infeasible_proved_by_kernel")) + " | " + str(q_field(m.mc, "uncovered")) + (if m.mcdc == 1 then " (must be 0)" else " (reported only: outside the MC/DC-qualified set)") + " | " + str(q_field(m.mc, "native_witnesses_agreeing")) + " |\n" + q_mods_md(t)
fn q_tcb_files() = Cons("bootstrap/lume0/lume0", Cons("build/bin/lumec", Cons("build/bootstrap/lumec2", Cons("build/bootstrap/lumec3", Cons("build/bin/lasm", Cons("build/bin/lmod", Cons("build/bin/lcaas", Cons("build/bin/lcert", Cons("build/bin/ltv", Cons("build/bin/lmcdc", Cons("build/bin/lsafety_envelope", Cons("build/bin/ltv_rt", Cons("build/bin/lsmt", Cons("build/bin/lstack", Cons("build/bin/lproof_cache", Cons("compiler/stage1/ltv_rt.src", Cons("compiler/stage1/lsmt.src", Cons("compiler/stage1/lstack.src", Cons("compiler/stage1/lcrypto_tls.src", Cons("build/bin/lqualify", Cons("build/bin/lume_driver", Cons("build/bin/lcli", Cons("compiler/stage1/lumec.src", Cons("compiler/stage1/runtime_core.lume", Cons("compiler/stage1/lasm.src", Cons("compiler/stage1/lcert.src", Cons("compiler/stage1/ltv.src", Cons("compiler/stage1/lmcdc.src", Cons("compiler/stage1/lsafety_envelope.src", Cons("compiler/stage1/lqualify.src", Nil))))))))))))))))))))))))))))))
fn q_tcb(root, fs) = match fs
    Nil        => Nil
    Cons(h, t) => Cons({path: h, sha: if fs_path_exists(root + "/" + h) == 1 then fs_sha256_file(root + "/" + h) else ""}, q_tcb(root, t))
fn q_tcb_json(xs) = match xs
    Nil        => ""
    Cons(h, t) => "{\"path\":\"" + h.path + "\",\"sha256\":\"" + h.sha + "\"}" + (if q_len(t) == 0 then "" else ",") + q_tcb_json(t)
fn q_tcb_md(xs) = match xs
    Nil        => ""
    Cons(h, t) => "| `" + h.path + "` | `" + (if h.sha == "" then "MISSING" else h.sha) + "` |\n" + q_tcb_md(t)
fn q_tcb_sha(xs, path) = match xs
    Nil        => ""
    Cons(h, t) => if h.path == path then h.sha else q_tcb_sha(t, path)

## --- evidence chain and signature ---
## The evidence file is `{"summary":S,"probes":[P],"gates":[G],"modules":[M],"trusted_computing_base":[T],"evidence_chain":{..}}`.
## Chain: c1 = H(tag, previous evidence file, P), c2 = H(c1, G), c3 = H(c2, M), c4 = H(c3, T), head = H(c4, S); H is
## SHA-256 over the texts as written. The detached signature (QUALIFICATION_EVIDENCE.sig.json) is Ed25519 (RFC 8032,
## compiler/stage1/lcrypto_tls.src) over "lume-qualification-signature-v1\nevidence_sha256 <file hash>\nchain_head <head>\n".
## The key is a 32-byte seed in a file outside the repository (`@sign-key <path>`, default
## /root/.lume/keys/qualification_ed25519.seed). When the file does not exist a key is generated with
## lct_ed25519_keygen (compiler/stage1/lcrypto_tls.src): the seed is read from the kernel CSPRNG and is used only if
## the OS entropy health check passes (a dead, stuck or repeating source refuses the key generation and the run has
## no signature); the file is written with mode 600. The signature is a statement by whoever holds that file on this
## host, nothing more: the certificate written next to the public key is self-signed (see below) and no hardware
## protects the key. `@verify <dir>` re-checks a signed package.
fn q_all_hex(s, i) = if i >= count(s) then 1 else let c = at(s, i) in if (c >= "0" and c <= "9") or (c >= "a" and c <= "f") then q_all_hex(s, i + 1) else 0
fn q_dirname(p, i) = if i < 0 then "." else if at(p, i) == "/" then (if i == 0 then "/" else slice(p, 0, i)) else q_dirname(p, i - 1)
fn q_key_new(path) = let mk = os_run("/bin/mkdir", Cons("-p", Cons(q_dirname(path, count(path) - 1), Nil))) in let k = lct_ed25519_keygen() in if k.ok != 1 or lct_len(k.seed) != 32 then {seed: "", fresh: 0, err: "no signing key was generated: the OS entropy health check refused the draw (" + lct_entropy_err_name(k.err) + ")"} else let hexs = lct_bytes_to_hex(k.seed) in let w = fs_write_sync(path, hexs + "\n") in let ch = os_run("/bin/chmod", Cons("600", Cons(path, Nil))) in if w != 1 or q_chomp(fs_read_file(path)) != hexs then {seed: "", fresh: 0, err: "cannot write the signing key file " + path} else {seed: hexs, fresh: 1, err: ""}
fn q_key_load(path) = if fs_path_exists(path) == 0 then q_key_new(path) else let have = q_chomp(fs_read_file(path)) in if count(have) == 64 and q_all_hex(have, 0) == 1 then {seed: have, fresh: 0, err: ""} else {seed: "", fresh: 0, err: "the signing key file " + path + " is not 64 lowercase hex digits"}
## --- X.509 binding of the signing key (Wave 14) ---
## Next to QUALIFICATION_SIGNING_KEY.pub the campaign writes QUALIFICATION_SIGNING_CERT.der: a SELF-SIGNED X.509 v3
## certificate (RFC 5280, Ed25519 per RFC 8410) for the key that signs the evidence, built here with the primitives of
## compiler/stage1/lcrypto_tls.src (lct_der_wrap, lct_ed25519_sign) and checked with lct_x509_verify_chain against
## ITSELF as the pinned trust anchor. The DER is a function of the key alone (fixed names, fixed validity window
## 2026-01-01T00:00:00Z .. 2036-01-01T00:00:00Z, serial = 8 bytes of the SHA-256 of the key), so the same key always
## gives the same file. What it adds: a standard container that states subject, validity and usage (digitalSignature,
## keyCertSign; CA so that it can be its own anchor) for the key, which `@verify` checks together with the signature.
## What it does NOT add: any assurance about who holds the key. No authority issued it; anybody can make one.
fn q_hd(xs) = match xs
    Nil        => 0
    Cons(h, t) => h
fn q_tl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => t
fn q_take(xs, n) = match xs
    Nil        => Nil
    Cons(h, t) => if n <= 0 then Nil else Cons(h, q_take(t, n - 1))
fn q_cert_org() = "Lume tool chain (repository lume)"
fn q_cert_cn() = "lqualify evidence signing key (self-signed, developer)"
fn q_cert_alg() = lct_hex_to_bytes("300506032b6570")
fn q_cert_rdn(oid, s) = lct_der_wrap(49, lct_der_wrap(48, q_app(lct_hex_to_bytes(oid), lct_der_wrap(12, lct_str_to_bytes(s)))))
fn q_cert_name() = lct_der_wrap(48, q_app(q_cert_rdn("060355040a", q_cert_org()), q_cert_rdn("0603550403", q_cert_cn())))
fn q_cert_nb() = (lct_x509_secs(2026, 1, 1, 0, 0, 0)).t
fn q_cert_na() = (lct_x509_secs(2036, 1, 1, 0, 0, 0)).t
fn q_cert_validity() = lct_der_wrap(48, q_app(lct_der_wrap(23, lct_str_to_bytes("260101000000Z")), lct_der_wrap(23, lct_str_to_bytes("360101000000Z"))))
fn q_cert_spki(pk) = lct_der_wrap(48, q_app(q_cert_alg(), lct_der_wrap(3, Cons(0, pk))))
## extensions: basicConstraints critical CA:TRUE; keyUsage critical digitalSignature + keyCertSign (bits 0 and 5: 0x84, 2 unused bits)
fn q_cert_exts() = lct_der_wrap(163, lct_der_wrap(48, lct_hex_to_bytes("300f0603551d130101ff040530030101ff300e0603551d0f0101ff040403020284")))
fn q_cert_serial(pk) = let h = lct_sha256(pk) in Cons(q_hd(h) % 127 + 1, q_take(q_tl(h), 7))
fn q_cert_tbs(pk) = lct_der_wrap(48, q_app(lct_hex_to_bytes("a003020102"), q_app(lct_der_wrap(2, q_cert_serial(pk)), q_app(q_cert_alg(), q_app(q_cert_name(), q_app(q_cert_validity(), q_app(q_cert_name(), q_app(q_cert_spki(pk), q_cert_exts()))))))))
fn q_cert_make(seed) = let tbs = q_cert_tbs(lct_ed25519_public_key(seed)) in lct_der_wrap(48, q_app(tbs, q_app(q_cert_alg(), lct_der_wrap(3, Cons(0, lct_ed25519_sign(seed, tbs))))))
## the certificate must validate as its own anchor at `now` and certify exactly the key `pkhex`
fn q_cert_check(xcb, pkhex, now) = if lct_len(xcb) == 0 then {ok: 0, why: "there is no signing certificate (QUALIFICATION_SIGNING_CERT.der)"} else let r = lct_x509_verify_chain(Cons(xcb, Nil), Cons(lct_x509_anchor_cert(xcb), Nil), now) in if r.ok != 1 then {ok: 0, why: "the signing certificate does not validate (X.509: " + lct_x509_err_name(r.err) + ")"} else if count(pkhex) != 64 or lct_bytes_to_hex(r.leaf_key) != pkhex then {ok: 0, why: "the signing certificate certifies another key than the one that signed the evidence"} else {ok: 1, why: ""}
## negative control: an altered certificate, the valid certificate of ANOTHER key, and a time after notAfter must fail
fn q_cert_neg(xcb, seedb, pkhex, now) = let a = q_cert_check(lct_flip(xcb, lct_len(xcb) - 1, 1), pkhex, now) in let b = q_cert_check(lct_flip(xcb, 12, 1), pkhex, now) in let c = q_cert_check(q_cert_make(lct_sha256(seedb)), pkhex, now) in let d = q_cert_check(xcb, pkhex, q_cert_na() + 1) in let e = q_cert_check(q_cert_make(lct_sha256(seedb)), lct_bytes_to_hex(lct_ed25519_public_key(lct_sha256(seedb))), now) in if lct_len(xcb) > 0 and a.ok == 0 and b.ok == 0 and c.ok == 0 and d.ok == 0 and e.ok == 1 then 1 else 0
fn q_bytes_at(path, i) = let b = fs_read_byte(path, i) in if b < 0 or i > 16384 then Nil else Cons(b, q_bytes_at(path, i + 1))
fn q_now(scratch) = let r = q_run("/bin/date", Cons("-u", Cons("+%s", Nil)), scratch, 10000) in let t = q_chomp(r.out) in let z = os_run("/bin/rm", Cons("-f", Cons(scratch, Cons(scratch + ".err", Nil)))) in if r.status == 0 and count(t) > 0 and q_digits_end(t, 0) == count(t) then toint(t) else 0
fn test_q_cert_roundtrip() = let seed = lct_sha256(lct_str_to_bytes("lqualify unit test seed")) in let pkhex = lct_bytes_to_hex(lct_ed25519_public_key(seed)) in let c = q_cert_make(seed) in let p = lct_x509_parse(c) in if p.err == 0 and p.ver == 3 and p.ca == 1 and p.nb == q_cert_nb() and p.na == q_cert_na() and lct_bytes_eq(p.issuer, p.subject) == 1 and lct_bytes_to_hex(p.key) == pkhex and (q_cert_check(c, pkhex, q_cert_nb())).ok == 1 and (q_cert_check(c, pkhex, q_cert_na())).ok == 1 and lct_bytes_eq(c, q_cert_make(seed)) == 1 then 1 else 0
fn test_q_cert_negative_control() = let seed = lct_sha256(lct_str_to_bytes("lqualify unit test seed")) in let pkhex = lct_bytes_to_hex(lct_ed25519_public_key(seed)) in let c = q_cert_make(seed) in if q_cert_neg(c, seed, pkhex, q_cert_nb() + 86400) == 1 and (q_cert_check(c, pkhex, q_cert_nb() - 1)).ok == 0 and (q_cert_check(Nil, pkhex, q_cert_nb())).ok == 0 and (q_cert_check(c, "", q_cert_nb() + 1)).ok == 0 then 1 else 0
fn test_q_rtm_kernel_and_fields() = if rtm_requirement_fully_traced(1, 1, 1, 1, 1) == 1 and rtm_requirement_fully_traced(1, 1, 1, 0, 1) == 0 and q_field("{\"uncovered\":12,\"x\":3}", "uncovered") == 12 and q_field_at("{\"a\":1,\"b\":{\"a\":7}}", "a", 8) == 7 and q_field_at("{\"a\":1}", "zz", 0) == 0 - 1 and q_flip_digit("a0b", 1) == "a1b" and q_ls_smt("x.lean\ny__f.smt2\n", 0) == "y__f.smt2" then 1 else 0
fn q_data_chain(prev, probes, gates, mods, tcb) = let c1 = lc_sha256("lume-qualification-evidence-v1\nprevious " + prev + "\nprobes\n" + probes) in let c2 = lc_sha256(c1 + "\ngates\n" + gates) in let c3 = lc_sha256(c2 + "\nmodules\n" + mods) in let c4 = lc_sha256(c3 + "\ntrusted_computing_base\n" + tcb) in {c1: c1, c2: c2, c3: c3, c4: c4}
fn q_chain_head(c4, summary) = lc_sha256(c4 + "\nsummary\n" + summary)
fn q_sig_text(file_sha, head) = "lume-qualification-signature-v1\nevidence_sha256 " + file_sha + "\nchain_head " + head + "\n"
fn q_chain_json(prev, dc, head) = "{\"algorithm\":\"SHA-256\",\"order\":[\"probes\",\"gates\",\"modules\",\"trusted_computing_base\",\"summary\"],\"previous_evidence_sha256\":\"" + prev + "\",\"links\":[\"" + dc.c1 + "\",\"" + dc.c2 + "\",\"" + dc.c3 + "\",\"" + dc.c4 + "\"],\"head\":\"" + head + "\"}"
fn q_evidence_text(summary, probes, gates, mods, tcb, chain) = "{\"summary\":" + summary + ",\"probes\":[" + probes + "],\"gates\":[" + gates + "],\"modules\":[" + mods + "],\"trusted_computing_base\":[" + tcb + "],\"evidence_chain\":" + chain + "}\n"
## the string value of "key" in a flat JSON text ("" when absent)
fn q_jstr_end(s, i) = if i >= count(s) or at(s, i) == "\"" then i else q_jstr_end(s, i + 1)
fn q_jstr(text, key) = let i = q_index(text, "\"" + key + "\":\"", 0) in if i < 0 then "" else let b = i + count(key) + 4 in slice(text, b, q_jstr_end(text, b))
## re-derive everything from the two files: the section texts are cut out of the evidence file at the markers this
## program writes, the chain is recomputed, and the signature is checked against the recomputed head and file hash
fn q_cut(text, from, open, close) = let a = q_index(text, open, from) in if a < 0 then {ok: 0, s: "", next: from} else let b = q_index(text, close, a + count(open)) in if b < 0 then {ok: 0, s: "", next: from} else {ok: 1, s: slice(text, a + count(open), b), next: b}
fn q_verify_texts(ev, sig) = let s = q_cut(ev, 0, "{\"summary\":", ",\"probes\":[") in let p = q_cut(ev, s.next, ",\"probes\":[", "],\"gates\":[") in let g = q_cut(ev, p.next, "],\"gates\":[", "],\"modules\":[") in let m = q_cut(ev, g.next, "],\"modules\":[", "],\"trusted_computing_base\":[") in let t = q_cut(ev, m.next, "],\"trusted_computing_base\":[", "],\"evidence_chain\":{") in if s.ok == 0 or p.ok == 0 or g.ok == 0 or m.ok == 0 or t.ok == 0 then {ok: 0, why: "the evidence file does not have the five sections in order"} else let chain_at = q_index(ev, "],\"evidence_chain\":{", t.next) in let chain = slice(ev, chain_at, count(ev)) in let prev = q_jstr(chain, "previous_evidence_sha256") in let dc = q_data_chain(prev, p.s, g.s, m.s, t.s) in let head = q_chain_head(dc.c4, s.s) in let fsha = lc_sha256(ev) in let pk = q_jstr(sig, "public_key") in let sg = q_jstr(sig, "signature") in if q_jstr(chain, "head") != head or q_has(chain, "\"links\":[\"" + dc.c1 + "\",\"" + dc.c2 + "\",\"" + dc.c3 + "\",\"" + dc.c4 + "\"]") == 0 then {ok: 0, why: "the hash chain recorded in the evidence file is not the chain of its sections"} else if q_jstr(sig, "evidence_sha256") != fsha then {ok: 0, why: "the signature file names another evidence file (SHA-256 mismatch)"} else if q_jstr(sig, "chain_head") != head then {ok: 0, why: "the signature file names another chain head"} else if count(pk) != 64 or count(sg) != 128 or q_all_hex(pk, 0) == 0 or q_all_hex(sg, 0) == 0 then {ok: 0, why: "the signature file has no well-formed public key and signature"} else if lct_ed25519_verify(lct_hex_to_bytes(pk), lct_str_to_bytes(q_sig_text(fsha, head)), lct_hex_to_bytes(sg)) != 1 then {ok: 0, why: "the Ed25519 signature does not verify"} else {ok: 1, why: ""}
fn q_pinned_key(root) = let p = root + "/docs/certification/QUALIFICATION_SIGNING_KEY.pub" in if fs_path_exists(p) == 1 then q_chomp(fs_read_file(p)) else ""
## the whole package: evidence and signature (q_verify_texts), then the X.509 binding of the key: the text of
## QUALIFICATION_SIGNING_KEY.pub must be the key of the signature file, and the certificate bytes must validate as
## their own trust anchor at `now` (seconds since 1970) and certify that key
fn q_verify_pkg(ev, sig, xcb, keyfile, now) = let v = q_verify_texts(ev, sig) in if v.ok != 1 then v else let pk = q_jstr(sig, "public_key") in if q_chomp(keyfile) != pk then {ok: 0, why: "QUALIFICATION_SIGNING_KEY.pub is not the key of the signature file"} else if now <= 0 then {ok: 0, why: "the current time is not known (give @now <seconds since 1970>)"} else q_cert_check(xcb, pk, now)
fn q_file_or_empty(p) = if fs_path_exists(p) == 1 then fs_read_file(p) else ""
fn q_verify_main(dir, root, nowarg) = let ep = dir + "/QUALIFICATION_EVIDENCE.json" in let sp = dir + "/QUALIFICATION_EVIDENCE.sig.json" in if fs_path_exists(ep) == 0 or fs_path_exists(sp) == 0 then ctfail("lqualify @verify: " + dir + " has no QUALIFICATION_EVIDENCE.json with its .sig.json\n") else let ev = fs_read_file(ep) in let sig = fs_read_file(sp) in let xcb = if fs_path_exists(dir + "/QUALIFICATION_SIGNING_CERT.der") == 1 then q_bytes_at(dir + "/QUALIFICATION_SIGNING_CERT.der", 0) else Nil in let now = if nowarg != "" and q_digits_end(nowarg, 0) == count(nowarg) then toint(nowarg) else q_now("/tmp/lume-qualify-now." + str(os_getpid())) in let v = q_verify_pkg(ev, sig, xcb, q_file_or_empty(dir + "/QUALIFICATION_SIGNING_KEY.pub"), now) in let pin = if root == "" then "" else q_pinned_key(root) in let pk = q_jstr(sig, "public_key") in let res = "{\"ok\":" + q_bool(v.ok) + ",\"tool\":\"lqualify\",\"mode\":\"verify\",\"evidence_sha256\":\"" + lc_sha256(ev) + "\",\"chain_head\":\"" + q_jstr(sig, "chain_head") + "\",\"public_key\":\"" + pk + "\",\"repository_key\":\"" + (if pin == "" then "none recorded" else if pin == pk then "matches" else "DIFFERENT") + "\",\"signing_certificate\":\"" + (if v.ok == 1 then "self-signed X.509 v3 (Ed25519), validated as its own trust anchor and certifying the signing key" else "not established") + "\",\"signing_certificate_sha256\":\"" + (if lct_len(xcb) == 0 then "" else lct_bytes_to_hex(lct_sha256(xcb))) + "\",\"verified_at_unix_time\":" + str(now) + ",\"error\":\"" + q_jesc(v.why) + "\"}" in if v.ok == 1 and (pin == "" or pin == pk) then res else let w = fs_write_sync("/dev/stdout", res + "\n") in ctfail("lqualify @verify: the evidence package did not verify\n")
## the certificate fields of the signature file: cx = {sha, v_ok: the written package verified with its certificate,
## c_ok: an altered certificate, an altered key file and a replaced key were each rejected}
fn q_sig_cert_json(cx) = ",\"certificate_file\":\"QUALIFICATION_SIGNING_CERT.der\",\"certificate_sha256\":\"" + cx.sha + "\",\"certificate_kind\":\"self-signed X.509 v3, Ed25519 (RFC 8410), basicConstraints CA, keyUsage digitalSignature + keyCertSign; trust anchor = the certificate itself\",\"certificate_subject\":\"O=" + q_cert_org() + ", CN=" + q_cert_cn() + "\",\"certificate_validity\":\"2026-01-01T00:00:00Z .. 2036-01-01T00:00:00Z\",\"certificate_verified_after_write\":" + q_bool(cx.v_ok) + ",\"altered_certificate_or_key_rejected\":" + q_bool(cx.c_ok)
fn q_sig_json(file_sha, head, pkhex, sighex, keypath, fresh, pin, v_ok, t_ok, cx) ="{\"scheme\":\"Ed25519 (RFC 8032), pure Lume implementation compiler/stage1/lcrypto_tls.src\",\"signed_text\":\"lume-qualification-signature-v1\\nevidence_sha256 <evidence_sha256>\\nchain_head <chain_head>\\n\",\"evidence_file\":\"QUALIFICATION_EVIDENCE.json\",\"evidence_sha256\":\"" + file_sha + "\",\"chain_head\":\"" + head + "\",\"public_key\":\"" + pkhex + "\",\"signature\":\"" + sighex + "\",\"key_file\":\"" + q_jesc(keypath) + "\",\"key_generated_in_this_run\":" + q_bool(fresh) + ",\"repository_key\":\"" + (if pin == "" then "none recorded" else if pin == pkhex then "matches" else "DIFFERENT") + "\",\"verified_after_write\":" + q_bool(v_ok) + ",\"altered_copy_rejected\":" + q_bool(t_ok) + q_sig_cert_json(cx) + ",\"what_the_signature_means\":\"the holder of the key file on this host produced this evidence file; the key is a developer key generated by this tool and not protected by hardware; the X.509 certificate next to it is self-signed (its own trust anchor): it states subject, validity and usage of the key and binds it to no identity\"}\n"

## --- documents ---
fn q_disclaimer() = "> **Status of this document.** It is evidence produced by the tool developer with `lume qualify`. It is NOT a\n> qualification and NOT a certification credit. Under DO-330 a tool is qualified per project by the certification\n> authority (and under IEC 61508 / IEC 62304 assessed by the assessor or notified body), with verification that is\n> independent of the developer and against the operational requirements of that project. The open items at the end\n> of the dossier list what this package does not provide.\n\n"
fn q_tor(hs, ls, when) = "# Tool Operational Requirements (TOR) -- Lume tool chain\n\nGenerated by `lume qualify` on " + when + ".\n\n" + q_disclaimer() + "## 1. Tool identification\n\n| Item | Value |\n|---|---|\n| Tool | Lume compiler tool chain: `lumec` (front end, prover, x86-64 code generator), `lasm` (assembler and ELF writer), hosted runtime, `lcaas` / `lcert` (proof service and certificate kernel), `ltv` (translation validator), `ltv_rt` (verifier of the integer runtime helpers), `lsmt` (native checker of the SMT-LIB certificates), `lstack` (static stack bound of `@no_alloc` code), `lproof_cache` (proof cache), `lmcdc` (coverage analyzer), `lsafety_envelope` (lockstep monitor with a clean-room second channel), `lcrypto_tls` (the cryptography that signs this evidence), all driven through `lume` (`lume_driver`) |\n| Version | contents of `VERSION`; exact binaries are identified by SHA-256 in QUALIFICATION_EVIDENCE.json |\n| Host / target | x86-64 Linux (ELF64, static). The AArch64 / RV64 / RV32 integer-kernel back ends are covered by LLR-MARCH-01 only (kernel fragment, emulated execution); every other target is outside this package |\n| Input | Lume-Core `.src` modules |\n| Output | native executables whose object code becomes part of the product |\n\n## 2. Qualification level sought and why\n\n| Standard | Classification | Reason |\n|---|---|---|\n| DO-330 / DO-178C | Criteria 1, TQL-1 for software level A | the tool's output is part of the airborne software and an error could insert an error |\n| IEC 61508-3 | off-line support tool class T3 | the tool generates the executable code of the safety-related system |\n| IEC 62304 | tool producing class C software items | the generated code can contribute to a hazardous situation |\n\n## 3. Operational environment\n\n- Linux on x86-64; the batteries of this package ran on the host recorded in QUALIFICATION_EVIDENCE.json.\n- The tool chain is built from its own sources by the frozen seed (`bootstrap/lume0`, hashes in `SEED_FREEZE.sha256`) and then by itself; no C compiler output is part of the delivered compiler.\n- Use restricted to the integer fragment for the claims of the translation validator and the coverage analyzer (see TQP section 5).\n\n## 4. Tool operational requirements\n\nThe high-level requirements below are the tool operational requirements. Each is refined into low-level requirements, tests and proofs in RTM_TRACEABILITY_MATRIX.md.\n\n| ID | Requirement | Refined by |\n|---|---|---|\n" + q_hlrs_md(hs, ls) + "\n## 5. Conditions of use the user must respect\n\n1. Build with the binaries whose hashes are in the evidence file; rebuild and requalify after any change of the compiler sources.\n2. Treat a `rejected` or `unsupported` verdict of `ltv` as: this function's object code is not covered by translation validation.\n3. Release critical outputs through `lsafety_envelope`; a `SAFE_STATE_TRIP` is not to be overridden by retry.\n4. Keep run-time contract checks enabled; an obligation reported as `runtime_checked` is not proven.\n5. Code that must be constant time at machine level is written as constant-time kernels (`@secret` + `@no_alloc`) and passed through `ltv`: a plain `@secret` function that reaches a runtime helper is rejected ([C0010] is closed over calls), and the property is about the instruction text, not about the micro-architecture.\n6. Use the stack bound of `lstack` together with the [E0210] acceptance of the same source: the bound is exact for the emitted text on the paths that remain under those range proofs, and trap paths and signal frames are outside it.\n7. Give every tool of the chain the artifact the previous tool produced (the certified source, the `.s` the build left, the certificate directory `ltv` wrote) and compare the SHA-256 each report states; `tests/harness/synergy_gate.src` is the reference chain.\n8. Verify a received evidence package with `@verify`; the signing certificate is self-signed, so trust in the key has to come from outside the package (for example the key recorded in the repository).\n"
## --- the limits of the evidence (TQP section 5). lim = {tvi, bc, ctk}: facts read from THIS run, so that the text
## states what ran and not what is planned. tvi = 1 when every ltv report of the module batteries carries
## runtime_helpers_verified and smt2_checked_native (ltv called ltv_rt and lsmt in process); bc = 1 when it carries
## branch_correlation; ctk = 1 when compiler/stage1/lcrypto_tls.src defines constant-time kernels named lct_k_*.
fn q_expect_tvint() = 1
fn q_tv_has(ms, key) = match ms
    Nil        => 1
    Cons(m, t) => if q_has(m.tv, "\"" + key + "\":") == 1 then q_tv_has(t, key) else 0
fn q_lim(cfg, ms) = {tvi: if q_len(ms) > 0 and q_tv_has(ms, "runtime_helpers_verified") == 1 and q_tv_has(ms, "smt2_checked_native") == 1 then 1 else 0, bc: if q_len(ms) > 0 and q_tv_has(ms, "branch_correlation") == 1 then 1 else 0, ctk: q_has(fs_read_file(cfg.root + "/compiler/stage1/lcrypto_tls.src"), "\nfn lct_k_")}
## The module rule for the fields ltv gains when it calls ltv_rt and lsmt in process (workstream tvint). A field that
## is present must hold: runtime_helpers_verified > 0, smt2_checked_native == validated, branch_correlation.uncorrelated
## == 0. An absent field is accepted while q_expect_tvint() is 0 and fails the module when it is 1: FLIP THAT
## CONSTANT once the fields exist.
fn q_tvint1(out, key, want_eq, v) = if q_has(out, "\"" + key + "\":") == 0 then (if q_expect_tvint() == 1 then 0 else 1) else let x = q_field(out, key) in if want_eq == 1 then (if x == v then 1 else 0) else (if x > v then 1 else 0)
fn q_tvint_ok(out) = if q_tvint1(out, "runtime_helpers_verified", 0, 0) == 1 and q_tvint1(out, "smt2_checked_native", 1, q_field(out, "validated")) == 1 and (if q_has(out, "\"branch_correlation\":") == 0 then (if q_expect_tvint() == 1 then 0 else 1) else q_tvint1(out, "uncorrelated", 1, 0)) == 1 then 1 else 0
fn q_limits(lim) = "## 5. Known limits of the evidence\n\n1. `ltv` covers the integer fragment (int/bool parameters, + - * / %, comparisons, and/or, if, let, calls, ctfail, and the constant-time kernels). Functions outside it are reported `unsupported`, never `validated`. `ltv` validates the lowering its linked front end produces; for code built with `--critical` it must be started with that flag too (the synergy gate does), and it has no documented option for it.\n2. `ltv` reasons over the integers: its theorem holds for executions without an i64 overflow trap. Constant-time kernels (`@secret` + `@no_alloc`) are the exception: `ltv` re-derives every range and their theorem has no overflow proviso; its hypothesis is that every argument is an immediate integer, which the entry guard of the kernel enforces by faulting.\n3. The integer runtime helpers (mkint, addv, __rt_sub, __rt_mul, __rt_div, __rt_mod, the wrapping variants, cmpv, eqv, __rt_uint, __rt_un2, __rt_ustk, __rt_cond, __rt_qnext, __rt_idiv, __rt_imod) are no longer unverified axioms: `ltv_rt` verifies the emitted code of each against its specification for all inputs of the modelled cases (gate G-TVRT, probes P-TVRT-*, the synergy gate). " + (if lim.tvi == 1 then "In this run every `ltv` report of the certified modules carries `runtime_helpers_verified`: the helpers of the validated text were verified in the same run." else "In this run the `ltv` reports of the certified modules do NOT carry `runtime_helpers_verified`: the helper verification is a separate tool run on the runtime text that lumec appends to every program, and `ltv` itself still takes the helper specifications as given.") + " What remains assumed: the x86-64 machine model of `ltv_rt` (items X1..X9 of ltv_rt.src), the allocator and the collector behind a boxed result (only the register writes of the allocator fast path are checked), the trap tail `__rt_die3`, and every helper that is not an integer helper (strings, lists, records, I/O): those are tested and stressed, not verified.\n4. The Lean 4 certificates are exported but were not machine-checked unless the evidence file says `lean_checked: true`. The SMT-LIB2 certificates are checked by `lsmt`, a native decision procedure that shares no code with `ltv` (gate G-SMT, probes P-SMT-*, the synergy gate). " + (if lim.tvi == 1 then "In this run every `ltv` report of the certified modules carries `smt2_checked_native`: each exported certificate was checked natively in the same run." else "In this run the `ltv` reports of the certified modules do NOT carry `smt2_checked_native`: the native check ran in the gates named above, not inside each `ltv` run.") + " An external solver (z3) checks them only when it is installed; the `gates` section records `external_solver_ran` for G-SMT. `unsat` establishes that the certificate text is a valid refutation; that its terms describe the source and the emitted assembly is the binding `ltv` makes. `lsmt` was written by the same team as `ltv`.\n5. `lmcdc` measures coverage of the lowered AST the code generator receives. All four certified modules must have 0 uncovered obligations or the qualification fails. A witness is confirmed by the value, or the contract trap, the real binary produces for it. " + (if lim.bc == 1 then "In this run `ltv` reports `branch_correlation` for the certified modules (`uncorrelated` must be 0): each decision of the lowered AST is matched with a conditional jump of the validated object code." else "In this run `ltv` reports no `branch_correlation`: which branch the object code took is not observed, and the link between the lowered AST and the object code is the translation validation of the function as a whole.") + " The witnesses come from the tool's own search over the literals of each function, not from the `test_*` functions of the module. It analyzes the typed int/bool functions that do not call themselves (`typed_integer_functions_in_source` against `functions` in the evidence). The false outcome of the conclusion of a declared law is not exercised: it is unreachable exactly when the law holds, which rests on the proof status of that law.\n6. Channel B of the safety envelope is produced by a clean-room front end and RV32IM code generator inside lsafety_envelope.src; its tool links no compiler module (gate G-ENV and probe P-ENVX-POS-INDEP scan the bundle), so the lumec front end is no longer a common mode of the two channels. Common modes that remain: both channels are given the same kernel text and the same language definition (a wrong specification is implemented twice); the same team wrote both front ends; in lockstep mode both run on one host, one operating system and one clock; the voter and the event log are single; the monitor is a software RV32IM interpreter and, in the split bundle, QEMU: emulators, not silicon, and two processes on one host, not two boards. Its number domain is i32.\n7. The stack bound of `lstack` is computed on the emitted text and is exact for that text on the paths that remain under the [E0210] range proofs (the report lists every slow-path edge it removed and why); over all syntactic paths the bound is unbounded whenever a slow path can box. Trap paths and asynchronous signal frames are outside the model. The latency jitter of gate G-REALTIME is a measurement on this host, not a worst-case execution time.\n8. The runtime beyond the verified integer helpers (collector, boxed values, string and list primitives) and `lasm` are tested and stressed, not formally verified.\n9. QUALIFICATION_EVIDENCE.json is hash-chained and signed with Ed25519 with a developer key that this tool generates and keeps in a file on the host: no hardware (HSM, TPM) protects it. QUALIFICATION_SIGNING_CERT.der is a SELF-SIGNED X.509 v3 certificate for that key, validated against itself as trust anchor: it states subject, validity and usage and binds the key to no identity; no authority issued it. A new key is generated only when the OS entropy health check passes; that check detects a dead, stuck or repeating source and does not measure or certify entropy. The signature shows which key holder produced the file; it is not an attestation by an independent party. The summary files of the gates are covered through their SHA-256 in the `gates` section; the soak ledger and the safety-envelope event log are hash-chained, not signed.\n10. The AArch64, RV64 and RV32 back ends cover the integer kernel fragment only and were executed on emulators (qemu user mode, qemu-system-riscv32, the LumePuter interpreter), not on silicon.\n11. [C0010] is closed over calls: the instructions of every routine a `@secret` function reaches by call or jmp, user functions and runtime text alike, are scanned, and a plain `@secret` function that calls a runtime helper is rejected. It is a property of the instruction text (no secret-dependent conditional branch, no division, no memory access outside the frame). It says nothing about the micro-architecture: caches, speculation, or instructions whose latency depends on their operands on a given CPU. The dudect test of the cryptography gate is a statistical timing test on this host.\n12. The cryptography of `lcrypto_tls.src` is tested against the official vectors and against forgeries; it is not formally verified. " + (if lim.ctk == 1 then "Its primitives that are written as constant-time kernels (`lct_k_*`) are under the machine-level check of item 11; the rest is constant-time by construction at source level only." else "Its constant-time property is by construction at source level: in this tree no primitive is written as a constant-time kernel (`lct_k_*`), so the machine-level check of item 11 does not cover it.") + " X.509 path validation exists for Ed25519 chains with pinned trust anchors: no RSA / ECDSA, no name constraints, no host name or subjectAltName matching, no revocation (CRL, OCSP). TLS 1.3 is one cipher suite and one group, without PSK, 0-RTT, HelloRetryRequest, client certificates or KeyUpdate. The entropy health check is described in item 9.\n13. A neural cartridge is evaluated by the integer forward pass of this tool chain; nothing is claimed about a floating-point inference engine that loads the same file.\n14. `lcert --check-source` binds the fragment its own reader understands (integer functions, laws, `@bound`, direct recursion with a measure, the two SIMD intrinsics); a contract over bit operations is reported unbound, so a constant-time kernel carries no certified `ensures`.\n"
fn q_tqp(when, quick, lim) = "# Tool Qualification Plan (TQP) -- Lume tool chain\n\nGenerated by `lume qualify` on " + when + (if quick == 1 then " (QUICK campaign: sampled gates, NOT FOR CREDIT)" else "") + ".\n\n" + q_disclaimer() + "## 1. Scope\n\nThis plan covers the x86-64 Linux tool chain named in the TOR. It defines the qualification activities that `lume qualify` executes, the pass criteria, and the objectives that remain with the applicant.\n\n## 2. Life-cycle data produced\n\n| Data item | File |\n|---|---|\n| Tool Operational Requirements | TOR_TOOL_OPERATIONAL_REQUIREMENTS.md |\n| Tool Qualification Plan | TQP_TOOL_QUALIFICATION_PLAN.md (this file) |\n| Tool requirements, traceability, verification cases and results | RTM_TRACEABILITY_MATRIX.json / .md |\n| Verification results, configuration index (hashes), hash chain | QUALIFICATION_EVIDENCE.json |\n| Detached Ed25519 signature of the evidence, public key, self-signed X.509 v3 certificate of that key | QUALIFICATION_EVIDENCE.sig.json, QUALIFICATION_SIGNING_KEY.pub, QUALIFICATION_SIGNING_CERT.der |\n| Machine-readable gate summaries, hash-linked into the evidence chain | safety_envelope_gate_summary.json, realtime_gate_summary.json, synergy_gate_summary.json, synergy_gate_evidence.manifest / .sig.json, tv_rt_gate_accepted_same_behaviour.txt |\n| Tool accomplishment summary (draft) | QUALIFICATION_DOSSIER.md |\n| Translation validation certificates | proofs/*.smt2, proofs/*.lean |\n| Soak campaign ledger | battle_telemetry_ledger.json |\n| Safety envelope event log | safety_envelope_events.jsonl |\n\n## 3. Qualification activities and pass criteria\n\n| Activity | Means | Pass criterion |\n|---|---|---|\n| Requirements-based testing, normal range | positive probes (a real program is compiled, assembled, run) | expected output, exit 0 |\n| Requirements-based testing, robustness | negative probes | the stated diagnostic code, non-zero exit, no object code |\n| Verification of the verification (test of the tests) | mutation gates: `tv_gate`, `claude_audit_gate`, `prover_fuzz_gate`; negative control of the matrix checker | every behaviour-changing mutant rejected; no false theorem proven |\n| Compiler correctness, back end | `ltv` over the certified modules, native boundary run | 0 rejected; native vectors agree |\n| Compiler correctness, assembler | `lasm_gate` against GNU as | byte-identical encodings |\n| Compiler integrity | bootstrap fixpoint, seed freeze, diverse double compilation | stage 2 == stage 3; hashes match; DDC identical |\n| Structural coverage of the certified kernels | `lmcdc` (decision + masking MC/DC), witnesses run on the real binary | every certified module: 0 uncovered obligations, or the module and the qualification FAIL; every witness agrees with the real binary |\n| Robustness and stress | `soak_battle_gate`, hash-chained ledger | all invariants hold; chain verifies |\n| Dissimilar monitoring | `safety_envelope_gate` | 0 false negatives over the injected faults; no compiler function in the tool of channel B; every front-end and code-generator mutant of one channel trips or is masked on every vector |\n| Runtime helpers | `tv_rt_gate` | every integer helper of the emitted runtime verified; every behaviour-changing mutant rejected (0 unsound acceptances) |\n| Proof certificates of the translation validator | `smt_cert_gate` | every exported .smt2 `unsat` for `lsmt` (and for the external solver when installed: recorded); no forged or sat mutant accepted |\n| Proof service at scale | `lcaas_scale_gate` | no mode adds a term of higher degree to the run time of the compiler alone |\n| Composition of the tools | `synergy_gate` | every stage of the chain passes on the artifact of the previous stage; every row of the tamper matrix is refused by the downstream tool (0 undetected) |\n| Driver and command-line parity | `native_driver_gate` | every announced command dispatched; help, manuals, README and SKILL agree with the dispatch table |\n| Source-level debugging data and proof reuse | `dwarf_cache_gate` | line tables decode to the source lines; cache hits only for unchanged, sealed records |\n| Concurrency restrictions | `concurrency_gate` | every use-after-send and lock-order violation rejected; worker runs deterministic |\n| Cryptography used for evidence | `crypto_tls_gate` | every official vector reproduced; every forgery rejected |\n| Other instruction sets (kernel fragment) | `multi_arch_gate` | official encodings; same results on every executor; every function image validated; at least 95% of single-bit mutants rejected |\n| Binding of certificates to sources | `cert_source_gate` | every forged certificate the plain kernel accepts is refused by `lcert --check-source` |\n| Hard real-time options | `realtime_gate` | every allocation path rejected with [E0210]; zero allocations measured on accepted kernels; the static stack bytes of `lstack` equal the painted high-water mark on the worst-case vectors; code without a bound rejected; jitter percentiles recorded |\n| Neural cartridges | `safetensors_gate` | forward pass equals native and monitor results; tampered files rejected |\n| Evidence integrity | hash chain, Ed25519 signature and self-signed X.509 certificate of the key, written and re-verified by `lqualify` | signature and certificate verify after writing; an altered evidence file, an altered certificate, an altered key file and a replaced key are each rejected |\n| Traceability | matrix check in `lqualify` | every requirement fully traced, no orphan, no uncited test |\n\n## 4. Objectives outside this package (remain with the applicant / assessor)\n\n| Objective | Why it is open |\n|---|---|\n| Independence of verification (DO-330 section 6, DO-178C objectives with independence) | all activities here were performed by the tool developer |\n| Tool operational requirements of the project, and validation of the TOR in the project's operational environment | this TOR is generic |\n| Configuration management, quality assurance and certification liaison records (DO-330 sections 7, 8, 9) | process records, not produced by a program |\n| Review of requirements, design and source code by qualified persons | not automatable |\n| Structural coverage of the tool's own source code (DO-330 for TQL-1) | measured here for the certified kernels, not for the compiler's own sources |\n| Object-code level verification of what `ltv` does not model | see section 5 |\n| Qualification of the hardware / operating system platform | out of scope |\n\n" + q_limits(lim)
fn q_list_md(xs) = match xs
    Nil        => "(none)"
    Cons(h, t) => h + (if q_len(t) == 0 then "" else ", " + q_list_md(t))
fn q_rtm_md(cfg, hs, ls, ev, ps, rt, when) = "# Requirements Traceability Matrix -- Lume tool chain\n\nGenerated by `lume qualify` on " + when + ". Verdict of the matrix check: **" + (if q_rtm_clean(rt) == 1 then "VERIFIED" else "NOT VERIFIED") + "**.\n\n" + q_disclaimer() + "A low-level requirement is TRACED only when all of the following hold at the time of this run: every cited high-level requirement exists, every cited source file exists on disk, every cited positive test passed, every cited negative test passed, and every cited mutation gate or proof battery passed.\n\n- requirements not fully traced: " + q_list_md(rt.untraced) + "\n- high-level requirements without a child: " + q_list_md(rt.childless) + "\n- probes or gates no requirement cites: " + q_list_md(rt.uncited) + "\n- negative control of the checker (a matrix with one orphaned and one untested requirement must be rejected): " + q_mark(ev.self_neg) + "\n\n## High-level requirements\n\n| ID | Requirement | Low-level requirements |\n|---|---|---|\n" + q_hlrs_md(hs, ls) + "\n## Low-level requirements\n\n| ID | Requirement | Parents | Source files | Positive tests | Negative tests | Mutation gates / proofs | Status |\n|---|---|---|---|---|---|---|---|\n" + q_llrs_md(cfg, hs, ev, ls) + "\n## Probes\n\n| ID | Kind | Result |\n|---|---|---|\n" + q_probes_md(ps, ev.probes) + "\nEvidence identifiers starting with `G-` are gate binaries, `M-` the module batteries (translation validation, coverage, proof status of the certified modules), `S-` the self-checks of the matrix checker; their outputs are in QUALIFICATION_EVIDENCE.json.\n"
fn q_sig_md(sg) = "## 5. Evidence integrity (hash chain and signature)\n\n| Item | Value |\n|---|---|\n| QUALIFICATION_EVIDENCE.json SHA-256 | `" + sg.fsha + "` |\n| Chain head (probes, gates, modules, trusted computing base, summary) | `" + sg.head + "` |\n| Evidence file this run replaced (SHA-256, first link of the chain) | " + (if sg.prev == "" then "none" else "`" + sg.prev + "`") + " |\n| Signature scheme | Ed25519 (RFC 8032), `compiler/stage1/lcrypto_tls.src` |\n| Public key | " + (if sg.pk == "" then "NONE (" + sg.err + ")" else "`" + sg.pk + "`") + " |\n| Signature (QUALIFICATION_EVIDENCE.sig.json) | `" + sg.sig + "` |\n| Key file | `" + sg.keypath + "`" + (if sg.fresh == 1 then " (generated in this run)" else "") + " |\n| Key recorded in docs/certification/QUALIFICATION_SIGNING_KEY.pub | " + (if sg.pin == "" then "none recorded" else if sg.pin == sg.pk then "matches" else "**DIFFERENT**") + " |\n| Signature verified after the files were written | " + q_mark(sg.v_ok) + " |\n| Altered copy of the evidence rejected | " + q_mark(sg.t_ok) + " |\n| Signing certificate (QUALIFICATION_SIGNING_CERT.der) SHA-256 | " + (if sg.xsha == "" then "NONE" else "`" + sg.xsha + "`") + " |\n| Certificate kind | self-signed X.509 v3, Ed25519 (RFC 8410); subject `O=" + q_cert_org() + ", CN=" + q_cert_cn() + "`; valid 2026-01-01T00:00:00Z .. 2036-01-01T00:00:00Z; basicConstraints CA, keyUsage digitalSignature + keyCertSign |\n| Certificate validated as its own trust anchor and certifies the signing key (lct_x509_verify_chain) | " + q_mark(sg.v_ok) + (if sg.why == "" then "" else " (" + sg.why + ")") + " |\n| Altered certificate, altered key file, replaced key and missing certificate each rejected | " + q_mark(sg.c_ok) + " |\n\nRe-check with `printf '@verify <this directory>\\n@root <repo>\\n' | build/bin/lqualify` (optional `@now <seconds since 1970>`; the time of the host otherwise). The signature says that the holder of the key file on this host produced the evidence file. The key is a developer key generated by this tool (the seed is drawn from the kernel CSPRNG and used only when the OS entropy health check passes); no hardware protects it. The certificate is SELF-SIGNED: it is its own trust anchor, it was issued by no authority, and it binds the key to no identity. What it adds is a standard statement of subject, validity and usage that `@verify` checks with the X.509 path validation of `lcrypto_tls.src`; trust in the key itself has to come from outside this package.\n\n"
fn q_dossier(cfg, hs, ls, ev, ms, tcb, rt, when, quick, verdict, host, sg) = "# Qualification Dossier (draft tool accomplishment summary) -- Lume tool chain\n\nGenerated by `lume qualify` on " + when + " on host `" + host + "`.\n\n**Result of this run: " + verdict + "**" + (if quick == 1 then " -- QUICK campaign (sampled gates), NOT FOR CREDIT" else "") + "\n\n" + q_disclaimer() + "## 1. Summary\n\n| Item | Result |\n|---|---|\n| Probes (positive and negative requirement tests) | " + str(q_count_ok(ev, q_probe_ids(ev.probes))) + " of " + str(q_len(ev.probes)) + " passed |\n| Gates | " + str(q_gates_passed(ev.gates)) + " of " + str(q_len(ev.gates)) + " passed |\n| Requirements | " + str(q_len(hs)) + " high-level, " + str(q_len(ls)) + " low-level, " + str(q_len(ls) - q_len(rt.untraced)) + " fully traced |\n| Traceability matrix | " + (if q_rtm_clean(rt) == 1 then "VERIFIED" else "NOT VERIFIED") + " |\n| Functions translation-validated (rejected) | " + str(q_mods_sum(ms, "validated")) + " (" + str(q_mods_sum(ms, "rejected")) + ") |\n| Functions outside the validated fragment | " + str(q_mods_sum(ms, "unsupported")) + " |\n| Native boundary vectors agreeing with the AST | " + str(q_mods_sum(ms, "native_vectors")) + " |\n| Proof obligations proven / budget-checked / runtime-checked / refuted | " + str(q_mods_sum(ms, "proven")) + " / " + str(q_mods_sum(ms, "budget")) + " / " + str(q_mods_sum(ms, "runtime")) + " / " + str(q_mods_sum(ms, "refuted")) + " |\n| Coverage obligations (decision + MC/DC) | " + str(q_mods_sum(ms, "mc:obligations")) + " |\n| ... covered by a witness the real binary confirmed | " + str(q_mods_sum(ms, "mc:covered")) + " |\n| ... false outcome of the conclusion of a declared law (not exercised; justified by the proof status of the law, not by `lmcdc`) | " + str(q_mods_sum(ms, "mc:theorem_false_unreachable")) + " |\n| ... infeasible, proved by the lcert kernel | " + str(q_mods_sum(ms, "mc:infeasible_proved_by_kernel")) + " |\n| ... uncovered (must be 0 in every certified module) | " + str(q_mods_sum(ms, "mc:uncovered")) + " |\n\n## 2. Certified modules\n\n| Module | Result | ltv validated / rejected / unsupported | Native vectors | proven / budget / runtime / refuted | Coverage obligations | Covered | Law conclusion false | Infeasible (proved) | Uncovered | Native witnesses |\n|---|---|---|---|---|---|---|---|---|---|---|\n" + q_mods_md(ms) + "\nAll four certified modules are in the MC/DC-qualified set (`(must be 0)`): an uncovered obligation in any of them fails that module and the qualification. An uncovered obligation is listed in QUALIFICATION_EVIDENCE.json (`uncovered_list`); it is closed by removing dead or redundant code, by a contract that lets the kernel prove the outcome infeasible (`infeasible_list` gives each proof term), or by making the outcome reachable for the witness search, never by marking it.\n\n## 3. Gates\n\n" + q_gates_md(ev.gates) + "## 4. Trusted computing base (SHA-256 of this run)\n\n| File | SHA-256 |\n|---|---|\n" + q_tcb_md(tcb) + "\n- stage 2 == stage 3: " + (if q_tcb_sha(tcb, "build/bootstrap/lumec2") != "" and q_tcb_sha(tcb, "build/bootstrap/lumec2") == q_tcb_sha(tcb, "build/bootstrap/lumec3") then "the two files above have the same hash" else "NOT CONFIRMED by the hashes above") + "; gate G-BOOT is the check that compares them byte for byte.\n- seed-built versus self-built compiler (diverse double compilation): see the output of gate G-AUDIT.\n\n" + q_sig_md(sg) + "## 6. Open items\n\n1. Independence: every activity above was run by the tool developer. An independent party has to repeat or review them.\n2. This is not a qualification: no authority has reviewed or accepted this package.\n3. The limits listed in TQP section 5: integer fragment and overflow-free executions for `ltv`; the machine model, the allocator and the non-integer helpers behind the verified integer runtime helpers; Lean certificates not machine-checked, SMT-LIB certificates checked natively and by an external solver only when one is installed; coverage measured on the lowered AST; a clean-room second channel that still shares the kernel text, the language definition, the authors and, in lockstep mode, the host; emulators instead of silicon; a stack bound that is conditional on the range proofs; a constant-time property of the instruction text only; cryptography tested against vectors and not formally verified; a developer-held signing key under a self-signed certificate.\n4. " + str(q_mods_sum(ms, "unsupported")) + " functions of the certified modules are outside the translation-validated fragment.\n5. " + str(q_mods_sum(ms, "mc:uncovered")) + " coverage obligations have neither a witness nor an infeasibility proof (any number other than 0 fails the qualification); " + str(q_mods_sum(ms, "mc:theorem_false_unreachable")) + " are false outcomes of law conclusions, justified by the proof status of the laws and not exercised.\n6. Structural coverage of the compiler's own sources, configuration management, quality assurance and review records are not part of this package.\n"
fn q_probe_ids(rs) = match rs
    Nil        => Nil
    Cons(r, t) => Cons(r.id, q_probe_ids(t))
fn q_gates_passed(gs) = match gs
    Nil        => 0
    Cons(g, t) => g.ok + q_gates_passed(t)
fn q_probes_passed(rs) = match rs
    Nil        => 0
    Cons(r, t) => r.ok + q_probes_passed(t)
fn q_first_fail(rs) = match rs
    Nil        => ""
    Cons(r, t) => if r.ok == 0 then r.id + ": " + r.note else q_first_fail(t)
fn q_first_gate_fail(gs) = match gs
    Nil        => ""
    Cons(g, t) => if g.ok == 0 then g.id + ": " + g.line else q_first_gate_fail(t)
fn q_first_failure(prs, ms, gs, skip) = let a = q_first_fail(prs) in if a != "" then a else let b = q_first_mod_fail(ms) in if b != "" then b else if skip == 1 then "" else q_first_gate_fail(gs)
fn q_first_mod_fail(ms) = match ms
    Nil        => ""
    Cons(m, t) => if m.ok == 0 then m.path + ": " + m.note else q_first_mod_fail(t)

## --- unit tests of the requirement tables (`./lume test compiler/stage1/lqualify.src`, run from the repository root) ---
## The matrix is checked here with every probe and gate result SET to pass: that says nothing about the tools (the
## campaign does), it shows that the tables are closed -- every requirement has a parent, files that exist, a positive
## test, a negative test and a gate; every high-level requirement has a child; every probe and gate is cited -- and
## that the checker still rejects the orphaned matrix and a single failing gate.
fn q_t_probes(ps) = match ps
    Nil        => Nil
    Cons(p, t) => Cons(q_res(p.id, 1, ""), q_t_probes(t))
fn q_t_gates(gs, failing) = match gs
    Nil        => Nil
    Cons(g, t) => Cons({id: g.id, title: g.title, ok: if g.id == failing then 0 else 1, status: 0, ms: 0, line: "", sha: "", sums: "", more: ""}, q_t_gates(t, failing))
fn q_t_ev(failing) = {probes: q_t_probes(q_probes()), gates: q_t_gates(q_gates(0), failing), mods_ok: 1, self_pos: 1, self_neg: 1, sig_pos: 1, sig_neg: 1, cert_pos: 1, cert_neg: 1}
fn q_t_cfg() = {root: ".", tmp: "/tmp", bin: "./build/bin"}
fn test_q_rtm_tables_are_closed() = let rt = q_rtm_check(q_t_cfg(), q_hlrs(), q_llrs(), q_t_ev("")) in if q_rtm_clean(rt) == 1 and q_len(q_hlrs()) == 10 and q_len(q_llrs()) == 44 and q_len(q_probes()) == 106 and q_len(q_gates(0)) == 21 and q_len(q_gates(1)) == 21 then 1 else 0
fn test_q_rtm_negative_controls() = let ls = q_llrs() in let bad = q_rtm_check(q_t_cfg(), q_hlrs(), q_orphan(ls), q_t_ev("")) in let syn = q_rtm_check(q_t_cfg(), q_hlrs(), ls, q_t_ev("G-SYNERGY")) in let smt = q_rtm_check(q_t_cfg(), q_hlrs(), ls, q_t_ev("G-SMT")) in if q_rtm_clean(bad) == 0 and q_same(bad.untraced, q_first2(ls)) == 1 and q_same(syn.untraced, q_s1("LLR-SYN-01")) == 1 and q_same(smt.untraced, q_s1("LLR-LTV-03")) == 1 then 1 else 0
fn test_q_gate_tables() = if q_gate_src(".", "native_driver_gate") == "tests/cli/driver_gate.src" and q_gate_src(".", "synergy_gate") == "tests/harness/synergy_gate.src" and q_gate_src(".", "lume_make") == "" and q_mem(q_gate_deps("G-REALTIME"), "lstack") == 1 and q_mem(q_gate_deps("G-MARCH"), "lsafety_envelope") == 1 and q_mem(q_gate_deps("G-MARCH"), "/usr/bin/qemu-system-riscv32") == 1 and q_mem(q_gate_deps("G-MARCH"), "/usr/bin/qemu-aarch64") == 1 and q_mem(q_gate_deps("G-MARCH"), "/usr/bin/qemu-riscv64") == 1 and q_mem(q_gate_sums("G-SYNERGY"), "synergy_gate_summary.json") == 1 and q_mem(q_gate_sums("G-ENV"), "safety_envelope_gate_summary.json") == 1 and q_mem(q_gate_sums("G-REALTIME"), "realtime_gate_summary.json") == 1 and q_gate_more("G-SMT", "{\"ok\":true,\"gate\":\"smt_cert\",\"external_solver\":\"/usr/bin/z3\",\"external_solver_ran\":true}") == ",\"external_solver\":\"/usr/bin/z3\",\"external_solver_ran\":true" and q_gate_more("G-TV", "x") == "" then 1 else 0
fn test_q_tvint_rule() = if q_tvint_ok("{\"validated\":6,\"rejected\":0}") == 1 - q_expect_tvint() and q_tvint_ok("{\"validated\":6,\"runtime_helpers_verified\":18,\"smt2_checked_native\":6,\"branch_correlation\":{\"uncorrelated\":0}}") == 1 and q_tvint_ok("{\"validated\":6,\"runtime_helpers_verified\":0,\"smt2_checked_native\":6,\"branch_correlation\":{\"uncorrelated\":0}}") == 0 and q_tvint_ok("{\"validated\":6,\"runtime_helpers_verified\":18,\"smt2_checked_native\":5,\"branch_correlation\":{\"uncorrelated\":0}}") == 0 and q_tvint_ok("{\"validated\":6,\"runtime_helpers_verified\":18,\"smt2_checked_native\":6,\"branch_correlation\":{\"uncorrelated\":2}}") == 0 then 1 else 0

fn q_main(input) = let vdir = q_get(input, "verify") in if vdir != "" then q_verify_main(vdir, q_get(input, "root"), q_get(input, "now")) else q_qualify(input)
fn q_qualify(input) = let root = q_get(input, "root") in if root == "" then ctfail("lqualify requires @root\n") else let quick = if q_get(input, "quick") == "1" then 1 else 0 in let skip = if q_get(input, "skip-gates") == "1" then 1 else 0 in let cert = root + "/build/certification" in let tmp = "/tmp/lume-qualify." + str(os_getpid()) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(cert, Cons(tmp + "/proofs", Cons(tmp + "/envelope", Nil))))) in let cfg = {root: root, tmp: tmp, bin: root + "/build/bin"} in let dt = q_run("/bin/date", Cons("-u", Cons("+%Y-%m-%dT%H:%M:%SZ", Nil)), tmp + "/date", 10000) in let when = q_chomp(dt.out) in let un = q_run("/bin/uname", Cons("-srm", Nil), tmp + "/uname", 10000) in let host = q_chomp(un.out) in let t0 = os_monotonic_ns() in let ps = q_probes() in let prs = q_run_probes(cfg, ps) in let ms = q_run_modules(cfg, q_modules(), 0) in let gs = if skip == 1 then q_skip_gates(q_gates(quick)) else q_run_gates(cfg, q_gates(quick)) in let hs = q_hlrs() in let ls = q_llrs() in let tcb = q_tcb(root, q_tcb_files()) in let probes_json = q_probes_json(ps, prs) in let gates_json = q_gates_json(gs) in let mods_json = q_mods_json(ms) in let tcb_json = q_tcb_json(tcb) in let ep = cert + "/QUALIFICATION_EVIDENCE.json" in let prev = if fs_path_exists(ep) == 1 then fs_sha256_file(ep) else "" in let dc = q_data_chain(prev, probes_json, gates_json, mods_json, tcb_json) in let keypath = if q_get(input, "sign-key") != "" then q_get(input, "sign-key") else "/root/.lume/keys/qualification_ed25519.seed" in let key = q_key_load(keypath) in let seedb = lct_hex_to_bytes(key.seed) in let pkb = if key.err == "" then lct_ed25519_public_key(seedb) else Nil in let pkhex = lct_bytes_to_hex(pkb) in let now = q_now(tmp + "/now") in let xcb = if key.err == "" then q_cert_make(seedb) else Nil in let cert_pos = (q_cert_check(xcb, pkhex, now)).ok in let cert_neg = if key.err == "" then q_cert_neg(xcb, seedb, pkhex, now) else 0 in let cmsg =lct_str_to_bytes(q_sig_text("data-sections-only", dc.c4)) in let canary = if key.err == "" then lct_ed25519_sign(seedb, cmsg) else Nil in let sig_pos = if key.err == "" and lct_ed25519_verify(pkb, cmsg, canary) == 1 then 1 else 0 in let dc_bad = q_data_chain(prev, probes_json, gates_json + " ", mods_json, tcb_json) in let sig_neg = if key.err == "" and dc_bad.c4 != dc.c4 and lct_ed25519_verify(pkb, lct_str_to_bytes(q_sig_text("data-sections-only", dc_bad.c4)), canary) == 0 then 1 else 0 in let mods_ok = q_mods_ok(ms) in let ev0 = {probes: prs, gates: gs, mods_ok: mods_ok, self_pos: 1, self_neg: 1, sig_pos: sig_pos, sig_neg: sig_neg, cert_pos: cert_pos, cert_neg: cert_neg} in let bad = q_rtm_check(cfg, hs, q_orphan(ls), ev0) in let self_neg = if q_rtm_clean(bad) == 0 and q_same(bad.untraced, q_first2(ls)) == 1 then 1 else 0 in let rt0 = q_rtm_check(cfg, hs, ls, {probes: prs, gates: gs, mods_ok: mods_ok, self_pos: 1, self_neg: self_neg, sig_pos: sig_pos, sig_neg: sig_neg, cert_pos: cert_pos, cert_neg: cert_neg}) in let ev = {probes: prs, gates: gs, mods_ok: mods_ok, self_pos: q_rtm_clean(rt0), self_neg: self_neg, sig_pos: sig_pos, sig_neg: sig_neg, cert_pos: cert_pos, cert_neg: cert_neg} in let rt = q_rtm_check(cfg, hs, ls, ev) in let all_ok = if q_probes_passed(prs) == q_len(prs) and q_gates_passed(gs) == q_len(gs) and mods_ok == 1 and q_rtm_clean(rt) == 1 and self_neg == 1 and sig_pos == 1 and sig_neg == 1 and cert_pos == 1 and cert_neg == 1 then 1 else 0 in let verdict =if all_ok == 1 then (if quick == 1 then "PASS (quick campaign)" else "PASS") else if skip == 1 then "INCOMPLETE (gates not run)" else "FAIL" in let ms_total = (os_monotonic_ns() - t0) / 1000000 in let w1 = fs_write_sync(cert + "/TOR_TOOL_OPERATIONAL_REQUIREMENTS.md", q_tor(hs, ls, when)) in let w2 = fs_write_sync(cert + "/TQP_TOOL_QUALIFICATION_PLAN.md", q_tqp(when, quick, q_lim(cfg, ms))) in let w3 = fs_write_sync(cert + "/RTM_TRACEABILITY_MATRIX.md", q_rtm_md(cfg, hs, ls, ev, ps, rt, when)) in let w4 = fs_write_sync(cert + "/RTM_TRACEABILITY_MATRIX.json", "{\"generated\":\"" + when + "\",\"verified\":" + q_bool(q_rtm_clean(rt)) + ",\"untraced\":[" + q_strs_json(rt.untraced) + "],\"hlr_without_child\":[" + q_strs_json(rt.childless) + "],\"uncited_tests\":[" + q_strs_json(rt.uncited) + "],\"checker_negative_control\":" + q_bool(self_neg) + ",\"hlr\":[" + q_hlrs_json(hs, ls) + "],\"llr\":[" + q_llrs_json(cfg, hs, ev, ls) + "]}\n") in let summary = "{\"ok\":" + q_bool(all_ok) + ",\"tool\":\"lqualify\",\"verdict\":\"" + verdict + "\",\"campaign\":\"" + (if skip == 1 then "probes-only" else if quick == 1 then "quick" else "full") + "\",\"generated\":\"" + when + "\",\"host\":\"" + q_jesc(host) + "\",\"duration_ms\":" + str(ms_total) + ",\"not_a_certification\":\"developer evidence package; qualification is granted per project by the authority or assessor and needs independent verification\",\"probes_passed\":" + str(q_probes_passed(prs)) + ",\"probes_total\":" + str(q_len(prs)) + ",\"gates_passed\":" + str(q_gates_passed(gs)) + ",\"gates_total\":" + str(q_len(gs)) + ",\"hlr\":" + str(q_len(hs)) + ",\"llr\":" + str(q_len(ls)) + ",\"llr_fully_traced\":" + str(q_len(ls) - q_len(rt.untraced)) + ",\"rtm_verified\":" + q_bool(q_rtm_clean(rt)) + ",\"rtm_checker_negative_control\":" + q_bool(self_neg) + ",\"functions_translation_validated\":" + str(q_mods_sum(ms, "validated")) + ",\"functions_rejected\":" + str(q_mods_sum(ms, "rejected")) + ",\"functions_outside_fragment\":" + str(q_mods_sum(ms, "unsupported")) + ",\"native_boundary_vectors\":" + str(q_mods_sum(ms, "native_vectors")) + ",\"obligations_proven\":" + str(q_mods_sum(ms, "proven")) + ",\"obligations_budget_checked\":" + str(q_mods_sum(ms, "budget")) + ",\"obligations_runtime_checked\":" + str(q_mods_sum(ms, "runtime")) + ",\"obligations_refuted\":" + str(q_mods_sum(ms, "refuted")) + ",\"mcdc_obligations\":" + str(q_mods_sum(ms, "mc:obligations")) + ",\"mcdc_covered\":" + str(q_mods_sum(ms, "mc:covered")) + ",\"mcdc_theorem_false\":" + str(q_mods_sum(ms, "mc:theorem_false_unreachable")) + ",\"mcdc_infeasible_proved\":" + str(q_mods_sum(ms, "mc:infeasible_proved_by_kernel")) + ",\"mcdc_uncovered\":" + str(q_mods_sum(ms, "mc:uncovered")) + ",\"mcdc_native_witnesses\":" + str(q_mods_sum(ms, "mc:native_witnesses_agreeing")) + ",\"first_failure\":\"" + q_jesc(q_first_failure(prs, ms, gs, skip)) + "\",\"evidence_signature\":{\"scheme\":\"Ed25519\",\"public_key\":\"" + pkhex + "\",\"data_sections_signature_verifies\":" + q_bool(sig_pos) + ",\"altered_data_section_rejected\":" + q_bool(sig_neg) + ",\"key_error\":\"" + q_jesc(key.err) + "\",\"signature_file\":\"QUALIFICATION_EVIDENCE.sig.json\",\"certificate_file\":\"QUALIFICATION_SIGNING_CERT.der\",\"certificate_sha256\":\"" + (if lct_len(xcb) == 0 then "" else lct_bytes_to_hex(lct_sha256(xcb))) + "\",\"certificate_is\":\"self-signed X.509 v3 for the signing key, its own trust anchor: no identity assurance\",\"certificate_validates_and_certifies_the_key\":" + q_bool(cert_pos) + ",\"altered_or_foreign_or_expired_certificate_rejected\":" + q_bool(cert_neg) + "},\"artifacts\":\"" + cert + "\"}" in let head = q_chain_head(dc.c4, summary) in let ev_text = q_evidence_text(summary, probes_json, gates_json, mods_json, tcb_json, q_chain_json(prev, dc, head)) in let w5 = fs_write_sync(ep, ev_text) in let fsha = lc_sha256(ev_text) in let sgb = if key.err == "" then lct_ed25519_sign(seedb, lct_str_to_bytes(q_sig_text(fsha, head))) else Nil in let sighex = lct_bytes_to_hex(sgb) in let pin = q_pinned_key(root) in let wk = if pkhex == "" then 0 else fs_write_sync(cert + "/QUALIFICATION_SIGNING_KEY.pub", pkhex + "\n") in let wx = if lct_len(xcb) == 0 then os_run("/bin/rm", Cons("-f", Cons(cert + "/QUALIFICATION_SIGNING_CERT.der", Nil))) else fs_write_hex_file(cert + "/QUALIFICATION_SIGNING_CERT.der", lct_bytes_to_hex(xcb)) in let xback = if lct_len(xcb) == 0 then Nil else q_bytes_at(cert + "/QUALIFICATION_SIGNING_CERT.der", 0) in let xsha = if lct_len(xback) == 0 then "" else lct_bytes_to_hex(lct_sha256(xback)) in let sig0 = q_sig_json(fsha, head, pkhex, sighex, keypath, key.fresh, pin, 0, 0, {sha: xsha, v_ok: 0, c_ok: 0}) in let kback = q_file_or_empty(cert + "/QUALIFICATION_SIGNING_KEY.pub") in let v = q_verify_pkg(fs_read_file(ep), sig0, xback, kback, now) in let altered = q_rep1(ev_text, "\"pass\":true", "\"pass\":false", 0) in let vt = q_verify_pkg(altered, sig0, xback, kback, now) in let t_ok = if altered != ev_text and vt.ok == 0 then 1 else 0 in let opk = lct_bytes_to_hex(lct_ed25519_public_key(lct_sha256(seedb))) in let n1 = q_verify_pkg(ev_text, sig0, lct_flip(xback, 40, 1), kback, now) in let n2 = q_verify_pkg(ev_text, sig0, xback, q_flip_digit(pkhex, 3) + "\n", now) in let n3 = q_verify_pkg(ev_text, q_rep1(sig0, "\"public_key\":\"" + pkhex, "\"public_key\":\"" + opk, 0), xback, opk + "\n", now) in let n4 = q_verify_pkg(ev_text, sig0, Nil, kback, now) in let c_ok = if key.err == "" and n1.ok == 0 and n2.ok == 0 and n3.ok == 0 and n4.ok == 0 then 1 else 0 in let w6 = fs_write_sync(cert + "/QUALIFICATION_EVIDENCE.sig.json", q_sig_json(fsha, head, pkhex, sighex, keypath, key.fresh, pin, v.ok, t_ok, {sha: xsha, v_ok: v.ok, c_ok: c_ok})) in let final_ok = if all_ok == 1 and v.ok == 1 and t_ok == 1 and c_ok == 1 then 1 else 0 in let verdict2 = if final_ok == 1 or all_ok == 0 then verdict else "FAIL (the signed evidence did not verify after it was written, or an altered certificate / key was accepted: " + v.why + ")" in let sg = {fsha: fsha, head: head, prev: prev, pk: pkhex, sig: sighex, keypath: keypath, fresh: key.fresh, pin: pin, v_ok: v.ok, t_ok: t_ok, err: key.err, xsha: xsha, c_ok: c_ok, why: v.why} in let w7 = fs_write_sync(cert + "/QUALIFICATION_DOSSIER.md", q_dossier(cfg, hs, ls, ev, ms, tcb, rt, when, quick, verdict2, host, sg)) in let rm = if final_ok == 1 then os_run("/bin/rm", Cons("-rf", Cons(tmp, Nil))) else 0 in q_finish(summary, final_ok)
fn q_finish(json, ok) = if ok == 1 then json else let w = fs_write_sync("/dev/stdout", json + "\n") in ctfail("lqualify: the qualification battery did not pass; the summary is on stdout and the details are in build/certification/\n")

print q_main(readall())
