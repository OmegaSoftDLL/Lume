## process.src -- Lume standard library: safe process abstractions (`std.process`, issue #406).
## Import with `use process` (spec-level name `std.process`; the bundler strips
## the `std.` prefix). Surface `.src` files write the bare module name: the
## canonical formatter does not preserve dotted `std.` imports yet. Exports
## carry the `sprc_` prefix (flat bundled namespace, like `sfile_`, `actor_`).
##
## Composes the native fork/execve/wait4 runtime (`os_run_capture`,
## `os_run_input_capture_timeout`, `os_last_timed_out`) into records with
## structured errors -- no shell, no stringly status, no raw crash:
## - `sprc_run_collect(cmd_path, args)`: run a binary and capture its streams into
##   {status, stdout, stderr, err}. Fail-closed on a missing binary: the record
##   carries `status: -1` and `err: "not_found"`, and the process is never spawned.
## - `sprc_run_input(cmd_path, args, stdin_text, timeout_ms)`: write `stdin_text`
##   to a deterministic scratch file, forward it as the child's stdin, enforce the
##   millisecond deadline, and report {status, stdout, stderr, timed_out, err}.
##   After the run the scratch input is truncated back to empty: bounded cleanup by
##   deterministic reuse, because the runtime has no `fs_remove` yet.
## - `sprc_tmp_write(text)` / `sprc_exit_code(status)`: the two small pieces above,
##   exported for reuse and testing.
##
## `status` is the raw wait4 status, exactly like `os_run`: 0 for exit 0, N*256
## for exit N, negative only when a guard rejected the call before spawning.
## Guards run cheapest-first: timeout, then binary presence, then scratch write.
## Limits: capture scratch files use fixed names in the caller's working directory
## (one capture at a time per directory), and `args` is a Cons/Nil list of exact
## argument strings (never a shell line).

fn sprc_run_collect(cmd_path, args) = if fs_path_exists(cmd_path) == 0 then {status: 0 - 1, stdout: "", stderr: "", err: "not_found"} else let status = os_run_capture(cmd_path, args, "std_process_stdout_probe", "std_process_stderr_probe") in {status: status, stdout: fs_read_file("std_process_stdout_probe"), stderr: fs_read_file("std_process_stderr_probe"), err: ""}

## Decode a raw wait status: exit code N reports as N*256; negative statuses are
## the wrapper's own rejections and pass through unchanged.
fn sprc_exit_code(status) = if status < 0 then status else status / 256

fn sprc_tmp_write(text) = if fs_write_sync("std_process_stdin_probe", text) == 1 then {ok: 1, path: "std_process_stdin_probe", err: ""} else {ok: 0, path: "", err: "input_write_failed"}

fn sprc_run_input(cmd_path, args, stdin_text, timeout_ms) = if timeout_ms <= 0 then {status: 0 - 1, stdout: "", stderr: "", timed_out: 0, err: "bad_timeout"} else if fs_path_exists(cmd_path) == 0 then {status: 0 - 1, stdout: "", stderr: "", timed_out: 0, err: "not_found"} else let tmp = sprc_tmp_write(stdin_text) in if tmp.ok == 0 then {status: 0 - 1, stdout: "", stderr: "", timed_out: 0, err: tmp.err} else let status = os_run_input_capture_timeout(cmd_path, args, tmp.path, "std_process_stdout_probe", "std_process_stderr_probe", timeout_ms) in let out = fs_read_file("std_process_stdout_probe") in let errf = fs_read_file("std_process_stderr_probe") in let tout = os_last_timed_out() in let cleared = fs_write_sync(tmp.path, "") in {status: status, stdout: out, stderr: errf, timed_out: tout, err: ""}

## --- unit tests (`lume test compiler/stage1/process.src`) ---
## These stay spawn-free: the real child-process runs live in process_ok.src,
## which `use`s this module and runs against the process_probe fixture.
fn test_sprc_missing_binary_fails_closed() = let r = sprc_run_collect("/definitely/missing-std-process-tool", Nil) in r.status == 0 - 1 and r.err == "not_found" and r.stdout == "" and r.stderr == ""

fn test_sprc_empty_cmd_fails_closed() = let r = sprc_run_collect("", Nil) in r.status == 0 - 1 and r.err == "not_found"

fn test_sprc_bad_timeout_rejected() = let r = sprc_run_input("/definitely/missing-std-process-tool", Nil, "x", 0) in r.status == 0 - 1 and r.err == "bad_timeout"

fn test_sprc_negative_timeout_rejected() = let r = sprc_run_input("/definitely/missing-std-process-tool", Nil, "x", 0 - 5) in r.status == 0 - 1 and r.err == "bad_timeout"

fn test_sprc_missing_binary_after_timeout_guard() = let r = sprc_run_input("/definitely/missing-std-process-tool", Nil, "x", 1000) in r.status == 0 - 1 and r.err == "not_found" and r.timed_out == 0

fn test_sprc_tmp_write_roundtrip() = let t = sprc_tmp_write("stdin-scratch\n") in t.ok == 1 and t.path == "std_process_stdin_probe" and fs_read_file(t.path) == "stdin-scratch\n"

fn test_sprc_exit_code_decodes_wait_status() = sprc_exit_code(0) == 0 and sprc_exit_code(1792) == 7 and sprc_exit_code(0 - 1) == 0 - 1

## --- spawn with pipes, process trees, bounded capture (LumeDesk RMM agent) ------------------------------------------
## os_spawn_pipes(prog, args, new_group) -> {ok, pid, out_fd, err_fd}: the child's stdout and stderr are pipes the
##     caller reads (os_fd_read_some, or epoll_add + epoll_wait_ev of `use netctl`); stdin is /dev/null. With
##     new_group == 1 the child leads a new process group (Linux: setpgid in the child and in the parent; Windows: the
##     layer creates the program suspended, puts it in a new Job Object and resumes it, so nothing it starts escapes).
## os_kill_tree(pid) kills the child and everything it started in its group / job: kill(-pid, SIGKILL), which the
##     Windows layer turns into TerminateJobObject.
## os_fd_read_some(fd, max) -> {n, data}: n > 0 bytes, 0 at the end, -2 nothing now, -1 error; never blocks.
## os_wait_nohang(pid) -> {done, status}; os_wait_child(pid) -> raw wait status (blocks); os_fd_close(fd).
## os_run_capture_limit(prog, args, max_bytes, timeout_ms) -> {status, exit_code, out, err, out_truncated,
##     err_truncated, timed_out}: at most max_bytes kept per stream (the rest read and dropped, so the child never
##     blocks on a full pipe), and at the deadline the whole tree is killed. status is the raw wait status (-1 when
##     the spawn failed); exit_code is status / 256 when the child exited, -1 when a signal ended it.
fn prc_u32(b, o) = buf_get(b, o) + 256 * buf_get(b, o + 1) + 65536 * buf_get(b, o + 2) + 16777216 * buf_get(b, o + 3)
fn prc_cz(s) = buf_from_str(s + chr(0))
fn prc_put64(b, o, v, k) = if k >= 8 then b else prc_put64(buf_set(b, o + k, bit_and(bit_shr(v, 8 * k), 255)), o, v, k + 1)
fn prc_win() = os_platform() == "windows"
fn prc_close(fd) = if fd >= 0 then sys_call(3, fd, 0, 0, 0, 0) else 0
fn os_fd_close(fd) = if prc_close(fd) == 0 then 1 else 0
fn prc_pipe() = let b = buf_new(8) in let r = sys_call(22, buf_addr(b), 0, 0, 0, 0) in if r < 0 then {ok: 0, r: 0 - 1, w: 0 - 1} else {ok: 1, r: prc_u32(b, 0), w: prc_u32(b, 4)}
fn prc_newgroup_self() = sys_call(109, 0, 0, 0, 0, 0)
fn os_kill_tree(pid) = if pid <= 0 then 0 else let g = sys_call(62, 0 - pid, 9, 0, 0, 0) in let k = os_kill(pid, 9) in 1
fn prc_child(prog, args, new_group, po, pe) = let g = (if new_group == 1 then prc_newgroup_self() else 0) in let nul = sys_call(2, buf_addr(prc_cz("/dev/null")), 0, 0, 0, 0) in let d0 = (if nul >= 0 then sys_call(33, nul, 0, 0, 0, 0) else 0) in let d1 = sys_call(33, po.w, 1, 0, 0, 0) in let d2 = sys_call(33, pe.w, 2, 0, 0, 0) in let c = prc_close(po.r) + prc_close(pe.r) + prc_close(po.w) + prc_close(pe.w) + (if nul > 2 then prc_close(nul) else 0) in let e = os_exec(prog, args) in os_exit(127)
fn prc_nonblock(fd) = if prc_win() then 0 else sys_call(72, fd, 4, 2048, 0, 0)
fn os_spawn_pipes(prog, args, new_group) = let po = prc_pipe() in let pe = prc_pipe() in if po.ok == 0 or pe.ok == 0 then (let c = prc_close(po.r) + prc_close(po.w) + prc_close(pe.r) + prc_close(pe.w) in {ok: 0, pid: 0 - 1, out_fd: 0 - 1, err_fd: 0 - 1}) else prc_spawn2(prog, args, new_group, po, pe, sys_call(57, 0, 0, 0, 0, 0))
fn prc_spawn2(prog, args, new_group, po, pe, pid) = if pid == 0 then prc_child(prog, args, new_group, po, pe) else if pid < 0 then (let c = prc_close(po.r) + prc_close(po.w) + prc_close(pe.r) + prc_close(pe.w) in {ok: 0, pid: 0 - 1, out_fd: 0 - 1, err_fd: 0 - 1}) else let g = (if new_group == 1 and prc_win() == 0 then sys_call(109, pid, pid, 0, 0, 0) else 0) in let c = prc_close(po.w) + prc_close(pe.w) in let nb = prc_nonblock(po.r) + prc_nonblock(pe.r) in {ok: 1, pid: pid, out_fd: po.r, err_fd: pe.r}
## readiness through a one-shot epoll (the Windows layer has no O_NONBLOCK on pipes; its epoll sees them)
fn prc_ready(fd) = let ep = sys_call(291, 0, 0, 0, 0, 0) in if ep < 0 then 1 else let ev = prc_put64(prc_put64(buf_new(16), 0, 25, 0), 4, fd, 0) in let a = sys_call(233, ep, 1, fd, buf_addr(ev), 0) in let out = buf_new(16) in let r = sys_call(232, ep, buf_addr(out), 1, 0, 0) in let c = prc_close(ep) in if a < 0 then 1 else if r > 0 then 1 else 0
fn os_fd_read_some(fd, max) = if max <= 0 or fd < 0 then {n: 0 - 1, data: ""} else if prc_win() and prc_ready(fd) == 0 then {n: 0 - 2, data: ""} else let b = buf_new(max) in let r = sys_call(0, fd, buf_addr(b), max, 0, 0) in if r > 0 then {n: r, data: buf_to_str(b, 0, r)} else if r == 0 then {n: 0, data: ""} else if r == 0 - 11 or r == 0 - 4 then {n: 0 - 2, data: ""} else {n: 0 - 1, data: ""}
fn os_wait_nohang(pid) = let b = buf_new(8) in let r = sys_call(61, pid, buf_addr(b), 1, 0, 0) in if r == 0 then {done: 0, status: 0} else if r < 0 then {done: 1, status: 0 - 1} else {done: 1, status: prc_u32(b, 0)}
fn os_wait_child(pid) = let b = buf_new(8) in let r = sys_call(61, pid, buf_addr(b), 0, 0, 0) in if r == 0 - 4 then os_wait_child(pid) else if r < 0 then 0 - 1 else prc_u32(b, 0)
fn prc_exit_code(st) = if st < 0 then 0 - 1 else if bit_and(st, 127) == 0 then bit_and(bit_shr(st, 8), 255) else 0 - 1
## keep at most max bytes of a stream: {s, trunc}
fn prc_keep(acc, data, max) = let room = max - count(acc) in if room <= 0 then {s: acc, t: (if count(data) > 0 then 1 else 0)} else if count(data) <= room then {s: acc + data, t: 0} else {s: acc + slice(data, 0, room), t: 1}
fn prc_drain(st, fd, which, max) = let r = os_fd_read_some(fd, 65536) in if r.n > 0 then (let k = prc_keep(if which == 1 then st.out else st.err, r.data, max) in if which == 1 then {st with out: k.s, ot: bit_or(st.ot, k.t)} else {st with err: k.s, et: bit_or(st.et, k.t)}) else if r.n == 0 - 2 then st else (let c = prc_close(fd) in if which == 1 then {st with oo: 0} else {st with eo: 0})
fn prc_now_ms() = os_monotonic_ns() / 1000000
fn prc_loop(s, st, max, deadline, quiet) = let st1 = (if st.oo == 1 then prc_drain(st, s.out_fd, 1, max) else st) in let st2 = (if st1.eo == 1 then prc_drain(st1, s.err_fd, 2, max) else st1) in let got = count(st2.out) + count(st2.err) != count(st.out) + count(st.err) or st2.oo != st.oo or st2.eo != st.eo in let w = (if st2.done == 1 then {done: 1, status: st2.status} else os_wait_nohang(s.pid)) in let st3 = {st2 with done: w.done, status: w.status} in if st3.done == 1 and (st3.oo == 0 and st3.eo == 0 or (got == 0 and quiet >= 2)) then st3 else if st3.done == 0 and prc_now_ms() >= deadline then (let k = os_kill_tree(s.pid) in {st3 with tmo: 1, status: os_wait_child(s.pid), done: 1}) else (let z = (if got then 0 else os_sleep_ms(5)) in prc_loop(s, st3, max, deadline, if got then 0 else quiet + 1))
fn os_run_capture_limit(prog, args, max_bytes, timeout_ms) = if timeout_ms <= 0 or max_bytes < 0 then {status: 0 - 1, exit_code: 0 - 1, out: "", err: "", out_truncated: 0, err_truncated: 0, timed_out: 0} else let s = os_spawn_pipes(prog, args, 1) in if s.ok == 0 then {status: 0 - 1, exit_code: 0 - 1, out: "", err: "", out_truncated: 0, err_truncated: 0, timed_out: 0} else let st = prc_loop(s, {out: "", err: "", ot: 0, et: 0, oo: 1, eo: 1, done: 0, status: 0, tmo: 0}, max_bytes, prc_now_ms() + timeout_ms, 0) in let c = (if st.oo == 1 then prc_close(s.out_fd) else 0) + (if st.eo == 1 then prc_close(s.err_fd) else 0) in {status: st.status, exit_code: (if st.tmo == 1 then 0 - 1 else prc_exit_code(st.status)), out: st.out, err: st.err, out_truncated: st.ot, err_truncated: st.et, timed_out: st.tmo}
