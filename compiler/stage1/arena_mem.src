## arena_mem.src -- #404 memory-peak evidence program (run with `lume run`).
##
## Prints boolean-first, machine-checkable lines (the gate greps these) plus
## raw numbers for humans. Three claims, each self-asserted in-program so a
## regression fails the gate instead of drifting silently:
##   arena_drop 1 ...        -- 1M 24-byte cells in a scoped arena, then
##                              arena_reset: heap_stats().used returns near
##                              baseline while heap_peak_used() keeps the
##                              ~48 MiB high-water mark
##   monotonic_growth 1 ...  -- the same allocation shape WITHOUT an arena
##                              grows used monotonically (the gap GC closes)
##   vmhwm_at_least_24m 1 ...-- peak RSS (VmHWM from /proc/self/status) really
##                              reached the arena region: arena_alloc only
##                              bumps a pointer, so the filler TOUCHES each
##                              cell (mmio_volatile_write64); without the
##                              touch the kernel never supplies the pages and
##                              RSS would not reflect the logical peak
##
## VmHWM is the kernel high-water mark: arena_reset releases the region to
## the runtime's bump pointer (heap_stats().used drops) but the brk mapping
## stays with the process, so VmHWM does NOT drop -- that asymmetry is the
## honest picture and is documented in docs/38-memory-management.md.
use arena

fn ar_fill_touch(a, i) = if i == 0 then 0 else let p = arena_alloc(a, 24) in let w = mmio_volatile_write64(p, 12345) in ar_fill_touch(a, i - 1)

fn rec_fill(i) = if i == 0 then 0 else let r = {cellv: i} in rec_fill(i - 1)

## Byte-level /proc/self/status scanner (the native runtime has no split, and
## fs_read_file sizes by lseek which procfs reports as 0, so read byte-wise).
fn slurp_status(i, acc) = let b = fs_read_byte("/proc/self/status", i) in if b < 0 then acc else slurp_status(i + 1, acc + utf8_chr(b))

fn vm_find(text, i) = if i + 6 > count(text) then 0 - 1 else if slice(text, i, i + 6) == "VmHWM:" then i else vm_find(text, i + 1)

fn vm_skip_nondigit(text, i) = if i >= count(text) then i else let c = at(text, i) in if c >= "0" and c <= "9" then i else vm_skip_nondigit(text, i + 1)

fn vm_digits(text, i, acc) = if i >= count(text) then acc else let c = at(text, i) in if c >= "0" and c <= "9" then vm_digits(text, i + 1, acc * 10 + toint(c)) else acc

fn vmhwm_kb() = let t = slurp_status(0, "") in let i = vm_find(t, 0) in if i < 0 then 0 - 1 else vm_digits(t, vm_skip_nondigit(t, i + 6), 0)

print (let before = heap_stats() in
       let a = arena_new(67108864) in
       let f = ar_fill_touch(a, 1000000) in
       let r = arena_reset(a) in
       let d = arena_destroy(a) in
       let after = heap_stats() in
       let peak = heap_peak_used() in
       "arena_drop " + (if after.used <= before.used + 4096 then "1" else "0") + " used_before=" + str(before.used) + " used_after=" + str(after.used) + " peak=" + str(peak))

print (let before2 = heap_stats() in
       let f2 = rec_fill(300000) in
       let after2 = heap_stats() in
       "monotonic_growth " + (if after2.used >= before2.used + 16000000 then "1" else "0") + " used_before=" + str(before2.used) + " used_after=" + str(after2.used))

print (let vm = vmhwm_kb() in
       "vmhwm_at_least_24m " + (if vm >= 24576 then "1" else "0") + " vmhwm_kb=" + str(vm))
