## http_ok.src -- `use std/http` against a local server (a forked child): plain, chunked, gzip, a redirect and a POST
use http
use deflate

fn crlf() = chr(13) + chr(10)
fn find(s, w, i) = if i + count(w) > count(s) then 0 - 1 else if slice(s, i, i + count(w)) == w then i else find(s, w, i + 1)
## read a request until the blank line and its body (Content-Length)
fn rq_read(fd, acc) = let h = find(acc, crlf() + crlf(), 0) in if h >= 0 and count(acc) >= h + 4 + rq_len(acc) then acc else let d = net_recv_str(fd, 4096) in if d == "" then acc else rq_read(fd, acc + d)
fn rq_len(s) = let i = find(s, "Content-Length: ", 0) in if i < 0 then 0 else rq_num(s, i + 16, 0)
fn rq_num(s, i, acc) = if i < count(s) and at(s, i) >= "0" and at(s, i) <= "9" then rq_num(s, i + 1, acc * 10 + ord(at(s, i)) - 48) else acc
fn rq_path(req) = let a = find(req, " ", 0) in let b = find(req, " ", a + 1) in slice(req, a + 1, b)
fn rq_body(req) = let h = find(req, crlf() + crlf(), 0) in slice(req, h + 4, count(req))
fn gz(s) = gzip_str(s)
fn answer(req) = let p = rq_path(req) in if p == "/plain" then "HTTP/1.1 200 OK" + crlf() + "Content-Length: 5" + crlf() + "X-Test: yes" + crlf() + crlf() + "hello" else if p == "/chunked" then "HTTP/1.1 200 OK" + crlf() + "Transfer-Encoding: chunked" + crlf() + crlf() + "4" + crlf() + "Lume" + crlf() + "6;ext=1" + crlf() + " chunk" + crlf() + "0" + crlf() + crlf() else if p == "/gz" then (let g = gz("compressed body") in "HTTP/1.1 200 OK" + crlf() + "Content-Encoding: gzip" + crlf() + "Content-Length: " + str(count(g)) + crlf() + crlf() + g) else if p == "/redir" then "HTTP/1.1 302 Found" + crlf() + "Location: /plain" + crlf() + "Content-Length: 0" + crlf() + crlf() else if p == "/post" then "HTTP/1.1 201 Created" + crlf() + "Content-Length: " + str(count(rq_body(req))) + crlf() + crlf() + rq_body(req) else "HTTP/1.1 404 Not Found" + crlf() + "Content-Length: 0" + crlf() + crlf()
fn serve(sfd, n) = if n == 0 then 0 else let c = net_tcp_accept(sfd) in let req = rq_read(c, "") in let s = net_send_str(c, answer(req)) in let z = net_close(c) in serve(sfd, n - 1)
fn base(port) = "http://127.0.0.1:" + str(port)
fn client(port) = let a = http_get(base(port) + "/plain") in let b = http_get(base(port) + "/chunked") in let c = http_get(base(port) + "/gz") in let d = http_get(base(port) + "/redir") in let e = http_post(base(port) + "/post", "text/plain", "ping body") in let f = http_get(base(port) + "/missing") in a.ok == 1 and a.status == 200 and a.body == "hello" and http_header(a, "x-test") == "yes" and b.body == "Lume chunk" and c.body == "compressed body" and d.status == 200 and d.body == "hello" and e.status == 201 and e.body == "ping body" and f.status == 404
fn test_http_exchanges() = let port = 21000 + os_getpid() % 20000 in let sfd = net_tcp_listen(port) in if sfd < 0 then false else let pid = os_fork() in if pid == 0 then (let s = serve(sfd, 7) in os_exit(0)) else (let z = net_close(sfd) in let ok = client(port) in let w = os_waitpid(pid) in ok)
fn test_parse_url() = let u = http_parse_url("http://example.org:8080/a/b?q=1") in u.ok == 1 and u.host == "example.org" and u.port == 8080 and u.path == "/a/b?q=1" and (http_parse_url("https://x.io")).port == 443 and (http_parse_url("nope")).ok == 0
fn test_https_unreachable() = (http_request("GET", "https://127.0.0.1:1/", Nil, "", 2000)).ok == 0
fn test_refused() = (http_request("GET", "http://127.0.0.1:1/", Nil, "", 2000)).ok == 0
