fn test_manual_en_all_chapters() = let idx = man_render("en", "index") in let syn = man_render("en", "syntax") in let typ = man_render("en", "types") in let con = man_render("en", "contracts") in let eff = man_render("en", "effects") in let std = man_render("en", "stdlib") in let trg = man_render("en", "targets") in let cmd = man_render("en", "commands") in let exm = man_render("en", "examples") in let err = man_render("en", "errors") in man_contains_at(idx, "MANUAL CHAPTERS (10 CHAPTERS)", 0) == 1 and man_contains_at(syn, "CHAPTER 2: SYNTAX", 0) == 1 and man_contains_at(typ, "CHAPTER 3: TYPE SYSTEM", 0) == 1 and man_contains_at(con, "CHAPTER 4: CONTRACTS", 0) == 1 and man_contains_at(eff, "CHAPTER 5: ALGEBRAIC EFFECTS", 0) == 1 and man_contains_at(std, "CHAPTER 6: BUILTINS", 0) == 1 and man_contains_at(std, "lume_reversa_engine", 0) == 1 and man_contains_at(std, "lume_pingora_proxy_engine", 0) == 1 and man_contains_at(std, "lume_egm_engine", 0) == 1 and man_contains_at(std, "lume_ncm_engine", 0) == 1 and man_contains_at(std, "lume_quantum_nexus_engine", 0) == 1 and man_contains_at(std, "lchameleon", 0) == 1 and man_contains_at(std, "## 6.2.1 Universal Chameleon Polyglot Interop Engine", 0) == 1 and man_contains_at(std, "Lumi", 0) == 1 and man_contains_at(std, "rust_cdylib", 0) == 1 and man_contains_at(std, "python_capi", 0) == 1 and man_contains_at(std, "openapi_rpc", 0) == 1 and man_contains_at(std, "@ui-layout", 0) == 1 and man_contains_at(std, "ui_split_conservation_law", 0) == 1 and man_contains_at(std, "1412694337", 0) == 1 and man_contains_at(std, "1412698308", 0) == 1 and man_contains_at(std, "vec_clamp_index", 0) == 1 and man_contains_at(std, "vec_checked_slice_len", 0) == 1 and man_contains_at(std, "map_checked_slot", 0) == 1 and man_contains_at(std, "decimal_clamp", 0) == 1 and man_contains_at(std, "lume_llm_core", 0) == 1 and man_contains_at(std, "sovereign_llm_router", 0) == 1 and man_contains_at(std, "zero_breach_forensics", 0) == 1 and man_contains_at(std, "ui_modal_blocks_parent", 0) == 1 and man_contains_at(std, "os_select_hybrid_gpu", 0) == 1 and man_contains_at(std, "vscode-lume", 0) == 1 and man_contains_at(trg, "CHAPTER 7: 27 UNIVERSAL TARGETS", 0) == 1 and man_contains_at(cmd, "CHAPTER 8: COMPLETE CLI COMMAND REFERENCE", 0) == 1 and man_contains_at(cmd, "LumeSynapse", 0) == 1 and man_contains_at(cmd, "lume reversa", 0) == 1 and man_contains_at(cmd, "lume pingora", 0) == 1 and man_contains_at(cmd, "lume egm", 0) == 1 and man_contains_at(cmd, "lume ncm", 0) == 1 and man_contains_at(cmd, "lume quantum-nexus", 0) == 1 and man_contains_at(cmd, "lume chameleon|camaleao|polyglot|ffi-bridge [target_or_file]", 0) == 1 and man_contains_at(cmd, "lume adapt <c|rust|python|js|go|java|dotnet|sql|openapi> [file]", 0) == 1 and man_contains_at(cmd, "lume morph <file>", 0) == 1 and man_contains_at(cmd, "lume daemon-triad", 0) == 1 and man_contains_at(cmd, "lume hot-evolve", 0) == 1 and man_contains_at(cmd, "lume live-cockpit", 0) == 1 and man_contains_at(cmd, "lume ui-layout", 0) == 1 and man_contains_at(std, "port_out32", 0) == 1 and man_contains_at(exm, "CHAPTER 9: 6 COPY-PASTE WORKING EXAMPLES", 0) == 1 and man_contains_at(exm, "## Example 7: Universal Chameleon Polyglot Interop (`chameleon_demo.src`)", 0) == 1 and man_contains_at(err, "CHAPTER 10: COMPILER DIAGNOSTIC CODES", 0) == 1 and man_contains_at(err, "[K0005]", 0) == 1 and man_contains_at(err, "[K0006]", 0) == 1 and man_contains_at(err, "[C0009]", 0) == 1 and man_contains_at(err, "[Q0001]", 0) == 1

fn test_manual_pt_all_chapters() = let idx = man_render("pt", "indice") in let syn = man_render("pt", "sintaxe") in let typ = man_render("pt", "tipos") in let con = man_render("pt", "contratos") in let eff = man_render("pt", "efeitos") in let std = man_render("pt", "biblioteca") in let trg = man_render("pt", "alvos") in let cmd = man_render("pt", "comandos") in let exm = man_render("pt", "exemplos") in let err = man_render("pt", "erros") in man_contains_at(idx, "CAPITULOS DO MANUAL (10 CAPITULOS)", 0) == 1 and man_contains_at(syn, "CAPITULO 2: SINTAXE", 0) == 1 and man_contains_at(typ, "CAPITULO 3: SISTEMA DE TIPOS", 0) == 1 and man_contains_at(con, "CAPITULO 4: CONTRATOS", 0) == 1 and man_contains_at(eff, "CAPITULO 5: EFEITOS ALGEBRICOS", 0) == 1 and man_contains_at(std, "CAPITULO 6: FUNCOES NATIVAS", 0) == 1 and man_contains_at(std, "lume_reversa_engine", 0) == 1 and man_contains_at(std, "lume_pingora_proxy_engine", 0) == 1 and man_contains_at(std, "lume_egm_engine", 0) == 1 and man_contains_at(std, "lume_ncm_engine", 0) == 1 and man_contains_at(std, "lume_quantum_nexus_engine", 0) == 1 and man_contains_at(std, "lchameleon", 0) == 1 and man_contains_at(std, "## 6.2.1 Motor Universal Camaleao de Interoperabilidade Poliglota", 0) == 1 and man_contains_at(std, "Lumi", 0) == 1 and man_contains_at(std, "rust_cdylib", 0) == 1 and man_contains_at(std, "python_capi", 0) == 1 and man_contains_at(std, "openapi_rpc", 0) == 1 and man_contains_at(std, "@ui-layout", 0) == 1 and man_contains_at(std, "ui_split_conservation_law", 0) == 1 and man_contains_at(std, "1412694337", 0) == 1 and man_contains_at(std, "1412698308", 0) == 1 and man_contains_at(std, "vec_clamp_index", 0) == 1 and man_contains_at(std, "vec_checked_slice_len", 0) == 1 and man_contains_at(std, "map_checked_slot", 0) == 1 and man_contains_at(std, "decimal_clamp", 0) == 1 and man_contains_at(std, "lume_llm_core", 0) == 1 and man_contains_at(std, "sovereign_llm_router", 0) == 1 and man_contains_at(std, "zero_breach_forensics", 0) == 1 and man_contains_at(std, "ui_modal_blocks_parent", 0) == 1 and man_contains_at(std, "os_select_hybrid_gpu", 0) == 1 and man_contains_at(std, "vscode-lume", 0) == 1 and man_contains_at(trg, "CAPITULO 7: 27 ALVOS UNIVERSAIS", 0) == 1 and man_contains_at(cmd, "CAPITULO 8: REFERENCIA COMPLETA DE COMANDOS", 0) == 1 and man_contains_at(cmd, "LumeSynapse", 0) == 1 and man_contains_at(cmd, "lume reversa", 0) == 1 and man_contains_at(cmd, "lume pingora", 0) == 1 and man_contains_at(cmd, "lume egm", 0) == 1 and man_contains_at(cmd, "lume ncm", 0) == 1 and man_contains_at(cmd, "lume quantum-nexus", 0) == 1 and man_contains_at(cmd, "lume chameleon|camaleao|polyglot|ffi-bridge [target_or_file]", 0) == 1 and man_contains_at(cmd, "lume adapt <c|rust|python|js|go|java|dotnet|sql|openapi> [file]", 0) == 1 and man_contains_at(cmd, "lume morph <file>", 0) == 1 and man_contains_at(cmd, "lume daemon-triad", 0) == 1 and man_contains_at(cmd, "lume hot-evolve", 0) == 1 and man_contains_at(cmd, "lume live-cockpit", 0) == 1 and man_contains_at(cmd, "lume ui-layout", 0) == 1 and man_contains_at(std, "port_out32", 0) == 1 and man_contains_at(exm, "CAPITULO 9: 6 EXEMPLOS PRATICOS", 0) == 1 and man_contains_at(exm, "## Exemplo 7: Interoperabilidade Poliglota Camaleao (`chameleon_demo.src`)", 0) == 1 and man_contains_at(err, "CAPITULO 10: TABELA DE CODIGOS DE ERRO", 0) == 1 and man_contains_at(err, "[K0005]", 0) == 1 and man_contains_at(err, "[K0006]", 0) == 1 and man_contains_at(err, "[C0009]", 0) == 1 and man_contains_at(err, "[Q0001]", 0) == 1

fn test_manual_json_and_full_bundle() = let j = man_json_summary("pt-br", "all") in let j_bad = man_json_summary("en", "bogus_topic") in let full_pt = man_render("pt-BR", "tudo") in let full_en = man_render("en", "all") in man_contains_at(j, "\"ok\":true", 0) == 1 and man_contains_at(j, "\"chapter_count\":10", 0) == 1 and man_contains_at(j, "\"language\":\"pt-BR\"", 0) == 1 and man_contains_at(j_bad, "\"ok\":false", 0) == 1 and count(full_pt) > 12000 and count(full_en) > 12000
