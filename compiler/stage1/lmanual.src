fn test_manual_json_and_full_bundle() =
    let j = man_json_summary("pt", "all") in
    let full_pt = man_render("pt", "tudo") in
    let full_en = man_render("en", "all") in
    man_contains_at(j, "\"chapter_count\":10", 0) == 1 and
    man_contains_at(j, "\"language\":\"pt-BR\"", 0) == 1 and
    count(full_pt) > 12000 and
    count(full_en) > 12000
