## Lume Internal Human & AI Programmer's Manual and Interactive Help System (lmanual.src)
## 100% Pure Self-Hosted Lume ("Lume gera Lume") — Bilingual EN + PT-BR Edition

fn man_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else man_contains_at(text, part, i + 1)

fn man_br(s) = "{" + s + "}"

fn man_norm_topic(raw) = if raw == "" or raw == "index" or raw == "indice" or raw == "help" or raw == "--help" or raw == "-h" or raw == "toc" then "index" else if raw == "overview" or raw == "visao-geral" or raw == "intro" or raw == "quickstart" or raw == "inicio" then "overview" else if raw == "syntax" or raw == "sintaxe" or raw == "grammar" or raw == "gramatica" or raw == "rules" or raw == "regras" then "syntax" else if raw == "types" or raw == "tipos" or raw == "ownership" or raw == "decimal" or raw == "money" or raw == "tensor" then "types" else if raw == "contracts" or raw == "contratos" or raw == "prove" or raw == "verification" or raw == "provas" or raw == "law" or raw == "laws-math" then "contracts" else if raw == "effects" or raw == "efeitos" or raw == "memory" or raw == "memoria" or raw == "arena" or raw == "arenas" or raw == "capsule" or raw == "capsules" then "effects" else if raw == "stdlib" or raw == "biblioteca" or raw == "std" or raw == "modules" or raw == "modulos" or raw == "chameleon" or raw == "camaleao" or raw == "polyglot" or raw == "ffi" or raw == "ffi-bridge" or raw == "interop" or raw == "adapt" or raw == "morph" or raw == "lumi" or raw == "mascot" or raw == "mascote" or raw == "ui-layout" or raw == "@ui-layout" or raw == "vec" or raw == "unified-field" or raw == "ufe" or raw == "singularity" or raw == "ote" or raw == "transition-engine" or raw == "net-sentinel" or raw == "iec62443" or raw == "conduite" or raw == "omega-mesh" or raw == "subsea" or raw == "lumeputer" or raw == "lumepu" or raw == "qwenputer" or raw == "weight-vm" or raw == "in-weights-npu" or raw == "64-domains" or raw == "autonomous-evolver" then "stdlib" else if raw == "targets" or raw == "alvos" or raw == "package" or raw == "mir" or raw == "neural-kernel" or raw == "cross" or raw == "lumeputer-rv32im-weights" then "targets" else if raw == "commands" or raw == "comandos" or raw == "cli" or raw == "waves" or raw == "ondas" or raw == "daemon-triad" or raw == "hot-evolve" or raw == "live-cockpit" then "commands" else if raw == "examples" or raw == "exemplos" or raw == "recipes" or raw == "receitas" or raw == "tutorial" then "examples" else if raw == "errors" or raw == "erros" or raw == "diagnostics" or raw == "diagnosticos" or raw == "codes" then "errors" else if raw == "all" or raw == "tudo" or raw == "full" or raw == "completo" or raw == "en" or raw == "english" or raw == "pt" or raw == "portugues" then "all" else if raw == "ref" or raw == "reference" or raw == "referencia" or raw == "referência" then "ref" else if raw == "vision" or raw == "visao" or raw == "roadmap" then "vision" else "unknown"

