"  lume egm / elephant-goldfish / goldfish-review / drift-report / heilmeier [alvo] Modelo Elefante-Peixe-Dourado (EGM SDD + Deriva Zero)\n" +
"  lume ncm / next-concept / ncm-quantize / ncm-generate / ncm-solve [alvo] Modelagem de Proximo Conceito Paralela Coarse-to-Fine (NCM-Lume)\n" +
"  lume opentpu / tpu / otpu-asm / k-smooth / stream-se / tpu-scoreboard [alvo] Acelerador Sistolico de IA e Compilador ISA OpenTPU-Lume\n" +
"  lume continuum / nexus / billion-context / acp / ecc-shield / bend-laws / ai-memory / notebook / doory [alvo] Motor Lume Continuum Nexus v1.0 (7 Motores de Referencia)\n" +
"  lume quantum-nexus / quantum-zx / quantum-stabilizer / quantum-qec / quantum-vqe / quantum-uncompute / silq / quizx / stim [alvo] Motor Lume Quantum Nexus v1.0 (Silq qfree, QuiZX, Stim, Surface Code QEC, Catalyst VQE)\n" +
"  lume chameleon|camaleao|polyglot|ffi-bridge [target_or_file] (ou `lume chameleon`) Motor Universal Camaleao de Interop Poliglota nos 9 ecossistemas (`c_abi`, `rust_cdylib`, `python_capi`, `node_napi_wasm`, `go_cshared`, `java_jni`, `dotnet_pinvoke`, `sql_relational`, `openapi_rpc`)\n" +
"  lume unified-field|ufe|subsea [alvo]               Motor de Campo Unificado e Submarino/Offshore em `std.gfx` (`ufe_dls_lambda_sq_milli`..`ufe_latency_shedder_step`, `subsea_catenary_top_tension_n`, `subsea_viv_screening_ok`, `subsea_miner_fatigue_safe_ok`, `marine_dnv_daf_floor_milli`, `marine_heavy_lift_feasible_ok`, `subsea_hyperbaric_decompression_safe_ok`, `subsea_well_kill_icp_kpa`, `subsea_b31g_corroded_pipe_safe_ok`)\n" +
"  lume singularity|ote|transition-engine [alvo]      Motor Dinamico de Transicao de 2a Ordem, Fronteira Omega e Bayes-SPC/CPM/k-Anonymity em `lchameleon.src` (`ote_select_damping_regime`..`ote_diagnose_primary_code`, `spc_beta_binomial_posterior_num`, `spc_cusum_upper_step_milli`, `ops_cpm_total_float_hours`, `analytics_k_anonymity_release_ok`, `analytics_pava_monotonic_pair_hi`)\n" +
"  lume net-sentinel|iec62443|conduite|omega-mesh [a] NetSentinel IEC 62443, Conduite HA e Sovereign Mesh/Raft/DHT/TOFU em `std.net` (`iec62443_purdue_conduit_ok`..`ot_finite_sentinel_clamp`, `conduit_admin_timeout_ok`, `conduit_ha_failover_parity_ok`, `ot_goose_state_transition_code`, `netsentinel_posture_traffic_confirmed`, `mesh_atomic_dual_rate_deduct`, `mesh_dht_healing_rank`, `mesh_raft_quorum_ok`, `mesh_tofu_verify_code`, `mesh_channel_mux_quota_ok`)\n" +
"  lume lumeputer|lumepu|qwenputer [alvo]             LumePuter & LumePU VM Compilada nos Pesos `RV32IM_Zba` + Bignum + NPU Vetorial/Matricial (`VDOT`/`SMAQA`/`VX VMAT`) & RAM `Gated DeltaNet` em `lchameleon.src` (`lumeputer_swiglu_exact_relu_unit`..`lumeputer_compile_rv32_vx_to_weights_layers`)\n" +
"  lume run compiler/stage1/lume_llm_core.src         Nucleo Soberano LLM 1-Bit/Ternario, Audio LFM3 LiquidCodec, Guarda MoE Colibri e Roteador 3-Tier (`21/21` provas)\n" +
"  lume run examples/apps/sovereign_llm_router/main.src Roteador LLM Hibrido Edge/Local/Cloud e Oraculo Anti-Alucinacao de Precos (`20/20` provas)\n" +
"  lume os-control / bios-core / web-research / crypto-engine\n" +
"  lume sensory-cortex / multimodal / file-indexer / interface / self-build\n" +
"  lume wireshark / switch-fabric / scada-ics / modbus / dnp3 / iec104 / iec61850\n" +
"  lume gfx / render-3d / scada-hmi / ied-protection / recall / synapse / orchestrate\n\n" +
"### Comandos de Certificacao da Onda 11 (Dominios `#112..#115`)\n" +
"  lume tv <src.src> [--fn <f>] [--exec]      Validacao de traducao (`ltv`): por funcao, a AST rebaixada contra o x86-64 que o `lumec` emitiu\n" +
"  lume mcdc <src.src> [--fn <f>] [--exec]    Obrigacoes de decisao + MC/DC por mascaramento (`lmcdc`); cada testemunha roda no binario real\n" +
"  lume safety-envelope <kernel.src> --fn <f> --args <a,b,..> [--args ..] [--budget n] [--reset]\n" +
"                                             Lockstep 2oo2: x86-64 nativo (canal A) contra o monitor LumePuter RV32IM (canal B)\n" +
"  lume safety-envelope --gate                Gate de injecao de falhas do envelope (bit flips, RAM/registrador/ROM, WCET, certificado)\n" +
"  lume lumeputer exec <kernel.src> --fn <f> --args <a,b,..>   Executa um kernel somente no monitor LumePuter RV32IM (sem voto, sem commit)\n" +
"  lume tv-gate [--stride n]                  Gate de mutacao do codegen: o `ltv` tem de rejeitar todo mutante que muda o comportamento\n" +
"  lume soak [--rounds n] [--procs n]         Soak battle: estresse do coletor, falhas de SO, determinismo concorrente, ledger encadeado por hash\n" +
"  lume prover-fuzz [--n k] [--seed s]        Fuzzer de teoremas falsos contra `lumec`, `lcaas` e o kernel `lcert`\n" +
"  lume qualify [--quick]                     Bateria de qualificacao de ferramenta; grava TOR, TQP, RTM, evidencias e dossie em `build/certification/`\n" +
"\n" +
"- **`ltv` (Dominio `#112`)** executa simbolicamente a AST e o assembly emitido de cada funcao inteira e so aceita\n" +
"  quando, para toda valoracao dos atomos de desvio, ambos chegam a `ctfail` nos mesmos casos e com a mesma mensagem,\n" +
"  senao retornam o mesmo valor em `%rax`, fazem as mesmas divisoes / modulos / chamadas e mantem a disciplina de\n" +
"  frame (`%rsp`/`%rbp` restaurados, nenhuma escrita fora do frame). O modelo de maquina e o real: inteiros de 63 bits\n" +
"  com tag, caminhos rapidos guardados por `jo`/`jno`, helpers do runtime como axiomas declarados. O que ele nao\n" +
"  consegue derivar e rejeicao. Limites: so o fragmento inteiro (o resto e `unsupported`, nunca `validated`); o teorema\n" +
"  vale sobre os inteiros (execucoes sem trap de overflow i64); os certificados SMT-LIB2 e Lean 4 em\n" +
"  `build/certification/proofs/` so sao checados quando `z3`/`cvc5`/`lean` estao instalados (o relatorio diz em\n" +
"  `external_solver` e `lean_checked`).\n" +
"- **`lmcdc` (Dominio `#114`)** lista as decisoes da AST rebaixada (`requires`, `ensures` checado em runtime, condicoes\n" +
"  de `if`, valores booleanos), procura vetores-testemunha e roda cada um no binario real. Obrigacao sem testemunha e\n" +
"  relatada como `theorem_false` (saida falsa de uma lei provada ou de um ensures checado), `infeasible` (contradicao\n" +
"  provada pelo kernel `lcert`: clausula redundante ou ramo morto, listado para revisao) ou `uncovered`.\n" +
"- **`lsafety_envelope` (Dominio `#115`)** so libera `VerifiedActuatorCommit(valor)` quando o canal A terminou dentro\n" +
"  do watchdog, o canal B parou dentro do orcamento de ciclos (`@bound(cycles: N)` x 16, ou `--budget`) sem trap, o\n" +
"  `ltv` validou o kernel e as duas palavras sao iguais. Qualquer outro caso trava `SAFE_STATE_TRIP` no log encadeado\n" +
"  `build/certification/safety_envelope_events.jsonl` ate `--reset`. Nivel real: o canal B e um interpretador RV32IM em\n" +
"  software no mesmo host (diversidade de projeto, nao independencia fisica); desde a Onda 14 o canal B compila o\n" +
"  kernel com um front-end proprio, clean-room (veja a secao da Onda 14 abaixo), mas os dois canais ainda leem o\n" +
"  mesmo texto do kernel; o dominio do monitor e i32 (um kernel que sai dele entra em estado seguro).\n" +
"- **`lume qualify` (Dominio `#114`)** roda 70 sondas, as baterias de modulo (ltv, lmcdc, estado das provas) e 16 gates,\n" +
"  confere a matriz de rastreabilidade bidirecional (todo requisito precisa de pai, arquivo-fonte existente, teste\n" +
"  positivo passando, teste negativo passando e gate de mutacao ou prova passando) e grava o dossie. E o pacote de\n" +
"  evidencias do desenvolvedor para trabalho DO-330 TQL-1 / DO-178C DAL A / IEC 61508 T3 / IEC 62304 classe C, **nao e\n" +
"  uma qualificacao**: ela e concedida por projeto pela autoridade ou avaliador e exige verificacao independente.\n" +
"- **Ledger de soak (Dominio `#113`)**: `build/certification/battle_telemetry_ledger.json` acumula as campanhas do\n" +
"  `lume soak`; cada entrada carrega o hash da anterior e o gate reverifica a cadeia antes de anexar.\n" +
"\n" +
"### Comandos Industriais da Onda 12 (Dominios `#116..#121`) e Fechamento da Onda 13\n" +
"  lume build --dwarf|-g <src.src> [-o <out>]             Tabela de linhas e simbolos DWARF v4 (`.debug_line`, `.debug_info`, `.debug_abbrev`, `.symtab`, `.strtab`)\n" +
"  lume build --keep-proven-checks|--critical <src.src>   Mantem o cheque em runtime de todo `ensures` provado (defesa em profundidade)\n" +
"  lume build --target aarch64-linux-gnu|aarch64-elf|riscv64-linux-gnu|riscv64-none-elf|riscv64-none-bin|riscv32-none-elf|riscv32-none-bin <kernel.src> -o <out>\n" +
"                                                         Back ends certificados de kernel inteiro (`larm64`, `lriscv`), com o front-end do `lumec` antes\n" +
"  lume build --target safetensors [--entry <fn>] <src.src> -o <out.safetensors>   Cartucho neural de uma funcao inteira `/ pure`\n" +
"  lume proof-cache <check|store> <src.src> [<cache_dir>] [--require-all-hits]      Cache incremental de provas por funcao (`lproof_cache`)\n" +
"  lume verify-cert --check-source <src.src> <cert.json>  Kernel de certificados com o cheque de vinculo fonte-obrigacao\n" +
"  lume qualify --verify                                  Reconfere a cadeia de hash e a assinatura Ed25519 de `build/certification/`\n" +
"  lume realtime-gate | concurrency-gate | crypto-gate | multi-arch-gate | safetensors-gate | dwarf-cache-gate | cert-source-gate\n" +
"                                                         Os gates de aceitacao dos recursos abaixo\n" +
"\n" +
"- **`@no_alloc` (Dominio `#116`, `[E0210]`)**: a funcao e toda funcao que ela chama (o cheque e transitivo) nao\n" +
"  podem alcancar alocacao no heap: parametros `int`/`bool` com limites provados, `+ - *` provados dentro da faixa\n" +
"  imediata de 63 bits, nenhum record, construtor com campos, string ou builtin que aloca, recursao so em posicao de\n" +
"  cauda. O `realtime_gate` mede o resultado com `heap_stats()`: zero alocacoes nos kernels aceitos. Limites: nada\n" +
"  e cronometrado; `@bound` e o orcamento de ciclos. A profundidade maxima de pilha em bytes e calculada a parte,\n" +
"  sobre o codigo emitido, pelo `lume stack` (secao da Onda 14 abaixo).\n" +
"- **Kernels constant-time (`@secret` + `@no_alloc`, `[C0011]`)**: uma funcao com os dois atributos e baixada para\n" +
"  codigo em linha reta sobre inteiros imediatos: sem teste de tag, sem teste de overflow, sem chamada de runtime,\n" +
"  sem salto. O `[C0011]` rejeita o resto: parametros e resultado `int`; sem `requires` (mascare com `bit_and`; o\n" +
"  kernel e total sobre imediatos); `ensures` so quando provado (nunca e checado em execucao, nem com\n" +
"  `--keep-proven-checks`); o corpo usa `+ - * +% -% *%`, `bit_and` / `bit_or` / `bit_xor` / `bit_not`, `bit_shl` /\n" +
"  `bit_shr` por literal inteiro, `ct_select`, `ct_eq` e chamadas de outros kernels; sem `if`, `match`, comparacao,\n" +
"  `and` / `or`, `/`, `%`, recursao. Todo resultado aritmetico precisa ser provado dentro da faixa imediata de 63\n" +
"  bits para todo argumento imediato (`[E0210]`). Uma guarda de entrada falha (fault) se um argumento nao e\n" +
"  imediato. O `ltv` rederiva as faixas e valida o codigo de maquina; o `tv_gate` o muta. Limites: \"constant time\"\n" +
"  e a ausencia de desvios, divisoes e acessos a memoria dependentes de segredo; nenhum tempo e medido.\n" +
"- **Back ends multi-ISA (Dominio `#117`)**: `larm64.src` e `lriscv.src` compilam o fragmento de kernel inteiro\n" +
"  (funcoes `int`, `+ - * / %`, comparacoes, `and`/`or`, `if`, `let`, chamadas, `print`) para imagens AArch64, RV64 e\n" +
"  RV32; o `ltv_multiarch.src` valida cada imagem de funcao contra o fonte. Nenhuma imagem sai antes de o front-end\n" +
"  do `lumec` aceitar o mesmo fonte (`[T0902]` com o diagnostico dele, `[T0903]` se o `lumec` nao for encontrado);\n" +
"  fonte fora do fragmento e `[T0901]`. Nivel real: executado em `qemu-aarch64`, `qemu-riscv64` e no interpretador\n" +
"  LumePuter, nao em silicio.\n" +
"- **Concorrencia linear (Dominio `#118`)**: um valor enviado com `chan_send_linear` nao pode ser usado de novo\n" +
"  (`[E0305]`); `lock_acquire` fora da ordem de rank, lock nao liberado ou ciclo de arestas `actor_link` e rejeitado\n" +
"  (`[E0306]`).\n" +
"- **Criptografia e TLS 1.3 (Dominio `#119`, `use lcrypto_tls`)**: SHA-256/512, HMAC, HKDF, ChaCha20-Poly1305,\n" +
"  Ed25519, X25519, o key schedule, a camada de registros e a maquina de estados do handshake do TLS 1.3, tudo em\n" +
"  Lume e conferido contra os vetores oficiais pelo `crypto_tls_gate`. SHA-256 em pedacos (mesma velocidade nativa):\n" +
"  `lcs_sha256_init()`, `lcs_sha256_update(st, dados)` -> st, `lcs_sha256_final(st)` -> 32 bytes; o mesmo para o HMAC\n" +
"  (`lcs_hmac_sha256_init(chave)` / `_update` / `_final`); o estado e um valor. AES e AES-GCM (pacotes Initial do QUIC e\n" +
"  suites AES do TLS 1.3): `lcs_aes128_ecb_encrypt(chave16, bloco16)`, `lcs_aes128_gcm_seal(chave16, nonce12, aad,\n" +
"  p)`, `lcs_aes128_gcm_open(...)`, e o mesmo com `aes256`. ECDSA P-256 com SHA-256: `lcs_p256_verify(pub65, msg,\n" +
"  assinatura_der)` -> 1 ou 0, `lcs_p256_sign(priv32, msg)` (nonce do RFC 6979), `lcs_p256_public(priv32)`, e as\n" +
"  formas `_raw` com r || s. X25519 e Ed25519 (rotinas do runtime escritas em Lume): `lcs_x25519(k32, u32)`,\n" +
"  `lcs_x25519_base(k32)`, `lcs_x25519_shared(k32, par32)`, `lcs_ed25519_public(seed32)`,\n" +
"  `lcs_ed25519_sign(seed32, msg)`, `lcs_ed25519_verify(pk32, msg, sig64)`. O `ltv` acrescenta o `[C0010]`: o codigo\n" +
"  emitido de uma funcao `@secret` nao pode ter desvio condicional, divisao nem acesso a memoria fora do frame, e\n" +
"  o mesmo vale para toda rotina que ela alcanca por `call` (a varredura e transitiva e nomeia a cadeia).\n" +
"  Limites: testado, nao verificado formalmente; uma funcao `@secret` comum que usa `+` ou operacao de bit e\n" +
"  rejeitada pelo `[C0010]` (os helpers dela desviam): escreva-a como kernel constant-time;\n" +
"  a validacao de cadeia X.509 cobre apenas cadeias Ed25519 (`lume x509 verify`, secao da Onda 14 abaixo).\n" +
"- **Cache incremental de provas (Dominio `#120`)**: um registro selado por funcao, indexado pelo SHA-256 do corpo,\n" +
"  dos contratos, das interfaces dos chamados e da versao do provador. Registro adulterado e recusado (`[PC0002]`),\n" +
"  modulo refutado pelo provador nunca e gravado (`[PC0003]`), `--require-all-hits` transforma miss em erro (`[PC0005]`).\n" +
"- **Cartuchos neurais (Dominio `#121`)**: uma funcao inteira `/ pure` compilada para palavras RV32IM dentro de um\n" +
"  arquivo `.safetensors` com os pesos inteiros de um bloco SwiGLU; o forward pass sobre os pesos do arquivo tem de\n" +
"  ser igual ao programa nativo e a execucao no LumePuter. E aritmetica matricial inteira avaliada por esta cadeia de\n" +
"  ferramentas, nao uma afirmacao sobre um motor de inferencia em ponto flutuante.\n" +
"- **Vinculo de certificado (`lcert --check-source`)**: alem de rederivar cada termo de prova, o kernel le os\n" +
"  contratos do proprio fonte e recusa um certificado cujas obrigacoes nao sejam as obrigacoes daquele arquivo.\n" +
"- **Evidencia assinada**: o `lume qualify` encadeia as secoes de `QUALIFICATION_EVIDENCE.json` com SHA-256 e grava uma\n" +
"  assinatura Ed25519 destacada (`QUALIFICATION_EVIDENCE.sig.json`). A chave e uma chave de desenvolvedor guardada em\n" +
"  arquivo no host (`/root/.lume/keys/qualification_ed25519.seed` ou `--sign-key`): ela mostra quem produziu o\n" +
"  arquivo, nao e um atestado independente.\n" +
"\n" +
"### Comandos da Onda 14 (limite de pilha, verificador de certificados, verificador do runtime, X.509, split bundle)\n" +
"  lume stack <src.src> [--fn <f,g>] [--asm <file.s>] [--critical] [--json]   Bytes de pilha no pior caso das funcoes `@no_alloc`, sobre o x86-64 emitido (`lstack`)\n" +
"  lume smt-check <cert.smt2>... [--dir <dir>] [--raw] [--budget <n>] [--verbose]   Confere os certificados SMT-LIB2 do `lume tv` com o verificador nativo (`lsmt`)\n" +
"  lume tv-rt <src.src> [--asm <file.s>] [--canon]   Verifica os helpers inteiros do runtime emitidos contra a especificacao (`ltv_rt`)\n" +
"  lume x509 verify --chain <leaf.der,ca.der> --anchor <root.der> --now <unix-seconds>   Validacao de caminho X.509 v3 (Ed25519); exit 0 valido, 3 invalido\n" +
"  lume x509 show <certificate>               Campos de um certificado (DER ou PEM) em JSON\n" +
"  lume entropy [--bytes <n>] [--source <device>] [--json]   Bytes da fonte aleatoria do SO, liberados apos os testes de saude\n" +
"  lume safety-envelope <kernel.src> --fn <f> --split <outdir>   Exporta o split bundle (os dois canais como programas independentes)\n" +
"  lume safety-envelope --split-run --manifest <m> --seq <n> --args <a,b,..> --cmd-a <cmd> --cmd-b <cmd> [--cmd-c <cmd>] [--frame-timeout-ms <n>]\n" +
"                                             Vota sobre os programas exportados pelo protocolo de frames\n" +
"  lume safety-envelope --split-verify <manifest.json>   Recalcula o hash dos artefatos de um bundle contra o manifesto\n" +
"  lume safety-envelope <kernel.src> --fn <f> --args <a,b,..> [--inject <kind:params>] [--log <file>] [--work <dir>] [--ltv <path>] [--ltv-timeout-ms <n>]\n" +
"                                             As demais opcoes do protocolo do lockstep (`--inject` e instrumento de teste, registrado no log)\n" +
"  lume tv-rt-gate [--stride <n>]             Gate de mutacao do `ltv_rt` (`tv_rt_gate`)\n" +
"  lume smt-cert-gate [--require-z3] [--solver <none>] [--chameleon] [--sites <n>] [--corpus <dir>]   Gate do `lsmt` (`smt_cert_gate`; o z3 e a verdade de referencia quando instalado)\n" +
"  lume lcaas-scale-gate [--full] [--modes <a,b>] [--fams <x,y>] [--reps <k>] [--timeout <ms>] [--lcaas <path>]   Gate de regressao de complexidade do `lcaas` (`lcaas_scale_gate`)\n" +
"  lume cli-parity                            O gate de paridade da linha de comando, sozinho (precisa de um checkout do fonte)\n" +
"\n" +
"- **`lstack` (pilha no pior caso)**: para cada funcao `@no_alloc`, o maximo, sobre todo caminho do grafo de fluxo\n" +
"  de controle do texto EMITIDO, dos bytes usados abaixo do `%rsp` de entrada, incluindo enderecos de retorno e\n" +
"  chamados; as rotinas de runtime alcancadas sao analisadas pelas mesmas regras, nao presumidas. Dois limites sao\n" +
"  reportados: `all paths` (muitas vezes `unbounded`, porque o caminho lento do `+` pode alocar) e `proven`, que\n" +
"  remove exatamente as arestas de caminho lento que as provas de faixa do `[E0210]` tornam mortas e lista cada\n" +
"  remocao como uma premissa. Limites: o limite `proven` e condicional a essas provas (a ferramenta nao as refaz);\n" +
"  um chamador fora de codigo `@no_alloc` pode passar um inteiro boxed; frames de sinal ficam fora do modelo; um\n" +
"  ciclo de chamadas ou um caminho ate o alocador e `unbounded`. Status de saida 3 quando uma funcao e rejeitada.\n" +
"- **`lsmt` (verificador de certificados)**: um procedimento de decisao que nao compartilha codigo com o `ltv`, o\n" +
"  `lcert` ou o compilador (forma normal polinomial, congruencia, divisao de casos sobre os inteiros). So `unsat`\n" +
"  passa: `unknown`, `unsupported`, `malformed` e `forged` sao falhas. No modo certificado o script precisa ter a\n" +
"  forma exata de uma afirmacao do `ltv` (`--raw` refuta qualquer script do subconjunto). Limites: `unsat`\n" +
"  estabelece que o TEXTO do certificado e uma refutacao valida, nao que o texto descreve o fonte e o assembly\n" +
"  (esse vinculo e do `ltv`); o procedimento e incompleto por projeto (orcamento, termos nao lineares como atomos).\n" +
"- **`ltv_rt` (helpers do runtime)**: os helpers inteiros que o `ltv` toma como axiomas (`mkint`, `addv`,\n" +
"  `__rt_sub`, `__rt_mul`, `__rt_div`, `__rt_mod`, as formas com wrap, `cmpv`, `eqv`, os helpers de unboxing) sao\n" +
"  verificados no texto emitido por execucao simbolica sobre todas as entradas dos casos modelados; o que fica fora\n" +
"  do modelo e rejeicao. Continuam axiomas: o contrato do alocador, a cauda de trap que nao retorna e os fatos de\n" +
"  x86-64 listados. `--canon` acrescenta o experimento que mostra quais helpers dependem do invariante canonico.\n" +
"- **X.509 e entropia (`use lcrypto_tls`)**: o `lume x509 verify` valida um caminho (folha primeiro, cada\n" +
"  certificado emitido pelo seguinte) contra ancoras fixadas, no instante `--now`: DER estrito, validade,\n" +
"  basicConstraints, keyUsage, comprimento de caminho, encadeamento de nomes e assinaturas Ed25519. Limites: apenas\n" +
"  Ed25519 (certificados RSA e ECDSA sao recusados), no maximo 8 certificados, sem conferencia de nome de host, sem\n" +
"  revogacao, sem name constraints nem politicas; a ferramenta nao tem relogio, quem chama fornece `--now`. O\n" +
"  `lume entropy` le `/dev/urandom` e so libera bytes quando os testes de saude passam (tudo zero, tudo igual,\n" +
"  contagem de repeticao, proporcao adaptativa, leituras consecutivas identicas): eles detectam fonte morta ou\n" +
"  travada, NAO medem nem certificam entropia.\n" +
"- **Canal B clean-room**: o canal monitor do `lume safety-envelope` nao compartilha front-end com o `lumec`. O\n" +
"  lexer, o parser, o checker tipado e o gerador de codigo RV32IM dele sao escritos a partir da definicao da\n" +
"  linguagem dentro de `lsafety_envelope.src`, que nao liga o compilador (o gate confere isso no bundle da\n" +
"  ferramenta), e todo `requires` / `ensures` vira cheque em tempo de execucao. Onde a especificacao e o `lumec`\n" +
"  divergem, o kernel e recusado. Limites: os dois canais recebem o mesmo texto do kernel e a mesma definicao da\n" +
"  linguagem (uma especificacao errada e implementada duas vezes); a mesma equipe escreveu os dois; apenas o\n" +
"  fragmento de kernel inteiro / bool; dominio i32 no monitor.\n" +
"- **Split bundle** (`docs/41-safety-envelope-split-bundle.md`): `--split` grava o canal A como programas x86-64,\n" +
"  AArch64 e RV64, o canal B como imagem RV32IM bare-metal, e `manifest.json` com tamanho e SHA-256 de cada um.\n" +
"  `--split-run` envia um frame de requisicao a cada comando e vota sobre os frames de resposta (CRC, sequencia, id\n" +
"  do kernel, eco dos argumentos, status, resultado exato); frame ausente, atrasado, malformado ou repetido e trip,\n" +
"  travado no log de eventos. Nivel real: executado neste host e sob QEMU (`qemu-aarch64`, `qemu-riscv64`,\n" +
"  `qemu-system-riscv32`), nao em silicio; dois processos em um host nao sao duas placas; o votador e o log dele\n" +
"  sao um ponto unico. Os programas AArch64 / RV64 so existem para kernels dentro do fragmento do `lkir` (o\n" +
"  manifesto registra o motivo quando nao).\n" +
"- **Cache do driver e execucoes concorrentes**: `lume build`, `lume run`, `lume test`, `lume check`, `lume prove`\n" +
"  e `lume certify` mantem o cache em `build/driver-cache` do checkout (entradas conferidas por hash, publicadas por\n" +
"  rename), usam nomes de rascunho por processo e nao gravam nada no diretorio home; assim varios drivers podem\n" +
"  trabalhar no mesmo checkout. A chave de um bundle em cache e o SHA-256 de todo modulo incluido.\n" +
"- **`lume pack`**: o corpo e o formato de bloco LZ4; o arquivo comeca com um cabecalho de 20 bytes (magica `LZ1`,\n" +
"  tamanho original, checksum) e nao e um frame LZ4.\n" +
"\n" +
"## 8.4 Orquestrador Universal de Modulos (`LumeSynapse`) e Memoria Proativa\n" +
"- `lume synapse <arq.src>` (ou `lume orchestrate <arq.src>`): Coordena todos os modulos\n" +
"  da Lume (`lmod`, `lumec`, `lasm`, `lcaas`, `lcert`, `ltest`, `lprotect`, `lsentience`)\n" +
"  atraves do barramento compartilhado (`synapse_bus.json`) da memoria de senciencia no diretorio home.\n" +
"  Desde a Onda 14 os comandos comuns (`lume build`, `lume run`, `lume test`, `lume check`, `lume prove`,\n" +
"  `lume certify`) nao gravam essa memoria: o cache deles e `build/driver-cache` dentro do checkout, e\n" +
"  `lume check` e `lume prove` compartilham uma resposta do oraculo em cache por bundle.\n" +
"- `lume recall <arq.src>`: Consulta a Memoria Soberana Proativa O(1) com selos\n" +
"  criptograficos `.sha256` anti-adulteracao (provas ate 91x mais rapidas e builds 20x\n" +
"  mais rapidos).\n" +
"- `lume self-prove` (ou `lume prove-all` / `lume verify-all` / `lume self prove`): Executa\n" +
"  nativamente dentro do proprio compilador as baterias de provas (todo numero do JSON e medido na execucao)\n" +
"  (`LumeCompiler-Embedded-OmniProof-v4`) sem nenhum script externo (`std.net`, `std.gfx`,\n" +
"  `lume_crypto_blockchain_engine`, `lume_reversa_engine`, `lume_pingora_proxy_engine`,\n" +
"  `lume_egm_engine`, `lume_ncm_engine`, `lume_opentpu_engine`, `lume_continuum_nexus_engine`,\n" +
"  `lume_quantum_nexus_engine`, `lchameleon`, `lsentience`, `lmanual`, `KerneLume` Bare-Metal OS,\n" +
"  guardas `[K0005]`/`[K0006]`/`[C0009]`/SRA e `MANIFEST.sha256`: 700 obrigacoes formais +\n" +
"  162 testes unitarios + 99 artefatos verificados + 112 dominios autonomos + 17 modulos LumePuter).\n"

fn man_pt_examples() = "# CAPITULO 9: 6 EXEMPLOS PRATICOS PRONTOS PARA COPIAR E RODAR\n\n" +
"## Exemplo 1: Listas, Recursao e Pattern Matching (`lista.src`)\n" +
"```lume\n" +
"fn dobrar_todos(xs) = match xs\n" +
"    Nil        => Nil\n" +
"    Cons(h, t) => Cons(h * 2, dobrar_todos(t))\n\n" +
"fn somar(xs) = match xs\n" +
"    Nil        => 0\n" +
"    Cons(h, t) => h + somar(t)\n\n" +
"fn test_soma() = somar(dobrar_todos(Cons(5, Cons(10, Nil)))) == 30\n" +
"print str(somar(dobrar_todos(Cons(5, Cons(10, Nil)))))\n" +
"```\n\n" +
"## Exemplo 2: Transferencia Bancaria com Prova Formal (`banco.src`)\n" +
"```lume\n" +
"fn transferir(origem: int, destino: int, valor: int) -> int\n" +
"  requires origem >= valor and valor >= 0 and destino >= 0\n" +
"  ensures result == origem + destino\n" +
"= (origem - valor) + (destino + valor)\n\n" +
"law conserva_total(o: int, d: int, v: int) = ((o - v) + (d + v)) == (o + d)\n" +
"print str(transferir(1000, 500, 250))\n" +
"```\n\n" +
"## Exemplo 3: Dicionario Hash (`std.map`) e SHA-256 (`dicionario.src`)\n" +
"```lume\n" +
"use fs_sha256_file\n" +
"use map\n\n" +
"fn executar() =\n" +
"    let m0 = map_new() in\n" +
"    let m1 = map_put(m0, \"creator\", lc_sha256(\"Ricardo Bueno\")) in\n" +
"    map_get_or(m1, \"creator\", \"missing\")\n\n" +
"print executar()\n" +
"```\n\n" +
"## Exemplo 4: Banco de Dados B+Tree + WAL ACID (`banco_dados.src`)\n" +
"```lume\n" +
"use db\n\n" +
"fn run_db() =\n" +
"    let d0 = db_open(2) in\n" +
"    let tx = db_put(db_begin_tx(d0), 1, 100, 1) in\n" +
"    let d1 = db_commit_tx(tx) in\n" +
"    db_read(d1, 1, 0)\n\n" +
"print str(run_db())\n" +
"```\n\n" +
"## Exemplo 5: Motor Cripto, Mineracao PoW SHA-256 e DeFi AMM (`cripto.src`)\n" +
"```lume\n" +
"use lume_crypto_blockchain_engine\n\n" +
"fn crypto_sha256_rounds(msg: str) = crypto_hmac_sha256(\"lume-key\", msg)\n" +
"print crypto_sha256_rounds(\"block-0\")\n" +
"```\n\n" +
"## Exemplo 6: Kernel Bare-Metal com Limite de Ciclos WCET (`rtc_kernel.src`)\n" +
"```lume\n" +
"@bound(cycles: 128)\n" +
"fn bcd_para_binario(bcd: int) -> int\n" +
"  requires bcd >= 0 and bcd <= 153\n" +
"  ensures result >= 0\n" +
"= ((bcd / 16) * 10) + (bcd % 16)\n\n" +
"print str(bcd_para_binario(35))\n" +
"```\n\n" +
"## Exemplo 7: Interoperabilidade Poliglota Camaleao (`chameleon_demo.src`)\n" +
"```lume\n" +
"use lchameleon\n\n" +
"fn run_chameleon_demo() =\n" +
"    let ok = chameleon_verify_boundary(1, 1, 1, 64, 4096) in\n" +
"    let r = chameleon_adapt_ecosystem(\"rust\") in\n" +
"    str(ok) + \":\" + r.id\n\n" +
"print run_chameleon_demo()\n" +
"```\n\n" +
"## Exemplo 8: LumePuter & LumePU VM Neural e NPU nos Pesos (`lumeputer_demo.src`)\n" +
"```lume\n" +
"use lchameleon\n\n" +
"fn run_lumeputer_demo() =\n" +
"    let relu_val = lumeputer_swiglu_exact_relu_unit(42, 1, 20) in\n" +
"    let ram_cell = lumeputer_deltanet_ram_step_exact(99, 777, 1) in\n" +
"    let vx_mac = lumepu_vx_vmat_row_mac_exact(10, 4, 8, 64) in\n" +
"    let layers = lumeputer_compile_rv32_vx_to_weights_layers(64, 1, 1) in\n" +
"    str(relu_val) + \":\" + str(ram_cell) + \":\" + str(vx_mac) + \":\" + str(layers)\n\n" +
"print run_lumeputer_demo()\n" +
"```\n"

fn man_pt_errors() = "# CAPITULO 10: TABELA DE CODIGOS DE ERRO E COMO CORRIGIR\n\n" +
"| Codigo    | Categoria            | Causa e Como Resolver |\n" +
"|-----------|----------------------|-----------------------|\n" +
"| `[P0002]` | Sintaxe / Parser     | Token inesperado, `let` solto no topo de `.src`, ou `match` sem chaves aninhado. Mova o `match` para `fn aux(x) = match x ...` ou use `match x " + man_br(" ... ") + "`, e garanta quebras de linha LF (`\\n`). |\n" +
"| `[R0200]` | Escopo / Nomes       | Funcao ou variavel nao declarada. Verifique a grafia ou adicione `use <modulo>` no topo do arquivo. |\n" +
"| `[R0201]` | Escopo / Nomes       | Funcao com o nome de uma rotina do runtime (`count`, `at`, ...) ou com um prefixo reservado a ele (`__rt_`, `__gc_`, `__lume_`, `__c_`, `__k_`, `__r_`, `__isr_`, `__cpu_`, `__krn_`, `__net_`). Renomeie. |\n" +
"| `[T0300]` | Forma de Tensor      | Dimensoes incompativeis em `tensor[...]`: a dimensao de um argumento difere da do parametro, ou os ramos de um `if` divergem. |\n" +
"| `[T2001]` | Tipos                | Operador aplicado a tipos incompativeis (`int + str`, `money[BRL] + money[USD]`). Converta os dois operandos para o mesmo tipo. |\n" +
"| `[T2002]` | Tipos                | A funcao retorna um tipo diferente do declarado. Corrija o corpo ou o tipo de retorno. |\n" +
"| `[E0200]` | Efeitos Algebricos   | Funcao marcada com `/ pure` tentou fazer I/O, rede, `arena_new` ou `embed`. Remova `/ pure` ou declare o efeito. |\n" +
"| `[O0001]` | Ownership / Borrow   | Uso de valor apos transferencia de posse (`move`) ou uso de arquivo ja fechado. |\n" +
"| `[V0001]` | Prova de Contrato    | Contrato `requires`/`ensures` ou `law` refutado pelo solver `QF_LIA`. Veja o contraexemplo impresso ou rode `lume heal <arq.src>`. |\n" +
"| `[V0002]` | Limite de Ciclos     | Funcao excedeu o orcamento `@bound(cycles: N)` ou possui recursao ilimitada em `@interrupt`. |\n" +
"| `[I0003]` | Interop Poliglota/C  | Declaracao C/poliglota insegura sem guarda explicita (`lume adapt c` / `lchameleon`). Promova `unverified[T] -> verified[T]` com limites `QF_LIA` ou `@repr(c)`. |\n" +
"| `[I0275]` | Sandbox WASM         | Um modulo WebAssembly entregue ao sandbox de capacidades importa uma capacidade de host nao concedida (`path_open`, `sock_*`), declara memoria fora de `1..16` paginas ou esta malformado. |\n" +
"| `[C0271]` | Comptime Embed       | `comptime embed(\"...\")`: o caminho nao e uma string, esta vazio, contem `..` ou aponta para um arquivo inexistente. |\n" +
"| `[D0273]` | Esquema de Tabela    | `comptime table_schema(T)`: `T` nao e um tipo registro nominal, ou uma coluna tem tipo nao suportado ou moeda invalida. |\n" +
"| `[K0005]` | Bare-Metal W^X / DMA | `mmio_volatile_write*`, `mem_copy` ou `mem_set` aponta para `.text`/`.rodata` (`[0x8000..0x3FFFF]`), inclusive `base + off` simbolico. Use endereco seguro de RAM (`>= 0x40000`). |\n" +
"| `[K0006]` | Pilha de Kernel      | Ciclo de recursao mutua ilimitada (`f -> g -> f`) em modulo `@freestanding` / `kernel_boot_entry`. Use loop tail-call ou iteracao limitada. |\n" +
"| `[C0009]` | Cripto Constant-Time | Branch `if`/`match`, divisao `/` ou `%`, curto-circuito `and`/`or` ou indice de memoria dependente de segredo. Segredos sao parametros chamados `secret` ou `secret_*`; numa funcao cujo nome comeca com `ct_`, todo parametro e segredo (so os `secret*`, se houver), entao `fn ct_tam(n) = if n == 0 then 1 else 2` falha e `fn tam(n) = ...` passa. Use acumulacao bitwise XOR/OR em tempo constante, ou tire o prefixo `ct_` se a funcao nao trata segredo. |\n" +
"| `[C0010]` | Constant-Time de Maquina | `lume tv`: o codigo emitido de uma `@secret fn`, ou de uma rotina que ela alcanca por `call`, tem desvio condicional, divisao ou acesso a memoria fora de frame e pilha. Escreva a funcao como kernel constant-time (`@secret` + `@no_alloc`). |\n" +
"| `[C0011]` | Kernel Constant-Time | Funcao `@secret` + `@no_alloc` com `requires`, `ensures` nao provado, condicional, comparacao, `/` ou `%`, shift por nao-literal, recursao, tipo que nao e `int` ou chamada de funcao que nao e kernel. Use mascaras, `ct_select(mask, a, b)` e `ct_eq(a, b)`. |\n" +
"| `[L0001]` | Lexico / Montador    | Literal de string nao terminado em um arquivo fonte (feche com aspas duplas); o `lasm` usa o mesmo codigo para instrucao ou diretiva desconhecida. |\n" +
"| `[L0010]` | Ligacao              | Um simbolo definido duas vezes na mesma imagem, o que mandaria chamadas para a rotina errada. |\n" +
"| `[L0002]` | Escape de String     | Sequencia de escape desconhecida em string (validos: `\\n`, `\\r`, `\\t`, `\\b`, `\\f`, `\\0`, `\\xHH`, `\\'`, `\\\"`, `\\\\`, `\\{`, `\\}`, `\\$`). |\n" +
"| `[W0002]` | Scanner de Segredos  | Chave privada ou token detectado no codigo-fonte durante `--protect`; remova o segredo literal. |\n" +
"| `[W0003]` | Nome Duplicado       | Um nome definido em dois modulos do mesmo programa (aviso: cada modulo fica com o seu). Renomeie um, use `priv fn` ou escreva `modulo.nome` onde os dois sao visiveis. |\n" +
"| `[W0004]` | f64 com int          | Um operador aritmetico mistura f64 e int (aviso: o int e convertido em execucao). Escreva `f64(n)` para deixar explicito, ou `f64_int(x)` para um resultado int. |\n" +
"| `[W0005]` | Obsoleto             | A funcao esta marcada com `## Deprecated: <mensagem>` (comentario logo acima dela) e e chamada de outro modulo. Ela continua funcionando por pelo menos uma versao MINOR inteira (docs/STABILITY.md); passe para a substituta indicada. |\n"

## ============================================================================
## DISPATCHER, FULL MANUAL COMPOSER, JSON & EXPORT ("LUME GERA LUME")
## ============================================================================

## the factual reference (docs/LUME_REFERENCE_EN.md / _PT_BR.md, examples checked by tests/docs/ref_examples_gate.src)
fn man_en_ref() = "# Lume Reference (factual) — v1.2.0\n" +
"\n" +
"This is the reference of what works today. It contains no roadmap and no vision material: that is in\n" +
"`lume manual vision` and in the other chapters, which mix both. Every example below is run by\n" +
"`tests/docs/ref_examples_gate.src` (in the test suite) with the installed toolchain; the block under each example\n" +
"is its exact output.\n" +
"\n" +
"Status labels: **stable** = Linux x86-64 and Windows x64, same behavior; **linux** / **windows** = that platform\n" +
"only; **experimental** = works, the API may still change; **privileged** = needs root (Linux) or an elevated\n" +
"process (Windows).\n" +
"\n" +
"## 1. Programs and commands\n" +
"\n" +
"A program is a `.src` file. Top-level `print` lines run in order. `lume run f.src [args]` builds and runs it,\n" +
"`lume build f.src -o out` writes a native executable (`out.exe` on Windows), `lume test f.src` runs every\n" +
"`fn test_*()` that returns a truth value, `lume check f.src` type-checks without running, `lume fmt f.src` formats\n" +
"in place (`--check`, `--stdout`), `lume manual [chapter]` prints the manual (`--pt` in Portuguese). `lume run --profile f.src` prints per function\n" +
"the self and total time, calls and allocations, and the GC time, on stderr at exit (inlined functions count in their\n" +
"caller; `LUME_FL=off` keeps them; a tail loop is one call).\n" +
"\n" +
"`lume verify [--jobs=N] a.src b.src ...` runs check, test, prove, fmt --check and certify on many files in N processes\n" +
"(default 2); each file's result is cached by the SHA-256 of its whole bundle and of the tools, so after a change only\n" +
"the changed module and the files that import it run again.\n" +
"\n" +
"Packages: `lume pkg publish [dir] --store=DIR` runs the package's tests and stores NAME/VERSION immutably with its\n" +
"SHA-256; `lume pkg add NAME@REQ` writes `name = \"REQ\"` under `[dependencies]` (REQ: `1.2.3`, `^1.2`, `~1.2.3`, `*`);\n" +
"`lume pkg install --store=DIR` takes the highest matching versions into `lume_modules/`, runs their tests and writes\n" +
"the versions and hashes into `lume.lock`; `use NAME` finds an installed package.\n" +
"\n" +
"Official examples: `examples/topics/*.src` (one file per topic, each run by `lume test`) and\n" +
"`examples/diagnostics/` (for a diagnostic code, `CODE_name.bad` gives it and `CODE_name.fixed.src` is the corrected\n" +
"program); `tests/docs/examples_gate.src` runs all of them on every release.\n" +
"\n" +
"```lume\n" +
"fn square(x) = x * x\n" +
"print square(7)\n" +
"```\n" +
"```output\n" +
"49\n" +
"```\n" +
"\n" +
"## 2. Syntax\n" +
"\n" +
"- `fn name(a, b) = expr`, `pub fn` (exported), `priv fn` (private to its module), `const NAME: T = expr`,\n" +
"  `type T = A(x) | B(x, y)`, `use module`, `use module as alias`, `use std/NAME` (always the standard library's NAME, even when the project has a NAME.src), `## comment` (to the end of the line).\n" +
"- Expressions: `let x = e in body`, `if c then a else b`, `match v` with one `Pattern => expr` per line,\n" +
"  `fn(x) => expr` (a closure; captures variables), `{{a: 1, b: 2}}` (record), `r.a` (field), `{{ r with a: 3 }}`\n" +
"  (a copy with a field changed), `[1, 2, 3]` (a list), `Cons(h, t)` / `Nil`.\n" +
"- Integers are 64-bit; an overflow stops the program (exit 3). `/` truncates toward zero, `%` has the sign of the\n" +
"  left operand. `*` `/` `%` bind tighter than `+` `-`. Comparisons and `and` / `or` / `not` give booleans, printed\n" +
"  as `1` / `0`.\n" +
"- Strings are bytes (UTF-8): `count` counts bytes, `+` joins two strings and nothing converts implicitly\n" +
"  (`str(x)` makes a string, `toint(s)` reads one).\n" +
"\n" +
"```lume\n" +
"type Shape = Circle(r) | Rect(w, h)\n" +
"fn area(s) = match s\n" +
"    Circle(r)  => 3 * r * r\n" +
"    Rect(w, h) => w * h\n" +
"print area(Circle(2))\n" +
"print area(Rect(3, 4))\n" +
"let p = {{x: 1, y: 2}}\n" +
"print p.x + p.y\n" +
"let q = {{ p with y: 10 }}\n" +
"print q.y\n" +
"print 7 / 2\n" +
"print 0 - 7 / 2\n" +
"print 7 % 3\n" +
"```\n" +
"```output\n" +
"12\n" +
"12\n" +
"3\n" +
"10\n" +
"3\n" +
"-3\n" +
"1\n" +
"```\n" +
"\n" +
"## 3. Errors at run time\n" +
"\n" +
"A program stops with exit code 3 and one line on stderr on: integer overflow, division by zero, an index outside a\n" +
"list, string or buffer, a field a record does not have, a value of the wrong kind for an operation, a `match` with\n" +
"no arm. `lume test` reports such a stop as a failed test and goes on with the others. After the message come the\n" +
"calls that led there, innermost first, one `  at NAME (file.src:LINE)` line each (a function inlined into its caller\n" +
"and a tail call leave no line; `LUME_FL=off` keeps small functions as calls).\n" +
"\n" +
"```lume\n" +
"print 9223372036854775807 + 1\n" +
"```\n" +
"```output\n" +
"exit 3\n" +
"stderr: lume: integer overflow\n" +
"```\n" +
"\n" +
"## 4. Core builtins (stable)\n" +
"\n" +
"| Builtin | Answer | On a wrong argument |\n" +
"| --- | --- | --- |\n" +
"| `count(s)` | bytes of a string, or elements of a list | stops on a value that has no length |\n" +
"| `at(s, i)` | the byte at i as a one-byte string | `\"\"` when i is outside |\n" +
"| `slice(s, a, b)` | bytes a..b-1, clamped to the string | — |\n" +
"| `ord_at(s, i)` | the byte at i as an int (0..255) | stops when outside |\n" +
"| `chr(n)` | the one-byte string of n (0..255) | stops outside 0..255 |\n" +
"| `str(v)` | the text of a value | — |\n" +
"| `toint(s)` | the integer written in s | `0` when s is not an integer (check the text first) |\n" +
"| `print v` / `emit(s)` / `flush()` | write to stdout | — |\n" +
"\n" +
"```lume\n" +
"print count(\"héllo\")\n" +
"print slice(\"abcdef\", 1, 4)\n" +
"print ord_at(\"A\", 0)\n" +
"print chr(66)\n" +
"print str(42) + \"!\"\n" +
"print toint(\"123\") + 1\n" +
"print bit_and(12, 10)\n" +
"print bit_shl(1, 4)\n" +
"print at(\"ab\", 5) == \"\"\n" +
"print toint(\"abc\")\n" +
"print slice(\"abc\", 2, 9)\n" +
"print count([1, 2, 3])\n" +
"```\n" +
"```output\n" +
"6\n" +
"bcd\n" +
"65\n" +
"B\n" +
"42!\n" +
"124\n" +
"8\n" +
"16\n" +
"1\n" +
"0\n" +
"c\n" +
"3\n" +
"```\n" +
"\n" +
"## 5. Byte buffers (stable)\n" +
"\n" +
"`buf_new(n)` (n bytes, all zero), `buf_len(b)`, `buf_get(b, i)` (0..255), `buf_set(b, i, v)` (answers b),\n" +
"`buf_copy(dst, d_off, src, s_off, n)`, `buf_slice(b, off, n)`, `buf_from_str(s)`, `buf_to_str(b, off, n)`,\n" +
"`buf_addr(b)` (the address of byte 0, for system calls). An index outside the buffer or a value outside\n" +
"0..255 stops the program.\n" +
"\n" +
"```lume\n" +
"let b = buf_new(4)\n" +
"let s = buf_set(b, 0, 255)\n" +
"print buf_len(b)\n" +
"print buf_get(b, 0)\n" +
"print buf_get(b, 1)\n" +
"```\n" +
"```output\n" +
"4\n" +
"255\n" +
"0\n" +
"```\n" +
"\n" +
"Video and codec builtins (stable; arguments are buffers, byte offsets and strides; each answers -1 on a wrong\n" +
"argument): `buf_bgra_to_i420`, `buf_i420_to_bgra`, `buf_sad16x16 / 8x8 / 4x4 (a, ai, sa, b, bi, sb)` and\n" +
"`buf_satd4x4 / 16x16 (same)` (SSE2), `buf_h264_fdct4x4 / idct4x4 (src, si, dst, di)` (int16 blocks),\n" +
"`buf_h264_quant4x4 (src, si, qp, intra, dst, di)` (answers the nonzero levels), `buf_h264_dequant4x4 (src, si, qp,\n" +
"dst, di)`, `buf_h264_sub4x4 (a, ai, sa, pred, pi, dst)`, `buf_h264_recon4x4 (pred, pi, res, ri, dst, di)`,\n" +
"`buf_h264_intra4x4 / intra16x16 (frame, fi, fs, mode, avail, dst)` (avail bits: 1 left, 2 top, 4 top-right,\n" +
"8 top-left).\n" +
"\n" +
"Bit writing (stable; most significant bit first): `buf_bits_write(b, pos, v, n)` writes the low n bits of v (1..32)\n" +
"at bit pos and answers pos + n, `buf_bits_read(b, pos, n)` answers them, `buf_bits_ue(b, pos, v)` / `buf_bits_se(b,\n" +
"pos, v)` write Exp-Golomb codes and answer the new pos; each answers -1 on a wrong argument.\n" +
"\n" +
"## 5a. Floating point (stable)\n" +
"\n" +
"`f64` is an IEEE 754 double: `f64(x)` makes one from an int, a decimal, another f64 or text (`f64(\"1e-9\")`,\n" +
"`f64(\"inf\")`, `f64(\"nan\")`); `+ - * /` and `< > <= >=` work on it (an int or decimal operand is converted), `==`\n" +
"compares by value. `print` / `str` give the shortest text that reads back to the same double. Functions:\n" +
"`f64_sqrt`, `f64_abs`, `f64_floor`, `f64_ceil`, `f64_round` (half away from zero), `f64_int` (toward zero, to an\n" +
"int), `f64_sin`, `f64_cos`, `f64_tan`, `f64_atan2(y, x)`, `f64_exp`, `f64_log`, `f64_log10`, `f64_pow(x, y)`,\n" +
"`f64_is_nan`, `f64_str(x, decimals)`, `f64_bits` / `f64_from_bits`. A literal with a point (`1.5`) is an exact\n" +
"decimal, not an f64: write `f64(1.5)` or `f64(\"1.5\")`. A comparison with NaN stops the program (test with\n" +
"`f64_is_nan`). A parameter declared `x: f64` converts what it receives with `f64(x)` on entry, so a decimal literal\n" +
"works there: `fn hyp(a: f64, b: f64) -> f64 = sqrt(a * a + b * b)` and `hyp(3.0, 4.0)`. `use math` gives `sqrt exp log\n" +
"log10 pow sin cos tan atan2 floor ceil round abs_f fmin fmax tofloat is_nan is_inf`, `f32(x)` (nearest single\n" +
"precision, ties to even) and `buf_f32_get(b, off)` / `buf_f32_set(b, off, x)` (4 bytes, little endian). `lume check`\n" +
"warns [W0004] where an int meets an f64 (it is converted at run time); `lume prove` marks a contract over f64\n" +
"`runtime_checked` with the reason (the integer prover does not decide floating point).\n" +
"\n" +
"```lume\n" +
"fn hypot(a, b) = f64_sqrt(a * a + b * b)\n" +
"print hypot(f64(3), f64(4))\n" +
"print hypot(f64(3), f64(4)) == f64(5)\n" +
"print f64(1) / f64(3)\n" +
"print f64_str(f64(\"2.5\"), 2)\n" +
"print f64_is_nan(f64(\"nan\"))\n" +
"print f64_int(f64_floor(f64(\"-2.5\")))\n" +
"print f64_pow(f64(2), f64(10))\n" +
"```\n" +
"```output\n" +
"5.0\n" +
"1\n" +
"0.3333333333333333\n" +
"2.50\n" +
"1\n" +
"-3\n" +
"1024.0\n" +
"```\n" +
"\n" +
"## 6. Files and the operating system (stable)\n" +
"\n" +
"| Builtin | Answer |\n" +
"| --- | --- |\n" +
"| `fs_read_file(p)` | the content, `\"\"` when it cannot be read |\n" +
"| `fs_write_sync(p, s)` / `fs_append_sync(p, s)` | 1, or 0 on failure |\n" +
"| `fs_path_exists(p)` / `fs_remove(p)` / `fs_mkdir(p)` / `fs_copy(a, b)` | 1, or 0 |\n" +
"| `os_getenv(name)` | the value, `\"\"` when unset |\n" +
"| `os_platform()` | `\"linux\"` or `\"windows\"` |\n" +
"| `os_arg_count()` / `os_arg_at(i)` | the program's arguments |\n" +
"| `os_monotonic_ns()` | a monotonic clock in nanoseconds |\n" +
"| `os_exit(code)` | ends the program |\n" +
"\n" +
"```lume\n" +
"print fs_write_sync(\"ref_probe.txt\", \"hi\")\n" +
"print fs_read_file(\"ref_probe.txt\")\n" +
"print fs_remove(\"ref_probe.txt\")\n" +
"print fs_path_exists(\"ref_probe.txt\")\n" +
"print fs_read_file(\"no_such_file.txt\") == \"\"\n" +
"print os_getenv(\"LUME_SURELY_UNSET_VAR\") == \"\"\n" +
"```\n" +
"```output\n" +
"1\n" +
"hi\n" +
"1\n" +
"0\n" +
"1\n" +
"1\n" +
"```\n" +
"\n" +
"Network (stable): `net_udp_bind_addr(ip, port)` (a socket, -1 on failure), `net_udp_send_to(fd, ip, port, data)`\n" +
"(bytes sent), `net_udp_recv_from(fd, max)` (the datagram, `\"\"` when none), `net_last_peer_ip()`,\n" +
"`net_last_peer_port()`, `net_tcp_connect_addr(ip, port)` (a socket, -1 when refused), `net_close(fd)`;\n" +
"`use netctl` adds timeouts and non-blocking I/O with epoll.\n" +
"\n" +
"## 7. Standard library modules\n" +
"\n" +
"| Module | What it gives | Status |\n" +
"| --- | --- | --- |\n" +
"| `h264` | `buf_h264_luma_mc(ref, ri, rs, rw, rh, x, y, mx, my, w, h, dst, di, ds)` (quarter-sample 6-tap luma, 8.4.2.2.1), `buf_h264_chroma_mc(...)` (same arguments, eighth-sample bilinear, 8.4.2.2.2), `buf_h264_deblock_edge(buf, q0, across, along, lines, bs, alpha, beta, tc0, chroma)` (8.7.2.3 / 8.7.2.4; bs and tc0 lists, one value per 4 luma / 2 chroma lines); 0, or -1 on a wrong argument; coordinates clamped to the picture | stable |\n" +
"| `hash` | `crc32`, `adler32`, `md5`, `sha1`, `sha256` (strings; `*_buf` for buffers), `hex32` | stable |\n" +
"| `csv` | `csv_parse(text)` (RFC 4180: quotes, separators and line breaks inside fields), `csv_format(rows)`, `csv_parse_sep` / `csv_format_sep`, `csv_field` | stable |\n" +
"| `utf8` | `utf8_len`, `utf8_decode` / `utf8_encode`, `utf8_char`, `utf8_cp`, `utf8_slice`, `utf8_upper` / `utf8_lower` (ASCII + Latin-1), `utf8_reverse`, `utf8_valid` (strings are bytes; these count characters) | stable |\n" +
"| `datetime` | `dt_from_unix`, `dt_to_unix`, `dt_iso`, `dt_parse_iso`, `dt_weekday`, `dt_add_days` / `dt_add_months`, `dt_offset(zone, t)` / `dt_local` / `dt_iso_local` (fixed offsets, US / EU / Sydney daylight rules) | stable |\n" +
"| `regex` | `re_match`, `re_search`, `re_find`, `re_find_all`, `re_groups`, `re_replace` (`$1`), `re_split`: classes, `\\d \\w \\s`, anchors, groups, alternation, greedy and lazy quantifiers | stable |\n" +
"| `deflate` | `inflate_buf` / `deflate_buf`, `zlib_decompress` / `zlib_compress`, `gunzip` / `gzip`, `gunzip_str` / `gzip_str` (Adler-32 / CRC-32 checked) | stable |\n" +
"| `http` | `http_get`, `http_post`, `http_request(method, url, headers, body, ms)`, `http_header`: chunked, gzip, redirects, deadlines; `https://` through `tls` | stable |\n" +
"| `tls` | `tls_request(host, port, data, ms)`: TLS 1.3 client (X25519, AES-128-GCM / ChaCha20-Poly1305); the server certificate is checked against the system roots (`SSL_CERT_FILE`, the Linux bundle, the Windows stores through `lchameleon`) and the host name | stable |\n" +
"| `tlspki`, `bignum` | RSA (PKCS #1 v1.5, PSS), ECDSA P-256 / P-384, SHA-384 / SHA-512, X.509 parsing and chain validation, PEM; integers of any size with Montgomery `bn_modexp` | stable |\n" +
"| `seq` | `seq_map`, `seq_filter`, `seq_fold`, `seq_loop(a, b, acc, f)` (a loop over a..b-1 without a list), `seq_while`, `seq_nth`, `seq_range`, `seq_concat` | stable |\n" +
"| `arena` | `heap_stats()`, `gc_collect()`, `gc_count()`, `arena_new / alloc / reset / destroy` | stable |\n" +
"| `netctl`, `dns` | TCP with timeouts, non-blocking sockets, epoll, DNS | stable |\n" +
"| `tun` | TUN interfaces: `tun_open`, `tun_read`, `tun_write`, `tun_wait`, `tun_set_ipv4`, `tun_set_mtu`, `tun_set_up`, `tun_close` | linux + windows, privileged; Windows loads Wintun only through `lchameleon` |\n" +
"| `lchameleon` | foreign boundaries: `chameleon_c_open(path)` (Windows: a signed DLL inside System32 / Program Files), `chameleon_c_sym`, `chameleon_c_call` (answer `unverified[int]`), `chameleon_verify_boundary` | `chameleon_c_*`: windows; guards: stable |\n" +
"| `winsys` | displays, capture, input, windows, registry, services, sessions, named pipes | windows |\n" +
"| `lcrypto_tls` | AES-GCM, ECDSA P-256, X25519, Ed25519, SHA-256 | stable |\n" +
"\n" +
"```lume\n" +
"use seq\n" +
"print seq_loop(0, 5, 0, fn(i, acc) => acc + i)\n" +
"print seq_map([1, 2, 3], fn(x) => x * 10)\n" +
"print seq_fold([1, 2, 3], 0, fn(acc, x) => acc + x)\n" +
"```\n" +
"```output\n" +
"10\n" +
"Cons(10, Cons(20, Cons(30, Nil)))\n" +
"6\n" +
"```\n" +
"\n" +
"## 8. Contracts\n" +
"\n" +
"`requires` / `ensures` after the parameters; `lume prove` proves them where it can, the rest is checked at run\n" +
"time (a violation stops the program, exit 3). `result` is the returned value, `old(x)` the value at entry.\n" +
"\n" +
"```lume\n" +
"fn half(x) requires x >= 0 ensures result >= 0 = x / 2\n" +
"print half(10)\n" +
"```\n" +
"```output\n" +
"5\n" +
"```\n" +
"\n" +
"Builtin contracts: the prover knows what some builtins answer, when the call's result is named with `let` or is\n" +
"the function's result: `buf_bits_write(b, p, v, n)` is `p + n` or `-1`; `buf_get(b, i)` is 0..255 (an index\n" +
"outside the buffer stops the program); `buf_len(b)` and `count(s)` are >= 0; `buf_sad*` / `buf_satd*` are >= -1;\n" +
"`buf_h264_quant4x4` is -1..16. A clause the prover proves must not trap itself: `p + n` can overflow, so bound\n" +
"p and n in `requires`.\n" +
"\n" +
"```lume\n" +
"fn put3(b: buf, p: int, v: int) -> int\n" +
"    requires p >= 0 and p <= 1000000000\n" +
"    ensures result == p + 3 or result == 0 - 1\n" +
"    = buf_bits_write(b, p, v, 3)\n" +
"print put3(buf_new(4), 0, 5)\n" +
"```\n" +
"```output\n" +
"3\n" +
"```\n" +
"\n" +
"## 9. Conventions and reserved names\n" +
"\n" +
"Keywords: `if then else elif let in var mut match not and or own with spawn do defer errdefer comptime quote\n" +
"splice scope shard fn pub priv use as type const law print requires ensures true false`. A capitalized name is a\n" +
"constructor. Runtime builtins and the prefixes `__rt_` / `__lume_` cannot name a function ([R0201]). `ct_` at the\n" +
"start of a function name makes its parameters secrets ([C0009] on a branch over them); parameters named `secret`\n" +
"/ `secret_*` are secrets anywhere. `test_*` functions are what `lume test` runs. A comment\n" +
"`## Deprecated: <message>` directly above a function marks it: a call from another module warns [W0005] with the\n" +
"message, and it keeps working for at least one whole MINOR release (versions, deprecation and the long-term-support\n" +
"line: `docs/STABILITY.md`). `grad`, `value_and_grad`, `jvp`,\n" +
"`vjp` are autodiff operators. A name defined in two modules gives warning [W0003].\n" +
"\n" +
"## 10. Known limits\n" +
"\n" +
"- The runtime is single-threaded.\n" +
"- At most 6 parameters in `--raw` runtime code; ordinary functions take any number.\n" +
"- Constant list and record literals (nested ones too) are shared static data: they are never mutated (Lume values are immutable).\n" +
"- Record flattening inlines small functions; `LUME_FL=off` turns it off (for measuring allocation or reading the\n" +
"  call shape in the assembly).\n" +
"- macOS targets cover the verified core only (write / exit); `winsys` exists only on Windows.\n" +
"\n" +
"## 11. Changed in this version\n" +
"\n" +
"Added: `use std/hash`, `csv`, `utf8`, `datetime`, `regex`, `deflate`, `http`, `tls` (HTTPS with TLS 1.3), `tlspki`, `bignum`, package versions (`lume pkg publish / add / install`, `[packages]` in lume.lock), `lume verify` (many files, N processes, per-file cache), the call stack (`at NAME (file:LINE)`) after a run-time error, builtin contracts in the prover (`buf_bits_write`, `buf_get`, `buf_len`, `count`, `buf_sad*`, `buf_satd*`, `buf_h264_quant4x4`), official examples (`examples/topics`, `examples/diagnostics`, examples gate), `use std/NAME`, `buf_bits_write / read / ue / se`, `## Deprecated:` and warning [W0005], docs/STABILITY.md (semver, deprecation, LTS 1.2), `use math` (math names, f32, f32 buffers), f64 parameters, W0004, `lume run --profile`, `use h264` (motion compensation, deblocking), `buf_sad*`, `buf_satd*` (SSE2), `buf_h264_*`, `use tun`, `lchameleon` `chameleon_c_open / sym / call` and\n" +
"`chameleon_verify_boundary`, `priv fn`, warning [W0003], `LUME_FL`, constant literals in .rodata, per-site field\n" +
"cache, collection pacing `max(8 MiB, 3 x live)`.\n" +
"Changed: W0004 also sees parameters typed `f64` and results of `f64(...)`; `buf_sad4x4` runs in SSE2; C0009 in a `ct_` function names the prefix as the reason; `lume fmt` refuses to run on the Stage-0\n" +
"fallback; on Git Bash `lume` runs the native `lume.exe`; `fs_copy` keeps the source's permission bits.\n" +
"Removed: nothing.\n"
fn man_pt_ref() = "# Referencia da Lume (factual) — v1.2.0\n" +
"\n" +
"Esta e a referencia do que funciona hoje. Ela nao tem roteiro nem material de visao: isso esta em\n" +
"`lume manual --pt visao` e nos outros capitulos, que misturam os dois. Cada exemplo abaixo e executado por\n" +
"`tests/docs/ref_examples_gate.src` (na bateria de testes) com a toolchain instalada; o bloco embaixo de cada exemplo\n" +
"e a saida exata dele.\n" +
"\n" +
"Estados: **estavel** = Linux x86-64 e Windows x64, mesmo comportamento; **linux** / **windows** = so naquela\n" +
"plataforma; **experimental** = funciona, a API ainda pode mudar; **privilegiado** = precisa de root (Linux) ou de\n" +
"processo elevado (Windows).\n" +
"\n" +
"## 1. Programas e comandos\n" +
"\n" +
"Um programa e um arquivo `.src`. As linhas `print` de topo rodam em ordem. `lume run f.src [args]` compila e roda,\n" +
"`lume build f.src -o saida` grava um executavel nativo (`saida.exe` no Windows), `lume test f.src` roda cada\n" +
"`fn test_*()` que devolve um valor verdade, `lume check f.src` checa os tipos sem rodar, `lume fmt f.src` formata\n" +
"no lugar (`--check`, `--stdout`), `lume manual [capitulo]` mostra o manual (`--pt` em portugues). `lume run --profile f.src` mostra por funcao o\n" +
"tempo proprio e total, chamadas e alocacoes, e o tempo do GC, no stderr ao terminar (funcoes expandidas no chamador\n" +
"contam nele; `LUME_FL=off` as mantem; um laco de cauda e uma chamada).\n" +
"\n" +
"`lume verify [--jobs=N] a.src b.src ...` roda check, test, prove, fmt --check e certify em muitos arquivos com N processos\n" +
"(padrao 2); o resultado de cada arquivo fica em cache pelo SHA-256 do pacote inteiro e das ferramentas, entao depois de\n" +
"uma mudanca so o modulo alterado e os arquivos que o importam rodam de novo.\n" +
"\n" +
"Pacotes: `lume pkg publish [dir] --store=DIR` roda os testes do pacote e guarda NOME/VERSAO imutavel com o SHA-256;\n" +
"`lume pkg add NOME@REQ` grava `nome = \"REQ\"` em `[dependencies]` (REQ: `1.2.3`, `^1.2`, `~1.2.3`, `*`);\n" +
"`lume pkg install --store=DIR` instala as maiores versoes compativeis em `lume_modules/`, roda os testes delas e grava\n" +
"versoes e hashes no `lume.lock`; `use NOME` encontra um pacote instalado.\n" +
"\n" +
"Exemplos oficiais: `examples/topics/*.src` (um arquivo por assunto, cada um rodado por `lume test`) e\n" +
"`examples/diagnostics/` (para um codigo de diagnostico, `CODIGO_nome.bad` o mostra e `CODIGO_nome.fixed.src` e o\n" +
"programa corrigido); `tests/docs/examples_gate.src` roda todos a cada versao.\n" +
"\n" +
"```lume\n" +
"fn square(x) = x * x\n" +
"print square(7)\n" +
"```\n" +
"```output\n" +
"49\n" +
"```\n" +
"\n" +
"## 2. Sintaxe\n" +
"\n" +
"- `fn nome(a, b) = expr`, `pub fn` (exportada), `priv fn` (privada do modulo), `const NOME: T = expr`,\n" +
"  `type T = A(x) | B(x, y)`, `use modulo`, `use modulo as apelido`, `use std/NOME` (sempre o NOME da biblioteca padrao, mesmo que o projeto tenha um NOME.src), `## comentario` (ate o fim da linha).\n" +
"- Expressoes: `let x = e in corpo`, `if c then a else b`, `match v` com um `Padrao => expr` por linha,\n" +
"  `fn(x) => expr` (closure; captura variaveis), `{{a: 1, b: 2}}` (registro), `r.a` (campo), `{{ r with a: 3 }}`\n" +
"  (copia com um campo trocado), `[1, 2, 3]` (lista), `Cons(h, t)` / `Nil`.\n" +
"- Inteiros tem 64 bits; um overflow para o programa (exit 3). `/` trunca em direcao a zero, `%` tem o sinal do\n" +
"  operando da esquerda. `*` `/` `%` ligam mais forte que `+` `-`. Comparacoes e `and` / `or` / `not` dao\n" +
"  booleanos, impressos como `1` / `0`.\n" +
"- Strings sao bytes (UTF-8): `count` conta bytes, `+` junta duas strings e nada converte sozinho (`str(x)` faz uma\n" +
"  string, `toint(s)` le um numero).\n" +
"\n" +
"```lume\n" +
"type Shape = Circle(r) | Rect(w, h)\n" +
"fn area(s) = match s\n" +
"    Circle(r)  => 3 * r * r\n" +
"    Rect(w, h) => w * h\n" +
"print area(Circle(2))\n" +
"print area(Rect(3, 4))\n" +
"let p = {{x: 1, y: 2}}\n" +
"print p.x + p.y\n" +
"let q = {{ p with y: 10 }}\n" +
"print q.y\n" +
"print 7 / 2\n" +
"print 0 - 7 / 2\n" +
"print 7 % 3\n" +
"```\n" +
"```output\n" +
"12\n" +
"12\n" +
"3\n" +
"10\n" +
"3\n" +
"-3\n" +
"1\n" +
"```\n" +
"\n" +
"## 3. Erros em tempo de execucao\n" +
"\n" +
"O programa para com exit 3 e uma linha no stderr em: overflow de inteiro, divisao por zero, indice fora de uma\n" +
"lista ou buffer, campo que o registro nao tem, valor do tipo errado para a operacao, `match` sem braco. O\n" +
"`lume test` mostra essa parada como teste que falhou e segue com os outros. Depois da mensagem vem as chamadas\n" +
"que levaram ate ali, da mais interna para fora, uma linha `  at NOME (arquivo.src:LINHA)` cada (uma funcao expandida\n" +
"no chamador e uma chamada de cauda nao deixam linha; `LUME_FL=off` mantem as funcoes pequenas como chamadas).\n" +
"\n" +
"```lume\n" +
"print 9223372036854775807 + 1\n" +
"```\n" +
"```output\n" +
"exit 3\n" +
"stderr: lume: integer overflow\n" +
"```\n" +
"\n" +
"## 4. Builtins basicos (estavel)\n" +
"\n" +
"| Builtin | Resposta | Com argumento errado |\n" +
"| --- | --- | --- |\n" +
"| `count(s)` | bytes de uma string, ou elementos de uma lista | para num valor sem tamanho |\n" +
"| `at(s, i)` | o byte em i como string de um byte | `\"\"` quando i esta fora |\n" +
"| `slice(s, a, b)` | bytes a..b-1, limitados a string | — |\n" +
"| `ord_at(s, i)` | o byte em i como int (0..255) | para quando i esta fora |\n" +
"| `chr(n)` | a string de um byte n (0..255) | para fora de 0..255 |\n" +
"| `str(v)` | o texto de um valor | — |\n" +
"| `toint(s)` | o inteiro escrito em s | `0` quando s nao e inteiro (confira o texto antes) |\n" +
"| `print v` / `emit(s)` / `flush()` | escrevem no stdout | — |\n" +
"\n" +
"```lume\n" +
"print count(\"héllo\")\n" +
"print slice(\"abcdef\", 1, 4)\n" +
"print ord_at(\"A\", 0)\n" +
"print chr(66)\n" +
"print str(42) + \"!\"\n" +
"print toint(\"123\") + 1\n" +
"print bit_and(12, 10)\n" +
"print bit_shl(1, 4)\n" +
"print at(\"ab\", 5) == \"\"\n" +
"print toint(\"abc\")\n" +
"print slice(\"abc\", 2, 9)\n" +
"print count([1, 2, 3])\n" +
"```\n" +
"```output\n" +
"6\n" +
"bcd\n" +
"65\n" +
"B\n" +
"42!\n" +
"124\n" +
"8\n" +
"16\n" +
"1\n" +
"0\n" +
"c\n" +
"3\n" +
"```\n" +
"\n" +
"## 5. Buffers de bytes (estavel)\n" +
"\n" +
"`buf_new(n)` (n bytes zerados), `buf_len(b)`, `buf_get(b, i)` (0..255), `buf_set(b, i, v)` (devolve b),\n" +
"`buf_copy(dst, d_off, src, s_off, n)`, `buf_slice(b, off, n)`, `buf_from_str(s)`, `buf_to_str(b, off, n)`,\n" +
"`buf_addr(b)` (endereco do byte 0, para chamadas de sistema). Indice fora do buffer ou valor fora de 0..255 para o\n" +
"programa.\n" +
"\n" +
"```lume\n" +
"let b = buf_new(4)\n" +
"let s = buf_set(b, 0, 255)\n" +
"print buf_len(b)\n" +
"print buf_get(b, 0)\n" +
"print buf_get(b, 1)\n" +
"```\n" +
"```output\n" +
"4\n" +
"255\n" +
"0\n" +
"```\n" +
"\n" +
"Video e codec (estavel; os argumentos sao buffers, deslocamentos em bytes e strides; cada um devolve -1 com\n" +
"argumento errado): `buf_bgra_to_i420`, `buf_i420_to_bgra`, `buf_sad16x16 / 8x8 / 4x4 (a, ai, sa, b, bi, sb)` e\n" +
"`buf_satd4x4 / 16x16 (iguais)` (SSE2), `buf_h264_fdct4x4 / idct4x4 (src, si, dst, di)` (blocos int16),\n" +
"`buf_h264_quant4x4 (src, si, qp, intra, dst, di)` (devolve os niveis nao nulos), `buf_h264_dequant4x4 (src, si, qp,\n" +
"dst, di)`, `buf_h264_sub4x4 (a, ai, sa, pred, pi, dst)`, `buf_h264_recon4x4 (pred, pi, res, ri, dst, di)`,\n" +
"`buf_h264_intra4x4 / intra16x16 (frame, fi, fs, modo, disponivel, dst)` (bits de disponivel: 1 esquerda, 2 topo,\n" +
"4 topo-direita, 8 topo-esquerda).\n" +
"\n" +
"Escrita de bits (estavel; bit mais significativo primeiro): `buf_bits_write(b, pos, v, n)` grava os n bits baixos de\n" +
"v (1..32) no bit pos e devolve pos + n, `buf_bits_read(b, pos, n)` os le, `buf_bits_ue(b, pos, v)` / `buf_bits_se(b,\n" +
"pos, v)` gravam codigos Exp-Golomb e devolvem a nova pos; cada um devolve -1 com argumento errado.\n" +
"\n" +
"## 5a. Ponto flutuante (estavel)\n" +
"\n" +
"`f64` e um double IEEE 754: `f64(x)` cria um a partir de inteiro, decimal, outro f64 ou texto (`f64(\"1e-9\")`,\n" +
"`f64(\"inf\")`, `f64(\"nan\")`); `+ - * /` e `< > <= >=` funcionam sobre ele (um operando inteiro ou decimal e\n" +
"convertido), `==` compara por valor. `print` / `str` dao o texto mais curto que volta ao mesmo double. Funcoes:\n" +
"`f64_sqrt`, `f64_abs`, `f64_floor`, `f64_ceil`, `f64_round` (meio para longe de zero), `f64_int` (em direcao a zero,\n" +
"para int), `f64_sin`, `f64_cos`, `f64_tan`, `f64_atan2(y, x)`, `f64_exp`, `f64_log`, `f64_log10`, `f64_pow(x, y)`,\n" +
"`f64_is_nan`, `f64_str(x, casas)`, `f64_bits` / `f64_from_bits`. Um literal com ponto (`1.5`) e um decimal exato, nao\n" +
"f64: escreva `f64(1.5)` ou `f64(\"1.5\")`. Comparar com NaN para o programa (teste com `f64_is_nan`). Um parametro declarado `x: f64` converte o que recebe com `f64(x)` na entrada, entao um literal\n" +
"decimal funciona ali: `fn hyp(a: f64, b: f64) -> f64 = sqrt(a * a + b * b)` e `hyp(3.0, 4.0)`. `use math` da `sqrt exp\n" +
"log log10 pow sin cos tan atan2 floor ceil round abs_f fmin fmax tofloat is_nan is_inf`, `f32(x)` (precisao simples\n" +
"mais proxima, empate para o par) e `buf_f32_get(b, off)` / `buf_f32_set(b, off, x)` (4 bytes, little endian). O\n" +
"`lume check` avisa [W0004] onde um int encontra um f64 (convertido em execucao); o `lume prove` marca um contrato\n" +
"com f64 como `runtime_checked` com o motivo (o provador de inteiros nao decide ponto flutuante).\n" +
"\n" +
"```lume\n" +
"fn hypot(a, b) = f64_sqrt(a * a + b * b)\n" +
"print hypot(f64(3), f64(4))\n" +
"print hypot(f64(3), f64(4)) == f64(5)\n" +
"print f64(1) / f64(3)\n" +
"print f64_str(f64(\"2.5\"), 2)\n" +
"print f64_is_nan(f64(\"nan\"))\n" +
"print f64_int(f64_floor(f64(\"-2.5\")))\n" +
"print f64_pow(f64(2), f64(10))\n" +
"```\n" +
"```output\n" +
"5.0\n" +
"1\n" +
"0.3333333333333333\n" +
"2.50\n" +
"1\n" +
"-3\n" +
"1024.0\n" +
"```\n" +
"\n" +
"## 6. Arquivos e sistema operacional (estavel)\n" +
"\n" +
"| Builtin | Resposta |\n" +
"| --- | --- |\n" +
"| `fs_read_file(p)` | o conteudo, `\"\"` quando nao da para ler |\n" +
"| `fs_write_sync(p, s)` / `fs_append_sync(p, s)` | 1, ou 0 na falha |\n" +
"| `fs_path_exists(p)` / `fs_remove(p)` / `fs_mkdir(p)` / `fs_copy(a, b)` | 1, ou 0 |\n" +
"| `os_getenv(nome)` | o valor, `\"\"` quando nao existe |\n" +
"| `os_platform()` | `\"linux\"` ou `\"windows\"` |\n" +
"| `os_arg_count()` / `os_arg_at(i)` | os argumentos do programa |\n" +
"| `os_monotonic_ns()` | relogio monotonico em nanossegundos |\n" +
"| `os_exit(codigo)` | encerra o programa |\n" +
"\n" +
"```lume\n" +
"print fs_write_sync(\"ref_probe.txt\", \"hi\")\n" +
"print fs_read_file(\"ref_probe.txt\")\n" +
"print fs_remove(\"ref_probe.txt\")\n" +
"print fs_path_exists(\"ref_probe.txt\")\n" +
"print fs_read_file(\"no_such_file.txt\") == \"\"\n" +
"print os_getenv(\"LUME_SURELY_UNSET_VAR\") == \"\"\n" +
"```\n" +
"```output\n" +
"1\n" +
"hi\n" +
"1\n" +
"0\n" +
"1\n" +
"1\n" +
"```\n" +
"\n" +
"Rede (estavel): `net_udp_bind_addr(ip, porta)` (socket, -1 na falha), `net_udp_send_to(fd, ip, porta, dados)`\n" +
"(bytes enviados), `net_udp_recv_from(fd, max)` (o datagrama, `\"\"` sem nada), `net_last_peer_ip()`,\n" +
"`net_last_peer_port()`, `net_tcp_connect_addr(ip, porta)` (socket, -1 quando recusado), `net_close(fd)`;\n" +
"`use netctl` acrescenta timeouts e E/S nao bloqueante com epoll.\n" +
"\n" +
"## 7. Modulos da biblioteca padrao\n" +
"\n" +
"| Modulo | O que oferece | Estado |\n" +
"| --- | --- | --- |\n" +
"| `h264` | `buf_h264_luma_mc(ref, ri, rs, rw, rh, x, y, mx, my, w, h, dst, di, ds)` (luma em 1/4 de amostra, 6 taps, 8.4.2.2.1), `buf_h264_chroma_mc(...)` (mesmos argumentos, croma bilinear em 1/8, 8.4.2.2.2), `buf_h264_deblock_edge(buf, q0, across, along, lines, bs, alpha, beta, tc0, chroma)` (8.7.2.3 / 8.7.2.4; bs e tc0 sao listas, um valor por 4 linhas de luma / 2 de croma); 0, ou -1 com argumento errado; coordenadas presas a figura | estavel |\n" +
"| `hash` | `crc32`, `adler32`, `md5`, `sha1`, `sha256` (strings; `*_buf` para buffers), `hex32` | estavel |\n" +
"| `csv` | `csv_parse(texto)` (RFC 4180: aspas, separadores e quebras de linha dentro de campos), `csv_format(linhas)`, `csv_parse_sep` / `csv_format_sep`, `csv_field` | estavel |\n" +
"| `utf8` | `utf8_len`, `utf8_decode` / `utf8_encode`, `utf8_char`, `utf8_cp`, `utf8_slice`, `utf8_upper` / `utf8_lower` (ASCII + Latin-1), `utf8_reverse`, `utf8_valid` (strings sao bytes; estas contam caracteres) | estavel |\n" +
"| `datetime` | `dt_from_unix`, `dt_to_unix`, `dt_iso`, `dt_parse_iso`, `dt_weekday`, `dt_add_days` / `dt_add_months`, `dt_offset(fuso, t)` / `dt_local` / `dt_iso_local` (deslocamentos fixos, horario de verao EUA / UE / Sydney) | estavel |\n" +
"| `regex` | `re_match`, `re_search`, `re_find`, `re_find_all`, `re_groups`, `re_replace` (`$1`), `re_split`: classes, `\\d \\w \\s`, ancoras, grupos, alternancia, quantificadores gulosos e preguicosos | estavel |\n" +
"| `deflate` | `inflate_buf` / `deflate_buf`, `zlib_decompress` / `zlib_compress`, `gunzip` / `gzip`, `gunzip_str` / `gzip_str` (Adler-32 / CRC-32 conferidos) | estavel |\n" +
"| `http` | `http_get`, `http_post`, `http_request(metodo, url, cabecalhos, corpo, ms)`, `http_header`: chunked, gzip, redirecionamentos, prazos; `https://` pelo `tls` | estavel |\n" +
"| `tls` | `tls_request(host, porta, dados, ms)`: cliente TLS 1.3 (X25519, AES-128-GCM / ChaCha20-Poly1305); o certificado do servidor e conferido contra as raizes do sistema (`SSL_CERT_FILE`, o pacote do Linux, os repositorios do Windows pelo `lchameleon`) e o nome do host | estavel |\n" +
"| `tlspki`, `bignum` | RSA (PKCS #1 v1.5, PSS), ECDSA P-256 / P-384, SHA-384 / SHA-512, parse X.509 e validacao de cadeia, PEM; inteiros de qualquer tamanho com `bn_modexp` de Montgomery | estavel |\n" +
"| `seq` | `seq_map`, `seq_filter`, `seq_fold`, `seq_loop(a, b, acc, f)` (laco sobre a..b-1 sem lista), `seq_while`, `seq_nth`, `seq_range`, `seq_concat` | estavel |\n" +
"| `arena` | `heap_stats()`, `gc_collect()`, `gc_count()`, `arena_new / alloc / reset / destroy` | estavel |\n" +
"| `netctl`, `dns` | TCP com timeout, sockets nao bloqueantes, epoll, DNS | estavel |\n" +
"| `tun` | interfaces TUN: `tun_open`, `tun_read`, `tun_write`, `tun_wait`, `tun_set_ipv4`, `tun_set_mtu`, `tun_set_up`, `tun_close` | linux + windows, privilegiado; no Windows o Wintun so entra pelo `lchameleon` |\n" +
"| `lchameleon` | fronteiras externas: `chameleon_c_open(caminho)` (Windows: DLL assinada dentro de System32 / Program Files), `chameleon_c_sym`, `chameleon_c_call` (devolvem `unverified[int]`), `chameleon_verify_boundary` | `chameleon_c_*`: windows; guardas: estavel |\n" +
"| `winsys` | monitores, captura, entrada, janelas, registro, servicos, sessoes, named pipes | windows |\n" +
"| `lcrypto_tls` | AES-GCM, ECDSA P-256, X25519, Ed25519, SHA-256 | estavel |\n" +
"\n" +
"```lume\n" +
"use seq\n" +
"print seq_loop(0, 5, 0, fn(i, acc) => acc + i)\n" +
"print seq_map([1, 2, 3], fn(x) => x * 10)\n" +
"print seq_fold([1, 2, 3], 0, fn(acc, x) => acc + x)\n" +
"```\n" +
"```output\n" +
"10\n" +
"Cons(10, Cons(20, Cons(30, Nil)))\n" +
"6\n" +
"```\n" +
"\n" +
"## 8. Contratos\n" +
"\n" +
"`requires` / `ensures` depois dos parametros; `lume prove` prova o que consegue, o resto e conferido em tempo de\n" +
"execucao (a violacao para o programa, exit 3). `result` e o valor devolvido, `old(x)` o valor na entrada.\n" +
"\n" +
"```lume\n" +
"fn half(x) requires x >= 0 ensures result >= 0 = x / 2\n" +
"print half(10)\n" +
"```\n" +
"```output\n" +
"5\n" +
"```\n" +
"\n" +
"Contratos dos builtins: o provador sabe o que alguns builtins devolvem, quando o resultado da chamada tem nome num\n" +
"`let` ou e o resultado da funcao: `buf_bits_write(b, p, v, n)` e `p + n` ou `-1`; `buf_get(b, i)` e 0..255 (um\n" +
"indice fora do buffer para o programa); `buf_len(b)` e `count(s)` sao >= 0; `buf_sad*` / `buf_satd*` sao >= -1;\n" +
"`buf_h264_quant4x4` e -1..16. Uma clausula que o provador prova nao pode ela mesma parar o programa: `p + n` pode\n" +
"estourar, entao limite p e n no `requires`.\n" +
"\n" +
"```lume\n" +
"fn put3(b: buf, p: int, v: int) -> int\n" +
"    requires p >= 0 and p <= 1000000000\n" +
"    ensures result == p + 3 or result == 0 - 1\n" +
"    = buf_bits_write(b, p, v, 3)\n" +
"print put3(buf_new(4), 0, 5)\n" +
"```\n" +
"```output\n" +
"3\n" +
"```\n" +
"\n" +
"## 9. Convencoes e nomes reservados\n" +
"\n" +
"Palavras-chave: `if then else elif let in var mut match not and or own with spawn do defer errdefer comptime\n" +
"quote splice scope shard fn pub priv use as type const law print requires ensures true false`. Nome com inicial\n" +
"maiuscula e construtor. Builtins do runtime e os prefixos `__rt_` / `__lume_` nao podem nomear funcao ([R0201]).\n" +
"`ct_` no inicio do nome de uma funcao torna os parametros segredos ([C0009] num desvio sobre eles); parametros\n" +
"`secret` / `secret_*` sao segredos em qualquer funcao. Funcoes `test_*` sao as que o `lume test` roda. Um\n" +
"comentario `## Deprecated: <mensagem>` logo acima de uma funcao a marca: uma chamada de outro modulo avisa [W0005]\n" +
"com a mensagem, e ela continua funcionando por pelo menos uma versao MINOR inteira (versoes, obsolescencia e a linha\n" +
"de suporte longo: `docs/STABILITY.md`). `grad`,\n" +
"`value_and_grad`, `jvp`, `vjp` sao operadores de autodiff. Um nome definido em dois modulos da o aviso [W0003].\n" +
"\n" +
"## 10. Limites conhecidos\n" +
"\n" +
"- O runtime tem uma thread so.\n" +
"- No maximo 6 parametros no codigo `--raw` do runtime; funcoes comuns aceitam qualquer numero.\n" +
"- Listas e registros literais constantes (tambem os aninhados) sao dados estaticos compartilhados: nunca sao alterados (valores Lume sao\n" +
"  imutaveis).\n" +
"- O achatamento de registros inlineia funcoes pequenas; `LUME_FL=off` desliga (para medir alocacao ou ler o\n" +
"  formato das chamadas no assembly).\n" +
"- Os alvos macOS cobrem so o nucleo verificado (write / exit); `winsys` existe so no Windows.\n" +
"\n" +
"## 11. Mudou nesta versao\n" +
"\n" +
"Entrou: `use std/hash`, `csv`, `utf8`, `datetime`, `regex`, `deflate`, `http`, `tls` (HTTPS com TLS 1.3), `tlspki`, `bignum`, versoes de pacotes (`lume pkg publish / add / install`, `[packages]` no lume.lock), `lume verify` (muitos arquivos, N processos, cache por arquivo), a pilha de chamadas (`at NOME (arquivo:LINHA)`) depois de um erro em tempo de execucao, contratos dos builtins no provador (`buf_bits_write`, `buf_get`, `buf_len`, `count`, `buf_sad*`, `buf_satd*`, `buf_h264_quant4x4`), exemplos oficiais (`examples/topics`, `examples/diagnostics`, gate dos exemplos), `use std/NOME`, `buf_bits_write / read / ue / se`, `## Deprecated:` e o aviso [W0005], docs/STABILITY.md (semver, obsolescencia, LTS 1.2), `use math` (funcoes matematicas, f32, buffers f32), parametros f64, W0004, `lume run --profile`, `use h264` (compensacao de movimento, desbloqueio), `buf_sad*`, `buf_satd*` (SSE2), `buf_h264_*`, `use tun`, `lchameleon` `chameleon_c_open / sym / call` e\n" +
"`chameleon_verify_boundary`, `priv fn`, aviso [W0003], `LUME_FL`, literais constantes em .rodata, cache de campo por\n" +
"ponto de leitura, ritmo de coleta `max(8 MiB, 3 x vivo)`.\n" +
"Mudou: o W0004 tambem ve parametros `f64` e resultados de `f64(...)`; `buf_sad4x4` roda em SSE2; o C0009 numa funcao `ct_` diz que o motivo e o prefixo; `lume fmt` se recusa a rodar no Stage-0; no Git\n" +
"Bash o `lume` roda o `lume.exe` nativo; `fs_copy` mantem as permissoes da origem.\n" +
"Saiu: nada.\n"
fn man_en_vision() = "# VISION AND RESEARCH MATERIAL (not a reference)\n" +
"\n" +
"The other chapters (1-10) describe Lume's full design: next to what works today they contain research directions,\n" +
"roadmap items, capstone counts and named engines (\"Sovereign Sentience\", \"Singularity\", the mascot, proof\n" +
"totals). Read them as design intent. For programming, and especially for an AI writing Lume, use\n" +
"`lume manual ref`: it lists only what works, with a status per builtin and module, and every example in it is\n" +
"run by the test suite with the exact output shown.\n"
fn man_pt_vision() = "# MATERIAL DE VISAO E PESQUISA (nao e referencia)\n" +
"\n" +
"Os outros capitulos (1-10) descrevem o projeto completo da Lume: ao lado do que funciona hoje eles trazem\n" +
"direcoes de pesquisa, itens de roteiro, contagens de capstones e motores com nome (\"Sovereign Sentience\",\n" +
"\"Singularity\", o mascote, totais de provas). Leia-os como intencao de projeto. Para programar, e principalmente\n" +
"para uma IA que escreve Lume, use `lume manual --pt referencia`: ela lista so o que funciona, com o estado de cada\n" +
"builtin e modulo, e cada exemplo dela e executado pela bateria de testes com a saida exata mostrada.\n"
fn man_en_all() = man_en_index() + "\n" + man_en_overview() + "\n" + man_en_syntax() + "\n" + man_en_types() + "\n" + man_en_contracts() + "\n" + man_en_effects() + "\n" + man_en_stdlib() + "\n" + man_en_targets() + "\n" + man_en_commands() + "\n" + man_en_examples() + "\n" + man_en_errors()

fn man_pt_all() = man_pt_index() + "\n" + man_pt_overview() + "\n" + man_pt_syntax() + "\n" + man_pt_types() + "\n" + man_pt_contracts() + "\n" + man_pt_effects() + "\n" + man_pt_stdlib() + "\n" + man_pt_targets() + "\n" + man_pt_commands() + "\n" + man_pt_examples() + "\n" + man_pt_errors()

fn man_render_en(topic) = let t = man_norm_topic(topic) in if t == "index" then man_en_index() else if t == "overview" then man_en_overview() else if t == "syntax" then man_en_syntax() else if t == "types" then man_en_types() else if t == "contracts" then man_en_contracts() else if t == "effects" then man_en_effects() else if t == "stdlib" then man_en_stdlib() else if t == "targets" then man_en_targets() else if t == "commands" then man_en_commands() else if t == "examples" then man_en_examples() else if t == "errors" then man_en_errors() else if t == "ref" then man_en_ref() else if t == "vision" then man_en_vision() else if t == "all" then man_en_all() else "Unknown manual topic '" + topic + "'. Run `lume manual` for the table of contents.\n"

fn man_render_pt(topic) = let t = man_norm_topic(topic) in if t == "index" then man_pt_index() else if t == "overview" then man_pt_overview() else if t == "syntax" then man_pt_syntax() else if t == "types" then man_pt_types() else if t == "contracts" then man_pt_contracts() else if t == "effects" then man_pt_effects() else if t == "stdlib" then man_pt_stdlib() else if t == "targets" then man_pt_targets() else if t == "commands" then man_pt_commands() else if t == "examples" then man_pt_examples() else if t == "errors" then man_pt_errors() else if t == "ref" then man_pt_ref() else if t == "vision" then man_pt_vision() else if t == "all" then man_pt_all() else "Topico desconhecido '" + topic + "'. Execute `lume manual --pt` para ver o indice completo.\n"

fn man_is_pt_word(raw) = if raw == "referencia" or raw == "visao" or raw == "portugues" or raw == "indice" or raw == "visao-geral" or raw == "inicio" or raw == "sintaxe" or raw == "gramatica" or raw == "regras" or raw == "tipos" or raw == "contratos" or raw == "provas" or raw == "efeitos" or raw == "memoria" or raw == "biblioteca" or raw == "modulos" or raw == "camaleao" or raw == "mascote" or raw == "alvos" or raw == "comandos" or raw == "ondas" or raw == "exemplos" or raw == "receitas" or raw == "erros" or raw == "diagnosticos" or raw == "tudo" or raw == "completo" then 1 else 0

fn man_is_pt_lang(lang) = if lang == "pt" or lang == "--pt" or lang == "pt-BR" or lang == "pt-br" or lang == "--pt-br" or lang == "--pt-BR" or lang == "pt_BR" or lang == "pt_br" or lang == "--pt_br" or lang == "--pt_BR" then 1 else 0

fn man_use_pt(lang, topic) = if man_is_pt_lang(lang) == 1 then 1 else if lang == "--en" then 0 else man_is_pt_word(topic)

fn man_render(lang, topic) = if man_use_pt(lang, topic) == 1 then man_render_pt(topic) else man_render_en(topic)

fn man_json_summary(lang, topic) = let norm = man_norm_topic(topic) in let is_pt = man_use_pt(lang, topic) in let lang_tag = if is_pt == 1 then "pt-BR" else "en" in if norm == "unknown" then "{\"ok\":false,\"error\":\"unknown_manual_topic\",\"mode\":\"lume-internal-manual\",\"edition\":\"2026\",\"version\":\"1.2.0\",\"language\":\"" + lang_tag + "\",\"topic\":\"unknown\",\"chapters\":[\"overview\",\"syntax\",\"types\",\"contracts\",\"effects\",\"stdlib\",\"targets\",\"commands\",\"examples\",\"errors\"],\"chapter_count\":10,\"bilingual_pt_en\":true,\"char_length\":0}" else let text = if is_pt == 1 then man_render_pt(norm) else man_render_en(norm) in "{\"ok\":true,\"mode\":\"lume-internal-manual\",\"edition\":\"2026\",\"version\":\"1.2.0\",\"language\":\"" + lang_tag + "\",\"topic\":\"" + norm + "\",\"chapters\":[\"overview\",\"syntax\",\"types\",\"contracts\",\"effects\",\"stdlib\",\"targets\",\"commands\",\"examples\",\"errors\"],\"chapter_count\":10,\"bilingual_pt_en\":true,\"char_length\":" + str(count(text)) + "}"

fn man_export_file(lang, topic, out_path) = let eff_topic = if topic == "" or topic == "index" or topic == "indice" then "all" else topic in let norm = man_norm_topic(eff_topic) in let is_pt = man_use_pt(lang, topic) in let lang_tag = if is_pt == 1 then "pt-BR" else "en" in if norm == "unknown" then "{\"ok\":false,\"error\":\"unknown_manual_topic\",\"mode\":\"lume-manual-export\",\"language\":\"" + lang_tag + "\",\"topic\":\"unknown\",\"output\":\"" + out_path + "\",\"bytes\":0}" else let text = if is_pt == 1 then man_render_pt(norm) else man_render_en(norm) in let w = fs_write_sync(out_path, text) in if w != 1 then ctfail("lume manual --export: cannot write " + out_path + "\n") else "{\"ok\":true,\"mode\":\"lume-manual-export\",\"language\":\"" + lang_tag + "\",\"output\":\"" + out_path + "\",\"bytes\":" + str(count(text)) + "}"

## --- Appendix A: the synopsis of every command -------------------------------------------------------------------
## The caller (lume_driver.src) passes the synopsis it generates from its dispatcher table, so the appendix cannot
## name a command, subcommand or option the driver does not dispatch. It follows the `commands` chapter and the full
## manual (`all`), in both languages; the other chapters are rendered unchanged.
fn man_cli_topic(topic) = let t = man_norm_topic(if topic == "" or topic == "index" or topic == "indice" then "index" else topic) in if t == "commands" or t == "all" then 1 else 0

fn man_cli_appendix(is_pt, synopsis) = if is_pt == 1 then "\n# APENDICE A: SINOPSE DE TODOS OS COMANDOS\n\n" + "Gerada pelo driver nativo a partir da tabela que ele usa para despachar: um comando, subcomando ou opcao que\n" + "nao esta nesta lista e recusado (`unknown native driver command`, `unknown subcommand`, `unknown option`).\n" + "`[--x <value>]` recebe um valor (`--x v` ou `--x=v`). `lume <comando> --help` imprime a linha do comando e\n" + "`lume help --json` imprime a tabela completa em JSON.\n\n" + synopsis else "\n# APPENDIX A: SYNOPSIS OF EVERY COMMAND\n\n" + "Generated by the native driver from the table it dispatches on: a command, subcommand or option that is not\n" + "listed here is refused (`unknown native driver command`, `unknown subcommand`, `unknown option`).\n" + "`[--x <value>]` takes a value (`--x v` or `--x=v`). `lume <command> --help` prints the line of one command and\n" + "`lume help --json` prints the whole table as JSON.\n\n" + synopsis

fn man_render_cli(lang, topic, synopsis) = if man_cli_topic(topic) == 1 then man_render(lang, topic) + man_cli_appendix(man_use_pt(lang, topic), synopsis) else man_render(lang, topic)

fn man_json_summary_cli(lang, topic, synopsis) = let norm = man_norm_topic(topic) in if man_cli_topic(topic) == 0 then man_json_summary(lang, topic) else let is_pt = man_use_pt(lang, topic) in "{\"ok\":true,\"mode\":\"lume-internal-manual\",\"edition\":\"2026\",\"version\":\"1.2.0\",\"language\":\"" + (if is_pt == 1 then "pt-BR" else "en") + "\",\"topic\":\"" + norm + "\",\"chapters\":[\"overview\",\"syntax\",\"types\",\"contracts\",\"effects\",\"stdlib\",\"targets\",\"commands\",\"examples\",\"errors\"],\"chapter_count\":10,\"bilingual_pt_en\":true,\"char_length\":" + str(count(man_render_cli(lang, topic, synopsis))) + "}"

fn man_export_file_cli(lang, topic, out_path, synopsis) = let eff_topic = if topic == "" or topic == "index" or topic == "indice" then "all" else topic in let norm = man_norm_topic(eff_topic) in let is_pt = man_use_pt(lang, topic) in if norm == "unknown" then man_export_file(lang, topic, out_path) else let text = (if is_pt == 1 then man_render_pt(norm) else man_render_en(norm)) + (if man_cli_topic(eff_topic) == 1 then man_cli_appendix(is_pt, synopsis) else "") in let w = fs_write_sync(out_path, text) in if w != 1 then ctfail("lume manual --export: cannot write " + out_path + "\n") else "{\"ok\":true,\"mode\":\"lume-manual-export\",\"language\":\"" + (if is_pt == 1 then "pt-BR" else "en") + "\",\"output\":\"" + out_path + "\",\"bytes\":" + str(count(text)) + "}"

fn test_manual_cli_appendix() = let syn = "  lume build [--target <value>] <source.src>\n" in let c = man_render_cli("en", "commands", syn) in let a = man_render_cli("pt", "tudo", syn) in let o = man_render_cli("en", "syntax", syn) in let j = man_json_summary_cli("en", "commands", syn) in man_contains_at(c, "# APPENDIX A: SYNOPSIS OF EVERY COMMAND", 0) == 1 and man_contains_at(c, syn, 0) == 1 and man_contains_at(a, "# APENDICE A: SINOPSE DE TODOS OS COMANDOS", 0) == 1 and man_contains_at(a, syn, 0) == 1 and man_contains_at(o, "APPENDIX A", 0) == 0 and o == man_render("en", "syntax") and man_contains_at(j, "\"char_length\":" + str(count(c)), 0) == 1 and man_cli_topic("comandos") == 1 and man_cli_topic("errors") == 0

