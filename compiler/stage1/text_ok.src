use text

fn test_str_find_from_position() = str_find("abcabc", "bc", 0) == 1 and str_find("abcabc", "bc", 2) == 4 and str_find("abcabc", "bc", 5) == 0 - 1 and str_find("abc", "zz", 0) == 0 - 1 and str_find("abc", "", 1) == 1 and str_find("", "a", 0) == 0 - 1
fn test_str_find_last_contains_count() = str_find_last("a:b:c", ":") == 3 and str_find_last("abc", ":") == 0 - 1 and str_contains("quic key:", "key") == 1 and str_contains("quic", "key") == 0 and str_count_of("aaaa", "aa") == 2 and str_count_of("a-b-c", "-") == 2
fn test_str_after_before_between() = str_after("quic key:  00ff", "quic key:") == "  00ff" and str_after("abc", "zz") == "" and str_before("k=v", "=") == "k" and str_before("kv", "=") == "kv" and str_between("f(x, y) + g", "(", ")") == "x, y" and str_between("f(x", "(", ")") == ""
fn test_str_trim() = str_trim("  a b \t\r\n") == "a b" and str_trim("") == "" and str_trim("   ") == "" and str_trim("x") == "x"
fn test_str_lines_split_only_at_newline() = let ls = str_lines("one\ntwo\n\nfour") in match ls
    Cons(a, Cons(b, Cons(c, Cons(d, Nil)))) => a == "one" and b == "two" and c == "" and d == "four"
    _ => false
## a form feed (page break of an RFC) does not start a new line: line numbers agree with sed and awk
fn test_str_line_numbers_like_awk() = let s = "a\nb" + chr(12) + "c\nd\n" in str_line(s, 1) == "a" and str_line(s, 2) == "b" + chr(12) + "c" and str_line(s, 3) == "d" and str_line(s, 4) == "" and str_line(s, 0) == ""
fn test_str_line_with_label() = str_line_with("x\n   quic key:  00100e\ny", "quic key:") == "   quic key:  00100e" and str_line_with("abc", "zz") == ""

## the RFC 9001 line of the LumeDesk vectors: the value after the label, whatever the spacing
fn test_hex_after_rfc_label() = str_hex_after("   quic key:  00100e746c7331332071756963206b657900", "quic key:") == "00100e746c7331332071756963206b657900" and str_hex_after("quic key: 00100E", "quic key:") == "00100e" and str_hex_after("quic key:", "quic key:") == "" and str_hex_after("abc", "key:") == ""
fn test_hex_tokens_words_prefix_and_bytes() = let t = str_hex_tokens("key = 0xDEADbeef, iv: 00 10 0e; mac 00:1a:2B tail 123 g7") in match t
    Cons(a, Cons(b, Cons(c, Cons(d, Nil)))) => a == "deadbeef" and b == "00100e" and c == "001a2b" and d == "123"
    _ => false
fn test_hex_tokens_skip_non_hex_words() = match str_hex_tokens("quic key xyz")
    Nil => true
    _ => false
fn test_hex_tokens_long_words_stay_apart() = match str_hex_tokens("c0ffee00 0011")
    Cons(a, Cons(b, Nil)) => a == "c0ffee00" and b == "0011"
    _ => false
