## lstack.src -- static worst-case stack usage, in bytes, of `@no_alloc` functions, computed on the EMITTED x86-64 text.
##
## stdin:  @root <repo>   @src <file.src> | @asm <file.s> (both: the source only names the `@no_alloc` functions,
##         the assembly is taken as given)   [@fn <name>[,<name>...]]   [@flags <one lumec flag>]   [@json 0|1]
## stdout: one JSON object (default) or a table (@json 0). Exit status 3 when a function is rejected (the report is
##         still on stdout): its bound on the proven paths is not a number.
##
## What is computed. For every analysed function F: the maximum, over every path of the control-flow graph of the
## emitted text, of  (%rsp at the entry of F, i.e. pointing at F's return address) - (lowest %rsp while F or anything
## it calls is running), in bytes. The 8-byte return address pushed by each `call` F executes is counted, the saved
## %rbp, the frame, every push, every outgoing-argument area, and the worst callee over the call graph.
##
## The accounting rules (one list; the walk is a depth-tracking traversal of the instruction graph, sk_eff):
##   S1  `pushq x` / `pushfq`: depth + 8.  `popq x` / `popfq`: depth - 8 (a pop below the entry %rsp is an error).
##   S2  `subq $N, %rsp`: depth + N.  `addq $N, %rsp`: depth - N.  `leaq N(%rsp), %rsp`: depth - N.
##   S3  `movq %rsp, %rbp` records the depth held by %rbp; `movq %rbp, %rsp` restores it (an error when %rbp is not
##       known: any other write to %rbp forgets it); `leave` is `movq %rbp, %rsp; popq %rbp`.
##   S4  `call f`: the bound is at least depth + 8 + bound(f); the depth after the call is unchanged, which is sound
##       because every `ret` of every analysed routine is checked to execute at depth 0 (S6).
##   S5  `jmp` / `jcc` to a label: the walk continues at the label with the same depth. Every instruction must be
##       reached with ONE depth and ONE %rbp state: a second arrival with a different state is the error "unbalanced
##       stack at a join". A loop (including the self tail call `jmp .Ltail_<fn>`) is therefore accepted exactly when
##       it comes back with the depth it left with: the tail jump contributes nothing BECAUSE this check passed, and
##       the report lists each tail jump with the depth at the jump, the depth at the label, and the position of the
##       label (after the prologue).
##   S6  `ret` must execute at depth 0.
##   S7  A memory operand `-K(%rsp)` (red zone, also when only its address is taken) counts as depth + K; a store
##       through `-K(%rbp)` below the current %rsp counts the same way.
##   S8  Anything else that writes %rsp (`subq %reg, %rsp`, `andq`, `movq mem, %rsp`, `popq %rsp`, `enter`, ...), an
##       indirect `call *` / `jmp *`, a jump to an undefined label, or control running into data is an error.
##   S9  In an analysed (`@no_alloc`) function the prologue must be `pushq %rbp; movq %rsp, %rbp[; subq $F, %rsp]` and
##       control must stay between its label and the next global label ("jump out of the function" otherwise).
##   S10 A call cycle (f -> f by `call`, or f -> g -> ... -> f) has no bound: it is reported with the cycle.
##   S11 `alloc`, `__lume_alloc_a` and every `__gc_*` entry are the allocator / collector: reaching one is
##       "unbounded" (the collector's stack need depends on the heap; `@no_alloc` code must not get there).
##   S12 Trapping exits are terminal and accounted separately: a `call` / jump to an entry of the trap table
##       (sk_is_trap: ctfail, __rt_ovf, __rt_div0, ...) ends the path; "on trap" is depth (+8 for a call) + the
##       stack need of the trap routine, when that is computable. Each trap entry that is used is VERIFIED not to
##       return: its own walk must reach no `ret` (it ends in the `exit` syscall, recognised as `movq $60, %rax ...
##       syscall`, or in the try-unwind `movq mem, %rsp`, which abandons the trapping frames). A table entry that
##       can return is an error, not a silent assumption.
##   S13 `syscall` uses no user stack. Asynchronous signal frames are outside the model.
## Runtime routines the function reaches (cmpv, addv, __rt_div, mkint, ...) are in the same `.s` and are analysed by
## the same rules, not assumed.
##
## Two bounds are reported, and they are different claims:
##   all paths     every syntactically reachable edge, slow paths included. Often "unbounded": the slow path of `+`
##                 is `addv`, which can box its result in a heap cell.
##   proven paths  the edges that remain when the facts lumec PROVED for a `@no_alloc` function ([E0210]) are used:
##                 every value is a 63-bit immediate integer and every arithmetic result stays in that range. The
##                 tool does not trust a list of dead calls; it removes exactly the following EDGES, each recognised
##                 by its instruction pattern, and records one obligation per removed edge:
##                   R2  in the analysed function: `testb $1, %al; jz .Lb<n>`           taken edge dead     (A1)
##                   R3  in the analysed function: `addq|subq|imulq ...; jo .Lb<n>`      taken edge dead     (A2)
##                       in the analysed function: `addq|subq|imulq ...; jno .Lc<n>`     fall-through dead   (A2)
##                   R1  `sarq $1, %r; jnc __rt_uint1|__rt_ustk1` (unboxing helper)       taken edge dead     (A1)
##                   R5  `addq %rax, %rax; jo .Lrt_mkint_box` (mkint)                     taken edge dead     (A2)
##                   R6  `orq %rsi, %rax; testq $7, %rax; jnz eqv0` (eqv)                 fall-through dead   (A1)
##                 A1 = "the tested word is an immediate integer (tag bit set)", A2 = "the result of the operation
##                 fits the 63-bit immediate range". A slow-path `call` is dead only if NO remaining edge reaches it.
##                 The bound is therefore CONDITIONAL on A1/A2 at the listed sites; they are discharged by lumec's
##                 [E0210] acceptance of the function (typed scalar parameters with proven bounds, every `+ - * / %`
##                 and `bit_shl` result proven inside [-2^62, 2^62), no heap construct, `@no_alloc` callees only), not
##                 re-proved here. Not covered by that proof and stated in the report: a caller OUTSIDE `@no_alloc`
##                 code can pass a boxed integer; the `requires` check then runs the `cmpv` slow path before it traps.
## A second number, "written", is the deepest byte actually stored to on the proven paths (pushes, return addresses,
## frame stores). It is what stack painting can observe; it is <= the bound, and equal to it when the deepest point of
## the worst path is a push or a call.
##
## `@no_alloc` functions are found by scanning the source text (attribute `@no_alloc` before `fn <name>`, comments and
## string literals skipped); the compiler front end is not linked in, so this tool does not depend on lumec's own
## data structures. With `@src` only, the file is compiled by build/bin/lumec (a file with `use` lines goes through
## build/bin/lume_driver, whose bundled source is then compiled by lumec here).

## --- generic helpers ---------------------------------------------------------------------------------------------
fn sk_line_end(s, n, i) = if i >= n or at(s, i) == "\n" then i else sk_line_end(s, n, i + 1)
fn sk_get_at(s, n, key, i) = if i >= n then "" else let e = sk_line_end(s, n, i) in let k = count(key) in if e - i > k + 2 and slice(s, i, i + k + 2) == "@" + key + " " then slice(s, i + k + 2, e) else sk_get_at(s, n, key, e + 1)
fn sk_get(s, key) = sk_get_at(s, count(s), key, 0)
fn sk_starts(s, pre) = if count(s) >= count(pre) and slice(s, 0, count(pre)) == pre then 1 else 0
fn sk_ends(s, suf) = if count(s) >= count(suf) and slice(s, count(s) - count(suf), count(s)) == suf then 1 else 0
fn sk_max(a, b) = if a > b then a else b
fn sk_nil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn sk_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => sk_rev(t, Cons(h, acc))
fn sk_len(xs, n) = match xs
    Nil        => n
    Cons(h, t) => sk_len(t, n + 1)
fn sk_has(xs, x) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else sk_has(t, x)
fn sk_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, sk_app(t, ys))
fn sk_hd(xs, d) = match xs
    Nil        => d
    Cons(h, t) => h
fn sk_last(xs, d) = match xs
    Nil        => d
    Cons(h, t) => sk_last(t, h)
fn sk_pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => sk_pairs2(a, t)
fn sk_pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, sk_pairs(r))
fn sk_join(xs) = match xs
    Nil        => ""
    Cons(a, t) => if sk_nil(t) == 1 then a else sk_join(sk_pairs(xs))
fn sk_sep(xs, sep) = match xs
    Nil        => Nil
    Cons(a, t) => if sk_nil(t) == 1 then Cons(a, Nil) else Cons(a, Cons(sep, sk_sep(t, sep)))
fn sk_isdig(c) = if c >= "0" and c <= "9" then 1 else 0
fn sk_digits(s, i, n) = if i >= n then 1 else if sk_isdig(at(s, i)) == 1 then sk_digits(s, i + 1, n) else 0
fn sk_isint(s) = let n = count(s) in if n == 0 then 0 else if at(s, 0) == "-" then (if n > 1 then sk_digits(s, 1, n) else 0) else sk_digits(s, 0, n)
fn sk_numneg(s, i, n, acc) = if i >= n then acc else sk_numneg(s, i + 1, n, acc * 10 - (ord(at(s, i)) - 48))
fn sk_int(s) = if at(s, 0) == "-" then sk_numneg(s, 1, count(s), 0) else 0 - sk_numneg(s, 0, count(s), 0)
fn sk_jesc1(c) = if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then "\\n" else if c == "\t" then " " else c
fn sk_jesc_at(s, i, n) = if i >= n then Nil else Cons(sk_jesc1(at(s, i)), sk_jesc_at(s, i + 1, n))
fn sk_jesc(s) = sk_join(sk_jesc_at(s, 0, count(s)))
fn sk_q(s) = "\"" + sk_jesc(s) + "\""
fn sk_ws(c) = if c == " " or c == "\t" or c == "\r" then 1 else 0
fn sk_lskip(s, i, n) = if i < n and sk_ws(at(s, i)) == 1 then sk_lskip(s, i + 1, n) else i
fn sk_rskip(s, i, j) = if j > i and sk_ws(at(s, j - 1)) == 1 then sk_rskip(s, i, j - 1) else j
fn sk_trim(s) = let n = count(s) in let i = sk_lskip(s, 0, n) in let j = sk_rskip(s, i, n) in if i == 0 and j == n then s else slice(s, i, j)
fn sk_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn sk_pad(s, w) = if count(s) >= w then s else sk_pad(s + " ", w)
fn sk_lpad(s, w) = if count(s) >= w then s else sk_lpad(" " + s, w)

## --- containers: a size-indexed balanced tree (the lines) and a search tree (labels, memo, visited states) -----------
fn sk_st_build(xs, n) = if n == 0 then {t: SkLeaf, r: xs} else let ln = n / 2 in sk_st_build2(sk_st_build(xs, ln), ln, n)
fn sk_st_build2(a, ln, n) = match a.r
    Nil        => {t: a.t, r: Nil}
    Cons(h, t) => let b = sk_st_build(t, n - ln - 1) in {t: SkNode(a.t, ln, h, b.t), r: b.r}
fn sk_line(t, i) = match t
    SkLeaf              => ""
    SkNode(l, ln, v, r) => if i < ln then sk_line(l, i) else if i == ln then v else sk_line(r, i - ln - 1)
fn sk_tget(t, k) = match t
    SkE              => Nil
    SkN(l, kk, v, r) => if k == kk then Cons(v, Nil) else if k < kk then sk_tget(l, k) else sk_tget(r, k)
fn sk_tput(t, k, v) = match t
    SkE               => SkN(SkE, k, v, SkE)
    SkN(l, kk, vv, r) => if k == kk then SkN(l, kk, v, r) else if k < kk then SkN(sk_tput(l, k, v), kk, vv, r) else SkN(l, kk, vv, sk_tput(r, k, v))
## line numbers arrive almost sorted: scramble them so the visited-state tree stays shallow (the key stays unique)
fn sk_ik(i) = i * 7919 % 100003 * 10000000 + i
fn sk_lab(lab, name) = sk_hd(sk_tget(lab, name), 0 - 1)

## --- the assembly text -----------------------------------------------------------------------------------------------
fn sk_lines_rev(s, n, i, acc, k) = if i >= n then {ls: acc, n: k} else let e = sk_line_end(s, n, i) in let a = sk_lskip(s, i, e) in let b = sk_rskip(s, a, e) in sk_lines_rev(s, n, e + 1, Cons(slicen(s, n, a, b), acc), k + 1)
fn sk_is_align(l) = if sk_starts(l, ".balign") == 1 or sk_starts(l, ".p2align") == 1 or sk_starts(l, ".align") == 1 or sk_starts(l, ".globl") == 1 or sk_starts(l, ".global") == 1 or sk_starts(l, ".type") == 1 or sk_starts(l, ".size") == 1 or sk_starts(l, ".file") == 1 or sk_starts(l, ".loc") == 1 or sk_starts(l, ".cfi") == 1 then 1 else 0
fn sk_has_text(l, i, n) = if i + 5 > n then 0 else if slice(l, i, i + 5) == ".text" then 1 else sk_has_text(l, i + 1, n)
fn sk_section(l, text) = if sk_starts(l, ".section") == 1 then sk_has_text(l, 8, count(l)) else if l == ".text" then 1 else if l == ".data" or l == ".bss" or l == ".rodata" then 0 else text
## label -> line index, for the labels of the text sections only (a jump to a data label is a jump to an undefined label)
fn sk_scan(ls, i, text, lab) = match ls
    Nil        => lab
    Cons(l, t) => let n = count(l) in if n == 0 then sk_scan(t, i + 1, text, lab) else if at(l, n - 1) == ":" then sk_scan(t, i + 1, text, if text == 1 then sk_tput(lab, slice(l, 0, n - 1), i) else lab) else if at(l, 0) == "." then sk_scan(t, i + 1, sk_section(l, text), lab) else sk_scan(t, i + 1, text, lab)
fn sk_is_global_label(l) = let n = count(l) in if n > 1 and at(l, n - 1) == ":" and sk_starts(l, ".L") == 0 then 1 else 0
## first line after `i` that starts another routine (a global label) or leaves the code (a section / data directive)
fn sk_hi(g, i) = if i >= g.n then i else let l = sk_line(g.ls, i) in let n = count(l) in if sk_is_global_label(l) == 1 then i else if n > 0 and at(l, 0) == "." and at(l, n - 1) != ":" and sk_is_align(l) == 0 then i else sk_hi(g, i + 1)

## --- instruction decoding: only the effect on %rsp / %rbp and on control flow matters ---------------------------------
fn sk_e(k, t, n, op, ops) = {k: k, t: t, n: n, op: op, ops: ops}
fn sk_spc(l, i, n) = if i >= n or at(l, i) == " " or at(l, i) == "\t" then i else sk_spc(l, i + 1, n)
fn sk_opsplit(a, i, st, dp, n) = if i >= n then (if sk_lskip(a, st, n) < n then Cons(sk_trim(slice(a, st, n)), Nil) else Nil) else let c = at(a, i) in if c == "(" then sk_opsplit(a, i + 1, st, dp + 1, n) else if c == ")" then sk_opsplit(a, i + 1, st, dp - 1, n) else if c == "," and dp == 0 then Cons(sk_trim(slice(a, st, i)), sk_opsplit(a, i + 1, i + 1, 0, n)) else sk_opsplit(a, i + 1, st, dp, n)
fn sk_op_of(l) = slice(l, 0, sk_spc(l, 0, count(l)))
fn sk_imm(a) = if sk_starts(a, "$") == 1 and sk_isint(slice(a, 1, count(a))) == 1 then 1 else 0
fn sk_immv(a) = sk_int(slice(a, 1, count(a)))
fn sk_dec_rsp(op, a, l) = if sk_starts(op, "cmp") == 1 or sk_starts(op, "test") == 1 then sk_e("nop", "", 0, op, Nil) else if op == "subq" and sk_imm(a) == 1 then sk_e("adj", "", sk_immv(a), op, Nil) else if op == "addq" and sk_imm(a) == 1 then sk_e("adj", "", 0 - sk_immv(a), op, Nil) else if op == "movq" and a == "%rbp" then sk_e("restsp", "", 0, op, Nil) else if op == "leaq" and sk_ends(a, "(%rsp)") == 1 and sk_isint(slice(a, 0, count(a) - 6)) == 1 then sk_e("adj", "", 0 - sk_int(slice(a, 0, count(a) - 6)), op, Nil) else if op == "movq" then sk_e("rspload", "", 0, op, Nil) else sk_e("bad", "non-constant stack adjustment `" + l + "`", 0, op, Nil)
fn sk_dec2(op, ops, l) = let a = sk_hd(ops, "") in let z = sk_last(ops, "") in if op == "pushq" or op == "push" then (if a == "%rsp" then sk_e("bad", "`" + l + "` (the stack pointer is pushed)", 0, op, ops) else sk_e("push", a, 0, op, ops)) else if op == "popq" or op == "pop" then (if a == "%rsp" then sk_e("bad", "non-constant stack adjustment `" + l + "`", 0, op, ops) else sk_e("pop", a, 0, op, ops)) else if op == "pushfq" or op == "pushf" then sk_e("push", "", 0, op, ops) else if op == "popfq" or op == "popf" then sk_e("pop", "", 0, op, ops) else if op == "call" or op == "callq" then (if sk_starts(a, "*") == 1 then sk_e("bad", "indirect call `" + l + "`", 0, op, ops) else sk_e("call", a, 0, op, ops)) else if op == "jmp" or op == "jmpq" then (if sk_starts(a, "*") == 1 then sk_e("bad", "indirect jump `" + l + "`", 0, op, ops) else sk_e("jmp", a, 0, op, ops)) else if op == "ret" or op == "retq" then (if sk_nil(ops) == 1 then sk_e("ret", "", 0, op, ops) else sk_e("bad", "`" + l + "` (ret that pops arguments)", 0, op, ops)) else if op == "syscall" then sk_e("syscall", "", 0, op, ops) else if op == "hlt" or op == "ud2" then sk_e("halt", "", 0, op, ops) else if op == "leave" or op == "leaveq" then sk_e("leave", "", 0, op, ops) else if op == "enter" or op == "iretq" or op == "iret" or op == "sysretq" or op == "sysret" or op == "lret" then sk_e("bad", "unsupported stack instruction `" + l + "`", 0, op, ops) else if at(op, 0) == "j" or sk_starts(op, "loop") == 1 then (if sk_starts(a, "*") == 1 then sk_e("bad", "indirect jump `" + l + "`", 0, op, ops) else sk_e("jcc", a, 0, op, ops)) else if z == "%rsp" then sk_dec_rsp(op, a, l) else if z == "%esp" or z == "%sp" or z == "%spl" then sk_e("bad", "non-constant stack adjustment `" + l + "`", 0, op, ops) else if sk_starts(op, "xchg") == 1 and a == "%rsp" then sk_e("bad", "non-constant stack adjustment `" + l + "`", 0, op, ops) else if z == "%rbp" or z == "%ebp" or (sk_starts(op, "xchg") == 1 and a == "%rbp") then (if sk_starts(op, "cmp") == 1 or sk_starts(op, "test") == 1 then sk_e("nop", "", 0, op, ops) else if op == "movq" and a == "%rsp" then sk_e("setbp", "", 0, op, ops) else sk_e("clobbp", "", 0, op, ops)) else sk_e("nop", "", 0, op, ops)
fn sk_decode(l) = let n = count(l) in if n == 0 or at(l, 0) == "#" then sk_e("skip", "", 0, "", Nil) else if at(l, n - 1) == ":" then sk_e("skip", "", 0, "", Nil) else if at(l, 0) == "." then (if sk_is_align(l) == 1 then sk_e("skip", "", 0, "", Nil) else sk_e("bad", "control runs into the directive `" + l + "`", 0, "", Nil)) else let sp = sk_spc(l, 0, n) in sk_dec2(slice(l, 0, sp), sk_opsplit(l, sp, sp, 0, n), l)

## S7: depth of the byte an operand addresses through %rsp / %rbp (<= 0: none, or above the entry %rsp; a symbolic
## %rsp offset is an error). It counts for the bound when it is below the current %rsp and for "written" when the
## operand is the destination.
fn sk_paren(o, i, n) = if i >= n then 0 - 1 else if at(o, i) == "(" then i else sk_paren(o, i + 1, n)
fn sk_touch1(o, d, bp) = let n = count(o) in let p = sk_paren(o, 0, n) in if p < 0 then 0 else let base = slice(o, p, n) in let off = slice(o, 0, p) in if sk_starts(base, "(%rsp") == 1 then (if off == "" then d else if sk_isint(off) == 1 then d - sk_int(off) else 0 - 1000000000000) else if sk_starts(base, "(%rbp") == 1 and bp >= 0 then (if off == "" then bp else if sk_isint(off) == 1 then bp - sk_int(off) else 0) else 0
fn sk_reads_only(op) = if sk_starts(op, "cmp") == 1 or sk_starts(op, "test") == 1 or sk_starts(op, "push") == 1 or op == "idivq" or op == "divq" or op == "mulq" then 1 else 0
fn sk_touches(ops, op, d, bp, a) = match ops
    Nil        => a
    Cons(o, t) => let x = sk_touch1(o, d, bp) in if x < 0 - 999999999999 then sk_a_err(a, "symbolic offset from %rsp in `" + o + "`") else if x <= 0 then sk_touches(t, op, d, bp, a) else sk_touches(t, op, d, bp, sk_a_pk(a, x, if op == "leaq" or (sk_nil(t) == 1 and sk_reads_only(op) == 0) then x else 0))

## --- S11 / S12 tables ----------------------------------------------------------------------------------------------
fn sk_barrier(nm) = if nm == "alloc" or nm == "__lume_alloc_a" or sk_starts(nm, "__gc_") == 1 then 1 else 0
fn sk_is_trap(nm) = if nm == "ctfail" or nm == "__rt_try_fail" or nm == "__rt_die3" or nm == "__rt_die_now" or nm == "__rt_div0" or nm == "__rt_ovf" or nm == "__rt_not_int" or nm == "__rt_not_bool" or nm == "__rt_not_str" or nm == "__rt_no_match" or nm == "__rt_no_field" then 1 else 0
## `syscall` is the process exit when the straight-line code before it loads 60 (exit) or 231 (exit_group) into %rax
fn sk_is_exit(ls, j, k) = if k == 0 or j < 0 then 0 else let l = sk_line(ls, j) in let n = count(l) in if l == "movq $60, %rax" or l == "movq $231, %rax" then 1 else if n == 0 then sk_is_exit(ls, j - 1, k) else if at(l, n - 1) == ":" or at(l, 0) == "." then 0 else if sk_ends(l, "%rax") == 1 or sk_ends(l, "%eax") == 1 or sk_ends(l, "%ax") == 1 or sk_ends(l, "%al") == 1 or sk_starts(l, "call") == 1 or sk_starts(l, "syscall") == 1 or at(l, 0) == "j" or sk_starts(l, "ret") == 1 then 0 else sk_is_exit(ls, j - 1, k - 1)

## --- the walk ------------------------------------------------------------------------------------------------------
## acc: pk = deepest %rsp excursion of the routine itself (callees excluded), wk = deepest byte stored to, calls /
## traps = the edges, obl = the edges removed on the proven paths, tails = self tail jumps, rets = `ret`s reached,
## unw = a try-unwind was reached (trap walk only)
fn sk_acc(pk, wk, calls, traps, obl, tails, err, rets, unw) = {pk: pk, wk: wk, calls: calls, traps: traps, obl: obl, tails: tails, err: err, rets: rets, unw: unw}
fn sk_a_pk(a, p, w) = sk_acc(sk_max(a.pk, p), sk_max(a.wk, w), a.calls, a.traps, a.obl, a.tails, a.err, a.rets, a.unw)
fn sk_a_err(a, e) = sk_acc(a.pk, a.wk, a.calls, a.traps, a.obl, a.tails, e, a.rets, a.unw)
fn sk_a_call(a, c) = sk_acc(a.pk, a.wk, Cons(c, a.calls), a.traps, a.obl, a.tails, a.err, a.rets, a.unw)
fn sk_a_trap(a, t) = sk_acc(a.pk, a.wk, a.calls, Cons(t, a.traps), a.obl, a.tails, a.err, a.rets, a.unw)
fn sk_a_obl(a, o) = sk_acc(a.pk, a.wk, a.calls, a.traps, Cons(o, a.obl), a.tails, a.err, a.rets, a.unw)
fn sk_a_tail(a, t) = sk_acc(a.pk, a.wk, a.calls, a.traps, a.obl, Cons(t, a.tails), a.err, a.rets, a.unw)
fn sk_a_ret(a) = sk_acc(a.pk, a.wk, a.calls, a.traps, a.obl, a.tails, a.err, a.rets + 1, a.unw)
fn sk_a_unw(a) = sk_acc(a.pk, a.wk, a.calls, a.traps, a.obl, a.tails, a.err, a.rets, 1)
fn sk_w(i, d, bp) = {i: i, d: d, bp: bp}
fn sk_r(nx, seen, acc) = {nx: nx, seen: seen, acc: acc}
fn sk_at(cx, i) = "line " + str(i + 1) + " `" + sk_line(cx.ls, i) + "`"
fn sk_lnum(t, pre) = if sk_starts(t, pre) == 1 and count(t) > count(pre) then sk_digits(t, count(pre), count(t)) else 0
fn sk_arith(op) = if op == "addq" or op == "subq" or op == "imulq" then 1 else 0
## the edges that are dead on the proven paths (header, R1..R6): 0 none, 1x the taken edge, 2x the fall-through
fn sk_dead(cx, w, e) = if cx.mode != 1 or w.i < 2 then 0 else let p = sk_line(cx.ls, w.i - 1) in let pop = sk_op_of(p) in if cx.strict == 1 and e.op == "jz" and p == "testb $1, %al" and sk_lnum(e.t, ".Lb") == 1 then 12 else if cx.strict == 1 and e.op == "jo" and sk_arith(pop) == 1 and sk_lnum(e.t, ".Lb") == 1 then 13 else if cx.strict == 1 and e.op == "jno" and sk_arith(pop) == 1 and sk_lnum(e.t, ".Lc") == 1 then 23 else if e.op == "jnc" and (e.t == "__rt_uint1" or e.t == "__rt_ustk1") and sk_starts(p, "sarq $1, %r") == 1 then 11 else if e.op == "jo" and e.t == ".Lrt_mkint_box" and p == "addq %rax, %rax" then 15 else if e.op == "jnz" and e.t == "eqv0" and p == "testq $7, %rax" and sk_line(cx.ls, w.i - 2) == "orq %rsi, %rax" then 26 else 0
fn sk_obl(cx, w, code) = {rule: code % 10, side: code / 10, nm: cx.nm, i: w.i, txt: sk_line(cx.ls, w.i - 1) + "; " + sk_line(cx.ls, w.i)}
## S5 / S12: the successor of a taken jump
fn sk_goto(cx, w, a, t) = let idx = sk_lab(cx.lab, t) in if cx.mode != 2 and sk_starts(t, ".L") == 0 and sk_is_trap(t) == 1 then {nx: Nil, acc: sk_a_trap(a, {cal: t, d: w.d, i: w.i})} else if idx < 0 then {nx: Nil, acc: sk_a_err(a, "jump to the undefined label '" + t + "' at " + sk_at(cx, w.i))} else if cx.strict == 1 and (idx < cx.lo or idx >= cx.hi) then {nx: Nil, acc: sk_a_err(a, "jump out of the function at " + sk_at(cx, w.i))} else {nx: Cons(sk_w(idx, w.d, w.bp), Nil), acc: if cx.strict == 1 and t == cx.tl then sk_a_tail(a, {i: w.i, d: w.d, bp: w.bp}) else a}
fn sk_jcc(cx, w, seen, a, e) = let dead = sk_dead(cx, w, e) in let tk = if dead / 10 == 1 then {nx: Nil, acc: sk_a_obl(a, sk_obl(cx, w, dead))} else sk_goto(cx, w, a, e.t) in if dead / 10 == 2 then sk_r(tk.nx, seen, sk_a_obl(tk.acc, sk_obl(cx, w, dead))) else sk_r(Cons(sk_w(w.i + 1, w.d, w.bp), tk.nx), seen, tk.acc)
fn sk_next(w, d, bp) = Cons(sk_w(w.i + 1, d, bp), Nil)
fn sk_eff(cx, w, seen, a, e) = let k = e.k in if a.err != "" then sk_r(Nil, seen, a) else if k == "skip" or k == "nop" then sk_r(sk_next(w, w.d, w.bp), seen, a) else if k == "push" then sk_r(sk_next(w, w.d + 8, w.bp), seen, sk_a_pk(a, w.d + 8, w.d + 8)) else if k == "pop" then (if w.d < 8 then sk_r(Nil, seen, sk_a_err(a, "pop below the entry %rsp at " + sk_at(cx, w.i))) else sk_r(sk_next(w, w.d - 8, if e.t == "%rbp" then 0 - 1 else w.bp), seen, a)) else if k == "adj" then (if w.d + e.n < 0 then sk_r(Nil, seen, sk_a_err(a, "%rsp is raised above the entry %rsp at " + sk_at(cx, w.i))) else sk_r(sk_next(w, w.d + e.n, w.bp), seen, sk_a_pk(a, w.d + e.n, 0))) else if k == "setbp" then sk_r(sk_next(w, w.d, w.d), seen, a) else if k == "clobbp" then sk_r(sk_next(w, w.d, 0 - 1), seen, a) else if k == "restsp" then (if w.bp < 0 then sk_r(Nil, seen, sk_a_err(a, "`movq %rbp, %rsp` with an unknown %rbp at line " + str(w.i + 1))) else sk_r(sk_next(w, w.bp, w.bp), seen, a)) else if k == "leave" then (if w.bp < 8 then sk_r(Nil, seen, sk_a_err(a, "`leave` with an unknown %rbp at line " + str(w.i + 1))) else sk_r(sk_next(w, w.bp - 8, 0 - 1), seen, a)) else if k == "rspload" then (if cx.mode == 2 then sk_r(Nil, seen, sk_a_unw(a)) else sk_r(Nil, seen, sk_a_err(a, "non-constant stack adjustment at " + sk_at(cx, w.i)))) else if k == "call" then (if sk_is_trap(e.t) == 1 and cx.mode != 2 then sk_r(Nil, seen, sk_a_trap(a, {cal: e.t, d: w.d + 8, i: w.i})) else sk_r(if sk_is_trap(e.t) == 1 then Nil else sk_next(w, w.d, w.bp), seen, sk_a_call(sk_a_pk(a, w.d + 8, w.d + 8), {cal: e.t, d: w.d, i: w.i}))) else if k == "jmp" then (let g = sk_goto(cx, w, a, e.t) in sk_r(g.nx, seen, g.acc)) else if k == "jcc" then sk_jcc(cx, w, seen, a, e) else if k == "ret" then (if w.d != 0 then sk_r(Nil, seen, sk_a_err(a, "`ret` with " + str(w.d) + " bytes still on the stack at line " + str(w.i + 1))) else sk_r(Nil, seen, sk_a_ret(a))) else if k == "syscall" then (if sk_is_exit(cx.ls, w.i - 1, 6) == 1 then sk_r(Nil, seen, a) else sk_r(sk_next(w, w.d, w.bp), seen, a)) else if k == "halt" then sk_r(Nil, seen, a) else sk_r(Nil, seen, sk_a_err(a, e.t + " at line " + str(w.i + 1)))
fn sk_step(cx, w, seen, a) = let e = sk_decode(sk_line(cx.ls, w.i)) in sk_eff(cx, w, seen, sk_touches(e.ops, e.op, w.d, w.bp, a), e)
fn sk_join_chk(cx, w, seen, a, p) = if p.d == w.d and p.bp == w.bp then sk_r(Nil, seen, a) else if p.d != w.d then sk_r(Nil, seen, sk_a_err(a, "unbalanced stack at a join: " + sk_at(cx, w.i) + " is reached with " + str(p.d) + " and with " + str(w.d) + " bytes on the stack")) else sk_r(Nil, seen, sk_a_err(a, "inconsistent %rbp at a join: " + sk_at(cx, w.i)))
fn sk_one(cx, w, seen, a) = let prev = sk_tget(seen, sk_ik(w.i)) in if sk_nil(prev) == 0 then sk_join_chk(cx, w, seen, a, sk_hd(prev, w)) else if w.i >= cx.n then sk_r(Nil, seen, sk_a_err(a, "control runs past the end of the text")) else if cx.strict == 1 and (w.i < cx.lo or w.i >= cx.hi) then sk_r(Nil, seen, sk_a_err(a, "control falls out of the function at line " + str(w.i + 1))) else sk_step(cx, w, sk_tput(seen, sk_ik(w.i), {d: w.d, bp: w.bp}), a)
fn sk_walk(cx, work, seen, a) = match work
    Nil          => {acc: a, seen: seen}
    Cons(w, rest) => if a.err != "" then {acc: a, seen: seen} else let r = sk_one(cx, w, seen, a) in sk_walk(cx, sk_app(r.nx, rest), r.seen, r.acc)

## --- S9: the shape of an analysed function ----------------------------------------------------------------------------
fn sk_frame(g, lo) = let l3 = sk_line(g.ls, lo + 3) in if sk_line(g.ls, lo + 1) != "pushq %rbp" or sk_line(g.ls, lo + 2) != "movq %rsp, %rbp" then 0 - 1 else if sk_starts(l3, "subq $") == 1 and sk_ends(l3, ", %rsp") == 1 and sk_isint(slice(l3, 6, count(l3) - 6)) == 1 then sk_int(slice(l3, 6, count(l3) - 6)) else 0
fn sk_cx(g, nm, idx, mode) = let strict = if sk_has(g.nas, nm) == 1 then 1 else if sk_has(g.targets, nm) == 1 and sk_frame(g, idx) >= 0 then 1 else 0 in {ls: g.ls, n: g.n, lab: g.lab, mode: mode, strict: strict, lo: idx, hi: if strict == 1 then sk_hi(g, idx + 1) else g.n, nm: nm, tl: ".Ltail_" + nm}

## --- the call graph: bound(f) = max(own, depth at call + 8 + bound(callee)) -------------------------------------------
## r: ok / n (bound) / w (written) / why (when not ok) / cyc (a call cycle) / pk wk (own) / edges / traps / tails / obl
##    (transitive) / tn (worst computable "on trap" total, -1 none) / tx (why a trap path is not computable) / tld
##    (depth at the tail label, -1 none)
fn sk_res(ok, n, w, why, cyc, a, edges, obl, tn, tx, tld) = {ok: ok, n: n, w: w, why: why, cyc: cyc, pk: a.pk, wk: a.wk, edges: edges, traps: a.traps, tails: a.tails, obl: obl, tn: tn, tx: tx, tld: tld, unw: a.unw}
fn sk_unb(why, cyc) = sk_res(0, 0, 0, why, cyc, sk_acc(0, 0, Nil, Nil, Nil, Nil, "", 0, 0), Nil, Nil, 0 - 1, "", 0 - 1)
fn sk_chain_from(xs, nm, go) = match xs
    Nil        => Nil
    Cons(h, t) => if go == 1 or h == nm then Cons(h, Cons(" -> ", sk_chain_from(t, nm, 1))) else sk_chain_from(t, nm, 0)
fn sk_chain(stk, nm) = sk_join(sk_chain_from(sk_rev(stk, Nil), nm, 0)) + nm
fn sk_put(memo, key, r) = {memo: sk_tput(memo, key, r), r: r}
fn sk_need(g, nm, mode, stk, memo) = let key = str(mode) + ":" + nm in let hit = sk_tget(memo, key) in if sk_nil(hit) == 0 then {memo: memo, r: sk_hd(hit, sk_unb("", 0))} else if sk_has(stk, nm) == 1 then {memo: memo, r: sk_unb("call cycle " + sk_chain(stk, nm) + (if sk_hd(stk, "") == nm then " (self recursion that is not a tail jump)" else " (mutual recursion)"), 1)} else if sk_barrier(nm) == 1 then sk_put(memo, key, sk_unb(nm + " (heap allocator / collector)", 0)) else let idx = sk_lab(g.lab, nm) in if idx < 0 then sk_put(memo, key, sk_unb(nm + " (no such routine in the text)", 0)) else let cx = sk_cx(g, nm, idx, mode) in let fr = if cx.strict == 1 then sk_frame(g, idx) else 0 in if fr < 0 then sk_put(memo, key, sk_unb(nm + ": unexpected prologue (not `pushq %rbp; movq %rsp, %rbp`)", 0)) else let wr = sk_walk(cx, Cons(sk_w(idx, 0, 0 - 1), Nil), SkE, sk_acc(0, 0, Nil, Nil, Nil, Nil, "", 0, 0)) in let a = wr.acc in if a.err != "" then sk_put(memo, key, sk_unb(nm + ": " + a.err, 0)) else if mode == 2 and sk_is_trap(nm) == 1 and a.rets > 0 then sk_put(memo, key, sk_unb(nm + ": the trap table says it never returns, but a `ret` is reachable", 2)) else let tli = sk_lab(g.lab, cx.tl) in let tls = if cx.strict == 1 and tli >= 0 then sk_tget(wr.seen, sk_ik(tli)) else Nil in if sk_nil(a.tails) == 0 and (tli < idx + 3 or sk_nil(tls) == 1) then sk_put(memo, key, sk_unb(nm + ": the tail label is not after the prologue", 0)) else let f = sk_fold(g, nm, mode, stk, memo, sk_rev(a.calls, Nil), a.pk, a.wk, "", 0, Nil, a.obl, 0 - 1, "") in let t = sk_trapfold(g, nm, stk, f.memo, sk_rev(a.traps, Nil), f.tn, f.tx, "") in sk_put(t.memo, key, sk_res(if f.bad == "" and t.tb == "" then 1 else 0, f.n, f.w, if f.bad != "" then f.bad else if t.tb != "" then nm + " -> " + t.tb else "", f.cyc, a, sk_rev(f.edges, Nil), f.obl, t.tn, t.tx, (sk_hd(tls, {d: 0 - 1, bp: 0})).d))
fn sk_fold(g, nm, mode, stk, memo, calls, n, w, bad, cyc, edges, obl, tn, tx) = match calls
    Nil        => {memo: memo, n: n, w: w, bad: bad, cyc: cyc, edges: edges, obl: obl, tn: tn, tx: tx}
    Cons(c, t) => let s = sk_need(g, c.cal, mode, Cons(nm, stk), memo) in let r = s.r in sk_fold(g, nm, mode, stk, s.memo, t, if r.ok == 1 then sk_max(n, c.d + 8 + r.n) else n, if r.ok == 1 then sk_max(w, c.d + 8 + r.w) else w, if bad != "" or r.ok == 1 then bad else if r.cyc == 1 then r.why else nm + " -> " + r.why, if bad == "" and r.ok == 0 then r.cyc else cyc, Cons({cal: c.cal, d: c.d, i: c.i, ok: r.ok, n: r.n, why: r.why}, edges), sk_app(r.obl, obl), if r.tn >= 0 then sk_max(tn, c.d + 8 + r.tn) else tn, if tx == "" then r.tx else tx)
fn sk_trapfold(g, nm, stk, memo, traps, tn, tx, tb) = match traps
    Nil        => {memo: memo, tn: tn, tx: tx, tb: tb}
    Cons(c, t) => let s = sk_need(g, c.cal, 2, Nil, memo) in let r = s.r in sk_trapfold(g, nm, stk, s.memo, t, if r.ok == 1 then sk_max(tn, c.d + r.n) else tn, if r.ok == 1 or tx != "" then tx else r.why, if tb == "" and r.ok == 0 and r.cyc == 2 then r.why else tb)

## --- `@no_alloc` functions of the source text ------------------------------------------------------------------------
fn sk_isid(c) = if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" or sk_isdig(c) == 1 then 1 else 0
fn sk_idend(s, n, i) = if i < n and sk_isid(at(s, i)) == 1 then sk_idend(s, n, i + 1) else i
fn sk_strend(s, n, i) = if i >= n then n else if at(s, i) == "\\" then sk_strend(s, n, i + 2) else if at(s, i) == "\"" then i + 1 else sk_strend(s, n, i + 1)
fn sk_decl_stop(wd) = if wd == "type" or wd == "const" or wd == "let" or wd == "print" or wd == "trait" or wd == "impl" or wd == "effect" or wd == "law" then 1 else 0
fn sk_na_scan(s, n, i, pend, acc) = if i >= n then sk_rev(acc, Nil) else let c = at(s, i) in if c == "#" then sk_na_scan(s, n, sk_line_end(s, n, i), pend, acc) else if c == "\"" then sk_na_scan(s, n, sk_strend(s, n, i + 1), pend, acc) else if c == "@" then (let a = sk_lskip(s, i + 1, n) in let b = sk_idend(s, n, a) in sk_na_scan(s, n, if b > i + 1 then b else i + 1, if slicen(s, n, a, b) == "no_alloc" then 1 else pend, acc)) else if sk_isid(c) == 1 then (let b = sk_idend(s, n, i) in let wd = slicen(s, n, i, b) in if wd == "fn" then (let a2 = sk_lskip(s, b, n) in let b2 = sk_idend(s, n, a2) in sk_na_scan(s, n, if b2 > b then b2 else b, 0, if pend == 1 and b2 > a2 then Cons(slicen(s, n, a2, b2), acc) else acc)) else sk_na_scan(s, n, b, if sk_decl_stop(wd) == 1 then 0 else pend, acc)) else sk_na_scan(s, n, i + 1, pend, acc)
fn sk_noalloc_fns(src) = sk_na_scan(src, count(src), 0, 0, Nil)
fn sk_has_use(s, n, i) = if i >= n then 0 else let a = sk_lskip(s, i, n) in if a + 4 <= n and slicen(s, n, a, a + 4) == "use " then 1 else sk_has_use(s, n, sk_line_end(s, n, i) + 1)
fn sk_split_commas(s, i, st, n) = if i >= n then (if n > st then Cons(sk_trim(slice(s, st, n)), Nil) else Nil) else if at(s, i) == "," then Cons(sk_trim(slice(s, st, i)), sk_split_commas(s, i + 1, i + 1, n)) else sk_split_commas(s, i + 1, st, n)

## --- report ----------------------------------------------------------------------------------------------------------
fn sk_bound_json(r) = if r.ok == 1 then str(r.n) else "\"unbounded\""
fn sk_edge_in(edges, i) = match edges
    Nil        => 0
    Cons(e, t) => if e.i == i then 1 else sk_edge_in(t, i)
fn sk_edge_find(edges, i, d) = match edges
    Nil        => d
    Cons(e, t) => if e.i == i then e else sk_edge_find(t, i, d)
## the call sites of the all-paths walk, grouped by (callee, depth, on the proven paths)
fn sk_grp_add(gs, key, e, pv) = match gs
    Nil        => Cons({key: key, e: e, pv: pv, k: 1}, Nil)
    Cons(h, t) => if h.key == key then Cons({key: h.key, e: h.e, pv: h.pv, k: h.k + 1}, t) else Cons(h, sk_grp_add(t, key, e, pv))
fn sk_groups(e0, e1, gs) = match e0
    Nil        => gs
    Cons(e, t) => let pv = sk_edge_in(e1, e.i) in sk_groups(t, e1, sk_grp_add(gs, e.cal + "|" + str(e.d) + "|" + str(pv), if pv == 1 then sk_edge_find(e1, e.i, e) else e, pv))
fn sk_grp_json(gs) = match gs
    Nil        => Nil
    Cons(h, t) => Cons("{\"callee\":" + sk_q(h.e.cal) + ",\"depth_at_call\":" + str(h.e.d) + ",\"call_sites\":" + str(h.k) + ",\"on_proven_paths\":" + (if h.pv == 1 then "true" else "false") + ",\"callee_bytes\":" + (if h.e.ok == 1 then str(h.e.n) else "\"unbounded\"") + ",\"total_bytes\":" + (if h.e.ok == 1 then str(h.e.d + 8 + h.e.n) else "\"unbounded\"") + (if h.e.ok == 1 then "" else ",\"chain\":" + sk_q(h.e.why)) + "}", sk_grp_json(t))
fn sk_tails_json(g, ts, tld, tli) = match ts
    Nil        => Nil
    Cons(h, t) => Cons("{\"line\":" + str(h.i + 1) + ",\"depth_at_jump\":" + str(h.d) + ",\"depth_at_label\":" + str(tld) + ",\"label_line\":" + str(tli + 1) + ",\"frame_reused\":" + (if h.d == tld then "true" else "false") + "}", sk_tails_json(g, t, tld, tli))
fn sk_rule_name(k) = if k == 1 then "R1 unboxing helper: `sarq $1; jnc` taken edge dead" else if k == 2 then "R2 tag test: `testb $1, %al; jz .Lb` taken edge dead" else if k == 3 then "R3 overflow test of an inline `+ - *`: slow-path edge dead" else if k == 5 then "R5 mkint: `jo .Lrt_mkint_box` taken edge dead" else "R6 eqv: pointer comparison edge dead"
fn sk_rule_assume(k) = if k == 1 or k == 2 or k == 6 then "A1 the tested word is an immediate integer (tag bit set)" else "A2 the result of the operation fits the 63-bit immediate range"
fn sk_obl_dedupe(os, seen, acc) = match os
    Nil        => sk_rev(acc, Nil)
    Cons(o, t) => let k = o.nm + ":" + str(o.i) in if sk_has(seen, k) == 1 then sk_obl_dedupe(t, seen, acc) else sk_obl_dedupe(t, Cons(k, seen), Cons(o, acc))
fn sk_obl_json(os, how) = match os
    Nil        => Nil
    Cons(o, t) => Cons("{\"rule\":" + sk_q(sk_rule_name(o.rule)) + ",\"assumes\":" + sk_q(sk_rule_assume(o.rule)) + ",\"in\":" + sk_q(o.nm) + ",\"line\":" + str(o.i + 1) + ",\"code\":" + sk_q(o.txt) + ",\"discharged_by\":" + sk_q(how) + "}", sk_obl_json(t, how))
fn sk_count_rule(os, a1, n) = match os
    Nil        => n
    Cons(o, t) => sk_count_rule(t, a1, if (if o.rule == 1 or o.rule == 2 or o.rule == 6 then 1 else 0) == a1 then n + 1 else n)
fn sk_arr(xs) = "[" + sk_join(sk_sep(xs, ",")) + "]"
fn sk_status(t) = if t.present == 0 then "absent" else if t.r1.ok == 1 then "bounded" else "rejected"
fn sk_fn_json(g, t, how) = if t.present == 0 then "{\"name\":" + sk_q(t.nm) + ",\"status\":\"absent\",\"diagnostic\":\"no routine of this name in the emitted text\"}" else let r0 = t.r0 in let r1 = t.r1 in let os = sk_obl_dedupe(r1.obl, Nil, Nil) in let fr = sk_max(sk_frame(g, t.lo), 0) in "{\"name\":" + sk_q(t.nm) + ",\"status\":" + sk_q(sk_status(t)) + ",\"no_alloc\":" + (if t.na == 1 then "true" else "false") + ",\"frame_bytes\":" + str(fr) + ",\"max_push_bytes\":" + str(sk_max(r0.pk - 8 - fr, 0)) + ",\"own_bytes\":" + str(r0.pk) + ",\"max_push_bytes_proven_paths\":" + str(sk_max(r1.pk - 8 - fr, 0)) + ",\"own_bytes_proven_paths\":" + str(r1.pk) + ",\"callees\":" + sk_arr(sk_grp_json(sk_groups(r0.edges, r1.edges, Nil))) + ",\"max_stack_bytes_all_paths\":" + sk_bound_json(r0) + (if r0.ok == 1 then "" else ",\"all_paths_chain\":" + sk_q(r0.why)) + ",\"max_stack_bytes_proven_paths\":" + sk_bound_json(r1) + (if r1.ok == 1 then ",\"max_written_bytes_proven_paths\":" + str(r1.w) else ",\"diagnostic\":" + sk_q(r1.why)) + ",\"proven_paths_are\":" + sk_q(if t.na == 1 then "conditional on the `@no_alloc` range proofs (see assumptions)" else "the same as all paths: the function is not `@no_alloc`, no edge was removed") + ",\"on_trap_bytes_proven_paths\":" + (if r1.tn >= 0 then str(r1.tn) else "null") + ",\"trap_note\":" + sk_q(if r1.tx != "" then "a trap path is excluded (the process aborts or unwinds): " + r1.tx else if r1.tn >= 0 then "deepest trap site + the stack need of the trap routine; the trap routines were verified not to return" else "no trap site on the proven paths") + ",\"self_tail_jumps\":" + sk_arr(sk_tails_json(g, sk_rev(r1.tails, Nil), r1.tld, sk_lab(g.lab, ".Ltail_" + t.nm))) + ",\"assumption_count\":{\"A1_immediate_operands\":" + str(sk_count_rule(os, 1, 0)) + ",\"A2_result_in_range\":" + str(sk_count_rule(os, 0, 0)) + "},\"assumptions\":" + sk_arr(sk_obl_json(os, how)) + "}"
fn sk_fns_json(g, ts, how) = match ts
    Nil        => Nil
    Cons(t, r) => Cons(sk_fn_json(g, t, how), sk_fns_json(g, r, how))
fn sk_count_status(ts, st, n) = match ts
    Nil        => n
    Cons(t, r) => sk_count_status(r, st, if sk_status(t) == st then n + 1 else n)
fn sk_count_unb(ts, n) = match ts
    Nil        => n
    Cons(t, r) => sk_count_unb(r, if t.present == 1 and t.r0.ok == 0 then n + 1 else n)
fn sk_worst(ts, best) = match ts
    Nil        => best
    Cons(t, r) => sk_worst(r, if t.present == 1 and t.r1.ok == 1 and t.r1.n > best.n then {nm: t.nm, n: t.r1.n} else best)
fn sk_diags(ts) = match ts
    Nil        => Nil
    Cons(t, r) => if sk_status(t) == "rejected" then Cons("lstack: rejected '" + t.nm + "': " + t.r1.why + "\n", sk_diags(r)) else sk_diags(r)
fn sk_standing() = "[\"asynchronous signal frames are not counted\",\"`syscall` uses no user stack\",\"a caller outside `@no_alloc` code that passes a boxed integer makes the `requires` check run the cmpv slow path before it traps: that excursion is covered by the all-paths numbers of the cmpv call sites, not by the proven-paths bound\",\"the emitted operations compute the source-level subexpressions lumec proved in range (constant folding only removes operations); lstack does not re-prove ranges\",\"a trap inside an active `try` unwinds to the handler frame, which is above the trapping frame\"]"
fn sk_json(g, ts, prep) = let w = sk_worst(ts, {nm: "", n: 0 - 1}) in let rej = sk_count_status(ts, "rejected", 0) in "{\"ok\":" + (if rej == 0 then "true" else "false") + ",\"tool\":\"lstack\",\"unit\":\"bytes below the %rsp at function entry (the entry %rsp points at the function's own return address)\",\"source\":" + sk_q(prep.srcp) + ",\"assembly\":" + sk_q(prep.asm) + ",\"assembly_origin\":" + sk_q(prep.how) + ",\"no_alloc_identified_by\":\"source text scan for the attribute (the compiler front end is not linked in)\",\"functions\":" + sk_arr(sk_fns_json(g, ts, prep.dis)) + ",\"summary\":{\"analysed\":" + str(sk_len(ts, 0)) + ",\"bounded\":" + str(sk_count_status(ts, "bounded", 0)) + ",\"rejected\":" + str(rej) + ",\"absent\":" + str(sk_count_status(ts, "absent", 0)) + ",\"unbounded_on_all_paths\":" + str(sk_count_unb(ts, 0)) + ",\"max_stack_bytes_proven_paths\":" + (if w.n >= 0 then str(w.n) else "null") + ",\"worst_function\":" + sk_q(w.nm) + "},\"standing_assumptions\":" + sk_standing() + "}"
fn sk_b(r) = if r.ok == 1 then str(r.n) else "unbounded"
fn sk_rows(g, ts) = match ts
    Nil        => Nil
    Cons(t, r) => Cons(if t.present == 0 then sk_pad(t.nm, 24) + " absent from the emitted text\n" else sk_pad(t.nm, 24) + sk_lpad(str(sk_max(sk_frame(g, t.lo), 0)), 6) + sk_lpad(str(t.r1.pk), 6) + sk_lpad(sk_b(t.r1), 11) + sk_lpad(if t.r1.ok == 1 then str(t.r1.w) else "-", 9) + sk_lpad(if t.r1.tn >= 0 then str(t.r1.tn) else "-", 9) + sk_lpad(str(sk_len(sk_obl_dedupe(t.r1.obl, Nil, Nil), 0)), 8) + "  " + sk_b(t.r0) + (if t.r0.ok == 1 then "" else ": " + t.r0.why) + (if t.r1.ok == 1 then "" else "\n    REJECTED: " + t.r1.why) + "\n", sk_rows(g, r))
fn sk_table(g, ts, prep) = "lstack: " + prep.asm + " (" + prep.how + ")\nbytes below the %rsp at function entry; `proven` is conditional on the [E0210] range proofs (assumptions = removed slow-path edges)\n" + sk_pad("function", 24) + sk_lpad("frame", 6) + sk_lpad("own", 6) + sk_lpad("proven", 11) + sk_lpad("written", 9) + sk_lpad("on-trap", 9) + sk_lpad("assume", 8) + "  all paths\n" + sk_join(sk_rows(g, ts))

## --- driver ----------------------------------------------------------------------------------------------------------
fn sk_stem_at(p, i, st) = if i >= count(p) then st else sk_stem_at(p, i + 1, if at(p, i) == "/" then i + 1 else st)
fn sk_stem(p) = slice(p, sk_stem_at(p, 0, 0), count(p))
fn sk_compile(root, srcp, flags) = let src = fs_read_file(srcp) in let mk = os_run("/bin/mkdir", Cons("-p", Cons(root + "/build/lstack-work", Nil))) in let work = root + "/build/lstack-work/" + sk_stem(srcp) + "." + str(os_getpid()) in if sk_has_use(src, count(src), 0) == 1 then (let st = sk_wait_exit(os_run_capture_timeout(root + "/build/bin/lume_driver", Cons("build", Cons(srcp, Cons("-o", Cons(work + ".elf", Nil)))), work + ".build.out", work + ".build.err", 600000)) in if st != 0 or fs_path_exists(work + ".elf.bundled.src") == 0 then ctfail("lstack: lume_driver build rejected " + srcp + ":\n" + fs_read_file(work + ".build.out") + fs_read_file(work + ".build.err")) else let st2 = sk_wait_exit(os_run_input_capture_timeout(root + "/build/bin/lumec", if flags == "" then Nil else Cons(flags, Nil), work + ".elf.bundled.src", work + ".s", work + ".lumec.err", 600000)) in if st2 != 0 then ctfail("lstack: lumec rejected the bundle of " + srcp + " (exit " + str(st2) + "):\n" + fs_read_file(work + ".lumec.err")) else {asm: work + ".s", src: fs_read_file(work + ".elf.bundled.src"), srcp: srcp, how: "bundled by build/bin/lume_driver build, the bundle compiled by build/bin/lumec" + (if flags == "" then "" else " " + flags), dis: "lumec [E0210] accepted the function (lumec exit 0 on the bundled source)"}) else let st = sk_wait_exit(os_run_input_capture_timeout(root + "/build/bin/lumec", if flags == "" then Nil else Cons(flags, Nil), srcp, work + ".s", work + ".lumec.err", 600000)) in if st != 0 then ctfail("lstack: lumec rejected " + srcp + " (exit " + str(st) + "):\n" + fs_read_file(work + ".lumec.err")) else {asm: work + ".s", src: src, srcp: srcp, how: "compiled by build/bin/lumec" + (if flags == "" then "" else " " + flags), dis: "lumec [E0210] accepted the function (lumec exit 0 on this source)"}
fn sk_prepare(root, srcp, asmp, flags) = if asmp != "" then (if fs_path_exists(asmp) == 0 then ctfail("lstack: cannot read " + asmp + "\n") else {asm: asmp, src: if srcp != "" and fs_path_exists(srcp) == 1 then fs_read_file(srcp) else "", srcp: srcp, how: "supplied by the caller (@asm), not compiled here", dis: "NOT discharged by this run: the assembly was supplied by the caller; the [E0210] proofs apply only if it is lumec's output for the named source"}) else if fs_path_exists(srcp) == 0 then ctfail("lstack: cannot read " + srcp + "\n") else sk_compile(root, srcp, flags)
fn sk_all(g, names, nas, memo, acc) = match names
    Nil         => sk_rev(acc, Nil)
    Cons(nm, t) => let lo = sk_lab(g.lab, nm) in let na = sk_has(nas, nm) in if lo < 0 then sk_all(g, t, nas, memo, Cons({nm: nm, present: 0, na: na, lo: lo, r0: sk_unb("", 0), r1: sk_unb("", 0)}, acc)) else let a = sk_need(g, nm, 0, Nil, memo) in let b = sk_need(g, nm, if na == 1 then 1 else 0, Nil, a.memo) in sk_all(g, t, nas, b.memo, Cons({nm: nm, present: 1, na: na, lo: lo, r0: a.r, r1: b.r}, acc))
fn sk_finish(out, ts) = let d = sk_diags(ts) in if sk_nil(d) == 1 then out else let w = fs_write_sync("/dev/stdout", out + "\n") in ctfail(sk_join(d))
fn sk_main(input) = let root = sk_get(input, "root") in let srcp = sk_get(input, "src") in let asmp = sk_get(input, "asm") in if root == "" or (srcp == "" and asmp == "") then ctfail("lstack: usage: @root <repo> and @src <file.src> or @asm <file.s> are required on stdin ([@fn a,b] [@flags <lumec flag>] [@json 0])\n") else let prep = sk_prepare(root, srcp, asmp, sk_get(input, "flags")) in let asm = fs_read_file(prep.asm) in let lr = sk_lines_rev(asm, count(asm), 0, Nil, 0) in let ls = sk_rev(lr.ls, Nil) in let nas = sk_noalloc_fns(prep.src) in let only = sk_get(input, "fn") in let names = if only != "" then sk_split_commas(only, 0, 0, count(only)) else nas in if sk_nil(names) == 1 and prep.src == "" then ctfail("lstack: @asm without @src needs @fn <name>[,<name>...]\n") else let g = {ls: (sk_st_build(ls, lr.n)).t, n: lr.n, lab: sk_scan(ls, 0, 1, SkE), targets: names, nas: nas} in let ts = sk_all(g, names, nas, SkE, Nil) in sk_finish(if sk_get(input, "json") == "0" then sk_table(g, ts, prep) else sk_json(g, ts, prep), ts)

print sk_main(readall())
