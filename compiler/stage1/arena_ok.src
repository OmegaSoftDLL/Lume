## arena_ok.src -- #404 memory management: heap observability and arenas
## over the native runtime. Exercises the module exactly as a consumer does
## (`use arena`). Run with `lume test`.
##
## The fail-closed paths (heap cap exceeded, invalid LUME_HEAP_CAP, too many
## arenas, arena budget exceeded, heap pinned by an arena) EXIT the process
## with status 12, so they cannot be unit-tested in-process; they are covered
## driver-level in bootstrap/lume0/tests/run.sh against tests/memory/*_fail.src.
##
## Why the 1M-cell regression test is one bulk bump: the issue asks for
## "1M small cells in an arena then arena_reset". A single O(1) bump of
## 24,000,000 bytes IS 1M 24-byte cells -- and it isolates the arena's
## accounting from the boxed calling convention's dead argument garbage
## (~5 small allocations per loop iteration on the normal heap, which the
## per-cell loop test measures explicitly). The bulk test therefore asserts
## the used-bytes drop cleanly; the per-cell loop test asserts the same drop
## modulo that documented garbage; the no-arena control shows the gap a GC
## will close (docs/38-memory-management.md).
use arena

## 300k small records on the plain heap: nothing is ever freed, so `used`
## must grow monotonically (the gap regions close today and GC closes in
## general -- it cannot be reclaimed by reset because it is not in an arena).
fn rec_fill(i) = if i == 0 then 0 else let r = {cellv: i} in rec_fill(i - 1)

## 50k individual per-cell arena allocations (the per-cell path, with the
## boxed runtime's per-call argument garbage measured into the bounds).
fn cell_fill(a, i) = if i == 0 then 0 else let x = arena_alloc(a, 24) in cell_fill(a, i - 1)

fn test_heap_stats_fields() = let s = heap_stats() in s.used >= 0 and s.cap > 0 and s.allocs > 0

fn test_heap_peak_tracked() = let s = heap_stats() in heap_peak_used() >= s.used

fn test_arena_bump_in_range() =
    let before = heap_stats() in
    let a = arena_new(4096) in
    let p1 = arena_alloc(a, 100) in
    let p2 = arena_alloc(a, 100) in
    let d = arena_destroy(a) in
    let after = heap_stats() in
    d == a and p2 > p1 and after.used <= before.used + 4096

fn test_arena_reset_reuses_base() =
    let before = heap_stats() in
    let a = arena_new(4096) in
    let p1 = arena_alloc(a, 100) in
    let r = arena_reset(a) in
    let q1 = arena_alloc(a, 100) in
    let d = arena_destroy(a) in
    let after = heap_stats() in
    r == a and d == a and q1 == p1 and after.used <= before.used + 4096

fn test_arena_stays_live_after_reset() =
    let a = arena_new(8192) in
    let p1 = arena_alloc(a, 100) in
    let r = arena_reset(a) in
    let q1 = arena_alloc(a, 100) in
    let p2 = arena_alloc(a, 100) in
    let d = arena_destroy(a) in
    q1 == p1 and p2 > q1 and d == a

## The #404 memory-peak regression, at the issue's 1M-cell scale: one O(1)
## bump of 24,000,000 bytes = 1M 24-byte cells. `used` must jump by the whole
## region and return near baseline after arena_reset, while heap_peak_used()
## keeps the high-water mark proving the cells were really allocated.
fn test_arena_bulk_1m_cells_used_drop() =
    let before = heap_stats() in
    let a = arena_new(33554432) in
    let base = arena_alloc(a, 24000000) in
    let mid = heap_stats() in
    let r = arena_reset(a) in
    let d = arena_destroy(a) in
    let after = heap_stats() in
    let peak = heap_peak_used() in
    base > 0 and r == a and d == a and
    mid.used >= before.used + 24000000 and
    mid.used - after.used >= 20000000 and
    after.used <= before.used + 65536 and
    peak >= before.used + 24000000

## The per-cell path: 50k individual arena_alloc(24) calls. The used-bytes
## drop across reset is at least the 1.2 MB of cells (the boxed runtime adds
## dead argument garbage on the normal heap per call, which stays -- that is
## the documented gap, not arena leakage).
fn test_arena_many_small_allocs_drop() =
    let before = heap_stats() in
    let a = arena_new(4194304) in
    let f = cell_fill(a, 50000) in
    let mid = heap_stats() in
    let r = arena_reset(a) in
    let d = arena_destroy(a) in
    let after = heap_stats() in
    f == 0 and r == a and d == a and
    mid.used >= before.used + 1200000 and
    mid.used - after.used >= 1000000

## Same shape WITHOUT an arena: 300k live records, used grows monotonically
## and never comes back.
fn test_without_arena_monotonic_growth() =
    let before = heap_stats() in
    let f = rec_fill(300000) in
    let after = heap_stats() in
    f == 0 and after.used >= before.used + 16000000 and heap_peak_used() >= after.used
