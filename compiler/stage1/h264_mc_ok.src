## h264_mc_ok.src -- `use h264` against a reference written from the standard's formulas in ordinary Lume:
## luma quarter-sample prediction (all 16 positions, j through the vertical intermediates h1 as in 8-245, clamped
## coordinates), chroma eighth-sample prediction, and the weak / strong / chroma deblocking filters.
use h264

fn rnd(s) = (s * 1103515245 + 12345) % 2147483648
fn fill(b, i, n, s) = if i >= n then s else let w = buf_set(b, i, rnd(s) % 256) in fill(b, i + 1, n, rnd(s))
## a smooth picture (small differences) so the deblocking conditions hold
fn fill_smooth(b, i, n, s, v) = if i >= n then s else let nv = v + rnd(s) % 7 - 3 in let c = (if nv < 0 then 0 else if nv > 255 then 255 else nv) in let w = buf_set(b, i, c) in fill_smooth(b, i + 1, n, rnd(s), c)

fn cl(v, hi) = if v < 0 then 0 else if v > hi then hi else v
fn clip1(v) = if v < 0 then 0 else if v > 255 then 255 else v
fn fdiv(v, d) = if v >= 0 then v / d else 0 - ((0 - v + d - 1) / d)
## picture access: {b, o, s, w, h}
fn px(p, x, y) = buf_get(p.b, p.o + cl(y, p.h - 1) * p.s + cl(x, p.w - 1))
fn tap6(a, b, c, d, e, f) = a - 5 * b + 20 * c + 20 * d - 5 * e + f
fn hb1(p, x, y) = tap6(px(p, x - 2, y), px(p, x - 1, y), px(p, x, y), px(p, x + 1, y), px(p, x + 2, y), px(p, x + 3, y))
fn vh1(p, x, y) = tap6(px(p, x, y - 2), px(p, x, y - 1), px(p, x, y), px(p, x, y + 1), px(p, x, y + 2), px(p, x, y + 3))
## j1 = cc - 5 dd + 20 h1 + 20 m1 - 5 ee + ff: horizontal filter of the vertical intermediates
fn j1(p, x, y) = tap6(vh1(p, x - 2, y), vh1(p, x - 1, y), vh1(p, x, y), vh1(p, x + 1, y), vh1(p, x + 2, y), vh1(p, x + 3, y))
fn r5(v) = clip1(fdiv(v + 16, 32))
fn av(a, b) = (a + b + 1) / 2
fn luma_ref(p, x, y, xf, yf) = let g0 = px(p, x, y) in let b = r5(hb1(p, x, y)) in let h = r5(vh1(p, x, y)) in let j = clip1(fdiv(j1(p, x, y) + 512, 1024)) in let s = r5(hb1(p, x, y + 1)) in let m = r5(vh1(p, x + 1, y)) in luma_pick(xf * 4 + yf, {g: g0, hh: px(p, x + 1, y), mm: px(p, x, y + 1), b: b, h: h, j: j, s: s, m: m})
fn luma_pick(k, v) = if k == 0 then v.g else if k == 1 then av(v.g, v.h) else if k == 2 then v.h else if k == 3 then av(v.mm, v.h) else if k == 4 then av(v.g, v.b) else if k == 5 then av(v.b, v.h) else if k == 6 then av(v.h, v.j) else if k == 7 then av(v.h, v.s) else if k == 8 then v.b else if k == 9 then av(v.b, v.j) else if k == 10 then v.j else if k == 11 then av(v.j, v.s) else if k == 12 then av(v.hh, v.b) else if k == 13 then av(v.b, v.m) else if k == 14 then av(v.j, v.m) else av(v.m, v.s)
fn chroma_ref(p, x, y, xf, yf) = ((8 - xf) * (8 - yf) * px(p, x, y) + xf * (8 - yf) * px(p, x + 1, y) + (8 - xf) * yf * px(p, x, y + 1) + xf * yf * px(p, x + 1, y + 1) + 32) / 64

## compare a w x h prediction in dst (at 0, stride ds) with the reference at block (bx, by), vector (mx, my)
fn cmp_block(p, dst, ds, bx, by, mx, my, w, h, sh, k) = if k >= w * h then 1 else let c = k % w in let r = k / w in let qx = bx * sh + mx in let qy = by * sh + my in let want = (if sh == 4 then luma_ref(p, fdiv(qx, 4) + c, fdiv(qy, 4) + r, qx - fdiv(qx, 4) * 4, qy - fdiv(qy, 4) * 4) else chroma_ref(p, fdiv(qx, 8) + c, fdiv(qy, 8) + r, qx - fdiv(qx, 8) * 8, qy - fdiv(qy, 8) * 8)) in if buf_get(dst, r * ds + c) != want then 0 else cmp_block(p, dst, ds, bx, by, mx, my, w, h, sh, k + 1)

fn pic() = let b = buf_new(40 * 30 + 5) in let s = fill(b, 0, 40 * 30 + 5, 7) in {b: b, o: 5, s: 40, w: 36, h: 30}
## every fraction, vectors inside and far outside the picture, block sizes 4 / 8 / 16
fn luma_case(p, dst, i) = if i >= 48 then 1 else let mx = (i * 7) % 4 + 4 * ((i % 5) - 2) * (if i % 11 == 0 then 30 else 1) in let my = (i / 4) % 4 + 4 * ((i % 3) - 1) * (if i % 13 == 0 then 25 else 1) in let w = (if i % 3 == 0 then 4 else if i % 3 == 1 then 8 else 16) in let h = (if i % 2 == 0 then 4 else 16) in let bx = (i * 5) % 30 in let by = (i * 3) % 25 in let r = buf_h264_luma_mc(p.b, p.o, p.s, p.w, p.h, bx, by, mx, my, w, h, dst, 0, 16) in if r != 0 or cmp_block(p, dst, 16, bx, by, mx, my, w, h, 4, 0) == 0 then 0 else luma_case(p, dst, i + 1)
fn test_luma_all_positions() = let p = pic() in let dst = buf_new(16 * 16) in luma_case(p, dst, 0) == 1
fn chroma_case(p, dst, i) = if i >= 40 then 1 else let mx = i % 8 + 8 * ((i % 5) - 2) in let my = (i / 8) % 8 - 8 * (i % 3) in let w = (if i % 4 == 0 then 2 else if i % 4 == 1 then 4 else 8) in let bx = (i * 7) % 30 in let by = (i * 3) % 24 in let r = buf_h264_chroma_mc(p.b, p.o, p.s, p.w, p.h, bx, by, mx, my, w, w, dst, 0, 16) in if r != 0 or cmp_block(p, dst, 16, bx, by, mx, my, w, w, 8, 0) == 0 then 0 else chroma_case(p, dst, i + 1)
fn test_chroma_bilinear() = let p = pic() in let dst = buf_new(16 * 16) in chroma_case(p, dst, 0) == 1
fn test_mc_wrong_arguments() = let p = pic() in let dst = buf_new(64) in buf_h264_luma_mc(p.b, p.o, p.s, p.w, p.h, 0, 0, 0, 0, 16, 16, dst, 0, 16) == 0 - 1 and buf_h264_luma_mc(p.b, p.o, p.s, p.w, p.h, 0, 0, 0, 0, 5, 4, dst, 0, 8) == 0 - 1 and buf_h264_luma_mc(p.b, 2000, p.s, p.w, p.h, 0, 0, 0, 0, 4, 4, dst, 0, 8) == 0 - 1 and buf_h264_chroma_mc(7, 0, 8, 8, 8, 0, 0, 0, 0, 2, 2, dst, 0, 8) == 0 - 1

## deblocking reference: one line, samples p3..q3 read from a copy
fn absv(v) = if v < 0 then 0 - v else v
fn c3(lo, hi, v) = if v < lo then lo else if v > hi then hi else v
fn sget(b, q, st, i) = buf_get(b, q + i * st)
fn dline_ref(b, q, st, bs, alpha, beta, tc0, ch) = let p0 = sget(b, q, st, 0 - 1) in let p1 = sget(b, q, st, 0 - 2) in let p2 = sget(b, q, st, 0 - 3) in let p3 = sget(b, q, st, 0 - 4) in let q0 = sget(b, q, st, 0) in let q1 = sget(b, q, st, 1) in let q2 = sget(b, q, st, 2) in let q3 = sget(b, q, st, 3) in if bs == 0 or absv(p0 - q0) >= alpha or absv(p1 - p0) >= beta or absv(q1 - q0) >= beta then 0 else if bs < 4 then dweak_ref(b, q, st, {p0: p0, p1: p1, p2: p2, q0: q0, q1: q1, q2: q2}, {beta: beta, tc0: tc0, ch: ch}) else dstrong_ref(b, q, st, {p0: p0, p1: p1, p2: p2, p3: p3, q0: q0, q1: q1, q2: q2, q3: q3}, {alpha: alpha, beta: beta, ch: ch})
fn dweak_ref(b, q, st, v, k) = let ap = absv(v.p2 - v.p0) in let aq = absv(v.q2 - v.q0) in let tc = (if k.ch == 1 then k.tc0 + 1 else k.tc0 + (if ap < k.beta then 1 else 0) + (if aq < k.beta then 1 else 0)) in let d = c3(0 - tc, tc, fdiv((v.q0 - v.p0) * 4 + (v.p1 - v.q1) + 4, 8)) in let a = buf_set(b, q - st, clip1(v.p0 + d)) in let c = buf_set(b, q, clip1(v.q0 - d)) in let e = (if k.ch == 0 and ap < k.beta then buf_set(b, q - 2 * st, v.p1 + c3(0 - k.tc0, k.tc0, fdiv(v.p2 + (v.p0 + v.q0 + 1) / 2 - 2 * v.p1, 2))) else b) in let f = (if k.ch == 0 and aq < k.beta then buf_set(b, q + st, v.q1 + c3(0 - k.tc0, k.tc0, fdiv(v.q2 + (v.p0 + v.q0 + 1) / 2 - 2 * v.q1, 2))) else b) in 0
fn dstrong_ref(b, q, st, v, k) = if k.ch == 1 then (let a = buf_set(b, q - st, (2 * v.p1 + v.p0 + v.q1 + 2) / 4) in let c = buf_set(b, q, (2 * v.q1 + v.q0 + v.p1 + 2) / 4) in 0) else let small = absv(v.p0 - v.q0) < k.alpha / 4 + 2 in let a = (if small and absv(v.p2 - v.p0) < k.beta then dsp(b, q, st, v) else buf_set(b, q - st, (2 * v.p1 + v.p0 + v.q1 + 2) / 4)) in let c = (if small and absv(v.q2 - v.q0) < k.beta then dsq(b, q, st, v) else buf_set(b, q, (2 * v.q1 + v.q0 + v.p1 + 2) / 4)) in 0
fn dsp(b, q, st, v) = let a = buf_set(b, q - st, (v.p2 + 2 * v.p1 + 2 * v.p0 + 2 * v.q0 + v.q1 + 4) / 8) in let c = buf_set(b, q - 2 * st, (v.p2 + v.p1 + v.p0 + v.q0 + 2) / 4) in buf_set(b, q - 3 * st, (2 * v.p3 + 3 * v.p2 + v.p1 + v.p0 + v.q0 + 4) / 8)
fn dsq(b, q, st, v) = let a = buf_set(b, q, (v.p1 + 2 * v.p0 + 2 * v.q0 + 2 * v.q1 + v.q2 + 4) / 8) in let c = buf_set(b, q + st, (v.p0 + v.q0 + v.q1 + v.q2 + 2) / 4) in buf_set(b, q + 2 * st, (2 * v.q3 + 3 * v.q2 + v.q1 + v.q0 + v.p0 + 4) / 8)
fn nth(xs, k) = match xs
    Nil        => 0
    Cons(h, t) => if k == 0 then h else nth(t, k - 1)
fn dedge_ref(b, q0, across, along, lines, bs, alpha, beta, tc0, ch, k) = if k >= lines then 0 else let seg = (if ch == 1 then k / 2 else k / 4) in let z = dline_ref(b, q0 + k * along, across, nth(bs, seg), alpha, beta, nth(tc0, seg), ch) in dedge_ref(b, q0, across, along, lines, bs, alpha, beta, tc0, ch, k + 1)
fn same(a, b, i) = if i >= buf_len(a) then 1 else if buf_get(a, i) != buf_get(b, i) then 0 else same(a, b, i + 1)
fn copyb(b) = let c = buf_new(buf_len(b)) in let z = buf_copy(c, 0, b, 0, buf_len(b)) in c
## a 24 x 24 picture, vertical edge at column 8 (across 1, along 24) and horizontal edge at row 8 (across 24, along 1)
fn dcase(i) = let b = buf_new(576) in let s = fill_smooth(b, 0, 576, i * 31 + 3, 128) in let r = copyb(b) in let ch = i % 3 == 2 in let lines = (if ch then 8 else 16) in let bs = Cons(i % 5, Cons((i + 1) % 5, Cons((i + 2) % 5, Cons(4, Nil)))) in let tc0 = Cons(i % 4, Cons(1, Cons(2, Cons(3, Nil)))) in let vert = i % 2 == 0 in let q0 = (if vert then 4 * 24 + 8 else 8 * 24 + 4) in let across = (if vert then 1 else 24) in let along = (if vert then 24 else 1) in let alpha = 10 + i * 3 in let beta = 4 + i % 6 in let x = buf_h264_deblock_edge(b, q0, across, along, lines, bs, alpha, beta, tc0, (if ch then 1 else 0)) in let y = dedge_ref(r, q0, across, along, lines, bs, alpha, beta, tc0, (if ch then 1 else 0), 0) in x == 0 and same(b, r, 0) == 1
fn dcases(i) = if i >= 30 then 1 else if dcase(i) then dcases(i + 1) else 0
fn test_deblock_weak_strong_chroma() = dcases(0) == 1
fn test_deblock_changes_something() = let b = buf_new(576) in let s = fill_smooth(b, 0, 576, 5, 128) in let r = copyb(b) in let x = buf_h264_deblock_edge(b, 4 * 24 + 8, 1, 24, 16, [4, 4, 4, 4], 40, 10, [0, 0, 0, 0], 0) in x == 0 and same(b, r, 0) == 0
fn test_deblock_wrong_arguments() = let b = buf_new(576) in buf_h264_deblock_edge(b, 2, 1, 24, 16, [4, 4, 4, 4], 40, 10, [0, 0, 0, 0], 0) == 0 - 1 and buf_h264_deblock_edge(b, 100, 1, 24, 16, [5], 40, 10, [0], 0) == 0 - 1 and buf_h264_deblock_edge(b, 100, 0, 24, 16, [1], 40, 10, [0], 0) == 0 - 1

## LumeDesk report: with the collector running between calls, the same luma call into two destinations gave two
## different blocks (a temporary window was reached only through a block the collector does not scan)
fn lcg(s) = (s *% 1664525 +% 1013904223) % 4294967296
fn enche(b, n, i, s) = if i >= n then s else let q = buf_set(b, i, bit_shr(s, 16) % 256) in enche(b, n, i + 1, lcg(s))
fn difere(a, b, n, i) = if i >= n then false else buf_get(a, i) != buf_get(b, i) or difere(a, b, n, i + 1)
fn laco(r, d1, d2, n, s) = if n <= 0 then 0 else let a = {x: (bit_shr(s, 8) % 88) - 20, y: (bit_shr(lcg(s), 8) % 72) - 20, mx: (bit_shr(lcg(lcg(s)), 8) % 129) - 64, my: (bit_shr(lcg(lcg(lcg(s))), 8) % 129) - 64, t: "caso " + str(n)} in let r1 = buf_h264_luma_mc(r, 0, 48, 48, 32, a.x, a.y, a.mx, a.my, 16, 16, d1, 0, 16) in let r2 = buf_h264_luma_mc(r, 0, 48, 48, 32, a.x, a.y, a.mx, a.my, 16, 16, d2, 0, 16) in if difere(d1, d2, 256, 0) then n else laco(r, d1, d2, n - 1, lcg(lcg(lcg(lcg(s)))))
fn test_luma_stable_across_collections() = let r = buf_new(48 * 32) in let s = enche(r, 48 * 32, 0, 12345) in laco(r, buf_new(256), buf_new(256), 100000, 777) == 0

## every fraction and every block size (w, h in 4 / 8 / 16) inside the picture (block at 9, 7), across the bottom
## right corner (30, 26) and across the top left corner (-5, -3)
fn lsz(i) = if i == 0 then 4 else if i == 1 then 8 else 16
fn lbx(e) = if e == 0 then 9 else if e == 1 then 30 else 0 - 5
fn lby(e) = if e == 0 then 7 else if e == 1 then 26 else 0 - 3
fn luma_sizes(p, dst, i) = if i >= 432 then 1 else let fr = i % 16 in let w = lsz((i / 16) % 3) in let h = lsz((i / 48) % 3) in let e = i / 144 in let r = buf_h264_luma_mc(p.b, p.o, p.s, p.w, p.h, lbx(e), lby(e), fr % 4, fr / 4, w, h, dst, 0, 16) in if r != 0 or cmp_block(p, dst, 16, lbx(e), lby(e), fr % 4, fr / 4, w, h, 4, 0) == 0 then 0 else luma_sizes(p, dst, i + 1)
fn test_luma_every_fraction_and_size() = let p = pic() in luma_sizes(p, buf_new(16 * 16), 0) == 1
## the prediction writes the w x h block and nothing around it (the vector routines work 8 or 16 bytes at a time)
fn fillc(b, i, n, v) = if i >= n then 0 else let w = buf_set(b, i, v) in fillc(b, i + 1, n, v)
fn untouched(b, i, w, h) = if i >= 480 then true else let x = i % 24 in let y = i / 24 in ((x >= 3 and x < 3 + w and y >= 2 and y < 2 + h) or buf_get(b, i) == 77) and untouched(b, i + 1, w, h)
fn wcase(p, x, y, w, h, fr) = let d = buf_new(480) in let z = fillc(d, 0, 480, 77) in buf_h264_luma_mc(p.b, p.o, p.s, p.w, p.h, x, y, fr % 4, fr / 4, w, h, d, 2 * 24 + 3, 24) == 0 and untouched(d, 0, w, h)
fn test_luma_writes_only_the_block() = let p = pic() in wcase(p, 9, 7, 4, 4, 7) and wcase(p, 9, 7, 8, 4, 10) and wcase(p, 9, 7, 16, 8, 5) and wcase(p, 9, 7, 4, 16, 0) and wcase(p, 30, 26, 4, 8, 15) and wcase(p, 0 - 5, 0 - 3, 16, 16, 0)
