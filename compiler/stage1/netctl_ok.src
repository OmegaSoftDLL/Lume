## netctl_ok.src -- connect with a deadline and TCP_NODELAY (netctl.src, written in Lume on sys_call / buf_addr),
## on both systems: address literals, a local listener, a closed port, a silent address, bad arguments.
use netctl

fn test_v4_literals() = nc_v4("10.255.255.1") == Cons(10, Cons(255, Cons(255, Cons(1, Nil)))) and nc_isnil(nc_v4("256.1.1.1")) == 1 and nc_isnil(nc_v4("1.2.3")) == 1 and nc_isnil(nc_v4("1.2.3.4.5")) == 1 and nc_isnil(nc_v4("a.b.c.d")) == 1 and nc_isnil(nc_v4("1..2.3")) == 1
fn test_v6_literals() = nc_v6("::1") == nc_app(nc_zeros(15), Cons(1, Nil)) and nc_len(nc_v6("2001:db8::8a2e:370:7334")) == 16 and nc_v6("::ffff:10.0.0.1") == nc_app(nc_zeros(10), Cons(255, Cons(255, Cons(10, Cons(0, Cons(0, Cons(1, Nil))))))) and nc_isnil(nc_v6("1::2::3")) == 1 and nc_isnil(nc_v6("12345::1")) == 1 and nc_isnil(nc_v6("1:2:3:4:5:6:7")) == 1 and nc_len(nc_v6("1:2:3:4:5:6:7:8")) == 16 and nc_isnil(nc_v6("1.2.3.4::")) == 1
fn test_sockaddr_layout() = let a = nc_sockaddr("127.0.0.1", 8080) in let b = nc_sockaddr("::1", 443) in a.ok == 1 and a.fam == 2 and a.len == 16 and buf_get(a.buf, 0) == 2 and buf_get(a.buf, 2) == 31 and buf_get(a.buf, 3) == 144 and buf_get(a.buf, 4) == 127 and buf_get(a.buf, 7) == 1 and buf_get(a.buf, 15) == 0 and b.ok == 1 and b.fam == 10 and b.len == 28 and buf_get(b.buf, 2) == 1 and buf_get(b.buf, 3) == 187 and buf_get(b.buf, 23) == 1 and nc_sockaddr("1.2.3.4", 70000).ok == 0
fn test_connect_to_a_local_listener_and_nodelay() = let l = net_tcp_listen_addr("127.0.0.1", 47811) in let fd = net_tcp_connect_addr_timeout("127.0.0.1", 47811, 3000) in let nd = if fd >= 0 then net_tcp_nodelay(fd, 1) else 0 in let nd0 = if fd >= 0 then net_tcp_nodelay(fd, 0) else 0 in let c1 = if fd >= 0 then net_close(fd) else 0 in let c2 = if l >= 0 then net_close(l) else 0 in l >= 0 and fd >= 0 and nd == 1 and nd0 == 1
fn test_connected_socket_carries_data() = let l = net_tcp_listen_addr("127.0.0.1", 47813) in let fd = net_tcp_connect_addr_timeout("127.0.0.1", 47813, 3000) in let a = net_tcp_accept(l) in let s = net_send_str(fd, "ping") in let r = net_recv_str(a, 16) in let c1 = net_close(fd) in let c2 = net_close(a) in let c3 = net_close(l) in fd >= 0 and a >= 0 and r == "ping"
fn test_closed_port_is_refused() = let t0 = os_monotonic_ns() in let fd = net_tcp_connect_addr_timeout("127.0.0.1", 47812, 3000) in let ms = (os_monotonic_ns() - t0) / 1000000 in fd == 0 - 1 and ms < 3000
fn test_silent_address_obeys_the_deadline() = let t0 = os_monotonic_ns() in let fd = net_tcp_connect_addr_timeout("10.255.255.1", 9, 400) in let ms = (os_monotonic_ns() - t0) / 1000000 in fd == 0 - 1 and ms < 5000
fn test_bad_arguments() = net_tcp_connect_addr_timeout("999.1.1.1", 80, 100) == 0 - 1 and net_tcp_connect_addr_timeout("127.0.0.1", 0 - 1, 100) == 0 - 1 and net_tcp_connect_addr_timeout("127.0.0.1", 80, 0 - 5) == 0 - 1 and net_tcp_connect_addr_timeout("fe80::1%eth0", 80, 100) == 0 - 1
fn test_nodelay_on_a_bad_socket() = net_tcp_nodelay(0 - 1, 1) == 0

## non-blocking writes: a peer that does not read never stops the sender; epoll says when writing can go on
fn nb_fill(fd, total, rounds) = if rounds <= 0 then {total: total, full: 0} else let k = net_send_some(fd, nb_block()) in if k < 0 then {total: total, full: 0 - 1} else if k == 0 then {total: total, full: 1} else nb_fill(fd, total + k, rounds - 1)
fn nb_block() = buf_to_str(buf_new(65536), 0, 65536)
fn nb_drain(fd, total, idle) = let r = net_recv_some(fd, 65536) in if r.n > 0 then nb_drain(fd, total + r.n, 0) else if r.n == 0 - 2 and idle < 40 then (let s = os_sleep_ms(5) in nb_drain(fd, total, idle + 1)) else total
fn test_send_some_never_blocks_and_epoll_out_resumes() = let l = net_tcp_listen_addr("127.0.0.1", 47814) in let c = net_tcp_connect_addr_timeout("127.0.0.1", 47814, 3000) in let a = net_tcp_accept(l) in let nb = net_set_nonblocking(a, 1) in let t0 = os_monotonic_ns() in let f = nb_fill(a, 0, 4096) in let ms = (os_monotonic_ns() - t0) / 1000000 in let ep = epoll_create_fd() in let ad = epoll_add(ep, a, 7, epoll_out()) in let w1 = epoll_wait_ev(ep, 100) in let nc = net_set_nonblocking(c, 1) in let got = nb_drain(c, 0, 0) in let w2 = epoll_wait_ev(ep, 2000) in let dl = epoll_del(ep, a) in let x1 = net_close(a) in let x2 = net_close(c) in let x3 = net_close(l) in let x4 = net_close(ep) in nb == 1 and f.full == 1 and f.total > 0 and ms < 2000 and ad == 1 and w1.tag == 0 - 1 and got == f.total and w2.tag == 7 and bit_and(w2.events, epoll_out()) == epoll_out() and dl == 1
fn test_recv_some_reports_empty_and_closed() = let l = net_tcp_listen_addr("127.0.0.1", 47815) in let c = net_tcp_connect_addr_timeout("127.0.0.1", 47815, 3000) in let a = net_tcp_accept(l) in let nb = net_set_nonblocking(a, 1) in let e = net_recv_some(a, 16) in let s = net_send_some(c, "hi") in let w = os_sleep_ms(50) in let r = net_recv_some(a, 16) in let x1 = net_close(c) in let w2 = os_sleep_ms(50) in let z = net_recv_some(a, 16) in let x2 = net_close(a) in let x3 = net_close(l) in nb == 1 and e.n == 0 - 2 and s == 2 and r.n == 2 and r.data == "hi" and z.n == 0
fn test_epoll_in_with_tags() = let l = net_tcp_listen_addr("127.0.0.1", 47816) in let c = net_tcp_connect_addr_timeout("127.0.0.1", 47816, 3000) in let a = net_tcp_accept(l) in let ep = epoll_create_fd() in let ad = epoll_add(ep, a, 42, epoll_in()) in let w0 = epoll_wait_ev(ep, 50) in let s = net_send_some(c, "x") in let w1 = epoll_wait_ev(ep, 2000) in let md = epoll_mod(ep, a, 43, bit_or(epoll_in(), epoll_out())) in let w2 = epoll_wait_ev(ep, 2000) in let x1 = net_close(a) in let x2 = net_close(c) in let x3 = net_close(l) in let x4 = net_close(ep) in ad == 1 and w0.tag == 0 - 1 and s == 1 and w1.tag == 42 and bit_and(w1.events, epoll_in()) == 1 and md == 1 and w2.tag == 43
fn test_send_some_on_a_bad_socket() = net_send_some(0 - 1, "x") == 0 - 1 and net_send_some(0 - 1, "") == 0 and epoll_add(0 - 1, 0 - 1, 1, epoll_in()) == 0
