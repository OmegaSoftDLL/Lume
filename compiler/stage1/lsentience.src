## --- 12g. Omniscient Universal Reverse-Engineering, Disassembler & Decompiler (`lume reverse-engineer`, `lume reveng`, `lume decompile`) ---
## Dissects ELF64, Windows PE64/DLL/SYS/UEFI, Mach-O, WASM, BIOS/MBR ROMs, Kernel images, and AI weights;
## decodes machine opcodes (x86-64/ARM64/RISC-V), reconstructs CFG & SSA LumeMIR, and decompiles to QF_LIA-proven Lume-Core.

fn rev_read_u16_le(path, off) = let b0 = fs_read_byte(path, off) in let b1 = fs_read_byte(path, off + 1) in if b0 < 0 or b1 < 0 then 0 else b0 + b1 * 256

fn rev_read_u32_le(path, off) = let lo = rev_read_u16_le(path, off) in let hi = rev_read_u16_le(path, off + 2) in lo + hi * 65536

fn rev_parse_headers(path, b0, b1, b2, b3) = if b0 == 127 and b1 == 69 and b2 == 76 and b3 == 70 then let etype = rev_read_u16_le(path, 16) in let emach = rev_read_u16_le(path, 18) in let eentry = rev_read_u32_le(path, 24) in let ephoff = rev_read_u32_le(path, 32) in {code_off: 120, arch_code: emach, entry_addr: eentry, hdr_offset: ephoff, bin_subtype: etype} else if b0 == 77 and b1 == 90 then let lfanew = rev_read_u32_le(path, 60) in let pemach = if lfanew > 0 and lfanew < 4096 then rev_read_u16_le(path, lfanew + 4) else 34404 in let peentry = if lfanew > 0 and lfanew < 4096 then rev_read_u32_le(path, lfanew + 40) else 4096 in {code_off: 512, arch_code: pemach, entry_addr: peentry, hdr_offset: lfanew, bin_subtype: 2} else {code_off: 0, arch_code: 62, entry_addr: 0, hdr_offset: 0, bin_subtype: 1}

fn rev_scan_opcodes(path, i, limit, acc) = if i >= limit then acc else let b0 = fs_read_byte(path, i) in if b0 < 0 then acc else let b1 = fs_read_byte(path, i + 1) in let p2 = if (b0 == 85 and b1 == 72) or (b0 == 65 and (b1 == 87 or b1 == 86 or b1 == 85 or b1 == 84)) then acc.prologues + 1 else acc.prologues in let m2 = if b0 == 72 and (b1 == 137 or b1 == 139) then acc.movs + 1 else acc.movs in let s2 = if b0 == 15 and b1 == 5 then acc.syscalls + 1 else acc.syscalls in let c2 = if b0 == 232 then acc.calls + 1 else acc.calls in let br2 = if b0 == 116 or b0 == 117 or b0 == 235 or (b0 == 15 and (b1 == 132 or b1 == 133)) then acc.branches + 1 else acc.branches in let r2 = if b0 == 195 then acc.rets + 1 else acc.rets in rev_scan_opcodes(path, i + 1, limit, {prologues: p2, movs: m2, syscalls: s2, calls: c2, branches: br2, rets: r2})

fn rev_classify_magic(b0, b1, b2, b3) = if b0 == 127 and b1 == 69 and b2 == 76 and b3 == 70 then "ELF64-Native-Binary (Linux/BSD/SystemV-ABI)" else if b0 == 77 and b1 == 90 then "PE64-MZ-Executable-or-UEFI-or-NT-Kernel (Windows/UEFI)" else if b0 == 0 and b1 == 97 and b2 == 115 and b3 == 109 then "WASM32-Bytecode-Module" else if (b0 == 207 and b1 == 250) or (b0 == 254 and b1 == 237) then "Mach-O-64-Binary (macOS/iOS)" else "Source-AST-or-Raw-Firmware-Image"

