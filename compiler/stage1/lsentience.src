fn hive_krum_consensus(g_honest1, g_honest2, g_honest3, g_byzantine) = let d12 = deq_abs(g_honest1 - g_honest2) in let d13 = deq_abs(g_honest1 - g_honest3) in let d1b = deq_abs(g_honest1 - g_byzantine) in let byzantine_rejected = if d1b > d12 + d13 then 1 else 0 in {consensus_grad: (g_honest1 + g_honest2 + g_honest3) / 3, byzantine_rejected: byzantine_rejected}

