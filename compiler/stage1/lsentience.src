fn test_wave10_proactive_memory_and_instant_recall() =
    let sample_jsonl = "{\"episode\":1,\"laws\":5,\"rewrites\":12,\"phi_delta\":100}\n{\"episode\":2,\"laws\":7,\"rewrites\":8,\"phi_delta\":250}\n" in
    let fast_st = mem_scan_jsonl_fast(sample_jsonl, 0, count(sample_jsonl), 0, 0, 0) in
    let t_src = "law proactive_mem_law(x: int) = x + 1 > x\nfn proactive_fn(x: int) -> int requires x >= 0 ensures result >= 0 = x\n" in
    let t_cid = lc_sha256("prove-v1\n" + t_src) in
    let st = mem_proactive_store("prove", t_cid, t_src, "{\"ok\":true,\"proactive_cached\":true}") in
    let lk = mem_proactive_lookup("prove", t_cid) in
    let lk_cross_chk = mem_proactive_lookup("check", lc_sha256(t_src)) in
    let rj = sentience_recall_json(t_src) in
    let oj = sentience_orchestrate_json(t_src) in
    let bad_write = fs_write_sync(lk.path, "{\"ok\":false,\"tampered\":true}") in
    let lk_tampered = mem_proactive_lookup("prove", t_cid) in
    let st2 = mem_proactive_store("prove", t_cid, t_src, "{\"ok\":true,\"proactive_cached\":true}") in
    let m1 = mem_record_learning("proactive-dedup-test", t_cid, 3, 2, 64) in
    let m2 = mem_record_learning("proactive-dedup-test", t_cid, 3, 2, 64) in
    let adv = mem_proactive_diag_advice("lume: wcet budget error [V0002]: function 'f'") in
    if fast_st.laws == 12 and fast_st.rewrites == 20 and fast_st.phi == 350 and lk.hit == 1 and lk_cross_chk.hit == 1 and lk_tampered.hit == 0 and lk_tampered.tampered_purged == 1 and m2.already_known == 1 and m2.episodes_learned == m1.episodes_learned and sn_contains(rj, "\"anti_tamper_sha256_seal_verified\":true") == 1 and sn_contains(oj, "\"mode\":\"synapse-orchestrate\"") == 1 and sn_contains(adv, "[V0002]") == 1 and fs_path_exists(mem_proactive_diag_path()) == 1 then 1 else 0

