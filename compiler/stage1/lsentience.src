/bios_vendor\",\"/sys/class/dmi/id/bios_version\",\"/sys/firmware/acpi\",\"/sys/firmware/efi\",\"/proc/cpuinfo\",\"/proc/iomem\",\"/proc/ioports\",\"/proc/kallsyms\",\"/proc/interrupts\",\"/proc/modules\"],\"active_interfaces_found\":" + str(bc.linux_ring0_interfaces) + "},\"windows_nt_kernel_core\":{\"binaries_probed\":[\"ntoskrnl.exe\",\"hal.dll\",\"winload.efi\",\"bcdedit.exe\",\"driverquery.exe\",\"pnputil.exe\",\"fltmc.exe\",\"sc.exe\"],\"active_binaries_found\":" + str(bc.windows_nt_kernel_binaries) + ",\"ntoskrnl_pe64_mz_header_verified\":" + (if bc.ntoskrnl_mz_verified == 1 then "true" else "false") + "},\"custom_os_and_bios_synthesis_ready\":{\"mbr_longmode_kernel_image\":true,\"uefi_bootx64_efi_image\":true,\"bootable_iso9660_image\":true,\"freestanding_ring0_capabilities\":[\"port_in8\",\"port_out8\",\"cpu_cli\",\"cpu_sti\",\"cpu_read_cr3\",\"cpu_write_cr3\",\"cpu_invlpg\",\"cpu_idt_init\",\"cpu_smp_boot_ap\",\"mmio_volatile_read64\",\"mmio_volatile_write64\"]},\"memory_episodes_learned\":" + str(mem.episodes_learned) + ",\"capsule_cid\":\"" + cap.cid + "\"}"

