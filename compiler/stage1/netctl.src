## netctl.src -- a TCP connect with a deadline and socket options, written in Lume (`use netctl`).
##
## net_tcp_connect_addr_timeout(ip, port, ms) -> the connected socket, or -1 when the address is not an IPv4/IPv6
##     literal, the port is outside 0..65535, the peer refuses, the network is unreachable, or nothing answers
##     within ms milliseconds (a silent host costs ms, not the kernel's two minutes)
## net_tcp_nodelay(fd, on) -> 1 when TCP_NODELAY was set (on != 0) or cleared (on == 0), else 0
##
## Built on the compiler primitives sys_call and buf_addr (Linux call numbers; the Windows runtime answers the same
## numbers): socket, fcntl O_NONBLOCK, connect (EINPROGRESS), poll for POLLOUT within ms, getsockopt SO_ERROR, and
## the blocking mode restored, so the socket works with net_send_str / net_recv_str as one from net_tcp_connect_addr.

fn nc_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => nc_rev(t, Cons(h, acc))
fn nc_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + nc_len(t)
fn nc_isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn nc_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, nc_app(t, ys))
fn nc_zeros(n) = if n <= 0 then Nil else Cons(0, nc_zeros(n - 1))
fn nc_has(s, c) = nc_find(s, c, 0) >= 0
fn nc_find(s, c, i) = if i >= count(s) then 0 - 1 else if at(s, i) == c then i else nc_find(s, c, i + 1)
fn nc_find2(s, i) = if i + 1 >= count(s) then 0 - 1 else if at(s, i) == ":" and at(s, i + 1) == ":" then i else nc_find2(s, i + 1)
## every piece of s between the separator characters (empty pieces kept)
fn nc_split(s, sep, i, start, acc) = if i >= count(s) then nc_rev(Cons(slice(s, start, count(s)), acc), Nil) else if at(s, i) == sep then nc_split(s, sep, i + 1, i + 1, Cons(slice(s, start, i), acc)) else nc_split(s, sep, i + 1, start, acc)

## --- address literals -> bytes (network order) ---
fn nc_dec(s, i, acc) = if i >= count(s) then acc else let c = at(s, i) in if c >= "0" and c <= "9" then nc_dec(s, i + 1, acc * 10 + ord(c) - 48) else 0 - 1
fn nc_octet(s) = if count(s) == 0 or count(s) > 3 then 0 - 1 else let v = nc_dec(s, 0, 0) in if v > 255 then 0 - 1 else v
fn nc_v4_bytes(ps, acc) = match ps
    Nil        => nc_rev(acc, Nil)
    Cons(h, t) => let v = nc_octet(h) in if v < 0 then Nil else nc_v4_bytes(t, Cons(v, acc))
## "a.b.c.d" -> its 4 bytes, or Nil
fn nc_v4(s) = let ps = nc_split(s, ".", 0, 0, Nil) in if nc_len(ps) != 4 then Nil else nc_v4_bytes(ps, Nil)
fn nc_hexv(c) = if c >= "0" and c <= "9" then ord(c) - 48 else if c >= "a" and c <= "f" then ord(c) - 87 else if c >= "A" and c <= "F" then ord(c) - 55 else 0 - 1
fn nc_hex16(s, i, acc) = if i >= count(s) then acc else let v = nc_hexv(at(s, i)) in if v < 0 then 0 - 1 else nc_hex16(s, i + 1, acc * 16 + v)
fn nc_group(s) = if count(s) == 0 or count(s) > 4 then 0 - 1 else nc_hex16(s, 0, 0)
fn nc_push_all(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => nc_push_all(t, Cons(h, acc))
## colon-separated 16-bit groups -> bytes; the last piece may be a dotted IPv4 (4 bytes) when v4_last == 1
fn nc_groups(ps, acc, v4_last) = match ps
    Nil        => {ok: 1, bytes: nc_rev(acc, Nil)}
    Cons(h, t) => if v4_last == 1 and nc_isnil(t) == 1 and nc_has(h, ".") then (let v = nc_v4(h) in if nc_isnil(v) == 1 then {ok: 0, bytes: Nil} else nc_groups(t, nc_push_all(v, acc), v4_last)) else let g = nc_group(h) in if g < 0 then {ok: 0, bytes: Nil} else nc_groups(t, Cons(g % 256, Cons(g / 256, acc)), v4_last)
fn nc_part(s, v4_last) = if s == "" then {ok: 1, bytes: Nil} else nc_groups(nc_split(s, ":", 0, 0, Nil), Nil, v4_last)
## an IPv6 literal (with at most one "::", optionally ending in a dotted IPv4) -> its 16 bytes, or Nil
fn nc_v6(s) = let k = nc_find2(s, 0) in if k < 0 then (let r = nc_part(s, 1) in if r.ok == 1 and nc_len(r.bytes) == 16 then r.bytes else Nil) else let tl = slice(s, k + 2, count(s)) in if nc_find2(tl, 0) >= 0 then Nil else let a = nc_part(slice(s, 0, k), 0) in let b = nc_part(tl, 1) in if a.ok == 0 or b.ok == 0 or nc_len(a.bytes) + nc_len(b.bytes) > 14 then Nil else nc_app(a.bytes, nc_app(nc_zeros(16 - nc_len(a.bytes) - nc_len(b.bytes)), b.bytes))

## --- the structures of the calls, in buffers ---
fn nc_put(b, i, xs) = match xs
    Nil        => b
    Cons(h, t) => let w = buf_set(b, i, h) in nc_put(b, i + 1, t)
fn nc_le32(v) = Cons(v % 256, Cons((v / 256) % 256, Cons((v / 65536) % 256, Cons((v / 16777216) % 256, Nil))))
fn nc_get32(b) = buf_get(b, 0) + 256 * buf_get(b, 1) + 65536 * buf_get(b, 2) + 16777216 * buf_get(b, 3)
## sockaddr_in (family 2, 16 bytes) or sockaddr_in6 (family 10, 28 bytes), the port in network order
fn nc_sockaddr(ip, port) = if port < 0 or port > 65535 then {ok: 0, fam: 0, len: 0, buf: buf_new(1)} else if nc_has(ip, ":") then (let a = nc_v6(ip) in if nc_isnil(a) == 1 then {ok: 0, fam: 0, len: 0, buf: buf_new(1)} else {ok: 1, fam: 10, len: 28, buf: nc_put(buf_new(28), 0, nc_app(Cons(10, Cons(0, Cons(port / 256, Cons(port % 256, nc_zeros(4))))), nc_app(a, nc_zeros(4))))}) else let a = nc_v4(ip) in if nc_isnil(a) == 1 then {ok: 0, fam: 0, len: 0, buf: buf_new(1)} else {ok: 1, fam: 2, len: 16, buf: nc_put(buf_new(16), 0, nc_app(Cons(2, Cons(0, Cons(port / 256, Cons(port % 256, Nil)))), nc_app(a, nc_zeros(8))))}

## --- the calls (Linux numbers: close 3, poll 7, socket 41, connect 42, setsockopt 54, getsockopt 55, fcntl 72) ---
fn nc_close(fd) = sys_call(3, fd, 0, 0, 0, 0)
## SO_ERROR of the socket is 0: the connection is established
fn nc_soerr_ok(fd) = let v = nc_put(buf_new(4), 0, nc_le32(0)) in let l = nc_put(buf_new(4), 0, nc_le32(4)) in let r = sys_call(55, fd, 1, 4, buf_addr(v), buf_addr(l)) in if r == 0 and nc_get32(v) == 0 then 1 else 0
## wait for the socket to become writable (POLLOUT) within ms; an interrupted wait starts again
fn nc_wait(fd, ms) = let pb = nc_put(buf_new(8), 0, nc_app(nc_le32(fd), Cons(4, Cons(0, Cons(0, Cons(0, Nil)))))) in let r = sys_call(7, buf_addr(pb), 1, ms, 0, 0) in if r == 0 - 4 then nc_wait(fd, ms) else if r <= 0 then 0 else nc_soerr_ok(fd)
## non-blocking connect, wait, blocking mode back: 1 when connected
fn nc_connect(fd, sa, ms) = let fl = sys_call(72, fd, 3, 0, 0, 0) in if fl < 0 then 0 else let s1 = sys_call(72, fd, 4, bit_or(fl, 2048), 0, 0) in if s1 < 0 then 0 else let c = sys_call(42, fd, buf_addr(sa.buf), sa.len, 0, 0) in let ok = if c == 0 then 1 else if c == 0 - 115 or c == 0 - 11 then nc_wait(fd, ms) else 0 in let r = sys_call(72, fd, 4, fl, 0, 0) in if ok == 1 and r >= 0 then 1 else 0
fn net_tcp_connect_addr_timeout(ip, port, ms) = let sa = nc_sockaddr(ip, port) in if sa.ok == 0 or ms < 0 then 0 - 1 else let fd = sys_call(41, sa.fam, 1, 0, 0, 0) in if fd < 0 then 0 - 1 else if nc_connect(fd, sa, ms) == 1 then fd else let z = nc_close(fd) in 0 - 1
## TCP_NODELAY (IPPROTO_TCP 6, option 1)
fn net_tcp_nodelay(fd, on) = let v = nc_put(buf_new(4), 0, nc_le32(if on != 0 then 1 else 0)) in if sys_call(54, fd, 6, 1, buf_addr(v), 4) == 0 then 1 else 0
