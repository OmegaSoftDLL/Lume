## compiler/stage1/capsule_ok.src -- Conformance tests for capability-sealed capsules (#430)
use capsule

fn test_capsule_seal_and_open() = let c = capsule_seal("tenant_ledger", "db", "balance=4200") in let v = capsule_verify(c) in let ok_open = capsule_open(c, "db") in let bad_cap = capsule_open(c, "pure") in let tampered = {magic: c.magic, name: c.name, cap_grant: c.cap_grant, payload: "balance=999999", digest: c.digest} in let bad_tamper = capsule_open(tampered, "db") in let ser = cap_serialize(c) in let deser = cap_deserialize(ser) in let reb = capsule_rebind(c, "db", "balance=4300") in if v == 1 and ok_open.ok == 1 and ok_open.value == "balance=4200" and bad_cap.ok == 0 and bad_tamper.ok == 0 and capsule_verify(deser) == 1 and reb.ok == 1 and capsule_verify(reb.cap) == 1 then 1 else 0

fn test_capsule_deterministic_replay() = let p = capsule_seal_proven("rtc_step", "io", "state=tick42", 42, 1337, "sha256:deedbeef") in let vp = capsule_verify_proven(p) in let rep_ok = capsule_replay(p, "io", 42, 1337) in let rep_bad_tick = capsule_replay(p, "io", 43, 1337) in let rep_bad_seed = capsule_replay(p, "io", 42, 9999) in let rep_bad_cap = capsule_replay(p, "db", 42, 1337) in if vp == 1 and rep_ok.ok == 1 and rep_ok.value == "state=tick42" and rep_ok.next_tick == 43 and rep_ok.next_seed == capsule_prng_step(1337) and rep_bad_tick.ok == 0 and rep_bad_seed.ok == 0 and rep_bad_cap.ok == 0 then 1 else 0

fn test_capsule_v2_bundle_vcr_and_replay() = let src = "fn fee(x: int) -> int requires x >= 0 ensures result >= 1 = 4 * x + 1\nprint fee(10)\n" in let b = capsule_bundle_create2("audit_2036", "pure", src, "", "41\n", 100) in let enc = capsule_bundle_encode(b) in let dec = capsule_bundle_decode(enc) in let v_ok = capsule_bundle_verify(dec) in let rep_ok = capsule_bundle_replay(dec, "41\n", 1) in let rep_bad_out = capsule_bundle_replay(dec, "42\n", 1) in let rep_bad_cert = capsule_bundle_replay(dec, "41\n", 0) in let vcr = capsule_vcr_entry("net", "GET /rate", "105") + "\n" in let vcr_hit = capsule_vcr_lookup(vcr, "net", "GET /rate") in if v_ok.ok == 1 and rep_ok.ok == 1 and rep_ok.next_tick == 101 and rep_bad_out.ok == 0 and rep_bad_cert.ok == 0 and vcr_hit == "105" then 1 else 0

print test_capsule_seal_and_open() * test_capsule_deterministic_replay() * test_capsule_v2_bundle_vcr_and_replay()
