## lumec.src -- the self-hosted Lume compiler in ONE Lume-Core file (self-hosting R6): lex -> parse ->
## x86-64 codegen, written in the functional core (recursion, immutable records, match, let-in, if;
## no var/mut/while/for). Compiled to native by data_asm_cc and assembled by lume0 asm, no C anywhere.
## The lexer/parser are copied verbatim from lcparse.src (R5); the code generator is the functional port
## of lcgen.lume (R6a, R6b, R6-match). Scope: fn / print / top-level expression statements over Num/Var/Bin/Call/If/LetIn plus Str/Rec/Field, match and
## constructors (R6b). `match` is only a whole function/let/print/expression-statement body (see "parser: match"). The driver reads the whole program from stdin, compiles it, and prints the resulting asm.

## --- lexer ---
fn isdigit(c) = c >= "0" and c <= "9"
fn isalpha(c) = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
fn isalnum(c) = isdigit(c) or isalpha(c)
fn idend(s, n, i) = if i < n and isalnum(at(s, i)) then idend(s, n, i + 1) else i
## End of a `##` comment: the index of the newline (or EOF) that terminates the line starting at i.
fn lineend(s, n, i) = if i >= n or at(s, i) == "\n" then i else lineend(s, n, i + 1)
fn numendn(s, n, i) requires i >= 0 ensures result >= i = if i < n and isdigit(at(s, i)) then numendn(s, n, i + 1) else i
fn decimalendn(s, n, i) requires i >= 0 ensures result >= i = let j = numendn(s, n, i) in if j + 1 < n and at(s, j) == "." and isdigit(at(s, j + 1)) then numendn(s, n, j + 1) else j
fn numend(s, i) requires i >= 0 ensures result >= i = numendn(s, count(s), i)
fn decimalend(s, i) requires i >= 0 ensures result >= i = decimalendn(s, count(s), i)
fn decscan(s, i, coefficient, scale, past, digits) requires i >= 0 requires scale >= 0 requires digits >= 0 ensures result.scale >= scale = if i >= count(s) then {coefficient: coefficient, scale: scale} else if at(s, i) == "." then decscan(s, i + 1, coefficient, scale, 1, digits) else let digit = toint(at(s, i)) in if past == 1 and scale >= 18 then ctfail("lume: decimal scale exceeds the 18 digit limit\n") else if coefficient == 0 and digit == 0 then decscan(s, i + 1, 0, scale + past, past, digits) else if digits >= 18 then ctfail("lume: decimal coefficient exceeds the 18 digit limit\n") else decscan(s, i + 1, coefficient * 10 + digit, scale + past, past, digits + 1)
fn decnode(s, negative) = let d = decscan(s, 0, 0, 0, 0, 0) in Rec(Cons({key: "coefficient", val: Num(if negative then 0 - d.coefficient else d.coefficient)}, Cons({key: "scale", val: Num(d.scale)}, Cons({key: "precision", val: Num(0)}, Nil))))
fn strend(s, n, i) = if i >= n then i else if at(s, i) == "\"" then i + 1 else if at(s, i) == "\\" then strend(s, n, i + 2) else strend(s, n, i + 1)
## String literal value: drop the delimiting quotes and decode \n \t \r (any other \x -> x, so \\ and \" decode to themselves), like the seed lexer.
fn lex_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => lex_rev(t, Cons(h, acc))
fn unesc1(c) = if c == "n" then "\n" else if c == "t" then "\t" else if c == "r" then "\r" else c
fn unescl_acc(s, i, n, acc) = if i >= n then lex_rev(acc, Nil) else if at(s, i) == "\\" and i + 1 < n then unescl_acc(s, i + 2, n, Cons(unesc1(at(s, i + 1)), acc)) else unescl_acc(s, i + 1, n, Cons(at(s, i), acc))
fn unescl(s, i, n) = unescl_acc(s, i, n, Nil)
fn strval(t) = let tn = count(t) in let b = slicen(t, tn, 1, tn - 1) in joinall(own unescl(b, 0, tn - 2))
fn two(s, n, i) = slicen(s, n, i, if i + 2 > n then n else i + 2)
fn istwo(t) = t == "==" or t == "!=" or t == "<=" or t == ">="
fn lexn_acc(s, n, i, ls, acc) = if i >= n then lex_rev(acc, Nil) else let c = at(s, i) in if c == "\n" then lexn_acc(s, n, i + 1, i + 1, acc) else if c == " " or c == "\t" or c == "\r" then lexn_acc(s, n, i + 1, ls, acc) else if c == "#" then let le = lineend(s, n, i) in lexn_acc(s, n, le, le, acc) else if isdigit(c) then let jn = numendn(s, n, i) in let jd = decimalendn(s, n, i) in lexn_acc(s, n, jd, ls, Cons({kind: if jd > jn then "decimal" else "int", text: slicen(s, n, i, jd), col: i - ls}, acc)) else if isalpha(c) then let ji = idend(s, n, i) in lexn_acc(s, n, ji, ls, Cons({kind: "id", text: slicen(s, n, i, ji), col: i - ls}, acc)) else if c == "\"" then let js = strend(s, n, i + 1) in lexn_acc(s, n, js, ls, Cons({kind: "str", text: slicen(s, n, i, js), col: i - ls}, acc)) else if (c == "=" or c == "!" or c == "<" or c == ">") and istwo(two(s, n, i)) then lexn_acc(s, n, i + 2, ls, Cons({kind: "op", text: two(s, n, i), col: i - ls}, acc)) else lexn_acc(s, n, i + 1, ls, Cons({kind: "op", text: c, col: i - ls}, acc))
fn lexn(s, n, i) = lexn_acc(s, n, i, i, Nil)
fn lex(s, i) = lexn(s, count(s), i)

## --- token-list helpers (avoid nested match in expressions) ---
fn headtext(ts) = match ts
    Nil        => ""
    Cons(h, t) => h.text
fn headkind(ts) = match ts
    Nil        => ""
    Cons(h, t) => h.kind
fn headcol(ts) = match ts
    Nil        => 0 - 1
    Cons(h, t) => h.col
fn decimalhead(ts) = match ts
    Nil        => false
    Cons(h, t) => h.kind == "decimal"
fn droponce(ts) = match ts
    Nil        => Nil
    Cons(h, t) => t
fn skiprp(ts) = if headtext(ts) == ")" then droponce(ts) else ts
fn skiprb(ts) = if headtext(ts) == "}" then droponce(ts) else ts
fn isrecbody(ts) = headtext(ts) == "}" or headtext(droponce(ts)) == ":"
fn isrecwith(ts) = headtext(ts) != "}" and headtext(droponce(ts)) == "with"
fn dropin(ts) = if headtext(ts) == "in" or headtext(ts) == ";" then droponce(ts) else ts
fn recentries(ts) = if headtext(ts) == "}" then {items: Nil, rest: droponce(ts)} else recmore(headtext(ts), expr(dropkw(droponce(ts), ":")))
fn recmore(k, rv) = if headtext(rv.rest) == "," then let rr = recentries(droponce(rv.rest)) in {items: Cons({key: k, val: rv.node}, rr.items), rest: rr.rest} else {items: Cons({key: k, val: rv.node}, Nil), rest: skiprb(rv.rest)}
fn dropkw(ts, kw) = if headtext(ts) == kw then droponce(ts) else ts
## F4 (front-end unification): `if c then t elif c2 then t2 ... else e` is the surface's chained-if form; it
## desugars to the core's nested `If` AST (`elif X` == `else if X`). The plain `else` path is byte-identical to
## before, so lumec.src (which uses `else if`, never `elif`) parses unchanged and the self-host fixpoint holds.
fn parseif(t) = parseifcore(t)
## Fail closed on doubled/misplaced branch keywords (#428): `else else` (the #417 port-bug shape:
## the first `else` was silently dropped and the second parsed as a variable, so `lume check`
## passed and the binary segfaulted), `then then`, and the analogous `else elif`/`else then` are
## rejected here with a clear [P0002] diagnostic instead of producing garbage AST. A branch
## keyword can never legitimately start a branch expression, so this has no false positives on
## well-formed programs (string literals keep their quotes in the token text and cannot collide).
fn parseifcore(t) = let rc = expr(t) in let after_then = dropkw(rc.rest, "then") in if headtext(after_then) == "then" or headtext(after_then) == "else" or headtext(after_then) == "elif" then ctfail("lume: parse error [P0002]: branch keyword '" + headtext(after_then) + "' cannot start the then-branch of an if (found a duplicated '" + headtext(after_then) + "'; write the branch expression right after 'then')\n") else let tb = expr(after_then) in if headtext(tb.rest) == "then" then ctfail("lume: parse error [P0002]: duplicated 'then' after the then-branch of an if (write 'else if <cond> then <expr>' or 'elif <cond> then <expr>' for chained branches)\n") else parseifelse(rc.node, tb.node, dropkw(tb.rest, ";"))
fn parseifelse(c, tb, rest) = if headtext(rest) == "elif" then parseifelif(c, tb, parseifcore(droponce(rest))) else if headtext(rest) == "else" and (headtext(droponce(rest)) == "else" or headtext(droponce(rest)) == "elif" or headtext(droponce(rest)) == "then") then ctfail("lume: parse error [P0002]: 'else' cannot be followed by '" + headtext(droponce(rest)) + "' (found a duplicated or misplaced branch keyword; write 'else if <cond> then <expr>' or 'elif <cond> then <expr>')\n") else parseifplain(c, tb, expr(dropkw(rest, "else")))
fn parseifelif(c, tb, r) = {node: If(c, tb, r.node), rest: r.rest}
fn parseifplain(c, tb, eb) = {node: If(c, tb, eb.node), rest: eb.rest}
fn dropletty(ts) = if headtext(ts) == ":" then (parsetype1(droponce(ts))).rest else ts
fn parsetupletids(ts) = if headtext(ts) == ")" then {items: Nil, rest: droponce(ts)} else let nm = headtext(ts) in let t1 = dropletty(droponce(ts)) in if headtext(t1) == "," then let rr = parsetupletids(droponce(t1)) in {items: Cons(nm, rr.items), rest: rr.rest} else {items: Cons(nm, Nil), rest: skiprp(t1)}
fn mktupletbinds(tnm, ids, idx, body) = match ids
    Nil        => body
    Cons(h, t) => if h == "_" then mktupletbinds(tnm, t, idx + 1, body) else LetIn(h, Field(Var(tnm), "_" + str(idx)), mktupletbinds(tnm, t, idx + 1, body))
fn lettuphd(xs) = match xs
    Nil        => "0"
    Cons(h, t) => if h == "_" then "0" else h
fn parselettup(t) = let ids = parsetupletids(t) in let rv = expr(dropkw(dropletty(ids.rest), "=")) in let rb = expr(dropin(rv.rest)) in let tnm = "_ltup_" + lettuphd(ids.items) in {node: LetIn(tnm, rv.node, mktupletbinds(tnm, ids.items, 0, rb.node)), rest: rb.rest}
fn parserecletfields(ts) = if headtext(ts) == "}" then {items: Nil, rest: droponce(ts)} else let fnm = headtext(ts) in let t1 = droponce(ts) in let bnm = if headtext(t1) == ":" then headtext(droponce(t1)) else fnm in let t2 = if headtext(t1) == ":" then droponce(droponce(t1)) else t1 in let t3 = dropletty(t2) in if headtext(t3) == "," then let rr = parserecletfields(droponce(t3)) in {items: Cons({key: fnm, nm: bnm}, rr.items), rest: rr.rest} else {items: Cons({key: fnm, nm: bnm}, Nil), rest: skiprb(t3)}
fn mkrecletbinds(tnm, fs, body) = match fs
    Nil        => body
    Cons(h, t) => if h.nm == "_" then mkrecletbinds(tnm, t, body) else LetIn(h.nm, Field(Var(tnm), h.key), mkrecletbinds(tnm, t, body))
fn letrechd(xs) = match xs
    Nil        => "0"
    Cons(h, t) => if h.nm == "_" then "0" else h.nm
fn parseletrec(t) = let fs = parserecletfields(t) in let rv = expr(dropkw(dropletty(fs.rest), "=")) in let rb = expr(dropin(rv.rest)) in let tnm = "_lrec_" + letrechd(fs.items) in {node: LetIn(tnm, rv.node, mkrecletbinds(tnm, fs.items, rb.node)), rest: rb.rest}
fn parseletpat(t) = let p = parsepat(t) in let rv = expr(dropkw(dropletty(p.rest), "=")) in let rb = expr(dropin(rv.rest)) in {node: Match(rv.node, Cons({pat: p.node, body: rb.node}, Nil)), rest: rb.rest}
fn parselet(t) = if headtext(t) == "mut" then parsevar(droponce(t)) else if headtext(t) == "(" then parselettup(droponce(t)) else if headtext(t) == "{" then parseletrec(droponce(t)) else if isctor(headtext(t)) == 1 then parseletpat(t) else if headtext(t) == "_" and headtext(droponce(t)) != "=" and headtext(droponce(t)) != ":" then parselet(droponce(t)) else let nm = headtext(t) in let rv = expr(dropkw(dropletty(droponce(t)), "=")) in let rb = expr(dropin(rv.rest)) in {node: LetIn(nm, rv.node, rb.node), rest: rb.rest}
fn parsevar(t) = let nm = headtext(t) in let rv = expr(dropkw(dropletty(droponce(t)), "=")) in let rb = expr(dropin(rv.rest)) in {node: VarIn(nm, rv.node, rb.node), rest: rb.rest}
fn parseowne(t) = let r = post(t) in {node: OwnE(r.node), rest: r.rest}
fn parsemute(t) = let r = post(t) in {node: MutE(r.node), rest: r.rest}
fn parsedefer(t) = let rc = expr(t) in let rb = expr(dropin(rc.rest)) in {node: DeferE(rc.node, rb.node), rest: rb.rest}
fn parseerrdefer(t) = let rc = expr(t) in let rb = expr(dropin(rc.rest)) in {node: ErrDeferE(rc.node, rb.node), rest: rb.rest}
fn parsehop(ts) = let opnm = headtext(droponce(ts)) in let ps = parseparams(dropkw(droponce(droponce(ts)), "(")) in let rt = parseret(ps.rest) in let b = expr(dropkw(rt.rest, "=")) in {op: {op: opnm, ps: ps.items, body: b.node}, rest: dropkw(b.rest, ";")}
fn parsehops(ts) = if headtext(ts) == "fn" then let r = parsehop(ts) in let rr = parsehops(r.rest) in {items: Cons(r.op, rr.items), rest: rr.rest} else {items: Nil, rest: ts}
fn parsewithhandler(t) = let enm = headtext(t) in let hs = parsehops(dropkw(droponce(t), "{")) in let rb = expr(dropin(skiprb(hs.rest))) in {node: WithHandlerE(enm, hs.items, rb.node), rest: rb.rest}
fn parsewith(t) = if headtext(t) == "alloc" then let ra = expr(dropkw(droponce(t), "=")) in let rb = expr(dropin(ra.rest)) in {node: WithAllocE(ra.node, rb.node), rest: rb.rest} else if headtext(t) == "handler" then parsewithhandler(droponce(t)) else expr(t)
fn parsescope(t) = if headtext(droponce(t)) == "in" or headtext(droponce(t)) == ";" or headtext(droponce(t)) == "{" then (let snm = headtext(t) in let t1 = droponce(t) in let hb = if headtext(t1) == "{" then 1 else 0 in let rb = expr(if hb == 1 then droponce(t1) else dropin(t1)) in {node: ScopeE(snm, rb.node), rest: if hb == 1 then skiprb(rb.rest) else rb.rest}) else let hb = if headtext(t) == "{" then 1 else 0 in let rb = expr(if hb == 1 then droponce(t) else dropin(t)) in {node: ScopeE("_scope", rb.node), rest: if hb == 1 then skiprb(rb.rest) else rb.rest}
fn parsespawn(t) = if headtext(t) == "(" then let a = arglist(droponce(t)) in {node: SpawnE(ohd_e(a.items)), rest: a.rest} else let r = expr(t) in {node: SpawnE(r.node), rest: r.rest}
fn postdotcall(nd, mnm, a) = match nd
    Var(enm) => if isctor(enm) == 1 then {node: Call(mnm, a.items), rest: a.rest} else {node: Call(mnm, Cons(nd, a.items)), rest: a.rest}
    _        => {node: Call(mnm, Cons(nd, a.items)), rest: a.rest}
fn is_lambda_nd(nd) = match nd
    LambdaE(ps, tys, rt, b) => 1
    _                       => 0
fn postloop(r) = if headtext(r.rest) == "." and headtext(droponce(r.rest)) != "." then (let t1 = droponce(r.rest) in let mnm = headtext(t1) in let t2 = droponce(t1) in if headtext(t2) == "(" then postloop(postdotcall(r.node, mnm, arglist(droponce(t2)))) else if mnm == "await" then postloop({node: AwaitE(r.node), rest: t2}) else postloop({node: Field(r.node, mnm), rest: t2})) else if headtext(r.rest) == "(" and is_lambda_nd(r.node) == 1 then (let a = arglist(droponce(r.rest)) in postloop({node: Call("_call", Cons(r.node, a.items)), rest: a.rest})) else r
fn post(ts) = postloop(prim(ts))

