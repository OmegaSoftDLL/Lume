## --- parser: programs (fn definitions, print statements, and bare expression statements) ---
## A statement is `fn ...`, `print <expr>`, or a bare `<expr>` evaluated for its effect (value discarded).
## `fn`/`print` are dispatched by keyword; anything else begins an expression statement. The program is a
## sequence of statements up to end of input (the `Nil` arm stops the recursion). Each top-level `<expr>` must
## consume at least one token (prim always advances on a non-empty stream), so progmore cannot loop forever.
## F2: a parameter may carry an optional annotation `name: T` and the signature an optional `-> R` (T as in F1:
## `int`, `str`, a declared name, `[T]`, or D1's `decimal(p, s)`). `items` are the bare names (so `Fn(nm, ps, body)` is UNCHANGED and the
## codegen never sees a type); `tys` is the parallel list of annotations, `TyAny` where a parameter has none.
## C3: a parameter may be prefixed `comptime` (a Zig-style comptime type parameter: `fn id(comptime T: type, x: T)`).
## The params record now also carries `plist` = one {cf, pn, pt} per parameter in source order (cf=1 iff it is a
## comptime parameter, pn its name, pt its type expression), while `items` holds ONLY the RUNTIME parameter names.
## So `Fn(nm, items, body)` is byte-identical for a comptime-free function (no comptime param => every cf=0 =>
## items == all names => exactly the pre-C3 AST, so the self-host fixpoint is untouched); the comptime params are
## recorded in a separate `GSig` statement (like F2's `Sig`), never in `Fn`, so codegen never sees an erased param.
fn parseparams(ts) = if headtext(ts) == ")" then {items: Nil, tys: Nil, plist: Nil, rest: droponce(ts)} else parseparamk(ts)
fn parseparamk(ts) = if headtext(ts) == "comptime" then parseparam(headtext(droponce(ts)), 1, droponce(droponce(ts))) else if headtext(ts) == "own" then parseparam(headtext(droponce(ts)), 2, droponce(droponce(ts))) else if headtext(ts) == "mut" then parseparam(headtext(droponce(ts)), 3, droponce(droponce(ts))) else parseparam(headtext(ts), 0, droponce(ts))
fn parseparam(nm, ct, ts) = if headtext(ts) == ":" then parseparamt(nm, ct, parsetype1(droponce(ts))) else parammore(nm, TyAny, ct, ts)
fn parseparamt(nm, ct, r) = if headtext(r.rest) == "where" then (let pr = expr(droponce(r.rest)) in parammore(nm, TyRefine(r.node, pr.node), ct, pr.rest)) else parammore(nm, r.node, ct, r.rest)
fn parammore(nm, ty, ct, ts) = if headtext(ts) == "," then parammcons(nm, ty, ct, parseparams(droponce(ts))) else parammend(nm, ty, ct, skiprp(ts))
fn parammcons(nm, ty, ct, rr) = {items: gaddrt(nm, ct, rr.items), tys: Cons(ty, rr.tys), plist: Cons({cf: ct, pn: nm, pt: ty}, rr.plist), rest: rr.rest}
fn parammend(nm, ty, ct, rest) = {items: gaddrt(nm, ct, Nil), tys: Cons(ty, Nil), plist: Cons({cf: ct, pn: nm, pt: ty}, Nil), rest: rest}
fn gaddrt(nm, ct, rest) = if ct != 1 then Cons(nm, rest) else rest
fn parseeffitems(ts) = if headtext(ts) == "}" then {items: Nil, rest: droponce(ts)} else let enm = headtext(ts) in let t1 = droponce(ts) in if headtext(t1) == "," then let rr = parseeffitems(droponce(t1)) in {items: Cons(enm, rr.items), rest: rr.rest} else {items: Cons(enm, Nil), rest: skiprb(t1)}
fn parseeffrow(ts) = if headtext(ts) == "/" then (let t1 = droponce(ts) in if headtext(t1) == "{" then parseeffitems(droponce(t1)) else {items: Cons(headtext(t1), Nil), rest: droponce(t1)}) else {items: Nil, rest: ts}
## `terminates (m1, m2, ...)`: a lexicographic measure over the parameters. Every recursive call must be proven to
## strictly decrease it while every component stays >= 0 (06b_phase3.src, tm_*); it is never taken on trust.
fn parsetermlist(ts) = if headtext(ts) == ")" then {items: Nil, rest: droponce(ts)} else let r = expr(ts) in if headtext(r.rest) == "," then let rr = parsetermlist(droponce(r.rest)) in {items: Cons(r.node, rr.items), rest: rr.rest} else {items: Cons(r.node, Nil), rest: skiprp(r.rest)}
fn parsetermclause(ts) = if headtext(ts) == "(" then parsetermlist(droponce(ts)) else ctfail("lume: parse error [P0002]: expected '(' after 'terminates' (write 'terminates (m1, m2, ...)') " + headpos(ts) + "
")
fn parsecontracts(ts) = if headtext(ts) == "requires" then let r = expr(droponce(ts)) in let rr = parsecontracts(r.rest) in {reqs: Cons(r.node, rr.reqs), enss: rr.enss, terms: rr.terms, rest: rr.rest} else if headtext(ts) == "ensures" then let r = expr(droponce(ts)) in let rr = parsecontracts(r.rest) in {reqs: rr.reqs, enss: Cons(r.node, rr.enss), terms: rr.terms, rest: rr.rest} else if headtext(ts) == "terminates" then let tl = parsetermclause(droponce(ts)) in let rr = parsecontracts(tl.rest) in if isnil(tl.items) == 1 then ctfail("lume: parse error [P0002]: 'terminates ()' needs at least one measure
") else {reqs: rr.reqs, enss: rr.enss, terms: app(tl.items, rr.terms), rest: rr.rest} else {reqs: Nil, enss: Nil, terms: Nil, rest: ts}
fn parseret(ts) = if headtext(ts) == "-" and headtext(droponce(ts)) == ">" then parseret2(parsetype1(droponce(droponce(ts)))) else let er = parseeffrow(ts) in let vc = parsecontracts(er.rest) in {ty: TyAny, fromp: "", effs: er.items, reqs: vc.reqs, enss: vc.enss, terms: vc.terms, rest: vc.rest}
fn parseret2(r) = if headtext(r.rest) == "where" then (let pr = expr(droponce(r.rest)) in let er = parseeffrow(pr.rest) in let vc = parsecontracts(er.rest) in {ty: r.node, fromp: "", effs: er.items, reqs: vc.reqs, enss: Cons(pr.node, vc.enss), terms: vc.terms, rest: vc.rest}) else if headtext(r.rest) == "from" then let rest2 = droponce(droponce(r.rest)) in let er = parseeffrow(rest2) in let vc = parsecontracts(er.rest) in {ty: r.node, fromp: headtext(droponce(r.rest)), effs: er.items, reqs: vc.reqs, enss: vc.enss, terms: vc.terms, rest: vc.rest} else let er = parseeffrow(r.rest) in let vc = parsecontracts(er.rest) in {ty: r.node, fromp: "", effs: er.items, reqs: vc.reqs, enss: vc.enss, terms: vc.terms, rest: vc.rest}
## `sg` is the annotation record of the function: `Nil` when nothing is annotated (the AST is then exactly the
## pre-F2 one), else a `Sig(name, paramnames, paramtypes, rettype)` that parseprog places just before the `Fn`.
fn anyownp(pl) = match pl
    Nil        => 0
    Cons(p, r) => if p.cf >= 2 then 1 else anyownp(r)
fn mkosig(nm, pubf, freef, pl, rty, fromp) = if pubf == 1 or freef > 0 or anyownp(pl) == 1 or fromp != "" then OSig(nm, pubf, freef, pl, rty, fromp) else Nil
fn mkksig_f(nm, effs, freef) = let effs2 = if (freef / 256) % 2 == 1 then Cons("async", effs) else effs in if isnil(effs2) == 0 then KEffSig(nm, effs2) else Nil
fn mkksig(nm, effs) = if isnil(effs) == 0 then KEffSig(nm, effs) else Nil
fn mktsig(nm, ps, terms) = if isnil(terms) == 0 then VTermSig(nm, ps, terms) else Nil
fn mkvsig(nm, ps, reqs, enss) = if isnil(reqs) == 0 or isnil(enss) == 0 then VContractSig(nm, ps, reqs, enss) else Nil
fn parsefnp(t, pubf, freef) = parsefn2(headtext(t), pubf, freef, checkparams(parseparams(dropkw(droponce(t), "("))))
fn parsefn2(nm, pubf, freef, ps) = parsefn3(nm, pubf, freef, ps, parseret(ps.rest))
fn parsefn3(nm, pubf, freef, ps, rt) = if (freef / 32) % 2 == 1 and headtext(rt.rest) != "=" and headtext(rt.rest) != "{" then {node: Nil, sg: mksig(nm, ps, rt.ty), osg: mkosig(nm, pubf, freef, ps.plist, rt.ty, rt.fromp), ksg: mkksig_f(nm, rt.effs, freef), vsg: mkvsig(nm, ps.items, rt.reqs, rt.enss), tsg: mktsig(nm, ps.items, rt.terms), rest: rt.rest} else parsefn4(nm, pubf, freef, ps, rt, expr(dropkw(rt.rest, "=")))
fn parsefn4(nm, pubf, freef, ps, rt, b) = {node: Fn(nm, ps.items, b.node), sg: mksig(nm, ps, rt.ty), osg: mkosig(nm, pubf, freef, ps.plist, rt.ty, rt.fromp), ksg: mkksig_f(nm, rt.effs, freef), vsg: mkvsig(nm, ps.items, rt.reqs, rt.enss), tsg: mktsig(nm, ps.items, rt.terms), rest: b.rest}
fn parsefn(t) = parsefnp(t, 0, 0)
fn isany(t) = match t
    TyAny => 1
    _     => 0
fn anyann(tys) = match tys
    Nil        => 0
    Cons(h, t) => if isany(h) == 0 then 1 else anyann(t)
## C3: a function with any comptime parameter emits a `GSig(name, plist, rettype)` (plist = all params with their
## comptime flag / name / type) instead of F2's `Sig`; the checker reads it for generic argument checking and the
## erasure pass reads it to drop comptime arguments. A comptime-free function keeps F2's exact `Sig`/`Nil` choice.
fn mksig(nm, ps, rty) = if ganyct(ps.plist) == 1 then GSig(nm, ps.plist, rty) else mksigf(nm, ps, rty)
fn mksigf(nm, ps, rty) = if anyann(ps.tys) == 1 or isany(rty) == 0 then Sig(nm, ps.items, ps.tys, rty) else Nil
fn ganyct(pl) = match pl
    Nil        => 0
    Cons(p, r) => if p.cf == 1 then 1 else ganyct(r)
fn parseprint(t) = let e = expr(t) in {node: Print(e.node), rest: e.rest}
fn parsestmt(ts) = if headtext(ts) == "fn" then parsefn(droponce(ts)) else if headtext(ts) == "type" then parsetype(droponce(ts)) else parseprint(droponce(ts))
fn progmore(r) = Cons(r.node, parseprog(r.rest))
fn progfn(r) = progsig(r.tsg, progsig(r.vsg, progsig(r.ksg, progsig(r.osg, progsig(r.sg, progsig(r.node, parseprog(r.rest)))))))
fn progsig(sg, rest) = match sg
    Nil => rest
    _   => Cons(sg, rest)
fn tdeclname(nd) = match nd
    TypeS(nm, k, items) => nm
    _                   => ""
fn progtype(r) = progsig(r.inv, Cons(r.node, parseprog(r.rest)))
fn progtyped(kind, r) = Cons(OType(tdeclname(r.node), kind), progsig(r.inv, Cons(r.node, parseprog(r.rest))))
fn lawrtarg3(args) = match args
    Cons(a, Cons(b, Cons(c, r))) => c
    _                            => Num(1)
fn lawrtbody(e) = match e
    Call(nm, args) => if nm == "always" or nm == "eventually" or nm == "until" or nm == "leads_to" then lawrtarg3(args) else e
    _              => e
fn parselaw(t) = let nm = headtext(t) in let ps = parseparams(dropkw(droponce(t), "(")) in let rt = parseret(ps.rest) in let b = expr(dropkw(rt.rest, "=")) in {law: VLawDecl(nm, ps.items, b.node), sg: mksig("law_" + nm, ps, TyName("int")), fnnode: Fn("law_" + nm, ps.items, lawrtbody(b.node)), rest: b.rest}
fn proglaw(r) = Cons(r.law, progsig(r.sg, Cons(r.fnnode, parseprog(r.rest))))
fn parseeffop(ts) = let opnm = headtext(droponce(ts)) in let ps = parseparams(dropkw(droponce(droponce(ts)), "(")) in let rt = parseret(ps.rest) in {op: {op: opnm, ps: ps.items, pt: ps.tys, rt: rt.ty}, rest: dropkw(rt.rest, ";")}
fn parseeffops(ts) = if headtext(ts) == "fn" then let r = parseeffop(ts) in let rr = parseeffops(r.rest) in {items: Cons(r.op, rr.items), rest: rr.rest} else {items: Nil, rest: ts}
fn parseeffect(t) = let enm = headtext(t) in let ops = parseeffops(dropkw(droponce(t), "{")) in {node: KEffectDecl(enm, ops.items), rest: skiprb(ops.rest)}
fn parsetrait(t) = let tnm = headtext(t) in let ops = parseeffops(dropkw(droponce(t), "{")) in {node: TraitDecl(tnm, ops.items), rest: skiprb(ops.rest)}
fn parseimplfn1(tty, ts) = let opnm = headtext(ts) in let mnm = "__impl_" + tty + "_" + opnm in let ps = parseparams(dropkw(droponce(ts), "(")) in let rt = parseret(ps.rest) in let b = expr(dropkw(rt.rest, "=")) in let fn_r = parsefn4(mnm, 0, 0, ps, rt, b) in {op: {op: opnm, ar: len(ps.items), mangled: mnm, pt: ps.tys, rt: rt.ty}, stmts: progsig(fn_r.vsg, progsig(fn_r.ksg, progsig(fn_r.osg, progsig(fn_r.sg, Cons(fn_r.node, Nil))))), rest: dropkw(b.rest, ";")}
fn parseimplfns(tty, ts) = if headtext(ts) == "fn" then (let r1 = parseimplfn1(tty, droponce(ts)) in let rr = parseimplfns(tty, r1.rest) in {ops: Cons(r1.op, rr.ops), stmts: app(r1.stmts, rr.stmts), rest: rr.rest}) else if headtext(ts) == "pub" and headtext(droponce(ts)) == "fn" then (let r1 = parseimplfn1(tty, droponce(droponce(ts))) in let rr = parseimplfns(tty, r1.rest) in {ops: Cons(r1.op, rr.ops), stmts: app(r1.stmts, rr.stmts), rest: rr.rest}) else {ops: Nil, stmts: Nil, rest: ts}
fn parseimpl(t) = let tnm = headtext(t) in let t1 = dropkw(droponce(t), "for") in let tty = headtext(t1) in let t2 = dropkw(droponce(t1), "{") in let ms = parseimplfns(tty, t2) in Cons(ImplDecl(tnm, tty, ms.ops), app(ms.stmts, parseprog(skiprb(ms.rest))))
fn is_attr_stop(tok) = tok == "fn" or tok == "pub" or tok == "type" or tok == "const" or tok == "let" or tok == "print" or tok == "trait" or tok == "impl" or tok == "effect" or tok == "law"
fn parsecaplist(ts) = if isnil(ts) == 1 then ctfail("lume: parse error [P0002]: unclosed attribute '(' at end of input\n") else if headtext(ts) == ")" then {items: Nil, rest: droponce(ts)} else if is_attr_stop(headtext(ts)) == 1 then ctfail("lume: parse error [P0002]: unclosed attribute '(' before '" + headtext(ts) + "' " + headpos(ts) + "\n") else let tok = headtext(ts) in let clean = if count(tok) >= 2 and at(tok, 0) == "\"" then strval(tok) else tok in let rr = parsecaplist(droponce(ts)) in if clean == "allow" or clean == ":" or clean == "[" or clean == "]" or clean == "," then rr else {items: Cons(clean, rr.items), rest: rr.rest}
fn parsecapat(t) = let t1 = droponce(t) in let er = if headtext(t1) == "{" then parseeffitems(droponce(t1)) else if headtext(t1) == "(" then parsecaplist(droponce(t1)) else {items: Cons(headtext(t1), Nil), rest: droponce(t1)} in Cons(KCapGrant(er.items), parseprog(er.rest))
fn parselinkat(t) = let t1 = droponce(t) in let er = if headtext(t1) == "{" then parseeffitems(droponce(t1)) else if headtext(t1) == "(" then parsecaplist(droponce(t1)) else {items: Cons(headtext(t1), Nil), rest: droponce(t1)} in Cons(FFILink(er.items), parseprog(er.rest))
fn parserule(t) = let nm = headtext(t) in let ps = parseparams(dropkw(droponce(t), "(")) in let rt = parseret(ps.rest) in let b = if headtext(rt.rest) == "when" then expr(droponce(rt.rest)) else if headtext(rt.rest) == ":" and headtext(droponce(rt.rest)) == "-" then expr(droponce(droponce(rt.rest))) else expr(dropkw(rt.rest, "=")) in {sg: mksig(nm, ps, TyName("int")), fnnode: Fn(nm, ps.items, b.node), rest: b.rest}
fn progrule(r) = progsig(r.sg, Cons(r.fnnode, parseprog(r.rest)))
fn skipatparen1(ts, d) = if d <= 0 then ts else if isnil(ts) == 1 then ctfail("lume: parse error [P0002]: unclosed attribute '(' at end of input\n") else if headtext(ts) == "(" then skipatparen1(droponce(ts), d + 1) else if headtext(ts) == ")" then skipatparen1(droponce(ts), d - 1) else if is_attr_stop(headtext(ts)) == 1 then ctfail("lume: parse error [P0002]: unclosed attribute '(' before '" + headtext(ts) + "' " + headpos(ts) + "\n") else skipatparen1(droponce(ts), d)
fn skipatparen(ts) = if headtext(ts) == "(" then skipatparen1(droponce(ts), 1) else ts
fn parseboundval(ts) = if headtext(ts) != "(" then 0 else let t1 = droponce(ts) in if headtext(droponce(t1)) == ":" then toint(headtext(droponce(droponce(t1)))) else toint(headtext(t1))
fn progfnwcet(wcet, fnm, r) = if wcet > 0 then Cons(WcetSig(fnm, wcet), progfn(r)) else progfn(r)
## ATTRIBUTES (spec 19.6). The names lumec gives a meaning to, the names the specification reserves for a later
## stage (read and ignored here, so the Stage 4/5 conformance sources keep compiling), and nothing else: an unknown
## name is [P0004], because a typo in `@no_alloc` or `@secret` used to drop the safety property without a word.
## `attr_fn_only` lists the ones that qualify a function: before any other item they are [P0004] too.
fn attr_impl() = Cons("bound", Cons("no_alloc", Cons("secret", Cons("freestanding", Cons("interrupt", Cons("export", Cons("protect", Cons("gc", Cons("soa", Cons("capability", Cons("grant", Cons("link", Cons("need", Nil)))))))))))))
fn attr_reserved() = Cons("repr", Cons("schedule", Cons("autotune", Cons("derive", Cons("inline", Cons("noinline", Cons("cold", Cons("deprecated", Cons("test", Cons("bench", Cons("target", Cons("mmio", Cons("bits", Cons("packed", Cons("panic", Cons("no_std", Cons("gpu", Cons("extension", Nil))))))))))))))))))
fn attr_mem(nm, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == nm then 1 else attr_mem(nm, t)
fn attr_min3(a, b, c) = if a <= b and a <= c then a else if b <= c then b else c
## Levenshtein distance by rows: `prev` is the row of a[0..i), the result is its last cell.
fn attr_ed_row(a, b, i, j, m, prev, left, acc) = if j > m then lex_rev(acc, Nil) else let sub = attr_nth(prev, j - 1) + (if at(a, i - 1) == at(b, j - 1) then 0 else 1) in let v = attr_min3(attr_nth(prev, j) + 1, left + 1, sub) in attr_ed_row(a, b, i, j + 1, m, prev, v, Cons(v, acc))
fn attr_nth(xs, k) = match xs
    Nil        => 0
    Cons(h, t) => if k <= 0 then h else attr_nth(t, k - 1)
fn attr_iota(k, m) = if k > m then Nil else Cons(k, attr_iota(k + 1, m))
fn attr_ed_rows(a, b, i, n, m, prev) = if i > n then attr_nth(prev, m) else attr_ed_rows(a, b, i + 1, n, m, attr_ed_row(a, b, i, 1, m, prev, i, Cons(i, Nil)))
fn attr_ed(a, b) = attr_ed_rows(a, b, 1, count(a), count(b), attr_iota(0, count(b)))
fn attr_near(nm, xs, best, bestd) = match xs
    Nil        => best
    Cons(h, t) => let d = attr_ed(nm, h) in if d < bestd then attr_near(nm, t, h, d) else attr_near(nm, t, best, bestd)
fn attr_hint(nm) = let near = attr_near(nm, attr_impl(), "", 3) in if near != "" then "fix-it: did you mean '@" + near + "'?" else "fix-it: remove it; the attributes of this compiler are @bound, @no_alloc, @secret, @freestanding, @interrupt, @export, @protect, @gc, @soa, @capability, @grant, @link and @need"
fn attr_check(anm, pos) = if anm == "" or is_attr_stop(anm) == 1 or anm == "overflow" or attr_mem(anm, attr_impl()) == 1 or attr_mem(anm, attr_reserved()) == 1 then 0 else ctfail("lume: parse error [P0004]: unknown attribute '@" + anm + "' " + pos + " (" + attr_hint(anm) + ")\n")
fn attr_fn_only(freef, wcet) = if wcet > 0 then "@bound" else if (freef / 512) % 2 == 1 then "@no_alloc" else if (freef / 128) % 2 == 1 then "@secret" else if (freef / 64) % 2 == 1 then "@protect" else if (freef / 32) % 2 == 1 then "@export" else if (freef / 16) % 2 == 1 then "@interrupt" else if freef % 2 == 1 then "@freestanding" else ""
fn attr_dropped(ts, freef, wcet) = let a = attr_fn_only(freef, wcet) in if a == "" then parseprog_item(ts) else ctfail("lume: parse error [P0004]: attribute '" + a + "' qualifies 'fn', 'pub fn', 'total fn' or 'extern fn' and would be dropped before '" + headtext(ts) + "' " + headpos(ts) + " (fix-it: put it directly above the function it is meant for)\n")
fn attr_or(freef, bit) = if (freef / bit) % 2 == 1 then freef else freef + bit
fn parseattrs(ts, freef, wcet) = if headtext(ts) == "@" then (let t1 = droponce(ts) in let anm = headtext(t1) in if anm == "" or is_attr_stop(anm) == 1 then ctfail("lume: parse error [P0002]: expected attribute name after '@' " + headpos(t1) + "\n") else let z0 = attr_check(anm, headpos(t1)) in let t2 = droponce(t1) in if anm == "freestanding" then parseattrs(skipatparen(t2), if freef % 2 == 0 then freef + 1 else freef, wcet) else if anm == "interrupt" then parseattrs(skipatparen(t2), if (freef / 16) % 2 == 0 then freef + 16 else freef, wcet) else if anm == "export" then parseattrs(skipatparen(t2), if (freef / 32) % 2 == 0 then freef + 32 else freef, wcet) else if anm == "protect" then parseattrs(skipatparen(t2), if (freef / 64) % 2 == 0 then freef + 64 else freef, wcet) else if anm == "secret" then parseattrs(skipatparen(t2), if (freef / 128) % 2 == 0 then freef + 128 else freef, wcet) else if anm == "no_alloc" then parseattrs(skipatparen(t2), if (freef / 512) % 2 == 0 then freef + 512 else freef, wcet) else if anm == "bound" then parseattrs(skipatparen(t2), freef, parseboundval(t2)) else if anm == "overflow" then ctfail("lume: parse error [P0002]: '@overflow' is not supported; write the wrapping operators '+%', '-%' or '*%' where wrapping is meant\n") else parseattrs(skipatparen(t2), freef, wcet)) else if headtext(ts) == "pub" and headtext(droponce(ts)) == "fn" then let ft = droponce(droponce(ts)) in progfnwcet(wcet, headtext(ft), parsefnp(ft, 1, freef)) else if headtext(ts) == "pub" and headtext(droponce(ts)) == "extern" then progexterna(droponce(droponce(ts)), 1, freef, wcet) else if headtext(ts) == "extern" then progexterna(droponce(ts), 0, freef, wcet) else if headtext(ts) == "fn" then let ft = droponce(ts) in progfnwcet(wcet, headtext(ft), parsefnp(ft, if (freef / 32) % 2 == 1 then 1 else 0, freef)) else if headtext(ts) == "total" and headtext(droponce(ts)) == "fn" then let ft = droponce(droponce(ts)) in progfnwcet(wcet, headtext(ft), parsefnp(ft, if (freef / 32) % 2 == 1 then 1 else 0, attr_or(freef, 2))) else if headtext(ts) == "pub" and headtext(droponce(ts)) == "total" and headtext(droponce(droponce(ts))) == "fn" then let ft = droponce(droponce(droponce(ts))) in progfnwcet(wcet, headtext(ft), parsefnp(ft, 1, attr_or(freef, 2))) else attr_dropped(ts, freef, wcet)
fn progfree(ts) = if headtext(ts) == "pub" then progfn(parsefnp(droponce(droponce(ts)), 1, 1)) else progfn(parsefnp(droponce(ts), 0, 1))
fn progat(t) = let z0 = attr_check(headtext(t), headpos(t)) in if headtext(t) == "gc" then progtyped("gc", parsetype(droponce(droponce(t)))) else if headtext(t) == "soa" and headtext(droponce(t)) == "type" then progtyped("soa", parsetype(droponce(droponce(t)))) else if headtext(t) == "capability" or headtext(t) == "grant" then parsecapat(t) else if headtext(t) == "link" or headtext(t) == "need" then parselinkat(t) else parseattrs(Cons({kind: "op", text: "@", col: 0, line: 1, bol: 1}, t), 0, 0)
fn progextern(t, pubf) = progexterna(t, pubf, 0, 0)
## An `extern` function below attributes keeps them: `@bound(..)` / `@no_alloc` above `pub extern "c" fn` used to be
## parsed and then dropped (the function was built with the extern flag alone and no WcetSig).
fn progexterna(t, pubf, freef, wcet) = if headtext(t) == "llm" and headtext(droponce(t)) == "fn" then progexternf(droponce(droponce(t)), pubf, attr_or(freef, 4), wcet) else if headtext(droponce(t)) == "fn" then progexternf(droponce(droponce(t)), pubf, attr_or(freef, 32), wcet) else if headtext(t) == "fn" then progexternf(droponce(t), pubf, attr_or(freef, 32), wcet) else progexternf(droponce(t), pubf, attr_or(freef, 4), wcet)
fn progexternf(ft, pubf, freef, wcet) = progfnwcet(wcet, headtext(ft), parsefnp(ft, pubf, freef))
fn progpub(t) = if headtext(t) == "total" and headtext(droponce(t)) == "fn" then progfn(parsefnp(droponce(droponce(t)), 1, 2)) else if headtext(t) == "llm" and headtext(droponce(t)) == "fn" then progfn(parsefnp(droponce(droponce(t)), 1, 4)) else if headtext(t) == "async" and headtext(droponce(t)) == "fn" then progfn(parsefnp(droponce(droponce(t)), 1, 256)) else if headtext(t) == "extern" then progextern(droponce(t), 1) else if headtext(t) == "kernel" and headtext(droponce(t)) == "fn" then progfn(parsefnp(droponce(droponce(t)), 1, 8)) else if headtext(t) == "effect" then progmore(parseeffect(droponce(t))) else if headtext(t) == "trait" then progmore(parsetrait(droponce(t))) else if headtext(t) == "temporal" and headtext(droponce(t)) == "law" then proglaw(parselaw(droponce(droponce(t)))) else if headtext(t) == "law" then proglaw(parselaw(droponce(t))) else if headtext(t) == "rule" then progrule(parserule(droponce(t))) else if headtext(t) == "const" or headtext(t) == "let" then progmore(parseconst(droponce(t))) else progfn(parsefnp(droponce(t), 1, 0))
fn parseconst(t) = let nm = headtext(t) in let lty = parseletty(droponce(t)) in let rv = expr(expecteq(lty.rest)) in {node: ConstDecl(nm, wrap_tyann(rv.node, lty.node)), rest: dropkw(rv.rest, ";")}
fn parsetoplet(ts, t) = if headtext(t) == "mut" or headtext(t) == "(" or headtext(t) == "{" or isctor(headtext(t)) == 1 then progmore(lexprstmt(expr(ts))) else let nm = headtext(t) in let lty = parseletty(droponce(t)) in let rv = expr(expecteq(lty.rest)) in if headtext(rv.rest) == "in" or headtext(rv.rest) == ";" then progmore(lexprstmt(expr(ts))) else if headline(rv.rest) == headline(t) then ctfail("lume: parse error [P0002]: expected 'in' or a new line after 'let' value " + headpos(rv.rest) + "\n") else Cons(ConstDecl(nm, wrap_tyann(rv.node, lty.node)), parseprog(rv.rest))
fn lexprstmt(e) = {node: ExprS(e.node), rest: e.rest}
## STATEMENT RULE (spec 19.2). Inside an item a line break is white space: an expression runs on to the first token
## that cannot continue it, so a line that starts with a binary operator continues the expression before it. A
## top-level item, though, has to start on a new line: `print 1 2` and `fn f() = 1 fn g() = 2` used to be read as two
## statements, which no reader of the line expects: [P0003]. (A stray closing token or operator there is not the start
## of anything and keeps its own [P0002].)
fn parseprog(ts) = match ts
    Nil        => Nil
    Cons(h, t) => if h.bol == 0 and (h.kind != "op" or h.text == "(" or h.text == "[" or h.text == "{" or h.text == "@") then ctfail("lume: parse error [P0003]: a new statement starts in the middle of line " + str(h.line) + ", col " + str(h.col + 1) + " (near '" + h.text + "'): the expression before it ended, and a top-level item must start on a new line (fix-it: put an operator between the two expressions, or move '" + h.text + "' to its own line)\n") else parseprog1(h, t, ts)
fn parseprog_item(ts) = match ts
    Nil        => Nil
    Cons(h, t) => parseprog1(h, t, ts)
fn parseprog1(h, t, ts) = if h.text == "fn" then progfn(parsefn(droponce(ts))) else if h.text == "pub" and (headtext(t) == "fn" or headtext(t) == "total" or headtext(t) == "llm" or headtext(t) == "async" or headtext(t) == "extern" or headtext(t) == "kernel" or headtext(t) == "effect" or headtext(t) == "trait" or headtext(t) == "temporal" or headtext(t) == "law" or headtext(t) == "rule" or headtext(t) == "const" or headtext(t) == "let") then progpub(t) else if h.text == "const" then progmore(parseconst(t)) else if h.text == "let" then parsetoplet(ts, t) else if h.text == "total" and headtext(t) == "fn" then progfn(parsefnp(droponce(t), 0, 2)) else if h.text == "llm" and headtext(t) == "fn" then progfn(parsefnp(droponce(t), 0, 4)) else if h.text == "async" and headtext(t) == "fn" then progfn(parsefnp(droponce(t), 0, 256)) else if h.text == "extern" then progextern(t, 0) else if h.text == "kernel" and headtext(t) == "fn" then progfn(parsefnp(droponce(t), 0, 8)) else if h.text == "effect" then progmore(parseeffect(t)) else if h.text == "trait" then progmore(parsetrait(t)) else if h.text == "impl" then parseimpl(t) else if h.text == "temporal" and headtext(t) == "law" then proglaw(parselaw(droponce(t))) else if h.text == "law" then proglaw(parselaw(t)) else if h.text == "rule" then progrule(parserule(t)) else if h.text == "@" then progat(t) else if h.text == "resource" and headtext(t) == "type" then progtyped("resource", parsetype(droponce(t))) else if h.text == "type" then (if headtext(dropkw(droponce(t), "=")) == "model" then progtyped("model", parsetype(droponce(ts))) else progtype(parsetype(droponce(ts)))) else if h.text == "print" then progmore(parseprint(droponce(ts))) else progmore(lexprstmt(expr(ts)))

## --- ergonomic AST sugar expansion: top-level `const` / `let` and `{ s with field: val }` ---
fn is_dec_rec_items(items) = match items
    Cons(a, Cons(b, Cons(c, Nil))) => if a.key == "coefficient" and b.key == "scale" and c.key == "precision" then 1 else 0
    _                              => 0
fn has_rec_with_e(e) = match e
    Call(nm, args)         => if nm == "__lume_rec_with" or nm == "__lume_fmt" or nf_tyapp(nm) then 1 else has_rec_with_el(args)
    Bin(op, a, b)          => if has_rec_with_e(a) == 1 then 1 else has_rec_with_e(b)
    If(c, t, e2)           => if has_rec_with_e(c) == 1 then 1 else if has_rec_with_e(t) == 1 then 1 else has_rec_with_e(e2)
    LetIn(nm, v, b)        => if has_rec_with_e(v) == 1 then 1 else has_rec_with_e(b)
    VarIn(nm, v, b)        => if has_rec_with_e(v) == 1 then 1 else has_rec_with_e(b)
    Rec(items)             => if is_dec_rec_items(items) == 1 then 1 else has_rec_with_recl(items)
    RecT(tn, items)        => has_rec_with_recl(items)
    Field(o, nm)           => has_rec_with_e(o)
    Match(sc, arms)        => if has_rec_with_e(sc) == 1 then 1 else has_rec_with_arms(arms)
    LambdaE(ps, ts, r, b)  => has_rec_with_e(b)
    ShardE(v, l, h, b)     => if has_rec_with_e(l) == 1 then 1 else if has_rec_with_e(h) == 1 then 1 else has_rec_with_e(b)
    OwnE(x)                => has_rec_with_e(x)
    MutE(x)                => has_rec_with_e(x)
    DeferE(c, b)           => if has_rec_with_e(c) == 1 then 1 else has_rec_with_e(b)
    ErrDeferE(c, b)        => if has_rec_with_e(c) == 1 then 1 else has_rec_with_e(b)
    WithAllocE(a, b)       => if has_rec_with_e(a) == 1 then 1 else has_rec_with_e(b)
    WithHandlerE(e0, h, b) => if has_rec_with_hops(h) == 1 then 1 else has_rec_with_e(b)
    ScopeE(s, b)           => has_rec_with_e(b)
    SpawnE(x)              => has_rec_with_e(x)
    AwaitE(x)              => has_rec_with_e(x)
    CT(x)                  => has_rec_with_e(x)
    _                      => 0
fn has_rec_with_hops(xs) = match xs
    Nil        => 0
    Cons(h, t) => if has_rec_with_e(h.body) == 1 then 1 else has_rec_with_hops(t)
fn has_rec_with_el(xs) = match xs
    Nil        => 0
    Cons(h, t) => if has_rec_with_e(h) == 1 then 1 else has_rec_with_el(t)
fn has_rec_with_recl(xs) = match xs
    Nil        => 0
    Cons(h, t) => if has_rec_with_e(h.val) == 1 then 1 else has_rec_with_recl(t)
fn has_rec_with_arms(xs) = match xs
    Nil        => 0
    Cons(h, t) => if has_rec_with_e(h.body) == 1 then 1 else has_rec_with_arms(t)
fn has_prog_sugar_s(s0) = match s0
    ConstDecl(nm, v)          => 1
    TypeS(nm, k, items)       => 1
    TraitDecl(nm, ops)        => 1
    ImplDecl(tnm, tty, mths)  => 1
    Fn(nm, ps, body)          => has_rec_with_e(body)
    VContractSig(nm, p, r, e) => if has_rec_with_el(r) == 1 then 1 else has_rec_with_el(e)
    Print(v)                  => has_rec_with_e(v)
    ExprS(v)                  => has_rec_with_e(v)
    VLawDecl(nm, ps, b)       => has_rec_with_e(b)
    _                         => 0
fn has_prog_sugar(prog) = match prog
    Nil        => 0
    Cons(h, t) => if has_prog_sugar_s(h) == 1 then 1 else has_prog_sugar(t)
fn ps_has_str(nm, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == nm then 1 else ps_has_str(nm, t)
fn ps_const_lookup(nm, consts) = match consts
    Nil        => Nil
    Cons(h, t) => if h.k == nm then Cons(h.v, Nil) else ps_const_lookup(nm, t)
fn ps_const_ev_lookup(nm, consts) = match consts
    Nil        => Num(0)
    Cons(h, t) => if h.k == nm then h.ev else ps_const_ev_lookup(nm, t)
fn ps_rec_fnames(fs) = match fs
    Nil        => Nil
    Cons(h, t) => Cons(h.fname, ps_rec_fnames(t))
fn ps_item_keys(items) = match items
    Nil        => Nil
    Cons(h, t) => Cons(h.key, ps_item_keys(t))
fn ps_is_struct_rec(items) = match items
    Nil        => 0
    Cons(h, t) => if count(h.key) > 0 and at(h.key, 0) == "_" then 0 else 1
fn ps_collect_recs_e(e, rest) = match e
    Rec(items)      => let r1 = ps_collect_recs_recl(items, rest) in if ps_is_struct_rec(items) == 1 then Cons({rname: "", fnames: ps_item_keys(items)}, r1) else r1
    RecT(tn, items) => ps_collect_recs_recl(items, rest)
    LetIn(nm, v, b) => ps_collect_recs_e(v, ps_collect_recs_e(b, rest))
    VarIn(nm, v, b) => ps_collect_recs_e(v, ps_collect_recs_e(b, rest))
    If(c, t, e2)    => ps_collect_recs_e(c, ps_collect_recs_e(t, ps_collect_recs_e(e2, rest)))
    Bin(op, a, b)   => ps_collect_recs_e(a, ps_collect_recs_e(b, rest))
    Call(nm, args)  => if nm == "__lume_rec_with" then rest else ps_collect_recs_el(args, rest)
    Match(sc, arms) => ps_collect_recs_e(sc, ps_collect_recs_arms(arms, rest))
    _               => rest
fn ps_collect_recs_el(xs, rest) = match xs
    Nil        => rest
    Cons(h, t) => ps_collect_recs_e(h, ps_collect_recs_el(t, rest))
fn ps_collect_recs_recl(xs, rest) = match xs
    Nil        => rest
    Cons(h, t) => ps_collect_recs_e(h.val, ps_collect_recs_recl(t, rest))
fn ps_collect_recs_arms(xs, rest) = match xs
    Nil        => rest
    Cons(h, t) => ps_collect_recs_e(h.body, ps_collect_recs_arms(t, rest))
fn ps_collect_recs1(s0, rest) = match s0
    TypeS(nm, k, items) => if k == "record" then Cons({rname: nm, fnames: ps_rec_fnames(items)}, rest) else rest
    Fn(nm, ps, body)    => ps_collect_recs_e(body, rest)
    _                   => rest
fn ps_collect_recs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ps_collect_recs1(h, ps_collect_recs(t))
fn ps_collect_sigs1(s0, rest) = match s0
    Sig(nm, ps, ts, rt) => Cons({fname: nm, ps: ps, ts: ts}, rest)
    _                   => rest
fn ps_collect_sigs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ps_collect_sigs1(h, ps_collect_sigs(t))
fn ps_lookup_rec(rnm, recs) = match recs
    Nil        => Nil
    Cons(h, t) => if h.rname == rnm then h.fnames else ps_lookup_rec(rnm, t)
fn ps_all_keys_in(upds, fnames) = match upds
    Nil        => 1
    Cons(h, t) => if ps_has_str(h.key, fnames) == 1 then ps_all_keys_in(t, fnames) else 0
fn ps_lrec_lookup(nm, lrecs) = match lrecs
    Nil        => {rname: "", fnames: Nil}
    Cons(h, t) => if h.nm == nm then {rname: h.rname, fnames: h.fnames} else ps_lrec_lookup(nm, t)
fn ps_upd_lookup(fnm, upds) = match upds
    Nil        => Nil
    Cons(h, t) => if h.key == fnm then Cons(h.val, Nil) else ps_upd_lookup(fnm, t)
fn ps_upd_val(bvar, fnm, m) = match m
    Cons(v, r) => v
    Nil        => Field(Var(bvar), fnm)
fn ps_build_merged(bvar, fnames, upds) = match fnames
    Nil        => Nil
    Cons(h, t) => Cons({key: h, val: ps_upd_val(bvar, h, ps_upd_lookup(h, upds))}, ps_build_merged(bvar, t, upds))
fn ps_var_name(e) = match e
    Var(nm) => nm
    _       => ""
fn ps_str_val(e) = match e
    Str(s) => s
    _      => ""
fn ps_rec_items(e) = match e
    Rec(items)      => items
    RecT(tn, items) => items
    _               => Nil
fn ps_expr_rec_info(e, recs) = match e
    RecT(tn, items) => {rname: tn, fnames: let fs = ps_lookup_rec(tn, recs) in if isnil(fs) == 0 then fs else ps_item_keys(items)}
    Rec(items)      => {rname: "", fnames: ps_item_keys(items)}
    _               => {rname: "", fnames: Nil}
fn ps_ty_rname(ty) = match ty
    TyName(nm)       => nm
    TyRefine(bty, p) => ps_ty_rname(bty)
    _                => ""
fn ps_sig_lrecs_zip(ps, ts, recs) = match ps
    Nil         => Nil
    Cons(p, pr) => ps_sig_lrecs_zip2(p, pr, ts, recs)
fn ps_sig_lrecs_zip2(p, pr, ts, recs) = match ts
    Nil         => Nil
    Cons(t, tr) => let rnm = ps_ty_rname(t) in let fns = if rnm != "" then ps_lookup_rec(rnm, recs) else Nil in let rest = ps_sig_lrecs_zip(pr, tr, recs) in if isnil(fns) == 0 then Cons({nm: p, rname: rnm, fnames: fns}, rest) else rest
fn ps_fn_lrecs(fnm, sigs, recs) = match sigs
    Nil        => Nil
    Cons(h, t) => if h.fname == fnm then ps_sig_lrecs_zip(h.ps, h.ts, recs) else ps_fn_lrecs(fnm, t, recs)
fn ps_pat_binds(p) = match p
    PBind(nm)      => Cons(nm, Nil)
    PCons(tag, ps) => ps_pat_bind_list(ps)
    _              => Nil
fn ps_pat_bind_list(ps) = match ps
    Nil        => Nil
    Cons(h, t) => app(ps_pat_binds(h), ps_pat_bind_list(t))
fn ps_unwrap_tyann(e) = match e
    If(c, t, e2) => if ps_is_tyann_marker(e2) == 1 then ps_unwrap_tyann(t) else e
    _            => e
fn ps_is_tyann_marker(e) = match e
    Call(nm, args) => if nm == "_tyann_" then 1 else 0
    _              => 0
fn ps_const_to_pat(v, fallback) = match v
    Num(n)       => PInt(n)
    Str(s)       => PStr(s)
    If(c, t, e2) => if ps_is_tyann_marker(e2) == 1 then ps_const_to_pat(t, fallback) else fallback
    _            => fallback
fn ps_exp_pat_list(ps, consts) = match ps
    Nil        => Nil
    Cons(h, t) => Cons(ps_exp_pat(h, consts), ps_exp_pat_list(t, consts))
fn ps_exp_pat_lookup(tag, m, ps, consts) = match m
    Cons(v, r) => if isnil(ps) == 1 then ps_const_to_pat(v, PCons(tag, Nil)) else PCons(tag, ps_exp_pat_list(ps, consts))
    Nil        => PCons(tag, ps_exp_pat_list(ps, consts))
fn ps_exp_pat(p, consts) = match p
    PCons(tag, ps) => ps_exp_pat_lookup(tag, ps_const_lookup(tag, consts), ps, consts)
    _              => p
fn ps_expand_rec_with(args, ctx, shadow, lrecs) = match args
    Cons(tn_e, Cons(base_e, Cons(upd_e, r))) => let tnm = ps_str_val(tn_e) in let b2 = ps_exp_e(base_e, ctx, shadow, lrecs) in let u2 = ps_exp_recl(ps_rec_items(upd_e), ctx, shadow, lrecs) in let bnm = ps_var_name(b2) in let lr = if bnm != "" then ps_lrec_lookup(bnm, lrecs) else {rname: "", fnames: Nil} in let rnm = if tnm != "" then tnm else lr.rname in let fns1 = if tnm != "" then ps_lookup_rec(tnm, ctx.recs) else lr.fnames in let mr = {rname: rnm, fnames: fns1} in if isnil(mr.fnames) == 1 then Call("__lume_rec_update", Cons(b2, Cons(Rec(u2), Nil))) else if bnm != "" then (let m = ps_build_merged(bnm, mr.fnames, u2) in if mr.rname != "" then RecT(mr.rname, m) else Rec(m)) else (let m = ps_build_merged("_ru", mr.fnames, u2) in LetIn("_ru", b2, if mr.rname != "" then RecT(mr.rname, m) else Rec(m)))
    _                                        => Num(0)
fn ps_exp_var(nm, ctx, shadow) = if ps_has_str(nm, shadow) == 1 then Var(nm) else ps_exp_var2(nm, ps_const_lookup(nm, ctx.consts))
fn ps_exp_var2(nm, m) = match m
    Cons(v, r) => v
    Nil        => Var(nm)
## `name[e]` parses as a type application, because `list[int]` is a value when it is the comptime argument of a
## generic. Scope decides: on a name that is bound here it is an index, and it has to become one before ownership
## and Perceus read the program, or the use of `xs` would be invisible to them.
fn ps_index_base(nm) = slice(nm, 7, count(nm))
fn ps_const_known(m) = match m
    Cons(v, r) => 1
    Nil        => 0
fn ps_is_index(nm, ctx, shadow) = if nf_tyapp(nm) == 0 then 0 else let b = ps_index_base(nm) in if nf_isctor(b) == 1 then 0 else if ps_has_str(b, shadow) == 1 then 1 else ps_const_known(ps_const_lookup(b, ctx.consts))
fn ps_is_const_call(nm, ctx, shadow) = if ps_has_str(nm, shadow) == 1 then 0 else ps_const_known(ps_const_lookup(nm, ctx.consts))
fn ps_idx_call(base_e, rargs) = match rargs
    Cons(Str(fld), Nil) => Field(base_e, fld)
    _                   => Call("lidx", Cons(base_e, rargs))
fn ps_exp_e(e, ctx, shadow, lrecs) = match e
    Var(nm)                => ps_exp_var(nm, ctx, shadow)
    Bin(op, a, b)          => Bin(op, ps_exp_e(a, ctx, shadow, lrecs), ps_exp_e(b, ctx, shadow, lrecs))
    If(c, t, e2)           => If(ps_exp_e(c, ctx, shadow, lrecs), ps_exp_e(t, ctx, shadow, lrecs), ps_exp_e(e2, ctx, shadow, lrecs))
    LetIn(nm, v, b)        => let v2 = ps_exp_e(v, ctx, shadow, lrecs) in let ri = ps_expr_rec_info(v2, ctx.recs) in let lr2 = if isnil(ri.fnames) == 0 then Cons({nm: nm, rname: ri.rname, fnames: ri.fnames}, lrecs) else lrecs in LetIn(nm, v2, ps_exp_e(b, ctx, Cons(nm, shadow), lr2))
    VarIn(nm, v, b)        => let v2 = ps_exp_e(v, ctx, shadow, lrecs) in let ri = ps_expr_rec_info(v2, ctx.recs) in let lr2 = if isnil(ri.fnames) == 0 then Cons({nm: nm, rname: ri.rname, fnames: ri.fnames}, lrecs) else lrecs in VarIn(nm, v2, ps_exp_e(b, ctx, Cons(nm, shadow), lr2))
    Call(nm, args)         => if nm == "__lume_rec_with" then ps_expand_rec_with(args, ctx, shadow, lrecs) else if ps_is_index(nm, ctx, shadow) == 1 then ps_idx_call(ps_exp_var(ps_index_base(nm), ctx, shadow), ps_exp_el(args, ctx, shadow, lrecs)) else if ps_is_const_call(nm, ctx, shadow) == 1 then Call("_call", Cons(ps_exp_var(nm, ctx, shadow), ps_exp_el(args, ctx, shadow, lrecs))) else Call(nm, ps_exp_el(args, ctx, shadow, lrecs))
    Rec(items)             => Rec(ps_exp_recl(items, ctx, shadow, lrecs))
    RecT(tn, items)        => RecT(tn, ps_exp_recl(items, ctx, shadow, lrecs))
    Field(o, nm)           => Field(ps_exp_e(o, ctx, shadow, lrecs), nm)
    Match(sc, arms)        => Match(ps_exp_e(sc, ctx, shadow, lrecs), ps_exp_arms(arms, ctx, shadow, lrecs))
    LambdaE(ps, ts, rt, b) => LambdaE(ps, ts, rt, ps_exp_e(b, ctx, app(ps, shadow), lrecs))
    ShardE(v, l, h, b)     => ShardE(v, ps_exp_e(l, ctx, shadow, lrecs), ps_exp_e(h, ctx, shadow, lrecs), ps_exp_e(b, ctx, Cons(v, shadow), lrecs))
    OwnE(x)                => OwnE(ps_exp_e(x, ctx, shadow, lrecs))
    MutE(x)                => MutE(ps_exp_e(x, ctx, shadow, lrecs))
    DeferE(c, b)           => DeferE(ps_exp_e(c, ctx, shadow, lrecs), ps_exp_e(b, ctx, shadow, lrecs))
    ErrDeferE(c, b)        => ErrDeferE(ps_exp_e(c, ctx, shadow, lrecs), ps_exp_e(b, ctx, shadow, lrecs))
    WithAllocE(a, b)       => WithAllocE(ps_exp_e(a, ctx, shadow, lrecs), ps_exp_e(b, ctx, shadow, lrecs))
    WithHandlerE(e0, h, b) => WithHandlerE(e0, ps_exp_hops(h, ctx, shadow, lrecs), ps_exp_e(b, ctx, shadow, lrecs))
    ScopeE(s, b)           => ScopeE(s, ps_exp_e(b, ctx, Cons(s, shadow), lrecs))
    SpawnE(x)              => SpawnE(ps_exp_e(x, ctx, shadow, lrecs))
    AwaitE(x)              => AwaitE(ps_exp_e(x, ctx, shadow, lrecs))
    CT(x)                  => CT(ps_exp_e(x, ctx, shadow, lrecs))
    _                      => e
fn ps_exp_hops(xs, ctx, shadow, lrecs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({op: h.op, ps: h.ps, body: ps_exp_e(h.body, ctx, app(h.ps, shadow), lrecs)}, ps_exp_hops(t, ctx, shadow, lrecs))
fn ps_exp_el(xs, ctx, shadow, lrecs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(ps_exp_e(h, ctx, shadow, lrecs), ps_exp_el(t, ctx, shadow, lrecs))
fn ps_exp_recl(xs, ctx, shadow, lrecs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: ps_exp_e(h.val, ctx, shadow, lrecs)}, ps_exp_recl(t, ctx, shadow, lrecs))
fn ps_exp_arms(xs, ctx, shadow, lrecs) = match xs
    Nil        => Nil
    Cons(h, t) => let p2 = ps_exp_pat(h.pat, ctx.consts) in Cons({pat: p2, body: ps_exp_e(h.body, ctx, app(ps_pat_binds(p2), shadow), lrecs)}, ps_exp_arms(t, ctx, shadow, lrecs))
## A top-level `let` made of literals and constructors is a constant and is inlined. Anything else runs once, at
## its statement: its value goes in a global slot, so a side effect never repeats per use. A kernel has no slot
## table, and keeps the inlining.
fn ps_pure_args(xs) = match xs
    Nil        => 1
    Cons(h, t) => if ps_pure_const(h) == 1 then ps_pure_args(t) else 0
fn ps_pure_items(xs) = match xs
    Nil        => 1
    Cons(h, t) => if ps_pure_const(h.val) == 1 then ps_pure_items(t) else 0
fn ps_pure_const(e) = match e
    Num(n)          => 1
    Str(v)          => 1
    Var(x)          => 1
    If(c, t, e2)    => if ps_is_tyann_marker(e2) == 1 then ps_pure_const(t) else 0
    Bin(op, l, r)   => if ps_pure_const(l) == 1 then ps_pure_const(r) else 0
    Rec(items)      => ps_pure_items(items)
    RecT(tn, items) => ps_pure_items(items)
    Call(nm, args)  => if isctor(nm) then ps_pure_args(args) else if nm == "__lume_global_get" then 1 else 0
    _               => 0
fn ps_is_freestanding(prog) = match prog
    Nil        => 0
    Cons(h, t) => ps_is_freestanding1(h, t)
fn ps_is_freestanding1(h, t) = match h
    OSig(nm, pubf, freef, pl, rty, fromp) => if freef % 2 == 1 then 1 else ps_is_freestanding(t)
    _                                     => ps_is_freestanding(t)
fn ps_all_cnames1(s0, rest) = match s0
    ConstDecl(nm, v) => Cons(nm, rest)
    _                => rest
fn ps_all_cnames(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ps_all_cnames1(h, ps_all_cnames(t))
fn ps_check_const_ref_el(xs, cnm, defined, allc, sh) = match xs
    Nil        => 0
    Cons(h, t) => let u = ps_check_const_ref_e(h, cnm, defined, allc, sh) in ps_check_const_ref_el(t, cnm, defined, allc, sh)
fn ps_check_const_ref_recl(xs, cnm, defined, allc, sh) = match xs
    Nil        => 0
    Cons(h, t) => let u = ps_check_const_ref_e(h.val, cnm, defined, allc, sh) in ps_check_const_ref_recl(t, cnm, defined, allc, sh)
fn ps_check_const_ref_arms(xs, cnm, defined, allc, sh) = match xs
    Nil        => 0
    Cons(h, t) => let u = ps_check_const_ref_e(h.body, cnm, defined, allc, app(ps_pat_binds(h.pat), sh)) in ps_check_const_ref_arms(t, cnm, defined, allc, sh)
fn ps_check_const_var(x, cnm, defined, allc, sh) = if ps_has_str(x, sh) == 1 then 0 else if x == cnm or (ps_has_str(x, allc) == 1 and ps_const_known(ps_const_lookup(x, defined)) == 0) then ctfail("lume: name error [R0200]: top-level binding '" + cnm + "' cannot reference '" + x + "' before initialization\n") else 0
fn ps_check_const_ref_e(e, cnm, defined, allc, sh) = match e
    Var(x)                 => ps_check_const_var(x, cnm, defined, allc, sh)
    Bin(op, a, b)          => let u = ps_check_const_ref_e(a, cnm, defined, allc, sh) in ps_check_const_ref_e(b, cnm, defined, allc, sh)
    If(c, t, e2)           => let u1 = ps_check_const_ref_e(c, cnm, defined, allc, sh) in let u2 = ps_check_const_ref_e(t, cnm, defined, allc, sh) in ps_check_const_ref_e(e2, cnm, defined, allc, sh)
    LetIn(nm, v, b)        => let u = ps_check_const_ref_e(v, cnm, defined, allc, sh) in ps_check_const_ref_e(b, cnm, defined, allc, Cons(nm, sh))
    VarIn(nm, v, b)        => let u = ps_check_const_ref_e(v, cnm, defined, allc, sh) in ps_check_const_ref_e(b, cnm, defined, allc, Cons(nm, sh))
    Call(nm, args)         => let u = if ps_is_index(nm, {consts: defined, recs: Nil, sigs: Nil}, sh) == 0 and nf_tyapp(nm) == 1 then ps_check_const_var(ps_index_base(nm), cnm, defined, allc, sh) else ps_check_const_var(nm, cnm, defined, allc, sh) in ps_check_const_ref_el(args, cnm, defined, allc, sh)
    Rec(items)             => ps_check_const_ref_recl(items, cnm, defined, allc, sh)
    RecT(tn, items)        => ps_check_const_ref_recl(items, cnm, defined, allc, sh)
    Field(o, nm)           => ps_check_const_ref_e(o, cnm, defined, allc, sh)
    Match(sc, arms)        => let u = ps_check_const_ref_e(sc, cnm, defined, allc, sh) in ps_check_const_ref_arms(arms, cnm, defined, allc, sh)
    LambdaE(ps, ts, rt, b) => ps_check_const_ref_e(b, cnm, defined, allc, app(ps, sh))
    OwnE(x)                => ps_check_const_ref_e(x, cnm, defined, allc, sh)
    MutE(x)                => ps_check_const_ref_e(x, cnm, defined, allc, sh)
    DeferE(c, b)           => let u = ps_check_const_ref_e(c, cnm, defined, allc, sh) in ps_check_const_ref_e(b, cnm, defined, allc, sh)
    ErrDeferE(c, b)        => let u = ps_check_const_ref_e(c, cnm, defined, allc, sh) in ps_check_const_ref_e(b, cnm, defined, allc, sh)
    _                      => 0
fn ps_global_slot(e, idx) = Call("__lume_global_get", Cons(Num(idx), Nil))
fn ps_collect_consts1(s0, acc, recs, sigs, krn, allc) = match s0
    ConstDecl(nm, v) => if ps_const_known(ps_const_lookup(nm, acc)) == 1 then ctfail("lume: name error [D0002]: name '" + nm + "' is defined more than once\n") else let u = ps_check_const_ref_e(v, nm, acc, allc, Nil) in let ev = ps_exp_e(v, {consts: acc, recs: recs, sigs: sigs}, Nil, Nil) in let uv = ps_unwrap_tyann(ev) in let keep = if krn == 1 or ps_pure_const(ev) == 1 then 1 else 0 in Cons({k: nm, v: if keep == 1 then uv else ps_global_slot(uv, len(acc)), ev: ev, slot: if keep == 1 then 0 - 1 else len(acc)}, acc)
    _                => acc
fn ps_collect_consts(prog, acc, recs, sigs, krn, allc) = match prog
    Nil        => acc
    Cons(h, t) => ps_collect_consts(t, ps_collect_consts1(h, acc, recs, sigs, krn, allc), recs, sigs, krn, allc)
fn ps_const_slot(nm, consts) = match consts
    Nil        => 0 - 1
    Cons(h, t) => if h.k == nm then h.slot else ps_const_slot(nm, t)
fn ps_exp_const(nm, v, slot) = if slot < 0 then Fn(nm, Nil, v) else ExprS(Call("__lume_global_set", Cons(Num(slot), Cons(v, Nil))))
fn ps_exp_stmt(s0, ctx) = match s0
    ConstDecl(nm, v)          => ps_exp_const(nm, ps_const_ev_lookup(nm, ctx.consts), ps_const_slot(nm, ctx.consts))
    Fn(nm, ps, body)          => let lr = ps_fn_lrecs(nm, ctx.sigs, ctx.recs) in Fn(nm, ps, ps_exp_e(body, ctx, ps, lr))
    VContractSig(nm, p, r, e) => let lr = ps_fn_lrecs(nm, ctx.sigs, ctx.recs) in VContractSig(nm, p, ps_exp_el(r, ctx, p, lr), ps_exp_el(e, ctx, Cons("result", p), lr))
    VLawDecl(nm, ps, b)       => VLawDecl(nm, ps, ps_exp_e(b, ctx, ps, Nil))
    VTermSig(nm, p, ms)       => VTermSig(nm, p, ps_exp_el(ms, ctx, p, ps_fn_lrecs(nm, ctx.sigs, ctx.recs)))
    VTypeInvariant(nm, fs, b) => VTypeInvariant(nm, fs, ps_exp_e(b, ctx, Cons("self", ps_rec_fnames(fs)), Nil))
    Print(v)                  => Print(ps_exp_e(v, ctx, Nil, Nil))
    ExprS(v)                  => ExprS(ps_exp_e(v, ctx, Nil, Nil))
    _                         => s0
fn ps_exp_prog(prog, ctx) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(ps_exp_stmt(h, ctx), ps_exp_prog(t, ctx))
fn ps_known_builtin_ty(nm) = nm == "int" or nm == "str" or nm == "bool" or nm == "unit" or nm == "never" or nm == "float" or nm == "f32" or nm == "f64" or nm == "i8" or nm == "i16" or nm == "i32" or nm == "i64" or nm == "u8" or nm == "u16" or nm == "u32" or nm == "u64" or nm == "usize" or nm == "isize" or nm == "any" or nm == "type" or nm == "Int" or nm == "String" or nm == "Bool" or nm == "Float" or nm == "Unit" or nm == "Option" or nm == "Result" or nm == "List" or nm == "Map" or (count(nm) == 1 and isctor(nm) == 1)
fn ps_collect_tnames1(s0, rest) = match s0
    TypeS(nm, k, items)    => Cons(nm, rest)
    TypeRefineS(nm, b, p)  => Cons(nm, rest)
    TraitDecl(nm, ops)     => Cons(nm, rest)
    KEffectDecl(nm, ops)   => Cons(nm, rest)
    _                      => rest
fn ps_collect_tnames(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ps_collect_tnames1(h, ps_collect_tnames(t))
fn ps_check_fty(ty, tnames) = match ty
    TyName(nm)      => if nm != "" and ps_known_builtin_ty(nm) == 0 and ps_has_str(nm, tnames) == 0 then ctfail("lume: type error [T0001]: unknown type '" + nm + "'\n") else 0
    TyList(e)       => ps_check_fty(e, tnames)
    TyApply(k, e)   => ps_check_fty(e, tnames)
    TyRefine(b, p)  => ps_check_fty(b, tnames)
    _               => 0
fn ps_check_rec_fields(fs, tnames) = match fs
    Nil        => 0
    Cons(h, t) => let u = ps_check_fty(h.fty, tnames) in ps_check_rec_fields(t, tnames)
fn ps_collect_traits1(s0, rest) = match s0
    TraitDecl(nm, ops) => Cons({tnm: nm, ops: ops}, rest)
    _                  => rest
fn ps_collect_traits(prog) = match prog
    Nil        => Nil
    Cons(h, t) => ps_collect_traits1(h, ps_collect_traits(t))
fn ps_find_trait(tnm, traits) = match traits
    Nil        => Nil
    Cons(h, t) => if h.tnm == tnm then Cons(h.ops, Nil) else ps_find_trait(tnm, t)
fn ps_find_top(opnm, tops) = match tops
    Nil        => Nil
    Cons(h, t) => if h.op == opnm then Cons(h, Nil) else ps_find_top(opnm, t)
fn ps_ty_eq(a, b, self_ty) = match a
    TyAny            => 1
    TyName(na)       => ps_ty_eq_name( if na == "Self" then self_ty else na, b, self_ty)
    TyList(ea)       => ps_ty_eq_list(ea, b, self_ty)
    TyApply(ka, ea)  => ps_ty_eq_app(ka, ea, b, self_ty)
    TyDecimal(p, s)  => ps_ty_eq_dec(p, s, b)
    TyRefine(ba, pa) => ps_ty_eq(ba, b, self_ty)
    _                => 1
fn ps_ty_eq_name(na, b, self_ty) = match b
    TyAny            => 1
    TyName(nb)       => na == (if nb == "Self" then self_ty else nb)
    TyRefine(bb, pb) => ps_ty_eq_name(na, bb, self_ty)
    _                => 0
fn ps_ty_eq_list(ea, b, self_ty) = match b
    TyAny            => 1
    TyList(eb)       => ps_ty_eq(ea, eb, self_ty)
    TyRefine(bb, pb) => ps_ty_eq_list(ea, bb, self_ty)
    _                => 0
fn ps_ty_eq_app(ka, ea, b, self_ty) = match b
    TyAny            => 1
    TyApply(kb, eb)  => if ka == kb then ps_ty_eq(ea, eb, self_ty) else 0
    TyRefine(bb, pb) => ps_ty_eq_app(ka, ea, bb, self_ty)
    _                => 0
fn ps_ty_eq_dec(p, s, b) = match b
    TyAny             => 1
    TyDecimal(p2, s2) => p == p2 and s == s2
    _                 => 0
fn ps_check_ptys(tps, mps, tty, tnm, opnm) = match tps
    Nil         => 0
    Cons(a, ar) => ps_check_ptys2(a, ar, mps, tty, tnm, opnm)
fn ps_check_ptys2(a, ar, mps, tty, tnm, opnm) = match mps
    Nil         => 0
    Cons(b, br) => if ps_ty_eq(a, b, tty) == 0 then ctfail("lume: trait error [T0403]: method '" + opnm + "' in 'impl " + tnm + " for " + tty + "' has incompatible parameter type with trait '" + tnm + "'\n") else ps_check_ptys(ar, br, tty, tnm, opnm)
fn ps_check_impl_op1(m, top, tnm, tty) = match top
    Nil         => ctfail("lume: trait error [T0402]: method '" + m.op + "' is not a member of trait '" + tnm + "'\n")
    Cons(tp, r) => if ps_ty_eq(tp.rt, m.rt, tty) == 0 then ctfail("lume: trait error [T0403]: method '" + m.op + "' in 'impl " + tnm + " for " + tty + "' has incompatible return type with trait '" + tnm + "'\n") else ps_check_ptys(tp.pt, m.pt, tty, tnm, m.op)
fn ps_check_impl_ops(mths, tops, tnm, tty) = match mths
    Nil        => 0
    Cons(m, t) => let u = ps_check_impl_op1(m, ps_find_top(m.op, tops), tnm, tty) in ps_check_impl_ops(t, tops, tnm, tty)
fn ps_check_impl_trait(tnm, tty, mths, found) = match found
    Nil          => 0
    Cons(tops, r) => ps_check_impl_ops(mths, tops, tnm, tty)
fn ps_has_mth(opnm, mths) = match mths
    Nil        => 0
    Cons(m, t) => if m.op == opnm then 1 else ps_has_mth(opnm, t)
fn ps_covers_tops(tops, mths) = match tops
    Nil        => 1
    Cons(h, t) => if isnil(tops) == 0 and ps_has_mth(h.op, mths) == 1 then ps_covers_tops(t, mths) else 0
fn ps_companion_impls(tnm, tty, mths, traits) = match traits
    Nil        => Nil
    Cons(h, t) => let rest = ps_companion_impls(tnm, tty, mths, t) in if h.tnm != tnm and isnil(h.ops) == 0 and ps_covers_tops(h.ops, mths) == 1 then Cons(ImplDecl(h.tnm, tty, mths), rest) else rest
fn ps_validate_decls(prog, tnames, traits) = match prog
    Nil        => Nil
    Cons(h, t) => ps_validate_decl1(h, ps_validate_decls(t, tnames, traits), tnames, traits)
fn ps_validate_decl1(s0, rest, tnames, traits) = match s0
    TypeS(nm, k, items)      => let u = if k == "record" then ps_check_rec_fields(items, tnames) else 0 in Cons(s0, rest)
    ImplDecl(tnm, tty, mths) => let u1 = if tty != "" and ps_known_builtin_ty(tty) == 0 and ps_has_str(tty, tnames) == 0 then ctfail("lume: type error [T0001]: unknown type '" + tty + "' in 'impl " + tnm + " for " + tty + "'\n") else 0 in let u2 = ps_check_impl_trait(tnm, tty, mths, ps_find_trait(tnm, traits)) in Cons(s0, app(ps_companion_impls(tnm, tty, mths, traits), rest))
    _                        => Cons(s0, rest)
fn ps_uses_call_e(e, target) = match e
    Call(nm, args)         => if nm == target then 1 else ps_uses_call_el(args, target)
    Bin(op, a, b)          => if ps_uses_call_e(a, target) == 1 then 1 else ps_uses_call_e(b, target)
    If(c, t, e2)           => if ps_uses_call_e(c, target) == 1 then 1 else if ps_uses_call_e(t, target) == 1 then 1 else ps_uses_call_e(e2, target)
    LetIn(nm, v, b)        => if ps_uses_call_e(v, target) == 1 then 1 else ps_uses_call_e(b, target)
    VarIn(nm, v, b)        => if ps_uses_call_e(v, target) == 1 then 1 else ps_uses_call_e(b, target)
    Rec(items)             => ps_uses_call_recl(items, target)
    RecT(tn, items)        => ps_uses_call_recl(items, target)
    Field(o, nm)           => ps_uses_call_e(o, target)
    Match(sc, arms)        => if ps_uses_call_e(sc, target) == 1 then 1 else ps_uses_call_arms(arms, target)
    LambdaE(ps, ts, rt, b) => ps_uses_call_e(b, target)
    _                      => 0
fn ps_uses_call_el(xs, target) = match xs
    Nil        => 0
    Cons(h, t) => if ps_uses_call_e(h, target) == 1 then 1 else ps_uses_call_el(t, target)
fn ps_uses_call_recl(xs, target) = match xs
    Nil        => 0
    Cons(h, t) => if ps_uses_call_e(h.val, target) == 1 then 1 else ps_uses_call_recl(t, target)
fn ps_uses_call_arms(xs, target) = match xs
    Nil        => 0
    Cons(h, t) => if ps_uses_call_e(h.body, target) == 1 then 1 else ps_uses_call_arms(t, target)
fn ps_uses_call_s(s0, target) = match s0
    Fn(nm, ps, b) => ps_uses_call_e(b, target)
    Print(v)      => ps_uses_call_e(v, target)
    ExprS(v)      => ps_uses_call_e(v, target)
    _             => 0
fn ps_uses_call_prog(prog, target) = match prog
    Nil        => 0
    Cons(h, t) => if ps_uses_call_s(h, target) == 1 then 1 else ps_uses_call_prog(t, target)
fn ps_has_fn_prog(prog, fnm) = match prog
    Nil        => 0
    Cons(h, t) => ps_has_fn_s(h, fnm, t)
fn ps_has_fn_s(s0, fnm, t) = match s0
    Fn(nm, ps, b) => if nm == fnm then 1 else ps_has_fn_prog(t, fnm)
    _             => ps_has_fn_prog(t, fnm)
fn ps_has_dec_lit_e(e) = match e
    Rec(items)      => if is_dec_rec_items(items) == 1 then 1 else ps_has_dec_lit_recl(items)
    RecT(tn, items) => ps_has_dec_lit_recl(items)
    Bin(op, a, b)   => if ps_has_dec_lit_e(a) == 1 then 1 else ps_has_dec_lit_e(b)
    If(c, t, e2)    => if ps_has_dec_lit_e(c) == 1 then 1 else if ps_has_dec_lit_e(t) == 1 then 1 else ps_has_dec_lit_e(e2)
    LetIn(nm, v, b) => if ps_has_dec_lit_e(v) == 1 then 1 else ps_has_dec_lit_e(b)
    VarIn(nm, v, b) => if ps_has_dec_lit_e(v) == 1 then 1 else ps_has_dec_lit_e(b)
    Call(nm, args)  => ps_has_dec_lit_el(args)
    Match(sc, arms) => if ps_has_dec_lit_e(sc) == 1 then 1 else ps_has_dec_lit_arms(arms)
    _               => 0
fn ps_has_dec_lit_el(xs) = match xs
    Nil        => 0
    Cons(h, t) => if ps_has_dec_lit_e(h) == 1 then 1 else ps_has_dec_lit_el(t)
fn ps_has_dec_lit_recl(xs) = match xs
    Nil        => 0
    Cons(h, t) => if ps_has_dec_lit_e(h.val) == 1 then 1 else ps_has_dec_lit_recl(t)
fn ps_has_dec_lit_arms(xs) = match xs
    Nil        => 0
    Cons(h, t) => if ps_has_dec_lit_e(h.body) == 1 then 1 else ps_has_dec_lit_arms(t)
fn ps_has_dec_lit_s(s0) = match s0
    Fn(nm, ps, b) => ps_has_dec_lit_e(b)
    Print(v)      => ps_has_dec_lit_e(v)
    ExprS(v)      => ps_has_dec_lit_e(v)
    _             => 0
fn ps_has_dec_lit_prog(prog) = match prog
    Nil        => 0
    Cons(h, t) => if ps_has_dec_lit_s(h) == 1 then 1 else ps_has_dec_lit_prog(t)
fn ps_is_tydec(ty) = match ty
    TyDecimal(p, s) => 1
    TyRefine(b, p)  => ps_is_tydec(b)
    _               => 0
fn ps_has_tydec_list(xs) = match xs
    Nil        => 0
    Cons(h, t) => if ps_is_tydec(h) == 1 then 1 else ps_has_tydec_list(t)
fn ps_has_tydec_s(s0) = match s0
    Sig(nm, ps, ts, rt) => if ps_is_tydec(rt) == 1 then 1 else ps_has_tydec_list(ts)
    _                   => 0
fn ps_has_tydec_prog(prog) = match prog
    Nil        => 0
    Cons(h, t) => if ps_has_tydec_s(h) == 1 then 1 else ps_has_tydec_prog(t)
fn ps_fmt_stdlib() =
    let f_padl = Fn("__lume_pad_l", Cons("s", Cons("w", Cons("ch", Nil))), If(Bin(">=", Call("count", Cons(Var("s"), Nil)), Var("w")), Var("s"), Call("__lume_pad_l", Cons(Bin("+", Var("ch"), Var("s")), Cons(Var("w"), Cons(Var("ch"), Nil)))))) in
    let f_padr = Fn("__lume_pad_r", Cons("s", Cons("w", Cons("ch", Nil))), If(Bin(">=", Call("count", Cons(Var("s"), Nil)), Var("w")), Var("s"), Call("__lume_pad_r", Cons(Bin("+", Var("s"), Var("ch")), Cons(Var("w"), Cons(Var("ch"), Nil)))))) in
    let f_rad1 = Fn("__lume_radix1", Cons("n", Cons("b", Cons("dg", Nil))), If(Bin("==", Var("n"), Num(0)), Str(""), Bin("+", Call("__lume_radix1", Cons(Bin("/", Var("n"), Var("b")), Cons(Var("b"), Cons(Var("dg"), Nil)))), Call("at", Cons(Var("dg"), Cons(Bin("%", Var("n"), Var("b")), Nil)))))) in
    let f_rad  = Fn("__lume_radix", Cons("n", Cons("b", Cons("dg", Nil))), If(Bin("==", Var("n"), Num(0)), Str("0"), If(Bin("<", Var("n"), Num(0)), Bin("+", Str("-"), Call("__lume_radix1", Cons(Bin("-", Num(0), Var("n")), Cons(Var("b"), Cons(Var("dg"), Nil))))), Call("__lume_radix1", Cons(Var("n"), Cons(Var("b"), Cons(Var("dg"), Nil))))))) in
    let w_sub  = Call("toint", Cons(Call("slice", Cons(Var("spec"), Cons(Num(1), Cons(Call("count", Cons(Var("spec"), Nil)), Nil)))), Nil)) in
    let w_all  = Call("toint", Cons(Var("spec"), Nil)) in
    let c0_e   = Call("at", Cons(Var("spec"), Cons(Num(0), Nil))) in
    let cl_e   = Call("at", Cons(Var("spec"), Cons(Bin("-", Call("count", Cons(Var("spec"), Nil)), Num(1)), Nil))) in
    let rem_e  = Call("slice", Cons(Var("spec"), Cons(Num(0), Cons(Bin("-", Call("count", Cons(Var("spec"), Nil)), Num(1)), Nil)))) in
    let pad_e  = LetIn("c0", c0_e, If(Bin("==", Var("c0"), Str(">")), Call("__lume_pad_l", Cons(Var("s"), Cons(w_sub, Cons(Str(" "), Nil)))), If(Bin("==", Var("c0"), Str("<")), Call("__lume_pad_r", Cons(Var("s"), Cons(w_sub, Cons(Str(" "), Nil)))), If(Bin("==", Var("c0"), Str("^")), LetIn("w", w_sub, LetIn("n", Call("count", Cons(Var("s"), Nil)), If(Bin(">=", Var("n"), Var("w")), Var("s"), LetIn("l", Bin("/", Bin("-", Var("w"), Var("n")), Num(2)), Call("__lume_pad_r", Cons(Call("__lume_pad_l", Cons(Var("s"), Cons(Bin("+", Var("n"), Var("l")), Cons(Str(" "), Nil)))), Cons(Var("w"), Cons(Str(" "), Nil)))))))), If(Bin("==", Var("c0"), Str("0")), Call("__lume_pad_l", Cons(Var("s"), Cons(w_sub, Cons(Str("0"), Nil)))), If(Bin("==", Var("c0"), Str(".")), LetIn("w", w_sub, If(Bin("<=", Call("count", Cons(Var("s"), Nil)), Var("w")), Var("s"), Call("slice", Cons(Var("s"), Cons(Num(0), Cons(Var("w"), Nil)))))), If(Bin("and", Bin(">=", Var("c0"), Str("1")), Bin("<=", Var("c0"), Str("9"))), Call("__lume_pad_l", Cons(Var("s"), Cons(w_all, Cons(Str(" "), Nil)))), Var("s")))))))) in
    let f_fmt  = Fn("__lume_fmt", Cons("s", Cons("spec", Nil)), If(Bin("==", Var("spec"), Str("")), Var("s"), LetIn("cl", cl_e, LetIn("rem", rem_e, If(Bin("==", Var("cl"), Str("x")), Call("__lume_fmt", Cons(Call("__lume_radix", Cons(Call("toint", Cons(Var("s"), Nil)), Cons(Num(16), Cons(Str("0123456789abcdef"), Nil)))), Cons(Var("rem"), Nil))), If(Bin("==", Var("cl"), Str("X")), Call("__lume_fmt", Cons(Call("__lume_radix", Cons(Call("toint", Cons(Var("s"), Nil)), Cons(Num(16), Cons(Str("0123456789ABCDEF"), Nil)))), Cons(Var("rem"), Nil))), If(Bin("==", Var("cl"), Str("b")), Call("__lume_fmt", Cons(Call("__lume_radix", Cons(Call("toint", Cons(Var("s"), Nil)), Cons(Num(2), Cons(Str("01"), Nil)))), Cons(Var("rem"), Nil))), If(Bin("==", Var("cl"), Str("o")), Call("__lume_fmt", Cons(Call("__lume_radix", Cons(Call("toint", Cons(Var("s"), Nil)), Cons(Num(8), Cons(Str("01234567"), Nil)))), Cons(Var("rem"), Nil))), pad_e)))))))) in
    Cons(f_padl, Cons(f_padr, Cons(f_rad1, Cons(f_rad, Cons(f_fmt, Nil)))))
fn ps_mk_dec_rec(coeff_e, sc_e) = Rec(Cons({key: "coefficient", val: coeff_e}, Cons({key: "scale", val: sc_e}, Cons({key: "precision", val: Num(0)}, Nil))))
fn ps_dec_stdlib() =
    let f_pow = Fn("__lume_dpow10", Cons("n", Nil), If(Bin("<=", Var("n"), Num(0)), Num(1), Bin("*", Num(10), Call("__lume_dpow10", Cons(Bin("-", Var("n"), Num(1)), Nil))))) in
    let f_max = Fn("__lume_dmax", Cons("a", Cons("b", Nil)), If(Bin(">", Var("a"), Var("b")), Var("a"), Var("b"))) in
    let f_al  = Fn("__lume_dalign", Cons("x", Cons("t", Nil)), Bin("*", Field(Var("x"), "coefficient"), Call("__lume_dpow10", Cons(Bin("-", Var("t"), Field(Var("x"), "scale")), Nil)))) in
    let s_ab  = Call("__lume_dmax", Cons(Field(Var("a"), "scale"), Cons(Field(Var("b"), "scale"), Nil))) in
    let f_add = Fn("decimal_add", Cons("a", Cons("b", Nil)), LetIn("s", s_ab, ps_mk_dec_rec(Bin("+", Call("__lume_dalign", Cons(Var("a"), Cons(Var("s"), Nil))), Call("__lume_dalign", Cons(Var("b"), Cons(Var("s"), Nil)))), Var("s")))) in
    let f_sub = Fn("decimal_sub", Cons("a", Cons("b", Nil)), LetIn("s", s_ab, ps_mk_dec_rec(Bin("-", Call("__lume_dalign", Cons(Var("a"), Cons(Var("s"), Nil))), Call("__lume_dalign", Cons(Var("b"), Cons(Var("s"), Nil)))), Var("s")))) in
    let f_mul = Fn("decimal_mul", Cons("a", Cons("b", Nil)), ps_mk_dec_rec(Bin("*", Field(Var("a"), "coefficient"), Field(Var("b"), "coefficient")), Bin("+", Field(Var("a"), "scale"), Field(Var("b"), "scale")))) in
    let f_div = Fn("decimal_div", Cons("a", Cons("b", Nil)), If(Bin("==", Field(Var("b"), "coefficient"), Num(0)), Call("ctfail", Cons(Str("lume: decimal division by zero\n"), Nil)), LetIn("s", s_ab, ps_mk_dec_rec(Bin("/", Bin("*", Call("__lume_dalign", Cons(Var("a"), Cons(Var("s"), Nil))), Call("__lume_dpow10", Cons(Var("s"), Nil))), Call("__lume_dalign", Cons(Var("b"), Cons(Var("s"), Nil)))), Var("s"))))) in
    let f_cmp = Fn("decimal_compare", Cons("a", Cons("b", Nil)), LetIn("s", s_ab, LetIn("ra", Call("__lume_dalign", Cons(Var("a"), Cons(Var("s"), Nil))), LetIn("rb", Call("__lume_dalign", Cons(Var("b"), Cons(Var("s"), Nil))), If(Bin("<", Var("ra"), Var("rb")), Bin("-", Num(0), Num(1)), If(Bin(">", Var("ra"), Var("rb")), Num(1), Num(0))))))) in
    Cons(f_pow, Cons(f_max, Cons(f_al, Cons(f_add, Cons(f_sub, Cons(f_mul, Cons(f_div, Cons(f_cmp, Nil))))))))
fn expand_prog_sugar(prog) = if has_prog_sugar(prog) == 0 then prog else let tnames = ps_collect_tnames(prog) in let traits = ps_collect_traits(prog) in let prog1 = ps_validate_decls(prog, tnames, traits) in let recs = ps_collect_recs(prog1) in let sigs = ps_collect_sigs(prog1) in let allc = ps_all_cnames(prog1) in let consts = ps_collect_consts(prog1, Nil, recs, sigs, ps_is_freestanding(prog1), allc) in let prog2 = ps_exp_prog(prog1, {consts: consts, recs: recs, sigs: sigs}) in let prog3 = if ps_uses_call_prog(prog2, "__lume_fmt") == 1 and ps_has_fn_prog(prog2, "__lume_fmt") == 0 then app(ps_fmt_stdlib(), prog2) else prog2 in if ps_has_dec_lit_prog(prog3) == 1 and ps_has_tydec_prog(prog3) == 0 and ps_has_fn_prog(prog3, "decimal_add") == 0 then app(ps_dec_stdlib(), prog3) else prog3
fn parseprogram(s) = expand_prog_sugar(parseprog(lex(s, 0)))

## --- parser: named type declarations (F1) -----------------------------------------------------------------
## Inline, layout-free syntax (the lexer is indentation-blind, so the README's indented form is not used here):
##   type Dept = enum Sales | IT | Finance            -- a sum type (ADT), nullary variants
##   type Node = enum Nil | Cons(int, Node)            -- a variant with a typed, positional payload
##   type Point = record x: int, y: int                -- a product type with named, typed fields
## A field/payload type `T` is `int`, `str`, a declared type name, or `[T]` (a list of T). Like `match`, the
## parts are delimited by LOOKAHEAD: enum variants continue while the next token is `|`, record fields while it
## is `,`; the declaration ends as soon as the separator is absent, leaving the stream on the next statement
## (`fn` / `print` / `type` / an expression). A declaration lowers to a `TypeS(name, kind, items)` statement that
## emits NO code (compile-time information only); `kind` is "enum" (items are `{tag, ar}`) or "record" (items are
## `{fname, fty}`). The `enum` keyword is optional (so `type T = A | B` is accepted); anything that is not
## `record` is parsed as an enum. Type expressions are kept (`TyName`/`TyList`); F2 checks them against call arguments.
fn skiptp1(ts, close, d) = if d <= 0 then ts else if isnil(ts) == 1 then Nil else if headtext(ts) == "[" or headtext(ts) == "(" then skiptp1(droponce(ts), close, d + 1) else if headtext(ts) == close then skiptp1(droponce(ts), close, d - 1) else skiptp1(droponce(ts), close, d)
fn skiptypeparams(ts) = if headtext(ts) == "[" then skiptp1(droponce(ts), "]", 1) else if headtext(ts) == "(" then skiptp1(droponce(ts), ")", 1) else ts
fn parsetype(t) = parsetypebody(headtext(t), dropkw(skiptypeparams(droponce(t)), "="))
fn parserefinety(nm, t) = let bty = TyName(headtext(t)) in let pr = expr(droponce(droponce(t))) in {node: TypeRefineS(nm, bty, pr.node), inv: Nil, rest: pr.rest}
fn parserefinebrace(nm, t) = let t1 = droponce(t) in let bty = TyName(headtext(droponce(droponce(t1)))) in let pr = expr(dropkw(droponce(droponce(droponce(t1))), "|")) in {node: TypeRefineS(nm, bty, pr.node), inv: Nil, rest: skiprb(pr.rest)}
fn parsetypebody(nm, t) = if headtext(t) == "record" or headtext(t) == "model" then parserecordty(nm, droponce(t)) else if headtext(t) == "{" and headtext(droponce(droponce(droponce(droponce(t))))) == "|" then parserefinebrace(nm, t) else if headtext(t) == "{" and headtext(droponce(droponce(t))) == ":" then parserecordty(nm, t) else if headtext(droponce(t)) == "where" then parserefinety(nm, t) else if isbasealias(t) == 1 then {node: TypeRefineS(nm, TyName(headtext(t)), Num(1)), inv: Nil, rest: droponce(t)} else parseenumty(nm, dropkw(t, "enum"))
fn isbasealias(t) = if (headtext(t) == "int" or headtext(t) == "str" or headtext(t) == "bool") and headtext(droponce(t)) != "|" and headtext(droponce(t)) != "(" then 1 else 0
fn check_dup_variants(vs, seen) = match vs
    Nil        => 0
    Cons(h, t) => if ps_has_str(h.tag, seen) == 1 then ctfail("lume: declaration error [D0002]: duplicate enum variant '" + h.tag + "'\n") else check_dup_variants(t, Cons(h.tag, seen))
fn check_dup_fields(fs, seen) = match fs
    Nil        => 0
    Cons(h, t) => if ps_has_str(h.fname, seen) == 1 then ctfail("lume: declaration error [D0002]: duplicate record field '" + h.fname + "'\n") else check_dup_fields(t, Cons(h.fname, seen))
fn parseenumty(nm, t) = let hb = if headtext(t) == "{" then 1 else 0 in parseenumty2(nm, hb, parsevariants(dropkw(dropkw(t, "{"), "|")))
fn parseenumty2(nm, hb, vs) = let u = check_dup_variants(vs.items, Nil) in {node: TypeS(nm, "enum", vs.items), inv: Nil, rest: if hb == 1 then skiprb(vs.rest) else vs.rest}
fn parsevariants(ts) = parsevariant(headtext(ts), droponce(ts))
fn parsevariant(tag, ts) = if headtext(ts) == "(" then parsevariantp(tag, parsevpayload(droponce(ts))) else parsevariantend(tag, 0, TyAny, Nil, ts)
## F4 (front-end unification, slice 1): an enum variant payload accepts BOTH the Lume-Core positional form
## `Cons(int, Node)` and the surface form with NAMED fields `Cons(value: int, next: Node)`. A leading `name :`
## is consumed and discarded, so both forms lower to the SAME `{tag, ar}` AST (arity = field count) and emit
## byte-identical code -- the surface and the core share one grammar here. A positional payload (every existing
## `.src`, lumec.src included) parses exactly as before, so the self-host fixpoint is untouched.
fn parsevpayload(ts) = if headtext(ts) == ")" then {items: Nil, rest: droponce(ts)} else parsevpmore(parsevpfield(ts))
fn parsevpfield(ts) = if headtext(droponce(ts)) == ":" then parsetype1(droponce(droponce(ts))) else parsetype1(ts)
fn parsevpmore(r) = if headtext(r.rest) == "," then parsevpcons(r.node, parsevpayload(droponce(r.rest))) else {items: Cons(r.node, Nil), rest: skiprp(r.rest)}
fn parsevpcons(n, rr) = {items: Cons(n, rr.items), rest: rr.rest}
fn vphd(xs) = match xs
    Nil        => TyAny
    Cons(h, t) => h
fn parsevariantp(tag, a) = parsevariantend(tag, len(a.items), if len(a.items) == 1 then vphd(a.items) else TyAny, a.items, a.rest)
fn parsevariantend(tag, ar, pty, ptys, ts) requires ar >= 0 ensures isnil(result.items) == 0 = if headtext(ts) == "|" then parsevariantcons(tag, ar, pty, ptys, parsevariants(droponce(ts))) else {items: Cons({tag: tag, ar: ar, pty: pty, ptys: ptys}, Nil), rest: ts}
fn parsevariantcons(tag, ar, pty, ptys, rr) = {items: Cons({tag: tag, ar: ar, pty: pty, ptys: ptys}, rr.items), rest: rr.rest}
fn parserecordty(nm, t) = let hb = if headtext(t) == "{" then 1 else 0 in parserecordty2(nm, hb, parsefields(dropkw(t, "{")))
fn parserecordty2(nm, hb, fs) = let u = check_dup_fields(fs.items, Nil) in if hb == 1 and headtext(fs.rest) == "invariant" then (let inv = expr(droponce(fs.rest)) in {node: TypeS(nm, "record", fs.items), inv: VTypeInvariant(nm, fs.items, inv.node), rest: skiprb(inv.rest)}) else let rest1 = if hb == 1 then skiprb(fs.rest) else fs.rest in if headtext(rest1) == "invariant" then (let inv = expr(droponce(rest1)) in {node: TypeS(nm, "record", fs.items), inv: VTypeInvariant(nm, fs.items, inv.node), rest: inv.rest}) else {node: TypeS(nm, "record", fs.items), inv: Nil, rest: rest1}
fn parsefields(ts) = parsefield(headtext(ts), dropkw(droponce(ts), ":"))
fn parsefield(fname, ts) = parsefieldt(fname, parsetype1(ts))
fn isfieldsep(ts) = headtext(ts) == "," or headtext(ts) == ";"
fn isnextfield(ts) = headtext(ts) != "" and headtext(ts) != "}" and headtext(droponce(ts)) == ":"
fn parsefieldt(fname, r) = if isfieldsep(r.rest) then (if isnextfield(droponce(r.rest)) then parsefieldcons(fname, r.node, parsefields(droponce(r.rest))) else {items: Cons({fname: fname, fty: r.node}, Nil), rest: droponce(r.rest)}) else if isnextfield(r.rest) then parsefieldcons(fname, r.node, parsefields(r.rest)) else {items: Cons({fname: fname, fty: r.node}, Nil), rest: r.rest}
fn parsefieldcons(fname, fty, rr) = {items: Cons({fname: fname, fty: fty}, rr.items), rest: rr.rest}
fn parsetypelist(ts) = if headtext(ts) == ")" then {items: Nil, rest: droponce(ts)} else parsetypemore(parsetype1(ts))
fn parsetypemore(r) = if headtext(r.rest) == "," then parsetypecons(r.node, parsetypelist(droponce(r.rest))) else {items: Cons(r.node, Nil), rest: skiprp(r.rest)}
fn parsetypecons(n, rr) = {items: Cons(n, rr.items), rest: rr.rest}
fn istyapp1(nm) = nm == "table" or nm == "rc" or nm == "arc" or nm == "weak" or nm == "promise" or nm == "signal" or nm == "cell" or nm == "chan" or nm == "Ref" or nm == "View" or nm == "unverified" or nm == "cap"
fn parsedims(ts) = if headtext(ts) == "]" then {items: Nil, rest: droponce(ts)} else let d = headtext(ts) in let t1 = droponce(ts) in if headtext(t1) == "," then let rr = parsedims(droponce(t1)) in {items: Cons(d, rr.items), rest: rr.rest} else {items: Cons(d, Nil), rest: skiprk(t1)}
fn parsetypetensor(ts) = let et = parsetype1(ts) in if headtext(et.rest) == "," then let ds = parsedims(droponce(et.rest)) in {node: TyTensor(et.node, ds.items), rest: ds.rest} else {node: TyTensor(et.node, Nil), rest: skiprk(et.rest)}
fn parsetyperec(ts) = if headtext(ts) == "}" then {node: TyRec(Nil), rest: droponce(ts)} else let fs = parsefields(ts) in {node: TyRec(fs.items), rest: skiprb(fs.rest)}
fn parsetype1(ts) = if headtext(ts) == "[" then parsetypelistof(parsetype1(droponce(ts))) else if headtext(ts) == "{" then parsetyperec(droponce(ts)) else if headtext(ts) == "decimal" and headtext(droponce(ts)) == "(" then parsetypedecimal(droponce(droponce(ts))) else if headtext(ts) == "tensor" and headtext(droponce(ts)) == "[" then parsetypetensor(droponce(droponce(ts))) else if headtext(ts) != "" and headtext(droponce(ts)) == "[" then parsetypeapp(headtext(ts), droponce(droponce(ts))) else {node: TyName(headtext(ts)), rest: droponce(ts)}
fn parsetypelistof(r) = {node: TyList(r.node), rest: skiprk(r.rest)}
fn parsetypeapp(kind, ts) = parsetypeapp2(kind, parsetype1(ts))
fn parsetypeapp2(kind, r) = {node: TyApply(kind, r.node), rest: skiprk(r.rest)}
fn parsetypedecimal(ts) = let p = toint(headtext(ts)) in let s = toint(headtext(droponce(droponce(ts)))) in let rest = skiprp(droponce(droponce(droponce(ts)))) in parsetypedecimal2(p, s, rest)
fn parsetypedecimal2(p, s, rest) requires p >= 0 requires s >= 0 = if p < 1 or p > 18 or s < 0 or s > p then ctfail("lume: type error: decimal annotation requires 1 <= precision <= 18 and 0 <= scale <= precision\n") else {node: TyDecimal(p, s), rest: rest}
fn skiprk(ts) = if headtext(ts) == "]" then droponce(ts) else ctfail("lume: parse error [P0002]: expected ']' " + headpos(ts) + "\n")

