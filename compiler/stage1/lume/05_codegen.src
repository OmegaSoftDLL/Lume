## --- program analysis vs. emission split (incremental compilation, #310): `lgen_analysis` walks the
## (already checked/expanded) program and produces every text piece and whole-program flag; `lgen_emit`
## assembles the final assembly from those pieces. The single-unit driver `lgen` is exactly
## `lgen_emit(lgen_analysis(prog0, ""))` — an empty label prefix reproduces the historical output
## byte-for-byte. Module mode runs `lgen_analysis(prog, "<module>-scoped prefix")` and caches the pieces.
fn lgen_analysis(prog0, pfx) = let ffi_osigs = lcollect_ffi_osigs(prog0, prog0) in let ffi_links = lcollect_ffi_links(prog0) in let is_krn = lhas_free_osig(prog0) in let isr_fn = lfind_isr_fn(prog0) in let prog = if isnil(ffi_osigs) == 1 then prog0 else lffi_rw_prog(prog0, ffi_osigs) in let has_sys = if is_krn == 1 or isr_fn != "" or luses_sys_prog(prog) == 1 then 1 else 0 in let has_tier = luses_tier_prog(prog) in let has_mem = if is_krn == 1 then 0 else luses_mem_prog(prog) in let uses_fs = luses_fs_prog(prog) in let mlocals = app(lmlocals(prog), lsds(0, lmdprog(prog))) in let s0 = {nl: 0, ns: 0, dt: Nil, pfx: pfx, cts: lct_names(prog0)} in let gs = lstmts(prog, mlocals, if has_mem == 1 then lhs_seed(s0) else s0) in let funcs_l = gs.funcs in let mains_l = gs.mains in {prog: prog, ffi_osigs: ffi_osigs, ffi_links: ffi_links, is_krn: is_krn, isr_fn: isr_fn, has_sys: has_sys, has_tier: has_tier, has_mem: has_mem, uses_fs: uses_fs, mframe: lframe(len(mlocals)), dt_s: ldt_text(gs.dt), relink: 0, funcs_raw: joinall(own funcs_l), mains_s: joinall(own mains_l)}
