## does the program call an f64 builtin (or pass one as a value)? Then its runtime carries the f64 code (rt_f64).

fn lis_f64_name(nm) = count(nm) >= 3 and slice(nm, 0, 3) == "f64" and (count(nm) == 3 or at(nm, 3) == "_")
fn luses_f64_prog(prog) = match prog
    Nil        => 0
    Cons(h, t) => if luses_f64_stmt(h) == 1 then 1 else luses_f64_prog(t)
fn luses_f64_expr(e) = match e
    Call(nm, args)  => if lis_f64_name(nm) then 1 else luses_f64_args(args)
    Var(nm)         => if lis_f64_name(nm) then 1 else 0
    LetIn(nm, v, b) => if luses_f64_expr(v) == 1 then 1 else luses_f64_expr(b)
    Bin(op, l, r)   => if luses_f64_expr(l) == 1 then 1 else luses_f64_expr(r)
    If(c, t, e2)    => if luses_f64_expr(c) == 1 or luses_f64_expr(t) == 1 then 1 else luses_f64_expr(e2)
    Field(o, nm)    => luses_f64_expr(o)
    Rec(items)      => luses_f64_rec(items)
    RecT(tn, items) => luses_f64_rec(items)
    Match(sc, arms) => if luses_f64_expr(sc) == 1 then 1 else luses_f64_arms(arms)
    _               => 0
fn luses_f64_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_f64_expr(h) == 1 then 1 else luses_f64_args(t)
fn luses_f64_rec(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_f64_expr(h.val) == 1 then 1 else luses_f64_rec(t)
fn luses_f64_arms(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_f64_expr(h.body) == 1 then 1 else luses_f64_arms(t)
fn luses_f64_stmt(s0) = match s0
    Fn(nm, ps, body) => luses_f64_expr(body)
    Print(v)         => luses_f64_expr(v)
    ExprS(v)         => luses_f64_expr(v)
    _                => 0

## does the program call a native crypto builtin (crypto_*)? Then its runtime carries rt_crypto and its K table.

fn lis_crypto_name(nm) = count(nm) > 7 and slice(nm, 0, 7) == "crypto_"
## the optional runtime part also carries the SSE2 block-distortion builtins (rt/rt_simd.src)
fn lis_optrt_name(nm) = lis_crypto_name(nm) or (count(nm) > 7 and slice(nm, 0, 7) == "buf_sad") or (count(nm) > 8 and slice(nm, 0, 8) == "buf_satd") or (count(nm) > 9 and slice(nm, 0, 9) == "buf_h264_") or (count(nm) > 9 and slice(nm, 0, 9) == "buf_bits_")
fn luses_crypto_prog(prog) = match prog
    Nil        => 0
    Cons(h, t) => if luses_crypto_stmt(h) == 1 then 1 else luses_crypto_prog(t)
fn luses_crypto_expr(e) = match e
    Call(nm, args)  => if lis_optrt_name(nm) then 1 else luses_crypto_args(args)
    Var(nm)         => if lis_optrt_name(nm) then 1 else 0
    LetIn(nm, v, b) => if luses_crypto_expr(v) == 1 then 1 else luses_crypto_expr(b)
    Bin(op, l, r)   => if luses_crypto_expr(l) == 1 then 1 else luses_crypto_expr(r)
    If(c, t, e2)    => if luses_crypto_expr(c) == 1 or luses_crypto_expr(t) == 1 then 1 else luses_crypto_expr(e2)
    Field(o, nm)    => luses_crypto_expr(o)
    Rec(items)      => luses_crypto_rec(items)
    RecT(tn, items) => luses_crypto_rec(items)
    Match(sc, arms) => if luses_crypto_expr(sc) == 1 then 1 else luses_crypto_arms(arms)
    _               => 0
fn luses_crypto_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_crypto_expr(h) == 1 then 1 else luses_crypto_args(t)
fn luses_crypto_rec(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_crypto_expr(h.val) == 1 then 1 else luses_crypto_rec(t)
fn luses_crypto_arms(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_crypto_expr(h.body) == 1 then 1 else luses_crypto_arms(t)
fn luses_crypto_stmt(s0) = match s0
    Fn(nm, ps, body) => luses_crypto_expr(body)
    Print(v)         => luses_crypto_expr(v)
    ExprS(v)         => luses_crypto_expr(v)
    _                => 0

fn luses_mem_prog(prog) = match prog
    Nil        => 0
    Cons(h, t) => if luses_mem_stmt(h) == 1 then 1 else luses_mem_prog(t)
fn luses_mem_expr(e) = match e
    Call(nm, args)  => if lis_mem_call(nm) then 1 else luses_mem_args(args)
    LetIn(nm, v, b) => if luses_mem_expr(v) == 1 then 1 else luses_mem_expr(b)
    Bin(op, l, r)   => if luses_mem_expr(l) == 1 then 1 else luses_mem_expr(r)
    If(c, t, e2)    => if luses_mem_expr(c) == 1 or luses_mem_expr(t) == 1 then 1 else luses_mem_expr(e2)
    Field(o, nm)    => luses_mem_expr(o)
    Rec(items)      => luses_mem_rec(items)
    RecT(tn, items) => luses_mem_rec(items)
    Match(sc, arms) => if luses_mem_expr(sc) == 1 then 1 else luses_mem_arms(arms)
    _               => 0
fn luses_mem_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_mem_expr(h) == 1 then 1 else luses_mem_args(t)
fn luses_mem_rec(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_mem_expr(h.val) == 1 then 1 else luses_mem_rec(t)
fn luses_mem_arms(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_mem_expr(h.body) == 1 then 1 else luses_mem_arms(t)
fn luses_mem_stmt(s0) = match s0
    Fn(nm, ps, body) => luses_mem_expr(body)
    Print(v)         => luses_mem_expr(v)
    ExprS(v)         => luses_mem_expr(v)
    _                => 0
fn lhas_free_osig(prog) = match prog
    Nil        => 0
    Cons(h, t) => if lis_free_osig1(h) == 1 then 1 else lhas_free_osig(t)
fn lis_free_osig1(s0) = match s0
    OSig(nm, pubf, freef, pl, rty, fromp) => if freef % 2 == 1 and nm == "kernel_boot_entry" then 1 else 0
    _                                     => 0
fn lfind_isr_fn(prog) = match prog
    Nil        => ""
    Cons(h, t) => let s = lfind_isr_fn1(h) in if s != "" then s else lfind_isr_fn(t)
fn lfind_isr_fn1(s0) = match s0
    OSig(nm, pubf, freef, pl, rty, fromp) => if (freef / 16) % 2 == 1 then nm else ""
    _                                     => ""
