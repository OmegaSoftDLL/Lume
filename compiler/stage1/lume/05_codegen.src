## --- code generator: x86-64 asm for the core (port of lcgen.lume, R6a; strings/records/ctors R6b) ---
## Same output shape as `agen` in data_asmgen.lume for fn/print statements over Num/Var/Bin/Call/If/LetIn/Str/Rec/Field.
## No mutation: the state {nl, ns, dt} (label counter, string-label counter, rodata chunks) is threaded through
## every call and returned in {code, nl, ns, dt}; the per-function context is the immutable record {locals, bound}.
## List/index nodes are out of scope; any unsupported AST node aborts compilation via ctfail ([C0001]). Output is joined pairwise
## (O(n log k)), never grown with a long right-nested `+` chain.

## --- list helpers ---
fn app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, app(t, ys))
fn len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + len(t)
fn isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn drop(xs, k) = if k <= 0 then xs else drop2(xs, k)
fn drop2(xs, k) = match xs
    Nil        => Nil
    Cons(h, t) => drop(t, k - 1)
fn revacc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => revacc(t, Cons(h, acc))
fn rev(xs) = revacc(xs, Nil)
fn pairs(own xs) = match xs
    Nil        => Nil
    Cons(a, t) => pairs2(a, own t)
fn pairs2(a, own t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, pairs(own r))
fn joinall(own xs) = match xs
    Nil        => ""
    Cons(a, t) => if isnil(t) == 1 then a else joinall(own pairs2(a, own t))

## --- registers, operators, frame slots ---
fn areg(i) = if i == 0 then "%rdi" else if i == 1 then "%rsi" else if i == 2 then "%rdx" else if i == 3 then "%rcx" else if i == 4 then "%r8" else "%r9"
fn lidxfrom(xs, name, i) = match xs
    Nil        => 0 - 1
    Cons(h, t) => if h == name then i else lidxfrom(t, name, i + 1)
fn lidxof(xs, name) = lidxfrom(xs, name, 0)
fn lslot(k) = str(0 - 8 * (k + 1))
fn lframe(n) = if (n * 8) % 16 != 0 then n * 8 + 8 else n * 8

## --- let-bound names reachable in an expression, in agen's collect_lets order ---
fn lqvar(e) = match e
    Var(nm) => nm
    Str(nm) => nm
    _       => "_qk"
fn lcollect_quant(args) = match args
    Cons(h, t) => Cons(lqvar(h), lcollectargs(t))
    _          => Nil
fn lcollect(e) = match e
    LetIn(nm, v, b) => Cons(nm, app(lcollect(v), lcollect(b)))
    Bin(op, l, r)   => app(lcollect(l), lcollect(r))
    If(c, t, e2)    => app(lcollect(c), app(lcollect(t), lcollect(e2)))
    Call(nm, args)  => if (nm == "forall_range" or nm == "exists_range") and len(args) == 4 then lcollect_quant(args) else lcollectargs(args)
    Field(o, nm)    => lcollect(o)
    Rec(items)      => lcollectrec(items)
    RecT(tn, items) => lcollectrec(items)
    Match(sc, arms) => app(lcollect(sc), lcollectarms(arms))
    _               => Nil
fn lcollectargs(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lcollect(h), lcollectargs(t))
fn lcollectrec(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lcollect(h.val), lcollectrec(t))
fn lcollectarms(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lpatbinds(h.pat), app(lcollect(h.body), lcollectarms(t)))

## --- patterns: the names a pattern binds (frame slots), and match nesting depth (scrutinee slots _sd<k>) ---
fn lpatbinds(p) = match p
    PBind(nm)       => Cons(nm, Nil)
    PCons(tag, subs) => lpatbindsl(subs)
    _               => Nil
fn lpatbindsl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => app(lpatbinds(h), lpatbindsl(t))
fn imax(a, b) ensures result >= a ensures result >= b = if a > b then a else b
fn lmdepth(e) = match e
    Match(sc, arms) => imax(lmdepth(sc), lmdarms(arms)) + 1
    If(c, t, e2)    => imax(lmdepth(c), imax(lmdepth(t), lmdepth(e2)))
    Bin(op, l, r)   => imax(lmdepth(l), lmdepth(r))
    LetIn(nm, v, b) => imax(lmdepth(v), lmdepth(b))
    Call(nm, args)  => lmdargs(args)
    Field(o, nm)    => lmdepth(o)
    Rec(items)      => lmdrec(items)
    RecT(tn, items) => lmdrec(items)
    _               => 0
fn lmdarms(xs) = match xs
    Nil        => 0
    Cons(h, t) => imax(lmdepth(h.body), lmdarms(t))
fn lmdargs(xs) = match xs
    Nil        => 0
    Cons(h, t) => imax(lmdepth(h), lmdargs(t))
fn lmdrec(xs) = match xs
    Nil        => 0
    Cons(h, t) => imax(lmdepth(h.val), lmdrec(t))
fn lsds(i, n) = if i >= n then Nil else Cons("_sd" + str(i), lsds(i + 1, n))

## --- binary operators ---
fn lsetc(op) = if op == ">" then "    setg %al\n" else if op == "<=" then "    setle %al\n" else if op == ">=" then "    setge %al\n" else "    setl %al\n"

fn ldec_key(items, key) = match items
    Nil        => 0
    Cons(h, t) => if h.key == key then 1 else ldec_key(t, key)
fn ldec_name(names, name) = match names
    Nil        => 0
    Cons(h, t) => if h == name then 1 else ldec_name(t, name)
fn ldec_remove(names, name) = match names
    Nil        => Nil
    Cons(h, t) => if h == name then ldec_remove(t, name) else Cons(h, ldec_remove(t, name))
fn ldec_expr(e, names) = match e
    Rec(items)    => len(items) == 3 and ldec_key(items, "coefficient") == 1 and ldec_key(items, "scale") == 1 and ldec_key(items, "precision") == 1
    Call(nm, args) => nm == "decimal" or nm == "decimal_make" or nm == "decimal_parse" or nm == "decimal_cast" or nm == "decimal_div_exact" or nm == "decimal_add" or nm == "decimal_sub" or nm == "decimal_mul" or nm == "decimal_div"
    Var(nm)       => ldec_name(names, nm)
    Bin(op, a, b) => (op == "+" or op == "-" or op == "*" or op == "/") and ldec_expr(a, names) and ldec_expr(b, names)
    If(c, t, e2) => ldec_expr(t, names) or ldec_expr(e2, names)
    LetIn(nm, v, body) => ldec_expr(body, if ldec_expr(v, names) then Cons(nm, ldec_remove(names, nm)) else ldec_remove(names, nm))
    VarIn(nm, v, body) => ldec_expr(body, if ldec_expr(v, names) then Cons(nm, ldec_remove(names, nm)) else ldec_remove(names, nm))
    _             => 0
fn ldec_tail(op) = if op == "+" then "    call decimal_add\n" else if op == "-" then "    call decimal_sub\n" else if op == "*" then "    call decimal_mul\n" else if op == "/" then "    call decimal_div\n" else "    call decimal_compare\n    cmpq $1, %rax\n" + (if op == "==" then "    sete %al\n" else if op == "!=" then "    setne %al\n" else lsetc(op)) + "    movzbq %al, %rax\n    leaq 1(%rax,%rax), %rax\n"

## --- state and results ---
## The threaded state is the record {nl, ns, dt}: nl = next free code label, ns = next free string label,
## dt = rodata chunks emitted so far (newest first). Every result is {code, nl, ns, dt}, so a result IS the
## next state and is passed straight to the following sibling; lres copies the state fields into a result.
## `cts` is the list of constant-time kernels of the program (functions that carry both `@secret` and `@no_alloc`,
## see lct_* below); it never changes during a compilation and rides along in every state so that a call site can
## tell whether its callee is a kernel.
fn lres(code, s) = {code: code, nl: s.nl, ns: s.ns, dt: s.dt, pfx: s.pfx, cts: s.cts}
fn lnext(s) = {nl: s.nl + 1, ns: s.ns, dt: s.dt, pfx: s.pfx, cts: s.cts}

## --- constructors (ML-core convention: a capitalised identifier is a constructor) ---
fn isctor(name) = let c = at(name, 0) in c >= "A" and c <= "Z"

## --- string literals: escape for .asciz and emit a .rodata label (port of sesc / strlabel) ---
fn lsesc1(c) = if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then "\\n" else if c == "\t" then "\\t" else if c == "\r" then "\\r" else c
fn lsescl(s, i, n) = if i >= n then Nil else Cons(lsesc1(at(s, i)), lsescl(s, i + 1, n))
fn lsesc(s) = joinall(own lsescl(s, 0, count(s)))
## --- value words (the note above rt_boxes in runtime_core.lume): integers of 63 bits and strings of at most 7
## bytes are the word itself; constructors without fields, the descriptors and the longer literals are static. ---
fn lfits32(n) = n >= 0 - 2147483648 and n <= 2147483647
fn lfits63b(n) = n >= 0 - 4611686018427387904 and n <= 4611686018427387903
fn lfits63(n) = if lfits32(n) then 1 else lfits63b(n)
fn lintword(n) = n + n + 1
fn lnum(n, reg) = if lfits63(n) then "    movq $" + str(lintword(n)) + ", " + reg + "\n" else "    movq $" + str(n) + ", %rdi\n    call mkint\n"
fn lsso_bytes(s, i, acc) = if i < 0 then acc else lsso_bytes(s, i - 1, acc * 256 + ord(at(s, i)))
fn lsso_top(b, low) = low + (if b >= 128 then b - 256 else b) * 72057594037927936
fn lsso_word(s, n) = let k = if n > 6 then 6 else n in let low = lsso_bytes(s, k - 1, 0) * 256 + n * 8 + 2 in if n == 7 then lsso_top(ord(at(s, 6)), low) else low

## --- rodata: every entry is one {l: label, t: text}; a label is a pure function of the content, so a literal, a
## descriptor or a key used a thousand times (or by several modules) is stored once. Two different texts under the
## same label stop the compilation: a hash collision must never become wrong data. ---
fn lentry(lab, txt, s) = {lab: lab, nl: s.nl, ns: s.ns, dt: Cons({l: lab, t: txt}, s.dt), pfx: s.pfx, cts: s.cts}
fn lhash1(s, i, n, h) = if i >= n then h else lhash1(s, i + 1, n, (h * 131 + ord(at(s, i))) % 2147483647)
fn lhash2(s, i, n, h) = if i >= n then h else lhash2(s, i + 1, n, (h * 137 + ord(at(s, i))) % 2147483629)
fn lhashlab(s) = let n = count(s) in str(n) + "_" + str(lhash1(s, 0, n, 7)) + "_" + str(lhash2(s, 0, n, 11))
fn lstrcell(v, n, s) = let lab = ".Ls_" + lhashlab(v) in lentry(lab, "    .balign 8\n" + lab + ":\n    .quad " + str(n * 256 + 1) + "\n    .asciz \"" + lsesc(v) + "\"\n", s)
fn lstrload(v, reg, s) = let n = count(v) in if n <= 7 then lres("    movq $" + str(lsso_word(v, n)) + ", " + reg + "\n", s) else lstrload2(lstrcell(v, n, s), reg)
fn lstrload2(c, reg) = lres("    leaq " + c.lab + "(%rip), " + reg + "\n", c)
fn lctordesc(nm, n, s) = let lab = "__c_" + nm + "_" + str(n) in lentry(lab, "    .balign 8\n" + lab + ":\n    .quad " + lab + "\n    .quad " + str(n * 256 + 2) + "\n    .asciz \"" + nm + "\"\n", s)
fn lkey(nm, s) = let lab = "__k_" + nm in lentry(lab, "    .balign 8\n" + lab + ":\n    .asciz \"" + nm + "\"\n", s)
fn lshape_keys(items, s) = match items
    Nil        => {txt: "", names: "", st: s}
    Cons(h, t) => lshape_keys2(h.key, lkey(h.key, s), t)
fn lshape_keys2(nm, k, t) = let r = lshape_keys(t, k) in {txt: "    .quad " + k.lab + "\n" + r.txt, names: nm + "," + r.names, st: r.st}
fn lshape(items, n, s) = let r = lshape_keys(items, s) in let lab = "__r_" + lhashlab(r.names) in lentry(lab, "    .balign 8\n" + lab + ":\n    .quad " + lab + "\n    .quad " + str(n * 256 + 4) + "\n" + r.txt, r.st)
fn lhs_seed(s) = let a = lkey("used", s) in let b = lkey("cap", a) in let c = lkey("allocs", b) in lentry("__r_hs", "    .balign 8\n__r_hs:\n    .quad __r_hs\n    .quad 772\n    .quad __k_used\n    .quad __k_cap\n    .quad __k_allocs\n", c)
fn ldt_merge(a, b) = match a
    Nil        => b
    Cons(h, t) => ldt_merge2(h, t, b)
fn ldt_merge2(h, t, b) = match b
    Nil          => Cons(h, t)
    Cons(h2, t2) => if h.l <= h2.l then Cons(h, ldt_merge(t, b)) else Cons(h2, ldt_merge2(h, t, t2))
fn ldt_pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => ldt_pairs2(a, t)
fn ldt_pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(ldt_merge(a, b), ldt_pairs(r))
fn ldt_rounds(xs) = match xs
    Nil        => Nil
    Cons(a, t) => if isnil(t) == 1 then a else ldt_rounds(ldt_pairs(xs))
fn ldt_singles(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(Cons(h, Nil), ldt_singles(t))
fn ldt_uniq(xs) = match xs
    Nil        => Nil
    Cons(h, t) => ldt_uniq2(h, t)
fn ldt_uniq2(a, t) = match t
    Nil        => Cons(a.t, Nil)
    Cons(b, r) => if a.l == b.l then ldt_uniq3(a, b, r) else Cons(a.t, ldt_uniq2(b, r))
fn ldt_uniq3(a, b, r) = if a.t == b.t then ldt_uniq2(a, r) else ctfail("lume: codegen error [C0001]: two rodata entries share the label " + a.l + "\n")
fn ldt_text(dt) = joinall(own ldt_uniq(ldt_rounds(ldt_singles(dt))))
## link step: the fragments of several modules are text again, so they are split back into entries
fn ldt_nl(s, n, i) = if i >= n then n else if at(s, i) == "\n" then i else ldt_nl(s, n, i + 1)
fn ldt_lines(s, n, i) = if i >= n then Nil else let e = ldt_nl(s, n, i) in Cons(slicen(s, n, i, e), ldt_lines(s, n, e + 1))
fn ldt_parse(lines) = match lines
    Nil        => Nil
    Cons(h, t) => if h == "    .balign 8" then ldt_parse2(t) else ldt_parse(t)
fn ldt_parse2(lines) = match lines
    Nil        => Nil
    Cons(h, t) => ldt_body(h, t, "    .balign 8\n" + h + "\n")
fn ldt_body(lab, lines, acc) = match lines
    Nil        => Cons({l: lab, t: acc}, Nil)
    Cons(h, t) => if h == "    .balign 8" then Cons({l: lab, t: acc}, ldt_parse2(t)) else ldt_body(lab, t, acc + h + "\n")
fn ldt_relink(text) = joinall(own ldt_uniq(ldt_rounds(ldt_singles(ldt_parse(ldt_lines(text, count(text), 0))))))

## --- calls: left-to-right arg evaluation (including 7th+ stack args), register pops ---
fn lstackargs(xs, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => lstackmore(laexpr(h, ctx, s), t, ctx)
fn lstackmore(a, t, ctx) = let rest = lstackargs(t, ctx, a) in lres(a.code + rest.code, rest)
fn lstackltr(xs, k, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => lstackltr2(laexpr(h, ctx, s), t, k, ctx)
fn lstackltr2(a, t, k, ctx) = let store = "    popq %rax\n    movq %rax, " + str(48 + k * 8) + "(%rsp)\n" in let rest = lstackltr(t, k + 1, ctx, a) in lres(a.code + store + rest.code, rest)
fn lregargs(xs, q, m, ctx, s) = if q >= m then lres("", s) else lregargs2(xs, q, m, ctx, s)
fn lregargs2(xs, q, m, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => lregmore(laexpr(h, ctx, s), t, q, m, ctx)
fn lregmore(a, t, q, m, ctx) = let rest = lregargs(t, q + 1, m, ctx, a) in lres(a.code + rest.code, rest)
fn lpops(i) = if i < 0 then "" else "    popq " + areg(i) + "\n" + lpops(i - 1)
fn lpopslots(i) = if i < 0 then "" else "    popq %rax\n    movq %rax, " + lslot(i) + "(%rbp)\n" + lpopslots(i - 1)
## --- register arguments: a leaf (literal or local) is loaded straight into its register after the other arguments ran ---
fn lisleaf(e) = match e
    Num(n) => lfits63(n)
    Str(v) => 1
    Var(v) => 1
    _      => 0
fn lload(e, reg, ctx, s) = match e
    Num(n)  => lres(lnum(n, reg), s)
    Str(v)  => lstrload(v, reg, s)
    Var(nm) => lvarload(nm, reg, ctx, s)
    _       => lres(ctfail("lume: codegen error [C0001]: a leaf operand was expected\n"), s)
fn lvarctor(d, reg) = lres("    leaq " + d.lab + "(%rip), " + reg + "\n", d)
fn lvarload(nm, reg, ctx, s) = if isctor(nm) then lvarctor(lctordesc(nm, 0, s), reg) else lvarload2(nm, lidxof(ctx.locals, nm), reg, s)
fn lvarload2(nm, k, reg, s) = if k >= 0 then lres("    movq " + lslot(k) + "(%rbp), " + reg + "\n", s) else if nm == "true" then lres("    movq $3, " + reg + "\n", s) else if nm == "false" then lres("    movq $1, " + reg + "\n", s) else lres(ctfail("lume: codegen error [C0002]: '" + nm + "' has no value here\n"), s)
fn lnonleaf(xs) = match xs
    Nil        => 0
    Cons(h, t) => (if lisleaf(h) == 1 then 0 else 1) + lnonleaf(t)
fn lregs_eval(xs, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => if lisleaf(h) == 1 then lregs_eval(t, ctx, s) else lregs_ev2(lax(h, ctx, s), t, ctx)
fn lregs_ev2(a, t, ctx) = let rest = lregs_eval(t, ctx, a) in lres(a.code + "    pushq %rax\n" + rest.code, rest)
fn lregs_pop(xs, i) = match xs
    Nil        => ""
    Cons(h, t) => lregs_pop(t, i + 1) + (if lisleaf(h) == 1 then "" else "    popq " + areg(i) + "\n")
fn lregs_leaf(xs, i, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => if lisleaf(h) == 1 then lregs_lf2(lload(h, areg(i), ctx, s), t, i, ctx) else lregs_leaf(t, i + 1, ctx, s)
fn lregs_lf2(a, t, i, ctx) = let rest = lregs_leaf(t, i + 1, ctx, a) in lres(a.code + rest.code, rest)
fn lregs_one(xs, i, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => if lisleaf(h) == 1 then lregs_one(t, i + 1, ctx, s) else lregs_on2(lax(h, ctx, s), i)
fn lregs_on2(a, i) = lres(a.code + "    movq %rax, " + areg(i) + "\n", a)
## register arguments of a call: every computed argument but the last is pushed; the last one is still in %rax when
## the others are popped, so it is moved to its register instead of being pushed and popped
fn lregs_evalc(xs, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => if lisleaf(h) == 1 then lregs_evalc(t, ctx, s) else lregs_ev2c(lax(h, ctx, s), t, ctx)
fn lregs_ev2c(a, t, ctx) = if lnonleaf(t) == 0 then a else lregs_ev3c(a, lregs_evalc(t, ctx, a))
fn lregs_ev3c(a, rest) = lres(a.code + "    pushq %rax\n" + rest.code, rest)
fn lregs_popc(xs, i) = match xs
    Nil        => ""
    Cons(h, t) => lregs_popc(t, i + 1) + (if lisleaf(h) == 1 then "" else if lnonleaf(t) == 0 then "    movq %rax, " + areg(i) + "\n" else "    popq " + areg(i) + "\n")
fn lregs(args, ctx, s) = if lnonleaf(args) == 1 then lregs1(args, ctx, lregs_one(args, 0, ctx, s)) else lregs2(args, ctx, lregs_evalc(args, ctx, s))
fn lregs1(args, ctx, a) = let b = lregs_leaf(args, 0, ctx, a) in lres(a.code + b.code, b)
fn lregs2(args, ctx, a) = let b = lregs_leaf(args, 0, ctx, a) in lres(a.code + lregs_popc(args, 0) + b.code, b)
fn lcall(nm, args, ctx, s) = let n = len(args) in if n <= 6 then (let rg = lregs(args, ctx, s) in lres(rg.code + "    call " + nm + "\n", rg)) else (let nst = n - 6 in let spad = if nst % 2 == 1 then (nst + 1) * 8 else nst * 8 in let rg = lregargs(args, 0, 6, ctx, s) in let st = lstackltr(drop(args, 6), 0, ctx, rg) in lres("    subq $" + str(spad) + ", %rsp\n" + rg.code + st.code + lpops(5) + "    call " + nm + "\n    addq $" + str(spad) + ", %rsp\n", st))

## --- constructors and records: args evaluated in order, then popped into a fresh k*8-byte block ---
fn lcell(lab, vals, n, ctx, s) = let a = lregs_eval(vals, ctx, s) in let b = lfields_leaf(vals, 8, ctx, a) in lres(a.code + "    movq $" + str((n + 1) * 8) + ", %rdi\n    call alloc\n    leaq " + lab + "(%rip), %rcx\n    movq %rcx, (%rax)\n" + lfields_pop(vals, 8) + b.code, b)
fn lfields_pop(xs, off) = match xs
    Nil        => ""
    Cons(h, t) => lfields_pop(t, off + 8) + (if lisleaf(h) == 1 then "" else "    popq %rcx\n    movq %rcx, " + str(off) + "(%rax)\n")
fn lfields_leaf(xs, off, ctx, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => if lisleaf(h) == 1 then lfields_lf2(lload(h, "%rcx", ctx, s), t, off, ctx) else lfields_leaf(t, off + 8, ctx, s)
fn lfields_lf2(a, t, off, ctx) = let rest = lfields_leaf(t, off + 8, ctx, a) in lres(a.code + "    movq %rcx, " + str(off) + "(%rax)\n" + rest.code, rest)
fn lctor(nm, args, ctx, s) = lctor2(lctordesc(nm, len(args), s), len(args), args, ctx)
fn lctor2(d, n, args, ctx) = if n == 0 then lres("    leaq " + d.lab + "(%rip), %rax\n", d) else lcell(d.lab, args, n, ctx, d)
fn lvalsof(items) = match items
    Nil        => Nil
    Cons(h, t) => Cons(h.val, lvalsof(t))
fn lrec(items, ctx, s) = lrec2(lvalsof(items), len(items), lshape(items, len(items), s), ctx)
fn lrec2(vals, n, d, ctx) = if n == 0 then lres("    leaq " + d.lab + "(%rip), %rax\n", d) else lcell(d.lab, vals, n, ctx, d)
fn lfield(nm, o, ctx, s) = lfield2(lkey(nm, s), o, ctx)
fn lfield2(k, o, ctx) = if lisleaf(o) == 1 then lfield3(k, lload(o, "%rdi", ctx, k)) else lfield3(k, lfield4(lax(o, ctx, k)))
fn lfield3(k, a) = lres(a.code + "    leaq " + k.lab + "(%rip), %rsi\n    call recget\n", a)
fn lfield4(a) = lres(a.code + "    movq %rax, %rdi\n", a)

## --- match (port of DMatch / atest / abind in data_asmgen.lume; same label + strlabel allocation order) ---
## `acc` is asm that loads the value pointer into %rax; sub-pattern k of a constructor loads field k from it.
fn lacck(acc, k) = acc + "    movq " + str((k + 1) * 8) + "(%rax), %rax\n"
fn lcmpword(w) = if lfits32(w) then "    cmpq $" + str(w) + ", %rax\n" else "    movq $" + str(w) + ", %rcx\n    cmpq %rcx, %rax\n"
fn lpatint(n, acc, flbl) = if lfits63(n) then acc + lcmpword(lintword(n)) + "    jne " + flbl + "\n" else acc + "    pushq %rax\n    movq $" + str(n) + ", %rdi\n    call mkint\n    movq %rax, %rsi\n    popq %rdi\n    call eqv\n    testq %rax, %rax\n    jz " + flbl + "\n"
fn latest(p, acc, flbl, s) = match p
    PInt(n)          => lres(lpatint(n, acc, flbl), s)
    PStr(v)          => lateststr(v, count(v), acc, flbl, s)
    PCons(tag, subs) => latestcons(lctordesc(tag, len(subs), s), acc, subs, flbl)
    _                => lres("", s)
fn lateststr(v, n, acc, flbl, s) = if n <= 7 then lres(acc + lcmpword(lsso_word(v, n)) + "    jne " + flbl + "\n", s) else lateststr2(lstrcell(v, n, s), acc, flbl)
fn lateststr2(c, acc, flbl) = lres(acc + "    movq %rax, %rdi\n    leaq " + c.lab + "(%rip), %rsi\n    call eqv\n    testq %rax, %rax\n    jz " + flbl + "\n", c)
fn latestcons(d, acc, subs, flbl) = if isnil(subs) == 1 then lres(acc + "    leaq " + d.lab + "(%rip), %rcx\n    cmpq %rcx, %rax\n    jne " + flbl + "\n", d) else latestcons2(d, acc, subs, flbl)
fn latestcons2(d, acc, subs, flbl) = let sb = latestsubs(subs, 0, acc, flbl, d) in lres(acc + "    testb $7, %al\n    jnz " + flbl + "\n    leaq " + d.lab + "(%rip), %rcx\n    cmpq %rcx, (%rax)\n    jne " + flbl + "\n" + sb.code, sb)
fn latestsubs(subs, k, acc, flbl, s) = match subs
    Nil        => lres("", s)
    Cons(h, t) => latestsub(latest(h, lacck(acc, k), flbl, s), t, k, acc, flbl)
fn latestsub(r, t, k, acc, flbl) = let rest = latestsubs(t, k + 1, acc, flbl, r) in lres(r.code + rest.code, rest)
fn labind(p, acc, locals) = match p
    PBind(nm)        => acc + "    movq %rax, " + lslot(lidxof(locals, nm)) + "(%rbp)\n"
    PCons(tag, subs) => labinds(subs, 0, acc, locals)
    _                => ""
fn labinds(subs, k, acc, locals) = match subs
    Nil        => ""
    Cons(h, t) => labind(h, lacck(acc, k), locals) + labinds(t, k + 1, acc, locals)
fn lmatch(lab, ctx, sc, arms, s1) = let c2 = {locals: ctx.locals, bound: ctx.bound, dvars: ctx.dvars, depth: ctx.depth + 1, fnm: ctx.fnm, nparams: ctx.nparams, tlbl: ctx.tlbl} in lmatch1(lab, lslot(lidxof(ctx.locals, "_sd" + str(ctx.depth))), arms, c2, lax(sc, c2, s1))
fn lmatch1(lab, soff, arms, c2, scr) = let ar = lmarms(lab, 0, "    movq " + soff + "(%rbp), %rax\n", arms, c2, scr) in lres(scr.code + "    movq %rax, " + soff + "(%rbp)\n" + ar.code + ".Lm" + lab + "_" + str(len(arms)) + ":\n    jmp __rt_no_match\n.Lm" + lab + "_end:\n", ar)
fn lmarms(lab, i, acc, arms, c2, s) = match arms
    Nil        => lres("", s)
    Cons(h, t) => lmarm(lab, i, acc, h, t, c2, lax(h.body, {locals: c2.locals, bound: app(c2.bound, lpatbinds(h.pat)), dvars: c2.dvars, depth: c2.depth, fnm: c2.fnm, nparams: c2.nparams, tlbl: c2.tlbl}, s))
fn lmarm(lab, i, acc, h, t, c2, bd) = lmarm2(lab, i, acc, h, t, c2, bd, latest(h.pat, acc, ".Lm" + lab + "_" + str(i + 1), bd))
fn lmarm2(lab, i, acc, h, t, c2, bd, ts) = let rest = lmarms(lab, i + 1, acc, t, c2, ts) in lres(".Lm" + lab + "_" + str(i) + ":\n" + ts.code + labind(h.pat, acc, c2.locals) + bd.code + "    jmp .Lm" + lab + "_end\n" + rest.code, rest)

## --- expressions: asm that leaves the value of `e` pushed; `s` is the threaded state ---
fn lboolval(e, ctx, s) = let lab = s.pfx + str(s.nl) in let a = lcond(e, ".Lsc_f" + lab, 0, ctx, lnext(s)) in lres(a.code + "    movq $3, %rax\n    jmp .Lsc_x" + lab + "\n.Lsc_f" + lab + ":\n    movq $1, %rax\n.Lsc_x" + lab + ":\n", a)

## --- two operands: left in %rdi, right in %rsi; a leaf never touches the stack ---
fn lbinargs(l, r, ctx, s) = if lisleaf(r) == 1 then (if lisleaf(l) == 1 then lbinargs_ll(l, r, ctx, s) else lbinargs_r(l, r, ctx, s)) else if lisleaf(l) == 1 then lbinargs_l(l, r, ctx, s) else lbinargs_2(l, r, ctx, s)
fn lbinargs_ll(l, r, ctx, s) = let a = lload(l, "%rdi", ctx, s) in let b = lload(r, "%rsi", ctx, a) in lres(a.code + b.code, b)
fn lbinargs_r(l, r, ctx, s) = let a = lax(l, ctx, s) in let b = lload(r, "%rsi", ctx, a) in lres(a.code + "    movq %rax, %rdi\n" + b.code, b)
fn lbinargs_l(l, r, ctx, s) = let a = lax(r, ctx, s) in let b = lload(l, "%rdi", ctx, a) in lres(a.code + "    movq %rax, %rsi\n" + b.code, b)
fn lbinargs_2(l, r, ctx, s) = let a = lax(l, ctx, s) in let b = lax(r, ctx, a) in lres(a.code + "    pushq %rax\n" + b.code + "    movq %rax, %rsi\n    popq %rdi\n", b)
fn lsmallnum(e) = match e
    Num(n) => if n >= 0 - 1000000 and n <= 1000000 then 1 else 0
    _      => 0
fn lnumval(e) = match e
    Num(n) => n
    _      => 0
fn limm(e) = match e
    Num(n) => lfits63(n)
    Str(v) => if count(v) <= 7 then 1 else 0
    _      => 0
fn limmword(e) = match e
    Num(n) => lintword(n)
    Str(v) => lsso_word(v, count(v))
    _      => 0

## --- flags of a comparison: integers compare as words (2a+1 < 2b+1 exactly when a < b), anything else goes to cmpv ---
fn lcmpflags(l, r, ctx, s) = if lsmallnum(r) == 1 then lcmpflags_imm(l, lnumval(r), s.pfx + str(s.nl), ctx, lnext(s)) else lcmpflags_gen(s.pfx + str(s.nl), lbinargs(l, r, ctx, lnext(s)))
fn lcmpflags_gen(lab, a) = lres(a.code + "    movq %rdi, %rax\n    andq %rsi, %rax\n    testb $1, %al\n    jz .Lb" + lab + "\n    cmpq %rsi, %rdi\n    jmp .Lc" + lab + "\n.Lb" + lab + ":\n    call cmpv\n    cmpq $0, %rax\n.Lc" + lab + ":\n", a)
fn lcmpflags_imm(l, k, lab, ctx, s) = let a = lax(l, ctx, s) in let w = str(lintword(k)) in lres(a.code + "    testb $1, %al\n    jz .Lb" + lab + "\n    cmpq $" + w + ", %rax\n    jmp .Lc" + lab + "\n.Lb" + lab + ":\n    movq %rax, %rdi\n    movq $" + w + ", %rsi\n    call cmpv\n    cmpq $0, %rax\n.Lc" + lab + ":\n", a)
## equality: a value has one form, so an immediate literal is equal to `x` exactly when the two words are equal
fn leqflags(l, r, ctx, s) = if limm(r) == 1 then leqimm(lax(l, ctx, s), limmword(r)) else if limm(l) == 1 then leqimm(lax(r, ctx, s), limmword(l)) else leqgen(lbinargs(l, r, ctx, s))
fn leqimm(a, w) = lres(a.code + lcmpword(w), a)
fn leqgen(a) = lres(a.code + "    call eqv\n    cmpq $1, %rax\n", a)
fn lsete(a, cc) = lres(a.code + "    " + cc + " %al\n    movzbq %al, %rax\n    leaq 1(%rax,%rax), %rax\n", a)
fn lsetcc(op) = if op == "<" then "setl" else if op == ">" then "setg" else if op == "<=" then "setle" else "setge"
fn lcmp_inv(op) = if op == "<" then "jge" else if op == ">" then "jle" else if op == "<=" then "jg" else "jl"
fn lcmp_dir(op) = if op == "<" then "jl" else if op == ">" then "jg" else if op == "<=" then "jle" else "jge"

## --- arithmetic: two odd words stay in registers, one flag test covers overflow; the rest goes to the runtime ---
fn lboth(lab) = "    movq %rdi, %rax\n    andq %rsi, %rax\n    testb $1, %al\n    jz .Lb" + lab + "\n"
fn lbin_rt(op) = if op == "/" then "__rt_div" else if op == "%" then "__rt_mod" else if op == "+%" then "__rt_wadd" else if op == "-%" then "__rt_wsub" else "__rt_wmul"
fn lbin_add(lab) = lboth(lab) + "    leaq -1(%rdi), %rax\n    addq %rsi, %rax\n    jno .Lc" + lab + "\n.Lb" + lab + ":\n    call addv\n.Lc" + lab + ":\n"
fn lbin_sub(lab) = lboth(lab) + "    leaq -1(%rsi), %rcx\n    movq %rdi, %rax\n    subq %rcx, %rax\n    jno .Lc" + lab + "\n.Lb" + lab + ":\n    call __rt_sub\n.Lc" + lab + ":\n"
fn lbin_mul(lab) = lboth(lab) + "    movq %rdi, %rax\n    sarq $1, %rax\n    leaq -1(%rsi), %rcx\n    imulq %rcx, %rax\n    jo .Lb" + lab + "\n    incq %rax\n    jmp .Lc" + lab + "\n.Lb" + lab + ":\n    call __rt_mul\n.Lc" + lab + ":\n"
fn lbin_code(lab, op) = if op == "+" then lbin_add(lab) else if op == "-" then lbin_sub(lab) else if op == "*" then lbin_mul(lab) else "    call " + lbin_rt(op) + "\n"
fn lbin_gen(lab, op, a) = lres(a.code + lbin_code(lab, op), a)
fn ladd_imm(lab, l, k, ctx, s) = let a = lax(l, ctx, s) in let d = str(k + k) in lres(a.code + "    testb $1, %al\n    jz .Lb" + lab + "\n    addq $" + d + ", %rax\n    jno .Lc" + lab + "\n    subq $" + d + ", %rax\n.Lb" + lab + ":\n    movq %rax, %rdi\n    movq $" + str(lintword(k)) + ", %rsi\n    call addv\n.Lc" + lab + ":\n", a)
fn lsub_imm(lab, l, k, ctx, s) = let a = lax(l, ctx, s) in let d = str(k + k) in lres(a.code + "    testb $1, %al\n    jz .Lb" + lab + "\n    subq $" + d + ", %rax\n    jno .Lc" + lab + "\n    addq $" + d + ", %rax\n.Lb" + lab + ":\n    movq %rax, %rdi\n    movq $" + str(lintword(k)) + ", %rsi\n    call __rt_sub\n.Lc" + lab + ":\n", a)
fn lbin_arith(op, l, r, ctx, s) = let lab = s.pfx + str(s.nl) in if op == "+" and lsmallnum(r) == 1 then ladd_imm(lab, l, lnumval(r), ctx, lnext(s)) else if op == "-" and lsmallnum(r) == 1 then lsub_imm(lab, l, lnumval(r), ctx, lnext(s)) else lbin_gen(lab, op, lbinargs(l, r, ctx, lnext(s)))
fn lbin_tag(op, l, r, ctx, s) = if op == "==" then lsete(leqflags(l, r, ctx, s), "sete") else if op == "!=" then lsete(leqflags(l, r, ctx, s), "setne") else if op == "<" or op == ">" or op == "<=" or op == ">=" then lsete(lcmpflags(l, r, ctx, s), lsetcc(op)) else lbin_arith(op, l, r, ctx, s)
fn lbin_dec(op, a) = lres(a.code + ldec_tail(op), a)
fn lisdec2(l, r, ctx) = ldec_expr(l, ctx.dvars) and ldec_expr(r, ctx.dvars)

## --- conditions: jump to `tgt` when the truth of `e` equals `sense`, otherwise fall through ---
fn lcond(e, tgt, sense, ctx, s) = match e
    Bin(op, l, r) => lcond_bin(op, l, r, {tgt: tgt, sense: sense}, ctx, s)
    _             => lcond_val(e, tgt, sense, ctx, s)
fn lcond_val(e, tgt, sense, ctx, s) = let lab = s.pfx + str(s.nl) in let a = lax(e, ctx, lnext(s)) in lres(a.code + "    testb $1, %al\n    jnz .Lv" + lab + "\n    call __rt_cond\n.Lv" + lab + ":\n    cmpq $1, %rax\n    " + (if sense == 0 then "je " else "jne ") + tgt + "\n", a)
fn lcond_bin(op, l, r, j, ctx, s) = if op == "and" then lcond_and(l, r, j, ctx, s) else if op == "or" then lcond_or(l, r, j, ctx, s) else if lisdec2(l, r, ctx) then lcond_val(Bin(op, l, r), j.tgt, j.sense, ctx, s) else if op == "==" or op == "!=" then lcond_eq(op, leqflags(l, r, ctx, s), j) else if op == "<" or op == ">" or op == "<=" or op == ">=" then lcond_cmp(op, lcmpflags(l, r, ctx, s), j) else lcond_val(Bin(op, l, r), j.tgt, j.sense, ctx, s)
fn lcond_eq(op, a, j) = let want = if op == "==" then j.sense else 1 - j.sense in lres(a.code + "    " + (if want == 1 then "je " else "jne ") + j.tgt + "\n", a)
fn lcond_cmp(op, a, j) = lres(a.code + "    " + (if j.sense == 1 then lcmp_dir(op) else lcmp_inv(op)) + " " + j.tgt + "\n", a)
fn lcond_same(l, r, j, ctx, s) = let a = lcond(l, j.tgt, j.sense, ctx, s) in let b = lcond(r, j.tgt, j.sense, ctx, a) in lres(a.code + b.code, b)
fn lcond_skip(l, r, j, sl, ctx, s) = let lab = ".Lsk" + s.pfx + str(s.nl) in let a = lcond(l, lab, sl, ctx, lnext(s)) in let b = lcond(r, j.tgt, j.sense, ctx, a) in lres(a.code + b.code + lab + ":\n", b)
fn lcond_and(l, r, j, ctx, s) = if j.sense == 0 then lcond_same(l, r, j, ctx, s) else lcond_skip(l, r, j, 0, ctx, s)
fn lcond_or(l, r, j, ctx, s) = if j.sense == 1 then lcond_same(l, r, j, ctx, s) else lcond_skip(l, r, j, 1, ctx, s)
fn lbin(op, l, r, ctx, s) = if lisdec2(l, r, ctx) then lbin_dec(op, lbinargs(l, r, ctx, s)) else lbin_tag(op, l, r, ctx, s)
fn lif(c, t, e2, ctx, s) = let lab = s.pfx + str(s.nl) in let cr = lcond(c, ".Le" + lab, 0, ctx, lnext(s)) in let tr = lax(t, ctx, cr) in let er = lax(e2, ctx, tr) in lres(cr.code + tr.code + "    jmp .Lx" + lab + "\n.Le" + lab + ":\n" + er.code + ".Lx" + lab + ":\n", er)
fn llet(nm, v, vr, b, ctx) = let inner = {locals: ctx.locals, bound: app(ctx.bound, Cons(nm, Nil)), dvars: if ldec_expr(v, ctx.dvars) then Cons(nm, ldec_remove(ctx.dvars, nm)) else ldec_remove(ctx.dvars, nm), depth: ctx.depth, fnm: ctx.fnm, nparams: ctx.nparams, tlbl: ctx.tlbl} in let br = lax(b, inner, vr) in lres(vr.code + "    movq %rax, " + lslot(lidxof(ctx.locals, nm)) + "(%rbp)\n" + br.code, br)
fn lreuse1(args, ctx, s) = let ar = lstackargs(args, ctx, s) in lres(ar.code + "    popq %rsi\n    popq %rax\n    movq %rsi, 8(%rax)\n", ar)
fn lreuse2(args, ctx, s) = let ar = lstackargs(args, ctx, s) in lres(ar.code + "    popq %rdx\n    popq %rsi\n    popq %rax\n    movq %rsi, 8(%rax)\n    movq %rdx, 16(%rax)\n", ar)
fn lbv2_op(nm) = if nm == "bv_xor" or nm == "bit_xor" then "    xorq %rcx, %rax\n" else if nm == "bv_and" or nm == "bit_and" then "    andq %rcx, %rax\n" else if nm == "bv_or" or nm == "bit_or" then "    orq %rcx, %rax\n" else if nm == "bv_shl" or nm == "bit_shl" then "    salq %cl, %rax\n" else if nm == "bv_shr" or nm == "bit_shr" then "    sarq %cl, %rax\n" else if nm == "bv_add_u8" then "    addq %rcx, %rax\n    andq $255, %rax\n" else if nm == "bv_sub_u8" then "    subq %rcx, %rax\n    andq $255, %rax\n" else "    imulq %rcx, %rax\n    andq $255, %rax\n"
fn lbv1_op(nm) = if nm == "bv_u8" then "    andq $255, %rax\n" else "    notq %rax\n    andq $255, %rax\n"
## SHIFTS (spec 19.8). `bit_shl(a, k)` / `bit_shr(a, k)` (and the `bv_` spellings) are defined for 0 <= k <= 63:
## `bit_shr` is arithmetic (the sign is propagated), `bit_shl` drops the bits that leave the 64-bit word. The CPU
## would take the count modulo 64 (`bit_shl(1, 64)` was 1), which no evaluator of the tool chain models, so a count
## outside the range stops the program like a division by zero: a literal one here ([C0012]), a computed one in the
## guard below (`__rt_shc` of runtime_core.lume, "lume: shift count outside 0..63", exit 3). A literal count inside the range keeps the
## unguarded sequence, byte for byte. The standalone routines `bit_shl:` / `bit_shr:` of runtime_sys_tail carry the
## same guard and the same arithmetic shift; generated code never calls them (a two-argument call is always lowered
## here and any other arity is [R0202]), they stay because the names are reserved runtime entry points.
fn lbv2_isshift(nm) = nm == "bv_shl" or nm == "bit_shl" or nm == "bv_shr" or nm == "bit_shr"
fn lbv2_guard(nm, args) = if lbv2_isshift(nm) then lbv2_guard2(nm, lqhead(lqrest(args))) else ""
fn lbv2_guard2(nm, k) = match k
    Num(n) => if n >= 0 and n <= 63 then "" else ctfail("lume: codegen error [C0012]: the shift count " + str(n) + " of '" + nm + "' is outside 0..63 (a 64-bit word has the bit positions 0..63; fix-it: use a count in that range)\n")
    _      => "    cmpq $63, %rcx\n    jg __rt_shc\n    cmpq $0, %rcx\n    jl __rt_shc\n"
fn lbv2(nm, args, ctx, s) = let ar = lstackargs(args, ctx, s) in lres(ar.code + "    popq %rcx\n    popq %rax\n    call __rt_un2\n" + lbv2_guard(nm, args) + lbv2_op(nm) + "    movq %rax, %rdi\n    call mkint\n", ar)
fn lbv1(nm, args, ctx, s) = let ar = lstackargs(args, ctx, s) in lres(ar.code + "    popq %rax\n    call __rt_uint\n" + lbv1_op(nm) + "    movq %rax, %rdi\n    call mkint\n", ar)
fn lqrest(args) = match args
    Nil        => Nil
    Cons(h, t) => t
fn lqhead(args) = match args
    Nil        => Num(0)
    Cons(h, t) => h
fn lquant(nm, args, ctx, s) = let vnm = lqvar(lqhead(args)) in let a1 = lqrest(args) in let lo_e = lqhead(a1) in let a2 = lqrest(a1) in let hi_e = lqhead(a2) in let pred_e = lqhead(lqrest(a2)) in let kslot = lslot(lidxof(ctx.locals, vnm)) + "(%rbp)" in let lab = s.pfx + str(s.nl) in let rlo = lax(lo_e, ctx, lnext(s)) in let rhi = lax(hi_e, ctx, rlo) in let is_all = if nm == "forall_range" then 1 else 0 in let rpr = lcond(pred_e, ".Lqearly_" + lab, if is_all == 1 then 0 else 1, ctx, rhi) in let v_done = if is_all == 1 then "3" else "1" in let v_early = if is_all == 1 then "1" else "3" in lres(rlo.code + "    movq %rax, " + kslot + "\n.Lqloop_" + lab + ":\n" + rhi.code + "    movq %rax, %rsi\n    movq " + kslot + ", %rdi\n    call cmpv\n    cmpq $0, %rax\n    jg .Lqdone_" + lab + "\n" + rpr.code + "    movq " + kslot + ", %rdi\n    call __rt_qnext\n    testq %rax, %rax\n    jz .Lqdone_" + lab + "\n    movq %rax, " + kslot + "\n    jmp .Lqloop_" + lab + "\n.Lqdone_" + lab + ":\n    movq $" + v_done + ", %rax\n    jmp .Lqend_" + lab + "\n.Lqearly_" + lab + ":\n    movq $" + v_early + ", %rax\n.Lqend_" + lab + ":\n", rpr)
fn lord_at_args(args) = match args
    Cons(h, Nil) => lord_at_inner(h)
    _            => {ok: 0, s: Num(0), i: Num(0)}
fn lord_at_inner(e) = match e
    Call(nm, a2) => if nm == "at" and len(a2) == 2 then {ok: 1, s: lqhead(a2), i: lqhead(lqrest(a2))} else {ok: 0, s: Num(0), i: Num(0)}
    _            => {ok: 0, s: Num(0), i: Num(0)}
fn lord_at(s_e, i_e, ctx, s) = let a = lbinargs(s_e, i_e, ctx, s) in lres(a.code + "    call ord_at\n", a)
fn lis_err_call(arg, ctx, s) = let d1 = lctordesc("Err", 1, s) in let d0 = lctordesc("Err", 0, d1) in let lab = d0.pfx + str(d0.nl) in let a = lax(arg, ctx, lnext(d0)) in let neg_chk = if ctx.fnm == "run_errdefer" then "    testb $1, %cl\n    jz .Lerr_n" + lab + "\n    testq %rcx, %rcx\n    js .Lerr_y" + lab + "\n    jmp .Lerr_n" + lab + "\n" else "    jmp .Lerr_n" + lab + "\n" in lres(a.code + "    movq %rax, %rcx\n    movq $1, %rax\n    testb $7, %cl\n    jz .Lerr_p" + lab + "\n" + neg_chk + ".Lerr_p" + lab + ":\n    testq %rcx, %rcx\n    jz .Lerr_n" + lab + "\n    leaq " + d1.lab + "(%rip), %rdx\n    cmpq %rdx, (%rcx)\n    je .Lerr_y" + lab + "\n    leaq " + d0.lab + "(%rip), %rdx\n    cmpq %rdx, %rcx\n    jne .Lerr_n" + lab + "\n.Lerr_y" + lab + ":\n    movq $3, %rax\n.Lerr_n" + lab + ":\n", a)
fn lcallx(nm, args, ctx, s) = if isctor(nm) then lctor(nm, args, ctx, s) else if nm == "__lume_is_err" and len(args) == 1 then lis_err_call(lqhead(args), ctx, s) else if nm == "__perceus_reuse_2" then lreuse2(args, ctx, s) else if nm == "__perceus_reuse_1" then lreuse1(args, ctx, s) else if nm == "ord" and len(args) == 1 then (let oa = lord_at_args(args) in if oa.ok == 1 then lord_at(oa.s, oa.i, ctx, s) else lcall(nm, args, ctx, s)) else if lis_bv2_call(nm) and len(args) == 2 then lbv2(nm, args, ctx, s) else if lis_bv1_call(nm) and len(args) == 1 then lbv1(nm, args, ctx, s) else if nm == "ct_eq" and len(args) == 2 then lcteq_o(args, ctx, s) else if nm == "ct_select" and len(args) == 3 then lctsel_o(args, ctx, s) else if (nm == "forall_range" or nm == "exists_range") and len(args) == 4 then lquant(nm, args, ctx, s) else lcall(nm, args, ctx, s)
## constant-string folding: a chain of `+` over string literals is one .rodata literal, so a long runtime
## fragment costs nothing at run time. A chain is only walked when its leftmost leaf is a literal.
fn lstr_chain_head(e) = match e
    Str(v)        => 1
    Bin(op, l, r) => if op == "+" then lstr_chain_head(l) else 0
    _             => 0
fn lstr_chain(e, acc) = match e
    Str(v)        => {ok: 1, acc: Cons(v, acc)}
    Bin(op, l, r) => if op == "+" then lstr_chain2(l, lstr_chain(r, acc)) else {ok: 0, acc: acc}
    _             => {ok: 0, acc: acc}
fn lstr_chain2(l, rr) = if rr.ok == 1 then lstr_chain(l, rr.acc) else rr
fn lbin_str(op, l, r, e, ctx, s) = let c = lstr_chain(e, Nil) in if c.ok == 1 then lstrload(joinall(own c.acc), "%rax", s) else lbin(op, l, r, ctx, s)
fn lax(e, ctx, s) = match e
    Num(n)         => lres(lnum(n, "%rax"), s)
    Str(v)         => lstrload(v, "%rax", s)
    Var(nm)        => lvarload(nm, "%rax", ctx, s)
    Bin(op, l, r)  => if op == "and" or op == "or" then lboolval(e, ctx, s) else if op == "+" and lstr_chain_head(l) == 1 then lbin_str(op, l, r, e, ctx, s) else lbin(op, l, r, ctx, s)
    If(c, t, e2)   => lif(c, t, e2, ctx, s)
    LetIn(nm, v, b) => llet(nm, v, lax(v, ctx, s), b, ctx)
    Call(nm, args) => lcallx(nm, args, ctx, s)
    Rec(items)     => lrec(items, ctx, s)
    RecT(tn, items) => lrec(items, ctx, s)
    Field(o, nm)   => lfield(nm, o, ctx, s)
    Match(sc, arms) => lmatch(s.pfx + str(s.nl), ctx, sc, arms, lnext(s))
    _              => lres(ctfail("lume: codegen error [C0001]: unsupported AST expression node in native x86-64 codegen\n"), s)
## the value of `e` pushed on the stack (arguments past the sixth, reuse, bit operations)
fn laexpr(e, ctx, s) = lpush(lax(e, ctx, s))
fn lpush(r) = lres(r.code + "    pushq %rax\n", r)
fn lcall_tail(args, ctx, s) = let m = len(args) in if m <= 6 then (let rg = lregs(args, ctx, s) in lres(rg.code + "    jmp " + ctx.tlbl + "\n", rg)) else (let st = lstackargs(args, ctx, s) in lres(st.code + lpopslots(m - 1) + "    jmp " + ctx.tlbl + "\n", st))
fn lcallx_tail(nm, args, ctx, s) = if ctx.fnm != "" and nm == ctx.fnm and isctor(nm) == 0 and len(args) == ctx.nparams then lcall_tail(args, ctx, s) else lcallx(nm, args, ctx, s)
fn lif_tail(c, t, e2, ctx, s) = let lab = s.pfx + str(s.nl) in let cr = lcond(c, ".Le" + lab, 0, ctx, lnext(s)) in let tr = laexpr_tail(t, ctx, cr) in let er = laexpr_tail(e2, ctx, tr) in lres(cr.code + tr.code + "    jmp .Lx" + lab + "\n.Le" + lab + ":\n" + er.code + ".Lx" + lab + ":\n", er)
fn llet_tail(nm, v, vr, b, ctx) = let inner = {locals: ctx.locals, bound: app(ctx.bound, Cons(nm, Nil)), dvars: if ldec_expr(v, ctx.dvars) then Cons(nm, ldec_remove(ctx.dvars, nm)) else ldec_remove(ctx.dvars, nm), depth: ctx.depth, fnm: ctx.fnm, nparams: ctx.nparams, tlbl: ctx.tlbl} in let br = laexpr_tail(b, inner, vr) in lres(vr.code + "    movq %rax, " + lslot(lidxof(ctx.locals, nm)) + "(%rbp)\n" + br.code, br)
fn lmatch_tail(lab, ctx, sc, arms, s1) = let c2 = {locals: ctx.locals, bound: ctx.bound, dvars: ctx.dvars, depth: ctx.depth + 1, fnm: ctx.fnm, nparams: ctx.nparams, tlbl: ctx.tlbl} in lmatch1_tail(lab, lslot(lidxof(ctx.locals, "_sd" + str(ctx.depth))), arms, c2, lax(sc, c2, s1))
fn lmatch1_tail(lab, soff, arms, c2, scr) = let ar = lmarms_tail(lab, 0, "    movq " + soff + "(%rbp), %rax\n", arms, c2, scr) in lres(scr.code + "    movq %rax, " + soff + "(%rbp)\n" + ar.code + ".Lm" + lab + "_" + str(len(arms)) + ":\n    jmp __rt_no_match\n.Lm" + lab + "_end:\n", ar)
fn lmarms_tail(lab, i, acc, arms, c2, s) = match arms
    Nil        => lres("", s)
    Cons(h, t) => lmarm_tail(lab, i, acc, h, t, c2, laexpr_tail(h.body, {locals: c2.locals, bound: app(c2.bound, lpatbinds(h.pat)), dvars: c2.dvars, depth: c2.depth, fnm: c2.fnm, nparams: c2.nparams, tlbl: c2.tlbl}, s))
fn lmarm_tail(lab, i, acc, h, t, c2, bd) = lmarm2_tail(lab, i, acc, h, t, c2, bd, latest(h.pat, acc, ".Lm" + lab + "_" + str(i + 1), bd))
fn lmarm2_tail(lab, i, acc, h, t, c2, bd, ts) = let rest = lmarms_tail(lab, i + 1, acc, t, c2, ts) in lres(".Lm" + lab + "_" + str(i) + ":\n" + ts.code + labind(h.pat, acc, c2.locals) + bd.code + "    jmp .Lm" + lab + "_end\n" + rest.code, rest)
fn laexpr_tail(e, ctx, s) = match e
    If(c, t, e2)    => lif_tail(c, t, e2, ctx, s)
    LetIn(nm, v, b) => llet_tail(nm, v, lax(v, ctx, s), b, ctx)
    Call(nm, args)  => lcallx_tail(nm, args, ctx, s)
    Match(sc, arms) => lmatch_tail(s.pfx + str(s.nl), ctx, sc, arms, lnext(s))
    _               => lax(e, ctx, s)

## --- Wave 10+ SRA: Escape Analysis & Scalar Replacement of Non-Escaping Stack Records ---
fn lsra_rec_items(e) = match e
    Rec(items)      => if ldec_expr(e, Nil) == 1 then Nil else items
    RecT(tn, items) => items
    _               => Nil
fn lsra_uniq_keys(items) = match items
    Nil        => 1
    Cons(h, t) => if ldec_key(t, h.key) == 1 then 0 else lsra_uniq_keys(t)
fn lsra_is_var(e, nm) = match e
    Var(x) => if x == nm then 1 else 0
    _      => 0
fn lsra_has_field(nm, e) = match e
    Field(o, k)   => if lsra_is_var(o, nm) == 1 then 1 else lsra_has_field(nm, o)
    Bin(op, l, r) => if lsra_has_field(nm, l) == 1 then 1 else lsra_has_field(nm, r)
    If(c, t, e2)  => if lsra_has_field(nm, c) == 1 or lsra_has_field(nm, t) == 1 then 1 else lsra_has_field(nm, e2)
    _             => 0
fn lsra_simple_val(nm, e) = match e
    Num(n)        => 1
    Str(s)        => 1
    Var(x)        => if x == nm then 0 else 1
    Bin(op, l, r) => if lsra_simple_val(nm, l) == 1 then lsra_simple_val(nm, r) else 0
    If(c, t, e2)  => if lsra_simple_val(nm, c) == 1 and lsra_simple_val(nm, t) == 1 then lsra_simple_val(nm, e2) else 0
    _             => 0
fn lsra_simple_items(nm, items) = match items
    Nil        => 1
    Cons(h, t) => if lsra_simple_val(nm, h.val) == 1 then lsra_simple_items(nm, t) else 0
fn lsra_no_escape(nm, items, e) = match e
    Num(n)        => 1
    Str(s)        => 1
    Var(x)        => if x == nm then 0 else 1
    Field(o, k)   => if lsra_is_var(o, nm) == 1 then ldec_key(items, k) else 0
    Bin(op, l, r) => if lsra_no_escape(nm, items, l) == 1 then lsra_no_escape(nm, items, r) else 0
    If(c, t, e2)  => if lsra_no_escape(nm, items, c) == 1 and lsra_no_escape(nm, items, t) == 1 then lsra_no_escape(nm, items, e2) else 0
    _             => 0
fn lsra_subst(nm, e) = match e
    Field(o, k)   => if lsra_is_var(o, nm) == 1 then Var("_sra_" + nm + "_" + k) else Field(lsra_subst(nm, o), k)
    Bin(op, l, r) => Bin(op, lsra_subst(nm, l), lsra_subst(nm, r))
    If(c, t, e2)  => If(lsra_subst(nm, c), lsra_subst(nm, t), lsra_subst(nm, e2))
    _             => e
fn lsra_bind_fields(nm, items, body) = match items
    Nil        => body
    Cons(h, t) => LetIn("_sra_" + nm + "_" + h.key, lsra_expr(h.val), lsra_bind_fields(nm, t, body))
fn lsra_expr_args(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(lsra_expr(h), lsra_expr_args(t))
fn lsra_expr_rec(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: lsra_expr(h.val)}, lsra_expr_rec(t))
fn lsra_expr_arms(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: lsra_expr(h.body)}, lsra_expr_arms(t))
fn lsra_expr(e) = match e
    LetIn(nm, v, b) => let items = lsra_rec_items(v) in if isnil(items) == 0 and lsra_uniq_keys(items) == 1 and lsra_simple_items(nm, items) == 1 and lsra_has_field(nm, b) == 1 and lsra_no_escape(nm, items, b) == 1 then lsra_bind_fields(nm, items, lsra_expr(lsra_subst(nm, b))) else LetIn(nm, lsra_expr(v), lsra_expr(b))
    Bin(op, l, r)   => Bin(op, lsra_expr(l), lsra_expr(r))
    If(c, t, e2)    => If(lsra_expr(c), lsra_expr(t), lsra_expr(e2))
    Call(cnm, args) => Call(cnm, lsra_expr_args(args))
    Field(o, k)     => Field(lsra_expr(o), k)
    Rec(its)        => Rec(lsra_expr_rec(its))
    RecT(tn, its)   => RecT(tn, lsra_expr_rec(its))
    Match(sc, arms) => Match(lsra_expr(sc), lsra_expr_arms(arms))
    _               => e

## --- literal folding: `+` and `-` of two integer literals of at most 10^9 in magnitude is the literal of the result
## (it fits 63 bits and cannot trap). A negative number is written `0 - k` in Lume, so without this every negative
## bound is a subtraction at run time and misses the immediate forms of lcmpflags_imm / ladd_imm / lsub_imm. ---
fn lcf_small(n) = n >= 0 - 1000000000 and n <= 1000000000
fn lcf_bin(op, l, r) = match l
    Num(a) => lcf_bin2(op, a, l, r)
    _      => Bin(op, l, r)
fn lcf_bin2(op, a, l, r) = match r
    Num(b) => if (op == "+" or op == "-") and lcf_small(a) and lcf_small(b) then Num(if op == "+" then a + b else a - b) else Bin(op, l, r)
    _      => Bin(op, l, r)
fn lcf_args(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(lcf(h), lcf_args(t))
fn lcf_rec(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: lcf(h.val)}, lcf_rec(t))
fn lcf_arms(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: lcf(h.body)}, lcf_arms(t))
fn lcf(e) = match e
    Bin(op, l, r)   => lcf_bin(op, lcf(l), lcf(r))
    If(c, t, e2)    => If(lcf(c), lcf(t), lcf(e2))
    LetIn(nm, v, b) => LetIn(nm, lcf(v), lcf(b))
    Call(cnm, args) => Call(cnm, lcf_args(args))
    Field(o, k)     => Field(lcf(o), k)
    Rec(its)        => Rec(lcf_rec(its))
    RecT(tn, its)   => RecT(tn, lcf_rec(its))
    Match(sc, arms) => Match(lcf(sc), lcf_arms(arms))
    _               => e

## --- alpha-renaming of shadowed local/pattern bindings so distinct lexical scopes get distinct frame slots ---
fn lenv_get(env, nm) = match env
    Nil        => nm
    Cons(h, t) => if h.k == nm then h.v else lenv_get(t, nm)
fn lenv_drop(env, nm) = match env
    Nil        => Nil
    Cons(h, t) => if h.k == nm then lenv_drop(t, nm) else Cons(h, lenv_drop(t, nm))
fn lalpha_bind(nm, st) = if lidxof(st.bound, nm) >= 0 then (let nnm = "_sh" + str(st.k) + "_" + nm in {nm: nnm, st: {bound: Cons(nnm, st.bound), env: Cons({k: nm, v: nnm}, lenv_drop(st.env, nm)), k: st.k + 1}}) else {nm: nm, st: {bound: Cons(nm, st.bound), env: lenv_drop(st.env, nm), k: st.k}}
fn lalpha_pat(p, st) = match p
    PBind(nm)        => let b = lalpha_bind(nm, st) in {pat: PBind(b.nm), st: b.st}
    PCons(tag, subs) => let sr = lalpha_pats(subs, st) in {pat: PCons(tag, sr.pats), st: sr.st}
    _                => {pat: p, st: st}
fn lalpha_pats(xs, st) = match xs
    Nil        => {pats: Nil, st: st}
    Cons(h, t) => let r1 = lalpha_pat(h, st) in let r2 = lalpha_pats(t, r1.st) in {pats: Cons(r1.pat, r2.pats), st: r2.st}
fn lalpha_let(nm, v, b, st) = let rv = lalpha_e(v, st) in let bd = lalpha_bind(nm, {bound: st.bound, env: st.env, k: rv.k}) in let rb = lalpha_e(b, bd.st) in {node: LetIn(bd.nm, rv.node, rb.node), k: rb.k}
fn lalpha_args(xs, st) = match xs
    Nil        => {items: Nil, k: st.k}
    Cons(h, t) => let r1 = lalpha_e(h, st) in let r2 = lalpha_args(t, {bound: st.bound, env: st.env, k: r1.k}) in {items: Cons(r1.node, r2.items), k: r2.k}
fn lalpha_rec(xs, st) = match xs
    Nil        => {items: Nil, k: st.k}
    Cons(h, t) => let r1 = lalpha_e(h.val, st) in let r2 = lalpha_rec(t, {bound: st.bound, env: st.env, k: r1.k}) in {items: Cons({key: h.key, val: r1.node}, r2.items), k: r2.k}
fn lalpha_arms(xs, st) = match xs
    Nil        => {items: Nil, k: st.k}
    Cons(h, t) => let pr = lalpha_pat(h.pat, st) in let br = lalpha_e(h.body, pr.st) in let rr = lalpha_arms(t, {bound: st.bound, env: st.env, k: br.k}) in {items: Cons({pat: pr.pat, body: br.node}, rr.items), k: rr.k}
fn lalpha_quant(nm, args, st) = let vnm = lqvar(lqhead(args)) in let a1 = lqrest(args) in let lo_e = lqhead(a1) in let a2 = lqrest(a1) in let hi_e = lqhead(a2) in let pred_e = lqhead(lqrest(a2)) in let rlo = lalpha_e(lo_e, st) in let rhi = lalpha_e(hi_e, {bound: st.bound, env: st.env, k: rlo.k}) in let bd = lalpha_bind(vnm, {bound: st.bound, env: st.env, k: rhi.k}) in let rpr = lalpha_e(pred_e, bd.st) in {node: Call(nm, Cons(Var(bd.nm), Cons(rlo.node, Cons(rhi.node, Cons(rpr.node, Nil))))), k: rpr.k}
fn llistlower(xs) = match xs
    Nil        => Var("Nil")
    Cons(h, t) => Call("Cons", Cons(h, Cons(llistlower(t), Nil)))
fn lis_ed_var(e) = match e
    Var(vn) => if count(vn) >= 8 and slice(vn, 0, 8) == "_ed_val_" then 1 else 0
    _       => 0
fn lis_ed_zero(e) = match e
    Num(n) => if n == 0 then 1 else 0
    _      => 0
fn lis_ed_cond(op, l, r) = if op == "<" and lis_ed_var(l) == 1 and lis_ed_zero(r) == 1 then 1 else 0
fn lalpha_e(e, st) = match e
    Var(nm)         => {node: Var(lenv_get(st.env, nm)), k: st.k}
    LetIn(nm, v, b) => lalpha_let(nm, v, b, st)
    Bin(op, l, r)   => if lis_ed_cond(op, l, r) == 1 then lalpha_e(Call("__lume_is_err", Cons(l, Nil)), st) else let rl = lalpha_e(l, st) in let rr = lalpha_e(r, {bound: st.bound, env: st.env, k: rl.k}) in {node: Bin(op, rl.node, rr.node), k: rr.k}
    If(c, t, e2)    => let rc = lalpha_e(c, st) in let rt = lalpha_e(t, {bound: st.bound, env: st.env, k: rc.k}) in let re = lalpha_e(e2, {bound: st.bound, env: st.env, k: rt.k}) in {node: If(rc.node, rt.node, re.node), k: re.k}
    Call(nm, args)  => if nm == "_tylist_" then lalpha_e(llistlower(args), st) else if (nm == "forall_range" or nm == "exists_range") and len(args) == 4 then lalpha_quant(nm, args, st) else let ra = lalpha_args(args, st) in {node: Call(nm, ra.items), k: ra.k}
    Field(o, nm)    => let ro = lalpha_e(o, st) in {node: Field(ro.node, nm), k: ro.k}
    Rec(items)      => let rr = lalpha_rec(items, st) in {node: Rec(rr.items), k: rr.k}
    RecT(tn, items) => let rr = lalpha_rec(items, st) in {node: RecT(tn, rr.items), k: rr.k}
    Match(sc, arms) => let rs = lalpha_e(sc, st) in let ra = lalpha_arms(arms, {bound: st.bound, env: st.env, k: rs.k}) in {node: Match(rs.node, ra.items), k: ra.k}
    _               => {node: e, k: st.k}
fn lalpha(e, params) = (lalpha_e(e, {bound: params, env: Nil, k: 0})).node

## --- Wave 14: the constant-time intrinsics in ordinary code. Operands may be boxed 64-bit integers, so both go
## through the unboxing helpers and the result through mkint, exactly like the bit_* operations of lbv2.
##   ct_eq(a, b):         x = a ^ b;  nz = (x | -x) >>logical 63  (1 exactly when x != 0);  result = nz ^ 1
##   ct_select(m, a, b):  b ^ ((a ^ b) & m)  -- bit i of the result is bit i of a where bit i of m is set, else of b
fn lcteq_o(args, ctx, s) = let ar = lstackargs(args, ctx, s) in lres(ar.code + "    popq %rcx\n    popq %rax\n    call __rt_un2\n    xorq %rcx, %rax\n    movq %rax, %rcx\n    negq %rcx\n    orq %rcx, %rax\n    shrq $63, %rax\n    xorq $1, %rax\n    movq %rax, %rdi\n    call mkint\n", ar)
fn lctsel_o(args, ctx, s) = let ar = lstackargs(args, ctx, s) in lres(ar.code + "    popq %rcx\n    popq %rax\n    call __rt_un2\n    call __rt_ustk\n    popq %rdx\n    xorq %rcx, %rax\n    andq %rdx, %rax\n    xorq %rax, %rcx\n    movq %rcx, %rdi\n    call mkint\n", ar)

## --- Wave 14: constant-time kernels ("ct mode"). A function that carries BOTH `@secret` and `@no_alloc` is lowered
## to straight-line code that works directly on immediate words (the word of the integer n is w = 2n + 1): no tag
## test, no overflow test, no runtime call, no conditional jump. That is only correct because
##   (1) the entry guard below faults unless EVERY parameter is an immediate word, and
##   (2) the checker (06b_phase3.src, ct_chk_fn / na_e) has PROVEN that every `+ - * +% -% *%` and every literal
##       bit_shl stays inside [-2^62, 2^62) for all immediate parameters, so the result word never leaves 64 bits and
##       wrapping and checked arithmetic coincide; and it rejected ([C0011]) every construct that is not listed here.
## The validator (ltv.src) re-derives both facts from the emitted text and trusts neither.
##   entry guard   AND of all parameter words; `andq $1` (1 when all are odd); `decq` (0, or -1 when one is even);
##                 `orq %rsp`; `movq (%rax), %rax`: a harmless load of the stack top, or a load from address
##                 0xFFFFFFFFFFFFFFFF, which faults (SIGSEGV). Fail-closed and branch-free.
##   a + b         (wa - 1) + wb                      a - b    wa - wb + 1
##   a * b         (wa >> 1) * (wb - 1) + 1
##   bit_and / or  the instruction on the two words   bit_xor  xorq, then `orq $1` restores the tag
##   bit_not(a)    negq: -(2a + 1) = 2(-a - 1) + 1
##   bit_shr(a, K) `sarq $K; orq $1`: floor((2a + 1) / 2^K) = a >> (K - 1), and x | 1 = 2 * (x >> 1) + 1
##   bit_shl(a, K) `decq; salq $K; incq`
##   ct_eq(a, b)   x = wa ^ wb (zero exactly when a == b); (x | -x) >>logical 63; `xorq $1`; retag
##   ct_select     wb ^ ((wa ^ wb) & wm): the tag bits cancel, bit i + 1 of a word is bit i of its value
##   call          only another kernel (it carries the same guard, so the guarantee is closed under calls)
fn lct_has(xs, nm) = match xs
    Nil        => 0
    Cons(h, t) => if h == nm then 1 else lct_has(t, nm)
fn lct_names(prog) = match prog
    Nil        => Nil
    Cons(h, t) => lct_names1(h, lct_names(t))
fn lct_names1(s0, rest) = match s0
    OSig(nm, pubf, freef, pl, rty, fromp) => if (freef / 128) % 2 == 1 and (freef / 512) % 2 == 1 then Cons(nm, rest) else rest
    _                                     => rest
## the checker reports these first, with a fix-it; reaching one here means a path around the checker, and the
## kernel must not be emitted as anything else
fn lct_fail(fnm, what) = ctfail("lume: constant-time error [C0011]: " + what + " cannot be lowered inside constant-time kernel '" + fnm + "' (`@secret` + `@no_alloc`); the code generator emits nothing rather than code with a branch\n")
fn lct_leaf(e) = match e
    Num(n) => lfits63(n)
    Var(v) => 1
    _      => 0
fn lct_load(e, reg, c, s) = match e
    Num(n)  => lres("    movq $" + str(lintword(n)) + ", " + reg + "\n", s)
    Var(nm) => let k = lidxof(c.locals, nm) in if k >= 0 then lres("    movq " + lslot(k) + "(%rbp), " + reg + "\n", s) else lres(lct_fail(c.fnm, "the name '" + nm + "' (neither a parameter nor a let-bound integer)"), s)
    _       => lres(lct_fail(c.fnm, "a non-leaf operand"), s)
fn lct_push(r) = lres(r.code + "    pushq %rax\n", r)
## two operands: left in %rax, right in %rcx
fn lct_two(l, r, c, s) = if lct_leaf(r) == 1 then lct_two_r(lct_e(l, c, s), r, c) else if lct_leaf(l) == 1 then lct_two_l(lct_e(r, c, s), l, c) else lct_two_2(lct_e(l, c, s), r, c)
fn lct_two_r(a, r, c) = let b = lct_load(r, "%rcx", c, a) in lres(a.code + b.code, b)
fn lct_two_l(a, l, c) = let b = lct_load(l, "%rax", c, a) in lres(a.code + "    movq %rax, %rcx\n" + b.code, b)
fn lct_two_2(a, r, c) = let b = lct_e(r, c, a) in lres(a.code + "    pushq %rax\n" + b.code + "    movq %rax, %rcx\n    popq %rax\n", b)
fn lct_is_arith(op) = if op == "+" or op == "-" or op == "*" or op == "+%" or op == "-%" or op == "*%" then 1 else 0
fn lct_arith(op) = if op == "+" or op == "+%" then "    decq %rax\n    addq %rcx, %rax\n" else if op == "-" or op == "-%" then "    subq %rcx, %rax\n    incq %rax\n" else "    sarq $1, %rax\n    decq %rcx\n    imulq %rcx, %rax\n    incq %rax\n"
fn lct_tail(a, code) = lres(a.code + code, a)
fn lct_bit2(nm) = if nm == "bit_and" or nm == "bv_and" then "    andq %rcx, %rax\n" else if nm == "bit_or" or nm == "bv_or" then "    orq %rcx, %rax\n" else if nm == "bit_xor" or nm == "bv_xor" then "    xorq %rcx, %rax\n    orq $1, %rax\n" else ""
fn lct_shift_k(e) = match e
    Num(n) => n
    _      => 0 - 1
fn lct_shr(a, k, c) = if k < 0 or k > 62 then lres(lct_fail(c.fnm, "bit_shr with a shift amount that is not an integer literal in 0..62"), a) else if k == 0 then a else lct_tail(a, "    sarq $" + str(k) + ", %rax\n    orq $1, %rax\n")
fn lct_shl(a, k, c) = if k < 0 or k > 61 then lres(lct_fail(c.fnm, "bit_shl with a shift amount that is not an integer literal in 0..61"), a) else if k == 0 then a else lct_tail(a, "    decq %rax\n    salq $" + str(k) + ", %rax\n    incq %rax\n")
## ct_select(m, a, b): a in %rcx, b in %rax, m in %rdx
fn lct_sel(m, a, b, c, s) = let r1 = if lct_leaf(m) == 1 then lres("", s) else lct_push(lct_e(m, c, s)) in let r2 = if lct_leaf(a) == 1 then lres("", r1) else lct_push(lct_e(a, c, r1)) in let r3 = lct_e(b, c, r2) in let r4 = if lct_leaf(a) == 1 then lct_load(a, "%rcx", c, r3) else lres("    popq %rcx\n", r3) in let r5 = if lct_leaf(m) == 1 then lct_load(m, "%rdx", c, r4) else lres("    popq %rdx\n", r4) in lres(r1.code + r2.code + r3.code + r4.code + r5.code + "    xorq %rax, %rcx\n    andq %rdx, %rcx\n    xorq %rcx, %rax\n", r5)
## a call of another kernel: computed arguments are pushed in order and popped into their registers, leaves are
## loaded last; arguments past the sixth go to the outgoing area the caller reserves (same layout as lcall)
fn lct_args_eval(xs, c, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => if lct_leaf(h) == 1 then lct_args_eval(t, c, s) else lct_args_ev2(lct_push(lct_e(h, c, s)), t, c)
fn lct_args_ev2(a, t, c) = let rest = lct_args_eval(t, c, a) in lres(a.code + rest.code, rest)
fn lct_args_pop(xs, i) = match xs
    Nil        => ""
    Cons(h, t) => lct_args_pop(t, i + 1) + (if lct_leaf(h) == 1 then "" else "    popq " + areg(i) + "\n")
fn lct_args_leaf(xs, i, c, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => if lct_leaf(h) == 1 then lct_args_lf2(lct_load(h, areg(i), c, s), t, i, c) else lct_args_leaf(t, i + 1, c, s)
fn lct_args_lf2(a, t, i, c) = let rest = lct_args_leaf(t, i + 1, c, a) in lres(a.code + rest.code, rest)
fn lct_args_push(xs, q, m, c, s) = if q >= m then lres("", s) else lct_args_push2(xs, q, m, c, s)
fn lct_args_push2(xs, q, m, c, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => lct_args_push3(lct_push(lct_e(h, c, s)), t, q, m, c)
fn lct_args_push3(a, t, q, m, c) = let rest = lct_args_push(t, q + 1, m, c, a) in lres(a.code + rest.code, rest)
fn lct_args_stk(xs, k, c, s) = match xs
    Nil        => lres("", s)
    Cons(h, t) => lct_args_stk2(lct_e(h, c, s), t, k, c)
fn lct_args_stk2(a, t, k, c) = let rest = lct_args_stk(t, k + 1, c, a) in lres(a.code + "    movq %rax, " + str(48 + k * 8) + "(%rsp)\n" + rest.code, rest)
fn lct_call(nm, args, c, s) = if nm == c.fnm then lres(lct_fail(c.fnm, "the recursive call '" + nm + "(...)'"), s) else if lct_has(s.cts, nm) == 0 then lres(lct_fail(c.fnm, "the call of '" + nm + "', which is not a constant-time kernel,"), s) else if len(args) <= 6 then lct_call_reg(nm, args, c, lct_args_eval(args, c, s)) else lct_call_stk(nm, args, len(args) - 6, c, s)
fn lct_call_reg(nm, args, c, ev) = let lf = lct_args_leaf(args, 0, c, ev) in lres(ev.code + lct_args_pop(args, 0) + lf.code + "    call " + nm + "\n", lf)
fn lct_call_stk(nm, args, nst, c, s) = let spad = if nst % 2 == 1 then (nst + 1) * 8 else nst * 8 in let rg = lct_args_push(args, 0, 6, c, s) in let st = lct_args_stk(drop(args, 6), 0, c, rg) in lres("    subq $" + str(spad) + ", %rsp\n" + rg.code + st.code + lpops(5) + "    call " + nm + "\n    addq $" + str(spad) + ", %rsp\n", st)
fn lct_callx(nm, args, c, s) = let n = len(args) in if n == 2 and lct_bit2(nm) != "" then lct_tail(lct_two(lqhead(args), lqhead(lqrest(args)), c, s), lct_bit2(nm)) else if nm == "bit_not" and n == 1 then lct_tail(lct_e(lqhead(args), c, s), "    negq %rax\n") else if (nm == "bit_shr" or nm == "bv_shr") and n == 2 then lct_shr(lct_e(lqhead(args), c, s), lct_shift_k(lqhead(lqrest(args))), c) else if (nm == "bit_shl" or nm == "bv_shl") and n == 2 then lct_shl(lct_e(lqhead(args), c, s), lct_shift_k(lqhead(lqrest(args))), c) else if nm == "ct_eq" and n == 2 then lct_tail(lct_two(lqhead(args), lqhead(lqrest(args)), c, s), "    xorq %rcx, %rax\n    movq %rax, %rcx\n    negq %rcx\n    orq %rcx, %rax\n    shrq $63, %rax\n    xorq $1, %rax\n    leaq 1(%rax,%rax), %rax\n") else if nm == "ct_select" and n == 3 then lct_sel(lqhead(args), lqhead(lqrest(args)), lqhead(lqrest(lqrest(args))), c, s) else if isctor(nm) or nf_rt(nm) == 1 or nf_special(nm) == 1 then lres(lct_fail(c.fnm, "the call of '" + nm + "'"), s) else lct_call(nm, args, c, s)
fn lct_let(nm, vr, b, c) = let br = lct_e(b, c, vr) in lres(vr.code + "    movq %rax, " + lslot(lidxof(c.locals, nm)) + "(%rbp)\n" + br.code, br)
fn lct_e(e, c, s) = match e
    Num(n)          => if lfits63(n) then lct_load(e, "%rax", c, s) else lres(lct_fail(c.fnm, "the integer literal " + str(n) + " (outside the 63-bit immediate range)"), s)
    Var(nm)         => lct_load(e, "%rax", c, s)
    Bin(op, l, r)   => if lct_is_arith(op) == 1 then lct_tail(lct_two(l, r, c, s), lct_arith(op)) else lres(lct_fail(c.fnm, "the operator '" + op + "'"), s)
    LetIn(nm, v, b) => lct_let(nm, lct_e(v, c, s), b, c)
    Call(nm, args)  => lct_callx(nm, args, c, s)
    _               => lres(lct_fail(c.fnm, "a construct outside the constant-time subset (conditional, match, record, string, ...)"), s)
fn lct_guard_and(i, n) = if i >= n then "" else "    movq " + lslot(i) + "(%rbp), %rcx\n    andq %rcx, %rax\n" + lct_guard_and(i + 1, n)
fn lct_guard(n) = if n <= 0 then "" else "    movq " + lslot(0) + "(%rbp), %rax\n" + lct_guard_and(1, n) + "    andq $1, %rax\n    decq %rax\n    orq %rsp, %rax\n    movq (%rax), %rax\n"
fn lct_fn(nm, params, body0, s) = let body = lalpha(lcf(body0), params) in let locals = app(params, lcollect(body)) in let frame = lframe(len(locals)) in let br = lct_e(body, {locals: locals, fnm: nm}, s) in lres(nm + ":\n    pushq %rbp\n    movq %rsp, %rbp\n" + (if frame > 0 then "    subq $" + str(frame) + ", %rsp\n" else "") + lparams(params, 0) + lct_guard(len(params)) + br.code + "    movq %rbp, %rsp\n    popq %rbp\n    ret\n", br)

## --- functions ---
fn lparams(ps, i) = match ps
    Nil        => ""
    Cons(h, t) => if i < 6 then "    movq " + areg(i) + ", " + lslot(i) + "(%rbp)\n" + lparams(t, i + 1) else "    movq " + str(16 + 8 * (i - 6)) + "(%rbp), %rax\n    movq %rax, " + lslot(i) + "(%rbp)\n" + lparams(t, i + 1)
fn lafn(nm, params, body, s) = lafn_typed(nm, params, body, Nil, s)
fn lafn_typed(nm, params, body0, dvars, s) = if lct_has(s.cts, nm) == 1 then lct_fn(nm, params, body0, s) else lafn_ord(nm, params, body0, dvars, s)
fn lafn_ord(nm, params, body0, dvars, s) = let body = lsra_expr(lalpha(lcf(body0), params)) in let locals = app(params, app(lcollect(body), lsds(0, lmdepth(body)))) in let frame = lframe(len(locals)) in let tlbl = s.pfx + ".Ltail_" + nm in let br = laexpr_tail(body, {locals: locals, bound: params, dvars: dvars, depth: 0, fnm: nm, nparams: len(params), tlbl: tlbl}, s) in let sub = if frame > 0 then "    subq $" + str(frame) + ", %rsp\n" else "" in let pentry = if len(params) <= 6 then tlbl + ":\n" + lparams(params, 0) else lparams(params, 0) + tlbl + ":\n" in lres(nm + ":\n    pushq %rbp\n    movq %rsp, %rbp\n" + sub + pentry + br.code + "    movq %rbp, %rsp\n    popq %rbp\n    ret\n", br)

## --- statements: one pass in source order threading the state ---
fn lmlocals(prog) = match prog
    Nil        => Nil
    Cons(h, t) => app(lmlocalsone(h), lmlocals(t))
fn lmlocalsone(s) = match s
    Print(v) => lcollect(lalpha(v, Nil))
    ExprS(v) => lcollect(lalpha(v, Nil))
    _        => Nil
fn lmdprog(prog) = match prog
    Nil        => 0
    Cons(h, t) => imax(lmdone(h), lmdprog(t))
fn lmdone(s) = match s
    Print(v) => lmdepth(v)
    ExprS(v) => lmdepth(v)
    _        => 0
fn lstmts(prog, mlocals, s) = match prog
    Nil        => {funcs: Nil, mains: Nil, nl: s.nl, ns: s.ns, dt: s.dt, pfx: s.pfx}
    Cons(h, t) => lstmt(h, t, mlocals, s)
fn lstmt(s0, t, mlocals, s) = match s0
    Fn(nm, ps, body) => lstmtfn(lafn(nm, ps, body, s), t, mlocals)
    Sig(nm, ps, tys, rt) => lstmt_sig(nm, ps, tys, t, mlocals, s)
    Print(v)         => lstmtprint(lax(lalpha(v, Nil), {locals: mlocals, bound: Nil, dvars: Nil, depth: 0, fnm: "", nparams: 0, tlbl: ""}, s), t, mlocals)
    ExprS(v)         => lstmtexpr(lax(lalpha(v, Nil), {locals: mlocals, bound: Nil, dvars: Nil, depth: 0, fnm: "", nparams: 0, tlbl: ""}, s), t, mlocals)
    _                => lstmts(t, mlocals, s)
fn lstmt_sig(nm, pnames, ptypes, rest, mlocals, s) = match rest
    Nil => lstmts(rest, mlocals, s)
    Cons(Fn(nm2, ps, body), tail) => lstmtfn(lafn_typed(nm2, ps, body, ldecimal_params(pnames, ptypes), s), tail, mlocals)
    _ => lstmts(rest, mlocals, s)
fn ldecimal_params(pnames, ptypes) = match pnames
    Nil => Nil
    Cons(pn, pr) => ldecimal_param(pn, pr, ptypes)
fn ldecimal_param(pn, rest, ptypes) = match ptypes
    Nil => ldecimal_params(rest, Nil)
    Cons(ty, tr) => app(if ldecimal_type(ty) then Cons(pn, Nil) else Nil, ldecimal_params(rest, tr))
fn ldecimal_type(ty) = match ty
    TyDecimal(p, s) => 1
    _ => 0
fn lstmtfn(f, t, mlocals) = let rest = lstmts(t, mlocals, f) in {funcs: Cons(f.code, rest.funcs), mains: rest.mains, nl: rest.nl, ns: rest.ns, dt: rest.dt, pfx: rest.pfx}
fn lstmtprint(pr, t, mlocals) = let rest = lstmts(t, mlocals, pr) in {funcs: rest.funcs, mains: Cons(pr.code + "    movq %rax, %rdi\n    call printval\n", rest.mains), nl: rest.nl, ns: rest.ns, dt: rest.dt, pfx: rest.pfx}
## an expression statement: evaluate `v` for its effect and DISCARD the pushed value (popq %rax, no printval)
fn lstmtexpr(er, t, mlocals) = let rest = lstmts(t, mlocals, er) in {funcs: rest.funcs, mains: Cons(er.code, rest.mains), nl: rest.nl, ns: rest.ns, dt: rest.dt, pfx: rest.pfx}

## --- the program: bss + rodata (oom_msg + string chunks) + text(funcs, runtime, _start, main) ---
fn luses_fs_expr(e) = match e
    Call(nm, args)  => if nm == "fs_write_sync" or nm == "fs_append_sync" or nm == "fs_read_file" or nm == "fs_read_dir" or nm == "fs_current_dir" or nm == "fs_path_exists" or nm == "fs_read_byte" or nm == "fs_mkdir" or nm == "fs_files_equal" or nm == "fs_write_hex_file" or nm == "fs_remove" then 1 else luses_fs_args(args)
    LetIn(nm, v, b) => if luses_fs_expr(v) == 1 then 1 else luses_fs_expr(b)
    Bin(op, l, r)   => if luses_fs_expr(l) == 1 then 1 else luses_fs_expr(r)
    If(c, t, e2)    => if luses_fs_expr(c) == 1 or luses_fs_expr(t) == 1 then 1 else luses_fs_expr(e2)
    Field(o, nm)    => luses_fs_expr(o)
    Rec(items)      => luses_fs_rec(items)
    RecT(tn, items) => luses_fs_rec(items)
    Match(sc, arms) => if luses_fs_expr(sc) == 1 then 1 else luses_fs_arms(arms)
    _               => 0
fn luses_fs_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_fs_expr(h) == 1 then 1 else luses_fs_args(t)
fn luses_fs_rec(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_fs_expr(h.val) == 1 then 1 else luses_fs_rec(t)
fn luses_fs_arms(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_fs_expr(h.body) == 1 then 1 else luses_fs_arms(t)
fn luses_fs_stmt(s0) = match s0
    Fn(nm, ps, body) => luses_fs_expr(body)
    Print(v)         => luses_fs_expr(v)
    ExprS(v)         => luses_fs_expr(v)
    _                => 0
fn luses_fs_prog(prog) = match prog
    Nil        => 0
    Cons(h, t) => if luses_fs_stmt(h) == 1 then 1 else luses_fs_prog(t)
fn lhas_fn(prog, nm) = match prog
    Nil        => 0
    Cons(h, t) => if lhas_fn1(h, nm) == 1 then 1 else lhas_fn(t, nm)
fn lhas_fn1(s0, nm) = match s0
    Fn(nm2, ps, body) => if nm2 == nm then 1 else 0
    _                 => 0
fn lcollect_ffi_osigs(prog, allp) = match prog
    Nil        => Nil
    Cons(h, t) => lcollect_ffi_osig1(h, allp, lcollect_ffi_osigs(t, allp))
fn lcollect_ffi_osig1(s0, allp, rest) = match s0
    OSig(nm, pubf, freef, pl, rty, fromp) => if (freef / 32) % 2 == 1 then (if pubf == 1 then Cons({nm: nm, pl: pl, rty: rty, exp: 1}, rest) else if lhas_fn(allp, nm) == 0 then Cons({nm: nm, pl: pl, rty: rty, exp: 0}, rest) else rest) else rest
    _                                     => rest
fn lcollect_ffi_links(prog) = match prog
    Nil        => ""
    Cons(h, t) => lcollect_ffi_link1(h) + lcollect_ffi_links(t)
fn lcollect_ffi_link1(s0) = match s0
    FFILink(libs) => lfmt_need_libs(libs)
    _             => ""
fn lfmt_need_libs(libs) = match libs
    Nil        => ""
    Cons(h, t) => "    .need \"" + h + "\"\n" + lfmt_need_libs(t)
fn lfind_ffi_osig(nm, osigs) = match osigs
    Nil        => {found: 0, exp: 0}
    Cons(o, r) => if o.nm == nm then {found: 1, exp: o.exp} else lfind_ffi_osig(nm, r)
fn lffi_rw_expr(e, osigs) = match e
    Call(nm, args)  => let lk = lfind_ffi_osig(nm, osigs) in let rargs = lffi_rw_args(args, osigs) in if lk.found == 1 then Call(if lk.exp == 1 then "__lume_fn_" + nm else "__lume_ffi_" + nm, rargs) else Call(nm, rargs)
    LetIn(nm, v, b) => LetIn(nm, lffi_rw_expr(v, osigs), lffi_rw_expr(b, osigs))
    Bin(op, l, r)   => Bin(op, lffi_rw_expr(l, osigs), lffi_rw_expr(r, osigs))
    If(c, t, e2)    => If(lffi_rw_expr(c, osigs), lffi_rw_expr(t, osigs), lffi_rw_expr(e2, osigs))
    Field(o, nm)    => Field(lffi_rw_expr(o, osigs), nm)
    Rec(items)      => Rec(lffi_rw_rec(items, osigs))
    RecT(tn, items) => RecT(tn, lffi_rw_rec(items, osigs))
    Match(sc, arms) => Match(lffi_rw_expr(sc, osigs), lffi_rw_arms(arms, osigs))
    _               => e
fn lffi_rw_args(xs, osigs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(lffi_rw_expr(h, osigs), lffi_rw_args(t, osigs))
fn lffi_rw_rec(xs, osigs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: lffi_rw_expr(h.val, osigs)}, lffi_rw_rec(t, osigs))
fn lffi_rw_arms(xs, osigs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: lffi_rw_expr(h.body, osigs)}, lffi_rw_arms(t, osigs))
fn lffi_rw_stmt(s0, osigs) = match s0
    Fn(nm, ps, body)     => let lk = lfind_ffi_osig(nm, osigs) in Fn(if lk.found == 1 and lk.exp == 1 then "__lume_fn_" + nm else nm, ps, lffi_rw_expr(body, osigs))
    Sig(nm, ps, tys, rt) => let lk = lfind_ffi_osig(nm, osigs) in Sig(if lk.found == 1 and lk.exp == 1 then "__lume_fn_" + nm else nm, ps, tys, rt)
    Print(v)             => Print(lffi_rw_expr(v, osigs))
    ExprS(v)             => ExprS(lffi_rw_expr(v, osigs))
    _                    => s0
fn lffi_rw_prog(prog, osigs) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(lffi_rw_stmt(h, osigs), lffi_rw_prog(t, osigs))
fn lis_cstr_ty(ty) = match ty
    TyName(n) => if n == "str" or n == "cstr" then 1 else 0
    _         => 0
fn lffi_unbox_args(pl, i) = match pl
    Nil        => ""
