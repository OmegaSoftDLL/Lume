fn rt_krn_head() = "__rt_ovf:\n__rt_div0:\n__rt_shc:\n__rt_need_int:\n__rt_not_int:\n__rt_not_bool:\n__rt_no_match:\n__rt_no_field:\n__rt_not_str:\n__rt_die3:\n    hlt\n    jmp __rt_ovf\n__lume_alloc_a:\nalloc:\n    movq .Lrt_heap_cur(%rip), %rax\n    movq %rax, %r10\n    addq %rdi, %r10\n    addq $7, %r10\n    andq $-8, %r10\n    cmpq %rax, %r10\n    jl .Lrt_alloc_oom\n    cmpq .Lrt_heap_end(%rip), %r10\n    jle .Lrt_alloc_ok\n    movq $3145728, %rax\n    movq %rax, %r10\n    addq %rdi, %r10\n    addq $7, %r10\n    andq $-8, %r10\n    cmpq .Lrt_heap_end(%rip), %r10\n    jg .Lrt_alloc_oom\n.Lrt_alloc_ok:\n    movq %r10, .Lrt_heap_cur(%rip)\n    ret\n.Lrt_alloc_oom:\n    leaq .Lrt_oom_msg(%rip), %rdi\n    call wstr\n    movq $244, %rdx\n    movq $12, %rax\n    outb %al, %dx\n    cli\n    hlt\n__rt_show_str:\n    movq $2, %rax\n    ret\n__rt_write:\n    testq %rcx, %rcx\n    jz __rt_kw9\n    movb (%rsi), %al\n    movq $1016, %rdx\n    outb %al, %dx\n    incq %rsi\n    decq %rcx\n    jmp __rt_write\n__rt_kw9:\n    ret\nwch:\n    movq %rdi, %rax\n    movq $1016, %rdx\n    outb %al, %dx\n    ret\n"
fn rt_krn_io() = "wstr:\n    movq %rdi, %r8\n.Lrt_ws0:\n    movb (%r8), %al\n    testb %al, %al\n    je .Lrt_ws1\n    movq $1016, %rdx\n    outb %al, %dx\n    incq %r8\n    jmp .Lrt_ws0\n.Lrt_ws1:\n    ret\nwint:\n    movq %rdi, %rax\n    xorq %r9, %r9\n    testq %rax, %rax\n    jge .Lrt_wi1\n    negq %rax\n    movq $1, %r9\n.Lrt_wi1:\n    leaq .Lrt_pbuf+31(%rip), %rsi\n    movb $0, (%rsi)\n    movq $10, %r8\n.Lrt_wi2:\n    decq %rsi\n    xorq %rdx, %rdx\n    divq %r8\n    addb $48, %dl\n    movb %dl, (%rsi)\n    testq %rax, %rax\n    jnz .Lrt_wi2\n    testq %r9, %r9\n    je .Lrt_wi3\n    decq %rsi\n    movb $45, (%rsi)\n.Lrt_wi3:\n    movq %rsi, %rdi\n    call wstr\n    ret\nprint_int:\n    call wint\n    movq $10, %rdi\n    call wch\n    ret\nctfail:\n    call __rt_sv0\n    movq %rax, %rdi\n    call wstr\n    movq $244, %rdx\n    movq $3, %rax\n    outb %al, %dx\n    cli\n    hlt\n"
fn runtime_krn_tail() = rt_krn_head() + rt_idiv() + rt_rec_update() + rt_boxes() + rt_records() + rt_compare() + rt_add() + rt_count() + rt_index() + rt_convert() + rt_cstr() + rt_equal() + rt_show() + rt_dec() + rt_dec_dyn_stub() + rt_bytes() + rt_krn_io()
## --- program analysis vs. emission split (incremental compilation, #310): `lgen_analysis` walks the
## (already checked/expanded) program and produces every text piece and whole-program flag; `lgen_emit`
## assembles the final assembly from those pieces. The single-unit driver `lgen` is exactly
## `lgen_emit(lgen_analysis(prog0, ""))` — an empty label prefix reproduces the historical output
## byte-for-byte. Module mode runs `lgen_analysis(prog, "<module>-scoped prefix")` and caches the pieces.
## --- record flattening (LumeDesk, 2026-11-18): small calls inlined, records that never escape kept in locals ---------
## (prefix rxq_: functions named lfl_* were miscompiled by the seed code generator, data_asm_cc.lume, a name clash)
## A small non-recursive function (tiny, or returning a record literal; Num / Str / Var / Bin / If / LetIn / Call /
## Field / Rec only) is inlined where it is called: its parameters become fresh lets holding the arguments (call-by-value, evaluated in
## order; at most one argument that is not a variable, a number, a string or a field of a variable, so no effect
## changes order) and its own lets are renamed fresh. Then a record that only has its fields read is replaced by one
## local per field: `let r = {a: x, b: y} in r.a + r.b`, `({a: x}).a`, a record returned by an inlined helper and read
## by an inlined consumer. Nothing is inlined into or out of @secret functions or kernels, into a function whose
## locals share a name with what the callee calls, or across a node the pass does not know (match, closures...):
## those stay calls, which is always correct.
fn rxq_ok(e) = match e
    Num(n)          => 1
    Str(s)          => 1
    Var(x)          => 1
    Bin(op, l, r)   => if rxq_ok(l) == 1 then rxq_ok(r) else 0
    If(c, t, e2)    => if rxq_ok(c) == 1 and rxq_ok(t) == 1 then rxq_ok(e2) else 0
    LetIn(nm, v, b) => if rxq_ok(v) == 1 then rxq_ok(b) else 0
    Call(nm, args)  => rxq_ok_args(args)
    Field(o, k)     => rxq_ok(o)
    Rec(items)      => rxq_ok_items(items)
    _               => 0
fn rxq_ok_args(xs) = match xs
    Nil        => 1
    Cons(h, t) => if rxq_ok(h) == 1 then rxq_ok_args(t) else 0
fn rxq_ok_items(xs) = match xs
    Nil        => 1
    Cons(h, t) => if rxq_ok(h.val) == 1 then rxq_ok_items(t) else 0
fn rxq_size(e) = match e
    Bin(op, l, r)   => 1 + rxq_size(l) + rxq_size(r)
    If(c, t, e2)    => 1 + rxq_size(c) + rxq_size(t) + rxq_size(e2)
    LetIn(nm, v, b) => 1 + rxq_size(v) + rxq_size(b)
    Call(nm, args)  => 1 + rxq_size_args(args)
    Field(o, k)     => 1 + rxq_size(o)
    Rec(items)      => 1 + rxq_size_items(items)
    _               => 1
fn rxq_size_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => rxq_size(h) + rxq_size_args(t)
fn rxq_size_items(xs) = match xs
    Nil        => 0
    Cons(h, t) => rxq_size(h.val) + rxq_size_items(t)
## every name a body calls or reads (a superset of what it needs from the caller's scope)
fn rxq_names(e, acc) = match e
    Var(x)          => Cons(x, acc)
    Bin(op, l, r)   => rxq_names(l, rxq_names(r, acc))
    If(c, t, e2)    => rxq_names(c, rxq_names(t, rxq_names(e2, acc)))
    LetIn(nm, v, b) => rxq_names(v, rxq_names(b, acc))
    Call(nm, args)  => Cons(nm, rxq_names_args(args, acc))
    Field(o, k)     => rxq_names(o, acc)
    Rec(items)      => rxq_names_items(items, acc)
    _               => acc
fn rxq_names_args(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => rxq_names(h, rxq_names_args(t, acc))
fn rxq_names_items(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => rxq_names(h.val, rxq_names_items(t, acc))
## the names a function binds: its parameters and every let of its body
fn rxq_binders(e, acc) = match e
    Bin(op, l, r)   => rxq_binders(l, rxq_binders(r, acc))
    If(c, t, e2)    => rxq_binders(c, rxq_binders(t, rxq_binders(e2, acc)))
    LetIn(nm, v, b) => Cons(nm, rxq_binders(v, rxq_binders(b, acc)))
    Call(nm, args)  => rxq_binders_args(args, acc)
    Field(o, k)     => rxq_binders(o, acc)
    Rec(items)      => rxq_binders_items(items, acc)
    _               => acc
fn rxq_binders_args(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => rxq_binders(h, rxq_binders_args(t, acc))
fn rxq_binders_items(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => rxq_binders(h.val, rxq_binders_items(t, acc))
fn rxq_any_in(xs, ys) = match xs
    Nil        => 0
    Cons(h, t) => if omem(h, ys) == 1 then 1 else rxq_any_in(t, ys)
fn rxq_simple(e) = match e
    Num(n)      => 1
    Str(s)      => 1
    Var(x)      => 1
    Field(o, k) => rxq_simple(o)
    _           => 0
fn rxq_complex_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => (if rxq_simple(h) == 1 then 0 else 1) + rxq_complex_args(t)
fn rxq_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + rxq_len(t)

## what is worth inlining: a tiny function (12 nodes at most, builtins only: `esc`, `s4`, an accessor), or one that returns a record
## literal (200 nodes at most: a producer whose record the caller can keep in locals). Inlining nests two levels at
## most and stops after about 4000 expansions in one function, so code size stays bounded.
## a tiny function is inlined only when it calls nothing but builtins and constructors (`esc`, `s4`, accessors): one
## that calls the program's own functions (it may build a big value and return a small one) stays a call, so a dead
## value does not linger in the caller's frame where the conservative collector would still see it
fn rxq_builtins_only(xs) = match xs
    Nil        => 1
    Cons(h, t) => if isctor(h) or nf_builtin_arity(h) >= 0 then rxq_builtins_only(t) else 0
fn rxq_returns_rec(e) = match e
    Rec(items)      => 1
    LetIn(nm, v, b) => rxq_returns_rec(b)
    Call(nm, args)  => if nm == "_tylist_" and len(args) >= 1 and len(args) <= 8 then 1 else 0
    If(c, t, e2)    => if rxq_returns_rec(t) == 1 then rxq_returns_rec(e2) else 0
    _               => 0
## the candidate table: {nm, ps, body} of every function that may be inlined
fn rxq_secret(nm, cts) = omem(nm, cts) == 1 or omem("secret:" + nm, cts) == 1
fn rxq_table(prog, cts) = match prog
    Nil        => Nil
    Cons(h, t) => rxq_table1(h, cts, rxq_table(t, cts))
fn rxq_table1(s0, cts, rest) = match s0
    Fn(nm, ps, body) => if (not rxq_secret(nm, cts)) and rxq_ok(body) == 1 and ((rxq_size(body) <= 12 and rxq_builtins_only(rxq_calls(body, Nil)) == 1) or (rxq_returns_rec(body) == 1 and rxq_size(body) <= 200)) and omem(nm, rxq_names(body, Nil)) == 0 and rxq_any_in(rxq_calls(body, Nil), rxq_binders(body, ps)) == 0 then Cons({nm: nm, ps: ps, body: body, ext: rxq_minus(rxq_names(body, Nil), rxq_binders(body, ps))}, rest) else rest
    _                => rest
## the names a body calls (a call of a parameter or a let is a closure call: such a body is not inlined)
fn rxq_calls(e, acc) = match e
    Bin(op, l, r)   => rxq_calls(l, rxq_calls(r, acc))
    If(c, t, e2)    => rxq_calls(c, rxq_calls(t, rxq_calls(e2, acc)))
    LetIn(nm, v, b) => rxq_calls(v, rxq_calls(b, acc))
    Call(nm, args)  => Cons(nm, rxq_calls_args(args, acc))
    Field(o, k)     => rxq_calls(o, acc)
    Rec(items)      => rxq_calls_items(items, acc)
    _               => acc
fn rxq_calls_args(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => rxq_calls(h, rxq_calls_args(t, acc))
fn rxq_calls_items(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => rxq_calls(h.val, rxq_calls_items(t, acc))
## what a body names from outside itself (its parameters and lets taken out)
fn rxq_minus(xs, ys) = match xs
    Nil        => Nil
    Cons(h, t) => if omem(h, ys) == 1 then rxq_minus(t, ys) else Cons(h, rxq_minus(t, ys))
fn rxq_find(nm, tbl) = match tbl
    Nil        => Nil
    Cons(h, t) => if h.nm == nm then Cons(h, Nil) else rxq_find(nm, t)

## renaming of an inlined body: parameters to the temporaries, every let to a fresh name
fn rxq_lookup(x, m) = match m
    Nil        => x
    Cons(h, t) => if h.from == x then h.to else rxq_lookup(x, t)
fn rxq_ren(e, m, k) = match e
    Var(x)          => {e: Var(rxq_lookup(x, m)), k: k}
    Bin(op, l, r)   => let a = rxq_ren(l, m, k) in let b = rxq_ren(r, m, a.k) in {e: Bin(op, a.e, b.e), k: b.k}
    If(c, t, e2)    => let a = rxq_ren(c, m, k) in let b = rxq_ren(t, m, a.k) in let d = rxq_ren(e2, m, b.k) in {e: If(a.e, b.e, d.e), k: d.k}
    LetIn(nm, v, b) => let a = rxq_ren(v, m, k) in let fresh = "_fl" + str(a.k) in let bb = rxq_ren(b, Cons({from: nm, to: fresh}, m), a.k + 1) in {e: LetIn(fresh, a.e, bb.e), k: bb.k}
    Call(nm, args)  => let a = rxq_ren_args(args, m, k) in {e: Call(nm, a.xs), k: a.k}
    Field(o, f)     => let a = rxq_ren(o, m, k) in {e: Field(a.e, f), k: a.k}
    Rec(items)      => let a = rxq_ren_items(items, m, k) in {e: Rec(a.xs), k: a.k}
    _               => {e: e, k: k}
fn rxq_ren_args(xs, m, k) = match xs
    Nil        => {xs: Nil, k: k}
    Cons(h, t) => let a = rxq_ren(h, m, k) in let b = rxq_ren_args(t, m, a.k) in {xs: Cons(a.e, b.xs), k: b.k}
fn rxq_ren_items(xs, m, k) = match xs
    Nil        => {xs: Nil, k: k}
    Cons(h, t) => let a = rxq_ren(h.val, m, k) in let b = rxq_ren_items(t, m, a.k) in {xs: Cons({key: h.key, val: a.e}, b.xs), k: b.k}
## parameters -> temporaries (the map) and the lets that hold the arguments, first argument outermost
fn rxq_pmap(ps, k) = match ps
    Nil        => {m: Nil, k: k}
    Cons(h, t) => let r = rxq_pmap(t, k + 1) in {m: Cons({from: h, to: "_fl" + str(k)}, r.m), k: r.k}
fn rxq_wrap(m, args, body) = match m
    Nil        => body
    Cons(h, t) => rxq_wrap1(h.to, t, args, body)
fn rxq_wrap1(to, mt, args, body) = match args
    Nil           => body
    Cons(a, rest) => LetIn(to, a, rxq_wrap(mt, rest, body))

## inlining inside one expression: cx = {tbl, binders (the caller's names), depth (bounds nested inlining)}
fn rxq_in(e, cx, k) = match e
    Bin(op, l, r)   => let a = rxq_in(l, cx, k) in let b = rxq_in(r, cx, a.k) in {e: Bin(op, a.e, b.e), k: b.k}
    If(c, t, e2)    => let a = rxq_in(c, cx, k) in let b = rxq_in(t, cx, a.k) in let d = rxq_in(e2, cx, b.k) in {e: If(a.e, b.e, d.e), k: d.k}
    LetIn(nm, v, b) => let a = rxq_in(v, cx, k) in let bb = rxq_in(b, cx, a.k) in {e: LetIn(nm, a.e, bb.e), k: bb.k}
    Field(o, f)     => let a = rxq_in(o, cx, k) in {e: Field(a.e, f), k: a.k}
    Rec(items)      => let a = rxq_in_items(items, cx, k) in {e: Rec(a.xs), k: a.k}
    Call(nm, args)  => let a = rxq_in_args(args, cx, k) in rxq_call(nm, a.xs, rxq_find(nm, cx.tbl), cx, a.k)
    Match(sc, arms) => let a = rxq_in(sc, cx, k) in let b = rxq_in_arms(arms, cx, a.k) in {e: Match(a.e, b.xs), k: b.k}
    _               => {e: e, k: k}
## inside an arm the names its pattern binds are the caller's too (a callee naming one of them stays a call)
fn rxq_in_arms(xs, cx, k) = match xs
    Nil        => {xs: Nil, k: k}
    Cons(h, t) => let a = rxq_in(h.body, {tbl: cx.tbl, binders: rsr_pbs(h.pat, cx.binders), depth: cx.depth}, k) in let b = rxq_in_arms(t, cx, a.k) in {xs: Cons({pat: h.pat, body: a.e}, b.xs), k: b.k}
fn rxq_in_args(xs, cx, k) = match xs
    Nil        => {xs: Nil, k: k}
    Cons(h, t) => let a = rxq_in(h, cx, k) in let b = rxq_in_args(t, cx, a.k) in {xs: Cons(a.e, b.xs), k: b.k}
fn rxq_in_items(xs, cx, k) = match xs
    Nil        => {xs: Nil, k: k}
    Cons(h, t) => let a = rxq_in(h.val, cx, k) in let b = rxq_in_items(t, cx, a.k) in {xs: Cons({key: h.key, val: a.e}, b.xs), k: b.k}
fn rxq_call(nm, args, found, cx, k) = match found
    Nil        => {e: Call(nm, args), k: k}
    Cons(f, t) => if cx.depth >= 2 or k - 1000000 > 4000 or omem(nm, cx.binders) == 1 or rxq_len(f.ps) != rxq_len(args) or rxq_complex_args(args) > 1 or rxq_any_in(f.ext, cx.binders) == 1 then {e: Call(nm, args), k: k} else rxq_expand(f, args, cx, k)
fn rxq_expand(f, args, cx, k) = let pm = rxq_pmap(f.ps, k) in let rb = rxq_ren(f.body, pm.m, pm.k) in let inner = rxq_in(rb.e, {tbl: cx.tbl, binders: cx.binders, depth: cx.depth + 1}, rb.k) in {e: rxq_wrap(pm.m, args, inner.e), k: inner.k}

## scalar replacement after inlining
fn rxq_is_fresh(x) = count(x) > 3 and slice(x, 0, 3) == "_fl"
fn rxq_has_key(items, k) = match items
    Nil        => 0
    Cons(h, t) => if h.key == k then 1 else rxq_has_key(t, k)
## does x reach anything but `x.k` (k a key of the record) in e?
fn rxq_fields_only(x, items, e) = match e
    Var(y)          => if y == x then 0 else 1
    Num(n)          => 1
    Str(s)          => 1
    Field(o, k)     => if rxq_isvar(o, x) == 1 then rxq_has_key(items, k) else rxq_fields_only(x, items, o)
    Bin(op, l, r)   => if rxq_fields_only(x, items, l) == 1 then rxq_fields_only(x, items, r) else 0
    If(c, t, e2)    => if rxq_fields_only(x, items, c) == 1 and rxq_fields_only(x, items, t) == 1 then rxq_fields_only(x, items, e2) else 0
    LetIn(nm, v, b) => if rxq_fields_only(x, items, v) == 0 then 0 else if nm == x then 1 else rxq_fields_only(x, items, b)
    Call(nm, args)  => rxq_fields_only_args(x, items, args)
    Rec(its)        => rxq_fields_only_items(x, items, its)
    _               => if omentions_var(x, e) == 1 then 0 else 1
fn rxq_fields_only_args(x, items, xs) = match xs
    Nil        => 1
    Cons(h, t) => if rxq_fields_only(x, items, h) == 1 then rxq_fields_only_args(x, items, t) else 0
fn rxq_fields_only_items(x, items, xs) = match xs
    Nil        => 1
    Cons(h, t) => if rxq_fields_only(x, items, h.val) == 1 then rxq_fields_only_items(x, items, t) else 0
fn rxq_isvar(e, x) = match e
    Var(y) => if y == x then 1 else 0
    _      => 0
## x.k -> the local of field k (m: key -> local)
fn rxq_sub(x, m, e) = match e
    Field(o, k)     => if rxq_isvar(o, x) == 1 then Var(rxq_lookup(k, m)) else Field(rxq_sub(x, m, o), k)
    Bin(op, l, r)   => Bin(op, rxq_sub(x, m, l), rxq_sub(x, m, r))
    If(c, t, e2)    => If(rxq_sub(x, m, c), rxq_sub(x, m, t), rxq_sub(x, m, e2))
    LetIn(nm, v, b) => LetIn(nm, rxq_sub(x, m, v), if nm == x then b else rxq_sub(x, m, b))
    Call(nm, args)  => Call(nm, rxq_sub_args(x, m, args))
    Rec(its)        => Rec(rxq_sub_items(x, m, its))
    _               => e
fn rxq_sub_args(x, m, xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(rxq_sub(x, m, h), rxq_sub_args(x, m, t))
fn rxq_sub_items(x, m, xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: rxq_sub(x, m, h.val)}, rxq_sub_items(x, m, t))
## one local per field, the values evaluated in the order written
fn rxq_fmap(items, k) = match items
    Nil        => {m: Nil, k: k}
    Cons(h, t) => let r = rxq_fmap(t, k + 1) in {m: Cons({from: h.key, to: "_fl" + str(k)}, r.m), k: r.k}
fn rxq_fwrap(m, items, body) = match m
    Nil        => body
    Cons(h, t) => rxq_fwrap1(h.to, t, items, body)
fn rxq_fwrap1(to, mt, items, body) = match items
    Nil            => body
    Cons(it, rest) => LetIn(to, it.val, rxq_fwrap(mt, rest, body))
fn rxq_simp(e, k) = match e
    LetIn(nm, v, b) => let a = rxq_simp(v, k) in let bb = rxq_simp(b, a.k) in rxq_let(nm, a.e, bb.e, bb.k)
    Field(o, f)     => let a = rxq_simp(o, k) in rxq_field(a.e, f, a.k)
    Bin(op, l, r)   => let a = rxq_simp(l, k) in let b = rxq_simp(r, a.k) in {e: Bin(op, a.e, b.e), k: b.k}
    If(c, t, e2)    => let a = rxq_simp(c, k) in let b = rxq_simp(t, a.k) in let d = rxq_simp(e2, b.k) in {e: If(a.e, b.e, d.e), k: d.k}
    Call(nm, args)  => let a = rxq_simp_args(args, k) in rxq_lidx(nm, a.xs, a.k)
    Rec(items)      => let a = rxq_simp_items(items, k) in {e: Rec(a.xs), k: a.k}
    Match(sc, arms) => let a = rxq_simp(sc, k) in let b = rxq_simp_arms(arms, a.k) in {e: Match(a.e, b.xs), k: b.k}
    _               => {e: e, k: k}
fn rxq_simp_arms(xs, k) = match xs
    Nil        => {xs: Nil, k: k}
    Cons(h, t) => let a = rxq_simp(h.body, k) in let b = rxq_simp_arms(t, a.k) in {xs: Cons({pat: h.pat, body: a.e}, b.xs), k: b.k}
fn rxq_simp_args(xs, k) = match xs
    Nil        => {xs: Nil, k: k}
    Cons(h, t) => let a = rxq_simp(h, k) in let b = rxq_simp_args(t, a.k) in {xs: Cons(a.e, b.xs), k: b.k}
fn rxq_simp_items(xs, k) = match xs
    Nil        => {xs: Nil, k: k}
    Cons(h, t) => let a = rxq_simp(h.val, k) in let b = rxq_simp_items(t, a.k) in {xs: Cons({key: h.key, val: a.e}, b.xs), k: b.k}
## let x = (let y = v in b) in body -> let y = v in let x = b in body (y fresh, so nothing is captured)
fn rxq_let(nm, v, body, k) = match v
    LetIn(y, v2, b2) => if rxq_is_fresh(y) then rxq_let(y, v2, LetIn(nm, b2, body), k) else rxq_let2(nm, v, body, k)
    _                => rxq_let2(nm, v, body, k)
fn rxq_let2(nm, v, body, k) = match v
    Rec(items) => if rxq_fields_only(nm, items, body) == 1 then (let fm = rxq_fmap(items, k) in rxq_simp(rxq_fwrap(fm.m, items, rxq_sub(nm, fm.m, body)), fm.k)) else {e: LetIn(nm, v, body), k: k}
    Call(f, xs) => if f == "_tylist_" and len(xs) >= 1 and rxq_idx_only(nm, len(xs), body) == 1 then (let items = rxq_litems(xs, 0) in let fm = rxq_fmap(items, k) in rxq_simp(rxq_fwrap(fm.m, items, rxq_lsub(nm, fm.m, body)), fm.k)) else {e: LetIn(nm, v, body), k: k}
    If(c, a, b) => if rxq_size(body) <= 40 and rxq_brok(nm, a, body) == 1 and rxq_brok(nm, b, body) == 1 then rxq_letif(nm, c, a, b, body, k) else {e: LetIn(nm, v, body), k: k}
    _          => {e: LetIn(nm, v, body), k: k}
## a list literal used as a tuple: `let t = [a, b] in t[0] + t[1]` keeps one local per element, as a record
## (2026-11-21). The elements are the items {key: "0", val: a}, {key: "1", val: b}, ... of the record code above.
fn rxq_litems(xs, i) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: str(i), val: h}, rxq_litems(t, i + 1))
## does x reach anything but `x[i]` (i a literal below n) in e?
fn rxq_idx_only(x, n, e) = match e
    Var(y)          => if y == x then 0 else 1
    Num(v)          => 1
    Str(s)          => 1
    Field(o, k)     => rxq_idx_only(x, n, o)
    Bin(op, l, r)   => if rxq_idx_only(x, n, l) == 1 then rxq_idx_only(x, n, r) else 0
    If(c, t, e2)    => if rxq_idx_only(x, n, c) == 1 and rxq_idx_only(x, n, t) == 1 then rxq_idx_only(x, n, e2) else 0
    LetIn(nm, v, b) => if rxq_idx_only(x, n, v) == 0 then 0 else if nm == x then 1 else rxq_idx_only(x, n, b)
    Call(nm, args)  => if nm == x then 0 else if nm == "lidx" and len(args) == 2 and rxq_isvar(rsr_hd(args), x) == 1 then (if rsr_nidx(ifp_nth(args, 1), n) >= 0 then 1 else 0) else rxq_idx_only_args(x, n, args)
    Rec(its)        => rxq_idx_only_items(x, n, its)
    _               => if omentions_var(x, e) == 1 then 0 else 1
fn rxq_idx_only_args(x, n, xs) = match xs
    Nil        => 1
    Cons(h, t) => if rxq_idx_only(x, n, h) == 1 then rxq_idx_only_args(x, n, t) else 0
fn rxq_idx_only_items(x, n, xs) = match xs
    Nil        => 1
    Cons(h, t) => if rxq_idx_only(x, n, h.val) == 1 then rxq_idx_only_items(x, n, t) else 0
## x[i] -> the local of element i (m: "i" -> local)
fn rxq_lsub(x, m, e) = match e
    Call(nm, args)  => if nm == "lidx" and len(args) == 2 and rxq_isvar(rsr_hd(args), x) == 1 then Var(rxq_lookup(str(rsr_nidx(ifp_nth(args, 1), 1000000)), m)) else Call(nm, rxq_lsub_args(x, m, args))
    Field(o, k)     => Field(rxq_lsub(x, m, o), k)
    Bin(op, l, r)   => Bin(op, rxq_lsub(x, m, l), rxq_lsub(x, m, r))
    If(c, t, e2)    => If(rxq_lsub(x, m, c), rxq_lsub(x, m, t), rxq_lsub(x, m, e2))
    LetIn(nm, v, b) => LetIn(nm, rxq_lsub(x, m, v), if nm == x then b else rxq_lsub(x, m, b))
    Rec(its)        => Rec(rxq_lsub_items(x, m, its))
    _               => e
fn rxq_lsub_args(x, m, xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(rxq_lsub(x, m, h), rxq_lsub_args(x, m, t))
fn rxq_lsub_items(x, m, xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: rxq_lsub(x, m, h.val)}, rxq_lsub_items(x, m, t))
## (let y = v in b)[i] -> let y = v in b[i]; [x0, ..., xn][i] (i a literal below n) -> the elements' locals, then xi
fn rxq_lidx(nm, xs, k) = if nm == "lidx" and len(xs) == 2 and rsr_nidx(ifp_nth(xs, 1), 1000000) >= 0 then rxq_lidx2(rsr_hd(xs), ifp_nth(xs, 1), k) else {e: Call(nm, xs), k: k}
fn rxq_lidx2(o, i, k) = match o
    LetIn(y, v, b) => let r = rxq_lidx2(b, i, k) in {e: LetIn(y, v, r.e), k: r.k}
    Call(f, ys)    => if f == "_tylist_" and rsr_nidx(i, len(ys)) >= 0 then rxq_lidx3(rxq_litems(ys, 0), str(rsr_nidx(i, len(ys))), k) else {e: Call("lidx", Cons(o, Cons(i, Nil))), k: k}
    _              => {e: Call("lidx", Cons(o, Cons(i, Nil))), k: k}
fn rxq_lidx3(items, key, k) = let fm = rxq_fmap(items, k) in {e: rxq_fwrap(fm.m, items, Var(rxq_lookup(key, fm.m))), k: fm.k}
## `let r = if c then A else B in body` (A and B literals of which body reads only fields or elements both have, body
## small) -> `if c then (let r = A in body) else (let r = B in body)`: each branch keeps its own locals; c, the
## literal's values and body still run once each, in that order
fn rxq_brok(nm, a, body) = match a
    Rec(items)     => rxq_fields_only(nm, items, body)
    Call(f, xs)    => if f == "_tylist_" and len(xs) >= 1 then rxq_idx_only(nm, len(xs), body) else 0
    LetIn(y, v, b) => if rxq_is_fresh(y) then rxq_brok(nm, b, body) else 0
    If(c, a2, b2)  => if rxq_brok(nm, a2, body) == 1 then rxq_brok(nm, b2, body) else 0
    _              => 0
fn rxq_letif(nm, c, a, b, body, k) = let ra = rxq_let(nm, a, body, k) in let rb = rxq_let(nm, b, body, ra.k) in {e: If(c, ra.e, rb.e), k: rb.k}
## (let y = v in b).f -> let y = v in b.f; ({..., f: x, ...}).f -> the fields' locals, then x
fn rxq_field(o, f, k) = match o
    LetIn(y, v, b) => let r = rxq_field(b, f, k) in {e: LetIn(y, v, r.e), k: r.k}
    Rec(items)     => if rxq_has_key(items, f) == 1 then (let fm = rxq_fmap(items, k) in {e: rxq_fwrap(fm.m, items, Var(rxq_lookup(f, fm.m))), k: fm.k}) else {e: Field(o, f), k: k}
    _              => {e: Field(o, f), k: k}

## the whole program (kernels untouched)
## LUME_FL=off turns the pass off; LUME_FL_LIMIT=N keeps only the first N candidates (for bisecting a miscompile)
fn rxq_prog(prog, cts) = if os_getenv("LUME_FL") == "off" or ldbg_on() then prog else rxq_prog2(prog, rxq_take(rxq_table(prog, cts), rxq_limit()), cts)
fn rxq_limit() = let v = os_getenv("LUME_FL_LIMIT") in if v == "" then 1000000 else toint(v)
fn rxq_take(xs, n) = if n <= 0 then Nil else match xs
    Nil        => Nil
    Cons(h, t) => Cons(h, rxq_take(t, n - 1))
fn rxq_prog2(prog, tbl, cts) = match tbl
    Nil        => prog
    Cons(h, t) => rxq_stmts(prog, tbl, cts)
fn rxq_stmts(prog, tbl, cts) = match prog
    Nil        => Nil
    Cons(h, t) => Cons(rxq_stmt(h, tbl, cts), rxq_stmts(t, tbl, cts))
fn rxq_stmt(s0, tbl, cts) = match s0
    Fn(nm, ps, body) => if rxq_secret(nm, cts) then s0 else Fn(nm, ps, rxq_body(body, tbl, rxq_binders(body, ps), 0 - 1))
    Print(v)         => Print(rxq_body(v, tbl, rxq_binders(v, Nil), 0 - 1))
    ExprS(v)         => ExprS(rxq_body(v, tbl, rxq_binders(v, Nil), 0 - 1))
    _                => s0
fn rxq_body(e, tbl, binders, unused) = let a = rxq_in(e, {tbl: tbl, binders: binders, depth: 0}, 1000000) in let s1 = rxq_simp(a.e, a.k) in (rxq_simp(s1.e, s1.k)).e
## --- record and tuple parameters split into scalars (2026-11-21) ----------------------------------------------------
## A parameter that only has its fields read (r.k) or its constant elements read (t[0]: a list used as a tuple) does
## not need its value built. After record flattening (rxq_ above) a function f gets a clone __rsr_f whose parameters
## are, for such a parameter p, one per field of a SHAPE (the keys of a record literal in their order, or the length
## of a list literal; at most 8):
##   * every call of f by itself passes, as that argument, p unchanged or a literal of the shape (an `if` of literals
##     and the lets in front of a literal are moved out of the argument first, so each call passes a literal); for a
##     function that builds none, the shape is that of the first literal another function passes there;
##   * p is read only as p.k (k a key of the shape) or p[i] (0 <= i < length); any other use (returned, passed on,
##     compared) rebuilds the literal from the fields there: at most once in the body of a function that calls
##     itself, never in one that does not, so the clone allocates no more than f did.
## In the clone p.k is a parameter, a call of f by itself is the clone's own call with the literal's values as its
## arguments (arguments are evaluated left to right, so effects keep their order), and p passed unchanged passes its
## fields. A call of f anywhere else whose split arguments are literals of their shapes calls the clone the same way.
## A function that calls itself keeps its body behind a guard: when every split argument has exactly its shape (the
## same record descriptor, or a list of exactly that length) it calls the clone with the fields, else it runs its old
## body; so a loop entered with a record built elsewhere still runs without allocating from its first iteration on.
## Values, errors and effects are unchanged: the guard only lets through values whose fields all exist, reading a
## field has no effect, and a rebuilt record has the original's descriptor. Only bodies made of Num / Str / Var / Bin /
## If / LetIn / Call / Field / Rec are touched, never @secret functions or kernels, nor a function whose Sig names a
## decimal parameter (its code depends on that type). The clone's name starts with `__`, so a stack trace skips its
## frame and still names f. LUME_RSR=off (or LUME_FL=off) turns the pass off.
fn rsr_known(e) = match e
    Num(n)          => 1
    Str(s)          => 1
    Var(x)          => 1
    Bin(op, l, r)   => if rsr_known(l) == 1 then rsr_known(r) else 0
    If(c, t, e2)    => if rsr_known(c) == 1 and rsr_known(t) == 1 then rsr_known(e2) else 0
    LetIn(nm, v, b) => if rsr_known(v) == 1 then rsr_known(b) else 0
    Call(nm, args)  => if nm == "__perceus_reuse_1" or nm == "__perceus_reuse_2" then 0 else rsr_known_args(args)
    Field(o, k)     => rsr_known(o)
    Rec(items)      => rsr_known_items(items)
    RecT(tn, items) => rsr_known_items(items)
    Match(sc, arms) => if rsr_known(sc) == 1 then rsr_known_arms(arms) else 0
    _               => 0
fn rsr_known_arms(xs) = match xs
    Nil        => 1
    Cons(h, t) => if rsr_known(h.body) == 1 then rsr_known_arms(t) else 0
## the names a pattern binds
fn rsr_pbs(p, acc) = match p
    PBind(nm)        => Cons(nm, acc)
    PCons(tag, subs) => rsr_pbs_l(subs, acc)
    _                => acc
fn rsr_pbs_l(ps, acc) = match ps
    Nil        => acc
    Cons(h, t) => rsr_pbs(h, rsr_pbs_l(t, acc))
## every name e binds (lets and patterns), its size, and whether it calls nm
fn rsr_binders(e, acc) = match e
    Bin(op, l, r)   => rsr_binders(l, rsr_binders(r, acc))
    If(c, t, e2)    => rsr_binders(c, rsr_binders(t, rsr_binders(e2, acc)))
    LetIn(nm, v, b) => Cons(nm, rsr_binders(v, rsr_binders(b, acc)))
    Call(nm, args)  => rsr_binders_args(args, acc)
    Field(o, k)     => rsr_binders(o, acc)
    Rec(items)      => rsr_binders_args(lvalsof(items), acc)
    RecT(tn, items) => rsr_binders_args(lvalsof(items), acc)
    Match(sc, arms) => rsr_binders(sc, rsr_binders_arms(arms, acc))
    _               => acc
fn rsr_binders_args(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => rsr_binders(h, rsr_binders_args(t, acc))
fn rsr_binders_arms(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => rsr_pbs(h.pat, rsr_binders(h.body, rsr_binders_arms(t, acc)))
fn rsr_size(e) = match e
    Bin(op, l, r)   => 1 + rsr_size(l) + rsr_size(r)
    If(c, t, e2)    => 1 + rsr_size(c) + rsr_size(t) + rsr_size(e2)
    LetIn(nm, v, b) => 1 + rsr_size(v) + rsr_size(b)
    Call(nm, args)  => 1 + rsr_size_args(args)
    Field(o, k)     => 1 + rsr_size(o)
    Rec(items)      => 1 + rsr_size_args(lvalsof(items))
    RecT(tn, items) => 1 + rsr_size_args(lvalsof(items))
    Match(sc, arms) => 1 + rsr_size(sc) + rsr_size_arms(arms)
    _               => 1
fn rsr_size_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => rsr_size(h) + rsr_size_args(t)
fn rsr_size_arms(xs) = match xs
    Nil        => 0
    Cons(h, t) => rsr_size(h.body) + rsr_size_arms(t)
fn rsr_hascall(e, nm) = match e
    Bin(op, l, r)   => if rsr_hascall(l, nm) == 1 then 1 else rsr_hascall(r, nm)
    If(c, t, e2)    => if rsr_hascall(c, nm) == 1 or rsr_hascall(t, nm) == 1 then 1 else rsr_hascall(e2, nm)
    LetIn(x, v, b)  => if rsr_hascall(v, nm) == 1 then 1 else rsr_hascall(b, nm)
    Call(f, args)   => if f == nm then 1 else rsr_hascall_args(args, nm)
    Field(o, k)     => rsr_hascall(o, nm)
    Rec(items)      => rsr_hascall_args(lvalsof(items), nm)
    RecT(tn, items) => rsr_hascall_args(lvalsof(items), nm)
    Match(sc, arms) => if rsr_hascall(sc, nm) == 1 then 1 else rsr_hascall_arms(arms, nm)
    _               => 0
fn rsr_hascall_args(xs, nm) = match xs
    Nil        => 0
    Cons(h, t) => if rsr_hascall(h, nm) == 1 then 1 else rsr_hascall_args(t, nm)
fn rsr_hascall_arms(xs, nm) = match xs
    Nil        => 0
    Cons(h, t) => if rsr_hascall(h.body, nm) == 1 then 1 else rsr_hascall_arms(t, nm)
fn rsr_known_args(xs) = match xs
    Nil        => 1
    Cons(h, t) => if rsr_known(h) == 1 then rsr_known_args(t) else 0
fn rsr_known_items(xs) = match xs
    Nil        => 1
    Cons(h, t) => if rsr_known(h.val) == 1 then rsr_known_items(t) else 0
fn rsr_atom(e) = match e
    Num(n) => 1
    Str(s) => 1
    Var(x) => 1
    _      => 0
fn rsr_atoms(xs) = match xs
    Nil        => 1
    Cons(h, t) => if rsr_atom(h) == 1 then rsr_atoms(t) else 0
fn rsr_hd(xs) = match xs
    Nil        => Num(0)
    Cons(h, t) => h
fn rsr_nidx(e, n) = match e
    Num(k) => if k >= 0 and k < n then k else 0 - 1
    _      => 0 - 1
fn rsr_mentions(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if omentions_var(x, h) == 1 then 1 else rsr_mentions(x, t)
fn rsr_isrq(xs) = match xs
    Nil        => 0
    Cons(h, t) => if count(h) >= 3 and slice(h, 0, 3) == "_rq" then 1 else rsr_isrq(t)
fn rsr_wrap(lets, body) = match lets
    Nil        => body
    Cons(h, t) => LetIn(h.nm, h.v, rsr_wrap(t, body))
## the compiler's own temporaries: lets of the inliner (_flN) and the base of a `{r with ...}` (rw__LINE_COL)
fn rsr_tmpname(y) = if rxq_is_fresh(y) then 1 else if count(y) > 4 and slice(y, 0, 4) == "rw__" then 1 else 0
fn rsr_cargs(e) = match e
    Call(f, args) => args
    _             => Nil
fn rsr_recitems(e) = match e
    Rec(items) => items
    _          => Nil
## {p with k: v, ...} is `__lume_rec_update(p, {k: v, ...})`; with p split, the keys it names must be keys of p's shape
## in the shape's order (as the fields of a literal its values then still run in the order written)
fn rsr_isupd(e, p) = match e
    Call(f, args) => if f == "__lume_rec_update" and len(args) == 2 and rxq_isvar(rsr_hd(args), p) == 1 then 1 else 0
    _             => 0
fn rsr_updord(items, ks) = match items
    Nil        => 1
    Cons(h, t) => rsr_updord2(h.key, t, ks)
fn rsr_updord2(k, t, ks) = match ks
    Nil          => 0
    Cons(kh, kt) => if kh == k then rsr_updord(t, kt) else rsr_updord2(k, t, kt)
fn rsr_use_upd(p, sh, u, k) = match u
    Rec(items) => if sh.kind == 0 and isnil(items) == 0 and rsr_updord(items, sh.keys) == 1 then rsr_use_items(p, sh, items, k) else 0 - 1
    _          => 0 - 1
## the fields of p after the update: per key of the shape, the update's value or the field's parameter
fn rsr_ival(items, k) = match items
    Nil        => {ok: 0, v: Num(0)}
    Cons(h, t) => if h.key == k then {ok: 1, v: h.val} else rsr_ival(t, k)
fn rsr_mval(r, f, cx) = if r.ok == 1 then rsr_s(r.v, cx) else Var(f)
fn rsr_mvals(ks, fv, items, cx) = match ks
    Nil        => Nil
    Cons(h, t) => Cons(rsr_mval(rsr_ival(items, h), ifp_hd(fv), cx), rsr_mvals(t, ifp_tl(fv), items, cx))
fn rsr_zip(ks, vs) = match ks
    Nil        => Nil
    Cons(h, t) => Cons({key: h, val: rsr_hd(vs)}, rsr_zip(t, ifp_tl(vs)))
fn rsr_mitems(sp, items, cx) = rsr_zip(sp.sh.keys, rsr_mvals(sp.sh.keys, sp.fv, items, cx))
fn rsr_pushr(vs, acc) = match vs
    Nil        => acc
    Cons(h, t) => rsr_pushr(t, Cons(h, acc))
fn rsr_flupd(sp, items, st, cx) = {ok: 1, acc: rsr_pushr(rsr_mvals(sp.sh.keys, sp.fv, items, cx), st.acc), lets: st.lets}
fn rsr_isupdsp(args, cx) = if (rsr_spp(cx.sps, rsr_avar(rsr_hd(args)))).i >= 0 then 1 else 0
fn rsr_supd(args, cx) = Rec(rsr_mitems(rsr_spp(cx.sps, rsr_avar(rsr_hd(args))), rsr_recitems(ifp_nth(args, 1)), cx))

## shapes: {ok, kind (0 record, 1 list), keys, n, sig (equal sigs: the same shape), vals, pre (the lets in front)}
fn rsr_none() = {ok: 0, kind: 0, keys: Nil, n: 0, sig: "", vals: Nil, pre: Nil}
fn rsr_keys(items) = match items
    Nil        => Nil
    Cons(h, t) => Cons(h.key, rsr_keys(t))
fn rsr_ksig(ks) = match ks
    Nil        => ""
    Cons(h, t) => h + "," + rsr_ksig(t)
fn rsr_uniq(ks) = match ks
    Nil        => 1
    Cons(h, t) => if omem(h, t) == 1 then 0 else rsr_uniq(t)
fn rsr_mk(kind, keys, vals) = {ok: 1, kind: kind, keys: keys, n: len(vals), sig: (if kind == 0 then "r:" + rsr_ksig(keys) else "l:" + str(len(vals))), vals: vals, pre: Nil}
fn rsr_recp(items) = let ks = rsr_keys(items) in if len(ks) < 1 or len(ks) > 8 or rsr_uniq(ks) == 0 then rsr_none() else if ldec_expr(Rec(items), Nil) then rsr_none() else rsr_mk(0, ks, lvalsof(items))
fn rsr_prod(e) = match e
    Rec(items)      => rsr_recp(items)
    RecT(tn, items) => rsr_recp(items)
    Call(nm, args)  => if nm == "_tylist_" and len(args) >= 1 and len(args) <= 8 then rsr_mk(1, Nil, args) else rsr_none()
    LetIn(y, v, b)  => rsr_prod_let(y, v, rsr_prod(b))
    _               => rsr_none()
fn rsr_prod_let(y, v, r) = if r.ok == 0 then r else {ok: 1, kind: r.kind, keys: r.keys, n: r.n, sig: r.sig, vals: r.vals, pre: Cons({nm: y, v: v}, r.pre)}
fn rsr_isprod(e) = (rsr_prod(e)).ok

## normalization of a candidate body: lets of the inliner that only rename a variable or a number are substituted
## (`let _fl3 = s in {x: _fl3.x + 1}` reads s.x), then calls of f by itself pass literals (rsr_dist)
fn rsr_cp(e) = match e
    LetIn(y, v, b)  => rsr_cp_let(y, rsr_cp(v), rsr_cp(b))
    Bin(op, l, r)   => Bin(op, rsr_cp(l), rsr_cp(r))
    If(c, t, e2)    => If(rsr_cp(c), rsr_cp(t), rsr_cp(e2))
    Call(nm, args)  => Call(nm, rsr_cp_args(args))
    Field(o, k)     => Field(rsr_cp(o), k)
    Rec(items)      => Rec(rsr_cp_items(items))
    RecT(tn, items) => RecT(tn, rsr_cp_items(items))
    Match(sc, arms) => Match(rsr_cp(sc), rsr_cp_arms(arms))
    _               => e
fn rsr_cp_arms(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: rsr_cp(h.body)}, rsr_cp_arms(t))
fn rsr_cp_args(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(rsr_cp(h), rsr_cp_args(t))
fn rsr_cp_items(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: rsr_cp(h.val)}, rsr_cp_items(t))
fn rsr_cpable(v) = match v
    Num(n) => lfits63(n)
    Var(x) => 1
    _      => 0
fn rsr_avar(a) = match a
    Var(x) => x
    _      => ""
fn rsr_cp_let(y, v, b) = if rsr_tmpname(y) == 1 and rsr_cpable(v) == 1 and rsr_svok(y, rsr_avar(v), b) == 1 then rsr_sv(y, v, b) else LetIn(y, v, b)
## can y be replaced in e by an atom whose variable is x: no let named x around a use of y, no call of y
fn rsr_svok(y, x, e) = match e
    Bin(op, l, r)   => if rsr_svok(y, x, l) == 1 then rsr_svok(y, x, r) else 0
    If(c, t, e2)    => if rsr_svok(y, x, c) == 1 and rsr_svok(y, x, t) == 1 then rsr_svok(y, x, e2) else 0
    LetIn(nm, v, b) => if rsr_svok(y, x, v) == 0 then 0 else if nm == y then 1 else if nm == x and omentions_var(y, b) == 1 then 0 else rsr_svok(y, x, b)
    Call(nm, args)  => if nm == y then 0 else rsr_svok_args(y, x, args)
    Field(o, k)     => rsr_svok(y, x, o)
    Rec(items)      => rsr_svok_items(y, x, items)
    RecT(tn, items) => rsr_svok_items(y, x, items)
    Match(sc, arms) => if rsr_svok(y, x, sc) == 1 then rsr_svok_arms(y, x, arms) else 0
    Num(n)          => 1
    Str(s)          => 1
    Var(z)          => 1
    _               => if omentions_var(y, e) == 1 then 0 else 1
fn rsr_svok_arms(y, x, xs) = match xs
    Nil        => 1
    Cons(h, t) => if opat_binds(y, h.pat) == 1 then rsr_svok_arms(y, x, t) else if opat_binds(x, h.pat) == 1 and omentions_var(y, h.body) == 1 then 0 else if rsr_svok(y, x, h.body) == 1 then rsr_svok_arms(y, x, t) else 0
fn rsr_svok_args(y, x, xs) = match xs
    Nil        => 1
    Cons(h, t) => if rsr_svok(y, x, h) == 1 then rsr_svok_args(y, x, t) else 0
fn rsr_svok_items(y, x, xs) = match xs
    Nil        => 1
    Cons(h, t) => if rsr_svok(y, x, h.val) == 1 then rsr_svok_items(y, x, t) else 0
fn rsr_sv(y, a, e) = match e
    Var(z)          => if z == y then a else e
    Bin(op, l, r)   => Bin(op, rsr_sv(y, a, l), rsr_sv(y, a, r))
    If(c, t, e2)    => If(rsr_sv(y, a, c), rsr_sv(y, a, t), rsr_sv(y, a, e2))
    LetIn(nm, v, b) => LetIn(nm, rsr_sv(y, a, v), if nm == y then b else rsr_sv(y, a, b))
    Call(nm, args)  => Call(nm, rsr_sv_args(y, a, args))
    Field(o, k)     => Field(rsr_sv(y, a, o), k)
    Rec(items)      => Rec(rsr_sv_items(y, a, items))
    RecT(tn, items) => RecT(tn, rsr_sv_items(y, a, items))
    Match(sc, arms) => Match(rsr_sv(y, a, sc), rsr_sv_arms(y, a, arms))
    _               => e
fn rsr_sv_arms(y, a, xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: (if opat_binds(y, h.pat) == 1 then h.body else rsr_sv(y, a, h.body))}, rsr_sv_arms(y, a, t))
fn rsr_sv_args(y, a, xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(rsr_sv(y, a, h), rsr_sv_args(y, a, t))
fn rsr_sv_items(y, a, xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: rsr_sv(y, a, h.val)}, rsr_sv_items(y, a, t))
## at a tail position, a call of f by itself whose argument is an `if` of literals (or has a let in front of one)
## becomes an `if` of calls; only when the arguments before are atoms (no effect moves) and those after are small
## (they are copied into both calls, still evaluated after the literal)
fn rsr_prodish(e) = match e
    If(c, t, e2)   => if rsr_prodish(t) == 1 then rsr_prodish(e2) else 0
    LetIn(y, v, b) => rsr_prodish(b)
    _              => rsr_isprod(e)
fn rsr_small(xs) = match xs
    Nil        => 1
    Cons(h, t) => if rsr_size(h) <= 12 then rsr_small(t) else 0
fn rsr_dist(e, k) = match e
    If(c, t, e2)   => If(c, rsr_dist(t, k), rsr_dist(e2, k))
    LetIn(y, v, b) => LetIn(y, v, rsr_dist(b, k))
    Call(f, args)  => if f == k.nm and len(args) == k.n then rsr_dcall(args, Nil, k) else e
    Match(sc, arms) => Match(sc, rsr_dist_arms(arms, k))
    _              => e
fn rsr_dist_arms(xs, k) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: rsr_dist(h.body, k)}, rsr_dist_arms(t, k))
fn rsr_dcall(args, pre, k) = match args
    Nil        => Call(k.nm, rev(pre))
    Cons(h, t) => if rsr_isprod(h) == 0 and rsr_prodish(h) == 1 and rsr_atoms(pre) == 1 and rsr_small(t) == 1 then rsr_d1(h, pre, t, k) else rsr_dcall(t, Cons(h, pre), k)
fn rsr_d1(h, pre, t, k) = match h
    If(c, a, b)    => If(c, rsr_dist(Call(k.nm, app(rev(pre), Cons(a, t))), k), rsr_dist(Call(k.nm, app(rev(pre), Cons(b, t))), k))
    LetIn(y, v, b) => if y != k.nm and rsr_mentions(y, pre) == 0 and rsr_mentions(y, t) == 0 then LetIn(y, v, rsr_dist(Call(k.nm, app(rev(pre), Cons(b, t))), k)) else Call(k.nm, app(rev(pre), Cons(h, t)))
    _              => Call(k.nm, app(rev(pre), Cons(h, t)))
fn rsr_norm(body, nm, n) = rsr_dist(rsr_cp(body), {nm: nm, n: n})

## the shape the calls of f by itself pass as argument i (p itself aside): {st: 0 none, 1 one shape (pr), 2 other}
fn rsr_ss(e, k, p, i, acc) = match e
    Bin(op, l, r)   => rsr_ss(l, k, p, i, rsr_ss(r, k, p, i, acc))
    If(c, t, e2)    => rsr_ss(c, k, p, i, rsr_ss(t, k, p, i, rsr_ss(e2, k, p, i, acc)))
    LetIn(nm, v, b) => rsr_ss(v, k, p, i, rsr_ss(b, k, p, i, acc))
    Call(f, args)   => rsr_ss_args(args, k, p, i, (if f == k.nm and len(args) == k.n then rsr_ss_arg(ifp_nth(args, i), p, acc) else acc))
    Field(o, f)     => rsr_ss(o, k, p, i, acc)
    Rec(items)      => rsr_ss_items(items, k, p, i, acc)
    RecT(tn, items) => rsr_ss_items(items, k, p, i, acc)
    Match(sc, arms) => rsr_ss(sc, k, p, i, rsr_ss_arms(arms, k, p, i, acc))
    _               => acc
fn rsr_ss_arms(xs, k, p, i, acc) = match xs
    Nil        => acc
    Cons(h, t) => rsr_ss_arms(t, k, p, i, rsr_ss(h.body, k, p, i, acc))
fn rsr_ss_args(xs, k, p, i, acc) = match xs
    Nil        => acc
    Cons(h, t) => rsr_ss_args(t, k, p, i, rsr_ss(h, k, p, i, acc))
fn rsr_ss_items(xs, k, p, i, acc) = match xs
    Nil        => acc
    Cons(h, t) => rsr_ss_items(t, k, p, i, rsr_ss(h.val, k, p, i, acc))
fn rsr_ss_arg(a, p, acc) = if rxq_isvar(a, p) == 1 or rsr_isupd(a, p) == 1 then acc else rsr_ss_add(rsr_prod(a), acc)
fn rsr_ss_add(pr, acc) = if acc.st == 2 then acc else if pr.ok == 0 then {st: 2, pr: pr} else if acc.st == 0 then {st: 1, pr: pr} else if acc.pr.sig == pr.sig then acc else {st: 2, pr: pr}
## how p (shape sh) is used in e: -1 when a use cannot be scalar, else the number of uses that need the whole value
## (rebuilt there); p as argument i of a call of f by itself is free (it passes its fields)
fn rsr_add(a, b) = if a < 0 or b < 0 then 0 - 1 else a + b
fn rsr_use(p, sh, e, k) = match e
    Var(y)          => if y == p then 1 else 0
    Field(o, f)     => if rxq_isvar(o, p) == 1 then (if sh.kind == 0 and omem(f, sh.keys) == 1 then 0 else 0 - 1) else rsr_use(p, sh, o, k)
    Bin(op, l, r)   => rsr_add(rsr_use(p, sh, l, k), rsr_use(p, sh, r, k))
    If(c, t, e2)    => rsr_add(rsr_use(p, sh, c, k), rsr_add(rsr_use(p, sh, t, k), rsr_use(p, sh, e2, k)))
    LetIn(nm, v, b) => if nm == p then 0 - 1 else rsr_add(rsr_use(p, sh, v, k), rsr_use(p, sh, b, k))
    Call(f, args)   => rsr_use_call(p, sh, f, args, k)
    Rec(items)      => rsr_use_items(p, sh, items, k)
    RecT(tn, items) => rsr_use_items(p, sh, items, k)
    Match(sc, arms) => rsr_add(rsr_use(p, sh, sc, k), rsr_use_arms(p, sh, arms, k))
    Num(n)          => 0
    Str(s)          => 0
    _               => 0 - 1
fn rsr_use_arms(p, sh, xs, k) = match xs
    Nil        => 0
    Cons(h, t) => if opat_binds(p, h.pat) == 1 then 0 - 1 else rsr_add(rsr_use(p, sh, h.body, k), rsr_use_arms(p, sh, t, k))
fn rsr_use_call(p, sh, f, args, k) = if f == p then 0 - 1 else if f == "__lume_rec_update" and len(args) == 2 and rxq_isvar(rsr_hd(args), p) == 1 then rsr_use_upd(p, sh, ifp_nth(args, 1), k) else if f == "lidx" and len(args) == 2 and rxq_isvar(rsr_hd(args), p) == 1 then (if sh.kind == 1 and rsr_nidx(ifp_nth(args, 1), sh.n) >= 0 then 0 else 0 - 1) else if f == k.nm and len(args) == k.n then rsr_use_self(p, sh, args, 0, k) else rsr_use_args(p, sh, args, k)
fn rsr_use_self(p, sh, xs, j, k) = match xs
    Nil        => 0
    Cons(h, t) => rsr_add((if j == k.i and rxq_isvar(h, p) == 1 then 0 else rsr_use(p, sh, h, k)), rsr_use_self(p, sh, t, j + 1, k))
fn rsr_use_args(p, sh, xs, k) = match xs
    Nil        => 0
    Cons(h, t) => rsr_add(rsr_use(p, sh, h, k), rsr_use_args(p, sh, t, k))
fn rsr_use_items(p, sh, xs, k) = match xs
    Nil        => 0
    Cons(h, t) => rsr_add(rsr_use(p, sh, h.val, k), rsr_use_items(p, sh, t, k))

## the split parameters of a candidate f = {nm, n, body, ext, rec}: {i, p, sh, fv (the clone's parameters)}
fn rsr_nosp() = {i: 0 - 1, p: "", sh: rsr_none(), fv: Nil}
fn rsr_extpr(ext, f, i) = match ext
    Nil        => rsr_none()
    Cons(h, t) => if h.f == f and h.i == i then h.pr else rsr_extpr(t, f, i)
fn rsr_fvs(i, t, n) = if t >= n then Nil else Cons("_rq" + str(i) + "_" + str(t), rsr_fvs(i, t + 1, n))
fn rsr_splits(ps, i, f, acc) = match ps
    Nil        => rev(acc)
    Cons(p, t) => rsr_splits(t, i + 1, f, rsr_split1(p, i, f, acc))
fn rsr_split1(p, i, f, acc) = let ss = rsr_ss(f.body, {nm: f.nm, n: f.n}, p, i, {st: 0, pr: rsr_none()}) in if ss.st == 2 then acc else rsr_split2(p, i, f, (if ss.st == 1 then ss.pr else rsr_extpr(f.ext, f.nm, i)), acc)
fn rsr_split2(p, i, f, sh, acc) = if sh.ok == 0 then acc else rsr_split3(p, i, sh, rsr_use(p, sh, f.body, {nm: f.nm, n: f.n, i: i}), f.rec, acc)
fn rsr_split3(p, i, sh, u, maxu, acc) = if u < 0 or u > maxu then acc else Cons({i: i, p: p, sh: sh, fv: rsr_fvs(i, 0, sh.n)}, acc)
fn rsr_spat(sps, j) = match sps
    Nil        => rsr_nosp()
    Cons(h, t) => if h.i == j then h else rsr_spat(t, j)
fn rsr_spp(sps, y) = match sps
    Nil        => rsr_nosp()
    Cons(h, t) => if h.p == y then h else rsr_spp(t, y)
## the clone's parameters, and how many
fn rsr_cps(ps, j, sps) = match ps
    Nil        => Nil
    Cons(p, t) => let sp = rsr_spat(sps, j) in if sp.i < 0 then Cons(p, rsr_cps(t, j + 1, sps)) else app(sp.fv, rsr_cps(t, j + 1, sps))

## a call of f as a call of the clone: cx = {cl, inc (1 inside the clone: p passed unchanged passes its fields, p.k
## reads its parameter), sps, nm, n}. The split arguments are literals of their shapes; the lets in front of a literal
## move before the call when the arguments before it are atoms or the lets bind atoms, and no other argument names
## them. {ok, e}
fn rsr_flat(args, cx) = rsr_fl(args, 0, {ok: 1, acc: Nil, lets: Nil}, cx)
fn rsr_fl(xs, j, st, cx) = match xs
    Nil        => if st.ok == 1 then {ok: 1, e: rsr_wrap(rev(st.lets), Call(cx.cl, rev(st.acc)))} else {ok: 0, e: Num(0)}
    Cons(h, t) => if st.ok == 0 then rsr_fl(Nil, j, st, cx) else rsr_fl(t, j + 1, rsr_fl1(h, rsr_spat(cx.sps, j), t, st, cx), cx)
fn rsr_flbad() = {ok: 0, acc: Nil, lets: Nil}
fn rsr_fl1(h, sp, t, st, cx) = if sp.i < 0 then {ok: 1, acc: Cons(rsr_s(h, cx), st.acc), lets: st.lets} else if cx.inc == 1 and rxq_isvar(h, sp.p) == 1 then {ok: 1, acc: rsr_pushv(sp.fv, st.acc), lets: st.lets} else if cx.inc == 1 and rsr_isupd(h, sp.p) == 1 then rsr_flupd(sp, rsr_recitems(ifp_nth(rsr_cargs(h), 1)), st, cx) else rsr_fl2(rsr_prod(h), sp, t, st, cx)
fn rsr_fl2(pr, sp, t, st, cx) = if pr.ok == 0 or pr.sig != sp.sh.sig then rsr_flbad() else if isnil(pr.pre) == 1 then {ok: 1, acc: rsr_pushs(pr.vals, st.acc, cx), lets: st.lets} else if (rsr_atoms(st.acc) == 1 or rsr_preatoms(pr.pre) == 1) and rsr_precap(pr.pre, st.acc, t) == 0 and rsr_prebind(pr.pre, cx) == 0 then {ok: 1, acc: rsr_pushs(pr.vals, st.acc, cx), lets: rsr_pushl(pr.pre, st.lets, cx)} else rsr_flbad()
fn rsr_preatoms(pre) = match pre
    Nil        => 1
    Cons(h, t) => if rsr_atom(h.v) == 1 then rsr_preatoms(t) else 0
fn rsr_precap(pre, acc, t) = match pre
    Nil        => 0
    Cons(h, r) => if rsr_mentions(h.nm, acc) == 1 or rsr_mentions(h.nm, t) == 1 then 1 else rsr_precap(r, acc, t)
## a moved let must not take the name of the function called
fn rsr_prebind(pre, cx) = match pre
    Nil        => 0
    Cons(h, r) => if h.nm == cx.cl or h.nm == cx.nm then 1 else rsr_prebind(r, cx)
fn rsr_pushv(fv, acc) = match fv
    Nil        => acc
    Cons(h, t) => rsr_pushv(t, Cons(Var(h), acc))
fn rsr_pushs(vals, acc, cx) = match vals
    Nil        => acc
    Cons(h, t) => rsr_pushs(t, Cons(rsr_s(h, cx), acc), cx)
fn rsr_pushl(pre, lets, cx) = match pre
    Nil        => lets
    Cons(h, t) => rsr_pushl(t, Cons({nm: h.nm, v: rsr_s(h.v, cx)}, lets), cx)
## inside the clone: p.k and p[i] -> the field's parameter, p -> the literal rebuilt, calls of f by itself -> the clone
fn rsr_s(e, cx) = if cx.inc == 0 then e else rsr_s2(e, cx)
fn rsr_s2(e, cx) = match e
    Var(y)          => rsr_svar(rsr_spp(cx.sps, y), e)
    Field(o, f)     => rsr_sfield(o, f, cx)
    Bin(op, l, r)   => Bin(op, rsr_s2(l, cx), rsr_s2(r, cx))
    If(c, t, e2)    => If(rsr_s2(c, cx), rsr_s2(t, cx), rsr_s2(e2, cx))
    LetIn(nm, v, b) => LetIn(nm, rsr_s2(v, cx), rsr_s2(b, cx))
    Call(f, args)   => rsr_scall(f, args, cx)
    Rec(items)      => Rec(rsr_s_items(items, cx))
    RecT(tn, items) => RecT(tn, rsr_s_items(items, cx))
    Match(sc, arms) => Match(rsr_s2(sc, cx), rsr_s_arms(arms, cx))
    _               => e
fn rsr_s_arms(xs, cx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: rsr_s2(h.body, cx)}, rsr_s_arms(t, cx))
fn rsr_s_args(xs, cx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(rsr_s2(h, cx), rsr_s_args(t, cx))
fn rsr_s_items(xs, cx) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: rsr_s2(h.val, cx)}, rsr_s_items(t, cx))
fn rsr_svar(sp, e) = if sp.i < 0 then e else rsr_rebuild(sp)
fn rsr_vars(fv) = match fv
    Nil        => Nil
    Cons(h, t) => Cons(Var(h), rsr_vars(t))
fn rsr_ritems(ks, fv) = match ks
    Nil        => Nil
    Cons(h, t) => Cons({key: h, val: Var(ifp_hd(fv))}, rsr_ritems(t, ifp_tl(fv)))
fn rsr_rebuild(sp) = if sp.sh.kind == 0 then Rec(rsr_ritems(sp.sh.keys, sp.fv)) else Call("_tylist_", rsr_vars(sp.fv))
fn rsr_kfv(ks, fv, f) = match ks
    Nil        => ""
    Cons(h, t) => if h == f then ifp_hd(fv) else rsr_kfv(t, ifp_tl(fv), f)
fn rsr_nthname(fv, k) = if k <= 0 then ifp_hd(fv) else rsr_nthname(ifp_tl(fv), k - 1)
fn rsr_sfield(o, f, cx) = match o
    Var(y) => rsr_sfield2(rsr_spp(cx.sps, y), o, f)
    _      => Field(rsr_s2(o, cx), f)
fn rsr_sfield2(sp, o, f) = if sp.i < 0 then Field(o, f) else Var(rsr_kfv(sp.sh.keys, sp.fv, f))
fn rsr_scall(f, args, cx) = if f == "__lume_rec_update" and len(args) == 2 and rsr_isupdsp(args, cx) == 1 then rsr_supd(args, cx) else if f == "lidx" and len(args) == 2 then rsr_slidx(rsr_hd(args), args, cx) else if f == cx.nm and len(args) == cx.n then rsr_sself(rsr_flat(args, cx), args, cx) else Call(f, rsr_s_args(args, cx))
fn rsr_slidx(a0, args, cx) = match a0
    Var(y) => rsr_slidx2(rsr_spp(cx.sps, y), args, cx)
    _      => Call("lidx", rsr_s_args(args, cx))
fn rsr_slidx2(sp, args, cx) = if sp.i < 0 then Call("lidx", rsr_s_args(args, cx)) else Var(rsr_nthname(sp.fv, rsr_nidx(ifp_nth(args, 1), sp.sh.n)))
fn rsr_sself(r, args, cx) = if r.ok == 1 then r.e else Call(cx.nm, rsr_s_args(args, cx))
## every call of f by itself can call the clone
fn rsr_selfok(e, cx) = match e
    Bin(op, l, r)   => if rsr_selfok(l, cx) == 1 then rsr_selfok(r, cx) else 0
    If(c, t, e2)    => if rsr_selfok(c, cx) == 1 and rsr_selfok(t, cx) == 1 then rsr_selfok(e2, cx) else 0
    LetIn(nm, v, b) => if rsr_selfok(v, cx) == 1 then rsr_selfok(b, cx) else 0
    Call(f, args)   => if rsr_selfok_args(args, cx) == 0 then 0 else if f == cx.nm and len(args) == cx.n then (rsr_flat(args, cx)).ok else 1
    Field(o, f)     => rsr_selfok(o, cx)
    Rec(items)      => rsr_selfok_items(items, cx)
    RecT(tn, items) => rsr_selfok_items(items, cx)
    Match(sc, arms) => if rsr_selfok(sc, cx) == 1 then rsr_selfok_arms(arms, cx) else 0
    _               => 1
fn rsr_selfok_arms(xs, cx) = match xs
    Nil        => 1
    Cons(h, t) => if rsr_selfok(h.body, cx) == 1 then rsr_selfok_arms(t, cx) else 0
fn rsr_selfok_args(xs, cx) = match xs
    Nil        => 1
    Cons(h, t) => if rsr_selfok(h, cx) == 1 then rsr_selfok_args(t, cx) else 0
fn rsr_selfok_items(xs, cx) = match xs
    Nil        => 1
    Cons(h, t) => if rsr_selfok(h.val, cx) == 1 then rsr_selfok_items(t, cx) else 0

## the guard of a function that calls itself, and the clone's arguments taken from f's parameters
fn rsr_zitems(ks) = match ks
    Nil        => Nil
    Cons(h, t) => Cons({key: h, val: Num(0)}, rsr_zitems(t))
fn rsr_guard1(sp) = if sp.sh.kind == 0 then Call("_rshape_", Cons(Var(sp.p), Cons(Rec(rsr_zitems(sp.sh.keys)), Nil))) else Call("_rlshape_", Cons(Var(sp.p), Cons(Num(sp.sh.n), Nil)))
fn rsr_guard(sps) = match sps
    Nil        => Var("true")
    Cons(h, t) => if isnil(t) == 1 then rsr_guard1(h) else Bin("and", rsr_guard1(h), rsr_guard(t))
fn rsr_gfields(p, ks) = match ks
    Nil        => Nil
    Cons(h, t) => Cons(Field(Var(p), h), rsr_gfields(p, t))
fn rsr_gelems(p, t, n) = if t >= n then Nil else Cons(Call("lidx", Cons(Var(p), Cons(Num(t), Nil))), rsr_gelems(p, t + 1, n))
fn rsr_gargs(ps, j, sps) = match ps
    Nil        => Nil
    Cons(p, t) => let sp = rsr_spat(sps, j) in if sp.i < 0 then Cons(Var(p), rsr_gargs(t, j + 1, sps)) else app((if sp.sh.kind == 0 then rsr_gfields(p, sp.sh.keys) else rsr_gelems(p, 0, sp.sh.n)), rsr_gargs(t, j + 1, sps))
fn rsr_gbody(c, body) = if c.rec == 1 then If(rsr_guard(c.sps), Call(c.cl, rsr_gargs(c.ps, 0, c.sps)), body) else body

## calls elsewhere: a call of a function with a clone whose split arguments are literals of their shapes calls the
## clone (not a call of the function being compiled by itself, nor of a name it binds itself)
fn rsr_rd(e, tbl, k) = match e
    Bin(op, l, r)   => Bin(op, rsr_rd(l, tbl, k), rsr_rd(r, tbl, k))
    If(c, t, e2)    => If(rsr_rd(c, tbl, k), rsr_rd(t, tbl, k), rsr_rd(e2, tbl, k))
    LetIn(nm, v, b) => LetIn(nm, rsr_rd(v, tbl, k), rsr_rd(b, tbl, k))
    Call(f, args)   => rsr_rdcall(f, rsr_rd_args(args, tbl, k), tbl, k)
    Field(o, f)     => Field(rsr_rd(o, tbl, k), f)
    Rec(items)      => Rec(rsr_rd_items(items, tbl, k))
    RecT(tn, items) => RecT(tn, rsr_rd_items(items, tbl, k))
    Match(sc, arms) => Match(rsr_rd(sc, tbl, k), rsr_rd_arms(arms, tbl, k))
    _               => e
fn rsr_rd_arms(xs, tbl, k) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({pat: h.pat, body: rsr_rd(h.body, tbl, k)}, rsr_rd_arms(t, tbl, k))
fn rsr_rd_args(xs, tbl, k) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(rsr_rd(h, tbl, k), rsr_rd_args(t, tbl, k))
fn rsr_rd_items(xs, tbl, k) = match xs
    Nil        => Nil
    Cons(h, t) => Cons({key: h.key, val: rsr_rd(h.val, tbl, k)}, rsr_rd_items(t, tbl, k))
fn rsr_tfind(tbl, f) = match tbl
    Nil        => Nil
    Cons(h, t) => if h.nm == f then Cons(h, Nil) else rsr_tfind(t, f)
fn rsr_rdcall(f, args, tbl, k) = if f == k.self or omem(f, k.bound) == 1 or omem("__rsr_" + f, k.bound) == 1 then Call(f, args) else rsr_rdcall2(f, args, rsr_tfind(tbl, f))
fn rsr_rdcall2(f, args, found) = match found
    Nil        => Call(f, args)
    Cons(c, t) => if len(args) != c.n then Call(f, args) else rsr_rdcall3(rsr_flat(args, {cl: c.cl, inc: 0, sps: c.sps, nm: f, n: c.n}), f, args)
fn rsr_rdcall3(r, f, args) = if r.ok == 1 then r.e else Call(f, args)

## the candidates: {nm, ps, n, body (normalized), rec}
fn rsr_fnames(prog) = match prog
    Nil        => Nil
    Cons(h, t) => rsr_fnames1(h, rsr_fnames(t))
fn rsr_fnames1(s0, rest) = match s0
    Fn(nm, ps, body) => Cons(nm, rest)
    _                => rest
fn rsr_decsig(prev) = match prev
    Sig(nm, ps, tys, rt) => if isnil(ldecimal_params(ps, tys)) == 1 then 0 else 1
    _                    => 0
fn rsr_cands(prog, prev, cts, names) = match prog
    Nil        => Nil
    Cons(h, t) => rsr_cand1(h, prev, cts, names, rsr_cands(t, h, cts, names))
fn rsr_cand1(s0, prev, cts, names, rest) = match s0
    Fn(nm, ps, body) => if rxq_secret(nm, cts) or rsr_decsig(prev) == 1 or len(ps) < 1 or len(ps) > 8 or omem("__rsr_" + nm, names) == 1 or rsr_known(body) == 0 or rsr_size(body) > 400 then rest else rsr_cand2(nm, ps, body, rsr_binders(body, ps), rest)
    _                => rest
fn rsr_cand2(nm, ps, body, bs, rest) = if rsr_isrq(bs) == 1 or omem(nm, bs) == 1 then rest else rsr_cand3(nm, ps, rsr_norm(body, nm, len(ps)), rest)
fn rsr_cand3(nm, ps, nb, rest) = if rsr_size(nb) > 800 then rest else Cons({nm: nm, ps: ps, n: len(ps), body: nb, rec: rsr_hascall(nb, nm)}, rest)
fn rsr_cnames(cs) = match cs
    Nil        => Nil
    Cons(h, t) => Cons(h.nm, rsr_cnames(t))
## the first literal each argument position of a candidate is given anywhere: {f, i, pr}
fn rsr_ext(prog, cn, cts, acc) = match prog
    Nil        => acc
    Cons(h, t) => rsr_ext(t, cn, cts, rsr_ext_s(h, cn, cts, acc))
fn rsr_ext_s(s0, cn, cts, acc) = match s0
    Fn(nm, ps, body) => if rxq_secret(nm, cts) then acc else rsr_ext_e(body, cn, acc)
    Print(v)         => rsr_ext_e(v, cn, acc)
    ExprS(v)         => rsr_ext_e(v, cn, acc)
    _                => acc
fn rsr_ext_e(e, cn, acc) = match e
    Bin(op, l, r)   => rsr_ext_e(r, cn, rsr_ext_e(l, cn, acc))
    If(c, t, e2)    => rsr_ext_e(e2, cn, rsr_ext_e(t, cn, rsr_ext_e(c, cn, acc)))
    LetIn(nm, v, b) => rsr_ext_e(b, cn, rsr_ext_e(v, cn, acc))
    Call(f, args)   => rsr_ext_args(args, cn, (if omem(f, cn) == 1 then rsr_ext_call(f, args, 0, acc) else acc))
    Field(o, f)     => rsr_ext_e(o, cn, acc)
    Rec(items)      => rsr_ext_items(items, cn, acc)
    RecT(tn, items) => rsr_ext_items(items, cn, acc)
    Match(sc, arms) => rsr_ext_arms(arms, cn, rsr_ext_e(sc, cn, acc))
    _               => acc
fn rsr_ext_arms(xs, cn, acc) = match xs
    Nil        => acc
    Cons(h, t) => rsr_ext_arms(t, cn, rsr_ext_e(h.body, cn, acc))
fn rsr_ext_args(xs, cn, acc) = match xs
    Nil        => acc
    Cons(h, t) => rsr_ext_args(t, cn, rsr_ext_e(h, cn, acc))
fn rsr_ext_items(xs, cn, acc) = match xs
    Nil        => acc
    Cons(h, t) => rsr_ext_items(t, cn, rsr_ext_e(h.val, cn, acc))
fn rsr_ext_call(f, xs, j, acc) = match xs
    Nil        => acc
    Cons(h, t) => rsr_ext_call(f, t, j + 1, rsr_ext_add(f, j, rsr_prod(h), acc))
fn rsr_ext_add(f, j, pr, acc) = if pr.ok == 0 then acc else if (rsr_extpr(acc, f, j)).ok == 1 then acc else Cons({f: f, i: j, pr: pr}, acc)
## the clones: {nm, cl, n, sps, ps, rec, cbody, cps}
fn rsr_nflat(sps, acc) = match sps
    Nil        => acc
    Cons(h, t) => rsr_nflat(t, acc + h.sh.n - 1)
fn rsr_clones(cs, ext) = match cs
    Nil        => Nil
    Cons(c, t) => rsr_clone1(c, rsr_splits(c.ps, 0, {nm: c.nm, n: c.n, body: c.body, ext: ext, rec: c.rec}, Nil), rsr_clones(t, ext))
fn rsr_clone1(c, sps, rest) = if isnil(sps) == 1 or rsr_nflat(sps, c.n) > 10 then rest else rsr_clone2(c, sps, {cl: "__rsr_" + c.nm, inc: 1, sps: sps, nm: c.nm, n: c.n}, rest)
fn rsr_clone2(c, sps, cx, rest) = if rsr_selfok(c.body, cx) == 0 then rest else Cons({nm: c.nm, cl: cx.cl, n: c.n, sps: sps, ps: c.ps, rec: c.rec, cbody: rsr_s(c.body, cx), cps: rsr_cps(c.ps, 0, sps)}, rest)
## the program rewritten: each function with a clone is followed by it
fn rsr_prog(prog, cts) = if os_getenv("LUME_RSR") == "off" or os_getenv("LUME_FL") == "off" or ldbg_on() then prog else rsr_prog2(prog, cts, rsr_cands(prog, ExprS(Num(0)), cts, rsr_fnames(prog)))
fn rsr_prog2(prog, cts, cs) = if isnil(cs) == 1 then prog else rsr_prog3(prog, cts, rsr_clones(cs, rsr_ext(prog, rsr_cnames(cs), cts, Nil)))
fn rsr_prog3(prog, cts, cl) = if isnil(cl) == 1 then prog else rsr_stmts(prog, cl, cts)
fn rsr_stmts(prog, cl, cts) = match prog
    Nil        => Nil
    Cons(h, t) => app(rsr_stmt(h, cl, cts), rsr_stmts(t, cl, cts))
fn rsr_stmt(s0, cl, cts) = match s0
    Fn(nm, ps, body) => if rxq_secret(nm, cts) then Cons(s0, Nil) else rsr_stmtfn(nm, ps, body, rsr_tfind(cl, nm), cl)
    Print(v)         => Cons(Print(rsr_rd(v, cl, {self: "", bound: rsr_binders(v, Nil)})), Nil)
    ExprS(v)         => Cons(ExprS(rsr_rd(v, cl, {self: "", bound: rsr_binders(v, Nil)})), Nil)
    _                => Cons(s0, Nil)
fn rsr_stmtfn(nm, ps, body, found, cl) = match found
    Nil        => Cons(Fn(nm, ps, rsr_rd(body, cl, {self: nm, bound: rsr_binders(body, ps)})), Nil)
    Cons(c, t) => Cons(Fn(nm, ps, rsr_rd(rsr_gbody(c, body), cl, {self: nm, bound: rsr_binders(body, ps)})), Cons(Fn(c.cl, c.cps, rsr_rd(c.cbody, cl, {self: nm, bound: rsr_binders(c.cbody, c.cps)})), Nil))
## the program the generator works on: FFI calls rewritten, then record flattening (never in kernels)
fn lgen_prog(prog0, ffi_osigs, is_krn, isr_fn) = let prog1 = (if isnil(ffi_osigs) == 1 then prog0 else lffi_rw_prog(prog0, ffi_osigs)) in if is_krn == 1 or isr_fn != "" then prog1 else rsr_prog(rxq_prog(prog1, lct_names(prog0)), lct_names(prog0))
fn lgen_analysis(prog0, pfx) = let ffi_osigs = lcollect_ffi_osigs(prog0, prog0) in let ffi_links = lcollect_ffi_links(prog0) in let is_krn = lhas_free_osig(prog0) in let isr_fn = lfind_isr_fn(prog0) in let prog = lgen_prog(prog0, ffi_osigs, is_krn, isr_fn) in let has_sys = if is_krn == 1 or isr_fn != "" or luses_sys_prog(prog) == 1 then 1 else 0 in let zk7 = if is_krn == 1 or isr_fn != "" then 0 else lkonly_chk(prog) in let has_tier = luses_tier_prog(prog) in let has_mem = if is_krn == 1 then 0 else luses_mem_prog(prog) in let uses_fs = luses_fs_prog(prog) in let has_f64 = if is_krn == 1 then 0 else luses_f64_prog(prog) in let has_dec = if is_krn == 1 then 0 else lhas_fn(prog, "__lume_dyn_add") in let has_crypto = if is_krn == 1 then 0 else if ldbg_on() then 1 else luses_crypto_prog(prog) in let mlocals = app(lmlocals(prog), lsds(0, lmdprog(prog))) in let s0 = {nl: 0, ns: 0, dt: Nil, pfx: pfx, cts: lct_names(prog0)} in let gs = lstmts(prog, mlocals, if has_mem == 1 then lhs_seed(s0) else s0) in let funcs_l = gs.funcs in let mains_l = gs.mains in {prog: prog, ffi_osigs: ffi_osigs, ffi_links: ffi_links, is_krn: is_krn, isr_fn: isr_fn, has_sys: has_sys, has_tier: has_tier, has_mem: has_mem, uses_fs: uses_fs, has_f64: has_f64, has_dec: has_dec, has_crypto: has_crypto, mframe: lframe(len(mlocals)), dt_s: ldt_text(gs.dt), relink: 0, funcs_raw: joinall(own funcs_l), mains_s: joinall(own mains_l)}
## --- peephole: the stack shuffles of the expression code, rewritten into register moves --------------------------------
## The expression code keeps a left operand on the stack while it evaluates the right one. Where nothing between the push
## and the pop touches the stack (no call, no %rsp operand), the value can stay in a register instead:
##   pushq %rax ; popq %rcx                              ->  movq %rax, %rcx
##   pushq %rax ; popq %rax                              ->  (nothing)
##   pushq %rax ; movq S, %rax ; popq %rcx               ->  movq %rax, %rcx ; movq S, %rax      (S reads no %rcx, %rsp)
##   pushq %rax ; movq S, %rax ; movq %rax, %rcx ; popq %rax  ->  movq S, %rcx                    (S reads no %rsp)
## Each rewrite keeps every register and memory word the following code can read, and the stack depth at every later
## instruction, so the program computes the same values; the code shrinks and loses two memory operations per pair.
fn lp_nl(s, i, n) = if i >= n then n else if at(s, i) == "\n" then i else lp_nl(s, i + 1, n)
fn lp_lines(s, i, n, acc) = if i >= n then rev(acc) else let e = lp_nl(s, i, n) in lp_lines(s, e + 1, n, Cons(slice(s, i, e), acc))
fn lp_has(s, w) = lp_has_at(s, w, 0, count(s), count(w))
fn lp_has_at(s, w, i, n, m) = if i + m > n then 0 else if slice(s, i, i + m) == w then 1 else lp_has_at(s, w, i + 1, n, m)
fn lp_starts(s, p) = count(s) >= count(p) and slice(s, 0, count(p)) == p
fn lp_ends(s, p) = count(s) >= count(p) and slice(s, count(s) - count(p), count(s)) == p
## `movq S, %rax` with S a register other than %rax, a literal, or a %rbp/%rip memory word: the source text S, else ""
fn lp_load_rax(l) = if lp_starts(l, "    movq ") == 1 and lp_ends(l, ", %rax") == 1 then (let src = slice(l, 9, count(l) - 6) in if src == "%rax" or lp_has(src, "%rsp") == 1 then "" else src) else ""
## `popq R` with R an argument register: R, else "" (`pushq %rax` right before it is `movq %rax, R`)
fn lp_argreg(l) = if l == "    popq %rdi" then "%rdi" else if l == "    popq %rsi" then "%rsi" else if l == "    popq %rdx" then "%rdx" else if l == "    popq %r8" then "%r8" else if l == "    popq %r9" then "%r9" else if l == "    popq %r10" then "%r10" else ""
fn lp_go(ls, acc) = match ls
    Nil        => rev(acc)
    Cons(a, t) => if a == "    pushq %rax" then lp_push(t, acc) else lp_go(t, Cons(a, acc))
fn lp_push(t, acc) = match t
    Nil        => rev(Cons("    pushq %rax", acc))
    Cons(b, t2) => if b == "    popq %rcx" then lp_go(Cons("    movq %rax, %rcx", t2), acc) else if b == "    popq %rax" then lp_go(t2, acc) else if lp_argreg(b) != "" then lp_go(Cons("    movq %rax, " + lp_argreg(b), t2), acc) else let src = lp_load_rax(b) in if src == "" then lp_go(t, Cons("    pushq %rax", acc)) else lp_push2(src, b, t2, acc)
fn lp_push2(src, b, t2, acc) = match t2
    Nil        => rev(Cons(b, Cons("    pushq %rax", acc)))
    Cons(c, t3) => if c == "    popq %rcx" and lp_has(src, "%rcx") == 0 then lp_go(Cons("    movq %rax, %rcx", Cons(b, t3)), acc) else if c == "    movq %rax, %rcx" then lp_push3(src, b, c, t3, acc) else if c == "    pushq %rax" then lp_go(Cons(b, t2), Cons("    pushq %rax", acc)) else lp_go(Cons(b, t2), Cons("    pushq %rax", acc))
fn lp_push3(src, b, c, t3, acc) = match t3
    Nil        => rev(Cons(c, Cons(b, Cons("    pushq %rax", acc))))
    Cons(d, t4) => if d == "    popq %rax" then lp_go(Cons("    movq " + src + ", %rcx", t4), acc) else lp_go(Cons(b, Cons(c, t3)), Cons("    pushq %rax", acc))
fn lp_addnl(ls, acc) = match ls
    Nil        => rev(acc)
    Cons(h, t) => lp_addnl(t, Cons(h + "\n", acc))
fn lp_join(ls) = joinall(own lp_addnl(ls, Nil))
fn lpeep(text) = if text == "" then text else lp_join(lp_go(lp_go(lp_lines(text, 0, count(text), Nil), Nil), Nil))

fn lgen_emit(a) = lgen_emit_src(a, "")
fn lgen_emit_src(a, src) = let funcs_s = (if a.is_krn == 1 then "    .kernel\n" else "") + a.ffi_links + lst_wrap(lpf_funcs(lpeep(a.funcs_raw), a), a) + lffi_stubs(a.ffi_osigs) in let mprol = "    movq %rsp, %rbp\n" + (if a.mframe > 0 then "    subq $" + str(a.mframe) + ", %rsp\n" else "") + lst_init(a) + ldbg_init(a) in let bss = runtime_bss_head() + ldbg_bss(a) + (if a.has_mem == 1 or a.is_krn == 0 then "    .lcomm .Lrt_ar_table, 96\n" else "") + (if a.has_sys == 1 then "    .lcomm .Lrt_irq32_cnt, 8\n    .lcomm .Lrt_pf14_cnt, 8\n    .lcomm .Lrt_pf14_addr, 8\n    .lcomm .Lrt_ctx_sp_a, 8\n    .lcomm .Lrt_ctx_sp_b, 8\n    .lcomm .Lrt_ctx_sw_cnt, 8\n    .lcomm .Lrt_hw_scratch, 8192\n    .lcomm .Lrt_wstat, 8\n    .lcomm .Lrt_tmo, 8\n    .lcomm .Lrt_pipefd, 8\n    .lcomm .Lrt_pipeint, 8\n    .lcomm .Lrt_static_arena, 65536\n" else "") + (if a.is_krn == 1 then "" else runtime_bss_gc()) in let rodata = lst_table(a, src) + ldbg_table(a, src) + runtime_rodata_head() + (if a.has_crypto == 1 then rt_crypto_rodata() else "") + (if a.is_krn == 1 then "" else runtime_rodata_gc()) + (if a.has_mem == 1 then ".Lrt_ar_msg_secret:\n    .asciz \"lume: arena error: a secret arena is never compressed (decompression timing leaks it, [C0009])\\n\"\n.Lrt_ar_msg_many:\n    .asciz \"lume: arena error: too many live arenas (the runtime supports 4)\\n\"\n.Lrt_ar_msg_dead:\n    .asciz \"lume: arena error: no live arena at this handle (arena_new first)\\n\"\n.Lrt_ar_msg_handle:\n    .asciz \"lume: arena error: invalid arena handle\\n\"\n.Lrt_ar_msg_budget:\n    .asciz \"lume: arena error: arena capacity exceeded (arena_new cap_hint is a hard budget)\\n\"\n.Lrt_ar_msg_size:\n    .asciz \"lume: arena error: arena_alloc size must be positive\\n\"\n" else "") + (if a.has_tier == 1 then ".Lrt_uaf_msg:\n    .asciz \"lume: ownership error [O0001]: use of dropped rc/arc reference\\n\"\n" else "") + (if a.has_sys == 1 then ".Lrt_idt_ptr:\n    .byte 255, 15, 0, 80, 0, 0, 0, 0, 0, 0\n.Lrt_ap_tramp:\n    .byte 250, 49, 192, 142, 216, 142, 192, 142, 208, 188, 0, 112, 15, 32, 224, 12, 32, 15, 34, 224, 102, 184, 0, 16, 0, 0, 15, 34, 216, 102, 185, 128, 0, 0, 192, 15, 50, 128, 204, 1, 15, 48, 15, 1, 22, 216, 124, 15, 32, 192, 102, 13, 1, 0, 0, 128, 15, 34, 192, 234, 64, 112, 8, 0, 102, 184, 16, 0, 142, 216, 142, 192, 142, 208, 72, 199, 196, 0, 240, 7, 0, 72, 199, 193, 0, 88, 0, 0, 72, 199, 192, 1, 0, 0, 0, 72, 135, 1, 72, 133, 192, 117, 241, 72, 139, 65, 8, 72, 1, 192, 72, 131, 192, 12, 72, 137, 65, 16, 72, 199, 1, 0, 0, 0, 0, 72, 199, 192, 1, 0, 0, 0, 240, 72, 15, 193, 65, 24, 15, 174, 240, 250, 244, 235, 252\n" else "") in let heapinit = if a.is_krn == 1 then "    movq $1017, %rdx\n    xorq %rax, %rax\n    outb %al, %dx\n    movq $1019, %rdx\n    movq $128, %rax\n    outb %al, %dx\n    movq $1016, %rdx\n    movq $3, %rax\n    outb %al, %dx\n    movq $1017, %rdx\n    xorq %rax, %rax\n    outb %al, %dx\n    movq $1019, %rdx\n    movq $3, %rax\n    outb %al, %dx\n    movq $2097152, %rax\n    movq %rax, .Lrt_heap_cur(%rip)\n    movq $4128768, %rax\n    movq %rax, .Lrt_heap_end(%rip)\n" else runtime_hosted_init() in let base_rt0 = if a.is_krn == 1 then runtime_krn_tail() else if a.uses_fs == 1 then runtime_tail() + runtime_argv_tail() + runtime_fs_tail() else runtime_tail() + runtime_argv_tail() in let base_rtf = if a.is_krn == 1 then base_rt0 + rt_f64_stub() else base_rt0 + (if a.has_f64 == 1 then rt_f64() else rt_f64_stub()) + (if a.has_dec == 1 then rt_dec_dyn() else rt_dec_dyn_stub()) + (if a.has_crypto == 1 then rt_crypto() else ldbg_stub()) in let base_rt = if a.has_tier == 1 then base_rtf + runtime_tier_tail() else base_rtf in let base_rtm = if a.has_mem == 1 then base_rt + runtime_mem_tail() else base_rt in let rtail = if a.has_sys == 1 then base_rtm + runtime_sys_tail(a.isr_fn, a.is_krn) else base_rtm in let exittail = if a.is_krn == 1 then "    movq $244, %rdx\n    xorq %rax, %rax\n    outb %al, %dx\n    cli\n    hlt\n" else "    movq $60, %rax\n    xorq %rdi, %rdi\n    syscall\n" in joinall(own Cons(bss, Cons(rodata, Cons(if a.relink == 1 then ldt_relink(a.dt_s) else a.dt_s, Cons("    .section .text\n", Cons(funcs_s, Cons("    ## __lume_rt_boundary\n" + rtail, Cons("    .globl _start\n_start:\n", Cons(heapinit, Cons(mprol, Cons(lpf_mains(lpeep(a.mains_s), a), Cons(exittail, Nil))))))))))))
## --- profiler: `lume run --profile` compiles with LUME_PROFILE naming the output file. The generated code then keeps,
## per user function, the calls, the time in its own code (self), the time below an outer call (total), the allocations,
## and the GC time, and writes them to that file at exit (the driver prints the table). Time is rdtsc, attributed at each
## function entry and after each return to a caller (a self tail loop is one call); every sequence saves the registers
## it uses and sits where no flags are live. Data block __prof_data: header 112 bytes (0 t0, 8 ts0, 24 t1, 32 ts1,
## 48 gc ticks, 56 last stamp, 64 current id, 72 slots, 80 done, 88 gc start, 96 gc count), then six arrays of slots
## words: self, total, calls, allocs, outer start, depth. Slot 0 is the top-level code. Not for kernels.
fn lpf_on() = if os_getenv("LUME_PROFILE") == "" then 0 else 1
fn lpf_tsc() = "    rdtsc\n    shlq $32, %rdx\n    orq %rdx, %rax\n"
fn lpf_save() = "    pushq %rax\n    pushq %rdx\n    pushq %rcx\n    pushq %rsi\n    leaq __prof_data(%rip), %rsi\n"
fn lpf_rest() = "    popq %rsi\n    popq %rcx\n    popq %rdx\n    popq %rax\n"
fn lpf_off(arr, slots, id) = 112 + arr * slots * 8 + id * 8
## charge the time since the last stamp (rax = now) to the running function, then `id` runs
fn lpf_switch(id) = "    movq 64(%rsi), %rcx\n    movq %rax, %rdx\n    subq 56(%rsi), %rdx\n    movq %rax, 56(%rsi)\n    addq %rdx, 112(%rsi,%rcx,8)\n    movq $" + str(id) + ", %rcx\n    movq %rcx, 64(%rsi)\n"
fn lpf_bump(off, by) = "    movq " + str(off) + "(%rsi), %rcx\n    addq $" + by + ", %rcx\n    movq %rcx, " + str(off) + "(%rsi)\n"
fn lpf_entry(id, slots) = lpf_save() + lpf_tsc() + lpf_switch(id) + lpf_bump(lpf_off(2, slots, id), "1") + lpf_rest()
fn lpf_pre(m, slots, lab) = lpf_save() + lpf_bump(lpf_off(5, slots, m), "1") + "    cmpq $1, %rcx\n    jne " + lab + "\n" + lpf_tsc() + "    movq %rax, " + str(lpf_off(4, slots, m)) + "(%rsi)\n" + lab + ":\n" + lpf_rest()
fn lpf_post(k, m, slots, lab) = lpf_save() + lpf_tsc() + lpf_switch(k) + lpf_bump(lpf_off(5, slots, m), "-1") + "    testq %rcx, %rcx\n    jne " + lab + "\n    subq " + str(lpf_off(4, slots, m)) + "(%rsi), %rax\n    addq %rax, " + str(lpf_off(1, slots, m)) + "(%rsi)\n" + lab + ":\n" + lpf_rest()

## the user functions: labels of the function text followed by the ordinary prologue; ids from 1
fn lpf_lab(h) = if count(h) >= 2 and at(h, count(h) - 1) == ":" and at(h, 0) != " " and at(h, 0) != "." then slice(h, 0, count(h) - 1) else ""
fn lpf_names(ls, acc) = match ls
    Nil        => rev(acc)
    Cons(h, t) => lpf_names2(lpf_lab(h), t, acc)
fn lpf_names2(nm, t, acc) = if nm != "" and lpf_is_prol(t) == 1 and lst_sw(nm, "__rsr_") == false then lpf_names(t, Cons(nm, acc)) else lpf_names(t, acc)
fn lpf_is_prol(t) = match t
    Nil        => 0
    Cons(a, r) => if a == "    pushq %rbp" then lpf_is_prol2(r) else 0
fn lpf_is_prol2(r) = match r
    Nil        => 0
    Cons(b, z) => if b == "    movq %rsp, %rbp" then 1 else 0
## the clone of a split function (__rsr_NAME, rsr_) is counted as the function itself
fn lpf_id(nms, nm, i) = lpf_id2(nms, lst_dname(nm), i)
fn lpf_id2(nms, nm, i) = match nms
    Nil        => 0
    Cons(h, t) => if h == nm then i else lpf_id2(t, nm, i + 1)
fn lpf_slots(nms) = len(nms) + 1

## rewrite a text: an entry after the prologue of each user function, pre/post around each call of one.
## st: {cur: running id, pend: id waiting for its prologue, k: label counter, pfx}
fn lpf_rw(ls, nms, st, acc) = match ls
    Nil        => joinall(own rev(acc))
    Cons(h, t) => lpf_rw1(h, t, nms, st, acc)
fn lpf_rw1(h, t, nms, st, acc) = let nm = lpf_lab(h) in let id = if nm == "" then 0 else lpf_id(nms, nm, 1) in if id > 0 then lpf_rw(t, nms, {cur: id, pend: id, k: st.k, pfx: st.pfx}, Cons(h + "\n", acc)) else if h == "    movq %rsp, %rbp" and st.pend > 0 then lpf_rw(t, nms, {cur: st.cur, pend: 0, k: st.k, pfx: st.pfx}, Cons(h + "\n" + lpf_entry(st.pend, lpf_slots(nms)), acc)) else lpf_rw3(h, t, nms, st, acc)
fn lpf_rw3(h, t, nms, st, acc) = let m = if count(h) > 9 and slice(h, 0, 9) == "    call " then lpf_id(nms, slice(h, 9, count(h)), 1) else 0 in if m > 0 then lpf_rw2(h, t, nms, st, acc, m) else lpf_rw(t, nms, st, Cons(h + "\n", acc))
fn lpf_rw2(h, t, nms, st, acc, m) = let slots = lpf_slots(nms) in let lab = ".Lpf_" + st.pfx + str(st.k) in lpf_rw(t, nms, {cur: st.cur, pend: st.pend, k: st.k + 1, pfx: st.pfx}, Cons(lpf_pre(m, slots, lab + "a") + h + "\n" + lpf_post(st.cur, m, slots, lab + "b"), acc))
fn lpf_text(text, nms, pfx) = if text == "" then text else lpf_rw(lp_lines(text, 0, count(text), Nil), nms, {cur: 0, pend: 0, k: 0, pfx: pfx}, Nil)

## whole program: count allocations, time the collector, write the file before every exit
fn lpf_exit_near(t, n) = if n == 0 then 0 else lpf_exit_near2(t, n)
fn lpf_exit_near2(t, n) = match t
    Nil        => 0
    Cons(a, r) => if a == "    syscall" then 1 else lpf_exit_near(r, n - 1)
fn lpf_glob(ls, slots, acc) = match ls
    Nil        => joinall(own rev(acc))
    Cons(h, t) => lpf_glob(t, slots, Cons(lpf_glob1(h, t, slots), acc))
fn lpf_glob1(h, t, slots) = if h == "alloc:" or h == "__lume_alloc_a:" then h + "\n    pushq %rdx\n" + lpf_save() + "    movq 64(%rsi), %rcx\n    leaq " + str(lpf_off(3, slots, 0)) + "(%rsi,%rcx,8), %rdx\n    movq (%rdx), %rcx\n    addq $1, %rcx\n    movq %rcx, (%rdx)\n" + lpf_rest() + "    popq %rdx\n" else if h == "__gc_collect:" then lpf_gcwrap() + "__gc_collect_body:\n" else if (h == "    movq $60, %rax" or h == "    movq $231, %rax") and lpf_exit_near(t, 3) == 1 then "    call __prof_report\n" + h + "\n" else h + "\n"
fn lpf_gcwrap() = "__gc_collect:\n" + lpf_save() + lpf_tsc() + "    movq %rax, 88(%rsi)\n" + lpf_rest() + "    subq $8, %rsp\n    pushq %rax\n    xorq %rax, %rax\n    movq %rax, 8(%rsp)\n    popq %rax\n    call __gc_collect_body\n    addq $8, %rsp\n" + lpf_save() + lpf_tsc() + "    subq 88(%rsi), %rax\n    addq %rax, 48(%rsi)\n" + lpf_rest() + "    ret\n"
fn lpf_init(slots) = "    leaq __prof_data(%rip), %rsi\n" + lpf_tsc() + "    movq %rax, (%rsi)\n    movq %rax, 56(%rsi)\n    movq $" + str(slots) + ", %rcx\n    movq %rcx, 72(%rsi)\n    addq $8, %rsi\n    movq $1, %rdi\n    movq $228, %rax\n    syscall\n"
fn lpf_join(nms) = match nms
    Nil        => ""
    Cons(h, t) => h + "\n" + lpf_join(t)
fn lpf_rep_head() = "__prof_report:\n    pushq %rax\n    pushq %rcx\n    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    pushq %r8\n    pushq %r9\n    pushq %r10\n    pushq %r11\n    leaq __prof_data(%rip), %rsi\n    movq 80(%rsi), %rcx\n    testq %rcx, %rcx\n    jne .Lpf_rep_out\n    movq $1, %rcx\n    movq %rcx, 80(%rsi)\n" + lpf_tsc() + "    movq %rax, 24(%rsi)\n    movq 64(%rsi), %rcx\n    movq %rax, %rdx\n    subq 56(%rsi), %rdx\n    movq %rax, 56(%rsi)\n    addq %rdx, 112(%rsi,%rcx,8)\n    movq __gc_count(%rip), %rcx\n    movq %rcx, 96(%rsi)\n    addq $32, %rsi\n    movq $1, %rdi\n    movq $228, %rax\n    syscall\n"
fn lpf_rep_tail() = ".Lpf_rep_out:\n    popq %r11\n    popq %r10\n    popq %r9\n    popq %r8\n    popq %rdi\n    popq %rsi\n    popq %rdx\n    popq %rcx\n    popq %rax\n    ret\n"
fn lpf_report(path, nms) = let slots = lpf_slots(nms) in let names = "(top level)\n" + lpf_join(nms) in let size = 112 + 6 * slots * 8 in lpf_rep_head() + "    leaq __prof_path(%rip), %rdi\n    movq $577, %rsi\n    movq $420, %rdx\n    movq $2, %rax\n    syscall\n    testq %rax, %rax\n    js .Lpf_rep_out\n    pushq %rax\n    pushq %rax\n    movq %rax, %rdi\n    leaq __prof_data(%rip), %rsi\n    movq $" + str(size) + ", %rdx\n    movq $1, %rax\n    syscall\n    movq (%rsp), %rdi\n    leaq __prof_names(%rip), %rsi\n    movq $" + str(count(names)) + ", %rdx\n    movq $1, %rax\n    syscall\n    movq (%rsp), %rdi\n    movq $3, %rax\n    syscall\n    popq %rax\n    popq %rax\n" + lpf_rep_tail() + "    .section .rodata\n__prof_path:\n    .asciz \"" + lsesc(path) + "\"\n__prof_names:\n    .asciz \"" + lsesc(names) + "\"\n    .section .text\n"
fn lpf_fnames(a) = let ft = lpeep(a.funcs_raw) in lpf_names(lp_lines(ft, 0, count(ft), Nil), Nil)
fn lpf_final(text, a) = if lpf_on() == 0 or a.is_krn == 1 then text else let nms = lpf_fnames(a) in let slots = lpf_slots(nms) in "    .section .bss\n    .lcomm __prof_data, " + str(112 + 6 * slots * 8) + "\n" + lpf_glob(lp_lines(text, 0, count(text), Nil), slots, Nil) + "    .section .text\n" + lpf_report(os_getenv("LUME_PROFILE"), nms)
fn lpf_funcs(text, a) = if lpf_on() == 0 or a.is_krn == 1 then text else lpf_text(text, lpf_names(lp_lines(text, 0, count(text), Nil), Nil), "f")
fn lpf_mains(text, a) = if lpf_on() == 0 or a.is_krn == 1 then text else let nms = lpf_fnames(a) in lpf_init(lpf_slots(nms)) + lpf_text(text, nms, "m")
## --- stack traces: the table rt_trace (compiler/stage1/rt/rt_trace.src) reads when a program stops on an error -------
## __lume_fntab: n, the end of the user code, then per function of the program {label, name, file, line} in address
## order (the labels of a.funcs_raw in text). The file and line come from the bundle: its `## --- module NAME ---` /
## `## --- entry NAME ---` markers and the bundle map the driver names in LUME_SRC_MAP (NAME TAB path lines). Only
## with LUME_SRC_MAP set (lume run / build / test): plain `lumec < file` stays byte-identical to the seed's oracle.
fn lst_sw(s, p) = count(s) >= count(p) and slice(s, 0, count(p)) == p
fn lst_ew(s, p) = count(s) >= count(p) and slice(s, count(s) - count(p), count(s)) == p
## the clone of a function made by rsr_ (__rsr_NAME) is listed under the function's own name, file and line
fn lst_dname(h) = if lst_sw(h, "__rsr_") then slice(h, 6, count(h)) else h
fn lst_idc(c) = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9")
fn lst_on(a) = a.is_krn == 0 and os_getenv("LUME_SRC_MAP") != ""
fn lst_wrap(t, a) = if lst_on(a) == false then t else "__lume_uf_begin:\n" + t + "    .section .text\n__lume_uf_end:\n"
fn lst_init(a) = if lst_on(a) == false then "" else "    leaq __lume_fntab(%rip), %r11\n    movq %r11, __rt_fntab(%rip)\n"
fn lst_labels(ls, intext, acc) = match ls
    Nil        => rev(acc)
    Cons(h, t) => if lst_sw(h, "    .section") then lst_labels(t, (if lst_has(h, ".text") then 1 else 0), acc) else if lst_sw(h, "    .text") then lst_labels(t, 1, acc) else lst_label1(h, t, intext, acc)
fn lst_label1(h, t, intext, acc) = let lab = lpf_lab(h) in if intext == 1 and lab != "" then lst_labels(t, intext, Cons(lab, acc)) else lst_labels(t, intext, acc)
fn lst_has(s, w) = lst_has_go(s, w, 0)
fn lst_has_go(s, w, i) = if i + count(w) > count(s) then false else if slice(s, i, i + count(w)) == w then true else lst_has_go(s, w, i + 1)
## the bundle map: {k: module name or @entry, v: path}
fn lst_map(text) = if text == "" then Nil else lst_map_ls(lp_lines(text, 0, count(text), Nil), Nil)
fn lst_map_ls(ls, acc) = match ls
    Nil        => acc
    Cons(h, t) => lst_map_ls(t, lst_map1(h, lst_tab(h, 0), acc))
fn lst_map1(h, p, acc) = if p < count(h) then Cons({k: slice(h, 0, p), v: lst_chomp(slice(h, p + 1, count(h)))}, acc) else acc
fn lst_tab(s, i) = if i >= count(s) or at(s, i) == chr(9) then i else lst_tab(s, i + 1)
fn lst_chomp(s) = if count(s) > 0 and at(s, count(s) - 1) == chr(13) then slice(s, 0, count(s) - 1) else s
fn lst_mfind(m, k) = match m
    Nil        => ""
    Cons(h, t) => if h.k == k then h.v else lst_mfind(t, k)
fn lst_file(mname, m) = let f = lst_mfind(m, mname) in if f != "" then lst_tidy(f) else if mname == "@entry" then "" else mname + ".src"
fn lst_tidy(p) = if count(p) > 2 and lst_sw(p, "./") then lst_tidy(slice(p, 2, count(p))) else p
## the name a declaration line defines ("" when it is not `[pub|priv|total|kernel] fn NAME`)
fn lst_decl(h) = if lst_sw(h, "pub ") then lst_decl(slice(h, 4, count(h))) else if lst_sw(h, "priv ") then lst_decl(slice(h, 5, count(h))) else if lst_sw(h, "total ") then lst_decl(slice(h, 6, count(h))) else if lst_sw(h, "kernel ") then lst_decl(slice(h, 7, count(h))) else if lst_sw(h, "fn ") then slice(h, 3, lst_idend(h, 3)) else ""
fn lst_idend(s, i) = if i < count(s) and (lst_idc(at(s, i)) or at(s, i) == "_") then lst_idend(s, i + 1) else i
fn lst_scan(ls, k, cur, m, acc) = match ls
    Nil        => rev(acc)
    Cons(h, t) => if lst_sw(h, "## --- module ") and lst_ew(h, " ---") then lst_scan(t, k + 1, {mname: slice(h, 14, count(h) - 4), base: k}, m, acc) else if lst_sw(h, "## --- entry ") and lst_ew(h, " ---") then lst_scan(t, k + 1, {mname: "@entry", base: k}, m, acc) else lst_scan1(h, t, k, cur, m, acc)
fn lst_scan1(h, t, k, cur, m, acc) = let nm = lst_decl(h) in if nm == "" then lst_scan(t, k + 1, cur, m, acc) else lst_scan(t, k + 1, cur, m, Cons({n: nm, f: lst_file(cur.mname, m), l: k - cur.base}, acc))
fn lst_info(src) = if src == "" then Nil else lst_scan(lp_lines(src, 0, count(src), Nil), 1, {mname: "@entry", base: 0}, lst_map(lst_mapfile()), Nil)
fn lst_mapfile() = let p = os_getenv("LUME_SRC_MAP") in if p == "" then "" else fs_read_file(p)
## declarations and labels come in nearly the same order: look from the last match on, then from the start
fn lst_find(xs, nm) = match xs
    Nil        => Nil
    Cons(h, t) => if h.n == nm then xs else lst_find(t, nm)
fn lst_pick(rest, all, nm) = let r = lst_find(rest, nm) in if isnil(r) == 0 then r else lst_find(all, nm)
fn lst_esc(s, i, acc) = if i >= count(s) then acc else let c = at(s, i) in lst_esc(s, i + 1, acc + (if c == chr(92) or c == chr(34) then chr(92) + c else c))
fn lst_hd(xs) = match xs
    Cons(h, t) => h
fn lst_tl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => t
fn lst_fidx(fs, f, i) = match fs
    Nil        => 0 - 1
    Cons(h, t) => if h == f then i else lst_fidx(t, f, i + 1)
## one row per label: {rows: text, files: the distinct file names in first-use order}
fn lst_rows(labs, st) = match labs
    Nil        => st
    Cons(h, t) => let r = lst_pick(st.rest, st.all, lst_dname(h)) in if isnil(r) == 1 then lst_rows(t, {rest: st.rest, all: st.all, k: st.k + 1, files: st.files, acc: st.acc + "    .quad " + h + "\n    .quad .Lstn" + str(st.k) + "\n    .quad 0\n    .quad 0\n"}) else lst_row2(h, t, lst_hd(r), lst_tl(r), st)
fn lst_row2(h, t, d, rest, st) = let fi = lst_fidx(st.files, d.f, 0) in let files2 = (if d.f != "" and fi < 0 then app(st.files, Cons(d.f, Nil)) else st.files) in let flab = (if d.f == "" then "0" else ".Lstf" + str(if fi < 0 then len(st.files) else fi)) in lst_rows(t, {rest: rest, all: st.all, k: st.k + 1, files: files2, acc: st.acc + "    .quad " + h + "\n    .quad .Lstn" + str(st.k) + "\n    .quad " + flab + "\n    .quad " + str(d.l) + "\n"})
fn lst_names(labs, k) = match labs
    Nil        => ""
    Cons(h, t) => ".Lstn" + str(k) + ":\n    .asciz \"" + lst_dname(h) + "\"\n" + lst_names(t, k + 1)
fn lst_files(fs, k) = match fs
    Nil        => ""
    Cons(h, t) => ".Lstf" + str(k) + ":\n    .asciz \"" + lst_esc(h, 0, "") + "\"\n" + lst_files(t, k + 1)
fn lst_table(a, src) = if lst_on(a) == false then "" else lst_table2(lst_labels(lp_lines(a.funcs_raw, 0, count(a.funcs_raw), Nil), 1, Nil), lst_info(src))
fn lst_table2(labs, info) = let r = lst_rows(labs, {rest: info, all: info, k: 0, files: Nil, acc: ""}) in "    .section .rodata\n    .balign 8\n__lume_fntab:\n    .quad " + str(len(labs)) + "\n    .quad __lume_uf_end\n" + r.acc + lst_names(labs, 0) + lst_files(r.files, 0)
## --- lume debug: a call of the debugger at each function's start and return, and the names and frame slots of its
## variables (compiler/stage1/rt/rt_debug.src reads them). Only when the driver sets LUME_DEBUG (the command file, or
## "-" for standard input) together with LUME_SRC_MAP: plain `lumec < file` is unchanged.
fn ldbg_on() = os_getenv("LUME_DEBUG") != "" and os_getenv("LUME_SRC_MAP") != ""
fn ldbg_act(a) = lst_on(a) and os_getenv("LUME_DEBUG") != ""
## the name the debugger shows for a local: a shadowing copy (_shN_x) shows as x, a record kept as fields
## (_sra_r_f) as r.f; the compiler's own temporaries (_sd0, __x, rw__...) are not listed
fn ldbg_name(nm) = if lst_sw(nm, "_sh") then ldbg_unsh(nm, 3) else if lst_sw(nm, "_sra_") then ldbg_sra(slice(nm, 5, count(nm))) else if lst_sw(nm, "_") or lst_sw(nm, "rw__") then "" else nm
fn ldbg_unsh(nm, i) = if i >= count(nm) then nm else if at(nm, i) == "_" then slice(nm, i + 1, count(nm)) else ldbg_unsh(nm, i + 1)
fn ldbg_sra(s) = let p = ldbg_lastus(s, 0, 0 - 1) in if p <= 0 then s else slice(s, 0, p) + "." + slice(s, p + 1, count(s))
fn ldbg_lastus(s, i, best) = if i >= count(s) then best else ldbg_lastus(s, i + 1, if at(s, i) == "_" then i else best)
fn ldbg_cnt(ls) = match ls
    Nil        => 0
    Cons(h, t) => (if ldbg_name(h) == "" then 0 else 1) + ldbg_cnt(t)
fn ldbg_take(ls, n) = if n <= 0 then Nil else ldbg_take2(ls, n)
fn ldbg_take2(ls, n) = match ls
    Nil        => Nil
    Cons(h, t) => Cons(h, ldbg_take(t, n - 1))
fn ldbg_q(ls, k, lab) = match ls
    Nil        => ""
    Cons(h, t) => (if ldbg_name(h) == "" then "" else "    .quad " + lab + "_" + str(k) + "\n    .quad " + lslot(k) + "\n") + ldbg_q(t, k + 1, lab)
fn ldbg_strs(ls, k, lab) = match ls
    Nil        => ""
    Cons(h, t) => (if ldbg_name(h) == "" then "" else lab + "_" + str(k) + ":\n    .asciz \"" + ldbg_name(h) + "\"\n") + ldbg_strs(t, k + 1, lab)
## {number of variables, number of them that are parameters, then {name, frame offset} per variable}
fn ldbg_block(nm, locals, np) = let lab = ".Ldbl_" + nm in let vl = ".Ldbv_" + nm in "    .section .rodata\n    .balign 8\n" + lab + ":\n    .quad " + str(ldbg_cnt(locals)) + "\n    .quad " + str(ldbg_cnt(ldbg_take(locals, np))) + "\n" + ldbg_q(locals, 0, vl) + ldbg_strs(locals, 0, vl) + "    .section .text\n"
## the variables start unset (0, which no value is), then the debugger sees the parameters
fn ldbg_zero(k, n) = if k >= n then "" else "    movq %rax, " + lslot(k) + "(%rbp)\n" + ldbg_zero(k + 1, n)
fn ldbg_enter(nm, np, nloc) = "    xorq %rax, %rax\n" + ldbg_zero(np, nloc) + "    leaq .Ldbe_" + nm + "(%rip), %rdi\n    movq %rbp, %rsi\n    call __rt_dbg_enter\n"
fn ldbg_leave(nm) = "    pushq %rax\n    pushq %rax\n    movq %rax, %rdx\n    leaq .Ldbe_" + nm + "(%rip), %rdi\n    movq %rbp, %rsi\n    call __rt_dbg_leave\n    popq %rax\n    popq %rax\n"
## rt_trace calls __rt_dbg_trap before it prints the call stack of an error: rt_debug (in the optional part) stops
## there for the debugger; a program without that part gets this stub
fn ldbg_stub() = "__rt_dbg_trap:\n    xorq %rax, %rax\n    ret\n"
fn ldbg_init(a) = if ldbg_act(a) then "    call __rt_dbg_start\n" else ""
## the optional runtime part holds rt_debug: a program that links it without debugging gets an empty table
fn ldbg_bss(a) = if ldbg_act(a) or a.has_crypto == 1 then "    .lcomm __dbg_state, 1024\n" else ""
## the functions that have a variable block (.Ldbl_NAME: lines of the function text)
fn ldbg_labs(ls, acc) = match ls
    Nil        => acc
    Cons(h, t) => ldbg_labs(t, if lst_sw(h, ".Ldbl_") and lst_ew(h, ":") then Cons(slice(h, 6, count(h) - 1), acc) else acc)
fn ldbg_mem(xs, x) = match xs
    Nil        => false
    Cons(h, t) => if h == x then true else ldbg_mem(t, x)
## one row of 7 words per label of the function text, in address order: start, name, file, line, variables, 0, 0
fn ldbg_rows(labs, st) = match labs
    Nil        => st
    Cons(h, t) => let r = lst_pick(st.rest, st.all, h) in let d = (if isnil(r) == 1 then {n: h, f: "", l: 0} else lst_hd(r)) in let rest = (if isnil(r) == 1 then st.rest else lst_tl(r)) in let k = str(st.k) in ldbg_rows(t, {rest: rest, all: st.all, k: st.k + 1, dl: st.dl, acc: st.acc + ".Ldbe_" + h + ":\n    .quad " + h + "\n    .quad .Ldbn" + k + "\n    .quad " + (if d.f == "" then "0" else ".Ldbf" + k) + "\n    .quad " + str(d.l) + "\n    .quad " + (if ldbg_mem(st.dl, h) then ".Ldbl_" + h else "0") + "\n    .quad 0\n    .quad 0\n", strs: st.strs + ".Ldbn" + k + ":\n    .asciz \"" + h + "\"\n" + (if d.f == "" then "" else ".Ldbf" + k + ":\n    .asciz \"" + lst_esc(d.f, 0, "") + "\"\n")})
fn ldbg_table(a, src) = if ldbg_act(a) == false then (if a.has_crypto == 1 then "    .section .rodata\n    .balign 8\n__lume_dbgcmd:\n    .asciz \"\"\n    .balign 8\n__lume_dbgtab:\n    .quad 0\n    .quad 0\n" else "") else let ls = lp_lines(a.funcs_raw, 0, count(a.funcs_raw), Nil) in let labs = lst_labels(ls, 1, Nil) in let info = lst_info(src) in let r = ldbg_rows(labs, {rest: info, all: info, k: 0, dl: ldbg_labs(ls, Nil), acc: "", strs: ""}) in "    .section .rodata\n    .balign 8\n__lume_dbgcmd:\n    .asciz \"" + lst_esc(os_getenv("LUME_DEBUG"), 0, "") + "\"\n    .balign 8\n__lume_dbgtab:\n    .quad " + str(len(labs)) + "\n    .quad __lume_uf_end\n" + r.acc + r.strs
fn lgen_src(prog0, src) = let a = lgen_analysis(prog0, "") in lcode_al_apply(lpf_final(lgen_emit_src(a, src), a))
## the runtime routines' alignment mark (rw_align) becomes a real `.p2align 5` under lume run / build / test only:
## plain `lumec < file` keeps the comment, so its text and its ELF stay what the seed's oracle gives
fn lcode_al_apply(t) = if os_getenv("LUME_SRC_MAP") == "" then t else lw_replace(t, "    #p2align" + chr(10), "    .p2align 5" + chr(10))
fn lgen(prog0) = lgen_src(prog0, "")


## --- runtime (copied verbatim from data_asmgen.lume) ---

## --- lumec --raw: the runtime written in Lume -----------------------------------------------------------------------
## A source of `fn` declarations becomes machine-word code for the runtime (the golden rule: the runtime is Lume
## source; the assembly is what the compiler makes of it). Parameters and results are 64-bit words, not tagged
## values: + - * are the machine's (wrapping), / and % are signed, comparisons give 1 or 0, `and` / `or` short-circuit
## on non-zero words, load8 / load32 / load64 read memory and store8 / store32 / store64 write it (they give 0),
## bit_and / bit_or / bit_xor / bit_shl / bit_shr act on words, sys_call(nr, a1..a5) is the OS call, and any other call
## is a call of a raw function or of a runtime routine by its name, with words in %rdi .. %r9. A call of the function
## itself in tail position is a jump back to its start (a loop: no stack grows). Every function keeps every register
## but %rax, its result, so it replaces a routine of the assembly runtime without its callers changing. Records,
## strings, lists and closures are not machine words: the compiler refuses them.
fn rw_regs() = Cons("%rdi", Cons("%rsi", Cons("%rdx", Cons("%rcx", Cons("%r8", Cons("%r9", Nil))))))
fn rw_nth(xs, k) = match xs
    Nil        => ""
    Cons(h, t) => if k <= 0 then h else rw_nth(t, k - 1)
fn rw_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + rw_len(t)
## where a value of a raw function lives: 1 .. 5 are the callee-saved registers %rbx, %r12 .. %r15 (the first five
## values: parameters, then lets, in a routine that is not rw_keepall), a negative number is a frame slot
fn rw_loc(o) = if o >= 1000 then str(o - 1000 + 16) + "(%rbp)" else if o > 0 then rw_nth(Cons("%rbx", Cons("%r12", Cons("%r13", Cons("%r14", Cons("%r15", Cons("%rdi", Cons("%rsi", Cons("%rdx", Cons("%r8", Cons("%r9", Cons("%r10", Cons("%r11", Nil)))))))))))), o - 1) else str(o) + "(%rbp)"
fn rw_vreg(f, idx) = rw_vregm(f, idx, 31)
## the five callee-saved registers go to the values a routine uses most (mask m: bit i for value i, parameters
## first, then the lets in the order the code generator meets them); the register is the rank of i in m
fn rw_vregm(f, idx, m) = if rw_isleaf(f) then rw_leafreg(f, idx) else if rw_keepall(f) then 0 else if idx < 62 and rw_mbit(m, idx) then rw_pop62(m % rw_p2(idx)) + 1 else 0
## (the compiler is ordinary Lume: no bit_* builtins here, they would link the runtime system tail)
fn rw_p2(k) = if k <= 0 then 1 else 2 * rw_p2(k - 1)
fn rw_mbit(m, i) = (m / rw_p2(i)) % 2 == 1
fn rw_pop62(x) = if x == 0 then 0 else x % 2 + rw_pop62(x / 2)
## the mask kept in env under a name no program can write (stored + 1: 0 means absent, then the first five)
fn rw_envmask(env) = if rw_slot(env, "#rmask") > 0 then rw_slot(env, "#rmask") - 1 else 31
## the uses of each candidate: parameters 0..5, then every let whose name its body reads (the same numbering as
## the LetIn case: the value first, then the let, then the body; branches and operands left to right)
fn rw_cnt(e, x) = match e
    Num(v)          => 0
    Str(v)          => 0
    Var(y)          => if y == x then 1 else 0
    Bin(op, a, b)   => rw_cnt(a, x) + rw_cnt(b, x)
    If(c, t, f)     => rw_cnt(c, x) + rw_cnt(t, x) + rw_cnt(f, x)
    LetIn(n, v, b)  => rw_cnt(v, x) + (if n == x then 0 else rw_cnt(b, x))
    Call(g, args)   => rw_cnt_l(args, x)
    _               => 0
fn rw_cnt_l(xs, x) = match xs
    Nil        => 0
    Cons(h, t) => rw_cnt(h, x) + rw_cnt_l(t, x)
fn rw_pcands(ps, i, body) = match ps
    Nil        => Nil
    Cons(p, t) => if i >= 6 then Nil else Cons({i: i, c: rw_cnt(body, p)}, rw_pcands(t, i + 1, body))
## the let candidates of e from index k: {xs, k} (the list and the next index)
fn rw_lcands(e, k) = match e
    Bin(op, a, b)   => rw_lc2(rw_lcands(a, k), b)
    If(c, t, f)     => rw_lc2(rw_lc2(rw_lcands(c, k), t), f)
    LetIn(n, v, b)  => rw_lclet(rw_lcands(v, k), n, b)
    Call(g, args)   => rw_lcl(args, {xs: Nil, k: k})
    _               => {xs: Nil, k: k}
fn rw_lc2(r, e) = let q = rw_lcands(e, r.k) in {xs: rw_appc(r.xs, q.xs), k: q.k}
fn rw_lcl(xs, r) = match xs
    Nil        => r
    Cons(h, t) => rw_lcl(t, rw_lc2(r, h))
fn rw_lclet(r, n, b) = if rw_uses(b, n) then (let q = rw_lcands(b, r.k + 1) in {xs: rw_appc(r.xs, Cons({i: r.k, c: rw_cnt(b, n)}, q.xs)), k: q.k}) else (let q = rw_lcands(b, r.k) in {xs: rw_appc(r.xs, q.xs), k: q.k})
fn rw_appc(a, b) = match a
    Nil        => b
    Cons(h, t) => Cons(h, rw_appc(t, b))
## the five most used (ties: the lower index), as a mask; candidates past index 61 are left out
fn rw_rmask(ps, body) = let np = rw_len(ps) in rw_top5(rw_appc(rw_pcands(ps, 0, body), (rw_lcands(body, np)).xs), 0, 0)
fn rw_top5(cs, m, k) = if k >= 5 then m else (let b = rw_best(cs, m, {i: 0 - 1, c: 0}) in if b.i < 0 then m else rw_top5(cs, m + rw_p2(b.i), k + 1))
fn rw_best(cs, m, best) = match cs
    Nil        => best
    Cons(h, t) => rw_best(t, m, if h.i < 62 and h.c > 0 and rw_mbit(m, h.i) == false and (h.c > best.c or (h.c == best.c and best.i >= 0 and h.i < best.i)) then h else best)
## a leaf routine (its code makes no call, syscall or division) is generated a second time under the name NAME__lf:
## no frame, its parameters stay in rdi, rsi, rdx, r8, r9 (the 4th moves from rcx, the scratch register, to r10),
## its lets take r11, then r10 when it has fewer than four parameters
fn rw_isleaf(f) = count(f) > 4 and slice(f, count(f) - 4, count(f)) == "__lf"
fn rw_base(f) = if rw_isleaf(f) then slice(f, 0, count(f) - 4) else f
fn rw_leafreg(f, idx) = rw_nthi(Cons(6, Cons(7, Cons(8, Cons(11, Cons(9, Cons(10, Nil)))))), idx)
fn rw_nthi(xs, i) = match xs
    Nil        => 0
    Cons(h, t) => if i == 0 then h else rw_nthi(t, i - 1)
fn rw_slot(env, nm) = match env
    Nil        => 0
    Cons(h, t) => if h.k == nm then h.off else rw_slot(t, nm)
## parameter i lives where the prologue pushed its register: -8(%rbp) for %rdi .. -48(%rbp) for %r9
fn rw_params(ps, i, acc, f) = rw_paramsm(ps, i, acc, f, 31)
fn rw_paramsm(ps, i, acc, f, m) = match ps
    Nil        => acc
    Cons(p, t) => rw_paramsm(t, i + 1, Cons({k: p, off: rw_phomem(f, i, m)}, acc), f, m)
## where parameter i lives: its register, else its frame slot (-8(%rbp) for the 1st .. -48(%rbp) for the 6th), and from
## the 7th on the word the caller pushed (System V: the 7th at 16(%rbp), the 8th at 24(%rbp) ...), encoded 1000 + 8 * (i - 6)
fn rw_phome(f, i) = rw_phomem(f, i, 31)
fn rw_phomem(f, i, m) = if i < 6 and rw_vregm(f, i, m) > 0 then rw_vregm(f, i, m) else if i >= 6 then 1000 + 8 * (i - 6) else if rw_keepall(f) or rw_isleaf(f) then 0 - 8 * (i + 1) else 0 - 48 - 8 * i
fn rw_r(code, st) = {code: code, n: st.n, nl: st.nl, f: st.f, np: st.np}
fn rw_lab(st, k) = ".Lrw_" + st.f + "_" + str(k)
fn rw_cc(op) = if op == "==" then "e" else if op == "!=" then "ne" else if op == "<" then "l" else if op == "<=" then "le" else if op == ">" then "g" else "ge"
fn rw_iscmp(op) = op == "==" or op == "!=" or op == "<" or op == "<=" or op == ">" or op == ">="
## a string literal of a raw function is the address of its bytes, a constant C string in .rodata (messages)
fn rw_esc(s, i, acc) = if i >= count(s) then acc else let c = at(s, i) in rw_esc(s, i + 1, acc + (if c == chr(92) then chr(92) + chr(92) else if c == chr(34) then chr(92) + chr(34) else if c == chr(10) then chr(92) + "n" else if c == chr(9) then chr(92) + "t" else c))
## %rax = a (left), %rcx = b (right)
fn rw_op(op) = if op == "+" or op == "+%" then "    addq %rcx, %rax\n" else if op == "-" or op == "-%" then "    subq %rcx, %rax\n" else if op == "*" or op == "*%" then "    imulq %rcx, %rax\n" else if op == "/" then "    cqto\n    idivq %rcx\n" else if op == "%" then "    cqto\n    idivq %rcx\n    movq %rdx, %rax\n" else ctfail("lume --raw: the operator '" + op + "' has no machine-word meaning\n")
## a right operand an instruction can take directly: a 32-bit literal or a register-held value ("" otherwise; a
## frame slot goes through %rcx, a wider literal through the stack)
fn rw_imm(e, env) = match e
    Num(v) => if v >= 0 - 2147483648 and v < 2147483648 then "$" + str(v) else ""
    Var(x) => let o = rw_slot(env, x) in if o > 0 then rw_loc(o) else if o < 0 then rw_loc(o) else ""
    _      => ""
fn rw_isslot(src) = count(src) > 6 and slice(src, count(src) - 6, count(src)) == "(%rbp)"
## %rax = %rax op src (src from rw_imm)
fn rw_opsrc(op, src) = if op == "*" or op == "*%" or op == "/" or op == "%" then "    movq " + src + ", %rcx\n" + rw_op(op) else if rw_isslot(src) then "    movq " + src + ", %rcx\n" + rw_op(op) else if op == "+" or op == "+%" then "    addq " + src + ", %rax\n" else if op == "-" or op == "-%" then "    subq " + src + ", %rax\n" else rw_op(op)
fn rw_cmpsrc(src) = if rw_isslot(src) then "    movq " + src + ", %rcx\n    cmpq %rcx, %rax\n" else "    cmpq " + src + ", %rax\n"
fn rw_binimm(op, a, src, env, st) = let k = st.n in let ra = rw_e(a, env, {n: st.n + 1, nl: st.nl, f: st.f, np: st.np}, 0) in rw_r(ra.code + (if rw_iscmp(op) then rw_cmpsrc(src) + "    movq $1, %rax\n    j" + rw_cc(op) + " " + rw_lab(st, k) + "c\n    xorq %rax, %rax\n" + rw_lab(st, k) + "c:\n" else rw_opsrc(op, src)), ra)
fn rw_inv(op) = if op == "==" then "ne" else if op == "!=" then "e" else if op == "<" then "ge" else if op == "<=" then "g" else if op == ">" then "le" else "l"
## the condition of an if: a comparison sets the flags and jumps to the else label when false; anything else is
## evaluated and tested
fn rw_cond(c, env, st, el) = match c
    Bin(op, a, b) => if rw_iscmp(op) then rw_cmpj(rw_inv(op), a, b, env, st, el) else if op == "and" then rw_cond_and(a, b, env, st, el) else if op == "or" then rw_cond_or(a, b, env, st, el) else let r = rw_e(c, env, st, 0) in rw_r(r.code + "    testq %rax, %rax\n    jz " + el + "\n", r)
    _             => let r = rw_e(c, env, st, 0) in rw_r(r.code + "    testq %rax, %rax\n    jz " + el + "\n", r)
## `a and b` / `a or b` as a condition: jumps only, no boolean is built (`or` jumps over the test of b when a holds)
fn rw_cond_and(a, b, env, st, el) = let ra = rw_cond(a, env, st, el) in let rb = rw_cond(b, env, ra, el) in rw_r(ra.code + rb.code, rb)
fn rw_cond_or(a, b, env, st, el) = let k = st.n in let ra = rw_condt(a, env, {n: st.n + 1, nl: st.nl, f: st.f, np: st.np}, rw_lab(st, k) + "t") in let rb = rw_cond(b, env, ra, el) in rw_r(ra.code + rb.code + rw_lab(st, k) + "t:\n", rb)
## the mirror of rw_cond: jumps to tl when the condition holds, falls through when it does not
fn rw_condt(c, env, st, tl) = match c
    Bin(op, a, b) => if rw_iscmp(op) then rw_cmpj(rw_cc(op), a, b, env, st, tl) else if op == "or" then rw_condt_or(a, b, env, st, tl) else if op == "and" then rw_condt_and(a, b, env, st, tl) else let r = rw_e(c, env, st, 0) in rw_r(r.code + "    testq %rax, %rax\n    jnz " + tl + "\n", r)
    _             => let r = rw_e(c, env, st, 0) in rw_r(r.code + "    testq %rax, %rax\n    jnz " + tl + "\n", r)
fn rw_condt_or(a, b, env, st, tl) = let ra = rw_condt(a, env, st, tl) in let rb = rw_condt(b, env, ra, tl) in rw_r(ra.code + rb.code, rb)
fn rw_condt_and(a, b, env, st, tl) = let k = st.n in let ra = rw_cond(a, env, {n: st.n + 1, nl: st.nl, f: st.f, np: st.np}, rw_lab(st, k) + "f") in let rb = rw_condt(b, env, ra, tl) in rw_r(ra.code + rb.code + rw_lab(st, k) + "f:\n", rb)
## a comparison that jumps to lab with condition code cc (rw_inv(op) for the else of an if, rw_cc(op) for a jump when true)
## `bit_and(x, m) == 0` (or != 0, or any comparison of it with 0) as a condition: one testq, no and/cmp; a value kept
## in a register is compared where it lives
fn rw_testj(cc, x, m, env, st, lab) = if rw_regof(x, env) != "" then rw_r("    testq $" + str(m) + ", " + rw_regof(x, env) + "\n    j" + cc + " " + lab + "\n", st) else let r = rw_e(x, env, st, 0) in rw_r(r.code + "    testq $" + str(m) + ", %rax\n    j" + cc + " " + lab + "\n", r)
fn rw_iszero(e) = match e
    Num(v) => if v == 0 then 1 else 0
    _      => 0
## the mask m of `bit_and(x, m)` when it is a literal that fits a testq immediate, else -1
fn rw_andm(a) = match a
    Call(g, args) => if g == "bit_and" and rw_len(args) == 2 then rw_immval(rw_nth(args, 1)) else 0 - 1
    _             => 0 - 1
fn rw_immval(e) = match e
    Num(m) => if m >= 0 and m < 2147483648 then m else 0 - 1
    _      => 0 - 1
fn rw_andx(a) = match a
    Call(g, args) => rw_nth(args, 0)
    _             => a
## the register that holds a name (a parameter or let kept in a register), else ""
fn rw_regof(e, env) = match e
    Var(x) => rw_regslot(rw_slot(env, x))
    _      => ""
fn rw_regslot(o) = if o > 0 and o < 1000 then rw_loc(o) else ""
## operands are computed left to right, as in ordinary Lume (2026-11-21; before, the right one went first). The left
## value (in %rax) waits in %rcx while the right one is computed when the right one's code never touches %rcx (no call,
## no shift by %cl); the operation then works on a in %rcx and b in %rax. Else the left value waits on the stack and the
## operation gets a in %rax, b in %rcx. rw_keepa (comparisons) leaves the flags of a - b either way.
fn rw_rcxfree(bcode) = lp_has(bcode, "cx") == 0 and lp_has(bcode, "%cl") == 0 and lp_has(bcode, "call") == 0
fn rw_keepa(bcode) = rw_keepat(bcode, "")
fn rw_keepat(bcode, t) = if rw_rcxfree(bcode) then "    movq %rax, %rcx\n" + bcode + "    cmpq %rax, %rcx\n" else if t != "" then "    movq %rax, " + t + "\n" + bcode + "    cmpq %rax, " + t + "\n" else "    pushq %rax\n" + bcode + "    movq %rax, %rcx\n    popq %rax\n    cmpq %rcx, %rax\n"
## a temporary register for the left value while the right one is computed, so it need not go to the stack: none when
## the right code calls anything (a call may change every scratch register); else the first of r11, r10, r9, r8, rsi,
## rdi that the right code never names and that holds no value of the function (in a leaf: its parameters and the
## lets allocated so far). rdx (cqto, idiv, rdtsc) and rcx (shifts, syscall) are never temporaries.
fn rw_tmp(bcode, st) = rw_tmpe(bcode, st, Nil)
fn rw_tmpe(bcode, st, env) = if lp_has(bcode, "call") == 1 then "" else rw_tpick(rw_tminus(rw_tpool(st), rw_envregs(env)), bcode)
## the scratch registers names in scope live in (offsets 6..12: rdi rsi rdx r8 r9 r10 r11)
fn rw_envregs(env) = match env
    Nil        => Nil
    Cons(h, t) => if h.k != "#rmask" and h.off >= 6 and h.off <= 12 then Cons(rw_loc(h.off), rw_envregs(t)) else rw_envregs(t)
## a let of a non-leaf routine beyond the five callee-saved registers lives in a free scratch register instead of a
## stack slot when nothing in its scope can change scratch registers: no call (only load / store / bit_* / sym_addr
## and arithmetic), so the value survives until its last use
fn rw_nocall(e) = match e
    Num(v)          => true
    Str(v)          => true
    Var(x)          => true
    Bin(op, a, b)   => rw_nocall(a) and rw_nocall(b)
    If(c, t, f)     => rw_nocall(c) and rw_nocall(t) and rw_nocall(f)
    LetIn(n, v, b)  => rw_nocall(v) and rw_nocall(b)
    Call(g, args)   => (rw_mem(g) or rw_isbit(g) or g == "sym_addr") and rw_nocall_l(args)
    _               => false
## whether e reads the name x (a let of the same name inside counts as a read: safe)
fn rw_uses(e, x) = match e
    Num(v)          => false
    Str(v)          => false
    Var(y)          => y == x
    Bin(op, a, b)   => rw_uses(a, x) or rw_uses(b, x)
    If(c, t, f)     => rw_uses(c, x) or rw_uses(t, x) or rw_uses(f, x)
    LetIn(n, v, b)  => rw_uses(v, x) or rw_uses(b, x)
    Call(g, args)   => g == x or rw_uses_l(args, x)
    _               => true
fn rw_uses_l(xs, x) = match xs
    Nil        => false
    Cons(h, t) => rw_uses(h, x) or rw_uses_l(t, x)
fn rw_nocall_l(xs) = match xs
    Nil        => true
    Cons(h, t) => rw_nocall(h) and rw_nocall_l(t)
fn rw_tofs(r) = if r == "%rdi" then 6 else if r == "%rsi" then 7 else if r == "%r8" then 9 else if r == "%r9" then 10 else if r == "%r10" then 11 else 12
fn rw_letreg(b, env) = if rw_nocall(b) then rw_firstofs(rw_tminus(rw_tall(), rw_envregs(env))) else 0
fn rw_firstofs(xs) = match xs
    Nil        => 0
    Cons(h, t) => rw_tofs(h)
fn rw_tpool(st) = if rw_isleaf(st.f) then rw_tminus(rw_tall(), rw_lfregs(st.np, st.nl)) else rw_tall()
fn rw_tall() = Cons("%r11", Cons("%r10", Cons("%r9", Cons("%r8", Cons("%rsi", Cons("%rdi", Nil))))))
fn rw_tminus(xs, ys) = match xs
    Nil        => Nil
    Cons(h, t) => if rw_tin(h, ys) then rw_tminus(t, ys) else Cons(h, rw_tminus(t, ys))
fn rw_tin(x, ys) = match ys
    Nil        => false
    Cons(h, t) => h == x or rw_tin(x, t)
fn rw_tpick(rs, bcode) = match rs
    Nil        => ""
    Cons(h, t) => if lp_has(bcode, rw_tkey(h)) == 0 then h else rw_tpick(t, bcode)
## the part of a register's name every form of it contains (%r10 / %r10d / %r10b, %rsi / %esi / %sil)
fn rw_tkey(r) = if r == "%rsi" then "si" else if r == "%rdi" then "di" else slice(r, 1, count(r))
## a op b with a in the temporary t and b in %rax
fn rw_optmp(op, t) = if op == "+" or op == "+%" then "    addq " + t + ", %rax\n" else if op == "*" or op == "*%" then "    imulq " + t + ", %rax\n" else if op == "-" or op == "-%" then "    subq %rax, " + t + "\n    movq " + t + ", %rax\n" else "    movq %rax, %rcx\n    movq " + t + ", %rax\n" + rw_op(op)
fn rw_binab(op, bcode, st, k) = rw_binabe(op, bcode, st, k, Nil)
fn rw_binabe(op, bcode, st, k, env) = if rw_iscmp(op) then rw_keepat(bcode, rw_tmpe(bcode, st, env)) + "    movq $1, %rax\n    j" + rw_cc(op) + " " + rw_lab(st, k) + "c\n    xorq %rax, %rax\n" + rw_lab(st, k) + "c:\n" else if rw_rcxfree(bcode) and rw_swapok(op) then "    movq %rax, %rcx\n" + bcode + rw_opswap(op) else if rw_tmpe(bcode, st, env) != "" then "    movq %rax, " + rw_tmpe(bcode, st, env) + "\n" + bcode + rw_optmp(op, rw_tmpe(bcode, st, env)) else "    pushq %rax\n" + bcode + "    movq %rax, %rcx\n    popq %rax\n" + rw_op(op)
## the operations that take a in %rcx and b in %rax without moving them first
fn rw_swapok(op) = op == "+" or op == "+%" or op == "*" or op == "*%" or op == "-" or op == "-%"
fn rw_opswap(op) = if op == "-" or op == "-%" then "    subq %rax, %rcx\n    movq %rcx, %rax\n" else rw_op(op)
fn rw_cmpj(cc, a, b, env, st, lab) = if rw_iszero(b) == 1 and rw_andm(a) >= 0 then rw_testj(cc, rw_andx(a), rw_andm(a), env, st, lab) else if rw_imm(b, env) != "" and rw_regof(a, env) != "" then rw_r("    cmpq " + rw_imm(b, env) + ", " + rw_regof(a, env) + "\n    j" + cc + " " + lab + "\n", st) else let src = rw_imm(b, env) in if src != "" then (let ra = rw_e(a, env, st, 0) in rw_r(ra.code + rw_cmpsrc(src) + "    j" + cc + " " + lab + "\n", ra)) else let ra = rw_e(a, env, st, 0) in let rb = rw_e(b, env, ra, 0) in rw_r(ra.code + rw_keepat(rb.code, rw_tmpe(rb.code, st, env)) + "    j" + cc + " " + lab + "\n", rb)
fn rw_cmpjump(op, a, b, env, st, el) = rw_cmpj(rw_inv(op), a, b, env, st, el)
## an if in tail position of a leaf routine: each branch ends in its own ret (no jump to a shared end), and a branch
## that only calls a runtime stop (__rt_not_str, __rt_die3, __rt_need_int ...) is placed after the other one, so the
## ordinary path falls straight through every check, as hand-written assembly does (measured: ord_at took six
## taken jumps per call before, and a loop of a few such routines ran 2.5x slower than the assembly)
fn rw_ifleaf(c, t, f, env, st) = let k = st.n in if rw_cold(t) == 1 then rw_ifleaf_cold(c, t, f, env, st, k) else let rc = rw_cond(c, env, {n: st.n + 1, nl: st.nl, f: st.f, np: st.np}, rw_lab(st, k) + "e") in let rt = rw_e(t, env, rc, 1) in let rf = rw_e(f, env, rt, 1) in rw_r(rc.code + rw_tailret(rt.code) + rw_lab(st, k) + "e:\n" + rw_tailret(rf.code), rf)
fn rw_ifleaf_cold(c, t, f, env, st, k) = let rc = rw_condt(c, env, {n: st.n + 1, nl: st.nl, f: st.f, np: st.np}, rw_lab(st, k) + "c") in let rf = rw_e(f, env, rc, 1) in let rt = rw_e(t, env, rf, 1) in rw_r(rc.code + rw_tailret(rf.code) + rw_lab(st, k) + "c:\n" + rw_tailret(rt.code), rt)
fn rw_cold(t) = match t
    Call(g, args) => if ld_s_starts(g, "__rt_") then 1 else 0
    _             => 0
## code that does not already end in a ret or a jump gets a ret
fn rw_tailret(code) = if rw_lastline(code, count(code) - 2) == "    ret" or ld_s_starts(rw_lastline(code, count(code) - 2), "    jmp ") then code else code + "    ret\n"
fn rw_lastline(code, i) = if i < 0 then slice(code, 0, rw_maxi(count(code) - 1, 0)) else if slice(code, i, i + 1) == chr(10) then slice(code, i + 1, count(code) - 1) else rw_lastline(code, i - 1)
fn rw_maxi(a, b) = if a > b then a else b
fn rw_e(e, env, st, tail) = match e
    Num(v)          => rw_r("    movq $" + str(v) + ", %rax\n", st)
    Str(v)          => let k = st.n in rw_r("    leaq " + rw_lab(st, k) + "t(%rip), %rax\n    .section .rodata\n" + rw_lab(st, k) + "t:\n    .asciz \"" + rw_esc(v, 0, "") + "\"\n    .section .text\n", {n: st.n + 1, nl: st.nl, f: st.f, np: st.np})
    Var(x)          => let o = rw_slot(env, x) in if o == 0 then ctfail("lume --raw: unknown name '" + x + "' in '" + st.f + "'\n") else rw_r("    movq " + rw_loc(o) + ", %rax\n", st)
    Bin(op, a, b)   => if op == "and" or op == "or" then rw_logic(op, a, b, env, st) else if rw_imm(b, env) != "" then rw_binimm(op, a, rw_imm(b, env), env, st) else let k = st.n in let ra = rw_e(a, env, {n: st.n + 1, nl: st.nl, f: st.f, np: st.np}, 0) in let rb = rw_e(b, env, ra, 0) in rw_r(ra.code + rw_binabe(op, rb.code, st, k, env), rb)
    If(c, t, f)     => if tail == 1 and rw_isleaf(st.f) then rw_ifleaf(c, t, f, env, st) else let k = st.n in let rc = rw_cond(c, env, {n: st.n + 1, nl: st.nl, f: st.f, np: st.np}, rw_lab(st, k) + "e") in let rt = rw_e(t, env, rc, tail) in let rf = rw_e(f, env, rt, tail) in rw_r(rc.code + rt.code + "    jmp " + rw_lab(st, k) + "d\n" + rw_lab(st, k) + "e:\n" + rf.code + rw_lab(st, k) + "d:\n", rf)
    LetIn(nm, v, b) => let rv = rw_e(v, env, st, 0) in let vr0 = (if rw_isleaf(st.f) then (if rv.nl == 0 then 12 else 11) else rw_vregm(st.f, st.np + rv.nl, rw_envmask(env))) in let vr = (if vr0 == 0 and rw_isleaf(st.f) == false and rw_keepall(st.f) == 0 then rw_letreg(b, env) else vr0) in let off = if vr > 0 then vr else if rw_keepall(st.f) then 0 - 72 - 8 * rv.nl else 0 - 96 - 8 * rv.nl in let rb = rw_e(b, Cons({k: nm, off: off}, env), {n: rv.n, nl: rv.nl + (if rw_uses(b, nm) then 1 else 0), f: st.f, np: st.np}, tail) in rw_r(rv.code + (if rw_uses(b, nm) then "    movq %rax, " + rw_loc(off) + "\n" else "") + rb.code, rb)
    Call(g, args)   => rw_call(g, args, env, st, tail)
    _               => ctfail("lume --raw: '" + st.f + "' uses a value that is not a machine word (a string, record, list or closure)\n")
fn rw_logic(op, a, b, env, st) = let k = st.n in let ra = rw_e(a, env, {n: st.n + 1, nl: st.nl, f: st.f, np: st.np}, 0) in let rb = rw_e(b, env, ra, 0) in rw_r(ra.code + "    testq %rax, %rax\n    " + (if op == "and" then "jz " else "jnz ") + rw_lab(st, k) + "s\n" + rb.code + rw_lab(st, k) + "s:\n    testq %rax, %rax\n    movq $0, %rax\n    jz " + rw_lab(st, k) + "z\n    movq $1, %rax\n" + rw_lab(st, k) + "z:\n", rb)
## the arguments, left to right, each pushed
fn rw_push(args, env, st) = match args
    Nil        => rw_r("", st)
    Cons(h, t) => let r1 = rw_e(h, env, st, 0) in let r2 = rw_push(t, env, r1) in rw_r(r1.code + "    pushq %rax\n" + r2.code, r2)
## pop into the k first argument registers (the last argument first)
fn rw_popregs(k) = if k <= 0 then "" else "    popq " + rw_nth(rw_regs(), k - 1) + "\n" + rw_popregs(k - 1)
## a self tail call (a loop): an argument that is the same parameter in the same position is neither pushed nor
## popped; the others are all computed first (pushed), then stored into their parameters (popped, last first)
fn rw_pushsel(args, i, env, st) = match args
    Nil        => rw_r("", st)
    Cons(h, t) => if rw_same(h, i, env, st.f) == 1 then rw_pushsel(t, i + 1, env, st) else rw_pushsel2(rw_e(h, env, st, 0), t, i, env)
fn rw_pushsel2(r1, t, i, env) = let r2 = rw_pushsel(t, i + 1, env, r1) in rw_r(r1.code + "    pushq %rax\n" + r2.code, r2)
fn rw_popsel(args, i, env, f) = match args
    Nil        => ""
    Cons(h, t) => rw_popsel(t, i + 1, env, f) + (if rw_same(h, i, env, f) == 1 then "" else rw_pop1m(i, f, rw_envmask(env)))
fn rw_pop1(i, f) = rw_pop1m(i, f, 31)
fn rw_pop1m(i, f, m) = if rw_phomem(f, i, m) > 0 and rw_phomem(f, i, m) < 1000 then "    popq " + rw_loc(rw_phomem(f, i, m)) + "\n" else "    popq %rax\n    movq %rax, " + rw_loc(rw_phomem(f, i, m)) + "\n"
fn rw_same(h, i, env, f) = match h
    Var(x) => if rw_slot(env, x) == rw_phomem(f, i, rw_envmask(env)) then 1 else 0
    _      => 0
fn rw_poff(f, i) = rw_phome(f, i)
fn rw_popparams(k, f) = if k <= 0 then "" else (if rw_vreg(f, k - 1) > 0 then "    popq " + rw_loc(rw_vreg(f, k - 1)) + "\n" else "    popq %rax\n    movq %rax, " + str(0 - 8 * k) + "(%rbp)\n") + rw_popparams(k - 1, f)
fn rw_popslots(k) = if k <= 0 then "" else "    popq %rax\n    movq %rax, " + str(0 - 8 * k) + "(%rbp)\n" + rw_popslots(k - 1)
## vector intrinsics of --raw (SSE2, xmm0 / xmm1 only: volatile in the SysV and Win64 ABIs): vec_sad16(p, q) and
## vec_sad8(p, q) are the sums of |p[i] - q[i]| over 16 / 8 bytes at the addresses p and q (psadbw); no alignment needed
fn rw_vec(g) = g == "vec_sad16" or g == "vec_sad8"
## vec_satd4(pa, sa, pb, sb): the 4x4 Hadamard transform of the difference of two byte blocks (rows sa / sb bytes
## apart), as 4 * sum |coefficient| (the butterflies leave every coefficient in four lanes; SATD = result >> 3). SSE2, xmm0..xmm5 only
## (xmm6 and up are callee-saved on Win64), r10 scratch; coefficients fit 16 bits (|c| <= 4080, eight per lane)
fn rw_satd4_asm() = "    pxor %xmm5, %xmm5\n    movl (%rax), %r10d\n    movq %r10, %xmm0\n    punpcklbw %xmm5, %xmm0\n    movl (%rdx), %r10d\n    movq %r10, %xmm1\n    punpcklbw %xmm5, %xmm1\n    psubw %xmm1, %xmm0\n    addq %rcx, %rax\n    addq %r8, %rdx\n    movl (%rax), %r10d\n    movq %r10, %xmm1\n    punpcklbw %xmm5, %xmm1\n    movl (%rdx), %r10d\n    movq %r10, %xmm2\n    punpcklbw %xmm5, %xmm2\n    psubw %xmm2, %xmm1\n    punpcklqdq %xmm1, %xmm0\n    addq %rcx, %rax\n    addq %r8, %rdx\n    movl (%rax), %r10d\n    movq %r10, %xmm1\n    punpcklbw %xmm5, %xmm1\n    movl (%rdx), %r10d\n    movq %r10, %xmm2\n    punpcklbw %xmm5, %xmm2\n    psubw %xmm2, %xmm1\n    addq %rcx, %rax\n    addq %r8, %rdx\n    movl (%rax), %r10d\n    movq %r10, %xmm2\n    punpcklbw %xmm5, %xmm2\n    movl (%rdx), %r10d\n    movq %r10, %xmm3\n    punpcklbw %xmm5, %xmm3\n    psubw %xmm3, %xmm2\n    punpcklqdq %xmm2, %xmm1\n    movdqu %xmm0, %xmm2\n    paddw %xmm1, %xmm0\n    psubw %xmm1, %xmm2\n    pshufd $78, %xmm0, %xmm1\n    movdqu %xmm0, %xmm3\n    paddw %xmm1, %xmm0\n    psubw %xmm1, %xmm3\n    pshufd $78, %xmm2, %xmm1\n    movdqu %xmm2, %xmm4\n    paddw %xmm1, %xmm2\n    psubw %xmm1, %xmm4\n    punpcklqdq %xmm2, %xmm0\n    punpcklqdq %xmm4, %xmm3\n    pshuflw $78, %xmm0, %xmm1\n    pshufhw $78, %xmm1, %xmm1\n    movdqu %xmm0, %xmm2\n    paddw %xmm1, %xmm0\n    psubw %xmm1, %xmm2\n    pshuflw $177, %xmm0, %xmm1\n    pshufhw $177, %xmm1, %xmm1\n    movdqu %xmm0, %xmm4\n    paddw %xmm1, %xmm0\n    psubw %xmm1, %xmm4\n    pshuflw $177, %xmm2, %xmm1\n    pshufhw $177, %xmm1, %xmm1\n    movdqu %xmm2, %xmm5\n    paddw %xmm1, %xmm2\n    psubw %xmm1, %xmm5\n    movdqu %xmm0, %xmm1\n    psraw $15, %xmm1\n    pxor %xmm1, %xmm0\n    psubw %xmm1, %xmm0\n    movdqu %xmm4, %xmm1\n    psraw $15, %xmm1\n    pxor %xmm1, %xmm4\n    psubw %xmm1, %xmm4\n    paddw %xmm4, %xmm0\n    movdqu %xmm2, %xmm1\n    psraw $15, %xmm1\n    pxor %xmm1, %xmm2\n    psubw %xmm1, %xmm2\n    paddw %xmm2, %xmm0\n    movdqu %xmm5, %xmm1\n    psraw $15, %xmm1\n    pxor %xmm1, %xmm5\n    psubw %xmm1, %xmm5\n    paddw %xmm5, %xmm0\n    pshuflw $78, %xmm3, %xmm1\n    pshufhw $78, %xmm1, %xmm1\n    movdqu %xmm3, %xmm2\n    paddw %xmm1, %xmm3\n    psubw %xmm1, %xmm2\n    pshuflw $177, %xmm3, %xmm1\n    pshufhw $177, %xmm1, %xmm1\n    movdqu %xmm3, %xmm4\n    paddw %xmm1, %xmm3\n    psubw %xmm1, %xmm4\n    pshuflw $177, %xmm2, %xmm1\n    pshufhw $177, %xmm1, %xmm1\n    movdqu %xmm2, %xmm5\n    paddw %xmm1, %xmm2\n    psubw %xmm1, %xmm5\n    movdqu %xmm3, %xmm1\n    psraw $15, %xmm1\n    pxor %xmm1, %xmm3\n    psubw %xmm1, %xmm3\n    paddw %xmm3, %xmm0\n    movdqu %xmm4, %xmm1\n    psraw $15, %xmm1\n    pxor %xmm1, %xmm4\n    psubw %xmm1, %xmm4\n    paddw %xmm4, %xmm0\n    movdqu %xmm2, %xmm1\n    psraw $15, %xmm1\n    pxor %xmm1, %xmm2\n    psubw %xmm1, %xmm2\n    paddw %xmm2, %xmm0\n    movdqu %xmm5, %xmm1\n    psraw $15, %xmm1\n    pxor %xmm1, %xmm5\n    psubw %xmm1, %xmm5\n    paddw %xmm5, %xmm0\n    pxor %xmm5, %xmm5\n    movdqu %xmm0, %xmm1\n    punpcklwd %xmm5, %xmm0\n    punpckhwd %xmm5, %xmm1\n    paddd %xmm1, %xmm0\n    pshufd $78, %xmm0, %xmm1\n    paddd %xmm1, %xmm0\n    pshufd $177, %xmm0, %xmm1\n    paddd %xmm1, %xmm0\n    movq %xmm0, %rax\n    movl %eax, %eax\n"
## vec_sad4(pa, sa, pb, sb): the sum of absolute differences of two 4x4 byte blocks (rows sa / sb bytes apart), one
## psadbw per row
fn rw_sad4_asm() = "    pxor %xmm0, %xmm0\n    movl (%rax), %r10d\n    movq %r10, %xmm1\n    movl (%rdx), %r10d\n    movq %r10, %xmm2\n    psadbw %xmm2, %xmm1\n    paddq %xmm1, %xmm0\n    addq %rcx, %rax\n    addq %r8, %rdx\n    movl (%rax), %r10d\n    movq %r10, %xmm1\n    movl (%rdx), %r10d\n    movq %r10, %xmm2\n    psadbw %xmm2, %xmm1\n    paddq %xmm1, %xmm0\n    addq %rcx, %rax\n    addq %r8, %rdx\n    movl (%rax), %r10d\n    movq %r10, %xmm1\n    movl (%rdx), %r10d\n    movq %r10, %xmm2\n    psadbw %xmm2, %xmm1\n    paddq %xmm1, %xmm0\n    addq %rcx, %rax\n    addq %r8, %rdx\n    movl (%rax), %r10d\n    movq %r10, %xmm1\n    movl (%rdx), %r10d\n    movq %r10, %xmm2\n    psadbw %xmm2, %xmm1\n    paddq %xmm1, %xmm0\n    movq %xmm0, %r10\n    movq %r10, %rax\n"
## vec_fdct4(src, dst): the H.264 forward 4x4 core transform of the int16 block at src (rows 8 bytes apart) into dst:
## butterflies over the four row registers, a word transpose (punpcklwd / punpckhwd / psrldq), the butterflies again and
## the transpose back. Additions, subtractions and doublings only, so the low 16 bits equal the scalar result exactly.
## xmm0..xmm5 and r10 only; answers 0
fn rw_fdct4_asm() = "    movq (%rax), %r10\n    movq %r10, %xmm0\n    movq 8(%rax), %r10\n    movq %r10, %xmm1\n    movq 16(%rax), %r10\n    movq %r10, %xmm2\n    movq 24(%rax), %r10\n    movq %r10, %xmm3\n    movdqu %xmm0, %xmm4\n    paddw %xmm3, %xmm4\n    psubw %xmm3, %xmm0\n    movdqu %xmm1, %xmm5\n    paddw %xmm2, %xmm5\n    psubw %xmm2, %xmm1\n    movdqu %xmm4, %xmm2\n    paddw %xmm5, %xmm2\n    psubw %xmm5, %xmm4\n    movdqu %xmm0, %xmm3\n    paddw %xmm0, %xmm3\n    paddw %xmm1, %xmm3\n    movdqu %xmm1, %xmm5\n    paddw %xmm1, %xmm5\n    psubw %xmm5, %xmm0\n    movdqu %xmm0, %xmm5\n    movdqu %xmm2, %xmm0\n    movdqu %xmm3, %xmm1\n    movdqu %xmm4, %xmm2\n    movdqu %xmm5, %xmm3\n    movdqu %xmm0, %xmm4\n    punpcklwd %xmm2, %xmm4\n    movdqu %xmm1, %xmm5\n    punpcklwd %xmm3, %xmm5\n    movdqu %xmm4, %xmm0\n    punpcklwd %xmm5, %xmm0\n    punpckhwd %xmm5, %xmm4\n    movdqu %xmm0, %xmm1\n    psrldq $8, %xmm1\n    movdqu %xmm4, %xmm2\n    movdqu %xmm4, %xmm3\n    psrldq $8, %xmm3\n    movdqu %xmm0, %xmm4\n    paddw %xmm3, %xmm4\n    psubw %xmm3, %xmm0\n    movdqu %xmm1, %xmm5\n    paddw %xmm2, %xmm5\n    psubw %xmm2, %xmm1\n    movdqu %xmm4, %xmm2\n    paddw %xmm5, %xmm2\n    psubw %xmm5, %xmm4\n    movdqu %xmm0, %xmm3\n    paddw %xmm0, %xmm3\n    paddw %xmm1, %xmm3\n    movdqu %xmm1, %xmm5\n    paddw %xmm1, %xmm5\n    psubw %xmm5, %xmm0\n    movdqu %xmm0, %xmm5\n    movdqu %xmm2, %xmm0\n    movdqu %xmm3, %xmm1\n    movdqu %xmm4, %xmm2\n    movdqu %xmm5, %xmm3\n    movdqu %xmm0, %xmm4\n    punpcklwd %xmm2, %xmm4\n    movdqu %xmm1, %xmm5\n    punpcklwd %xmm3, %xmm5\n    movdqu %xmm4, %xmm0\n    punpcklwd %xmm5, %xmm0\n    punpckhwd %xmm5, %xmm4\n    movdqu %xmm0, %xmm1\n    psrldq $8, %xmm1\n    movdqu %xmm4, %xmm2\n    movdqu %xmm4, %xmm3\n    psrldq $8, %xmm3\n    movq %xmm0, %r10\n    movq %r10, (%rcx)\n    movq %xmm1, %r10\n    movq %r10, 8(%rcx)\n    movq %xmm2, %r10\n    movq %r10, 16(%rcx)\n    movq %xmm3, %r10\n    movq %r10, 24(%rcx)\n    xorq %rax, %rax\n"
## block-pipeline vector intrinsics of --raw (SSE2, xmm0..xmm5, r10; every result equal to the scalar routines of
## rt_codec.src, 16-bit wrap included); the 4-argument ones keep rdx, r8, r9 and r11 and answer 0:
##   vec_res4(pa, sa, pp, dst)     dst (16 int16) = the 4x4 bytes at pa (rows sa apart) - the 16 bytes at pp
##   vec_rec4(pp, res, d, ds)      the 4 rows at d (ds apart) = clip(pp byte + res int16) (paddsw then packuswb)
##   vec_idct4(src, dst)           the inverse 4x4 transform of the int16 block with the final (x + 32) >> 6, in
##                                 32-bit lanes (two dword transposes), the low 16 bits of each result stored
##   vec_quant4(src, dst, mp, fq)  |w| x mp[i % 8] + (fq >> 5) >> (fq & 31) with w's sign, 32-bit products from
##                                 pmullw / pmulhuw (|w| unsigned, so -32768 counts 32768)
##   vec_dequant4(src, dst, vp, sh) the low 16 bits of (z x vp[i % 8]) << sh
fn rw_vec4w(g) = g == "vec_res4" or g == "vec_rec4" or g == "vec_quant4" or g == "vec_dequant4"
fn rw_res4_asm() = "    pushq %rdx\n" + "    pushq %r8\n" + "    pushq %r9\n" + "    pushq %r11\n" + "    movq 56(%rsp), %rax\n" + "    movq 48(%rsp), %rcx\n" + "    movq 40(%rsp), %rdx\n" + "    movq 32(%rsp), %r8\n" + "    pxor %xmm5, %xmm5\n" + "    movl (%rax), %r10d\n" + "    movq %r10, %xmm0\n" + "    punpcklbw %xmm5, %xmm0\n" + "    movl 0(%rdx), %r10d\n" + "    movq %r10, %xmm1\n" + "    punpcklbw %xmm5, %xmm1\n" + "    psubw %xmm1, %xmm0\n" + "    movq %xmm0, %r10\n" + "    movq %r10, 0(%r8)\n" + "    addq %rcx, %rax\n" + "    movl (%rax), %r10d\n" + "    movq %r10, %xmm0\n" + "    punpcklbw %xmm5, %xmm0\n" + "    movl 4(%rdx), %r10d\n" + "    movq %r10, %xmm1\n" + "    punpcklbw %xmm5, %xmm1\n" + "    psubw %xmm1, %xmm0\n" + "    movq %xmm0, %r10\n" + "    movq %r10, 8(%r8)\n" + "    addq %rcx, %rax\n" + "    movl (%rax), %r10d\n" + "    movq %r10, %xmm0\n" + "    punpcklbw %xmm5, %xmm0\n" + "    movl 8(%rdx), %r10d\n" + "    movq %r10, %xmm1\n" + "    punpcklbw %xmm5, %xmm1\n" + "    psubw %xmm1, %xmm0\n" + "    movq %xmm0, %r10\n" + "    movq %r10, 16(%r8)\n" + "    addq %rcx, %rax\n" + "    movl (%rax), %r10d\n" + "    movq %r10, %xmm0\n" + "    punpcklbw %xmm5, %xmm0\n" + "    movl 12(%rdx), %r10d\n" + "    movq %r10, %xmm1\n" + "    punpcklbw %xmm5, %xmm1\n" + "    psubw %xmm1, %xmm0\n" + "    movq %xmm0, %r10\n" + "    movq %r10, 24(%r8)\n" + "    addq %rcx, %rax\n" + "    popq %r11\n" + "    popq %r9\n" + "    popq %r8\n" + "    popq %rdx\n" + "    addq $32, %rsp\n"
fn rw_rec4_asm() = "    pushq %rdx\n" + "    pushq %r8\n" + "    pushq %r9\n" + "    pushq %r11\n" + "    movq 56(%rsp), %rax\n" + "    movq 48(%rsp), %rcx\n" + "    movq 40(%rsp), %rdx\n" + "    movq 32(%rsp), %r8\n" + "    pxor %xmm5, %xmm5\n" + "    movl 0(%rax), %r10d\n" + "    movq %r10, %xmm0\n" + "    punpcklbw %xmm5, %xmm0\n" + "    movq 0(%rcx), %r10\n" + "    movq %r10, %xmm1\n" + "    paddsw %xmm1, %xmm0\n" + "    packuswb %xmm0, %xmm0\n" + "    movq %xmm0, %r10\n" + "    movl %r10d, (%rdx)\n" + "    addq %r8, %rdx\n" + "    movl 4(%rax), %r10d\n" + "    movq %r10, %xmm0\n" + "    punpcklbw %xmm5, %xmm0\n" + "    movq 8(%rcx), %r10\n" + "    movq %r10, %xmm1\n" + "    paddsw %xmm1, %xmm0\n" + "    packuswb %xmm0, %xmm0\n" + "    movq %xmm0, %r10\n" + "    movl %r10d, (%rdx)\n" + "    addq %r8, %rdx\n" + "    movl 8(%rax), %r10d\n" + "    movq %r10, %xmm0\n" + "    punpcklbw %xmm5, %xmm0\n" + "    movq 16(%rcx), %r10\n" + "    movq %r10, %xmm1\n" + "    paddsw %xmm1, %xmm0\n" + "    packuswb %xmm0, %xmm0\n" + "    movq %xmm0, %r10\n" + "    movl %r10d, (%rdx)\n" + "    addq %r8, %rdx\n" + "    movl 12(%rax), %r10d\n" + "    movq %r10, %xmm0\n" + "    punpcklbw %xmm5, %xmm0\n" + "    movq 24(%rcx), %r10\n" + "    movq %r10, %xmm1\n" + "    paddsw %xmm1, %xmm0\n" + "    packuswb %xmm0, %xmm0\n" + "    movq %xmm0, %r10\n" + "    movl %r10d, (%rdx)\n" + "    addq %r8, %rdx\n" + "    popq %r11\n" + "    popq %r9\n" + "    popq %r8\n" + "    popq %rdx\n" + "    addq $32, %rsp\n"
fn rw_quant4_asm() = "    pushq %rdx\n" + "    pushq %r8\n" + "    pushq %r9\n" + "    pushq %r11\n" + "    movq 56(%rsp), %rax\n" + "    movq 48(%rsp), %rcx\n" + "    movq 40(%rsp), %rdx\n" + "    movq 32(%rsp), %r8\n" + "    movq %r8, %r10\n" + "    shrq $5, %r10\n" + "    movq %r10, %xmm4\n" + "    pshufd $0, %xmm4, %xmm4\n" + "    movq %r8, %r10\n" + "    andq $31, %r10\n" + "    movq %r10, %xmm5\n" + "    movdqu (%rdx), %xmm3\n" + "    movdqu 0(%rax), %xmm0\n" + "    pxor %xmm1, %xmm1\n" + "    pcmpgtw %xmm0, %xmm1\n" + "    pxor %xmm1, %xmm0\n" + "    psubw %xmm1, %xmm0\n" + "    movdqu %xmm0, %xmm2\n" + "    pmullw %xmm3, %xmm0\n" + "    pmulhuw %xmm3, %xmm2\n" + "    movdqu %xmm0, %xmm1\n" + "    punpcklwd %xmm2, %xmm0\n" + "    punpckhwd %xmm2, %xmm1\n" + "    paddd %xmm4, %xmm0\n" + "    paddd %xmm4, %xmm1\n" + "    psrad %xmm5, %xmm0\n" + "    psrad %xmm5, %xmm1\n" + "    packssdw %xmm1, %xmm0\n" + "    movdqu 0(%rax), %xmm2\n" + "    pxor %xmm1, %xmm1\n" + "    pcmpgtw %xmm2, %xmm1\n" + "    pxor %xmm1, %xmm0\n" + "    psubw %xmm1, %xmm0\n" + "    movdqu %xmm0, 0(%rcx)\n" + "    movdqu 16(%rax), %xmm0\n" + "    pxor %xmm1, %xmm1\n" + "    pcmpgtw %xmm0, %xmm1\n" + "    pxor %xmm1, %xmm0\n" + "    psubw %xmm1, %xmm0\n" + "    movdqu %xmm0, %xmm2\n" + "    pmullw %xmm3, %xmm0\n" + "    pmulhuw %xmm3, %xmm2\n" + "    movdqu %xmm0, %xmm1\n" + "    punpcklwd %xmm2, %xmm0\n" + "    punpckhwd %xmm2, %xmm1\n" + "    paddd %xmm4, %xmm0\n" + "    paddd %xmm4, %xmm1\n" + "    psrad %xmm5, %xmm0\n" + "    psrad %xmm5, %xmm1\n" + "    packssdw %xmm1, %xmm0\n" + "    movdqu 16(%rax), %xmm2\n" + "    pxor %xmm1, %xmm1\n" + "    pcmpgtw %xmm2, %xmm1\n" + "    pxor %xmm1, %xmm0\n" + "    psubw %xmm1, %xmm0\n" + "    movdqu %xmm0, 16(%rcx)\n" + "    xorq %rax, %rax\n" + "    popq %r11\n" + "    popq %r9\n" + "    popq %r8\n" + "    popq %rdx\n" + "    addq $32, %rsp\n"
fn rw_dequant4_asm() = "    pushq %rdx\n" + "    pushq %r8\n" + "    pushq %r9\n" + "    pushq %r11\n" + "    movq 56(%rsp), %rax\n" + "    movq 48(%rsp), %rcx\n" + "    movq 40(%rsp), %rdx\n" + "    movq 32(%rsp), %r8\n" + "    movq %r8, %r10\n" + "    movq %r10, %xmm5\n" + "    movdqu (%rdx), %xmm3\n" + "    movdqu 0(%rax), %xmm0\n" + "    pmullw %xmm3, %xmm0\n" + "    psllw %xmm5, %xmm0\n" + "    movdqu %xmm0, 0(%rcx)\n" + "    movdqu 16(%rax), %xmm0\n" + "    pmullw %xmm3, %xmm0\n" + "    psllw %xmm5, %xmm0\n" + "    movdqu %xmm0, 16(%rcx)\n" + "    xorq %rax, %rax\n" + "    popq %r11\n" + "    popq %r9\n" + "    popq %r8\n" + "    popq %rdx\n" + "    addq $32, %rsp\n"
fn rw_idct4_asm() = "    movq 0(%rax), %r10\n" + "    movq %r10, %xmm0\n" + "    punpcklwd %xmm0, %xmm0\n" + "    psrad $16, %xmm0\n" + "    movq 8(%rax), %r10\n" + "    movq %r10, %xmm1\n" + "    punpcklwd %xmm1, %xmm1\n" + "    psrad $16, %xmm1\n" + "    movq 16(%rax), %r10\n" + "    movq %r10, %xmm2\n" + "    punpcklwd %xmm2, %xmm2\n" + "    psrad $16, %xmm2\n" + "    movq 24(%rax), %r10\n" + "    movq %r10, %xmm3\n" + "    punpcklwd %xmm3, %xmm3\n" + "    psrad $16, %xmm3\n" + "    movdqu %xmm0, %xmm4\n" + "    punpckldq %xmm1, %xmm4\n" + "    punpckhdq %xmm1, %xmm0\n" + "    movdqu %xmm2, %xmm5\n" + "    punpckldq %xmm3, %xmm5\n" + "    punpckhdq %xmm3, %xmm2\n" + "    movdqu %xmm4, %xmm1\n" + "    punpcklqdq %xmm5, %xmm1\n" + "    punpckhqdq %xmm5, %xmm4\n" + "    movdqu %xmm0, %xmm3\n" + "    punpcklqdq %xmm2, %xmm3\n" + "    punpckhqdq %xmm2, %xmm0\n" + "    movdqu %xmm1, %xmm2\n" + "    paddd %xmm3, %xmm2\n" + "    psubd %xmm3, %xmm1\n" + "    movdqu %xmm4, %xmm3\n" + "    psrad $1, %xmm3\n" + "    psubd %xmm0, %xmm3\n" + "    movdqu %xmm0, %xmm5\n" + "    psrad $1, %xmm5\n" + "    paddd %xmm4, %xmm5\n" + "    movdqu %xmm2, %xmm0\n" + "    paddd %xmm5, %xmm0\n" + "    psubd %xmm5, %xmm2\n" + "    movdqu %xmm1, %xmm4\n" + "    paddd %xmm3, %xmm4\n" + "    psubd %xmm3, %xmm1\n" + "    movdqu %xmm0, %xmm3\n" + "    punpckldq %xmm4, %xmm3\n" + "    punpckhdq %xmm4, %xmm0\n" + "    movdqu %xmm1, %xmm5\n" + "    punpckldq %xmm2, %xmm5\n" + "    punpckhdq %xmm2, %xmm1\n" + "    movdqu %xmm3, %xmm4\n" + "    punpcklqdq %xmm5, %xmm4\n" + "    punpckhqdq %xmm5, %xmm3\n" + "    movdqu %xmm0, %xmm2\n" + "    punpcklqdq %xmm1, %xmm2\n" + "    punpckhqdq %xmm1, %xmm0\n" + "    movdqu %xmm4, %xmm1\n" + "    paddd %xmm2, %xmm1\n" + "    psubd %xmm2, %xmm4\n" + "    movdqu %xmm3, %xmm2\n" + "    psrad $1, %xmm2\n" + "    psubd %xmm0, %xmm2\n" + "    movdqu %xmm0, %xmm5\n" + "    psrad $1, %xmm5\n" + "    paddd %xmm3, %xmm5\n" + "    movdqu %xmm1, %xmm0\n" + "    paddd %xmm5, %xmm0\n" + "    psubd %xmm5, %xmm1\n" + "    movdqu %xmm4, %xmm3\n" + "    paddd %xmm2, %xmm3\n" + "    psubd %xmm2, %xmm4\n" + "    movq $32, %r10\n" + "    movq %r10, %xmm5\n" + "    pshufd $0, %xmm5, %xmm5\n" + "    paddd %xmm5, %xmm0\n" + "    psrad $6, %xmm0\n" + "    pslld $16, %xmm0\n" + "    psrad $16, %xmm0\n" + "    paddd %xmm5, %xmm3\n" + "    psrad $6, %xmm3\n" + "    pslld $16, %xmm3\n" + "    psrad $16, %xmm3\n" + "    paddd %xmm5, %xmm4\n" + "    psrad $6, %xmm4\n" + "    pslld $16, %xmm4\n" + "    psrad $16, %xmm4\n" + "    paddd %xmm5, %xmm1\n" + "    psrad $6, %xmm1\n" + "    pslld $16, %xmm1\n" + "    psrad $16, %xmm1\n" + "    packssdw %xmm3, %xmm0\n" + "    movdqu %xmm0, (%rcx)\n" + "    packssdw %xmm1, %xmm4\n" + "    movdqu %xmm4, 16(%rcx)\n" + "    xorq %rax, %rax\n"
fn rw_vec4wop(g) = if g == "vec_res4" then rw_res4_asm() else if g == "vec_rec4" then rw_rec4_asm() else if g == "vec_quant4" then rw_quant4_asm() else rw_dequant4_asm()
fn rw_vecop(g) = if g == "vec_sad16" then "    movdqu (%rax), %xmm0\n    movdqu (%rcx), %xmm1\n    psadbw %xmm1, %xmm0\n    movq %xmm0, %rax\n    psrldq $8, %xmm0\n    movq %xmm0, %rcx\n    addq %rcx, %rax\n" else "    movq (%rax), %rax\n    movq (%rcx), %rcx\n    movq %rax, %xmm0\n    movq %rcx, %xmm1\n    psadbw %xmm1, %xmm0\n    movq %xmm0, %rax\n"
## three-argument vector intrinsics for luma motion compensation (8.4.2.2.1). Each one keeps rdx and r11 (a leaf
## routine's third parameter and its first let) on the stack, reads its arguments from there and uses xmm0..xmm5 only:
##   vec_hp6h(src, dst, dw)  the horizontal 6-tap (1, -5, 20, 20, -5, 1) at the 8 bytes from src (reads src - 2 ..
##                           src + 13): the raw sums as 8 int16 at dw (16 bytes), Clip1((sum + 16) >> 5) at dst (writes
##                           16 bytes, the last 8 are scratch)
##   vec_hp6v(src, s, dst)   the vertical 6-tap over rows s bytes apart (rows -2 .. 3 of src, 16 bytes read per row),
##                           Clip1((sum + 16) >> 5) of 8 columns at dst (writes 16 bytes)
##   vec_hp6c(src, s, dst)   the vertical 6-tap over int16 rows (the raw horizontal sums), in 32-bit lanes,
##                           Clip1((sum + 512) >> 10) of 8 columns at dst (writes 16 bytes): the centre sample j
##   vec_avg8(p, q, d) / vec_avg4(p, q, d)  (p[i] + q[i] + 1) >> 1 of 8 / 4 bytes into d (exactly 8 / 4 bytes written)
fn rw_vec3(g) = g == "vec_hp6h" or g == "vec_hp6v" or g == "vec_hp6c" or g == "vec_avg8" or g == "vec_avg4"
fn rw_vec3op(g) = if g == "vec_hp6h" then "    pushq %r11\n    pushq %rdx\n    movq 16(%rsp), %r11\n    movq 24(%rsp), %rcx\n    movq 32(%rsp), %rax\n    movdqu -2(%rax), %xmm0\n    pxor %xmm5, %xmm5\n    movdqu %xmm0, %xmm1\n    psrldq $2, %xmm1\n    punpcklbw %xmm5, %xmm1\n    movdqu %xmm0, %xmm2\n    psrldq $3, %xmm2\n    punpcklbw %xmm5, %xmm2\n    paddw %xmm2, %xmm1\n    psllw $2, %xmm1\n    movdqu %xmm0, %xmm2\n    psrldq $1, %xmm2\n    punpcklbw %xmm5, %xmm2\n    movdqu %xmm0, %xmm3\n    psrldq $4, %xmm3\n    punpcklbw %xmm5, %xmm3\n    paddw %xmm3, %xmm2\n    psubw %xmm2, %xmm1\n    movdqu %xmm1, %xmm2\n    psllw $2, %xmm2\n    paddw %xmm2, %xmm1\n    movdqu %xmm0, %xmm2\n    punpcklbw %xmm5, %xmm2\n    movdqu %xmm0, %xmm3\n    psrldq $5, %xmm3\n    punpcklbw %xmm5, %xmm3\n    paddw %xmm3, %xmm2\n    paddw %xmm2, %xmm1\n    movdqu %xmm1, (%r11)\n    movq $1048592, %rdx\n    movq %rdx, %xmm4\n    pshufd $0, %xmm4, %xmm4\n    paddw %xmm4, %xmm1\n    psraw $5, %xmm1\n    packuswb %xmm1, %xmm1\n    movdqu %xmm1, (%rcx)\n    popq %rdx\n    popq %r11\n    addq $24, %rsp\n    xorq %rax, %rax\n" else if g == "vec_hp6v" then "    pushq %r11\n    pushq %rdx\n    movq 16(%rsp), %r11\n    movq 24(%rsp), %rcx\n    movq 32(%rsp), %rax\n    pxor %xmm5, %xmm5\n    subq %rcx, %rax\n    subq %rcx, %rax\n    movdqu (%rax), %xmm0\n    punpcklbw %xmm5, %xmm0\n    addq %rcx, %rax\n    movdqu (%rax), %xmm2\n    punpcklbw %xmm5, %xmm2\n    addq %rcx, %rax\n    movdqu (%rax), %xmm1\n    punpcklbw %xmm5, %xmm1\n    addq %rcx, %rax\n    movdqu (%rax), %xmm3\n    punpcklbw %xmm5, %xmm3\n    paddw %xmm3, %xmm1\n    psllw $2, %xmm1\n    addq %rcx, %rax\n    movdqu (%rax), %xmm3\n    punpcklbw %xmm5, %xmm3\n    paddw %xmm3, %xmm2\n    psubw %xmm2, %xmm1\n    movdqu %xmm1, %xmm2\n    psllw $2, %xmm2\n    paddw %xmm2, %xmm1\n    addq %rcx, %rax\n    movdqu (%rax), %xmm3\n    punpcklbw %xmm5, %xmm3\n    paddw %xmm3, %xmm0\n    paddw %xmm0, %xmm1\n    movq $1048592, %rdx\n    movq %rdx, %xmm4\n    pshufd $0, %xmm4, %xmm4\n    paddw %xmm4, %xmm1\n    psraw $5, %xmm1\n    packuswb %xmm1, %xmm1\n    movdqu %xmm1, (%r11)\n    popq %rdx\n    popq %r11\n    addq $24, %rsp\n    xorq %rax, %rax\n" else if g == "vec_hp6c" then "    pushq %r11\n    pushq %rdx\n    movq 16(%rsp), %r11\n    movq 24(%rsp), %rcx\n    movq 32(%rsp), %rax\n    movq $512, %rdx\n    movq %rdx, %xmm4\n    pshufd $0, %xmm4, %xmm4\n    subq %rcx, %rax\n    subq %rcx, %rax\n    movdqu (%rax), %xmm0\n    punpcklwd %xmm0, %xmm0\n    psrad $16, %xmm0\n    addq %rcx, %rax\n    movdqu (%rax), %xmm2\n    punpcklwd %xmm2, %xmm2\n    psrad $16, %xmm2\n    addq %rcx, %rax\n    movdqu (%rax), %xmm1\n    punpcklwd %xmm1, %xmm1\n    psrad $16, %xmm1\n    addq %rcx, %rax\n    movdqu (%rax), %xmm3\n    punpcklwd %xmm3, %xmm3\n    psrad $16, %xmm3\n    paddd %xmm3, %xmm1\n    pslld $2, %xmm1\n    addq %rcx, %rax\n    movdqu (%rax), %xmm3\n    punpcklwd %xmm3, %xmm3\n    psrad $16, %xmm3\n    paddd %xmm3, %xmm2\n    psubd %xmm2, %xmm1\n    movdqu %xmm1, %xmm2\n    pslld $2, %xmm2\n    paddd %xmm2, %xmm1\n    addq %rcx, %rax\n    movdqu (%rax), %xmm3\n    punpcklwd %xmm3, %xmm3\n    psrad $16, %xmm3\n    paddd %xmm3, %xmm0\n    paddd %xmm0, %xmm1\n    paddd %xmm4, %xmm1\n    psrad $10, %xmm1\n    subq %rcx, %rax\n    subq %rcx, %rax\n    subq %rcx, %rax\n    movdqu %xmm1, %xmm5\n    subq %rcx, %rax\n    subq %rcx, %rax\n    movdqu (%rax), %xmm0\n    punpckhwd %xmm0, %xmm0\n    psrad $16, %xmm0\n    addq %rcx, %rax\n    movdqu (%rax), %xmm2\n    punpckhwd %xmm2, %xmm2\n    psrad $16, %xmm2\n    addq %rcx, %rax\n    movdqu (%rax), %xmm1\n    punpckhwd %xmm1, %xmm1\n    psrad $16, %xmm1\n    addq %rcx, %rax\n    movdqu (%rax), %xmm3\n    punpckhwd %xmm3, %xmm3\n    psrad $16, %xmm3\n    paddd %xmm3, %xmm1\n    pslld $2, %xmm1\n    addq %rcx, %rax\n    movdqu (%rax), %xmm3\n    punpckhwd %xmm3, %xmm3\n    psrad $16, %xmm3\n    paddd %xmm3, %xmm2\n    psubd %xmm2, %xmm1\n    movdqu %xmm1, %xmm2\n    pslld $2, %xmm2\n    paddd %xmm2, %xmm1\n    addq %rcx, %rax\n    movdqu (%rax), %xmm3\n    punpckhwd %xmm3, %xmm3\n    psrad $16, %xmm3\n    paddd %xmm3, %xmm0\n    paddd %xmm0, %xmm1\n    paddd %xmm4, %xmm1\n    psrad $10, %xmm1\n    subq %rcx, %rax\n    subq %rcx, %rax\n    subq %rcx, %rax\n    packssdw %xmm1, %xmm5\n    packuswb %xmm5, %xmm5\n    movdqu %xmm5, (%r11)\n    popq %rdx\n    popq %r11\n    addq $24, %rsp\n    xorq %rax, %rax\n" else if g == "vec_avg8" then "    pushq %r11\n    pushq %rdx\n    movq 16(%rsp), %r11\n    movq 24(%rsp), %rcx\n    movq 32(%rsp), %rax\n    movq (%rax), %rax\n    movq (%rcx), %rcx\n    movq %rax, %xmm0\n    movq %rcx, %xmm1\n    pavgb %xmm1, %xmm0\n    movq %xmm0, %rax\n    movq %rax, (%r11)\n    popq %rdx\n    popq %r11\n    addq $24, %rsp\n    xorq %rax, %rax\n" else "    pushq %r11\n    pushq %rdx\n    movq 16(%rsp), %r11\n    movq 24(%rsp), %rcx\n    movq 32(%rsp), %rax\n    movl (%rax), %eax\n    movl (%rcx), %ecx\n    movq %rax, %xmm0\n    movq %rcx, %xmm1\n    pavgb %xmm1, %xmm0\n    movq %xmm0, %rax\n    movl %eax, (%r11)\n    popq %rdx\n    popq %r11\n    addq $24, %rsp\n    xorq %rax, %rax\n"
## deblocking intrinsics (8.7.2.3, bS < 4) on 16 lines at once, SSE2 with xmm0..xmm5 only; every general register but
## rax and rcx is kept (pushed). ab = alpha + beta 2^8 + chroma 2^16 (chroma: p1 / q1 never change and tC0 already
## carries its + 1); tcw = the tC0 of each pair of lines, one byte per pair (line 2j and 2j + 1), 255 for a pair that
## must not be filtered; scr = a 512-byte scratch block (vectors at 0 .. 303, the transposed edge at 320 .. 447, the
## first half of a transpose at 448 .. 511).
##   vec_dbk16(p, s, ab, tcw, scr)          a horizontal edge filtered in place: q0 of line i at p + i, rows s apart
##                                          (reads rows -3 .. 2, writes rows -2 .. 1; lines left alone keep their bytes)
##   vec_dbkv(p1, p2, s, ab, tcw, scr)      a vertical edge: lines 0..7 have q0 at p1 + i s, lines 8..15 at p2 + i s
##                                          (reads q0 - 4 .. q0 + 3, writes q0 - 2 .. q0 + 1 of each line, lines 8..15
##                                          first, so p2 = p1 serves one 8-line chroma edge)
##   vec_dbkh2(p1, p2, s, ab, tcw, scr)     a horizontal chroma edge: lines 0..7 are the 8 bytes of the rows at p1,
##                                          lines 8..15 those at p2 (reads rows -2 .. 1, writes rows -1 and 0, p2 first)
fn rw_dbk_push() = "    pushq %rdx\n    pushq %rsi\n    pushq %rdi\n    pushq %r8\n    pushq %r9\n    pushq %r10\n    pushq %r11\n"
fn rw_dbk_pop(n) = "    popq %r11\n    popq %r10\n    popq %r9\n    popq %r8\n    popq %rdi\n    popq %rsi\n    popq %rdx\n    addq $" + str(8 * n) + ", %rsp\n    xorq %rax, %rax\n"
## the vectors from ab (%r8) and tcw (%r9) into the block at %rdx: alpha 0, beta 16, tC0 32, enable 48, luma 64,
## 16 bytes of 3 at 240, of 161 at 256, of 1 at 288
fn rw_dbk_vecs() = "    movq %r8, %rax\n    andq $255, %rax\n    movq %rax, %xmm0\n    punpcklbw %xmm0, %xmm0\n    pshuflw $0, %xmm0, %xmm0\n    punpcklqdq %xmm0, %xmm0\n    movdqu %xmm0, 0(%rdx)\n    movq %r8, %rax\n    shrq $8, %rax\n    andq $255, %rax\n    movq %rax, %xmm0\n    punpcklbw %xmm0, %xmm0\n    pshuflw $0, %xmm0, %xmm0\n    punpcklqdq %xmm0, %xmm0\n    movdqu %xmm0, 16(%rdx)\n    movq %r8, %rax\n    shrq $16, %rax\n    andq $1, %rax\n    subq $1, %rax\n    movq %rax, %xmm0\n    punpcklqdq %xmm0, %xmm0\n    movdqu %xmm0, 64(%rdx)\n    movq %r9, %xmm0\n    punpcklbw %xmm0, %xmm0\n    movdqu %xmm0, 32(%rdx)\n    pcmpeqb %xmm2, %xmm2\n    movdqu %xmm2, %xmm1\n    pcmpeqb %xmm0, %xmm1\n    pxor %xmm2, %xmm1\n    movdqu %xmm1, 48(%rdx)\n    pxor %xmm3, %xmm3\n    psubb %xmm2, %xmm3\n    movdqu %xmm3, 288(%rdx)\n    movdqu %xmm3, %xmm0\n    paddb %xmm3, %xmm0\n    paddb %xmm3, %xmm0\n    movdqu %xmm0, 240(%rdx)\n    movdqu %xmm3, %xmm0\n    psllw $7, %xmm0\n    movdqu %xmm3, %xmm1\n    psllw $5, %xmm1\n    paddb %xmm1, %xmm0\n    paddb %xmm3, %xmm0\n    movdqu %xmm0, 256(%rdx)\n"
## |a - b| < t (per byte, unsigned): the fail mask (FF where |a - b| >= t) into xmm4, using xmm5 as well; a in xmm, b
## and t in memory or xmm
fn rw_dbk_fail(a, b, t) = "    movdqu " + a + ", %xmm4\n    movdqu " + b + ", %xmm6\n    psubusb %xmm6, %xmm4\n    movdqu " + b + ", %xmm5\n    psubusb " + a + ", %xmm5\n    por %xmm5, %xmm4\n    movdqu " + t + ", %xmm5\n    psubusb %xmm4, %xmm5\n    pxor %xmm4, %xmm4\n    pcmpeqb %xmm5, %xmm4\n"
## p0' = Clip1(p0 + delta), q0' = Clip1(q0 - delta), delta = Clip3(-tC, tC, (4 (q0 - p0) + (p1 - q1) + 4) >> 3), in
## bytes without widening: averages give d + 161 (saturating, exact for the range tC can keep), its parts above and below
## 161 are clipped by tC & mask (0 where the line is not filtered) and added / taken with saturation. The rows go
## straight to P0 (%r10,%r11) and Q0 (%rax)
fn rw_dbk_p0q0() = "    movdqu 160(%rdx), %xmm4\n    movdqu 80(%rdx), %xmm6\n    pand %xmm6, %xmm4\n    movdqu %xmm4, 272(%rdx)\n    movdqu 208(%rdx), %xmm0\n    movdqu 176(%rdx), %xmm1\n    movdqu 192(%rdx), %xmm2\n    movdqu 224(%rdx), %xmm3\n    pcmpeqb %xmm4, %xmm4\n    movdqu %xmm1, %xmm5\n    pxor %xmm2, %xmm5\n    pxor %xmm4, %xmm3\n    movdqu 288(%rdx), %xmm6\n    pand %xmm6, %xmm5\n    pavgb %xmm0, %xmm3\n    movdqu 240(%rdx), %xmm6\n    pavgb %xmm6, %xmm3\n    pxor %xmm1, %xmm4\n    pavgb %xmm2, %xmm4\n    pavgb %xmm5, %xmm3\n    paddusb %xmm4, %xmm3\n    movdqu 256(%rdx), %xmm5\n    psubusb %xmm3, %xmm5\n    movdqu 256(%rdx), %xmm6\n    psubusb %xmm6, %xmm3\n    movdqu 272(%rdx), %xmm4\n    pminub %xmm4, %xmm5\n    pminub %xmm4, %xmm3\n    psubusb %xmm5, %xmm1\n    psubusb %xmm3, %xmm2\n    paddusb %xmm3, %xmm1\n    paddusb %xmm5, %xmm2\n    movdqu %xmm1, (%r10,%r11)\n    movdqu %xmm2, (%rax)\n"
## p1' (or q1') where the side's mask m holds: clip3(s1 - tC0, s1 + tC0, (s2 + ((p0 + q0 + 1) >> 1)) >> 1), with s2, s1
## and m the spill offsets of the side's rows and mask; the row goes to dst
fn rw_dbk_side(s2, s1, m, dst) = "    movdqu 176(%rdx), %xmm0\n    movdqu 192(%rdx), %xmm6\n    pavgb %xmm6, %xmm0\n    movdqu " + s2 + "(%rdx), %xmm1\n    movdqu %xmm1, %xmm2\n    pxor %xmm0, %xmm2\n    movdqu 288(%rdx), %xmm6\n    pand %xmm6, %xmm2\n    pavgb %xmm0, %xmm1\n    psubb %xmm2, %xmm1\n    movdqu " + s1 + "(%rdx), %xmm3\n    movdqu %xmm3, %xmm4\n    movdqu 32(%rdx), %xmm6\n    psubusb %xmm6, %xmm4\n    pmaxub %xmm4, %xmm1\n    movdqu %xmm3, %xmm4\n    movdqu 32(%rdx), %xmm6\n    paddusb %xmm6, %xmm4\n    pminub %xmm4, %xmm1\n    movdqu " + m + "(%rdx), %xmm4\n    pand %xmm4, %xmm1\n    pandn %xmm3, %xmm4\n    por %xmm4, %xmm1\n    movdqu %xmm1, " + dst + "\n"
## the masks of 16 lanes (M at 80, ap at 128, aq at 144 and in xmm4; P2 96, Q2 112, P0 176, Q0 192, P1 208, Q1 224): rows P2 (%r10), P1 (%r10,%rcx), P0 (%r10,%r11), Q0 (%rax), Q1 (%rax,%rcx), Q2 (%rax,%r11)
## with %rax the q0 row, %rcx the row step, %rdx the block (vectors ready); r11 = 2 s
fn rw_dbk_masks() = "    movq %rcx, %r11\n    addq %rcx, %r11\n    movq %rax, %r10\n    subq %r11, %r10\n    subq %rcx, %r10\n    movdqu (%r10,%r11), %xmm0\n    movdqu (%rax), %xmm1\n    movdqu (%r10,%rcx), %xmm2\n    movdqu (%rax,%rcx), %xmm3\n    movdqu %xmm0, 176(%rdx)\n    movdqu %xmm1, 192(%rdx)\n    movdqu %xmm2, 208(%rdx)\n    movdqu %xmm3, 224(%rdx)\n" + rw_dbk_fail("%xmm0", "%xmm1", "0(%rdx)") + "    movdqu %xmm4, 80(%rdx)\n" + rw_dbk_fail("%xmm2", "%xmm0", "16(%rdx)") + "    movdqu 80(%rdx), %xmm6\n    por %xmm6, %xmm4\n    movdqu %xmm4, 80(%rdx)\n" + rw_dbk_fail("%xmm3", "%xmm1", "16(%rdx)") + "    movdqu 80(%rdx), %xmm6\n    por %xmm6, %xmm4\n    movdqu 48(%rdx), %xmm5\n    pandn %xmm5, %xmm4\n    movdqu %xmm4, 80(%rdx)\n" + "    movdqu (%r10), %xmm2\n    movdqu %xmm2, 96(%rdx)\n" + rw_dbk_fail("%xmm2", "176(%rdx)", "16(%rdx)") + "    movdqu 80(%rdx), %xmm5\n    pandn %xmm5, %xmm4\n    movdqu 64(%rdx), %xmm6\n    pand %xmm6, %xmm4\n    movdqu %xmm4, 128(%rdx)\n" + "    movdqu (%rax,%r11), %xmm2\n    movdqu %xmm2, 112(%rdx)\n" + rw_dbk_fail("%xmm2", "192(%rdx)", "16(%rdx)") + "    movdqu 80(%rdx), %xmm5\n    pandn %xmm5, %xmm4\n    movdqu 64(%rdx), %xmm6\n    pand %xmm6, %xmm4\n    movdqu %xmm4, 144(%rdx)\n"
## the bS < 4 filter: tC = tC0 + ap + aq (bytes), p0 / q0, then p1 / q1
## the deblocking intrinsics load every memory operand with movdqu into %xmm6 first: a legacy SSE2 operation with a
## memory operand needs a 16-byte aligned address, and the codec scratch is aligned in ELF but not in PE (lasm lays
## out .bss exactly as the frozen seed assembler does, so it cannot align it); %xmm6 is free in these routines
fn rw_dbk_core() = rw_dbk_masks() + "    movdqu 32(%rdx), %xmm5\n    movdqu 128(%rdx), %xmm6\n    psubb %xmm6, %xmm5\n    psubb %xmm4, %xmm5\n    movdqu %xmm5, 160(%rdx)\n" + rw_dbk_p0q0() + rw_dbk_side("96", "208", "128", "(%r10,%rcx)") + rw_dbk_side("112", "224", "144", "(%rax,%rcx)")
fn rw_dbk16_asm() = rw_dbk_push() + "    movq 72(%rsp), %r8\n    movq 64(%rsp), %r9\n    movq 56(%rsp), %rdx\n" + rw_dbk_vecs() + "    movq 88(%rsp), %rax\n    movq 80(%rsp), %rcx\n" + rw_dbk_core() + rw_dbk_pop(5)
## 8 lines of 8 bytes from %rsi (q0 - 4 of each line, %rdi apart) transposed: columns 0/1 in xmm0, 2/3 in xmm1, 4/5 in
## xmm4, 6/7 in xmm3 (low half the even column)
fn rw_dbk_ld(x) = "    movq (%rsi), %rax\n    movq %rax, " + x + "\n    addq %rdi, %rsi\n"
fn rw_dbk_tr() = rw_dbk_ld("%xmm0") + rw_dbk_ld("%xmm1") + "    punpcklbw %xmm1, %xmm0\n" + rw_dbk_ld("%xmm1") + rw_dbk_ld("%xmm2") + "    punpcklbw %xmm2, %xmm1\n" + rw_dbk_ld("%xmm2") + rw_dbk_ld("%xmm3") + "    punpcklbw %xmm3, %xmm2\n" + rw_dbk_ld("%xmm3") + rw_dbk_ld("%xmm4") + "    punpcklbw %xmm4, %xmm3\n" + "    movdqu %xmm0, %xmm4\n    punpcklwd %xmm1, %xmm0\n    punpckhwd %xmm1, %xmm4\n    movdqu %xmm2, %xmm5\n    punpcklwd %xmm3, %xmm2\n    punpckhwd %xmm3, %xmm5\n    movdqu %xmm0, %xmm1\n    punpckldq %xmm2, %xmm0\n    punpckhdq %xmm2, %xmm1\n    movdqu %xmm4, %xmm3\n    punpckldq %xmm5, %xmm4\n    punpckhdq %xmm5, %xmm3\n"
## the first half's pair of columns at o joined with the second half's (in x): rows r and r + 1 of the block
fn rw_dbk_join(o, x, r) = "    movdqu " + str(o) + "(%rdx), %xmm2\n    movdqu %xmm2, %xmm5\n    punpcklqdq " + x + ", %xmm2\n    punpckhqdq " + x + ", %xmm5\n    movdqu %xmm2, " + str(320 + 16 * r) + "(%rdx)\n    movdqu %xmm5, " + str(336 + 16 * r) + "(%rdx)\n"
## four lines' (p1 p0 q0 q1) dwords from x to %r10, %r10 + %rcx, ...
fn rw_dbk_st4(x) = "    movq " + x + ", %rax\n    movl %eax, (%r10)\n    addq %rcx, %r10\n    shrq $32, %rax\n    movl %eax, (%r10)\n    addq %rcx, %r10\n    psrldq $8, " + x + "\n    movq " + x + ", %rax\n    movl %eax, (%r10)\n    addq %rcx, %r10\n    shrq $32, %rax\n    movl %eax, (%r10)\n    addq %rcx, %r10\n"
fn rw_dbkv_asm() = rw_dbk_push() + "    movq 72(%rsp), %r8\n    movq 64(%rsp), %r9\n    movq 56(%rsp), %rdx\n" + rw_dbk_vecs() + "    movq 96(%rsp), %rsi\n    subq $4, %rsi\n    movq 80(%rsp), %rdi\n" + rw_dbk_tr() + "    movdqu %xmm0, 448(%rdx)\n    movdqu %xmm1, 464(%rdx)\n    movdqu %xmm4, 480(%rdx)\n    movdqu %xmm3, 496(%rdx)\n    movq 88(%rsp), %rsi\n    subq $4, %rsi\n" + rw_dbk_tr() + rw_dbk_join(448, "%xmm0", 0) + rw_dbk_join(464, "%xmm1", 2) + rw_dbk_join(480, "%xmm4", 4) + rw_dbk_join(496, "%xmm3", 6) + "    movq %rdx, %rax\n    addq $384, %rax\n    movq $16, %rcx\n" + rw_dbk_core() + "    movdqu 352(%rdx), %xmm0\n    movdqu 368(%rdx), %xmm1\n    movdqu %xmm0, %xmm2\n    punpcklbw %xmm1, %xmm2\n    punpckhbw %xmm1, %xmm0\n    movdqu 384(%rdx), %xmm1\n    movdqu 400(%rdx), %xmm3\n    movdqu %xmm1, %xmm4\n    punpcklbw %xmm3, %xmm4\n    punpckhbw %xmm3, %xmm1\n    movq 80(%rsp), %rcx\n    movq 88(%rsp), %r10\n    subq $2, %r10\n    movdqu %xmm0, %xmm5\n    punpcklwd %xmm1, %xmm5\n    punpckhwd %xmm1, %xmm0\n" + rw_dbk_st4("%xmm5") + rw_dbk_st4("%xmm0") + "    movq 96(%rsp), %r10\n    subq $2, %r10\n    movdqu %xmm2, %xmm5\n    punpcklwd %xmm4, %xmm5\n    punpckhwd %xmm4, %xmm2\n" + rw_dbk_st4("%xmm5") + rw_dbk_st4("%xmm2") + rw_dbk_pop(6)
## row r (-2 .. 1) of both planes: 8 bytes from %rsi + r s and %rdi + r s (r8 = s) joined into block row 4 + r
fn rw_dbk_off(r) = if r == 1 then "    movq %r8, %rax\n" else if r == 0 then "    xorq %rax, %rax\n" else if r == 0 - 1 then "    xorq %rax, %rax\n    subq %r8, %rax\n" else "    xorq %rax, %rax\n    subq %r8, %rax\n    subq %r8, %rax\n"
fn rw_dbk_row(r) = rw_dbk_off(r) + "    movq (%rsi,%rax), %rcx\n    movq %rcx, %xmm0\n    movq (%rdi,%rax), %rcx\n    movq %rcx, %xmm1\n    punpcklqdq %xmm1, %xmm0\n    movdqu %xmm0, " + str(384 + 16 * r) + "(%rdx)\n"
fn rw_dbkh2_asm() = rw_dbk_push() + "    movq 72(%rsp), %r8\n    movq 64(%rsp), %r9\n    movq 56(%rsp), %rdx\n" + rw_dbk_vecs() + "    movq 96(%rsp), %rsi\n    movq 88(%rsp), %rdi\n    movq 80(%rsp), %r8\n" + rw_dbk_row(0 - 2) + rw_dbk_row(0 - 1) + rw_dbk_row(0) + rw_dbk_row(1) + "    movq %rdx, %rax\n    addq $384, %rax\n    movq $16, %rcx\n" + rw_dbk_core() + "    movq %rdi, %rax\n    subq %r8, %rax\n    movq 376(%rdx), %rcx\n    movq %rcx, (%rax)\n    movq 392(%rdx), %rcx\n    movq %rcx, (%rdi)\n    movq %rsi, %rax\n    subq %r8, %rax\n    movq 368(%rdx), %rcx\n    movq %rcx, (%rax)\n    movq 384(%rdx), %rcx\n    movq %rcx, (%rsi)\n" + rw_dbk_pop(6)
## the bS = 4 filter (8.7.2.4) on the same 16 lanes: the masks of rw_dbk_core, then per half the sums in words (rows
## unpacked to scr + 1152 .. 1279, constants 2 / 4 at 1056 / 1072, low-half results at 1280 .. 1407), packed into the
## byte results at 1408 .. 1535 and chosen per lane: p0..p2 (q0..q2) from the strong sums where ap (aq) and
## |p0 - q0| < (alpha >> 2) + 2 hold, else p0 (q0) from (2 p1 + p0 + q1 + 2) >> 2 where the line is filtered at all
## (chroma: luma mask 0, so always the latter). P3 / Q3 rows are read from (%r10) - s and (%rax,%r11) + s.
fn rw_dbks_unp(row, o, u) = "    movdqu " + row + ", %xmm0\n    " + u + " %xmm5, %xmm0\n    movdqu %xmm0, " + str(o) + "(%rdx)\n"
## one side's four results of one half as words into xmm1 (s1'), xmm2 (s0'), xmm3 (s2'), xmm4 (weak s0'); w0..w3 the
## side's unpacked rows s0..s3, o0, o1 the other side's first two
fn rw_dbks_side(w0, w1, w2, w3, o0, o1) = "    movdqu " + w2 + "(%rdx), %xmm0\n    movdqu " + w1 + "(%rdx), %xmm6\n    paddw %xmm6, %xmm0\n    movdqu " + w0 + "(%rdx), %xmm6\n    paddw %xmm6, %xmm0\n    movdqu " + o0 + "(%rdx), %xmm6\n    paddw %xmm6, %xmm0\n    movdqu %xmm0, %xmm1\n    movdqu 1056(%rdx), %xmm6\n    paddw %xmm6, %xmm1\n    psraw $2, %xmm1\n    movdqu %xmm0, %xmm2\n    movdqu " + w1 + "(%rdx), %xmm6\n    paddw %xmm6, %xmm2\n    movdqu " + w0 + "(%rdx), %xmm6\n    paddw %xmm6, %xmm2\n    movdqu " + o0 + "(%rdx), %xmm6\n    paddw %xmm6, %xmm2\n    movdqu " + o1 + "(%rdx), %xmm6\n    paddw %xmm6, %xmm2\n    movdqu 1072(%rdx), %xmm6\n    paddw %xmm6, %xmm2\n    psraw $3, %xmm2\n    movdqu " + w3 + "(%rdx), %xmm3\n    movdqu " + w2 + "(%rdx), %xmm6\n    paddw %xmm6, %xmm3\n    paddw %xmm3, %xmm3\n    paddw %xmm0, %xmm3\n    movdqu 1072(%rdx), %xmm6\n    paddw %xmm6, %xmm3\n    psraw $3, %xmm3\n    movdqu " + w1 + "(%rdx), %xmm4\n    paddw %xmm4, %xmm4\n    movdqu " + w0 + "(%rdx), %xmm6\n    paddw %xmm6, %xmm4\n    movdqu " + o1 + "(%rdx), %xmm6\n    paddw %xmm6, %xmm4\n    movdqu 1056(%rdx), %xmm6\n    paddw %xmm6, %xmm4\n    psraw $2, %xmm4\n"
## the four word results of a half: kept (low half, at base) or packed with the kept ones into bytes (high half)
fn rw_dbks_keep(base) = "    movdqu %xmm1, " + str(base) + "(%rdx)\n    movdqu %xmm2, " + str(base + 16) + "(%rdx)\n    movdqu %xmm3, " + str(base + 32) + "(%rdx)\n    movdqu %xmm4, " + str(base + 48) + "(%rdx)\n"
fn rw_dbks_pack(lo, out) = "    movdqu " + str(lo) + "(%rdx), %xmm0\n    packuswb %xmm1, %xmm0\n    movdqu %xmm0, " + str(out) + "(%rdx)\n    movdqu " + str(lo + 16) + "(%rdx), %xmm0\n    packuswb %xmm2, %xmm0\n    movdqu %xmm0, " + str(out + 16) + "(%rdx)\n    movdqu " + str(lo + 32) + "(%rdx), %xmm0\n    packuswb %xmm3, %xmm0\n    movdqu %xmm0, " + str(out + 32) + "(%rdx)\n    movdqu " + str(lo + 48) + "(%rdx), %xmm0\n    packuswb %xmm4, %xmm0\n    movdqu %xmm0, " + str(out + 48) + "(%rdx)\n"
## one half (u = punpcklbw / punpckhbw): rows to words (P3 1152, P2 1168, P1 1184, P0 1200, Q0 1216, Q1 1232, Q2 1248,
## Q3 1264), both sides' results kept (low) or packed (high: p at 1408, q at 1472; s1', s0', s2', weak s0')
fn rw_dbks_half(u, hi) = "    pxor %xmm5, %xmm5\n" + rw_dbks_unp("1024(%rdx)", 1152, u) + rw_dbks_unp("96(%rdx)", 1168, u) + rw_dbks_unp("208(%rdx)", 1184, u) + rw_dbks_unp("176(%rdx)", 1200, u) + rw_dbks_unp("192(%rdx)", 1216, u) + rw_dbks_unp("224(%rdx)", 1232, u) + rw_dbks_unp("112(%rdx)", 1248, u) + rw_dbks_unp("1040(%rdx)", 1264, u) + rw_dbks_side("1200", "1184", "1168", "1152", "1216", "1232") + (if hi == 0 then rw_dbks_keep(1280) else rw_dbks_pack(1280, 1408)) + rw_dbks_side("1216", "1232", "1248", "1264", "1200", "1184") + (if hi == 0 then rw_dbks_keep(1344) else rw_dbks_pack(1344, 1472))
## lane choice for one side: m the side's strong mask (in xmm5), r the results base, s0..s2 the side's original row
## spills, d0..d2 the destination rows
fn rw_dbks_pick(r, s0, s1, s2, d0, d1, d2) = "    movdqu 80(%rdx), %xmm0\n    movdqu %xmm0, %xmm1\n    movdqu " + str(r + 48) + "(%rdx), %xmm6\n    pand %xmm6, %xmm1\n    movdqu " + s0 + "(%rdx), %xmm6\n    pandn %xmm6, %xmm0\n    por %xmm1, %xmm0\n    movdqu %xmm5, %xmm1\n    movdqu " + str(r + 16) + "(%rdx), %xmm6\n    pand %xmm6, %xmm1\n    movdqu %xmm5, %xmm2\n    pandn %xmm0, %xmm2\n    por %xmm2, %xmm1\n    movdqu %xmm1, " + d0 + "\n    movdqu %xmm5, %xmm1\n    movdqu " + str(r) + "(%rdx), %xmm6\n    pand %xmm6, %xmm1\n    movdqu %xmm5, %xmm2\n    movdqu " + s1 + "(%rdx), %xmm6\n    pandn %xmm6, %xmm2\n    por %xmm2, %xmm1\n    movdqu %xmm1, " + d1 + "\n    movdqu %xmm5, %xmm1\n    movdqu " + str(r + 32) + "(%rdx), %xmm6\n    pand %xmm6, %xmm1\n    movdqu %xmm5, %xmm2\n    movdqu " + s2 + "(%rdx), %xmm6\n    pandn %xmm6, %xmm2\n    por %xmm2, %xmm1\n    movdqu %xmm1, " + d2 + "\n"
## the strong core: the masks of the weak one (rw_dbk_masks), sm = |p0 - q0| < (alpha >> 2) + 2 (vector at 304), sp =
## ap & sm, sq = aq & sm; constants; both halves; the choice written to the rows
fn rw_dbks_core() = rw_dbk_masks() + "    movq %r10, %rsi\n    subq %rcx, %rsi\n    movdqu (%rsi), %xmm0\n    movdqu %xmm0, 1024(%rdx)\n    movq %rax, %rsi\n    addq %r11, %rsi\n    addq %rcx, %rsi\n    movdqu (%rsi), %xmm0\n    movdqu %xmm0, 1040(%rdx)\n    movdqu 176(%rdx), %xmm0\n" + rw_dbk_fail("%xmm0", "192(%rdx)", "304(%rdx)") + "    movdqu %xmm4, %xmm5\n    movdqu 128(%rdx), %xmm0\n    pandn %xmm0, %xmm4\n    movdqu %xmm4, 128(%rdx)\n    movdqu 144(%rdx), %xmm0\n    pandn %xmm0, %xmm5\n    movdqu %xmm5, 144(%rdx)\n    pcmpeqw %xmm0, %xmm0\n    pxor %xmm1, %xmm1\n    psubw %xmm0, %xmm1\n    paddw %xmm1, %xmm1\n    movdqu %xmm1, 1056(%rdx)\n    paddw %xmm1, %xmm1\n    movdqu %xmm1, 1072(%rdx)\n" + rw_dbks_half("punpcklbw", 0) + rw_dbks_half("punpckhbw", 1) + "    movdqu 128(%rdx), %xmm5\n" + rw_dbks_pick(1408, "176", "208", "96", "(%r10,%r11)", "(%r10,%rcx)", "(%r10)") + "    movdqu 144(%rdx), %xmm5\n" + rw_dbks_pick(1472, "192", "224", "112", "(%rax)", "(%rax,%rcx)", "(%rax,%r11)")
## the strong filter's vectors: those of rw_dbk_vecs plus (alpha >> 2) + 2 from ab bits 24..31 at 304
fn rw_dbks_vecs() = rw_dbk_vecs() + "    movq %r8, %rax\n    shrq $24, %rax\n    andq $255, %rax\n    movq %rax, %xmm0\n    punpcklbw %xmm0, %xmm0\n    pshuflw $0, %xmm0, %xmm0\n    punpcklqdq %xmm0, %xmm0\n    movdqu %xmm0, 304(%rdx)\n"
## eight lines' 8 bytes (two per x: low then high half) to %r10, %r10 + %rcx, ...
fn rw_dbk_st8(x) = "    movq " + x + ", %rax\n    movq %rax, (%r10)\n    addq %rcx, %r10\n    psrldq $8, " + x + "\n    movq " + x + ", %rax\n    movq %rax, (%r10)\n    addq %rcx, %r10\n"
## vec_dbk16s / vec_dbkvs / vec_dbkh2s: the arguments of vec_dbk16 / vec_dbkv / vec_dbkh2 with ab + ((alpha >> 2) + 2) 2^24
## and tcw only telling which pairs of lines to filter (255: not); the vertical one writes the 8 columns back (p2 / q2
## change too) through two transposes, lines 8..15 first
fn rw_dbk16s_asm() = rw_dbk_push() + "    movq 72(%rsp), %r8\n    movq 64(%rsp), %r9\n    movq 56(%rsp), %rdx\n" + rw_dbks_vecs() + "    movq 88(%rsp), %rax\n    movq 80(%rsp), %rcx\n" + rw_dbks_core() + rw_dbk_pop(5)
fn rw_dbkvs_asm() = rw_dbk_push() + "    movq 72(%rsp), %r8\n    movq 64(%rsp), %r9\n    movq 56(%rsp), %rdx\n" + rw_dbks_vecs() + "    movq 96(%rsp), %rsi\n    subq $4, %rsi\n    movq 80(%rsp), %rdi\n" + rw_dbk_tr() + "    movdqu %xmm0, 448(%rdx)\n    movdqu %xmm1, 464(%rdx)\n    movdqu %xmm4, 480(%rdx)\n    movdqu %xmm3, 496(%rdx)\n    movq 88(%rsp), %rsi\n    subq $4, %rsi\n" + rw_dbk_tr() + rw_dbk_join(448, "%xmm0", 0) + rw_dbk_join(464, "%xmm1", 2) + rw_dbk_join(480, "%xmm4", 4) + rw_dbk_join(496, "%xmm3", 6) + "    movq %rdx, %rax\n    addq $384, %rax\n    movq $16, %rcx\n" + rw_dbks_core() + "    movq %rdx, %rsi\n    addq $328, %rsi\n    movq $16, %rdi\n" + rw_dbk_tr() + "    movq 80(%rsp), %rcx\n    movq 88(%rsp), %r10\n    subq $4, %r10\n" + rw_dbk_st8("%xmm0") + rw_dbk_st8("%xmm1") + rw_dbk_st8("%xmm4") + rw_dbk_st8("%xmm3") + "    movq %rdx, %rsi\n    addq $320, %rsi\n    movq $16, %rdi\n" + rw_dbk_tr() + "    movq 80(%rsp), %rcx\n    movq 96(%rsp), %r10\n    subq $4, %r10\n" + rw_dbk_st8("%xmm0") + rw_dbk_st8("%xmm1") + rw_dbk_st8("%xmm4") + rw_dbk_st8("%xmm3") + rw_dbk_pop(6)
fn rw_dbkh2s_asm() = rw_dbk_push() + "    movq 72(%rsp), %r8\n    movq 64(%rsp), %r9\n    movq 56(%rsp), %rdx\n" + rw_dbks_vecs() + "    movq 96(%rsp), %rsi\n    movq 88(%rsp), %rdi\n    movq 80(%rsp), %r8\n" + rw_dbk_row(0 - 2) + rw_dbk_row(0 - 1) + rw_dbk_row(0) + rw_dbk_row(1) + "    movq %rdx, %rax\n    addq $384, %rax\n    movq $16, %rcx\n" + rw_dbks_core() + "    movq 96(%rsp), %rsi\n    movq 88(%rsp), %rdi\n    movq 80(%rsp), %r8\n    movq %rdi, %rax\n    subq %r8, %rax\n    movq 376(%rdx), %rcx\n    movq %rcx, (%rax)\n    movq 392(%rdx), %rcx\n    movq %rcx, (%rdi)\n    movq %rsi, %rax\n    subq %r8, %rax\n    movq 368(%rdx), %rcx\n    movq %rcx, (%rax)\n    movq 384(%rdx), %rcx\n    movq %rcx, (%rsi)\n" + rw_dbk_pop(6)
fn rw_mem(g) = g == "load8" or g == "load32" or g == "load64" or g == "store8" or g == "store32" or g == "store64"
## a load from an address a register already holds (a parameter or let of a leaf routine): no copy to %rax first
## `load8(b + d + x)` / `load64(b + d + x)` with b in a register and d a small literal: x is computed into %rax and the
## load uses the d(b,%rax) addressing form, as hand-written assembly does (no add chain)
fn rw_idxbase(e, env) = match e
    Bin(op, l, x) => if op == "+" then rw_idxb2(l, env) else ""
    _             => ""
fn rw_idxb2(l, env) = match l
    Bin(op, b, d) => if op == "+" and rw_immval(d) >= 0 and rw_immval(d) < 4096 then rw_regof(b, env) else ""
    _             => ""
fn rw_idxdisp(e) = match e
    Bin(op, l, x) => rw_idxd2(l)
    _             => 0
fn rw_idxd2(l) = match l
    Bin(op, b, d) => rw_immval(d)
    _             => 0
fn rw_idxrest(e) = match e
    Bin(op, l, x) => x
    _             => e
fn rw_loadx(g, d, reg) = (if g == "load8" then "    movzbq " else "    movq ") + str(d) + "(" + reg + ",%rax), %rax\n"
fn rw_loadr(g, reg) = if g == "load8" then "    movzbq (" + reg + "), %rax\n" else if g == "load32" then "    movl (" + reg + "), %eax\n" else "    movq (" + reg + "), %rax\n"
fn rw_memop(g) = if g == "load8" then "    movzbq (%rax), %rax\n" else if g == "load32" then "    movl (%rax), %eax\n" else if g == "load64" then "    movq (%rax), %rax\n" else if g == "store8" then "    movb %cl, (%rax)\n    xorq %rax, %rax\n" else if g == "store32" then "    movl %ecx, (%rax)\n    xorq %rax, %rax\n" else "    movq %rcx, (%rax)\n    xorq %rax, %rax\n"
fn rw_bitop(g) = if g == "bit_and" then "    andq %rcx, %rax\n" else if g == "bit_or" then "    orq %rcx, %rax\n" else if g == "bit_xor" then "    xorq %rcx, %rax\n" else if g == "bit_shl" then "    salq %cl, %rax\n" else "    sarq %cl, %rax\n"
fn rw_isbit(g) = g == "bit_and" or g == "bit_or" or g == "bit_xor" or g == "bit_shl" or g == "bit_shr"
## sym_addr("name"): the address of a runtime symbol (a .bss word, a buffer, a table); the name must be a literal
## made of letters, digits, `_` and `.`
fn rw_symname(e, st) = match e
    Str(v) => if count(v) > 0 and rw_symok(v, 0) == 1 then v else ctfail("lume --raw: sym_addr needs a symbol name, not '" + v + "' (in '" + st.f + "')\n")
    _      => ctfail("lume --raw: sym_addr takes a string literal (in '" + st.f + "')\n")
fn rw_symok(v, i) = if i >= count(v) then 1 else let c = ord_at(v, i) in if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c == 46 then rw_symok(v, i + 1) else 0
## a simple argument (a literal or a local) as an operand, else "": it needs no stack slot, it is loaded straight
## into its register after the other arguments are popped (it reads only an immediate or the frame)
fn rw_simple(e, env) = match e
    Num(v) => "$" + str(v)
    Var(x) => let o = rw_slot(env, x) in if o == 0 then "" else rw_loc(o)
    _      => ""
## the complex arguments, left to right, each pushed
fn rw_pushc(args, env, st) = match args
    Nil        => rw_r("", st)
    Cons(h, t) => if rw_simple(h, env) != "" then rw_pushc(t, env, st) else let r1 = rw_e(h, env, st, 0) in let r2 = rw_pushc(t, env, r1) in rw_r(r1.code + "    pushq %rax\n" + r2.code, r2)
## into the registers regs: from the last argument back, a complex one popped, a simple one moved
fn rw_popc(args, regs, env) = rw_popc_go(rw_revl(args, Nil), rw_revl(rw_takel(regs, rw_len(args)), Nil), env)
fn rw_popc_go(xas, rs, env) = match xas
    Nil        => ""
    Cons(a, t) => let s = rw_simple(a, env) in (if s != "" then "    movq " + s + ", " + rw_nth(rs, 0) + "\n" else "    popq " + rw_nth(rs, 0) + "\n") + rw_popc_go(t, rw_dropl(rs), env)
fn rw_revl(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => rw_revl(t, Cons(h, acc))
fn rw_takel(xs, k) = match xs
    Nil        => Nil
    Cons(h, t) => if k <= 0 then Nil else Cons(h, rw_takel(t, k - 1))
fn rw_dropl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => t
## mkint(v) inline: the immediate 2v + 1, and the runtime's mkint (a boxed cell) only when 2v overflows
fn rw_mkint(r, st) = let k = st.n in if rw_isleaf(st.f) then rw_r(r.code + "    movq %rax, %rcx\n    addq %rax, %rax\n    jo " + rw_lab(st, k) + "m\n    incq %rax\n    jmp " + rw_lab(st, k) + "k\n" + rw_lab(st, k) + "m:\n    pushq %rdi\n    pushq %rsi\n    pushq %rdx\n    pushq %r8\n    pushq %r9\n    pushq %r10\n    pushq %r11\n    movq %rcx, %rdi\n    call mkint\n    popq %r11\n    popq %r10\n    popq %r9\n    popq %r8\n    popq %rdx\n    popq %rsi\n    popq %rdi\n" + rw_lab(st, k) + "k:\n", r) else rw_r(r.code + "    movq %rax, %rdi\n    addq %rax, %rax\n    jo " + rw_lab(st, k) + "m\n    incq %rax\n    jmp " + rw_lab(st, k) + "k\n" + rw_lab(st, k) + "m:\n    call mkint\n" + rw_lab(st, k) + "k:\n", r)
## bit_and/or/xor/shl/shr(a, src) with src from rw_imm: the operation straight on %rax; a literal shift count is an
## immediate, a variable one goes through %cl
## two arguments for an operation that takes the first in %rax and the second in %rcx (as rw_push + pop %rcx, %rax)
fn rw_twoop(args, env, st, op) = let ra = rw_e(rw_nth(args, 0), env, st, 0) in let rb = rw_e(rw_nth(args, 1), env, ra, 0) in rw_r(ra.code + rw_two(rb.code, rw_tmpe(rb.code, st, env)) + op, rb)
## (no xchg: the frozen seed assembler, which must assemble the same text, does not know it)
fn rw_two(bcode, t) = if t != "" then "    movq %rax, " + t + "\n" + bcode + "    movq %rax, %rcx\n    movq " + t + ", %rax\n" else if rw_rcxfree(bcode) then "    movq %rax, %rcx\n" + bcode + "    pushq %rcx\n    movq %rax, %rcx\n    popq %rax\n" else "    pushq %rax\n" + bcode + "    movq %rax, %rcx\n    popq %rax\n"
fn rw_bitimm(g, a, src, env, st) = let ra = rw_e(a, env, st, 0) in rw_r(ra.code + rw_bitsrc(g, src), ra)
fn rw_bitsrc(g, src) = if g == "bit_shl" or g == "bit_shr" then (if slice(src, 0, 1) == "$" then "    " + (if g == "bit_shl" then "salq " else "sarq ") + src + ", %rax\n" else "    movq " + src + ", %rcx\n" + rw_bitop(g)) else if rw_isslot(src) then "    movq " + src + ", %rcx\n" + rw_bitop(g) else "    " + (if g == "bit_and" then "andq " else if g == "bit_or" then "orq " else "xorq ") + src + ", %rax\n"
## a call inside a leaf routine (rw_leafok allows a few): in tail position the arguments go to their registers and
## the routine jumps (it has no frame to drop); elsewhere the registers that hold its parameters and lets are
## pushed around the call (seven pushes keep the stack 16-byte aligned at the call)
## the arguments a leaf call pushed, popped into their registers (last first): every argument is pushed, because a
## leaf keeps its own parameters in those registers and a register-to-register move could overwrite one still needed
fn rw_popn(n) = if n <= 0 then "" else "    popq " + rw_nth(rw_regs(), n - 1) + "\n" + rw_popn(n - 1)
## a call of n > 6 arguments: all are computed left to right and pushed; the words of the 7th .. nth are put in the
## order System V wants (the 7th lowest), the first six are loaded into their registers, and after the call the n
## words go. The comment #rwbig keeps the routine out of leaf mode (a leaf has no frame to read such arguments).
fn rw_bigcall(g, args, env, st) = let n = rw_len(args) in let r = rw_push(args, env, st) in rw_r("    #rwbig\n" + r.code + rw_bigrev(0, n - 7) + rw_bigregs(0, n - 6) + "    call " + g + "\n    addq $" + str(8 * n) + ", %rsp\n", r)
fn rw_bigrev(i, j) = if i >= j then "" else "    movq " + str(8 * i) + "(%rsp), %rax\n    movq " + str(8 * j) + "(%rsp), %rcx\n    movq %rcx, " + str(8 * i) + "(%rsp)\n    movq %rax, " + str(8 * j) + "(%rsp)\n" + rw_bigrev(i + 1, j - 1)
fn rw_bigregs(idx, k) = if idx >= 6 then "" else "    movq " + str(8 * (k + 5 - idx)) + "(%rsp), " + rw_nth(rw_regs(), idx) + "\n" + rw_bigregs(idx + 1, k)
## a call inside a leaf saves only the registers the leaf holds values in: its parameters (rdi, rsi, rdx, r10, r8,
## r9) and the lets allocated so far (r11, then r10); an even count gets an 8-byte pad, so the stack keeps the
## alignment the seven saves gave (rsp a multiple of 16 at the call)
fn rw_lfregs(np, nl) = rw_lfp(0, np, if nl >= 2 then Cons("%r11", Cons("%r10", Nil)) else if nl >= 1 then Cons("%r11", Nil) else Nil)
fn rw_lfp(i, np, acc) = if i >= np then acc else Cons(rw_nth(Cons("%rdi", Cons("%rsi", Cons("%rdx", Cons("%r10", Cons("%r8", Cons("%r9", Nil)))))), i), rw_lfp(i + 1, np, acc))
fn rw_lfpush(rs) = match rs
    Nil        => ""
    Cons(h, t) => "    pushq " + h + "\n" + rw_lfpush(t)
fn rw_lfpop(rs) = match rs
    Nil        => ""
    Cons(h, t) => rw_lfpop(t) + "    popq " + h + "\n"
fn rw_lfpad(rs) = if rw_len(rs) % 2 == 0 then "    subq $8, %rsp\n" else ""
fn rw_lfunpad(rs) = if rw_len(rs) % 2 == 0 then "    addq $8, %rsp\n" else ""
fn rw_leafcall(g, args, env, st, tail) = let r = rw_push(args, env, st) in if tail == 1 then rw_r(r.code + rw_popn(rw_len(args)) + "    jmp " + g + "\n", r) else (let rs = rw_lfregs(st.np, st.nl) in rw_r(rw_lfpush(rs) + rw_lfpad(rs) + r.code + rw_popn(rw_len(args)) + "    call " + g + "\n" + rw_lfunpad(rs) + rw_lfpop(rs), r))
## frame_ptr() is the routine's own %rbp (its caller's %rbp is load64(frame_ptr()), its return address
## load64(frame_ptr() + 8), the caller's %rsp after the return frame_ptr() + 16); a routine that uses it keeps its
## frame (never a leaf). long_jump(sp, fp, addr, v) sets %rsp and %rbp, puts v in %rax and jumps to addr: the
## other half of a saved frame (try / fail), it never returns. The jump is `pushq; ret` because the frozen seed
## assembler (bootstrap/lume0/elf.c), which assembles this runtime too, has no indirect jmp.
## --- floating point for the runtime (f64 in Lume): IEEE doubles travel as their 64 bits in general registers; the
## x87 values of extended precision (the text <-> double conversions need them) live in 16-byte slots in memory and
## every x87 intrinsic loads, works and stores (fldt / fstpt), so no x87 register is held across Lume code.
##   fp_add / fp_sub / fp_mul / fp_div (a, b), fp_sqrt(a), fp_of_int(i), fp_trunc(a) -> int, fp_cmp(a, b) -> -1 0 1, 2 when
##   unordered (a NaN); x87_ldi(d, i), x87_ldd(d, bits), x87_std(s) -> bits, x87_sti(s) -> int (rounding: the control word),
##   x87_add / x87_sub / x87_mul / x87_div (d, a, b), x87_rnd(d, a), x87_yl2x(d, y, x) = y * log2 x, x87_f2xm1(d, a), x87_scale(d,
##   a, b) = a * 2^trunc(b), x87_sin / x87_cos / x87_tan (d, a), x87_atan2(d, y, x), x87_const(d, k) (0 zero, 1 one, 2 log2 e,
##   3 log10 2, 4 ln 2), x87_getcw() and x87_setcw(cw)
fn rw_isfp(g) = rw_kin(g, Cons("fp_add", Cons("fp_sub", Cons("fp_mul", Cons("fp_div", Cons("fp_sqrt", Cons("fp_of_int", Cons("fp_trunc", Cons("fp_cmp", Cons("x87_ldi", Cons("x87_ldd", Cons("x87_std", Cons("x87_sti", Cons("x87_add", Cons("x87_sub", Cons("x87_mul", Cons("x87_div", Cons("x87_rnd", Cons("x87_yl2x", Cons("x87_f2xm1", Cons("x87_scale", Cons("x87_sin", Cons("x87_cos", Cons("x87_tan", Cons("x87_atan2", Cons("x87_const", Cons("x87_getcw", Cons("x87_setcw", Nil))))))))))))))))))))))))))))
fn rw_kin(g, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == g then 1 else rw_kin(g, t)
fn rw_fparity(g) = if g == "fp_sqrt" or g == "fp_of_int" or g == "fp_trunc" or g == "x87_std" or g == "x87_sti" or g == "x87_setcw" then 1 else if g == "x87_getcw" then 0 else if g == "x87_add" or g == "x87_sub" or g == "x87_mul" or g == "x87_div" or g == "x87_yl2x" or g == "x87_scale" or g == "x87_atan2" then 3 else 2
fn rw_fpcall(g, args, env, st) = if rw_len(args) != rw_fparity(g) then ctfail("lume --raw: " + g + " takes " + str(rw_fparity(g)) + " arguments\n") else if g == "x87_const" then rw_xfconst(rw_nth(args, 0), rw_immval(rw_nth(args, 1)), env, st) else let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg(rw_fppop(rw_fparity(g)) + rw_fpop(g)), r)
## the arguments into %rax (1st), %rcx (2nd), %rdx (3rd)
fn rw_fppop(n) = if n == 1 then "    popq %rax\n" else if n == 2 then "    popq %rcx\n    popq %rax\n" else if n == 3 then "    popq %rdx\n    popq %rcx\n    popq %rax\n" else ""
fn rw_fpop(g) = if g == "fp_add" then rw_sse2("addsd") else if g == "fp_sub" then rw_sse2("subsd") else if g == "fp_mul" then rw_sse2("mulsd") else if g == "fp_div" then rw_sse2("divsd") else if g == "fp_sqrt" then "    movq %rax, %xmm0\n    sqrtsd %xmm0, %xmm0\n    movq %xmm0, %rax\n" else if g == "fp_of_int" then "    cvtsi2sdq %rax, %xmm0\n    movq %xmm0, %rax\n" else if g == "fp_trunc" then "    movq %rax, %xmm0\n    cvttsd2siq %xmm0, %rax\n" else if g == "fp_cmp" then rw_fpcmp() else if g == "x87_ldi" then "    pushq %rcx\n    fildq (%rsp)\n    popq %rcx\n    fstpt (%rax)\n    xorq %rax, %rax\n" else if g == "x87_ldd" then "    pushq %rcx\n    fldl (%rsp)\n    popq %rcx\n    fstpt (%rax)\n    xorq %rax, %rax\n" else if g == "x87_std" then "    fldt (%rax)\n    subq $8, %rsp\n    fstpl (%rsp)\n    popq %rax\n" else if g == "x87_sti" then "    fldt (%rax)\n    subq $8, %rsp\n    fistpq (%rsp)\n    popq %rax\n" else if g == "x87_add" then rw_xf3("faddp") else if g == "x87_mul" then rw_xf3("fmulp") else if g == "x87_sub" then "    fldt (%rcx)\n    fldt (%rdx)\n    fchs\n    faddp\n    fstpt (%rax)\n    xorq %rax, %rax\n" else if g == "x87_div" then rw_xf3("fdivrp") else if g == "x87_rnd" then rw_xf1("frndint") else if g == "x87_f2xm1" then rw_xf1("f2xm1") else if g == "x87_sin" then rw_xf1("fsin") else if g == "x87_cos" then rw_xf1("fcos") else if g == "x87_tan" then "    fldt (%rcx)\n    fptan\n    fstp %st(0)\n    fstpt (%rax)\n    xorq %rax, %rax\n" else if g == "x87_yl2x" then rw_xf3("fyl2x") else if g == "x87_atan2" then rw_xf3("fpatan") else if g == "x87_scale" then "    fldt (%rdx)\n    fldt (%rcx)\n    fscale\n    fstpt (%rax)\n    fstp %st(0)\n    xorq %rax, %rax\n" else if g == "x87_getcw" then "    subq $8, %rsp\n    movq $0, (%rsp)\n    fnstcw (%rsp)\n    popq %rax\n    andq $65535, %rax\n" else if g == "x87_setcw" then "    pushq %rax\n    fldcw (%rsp)\n    popq %rax\n" else ctfail("lume --raw: unknown floating-point intrinsic " + g + "\n")
fn rw_sse2(op) = "    movq %rax, %xmm0\n    movq %rcx, %xmm1\n    " + op + " %xmm1, %xmm0\n    movq %xmm0, %rax\n"
## two operands (a in %rcx, b in %rdx): a, then b on the x87 stack, the popping operation, the result into (d)
fn rw_xf3(op) = "    fldt (%rcx)\n    fldt (%rdx)\n    " + op + "\n    fstpt (%rax)\n    xorq %rax, %rax\n"
fn rw_xf1(op) = "    fldt (%rcx)\n    " + op + "\n    fstpt (%rax)\n    xorq %rax, %rax\n"
## ucomisd: below -> -1, equal -> 0, above -> 1, unordered (ZF and CF set) -> 2
fn rw_fpcmp() = "    movq %rax, %xmm0\n    movq %rcx, %xmm1\n    ucomisd %xmm1, %xmm0\n    movq $1, %rax\n    jnc 1f\n    movq $-1, %rax\n    jnz 2f\n    movq $2, %rax\n    jmp 2f\n1:\n    jnz 2f\n    xorq %rax, %rax\n2:\n"
fn rw_xfconst(d, k, env, st) = let r = rw_e(d, env, st, 0) in rw_r(r.code + (if k == 0 then "    fldz\n" else if k == 1 then "    fld1\n" else if k == 2 then "    fldl2e\n" else if k == 3 then "    fldlg2\n" else if k == 4 then "    fldln2\n" else ctfail("lume --raw: x87_const takes 0 .. 4\n")) + "    fstpt (%rax)\n    xorq %rax, %rax\n", r)
fn rw_call(g, args, env, st, tail) = let n = rw_len(args) in if g == "mkint" and n == 1 then rw_mkint(rw_e(rw_nth(args, 0), env, {n: st.n + 1, nl: st.nl, f: st.f, np: st.np}, 0), st) else if rw_isfp(g) == 1 then rw_fpcall(g, args, env, st) else if g == "frame_ptr" and n == 0 then rw_r("    leaq 0(%rbp), %rax\n", st) else if g == "long_jump" and n == 4 then (let r = rw_push(args, env, st) in rw_r(r.code + "    popq %rax\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    movq %rsi, %rsp\n    movq %rdx, %rbp\n    pushq %rcx\n    ret\n", r)) else if g == "sym_addr" and n == 1 then rw_r("    leaq " + rw_symname(rw_nth(args, 0), st) + "(%rip), %rax\n", st) else if g == "vec_satd4" and n == 4 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg("    popq %r8\n    popq %rdx\n    popq %rcx\n    popq %rax\n" + rw_satd4_asm()), r)) else if g == "vec_sad4" and n == 4 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg("    popq %r8\n    popq %rdx\n    popq %rcx\n    popq %rax\n" + rw_sad4_asm()), r)) else if g == "vec_fdct4" and n == 2 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg("    popq %rcx\n    popq %rax\n" + rw_fdct4_asm()), r)) else if g == "vec_idct4" and n == 2 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg("    popq %rcx\n    popq %rax\n" + rw_idct4_asm()), r)) else if g == "vec_dbk16" and n == 5 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg(rw_dbk16_asm()), r)) else if g == "vec_dbkv" and n == 6 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg(rw_dbkv_asm()), r)) else if g == "vec_dbkh2" and n == 6 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg(rw_dbkh2_asm()), r)) else if g == "vec_dbk16s" and n == 5 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg(rw_dbk16s_asm()), r)) else if g == "vec_dbkvs" and n == 6 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg(rw_dbkvs_asm()), r)) else if g == "vec_dbkh2s" and n == 6 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg(rw_dbkh2s_asm()), r)) else if rw_vec4w(g) and n == 4 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg(rw_vec4wop(g)), r)) else if rw_vec3(g) and n == 3 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg(rw_vec3op(g)), r)) else if rw_vec(g) and n == 2 then (let r = rw_push(args, env, st) in rw_r(r.code + rw_lfg("    popq %rcx\n    popq %rax\n" + rw_vecop(g)), r)) else if rw_mem(g) then (if (g == "load8" or g == "load32" or g == "load64") and n == 1 and rw_regof(rw_nth(args, 0), env) != "" then rw_r(rw_loadr(g, rw_regof(rw_nth(args, 0), env)), st) else if (g == "load8" or g == "load64") and n == 1 and rw_idxbase(rw_nth(args, 0), env) != "" then (let r = rw_e(rw_idxrest(rw_nth(args, 0)), env, st, 0) in rw_r(r.code + rw_loadx(g, rw_idxdisp(rw_nth(args, 0)), rw_idxbase(rw_nth(args, 0), env)), r)) else if (g == "load8" or g == "load32" or g == "load64") and n == 1 then let r = rw_e(rw_nth(args, 0), env, st, 0) in rw_r(r.code + rw_memop(g), r) else if n == 2 then rw_twoop(args, env, st, rw_memop(g)) else ctfail("lume --raw: " + g + " takes " + (if ld_s_starts(g, "load") then "1 argument" else "2 arguments") + "\n")) else if rw_isbit(g) and n == 2 and rw_imm(rw_nth(args, 1), env) != "" then rw_bitimm(g, rw_nth(args, 0), rw_imm(rw_nth(args, 1), env), env, st) else if rw_isbit(g) and n == 2 then rw_twoop(args, env, st, rw_bitop(g)) else if g == "sys_call" and n == 6 then let r = rw_pushc(args, env, st) in rw_r(r.code + rw_popc(args, Cons("%rax", Cons("%rdi", Cons("%rsi", Cons("%rdx", Cons("%r10", Cons("%r8", Nil)))))), env) + "    xorq %r9, %r9\n    syscall\n", r) else if tail == 1 and g == rw_base(st.f) and n == st.np then let r = rw_pushsel(args, 0, env, st) in rw_r(r.code + rw_popsel(args, 0, env, st.f) + "    jmp .Lrw_" + st.f + "_top\n", r) else if n > 6 then rw_bigcall(g, args, env, st) else if rw_isleaf(st.f) then rw_leafcall(g, args, env, st, tail) else let r = rw_pushc(args, env, st) in rw_r(r.code + rw_popc(args, rw_regs(), env) + "    call " + g + "\n", r)
fn ld_s_starts(s, p) = count(s) >= count(p) and slice(s, 0, count(p)) == p
## the prologue keeps %rdi..%r11 (also the parameters' homes), the frame holds the lets; the epilogue gives them back
## a routine the hand-written assembly calls keeps every register but %rax (those callers rely on it); every other one
## follows the System V rule, like the assembly builtins it sits next to: %rdi .. %r11 are the caller's to save (the
## code Lume compiles keeps nothing in them across a call), so the prologue stores only its parameters into their slots
## the callee-saved registers a routine uses are kept in the frame words -8 .. -40 (the slots its first five parameters
## would have had); its parameters move from the argument registers to their registers or slots
fn rw_saveregs(i, nu) = if i > nu then "" else "    movq " + rw_loc(i) + ", " + str(0 - 8 * i) + "(%rbp)\n" + rw_saveregs(i + 1, nu)
fn rw_restregs(i, nu) = if i > nu then "" else "    movq " + str(0 - 8 * i) + "(%rbp), " + rw_loc(i) + "\n" + rw_restregs(i + 1, nu)
fn rw_movparams(f, i, np) = rw_movparamsm(f, i, np, 31)
fn rw_movparamsm(f, i, np, m) = if i >= np or i >= 6 then "" else "    movq " + rw_nth(rw_regs(), i) + ", " + rw_loc(rw_phomem(f, i, m)) + "\n" + rw_movparamsm(f, i + 1, np, m)
## the number of times w occurs in code
fn rw_count(code, w, i, n) = let p = lp_find(code, w, i) in if p < 0 then n else rw_count(code, w, p + count(w), n + 1)
fn lp_find(s, w, i) = if i + count(w) > count(s) then 0 - 1 else if slice(s, i, i + count(w)) == w then i else lp_find(s, w, i + 1)
fn rw_has(code, w) = lp_has(code, w)
## an intrinsic notes each register a leaf routine may keep a value in (rdx, rdi, rsi, r8 .. r11) that its code uses,
## as a comment line #rwu-REG; rw_leafok refuses leaf mode when one of them holds a parameter or let of the routine
fn rw_lfg(x) = rw_lfu(x, "%rdx", "%edx") + rw_lfu(x, "%rdi", "%edi") + rw_lfu(x, "%rsi", "%esi") + rw_lfu(x, "%r8", "%r8") + rw_lfu(x, "%r9", "%r9") + rw_lfu(x, "%r10", "%r10") + rw_lfu(x, "%r11", "%r11") + x
fn rw_lfu(x, r, r32) = if rw_has(x, r) == 1 or rw_has(x, r32) == 1 then "    #rwu-" + r + "\n" else ""
fn rw_lfbad(code, rs) = match rs
    Nil        => false
    Cons(h, t) => rw_has(code, "#rwu-" + h + "\n") == 1 or rw_lfbad(code, t)
fn rw_leafok(nm, np, r) = rw_keepall(nm) == 0 and np <= 6 and rw_lfbad(r.code, rw_lfregs(np, r.nl)) == false and rw_has(r.code, "#rwbig") == 0 and rw_count(r.code, "    call ", 0, 0) <= 3 + rw_count(r.code, "    call mkint\n", 0, 0) + rw_count(r.code, "    call __rt_not_str\n", 0, 0) + rw_count(r.code, "    call __rt_not_int\n", 0, 0) + rw_count(r.code, "    call __rt_not_bool\n", 0, 0) + rw_count(r.code, "    call __rt_die3\n", 0, 0) and rw_has(r.code, "syscall") == 0 and rw_has(r.code, "idivq") == 0 and rw_has(r.code, "leaq 0(%rbp), %rax") == 0 and r.nl <= (if np <= 3 then 2 else 1)
fn rw_leaf(nm, ps, body, np) = let f2 = nm + "__lf" in let r = rw_e(body, rw_params(ps, 0, Nil, f2), {n: 0, nl: 0, f: f2, np: np}, 1) in nm + ":\n" + (if np >= 4 then "    movq %rcx, %r10\n" else "") + ".Lrw_" + f2 + "_top:\n" + r.code + "    ret\n"
fn rw_keepall(nm) = nm == "strlen" or nm == "streq" or nm == "__rt_nofield_text" or ld_s_starts(nm, "rtd_") or ld_s_starts(nm, "__rt_dbg_")
fn rw_pushparams(np, i) = if i >= np then "" else "    pushq " + rw_nth(rw_regs(), i) + "\n" + rw_pushparams(np, i + 1)
fn rw_fn(nm, ps, body) = let np = rw_len(ps) in let rm = (if rw_keepall(nm) then 31 else rw_rmask(ps, body)) in let r = rw_e(body, Cons({k: "#rmask", off: rm + 1}, rw_paramsm(ps, 0, Nil, nm, rm)), {n: 0, nl: 0, f: nm, np: np}, 1) in let fr = (r.nl * 8 + 15) / 16 * 16 in if rw_leafok(nm, np, r) then rw_leaf(nm, ps, body, np) else if rw_keepall(nm) then nm + ":\n    pushq %rbp\n    movq %rsp, %rbp\n    pushq %rdi\n    pushq %rsi\n    pushq %rdx\n    pushq %rcx\n    pushq %r8\n    pushq %r9\n    pushq %r10\n    pushq %r11\n" + (if fr > 0 then "    subq $" + str(fr) + ", %rsp\n" else "") + ".Lrw_" + nm + "_top:\n" + r.code + "    leaq -64(%rbp), %rsp\n    popq %r11\n    popq %r10\n    popq %r9\n    popq %r8\n    popq %rcx\n    popq %rdx\n    popq %rsi\n    popq %rdi\n    popq %rbp\n    ret\n" else let nu = rw_pop62(rm) in nm + ":\n    pushq %rbp\n    movq %rsp, %rbp\n    subq $" + str(96 + fr) + ", %rsp\n" + rw_saveregs(1, nu) + rw_movparamsm(nm, 0, np, rm) + ".Lrw_" + nm + "_top:\n" + r.code + rw_restregs(1, nu) + "    movq %rbp, %rsp\n    popq %rbp\n    ret\n"
## every raw routine starts on a 32-byte boundary: a small hot routine otherwise ran at half speed or full speed
## depending on where the code before it ended (measured: ord_at 32 or 65 ms per 10M calls on the same code). The
## runtime text carries a comment as the mark (every assembler, the frozen seed too, skips it: plain `lumec < file`
## stays byte-identical to the seed's oracle and assembles to the same ELF); lume run / build / test turn it
## into `.p2align 5` (lcode_al_apply)
fn rw_align() = "    #p2align\n"
fn rw_prog(stmts) = match stmts
    Nil        => ""
    Cons(h, t) => (match h
        Fn(nm, ps, body) => rw_align() + rw_fn(nm, ps, body) + rw_prog(t)
        _                => rw_prog(t))
