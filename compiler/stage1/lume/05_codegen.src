fn luses_tier_args(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_tier_expr(h) == 1 then 1 else luses_tier_args(t)
fn luses_tier_rec(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_tier_expr(h.val) == 1 then 1 else luses_tier_rec(t)
fn luses_tier_arms(xs) = match xs
    Nil        => 0
    Cons(h, t) => if luses_tier_expr(h.body) == 1 then 1 else luses_tier_arms(t)
fn luses_tier_stmt(s0) = match s0
    Fn(nm, ps, body) => luses_tier_expr(body)
    Print(v)         => luses_tier_expr(v)
    ExprS(v)         => luses_tier_expr(v)
