## [K0007] a builtin that only works in ring 0 (a privileged instruction: port I/O, MSRs, cli / sti / hlt, CR3,
## invlpg, the IDT, interrupts, AP boot, task switch; or the VGA text buffer at 0xB8000) in a hosted program: the
## process would die of SIGSEGV (exit 139) at the call, so the compiler refuses it. A @freestanding kernel or a
## program with an ISR takes them.
fn lis_kernel_only(nm) = nm == "port_out8" or nm == "port_in8" or nm == "port_out16" or nm == "port_in16" or nm == "port_out32" or nm == "port_in32" or nm == "cpu_rdmsr" or nm == "cpu_wrmsr" or nm == "cpu_cli" or nm == "cpu_sti" or nm == "cpu_hlt" or nm == "cpu_read_cr3" or nm == "cpu_write_cr3" or nm == "cpu_invlpg" or nm == "cpu_idt_init" or nm == "cpu_trigger_irq32" or nm == "cpu_wait_timer_irq" or nm == "cpu_smp_boot_ap" or nm == "cpu_run_2tasks" or nm == "vga_puts" or nm == "vga_fill_row" or nm == "vga_scroll_up" or nm == "vga_set_cursor"
fn lkonly_expr(e) = match e
    Call(nm, args)  => if lis_kernel_only(nm) then nm else lkonly_args(args)
    LetIn(nm, v, b) => let a = lkonly_expr(v) in if a != "" then a else lkonly_expr(b)
    Bin(op, l, r)   => let a = lkonly_expr(l) in if a != "" then a else lkonly_expr(r)
    If(c, t, e2)    => let a = lkonly_expr(c) in if a != "" then a else let b = lkonly_expr(t) in if b != "" then b else lkonly_expr(e2)
    Field(o, nm)    => lkonly_expr(o)
    Rec(items)      => lkonly_rec(items)
    RecT(tn, items) => lkonly_rec(items)
    Match(sc, arms) => let a = lkonly_expr(sc) in if a != "" then a else lkonly_arms(arms)
    _               => ""
fn lkonly_args(xs) = match xs
    Nil        => ""
    Cons(h, t) => let a = lkonly_expr(h) in if a != "" then a else lkonly_args(t)
fn lkonly_rec(xs) = match xs
    Nil        => ""
    Cons(h, t) => let a = lkonly_expr(h.val) in if a != "" then a else lkonly_rec(t)
fn lkonly_arms(xs) = match xs
    Nil        => ""
    Cons(h, t) => let a = lkonly_expr(h.body) in if a != "" then a else lkonly_arms(t)
fn lkonly_stmt(s0) = match s0
    Fn(nm, ps, body) => let a = lkonly_expr(body) in if a != "" then {nm: a, fnm: nm} else {nm: "", fnm: ""}
    Print(v)         => {nm: lkonly_expr(v), fnm: "<main>"}
    ExprS(v)         => {nm: lkonly_expr(v), fnm: "<main>"}
    _                => {nm: "", fnm: ""}
fn lkonly_chk(prog) = match prog
    Nil        => 0
    Cons(h, t) => let r = lkonly_stmt(h) in if r.nm != "" then ctfail("lume: kernel error [K0007]: '" + r.nm + "' in '" + r.fnm + "' is a kernel-only builtin (a privileged instruction or the VGA text buffer); a hosted process stops with SIGSEGV there (fix-it: mark the program's entry @freestanding and build it as a kernel, or use the hosted builtin for the job)\n") else lkonly_chk(t)
fn luses_tier_expr(e) = match e
    Call(nm, args)  => if lis_tier_call(nm) then 1 else luses_tier_args(args)
    LetIn(nm, v, b) => if luses_tier_expr(v) == 1 then 1 else luses_tier_expr(b)
