## buf_ok.src -- conformance tests for the mutable byte buffers of the runtime (buf_new, buf_len, buf_get,
## buf_set, buf_copy, buf_slice, buf_from_str, buf_to_str). A buffer holds raw bytes 0..255 and is changed in
## place: every holder of the same buffer sees a buf_set or a buf_copy. Out-of-bounds access, a value outside
## 0..255 and a non-buffer argument stop the program with a message (checked by build/windows-native/mem/buf_err_*.src).

fn fill(b, i, n, v) / {io} = if i >= n then b else let s = buf_set(b, i, (v + i) % 256) in fill(b, i + 1, n, v)
fn sum(b, i, n, acc) / {io} = if i >= n then acc else sum(b, i + 1, n, acc + buf_get(b, i))

fn test_new_is_zeroed_with_its_length() / {io} = let b = buf_new(10) in buf_len(b) == 10 and buf_get(b, 0) == 0 and buf_get(b, 9) == 0 and sum(b, 0, 10, 0) == 0
fn test_empty_buffer() / {io} = let b = buf_new(0) in buf_len(b) == 0 and buf_to_str(b, 0, 0) == ""
fn test_set_get_every_byte_value() / {io} = let b = fill(buf_new(256), 0, 256, 0) in buf_get(b, 0) == 0 and buf_get(b, 127) == 127 and buf_get(b, 128) == 128 and buf_get(b, 255) == 255 and sum(b, 0, 256, 0) == 32640
fn test_change_in_place_is_seen_by_every_holder() / {io} = let a = buf_new(4) in let alias = a in let r = buf_set(alias, 2, 99) in buf_get(a, 2) == 99 and buf_get(r, 2) == 99
fn test_set_returns_the_same_buffer() / {io} = let b = buf_new(3) in let c = buf_set(buf_set(buf_set(b, 0, 1), 1, 2), 2, 3) in buf_get(b, 0) == 1 and buf_get(b, 1) == 2 and buf_get(b, 2) == 3 and buf_len(c) == 3
fn test_copy_between_buffers() / {io} = let src = fill(buf_new(8), 0, 8, 10) in let dst = buf_new(8) in let r = buf_copy(dst, 2, src, 1, 4) in buf_get(dst, 1) == 0 and buf_get(dst, 2) == 11 and buf_get(dst, 5) == 14 and buf_get(dst, 6) == 0
fn test_copy_overlapping_forward_and_backward() / {io} = let a = fill(buf_new(8), 0, 8, 0) in let r1 = buf_copy(a, 2, a, 0, 5) in let ok1 = buf_get(a, 2) == 0 and buf_get(a, 6) == 4 in let b = fill(buf_new(8), 0, 8, 0) in let r2 = buf_copy(b, 0, b, 3, 5) in ok1 and buf_get(b, 0) == 3 and buf_get(b, 4) == 7
fn test_slice_is_an_independent_copy() / {io} = let a = fill(buf_new(6), 0, 6, 20) in let s = buf_slice(a, 1, 3) in let r = buf_set(a, 1, 0) in buf_len(s) == 3 and buf_get(s, 0) == 21 and buf_get(s, 2) == 23 and buf_get(a, 1) == 0
fn test_str_roundtrip_keeps_nul_and_high_bytes() / {io} = let s = "A" + chr(0) + "B" + chr(255) + "C" in let b = buf_from_str(s) in buf_len(b) == 5 and buf_get(b, 1) == 0 and buf_get(b, 3) == 255 and buf_to_str(b, 0, 5) == s
fn test_long_str_roundtrip() / {io} = let s = "0123456789abcdefghij" + chr(0) + "tail" in let b = buf_from_str(s) in buf_len(b) == 25 and buf_to_str(b, 0, 25) == s and buf_to_str(b, 10, 10) == "abcdefghij"
fn test_buffer_survives_collections() / {io} = let b = fill(buf_new(4096), 0, 4096, 7) in let junk = churn(0, 20000, "") in sum(b, 0, 4096, 0) == sum(fill(buf_new(4096), 0, 4096, 7), 0, 4096, 0) and count(junk) > 0
fn churn(i, n, acc) = if i >= n then acc else churn(i + 1, n, if i % 1000 == 0 then str(i) else acc + "x")

print "buffers: " + str(buf_len(buf_new(16))) + " bytes, byte 3 after set = " + str(buf_get(buf_set(buf_new(8), 3, 200), 3))
