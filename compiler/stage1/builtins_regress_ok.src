## builtins_regress_ok.src -- every documented builtin is called at least once (`lume test`, on Linux and Windows).
## A builtin that disappears from a release makes this file fail to compile ("undefined function"); one that changes
## its answer fails its test. Families follow the factual reference (docs/LUME_REFERENCE_EN.md).
use seq
use arena
use h264

fn test_core_text() = count("abc") == 3 and at("abc", 1) == "b" and slice("abcdef", 1, 3) == "bc" and ord_at("A", 0) == 65 and ord("A") == 65 and chr(66) == "B" and str(42) == "42" and toint("17") == 17 and utf8_chr(233) == "é"
fn test_core_bits() = bit_and(12, 10) == 8 and bit_or(12, 10) == 14 and bit_xor(12, 10) == 6 and bit_shl(1, 4) == 16 and bit_shr(16, 4) == 1

fn test_buffers() = let b = buf_new(8) in let s = buf_set(b, 0, 7) in let c = buf_new(8) in let k = buf_copy(c, 4, b, 0, 1) in buf_len(b) == 8 and buf_get(b, 0) == 7 and buf_get(c, 4) == 7 and buf_to_str(buf_from_str("xyz"), 0, 3) == "xyz" and buf_addr(b) != 0

## video and codec families: each answers -1 on a wrong argument and a value on a right one
fn test_video_colour() = let src = buf_new(16 * 16 * 4) in let dst = buf_new(16 * 16 * 3 / 2) in buf_bgra_to_i420(src, 64, 16, 16, dst) > 0 and buf_i420_to_bgra(dst, 16, 16, src, 64) > 0 and buf_bgra_to_i420(7, 64, 16, 16, dst) == 0 - 1
fn test_sad_satd() = let a = buf_new(256) in buf_sad16x16(a, 0, 16, a, 0, 16) == 0 and buf_sad8x8(a, 0, 16, a, 0, 16) == 0 and buf_sad4x4(a, 0, 16, a, 0, 16) == 0 and buf_satd4x4(a, 0, 16, a, 0, 16) == 0 and buf_satd16x16(a, 0, 16, a, 0, 16) == 0 and buf_sad4x4(a, 0, 2, a, 0, 16) == 0 - 1
fn test_h264() = let w = buf_new(32) in let z = buf_new(32) in let f = buf_new(64 * 20) in let p = buf_new(256) in buf_h264_fdct4x4(w, 0, z, 0) == 0 and buf_h264_idct4x4(z, 0, w, 0) == 0 and buf_h264_quant4x4(w, 0, 26, 1, z, 0) == 0 and buf_h264_dequant4x4(z, 0, 26, w, 0) == 0 and buf_h264_sub4x4(f, 65, 64, p, 0, w) == 0 and buf_h264_recon4x4(p, 0, w, 0, z, 0) == 0 and buf_h264_intra4x4(f, 65, 64, 0, 15, p) == 0 and buf_h264_intra16x16(f, 65, 64, 2, 3, p) == 0 and buf_h264_mb_i4(f, 65, 64, f, 65, buf_new(10)) == 0 - 1 and buf_h264_mb_p(f, 65, 64, f, f, buf_new(10)) == 0 - 1 and buf_h264_mb_pc(f, 65, 64, f, f, buf_new(10)) == 0 - 1 and buf_h264_me16(f, 65, 64, f, buf_new(10)) == 0 - 1 and buf_h264_mb_i16(f, 65, 64, f, 65, buf_new(10)) == 0 - 1 and buf_h264_mb_ic(f, f, f, f, buf_new(10)) == 0 - 1 and buf_h264_cavlc_luma(f, buf_new(10), f, 0) == 0 - 1 and buf_h264_cavlc_chroma(f, buf_new(10), f, 0) == 0 - 1 and buf_h264_fdct4x4(7, 0, z, 0) == 0 - 1

fn test_files() = let a = fs_write_sync("regress_probe.txt", "a") in let b = fs_append_sync("regress_probe.txt", "b") in let c = fs_copy("regress_probe.txt", "regress_probe2.txt") in let r = fs_read_file("regress_probe2.txt") in let e = fs_path_exists("regress_probe.txt") in let x = fs_remove("regress_probe.txt") in let y = fs_remove("regress_probe2.txt") in a == 1 and b == 1 and c == 1 and r == "ab" and e == 1 and x == 1 and y == 1 and fs_read_file("regress_absent_probe.txt") == ""
## the rest of the reference (os_exit is the one documented builtin left out: it would end the test process)
fn test_rest_of_reference() = let b = buf_from_str("abcdef") in let s = buf_slice(b, 1, 3) in let p = buf_new(4) in let q = buf_bits_se(p, 0, 0 - 2) in let e = emit("") in let f = flush() in let d = fs_mkdir("regress_mkdir_probe") in let x = fs_path_exists("regress_mkdir_probe") in let r = fs_rmdir("regress_mkdir_probe") in buf_to_str(s, 0, 3) == "bcd" and buf_len(s) == 3 and q == 5 and buf_get(p, 0) == 40 and d == 1 and x == 1 and r == 1 and count(os_arg_at(0)) > 0 and os_arg_at(0 - 1) == ""
fn test_os() =(os_platform() == "linux" or os_platform() == "windows") and os_getenv("LUME_REGRESS_UNSET_VAR") == "" and os_monotonic_ns() > 0 and os_unix_time() > 1700000000 and os_arg_count() >= 0 and os_setenv("LUME_REGRESS_VAR", "v") == 1 and os_getenv("LUME_REGRESS_VAR") == "v"
fn test_network() = let fd = net_udp_bind_addr("127.0.0.1", 47417) in let s = net_udp_send_to(fd, "127.0.0.1", 47417, "ok") in let r = net_udp_recv_from(fd, 16) in let p = net_last_peer_port() in let ip = net_last_peer_ip() in let c = net_close(fd) in fd >= 0 and s == 2 and r == "ok" and p == 47417 and ip == "127.0.0.1" and net_tcp_connect_addr("127.0.0.1", 1) == 0 - 1

fn test_f64() = f64_sqrt(f64(16)) == f64(4) and f64_int(f64_floor(f64("2.7"))) == 2 and f64_int(f64_ceil(f64("2.2"))) == 3 and f64_int(f64_round(f64("2.5"))) == 3 and f64_abs(f64(0) - f64(2)) == f64(2) and f64_is_nan(f64("nan")) == 1 and f64_str(f64("1.5"), 1) == "1.5" and f64_int(f64_pow(f64(2), f64(8))) == 256 and f64_from_bits(f64_bits(f64(3))) == f64(3) and f64_int(f64_exp(f64(0))) == 1 and f64_int(f64_log(f64(1))) == 0 and f64_int(f64_log10(f64(100))) == 2 and f64_int(f64_cos(f64(0))) == 1 and f64_int(f64_sin(f64(0))) == 0 and f64_int(f64_tan(f64(0))) == 0 and f64_int(f64_atan2(f64(0), f64(1))) == 0

fn test_memory() = let h = heap_stats() in let g = gc_count() in let c = gc_collect() in h.used >= 0 and gc_count() == g + 1

fn test_seq_module() = seq_loop(0, 4, 0, fn(i, acc) => acc + i) == 6 and seq_nth([5, 6, 7], 2) == 7 and seq_fold([1, 2], 0, fn(acc, x) => acc + x) == 3
fn test_h264_module() = let f = buf_new(256) in let d = buf_new(256) in buf_h264_luma_mc(f, 0, 16, 16, 16, 0, 0, 1, 2, 4, 4, d, 0, 16) == 0 and buf_h264_chroma_mc(f, 0, 16, 16, 16, 0, 0, 3, 5, 2, 2, d, 0, 16) == 0 and buf_h264_deblock_edge(f, 72, 1, 16, 4, [4], 40, 10, [0], 0) == 0 and buf_h264_luma_mc(f, 0, 16, 16, 16, 0, 0, 0, 0, 3, 4, d, 0, 16) == 0 - 1
## a whole macroblock deblocked (1x1 picture, QP 0: nothing to filter) and a cfg too small
fn test_h264_deblock_mb() = let y = buf_new(256) in let u = buf_new(64) in let v = buf_new(64) in let c = buf_new(400) in let s1 = buf_set(c, 4, 16) in let s2 = buf_set(c, 16, 8) in let s3 = buf_set(c, 28, 1) in let s4 = buf_set(c, 32, 1) in buf_h264_deblock_mb(y, u, v, c) == 0 and buf_h264_deblock_mb(y, u, v, buf_new(10)) == 0 - 1
fn test_bits() = let b = buf_new(8) in let p1 = buf_bits_write(b, 0, 5, 3) in let p2 = buf_bits_write(b, p1, 1, 1) in let p3 = buf_bits_ue(b, p2, 3) in p1 == 3 and p2 == 4 and p3 == 9 and buf_get(b, 0) == 178 and buf_bits_read(b, 0, 3) == 5 and buf_bits_read(b, 4, 5) == 4 and buf_bits_write(b, 63, 3, 2) == 0 - 1
## buf_shared: a shared buffer is an ordinary buffer to the program (zeroed, sized, writable)
fn test_shared_buffer() = let b = buf_shared(16) in let s = buf_set(b, 3, 7) in buf_len(b) == 16 and buf_get(b, 3) == 7 and buf_get(b, 0) == 0
## os_fork: the child exits at once with 7; os_waitpid_status gives the raw wait status (exit code * 256)
fn test_fork() = let pid = os_fork() in if pid == 0 then os_exit(7) else os_waitpid_status(pid) / 256 == 7

## text, failure, bits, constant time, packed h264 forms (family M)
fn test_text_more() = ord("A") == 65 and ord("") == 0 and utf8_chr(8364) == "€" and slicen("abcdef", 0, 1, 3) == "bc" and lidx([10, 20, 30], 1) == 20 and lidx("abc", 2) == "c"
fn test_printval() = let p = printval("") in true
fn rgm_risky(x) = if x > 3 then ctfail("too big") else x * 2
fn rgm_guard(x) = if __lume_try_begin() == 0 then (let r = rgm_risky(x) in let e = __lume_try_end() in str(r)) else "failed: " + __lume_try_msg()
fn test_try_fail() = rgm_guard(2) == "4" and rgm_guard(5) == "failed: too big"
fn test_bits_more() = bit_not(5) == 0 - 6 and bit_or(12, 10) == 14 and bit_xor(12, 10) == 6 and bit_shr(0 - 16, 2) == 0 - 4
fn test_bitvector() = bv_u8(300) == 44 and bv_not_u8(0) == 255 and bv_add_u8(200, 100) == 44 and bv_sub_u8(1, 2) == 255 and bv_mul_u8(16, 17) == 16 and bv_and(12, 10) == 8 and bv_or(12, 10) == 14 and bv_xor(12, 10) == 6 and bv_shl(1, 8) == 256 and bv_shr(0 - 256, 4) == 0 - 16
fn test_constant_time() = ct_eq(5, 5) == 1 and ct_eq(5, 6) == 0 and ct_select(0 - 1, 7, 9) == 7 and ct_select(0, 7, 9) == 9 and ct_select(12, 10, 5) == 9
fn test_simd() = simd_add4_i64(1, 2) == 12 and simd_sub4_i64(5, 2) == 12 and simd_xor4_i64(12, 10) == 6
fn test_h264_packed() = let f = buf_new(256) in let d = buf_new(256) in let c = buf_new(32) in let o = buf_new(16) in let s = buf_set(c, 0, 1) in buf_h264_lmc6(f, d, 16, 16, 16 + 16 * 65536 + 4 * 4294967296 + 4 * 1099511627776, 536870912 + 536870912 * 1073741824) == 0 and buf_h264_cmc6(f, d, 16, 16, 16 + 16 * 65536 + 2 * 4294967296 + 2 * 1099511627776, 536870912 + 536870912 * 1073741824) == 0 and buf_h264_lmc6(f, d, 16, 16, 16 + 16 * 65536 + 3 * 4294967296 + 4 * 1099511627776, 536870912 + 536870912 * 1073741824) == 0 - 1 and buf_h264_cavlc6(c, 0, 0, 16, o, 0) == 129 and buf_h264_dbk5(f, 72, 1 + 16777216 + (16 + 16777216) * 33554432, 4 + 40 * 65536 + 10 * 16777216, 4) == 0 and buf_h264_dbk5(f, 72, 16777216 + (16 + 16777216) * 33554432, 4, 4) == 0 - 1

## files beyond read / write: directories, ranges, renames, modes (fork A)
fn test_files_dirs_A() = let d0 = fs_current_dir() in let m = fs_mkdir("rga_dir") in let c = fs_chdir("rga_dir") in let d1 = fs_current_dir() in let b = fs_chdir("..") in let w = fs_write_sync("rga_dir/a.txt", "hello world") in let l = fs_read_dir("rga_dir") in let rd = fs_rmdir("rga_dir") in let x = fs_remove("rga_dir/a.txt") in let r = fs_rmdir("rga_dir") in m == 1 and c == 1 and count(d1) > count(d0) and b == 1 and fs_current_dir() == d0 and l == "a.txt\n" and rd == 0 and x == 1 and r == 1 and fs_chdir("rga_absent_dir") == 0 and fs_read_dir("rga_absent_dir") == ""
fn test_files_ranges_A() = let w = fs_write_sync("rga_r.txt", "hello world") in let w2 = fs_write_sync("rga_s.txt", "hello world") in let ok = fs_read_byte("rga_r.txt", 0) == 104 and fs_read_byte("rga_r.txt", 11) == 0 - 1 and fs_read_range("rga_r.txt", 6, 100) == "world" and fs_read_range("rga_r.txt", 11, 3) == "" and fs_files_equal("rga_r.txt", "rga_s.txt") == 1 and fs_files_equal("rga_r.txt", "rga_absent.txt") == 0 - 1 in let t = fs_truncate("rga_s.txt", 2) in let ok2 = t == 1 and fs_read_file("rga_s.txt") == "he" and fs_files_equal("rga_r.txt", "rga_s.txt") == 0 and fs_truncate("rga_absent.txt", 1) == 0 in let x = fs_remove("rga_r.txt") in let y = fs_remove("rga_s.txt") in ok and ok2 and x == 1 and y == 1
fn test_files_rename_hex_A() = let w = fs_write_hex_file("rga_h.bin", "48690aFF") in let ok = w == 1 and fs_read_range("rga_h.bin", 0, 2) == "Hi" and fs_read_byte("rga_h.bin", 3) == 255 and fs_write_hex_file("rga_bad.bin", "486") == 0 and fs_path_exists("rga_bad.bin") == 0 in let r = fs_rename("rga_h.bin", "rga_h2.bin") in let w2 = fs_write_sync("rga_h3.bin", "x") in let n1 = fs_rename_noreplace("rga_h2.bin", "rga_h3.bin") in let n2 = fs_rename_noreplace("rga_h2.bin", "rga_h4.bin") in let x = fs_remove("rga_h3.bin") + fs_remove("rga_h4.bin") in ok and r == 1 and n1 == 0 and n2 == 1 and x == 2 and fs_rename("rga_absent.bin", "rga_h5.bin") == 0
fn test_files_modes_A() = let w = fs_write_sync("rga_m.txt", "m") in let c = fs_chmod("rga_m.txt", 292) in let m1 = fs_mode("rga_m.txt") in let c2 = fs_chmod("rga_m.txt", 420) in let e = fs_make_executable("rga_m.txt") in let m2 = fs_mode("rga_m.txt") in let x = fs_remove("rga_m.txt") in c == 1 and m1 == 292 and c2 == 1 and e == 1 and (m2 == 493 or os_platform() == "windows" and m2 == 420) and x == 1 and fs_mode("rga_absent.txt") == 0 - 1 and fs_chmod("rga_absent.txt", 420) == 0 and fs_chmod("rga_m.txt", 4096) == 0
fn test_files_private_A() = let a = fs_create_private("rga_p.txt", "s1") in let b = fs_create_private("rga_p.txt", "s2") in let c = fs_write_private("rga_p.txt", "s3") in let ok = a == 1 and b == 0 and c == 1 and fs_read_file("rga_p.txt") == "s3" and fs_is_private("rga_p.txt") == 1 and fs_mode("rga_p.txt") == 384 in let d = fs_mkdir_private("rga_pd") in let ok2 = d == 1 and fs_mode("rga_pd") == 448 and fs_is_private("rga_pd") == 1 in let x = fs_remove("rga_p.txt") in let y = fs_rmdir("rga_pd") in ok and ok2 and x == 1 and y == 1 and fs_is_private("rga_absent.txt") == 0 - 1
## the OS keychain: Windows Credential Manager; elsewhere every call answers -38 (no OS keychain; `use keychain` has a file store)
fn test_keychain_A() = if os_keychain_available() == 0 then os_keychain_put("lume-regress-a", "v") == 0 - 38 and os_keychain_get("lume-regress-a") == "-38" and os_keychain_delete("lume-regress-a") == 0 - 38 else let p = os_keychain_put("lume-regress-a", "v") in let g = os_keychain_get("lume-regress-a") in let d = os_keychain_delete("lume-regress-a") in p == 1 and g == "+v" and d == 1 and os_keychain_get("lume-regress-a") == "" and os_keychain_delete("lume-regress-a") == 0

## processes, environment and system information (fork B): each call runs on Linux and Windows; a missing tool path
## exercises every launcher without needing a real executable (the child exits 127: status 32512)
fn test_env_B() = let s = os_setenv("LUME_REGRESS_B", "") in let h = os_env_has("LUME_REGRESS_B") in let u = os_unsetenv("LUME_REGRESS_B") in s == 1 and h == 1 and u == 1 and os_env_has("LUME_REGRESS_B") == 0 and os_setenv("A=B", "x") == 0 and os_unsetenv("") == 0
fn test_sysinfo_B() = (os_uname_field(0) == "Linux" or os_uname_field(0) == "Windows_NT") and os_uname_field(4) == "x86_64" and os_uname_field(5) == "" and os_getpid() > 0 and os_unix_time() > 1700000000 and os_self_maxrss_kb() > 0 and os_last_child_maxrss_kb() >= 0 and os_sleep_ms(1) == 1
fn test_dns_servers_B() = let d = os_dns_servers() in d == "" or slice(d, 0, 11) == "nameserver "
fn test_launchers_B() = let a = os_run("/no/such/lume-regress-tool", Nil) in let b = os_run_capture("/no/such/lume-regress-tool", Nil, "regress_b_out.txt", "regress_b_out.txt") in let c = os_run_capture_timeout("/no/such/lume-regress-tool", Nil, "regress_b_out.txt", "regress_b_out.txt", 5000) in let t = os_last_timed_out() in let d = os_run_input_capture_timeout("/no/such/lume-regress-tool", Nil, "regress_b_absent_in.txt", "regress_b_out.txt", "regress_b_out.txt", 5000) in let sp = os_spawn_capture("/no/such/lume-regress-tool", Nil, "regress_b_out.txt", "regress_b_out.txt") in let st = os_waitpid_status(sp) in let r = fs_remove("regress_b_out.txt") in a == 32512 and b == 32512 and c == 32512 and t == 0 and d == 32512 and sp > 0 and st == 32512
fn test_exec_B() = let pid = os_fork() in if pid == 0 then os_exit(if os_exec("/no/such/lume-regress-tool", Nil) < 0 then 40 else 41) else os_waitpid_status(pid) == 10240
fn test_kill_wait_B() = let pid = os_fork() in if pid == 0 then os_exit(os_sleep_ms(60000)) else let k = os_kill(pid, 9) in k == 0 and os_waitpid_status(pid) == 9 and os_waitpid(pid) < 0 and os_kill(0 - 999999, 15) < 0
fn test_waitpid_B() = let pid = os_fork() in if pid == 0 then os_exit(0) else os_waitpid(pid) == pid
fn test_pipe_B() = let p = os_pipe_new() in let w = os_pipe_write_int(p % 10000, 0 - 42) in p > 0 and w == 1 and os_pipe_read_int(p / 10000) == 0 - 42
fn test_shm_B() = os_shm_map(4096) > 0 and os_shm_map(0) < 0
## io_uring: a kernel that disables it answers -38 or -1; Windows answers through its emulation
fn test_io_uring_B() = let u = os_io_uring_setup(8, 0) in u == 0 - 38 or u == 0 - 1 or (u >= 0 and os_io_uring_enter(u, 0, 0) == 0 and os_io_uring_register(u, 0, 0) < 0 and net_close(u) == 1 and os_io_uring_setup(0, 0) < 0)

## network on 127.0.0.1 (ports 47530..47533) and epoll: one process is both ends; -1 on a refused connection
fn test_tcp_loopback_C() = let l = net_tcp_listen(47530) in let c = net_tcp_connect(47530) in let a = net_tcp_accept(l) in let s = net_send_str(c, "ping") in let ep = epoll_create_fd() in let e = epoll_add_in(ep, a, 77) in let w = epoll_wait_one(ep, 2000) in let r = net_recv_str(a, 4096) in let h = net_shutdown_write(c) in let eof = net_recv_str(a, 4096) in let z = net_close(a) + net_close(c) + net_close(l) + net_close(ep) in l >= 0 and c >= 0 and a >= 0 and s == 4 and ep >= 0 and e == 0 and w == 77 and r == "ping" and h == 1 and eof == "" and net_tcp_connect(47531) == 0 - 1
fn test_tcp_listen_addr_C() = let l = net_tcp_listen_addr("127.0.0.1", 47532) in let c = net_tcp_connect_addr("127.0.0.1", 47532) in let a = net_tcp_accept(l) in let z = net_close(a) + net_close(c) + net_close(l) in l >= 0 and c >= 0 and a >= 0 and net_tcp_listen_addr("1.2.3", 47532) == 0 - 1
fn test_udp_loopback_C() = let u = net_udp_bind(47533) in let s = net_udp_sendto(47533, "hi") in let r = net_recv_str(u, 4096) in let z = net_close(u) in u >= 0 and s == 2 and r == "hi"
## crypto primitives against RFC 7748 / RFC 8032 / RFC 8439 / FIPS 180-4 vectors
fn rgc_hx(c) = if c >= 97 then c - 87 else c - 48
fn rgc_unhex(s, i, acc) = if i >= count(s) then acc else rgc_unhex(s, i + 2, acc + chr(rgc_hx(ord_at(s, i)) * 16 + rgc_hx(ord_at(s, i + 1))))
fn rgc_h(s) = rgc_unhex(s, 0, "")
fn rgc_z(n) = if n == 0 then "" else chr(0) + rgc_z(n - 1)
fn test_crypto_x25519_C() = crypto_x25519(rgc_h("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4"), rgc_h("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c")) == rgc_h("c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552") and crypto_x25519("short", rgc_z(32)) == rgc_z(32)
fn test_crypto_ed25519_C() = let b = rgc_h("5866666666666666666666666666666666666666666666666666666666666666") in crypto_ed25519_base(chr(1) + rgc_z(31)) == b and crypto_ed25519_vpt(b, chr(1) + rgc_z(31), chr(2) + rgc_z(31)) == b and crypto_ed25519_vpt("x", rgc_z(32), rgc_z(32)) == ""
fn test_crypto_chacha_poly_C() = let k = rgc_h("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f") in let n = rgc_h("000000000000004a00000000") in let o = crypto_chacha20_xor(buf_new(5), "Ladie", k, n, 1) in buf_to_str(o, 0, 5) == rgc_h("6e2e359a25") and crypto_poly1305(rgc_h("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b"), "Cryptographic Forum Research Group") == rgc_h("a8061dc1305136c6c22b8baf0c0127a9")
fn rgc_w(b, o, v) = let a = buf_set(b, o, v % 256) in let c = buf_set(b, o + 1, (v / 256) % 256) in let d = buf_set(b, o + 2, (v / 65536) % 256) in buf_set(b, o + 3, v / 16777216)
fn test_crypto_sha256_blocks_C() = let st = rgc_w(rgc_w(rgc_w(rgc_w(rgc_w(rgc_w(rgc_w(rgc_w(buf_new(32), 0, 1779033703), 4, 3144134277), 8, 1013904242), 12, 2773480762), 16, 1359893119), 20, 2600822924), 24, 528734635), 28, 1541459225) in let h = crypto_sha256_blocks(st, "abc" + chr(128) + rgc_z(59) + chr(24), 0, 64) in buf_to_str(h, 0, 4) == rgc_h("bf1678ba")

## hardware builtins that run in a hosted process (Linux and Windows): ordinary user-mode instructions, memory
## through buf_addr, counters that stay 0 outside a kernel; the privileged ones (reg skip) fault in user mode
fn test_hw_cpu_D() = cpu_rdtsc() > 0 and cpu_pause() == 1 and cpu_mfence() == 1 and cpu_irq32_count() == 0 and cpu_pf14_count() == 0 and cpu_pf14_addr() == 0
fn test_hw_static_D() = hw_scratch_addr() > 0 and static_arena_addr() > 0 and static_arena_cap() == 65536 and krn_slot_write(1000, 42) == 42 and krn_slot_read(1000) == 42 and krn_slot_read(2024) == 42
fn test_hw_memory_D() = let b = buf_new(64) in let a = buf_addr(b) in let s = mem_set(a, 65, 3) in let c = mem_copy(a + 8, a, 3) in s == 3 and c == 3 and buf_to_str(b, 8, 3) == "AAA" and mem_crc64(a, 3) == -419964953232898494 and mem_crc64(a, 0) == -3750763034362895579 and mem_copy(a, a, 0 - 5) == 0 - 5
fn test_hw_mmio_D() = let b = buf_new(64) in let a = buf_addr(b) in let w8 = mmio_volatile_write8(a + 16, 300) in let r8 = mmio_volatile_read8(a + 16) in let w16 = mmio_volatile_write16(a + 16, 4660) in let r16 = mmio_volatile_read16(a + 16) in let w32 = mmio_volatile_write32(a + 16, 0 - 1) in let r32 = mmio_volatile_read32(a + 16) in let w64 = mmio_volatile_write64(a + 24, 0 - 2) in w8 == 300 and r8 == 44 and w16 == 4660 and r16 == 4660 and w32 == 0 - 1 and r32 == 4294967295 and w64 == 0 - 2 and mmio_volatile_read64(a + 24) == 0 - 2 and mmio_volatile_write64(toint("40000"), 5) == 5
fn test_hw_atomic_D() = let b = buf_new(16) in let a = buf_addr(b) in let o1 = atomic_xadd64(a, 5) in let o2 = atomic_xadd64(a, 2) in let l = spinlock_acquire(a + 8) in let held = mmio_volatile_read64(a + 8) in let r = spinlock_release(a + 8) in o1 == 0 and o2 == 5 and mmio_volatile_read64(a) == 7 and l == 1 and held == 1 and r == 1 and mmio_volatile_read64(a + 8) == 0
fn test_hw_syscall_D() = sys_call(9999, 0, 0, 0, 0, 0) == 0 - 38
## loopback sockets, epoll, pipes, sleep, environment, the kernel table, the page hash and the SIMD lanes (the edges are
## in tests/runtime/builtin_edges_ok.src)
fn test_loopback_and_pipes() = let l = net_tcp_listen(47418) in let c = net_tcp_connect(47418) in let a = net_tcp_accept(l) in let s = net_send_str(c, "hi") in let r = net_recv_str(a, 2) in let sh = net_shutdown_write(c) in let e = net_recv_str(a, 8) in let u = net_udp_bind(47419) in let us = net_udp_sendto(47419, "u") in let ur = net_recv_str(u, 8) in let z = net_close(a) + net_close(c) + net_close(l) + net_close(u) in l >= 0 and c >= 0 and a >= 0 and s == 2 and r == "hi" and sh == 1 and e == "" and us == 1 and ur == "u"
fn test_epoll_and_pipes() = let ep = epoll_create_fd() in let p = os_pipe_new() in let ad = epoll_add_in(ep, p / 10000, 5) in let w = os_pipe_write_int(p % 10000, 42) in let ev = epoll_wait_one(ep, 1000) in let r = os_pipe_read_int(p / 10000) in let z = net_close(ep) + net_close(p / 10000) + net_close(p % 10000) in ad == 0 and w == 1 and ev == 5 and r == 42
fn test_sleep_env_print() = let s = os_sleep_ms(1) in let a = os_setenv("LUME_REGRESS_UNSET_ME", "x") in let u = os_unsetenv("LUME_REGRESS_UNSET_ME") in let v = printval(7) in s == 1 and a == 1 and u == 1 and os_env_has("LUME_REGRESS_UNSET_ME") == 0 and v == 7
fn test_kernel_table_hash_simd() = let w = krn_slot_write(9, 99) in w == 99 and krn_slot_read(9) == 99 and mem_crc64(buf_addr(buf_from_str("a")), 1) == 0 - 5808556873153909620 and simd_add4_i64(1, 2) == 12 and simd_sub4_i64(5, 2) == 12 and simd_xor4_i64(5, 3) == 6
