## std.gfx (`compiler/stage1/gfx.src`) — Native 100%-Lume 2D/3D Graphics, Fixed-Point Math,
## Framebuffer Rasterizer, 3D Pinhole Perspective Projection, and Binary BMP / PPM / Vector SVG Engine.
## Zero-C, Zero external dependencies (`libpng`/`cairo`/`opengl` not required).

## ============================================================================
## 1. Fixed-Point Math & Trigonometry (`scale = 1000`, `1.000 == 1000`)
## ============================================================================

@bound(cycles: 16)
fn fx_abs(x: int) -> int
    ensures result >= 0
    = if x < 0 then 0 - x else x

@bound(cycles: 24)
fn fx_clamp(x: int, lo: int, hi: int) -> int
    requires lo <= hi
    ensures result >= lo and result <= hi
    = if x < lo then lo else (if x > hi then hi else x)

@bound(cycles: 32)
fn fx_lerp(a: int, b: int, t_permil: int) -> int = a + (b - a) * t_permil / 1000

fn fx_sqrt_iter(n: int, guess: int, steps: int) -> int = if steps <= 0 or guess <= 0 then guess else let next = (guess + n / guess) / 2 in if next >= guess then guess else fx_sqrt_iter(n, next, steps - 1)

fn fx_sqrt(n: int) -> int = if n <= 0 then 0 else if n < 4 then 1 else fx_sqrt_iter(n, n / 2 + 1, 32)

fn fx_norm_deg(deg: int) -> int = let m = deg % 360 in if m < 0 then m + 360 else m

## Bhaskara I parabolic sine approximation in `[-1000..1000]` for `deg in [0..360)`:
## `sin(x) ~= 4 * x * (180 - x) / (40500 - x * (180 - x))` with < 0.16% max error.
## The denominator needs no guard: `x * (180 - x) = 8100 - (x - 90) * (x - 90) <= 8100` for every integer `x`, so
## `denom >= 32400`. The former `if denom <= 0 then 0 else ..` test was dead code: no input could take its true arm.
## (The inequality is nonlinear, outside what the prover decides, so it is not stated as a `law`;
## `test_fx_sin_half_matches_guarded_form_on_sweep` checks it, and the old guarded form, on every `x` in `[-2000, 2000]`.)
fn fx_sin_half(x: int) -> int = let p = x * (180 - x) in let denom = 40500 - p in (4000 * p + denom / 2) / denom

fn fx_sin_deg(deg: int) -> int = let d = fx_norm_deg(deg) in if d <= 180 then fx_sin_half(d) else 0 - fx_sin_half(d - 180)

fn fx_cos_deg(deg: int) -> int = fx_sin_deg(deg + 90)

## ============================================================================
## 2. RGBA Color Packing & Porter-Duff Source-Over Alpha Blending
## ============================================================================

@bound(cycles: 32)
fn rgba_pack(r: int, g: int, b: int, a: int) -> int
    requires r >= 0 and r <= 255
    requires g >= 0 and g <= 255
    requires b >= 0 and b <= 255
    requires a >= 0 and a <= 255
    ensures result >= 0
    = ((r * 256 + g) * 256 + b) * 256 + a

@bound(cycles: 24)
fn rgba_r(c: int) -> int
    requires c >= 0
    ensures result >= 0 and result <= 255
    = (c / 16777216) % 256

@bound(cycles: 24)
fn rgba_g(c: int) -> int
    requires c >= 0
    ensures result >= 0 and result <= 255
    = (c / 65536) % 256

@bound(cycles: 24)
fn rgba_b(c: int) -> int
    requires c >= 0
    ensures result >= 0 and result <= 255
    = (c / 256) % 256

@bound(cycles: 24)
fn rgba_a(c: int) -> int
    requires c >= 0
    ensures result >= 0 and result <= 255
    = c % 256

fn rgba_blend(fg: int, bg: int) -> int = let a = rgba_a(fg) in let inv_a = 255 - a in let r = (rgba_r(fg) * a + rgba_r(bg) * inv_a) / 255 in let g = (rgba_g(fg) * a + rgba_g(bg) * inv_a) / 255 in let b = (rgba_b(fg) * a + rgba_b(bg) * inv_a) / 255 in rgba_pack(fx_clamp(r, 0, 255), fx_clamp(g, 0, 255), fx_clamp(b, 0, 255), 255)

fn gfx_hex_nib(n: int) = let v = (n % 16 + 16) % 16 in slice("0123456789abcdef", v, v + 1)

fn gfx_hex_u8(b: int) = let v = (b % 256 + 256) % 256 in gfx_hex_nib(v / 16) + gfx_hex_nib(v % 16)

fn gfx_hex_u16_le(v: int) = let u = (v % 65536 + 65536) % 65536 in gfx_hex_u8(u % 256) + gfx_hex_u8(u / 256 % 256)

fn gfx_hex_u32_le(v: int) = let lo = v % 65536 in let hi = v / 65536 % 65536 in gfx_hex_u16_le(lo) + gfx_hex_u16_le(hi)

fn rgba_to_hex(c: int) = "#" + gfx_hex_u8(rgba_r(c)) + gfx_hex_u8(rgba_g(c)) + gfx_hex_u8(rgba_b(c))

## ============================================================================
## 3. 2D Rasterizer Geometry (Rect, Bresenham Line, Circle, Quadratic Bezier)
## ============================================================================

@bound(cycles: 32)
fn gfx_point_in_rect(px: int, py: int, rx: int, ry: int, rw: int, rh: int) -> int
    requires rw >= 0 and rh >= 0
    ensures result >= 0 and result <= 1
    = if px >= rx then (if px < rx + rw then (if py >= ry then (if py < ry + rh then 1 else 0) else 0) else 0) else 0

@bound(cycles: 48)
fn gfx_bresenham_steps(x0: int, y0: int, x1: int, y1: int) -> int = let dx = fx_abs(x1 - x0) in let dy = fx_abs(y1 - y0) in if dx >= dy then dx else dy

fn gfx_circle_contains(px: int, py: int, cx: int, cy: int, radius: int) -> int = if radius < 0 then 0 else let dx = px - cx in let dy = py - cy in if dx * dx + dy * dy <= radius * radius then 1 else 0

fn gfx_bezier_quad_eval(p0: int, p1: int, p2: int, t_permil: int) -> int = let t = fx_clamp(t_permil, 0, 1000) in let a = fx_lerp(p0, p1, t) in let b = fx_lerp(p1, p2, t) in fx_lerp(a, b, t)

## ============================================================================
## 4. 3D Vector Math & Pinhole Perspective Projection Pipeline
## ============================================================================

fn vec3_new(x: int, y: int, z: int) = {x: x, y: y, z: z}

fn vec3_add(a, b) = {x: a.x + b.x, y: a.y + b.y, z: a.z + b.z}

fn vec3_sub(a, b) = {x: a.x - b.x, y: a.y - b.y, z: a.z - b.z}

fn vec3_dot(a, b) -> int = (a.x * b.x + a.y * b.y + a.z * b.z) / 1000

fn vec3_cross(a, b) = {x: (a.y * b.z - a.z * b.y) / 1000, y: (a.z * b.x - a.x * b.z) / 1000, z: (a.x * b.y - a.y * b.x) / 1000}

fn vec3_rotate_y_deg(v, deg: int) = let s = fx_sin_deg(deg) in let c = fx_cos_deg(deg) in {x: (v.x * c + v.z * s) / 1000, y: v.y, z: (0 - v.x * s + v.z * c) / 1000}

fn vec3_rotate_x_deg(v, deg: int) = let s = fx_sin_deg(deg) in let c = fx_cos_deg(deg) in {x: v.x, y: (v.y * c - v.z * s) / 1000, z: (v.y * s + v.z * c) / 1000}

fn gfx_project_3d_to_2d(v, fov_focal: int, cam_z_offset: int, screen_w: int, screen_h: int) = let dz = v.z + cam_z_offset in if dz <= 10 then {sx: screen_w / 2, sy: screen_h / 2, depth_z: dz, visible: 0} else let sx = screen_w / 2 + v.x * fov_focal / dz in let sy = screen_h / 2 - v.y * fov_focal / dz in let vis = gfx_point_in_rect(sx, sy, 0, 0, screen_w, screen_h) in {sx: sx, sy: sy, depth_z: dz, visible: vis}

## ============================================================================
## 5. Binary BMP (`BM` 54-byte Header), Netpbm PPM & Vector SVG Substation HMI
## ============================================================================

fn gfx_hex_nibble_val(c) -> int = if c >= "0" and c <= "9" then ord(c) - 48 else if c >= "a" and c <= "f" then ord(c) - 87 else if c >= "A" and c <= "F" then ord(c) - 55 else 0

fn gfx_hex_byte_at(hex, byte_idx: int) -> int = let pos = byte_idx * 2 in if pos + 2 > count(hex) then 0 else gfx_hex_nibble_val(at(hex, pos)) * 16 + gfx_hex_nibble_val(at(hex, pos + 1))

fn gfx_hex_u32_le_at(hex, byte_idx: int) -> int = gfx_hex_byte_at(hex, byte_idx) + gfx_hex_byte_at(hex, byte_idx + 1) * 256 + gfx_hex_byte_at(hex, byte_idx + 2) * 65536 + gfx_hex_byte_at(hex, byte_idx + 3) * 16777216

fn bmp_header_build_hex(width: int, height: int) = let row_stride = (width * 3 + 3) / 4 * 4 in let pix_bytes = row_stride * height in let file_size = 54 + pix_bytes in "424d" + gfx_hex_u32_le(file_size) + "00000000" + gfx_hex_u32_le(54) + gfx_hex_u32_le(40) + gfx_hex_u32_le(width) + gfx_hex_u32_le(height) + gfx_hex_u16_le(1) + gfx_hex_u16_le(24) + gfx_hex_u32_le(0) + gfx_hex_u32_le(pix_bytes) + gfx_hex_u32_le(2835) + gfx_hex_u32_le(2835) + gfx_hex_u32_le(0) + gfx_hex_u32_le(0)

fn bmp_header_dissect(hex_hdr) = if count(hex_hdr) < 108 then {ok: 0, magic: "", file_size: 0, width: 0, height: 0, bpp: 0} else let b0 = gfx_hex_byte_at(hex_hdr, 0) in let b1 = gfx_hex_byte_at(hex_hdr, 1) in let magic_ok = b0 == 66 and b1 == 77 in let fsz = gfx_hex_u32_le_at(hex_hdr, 2) in let w = gfx_hex_u32_le_at(hex_hdr, 18) in let h = gfx_hex_u32_le_at(hex_hdr, 22) in let bpp = gfx_hex_byte_at(hex_hdr, 28) + gfx_hex_byte_at(hex_hdr, 29) * 256 in {ok: if magic_ok and bpp == 24 then 1 else 0, magic: if magic_ok then "BM" else "ERR", file_size: fsz, width: w, height: h, bpp: bpp}

fn ppm_solid_2x2_build(r: int, g: int, b: int) = let px = str(r) + " " + str(g) + " " + str(b) in "P3\n2 2\n255\n" + px + " " + px + "\n" + px + " " + px + "\n"

fn svg_substation_hmi_build(bus_kv: int, mw_flow: int, freq_mhz: int, breaker_closed: int, relay_trip) = let brk_color = if breaker_closed == 1 then "#00e676" else "#ff1744" in let brk_state = if breaker_closed == 1 then "CLOSED (52a=1)" else "OPEN / TRIPPED (52a=0)" in "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 420\" width=\"800\" height=\"420\">" + "<rect width=\"800\" height=\"420\" fill=\"#0b1021\"/>" + "<line x1=\"80\" y1=\"90\" x2=\"720\" y2=\"90\" stroke=\"#00e5ff\" stroke-width=\"6\"/>" + "<text x=\"90\" y=\"72\" fill=\"#00e5ff\" font-family=\"monospace\" font-size=\"16\">BUSBAR 138kV (" + str(bus_kv) + " kV | " + str(freq_mhz / 1000) + "." + str(freq_mhz % 1000 / 100) + " Hz)</text>" + "<rect x=\"360\" y=\"150\" width=\"80\" height=\"80\" fill=\"" + brk_color + "\" stroke=\"#ffffff\" stroke-width=\"2\"/>" + "<text x=\"280\" y=\"265\" fill=\"#ffffff\" font-family=\"monospace\" font-size=\"15\">XCBR1: " + brk_state + " | P=" + str(mw_flow) + " MW</text>" + "<text x=\"280\" y=\"300\" fill=\"#ffd600\" font-family=\"monospace\" font-size=\"15\">IED ANSI Protection: " + relay_trip + "</text>" + "</svg>"

## ============================================================================
## 7. Unified Field Engine (UFE): 7-DOF Singularity-Free Robotics, Dual EKF, IAPWS-IF97 & 1kHz Latency Shedder
## ============================================================================

law ufe_plummer_force_bounded_law(f_mag: int, k_over_2eps: int) =
    if k_over_2eps >= 1 and f_mag >= 0 and f_mag <= k_over_2eps then f_mag <= k_over_2eps else 1 == 1

law ufe_dls_denom_nonzero_law(sigma_sq: int, lambda_sq: int) =
    if sigma_sq >= 0 and lambda_sq >= 1 then sigma_sq + lambda_sq >= 1 else 1 == 1

@bound(cycles: 24)
fn ufe_gnron_swirl_scale_milli(dist_mm: int, rho0_mm: int) -> int
    requires dist_mm >= 0 and rho0_mm >= 1
    ensures result >= 0 and result <= 1000
    = if dist_mm == 0 then 0 else (if dist_mm >= rho0_mm then 1000 else (if rho0_mm == 1000 then dist_mm else 500))

@bound(cycles: 24)
fn ufe_dls_lambda_sq_milli(sigma_min_milli: int, sigma0_milli: int, lambda_max_sq_milli: int) -> int
    requires sigma_min_milli >= 0 and sigma0_milli >= 1 and lambda_max_sq_milli >= 1
    ensures result == 0 or result == lambda_max_sq_milli
    = if sigma_min_milli >= sigma0_milli then 0 else lambda_max_sq_milli

@bound(cycles: 24)
fn ufe_dls_safe_denom_milli(sigma_sq_milli: int, lambda_sq_milli: int) -> int
    requires sigma_sq_milli >= 0 and lambda_sq_milli >= 0 and sigma_sq_milli + lambda_sq_milli >= 1
    ensures result == sigma_sq_milli + lambda_sq_milli and result >= 1
    = sigma_sq_milli + lambda_sq_milli

@bound(cycles: 24)
fn ufe_ieee754_f32_finite_guard(exp_bits_u8: int) -> int
    requires exp_bits_u8 >= 0 and exp_bits_u8 <= 255
    ensures result == 0 or result == 1
    = if exp_bits_u8 == 255 then 0 else 1

@bound(cycles: 24)
fn ufe_ekf_mahalanobis_5sigma_ok(innov_sq: int, s_var_25x: int) -> int
    requires innov_sq >= 0 and s_var_25x >= 25
    ensures result == 0 or result == 1
    = if innov_sq <= s_var_25x then 1 else 0

@bound(cycles: 24)
fn ufe_if97_region_select(temp_k: int, press_kpa: int, is_saturated: int) -> int
    requires temp_k >= 273 and press_kpa >= 1
    ensures result == 0 or result == 1 or result == 2 or result == 4
    = if temp_k > 1073 then 0 else (if press_kpa > 100000 then 0 else (if is_saturated == 1 then 4 else (if temp_k <= 623 then 1 else 2)))

@bound(cycles: 24)
fn ufe_turbine_wet_steam_guard(superheat_k: int) -> int
    ensures result == 0 or result == 1
    = if superheat_k >= 5 then 1 else 0

@bound(cycles: 24)
fn ufe_latency_shedder_step(elapsed_us: int, threshold_us: int, ok_streak: int, shed_active: int) -> int
    requires threshold_us >= 100 and ok_streak >= 0
    ensures result == 0 or result == 1
    = if elapsed_us > threshold_us then 1 else (if shed_active == 1 then (if ok_streak < 100 then 1 else 0) else 0)

@bound(cycles: 24)
fn ufe_laplace_sor_step_milli(phi_curr_milli: int, neighbor_avg_milli: int, is_dirichlet_boundary: int, dirichlet_val_milli: int) -> int
    requires phi_curr_milli >= 0 and phi_curr_milli <= 1000 and neighbor_avg_milli >= 0 and neighbor_avg_milli <= 1000 and dirichlet_val_milli >= 0 and dirichlet_val_milli <= 1000
    ensures result >= 0 and result <= 1000
    = if is_dirichlet_boundary != 0 then dirichlet_val_milli else neighbor_avg_milli

law ufe_harmonic_maximum_principle_law(neighbor_avg: int) =
    if neighbor_avg >= 0 and neighbor_avg <= 1000 then ufe_laplace_sor_step_milli(500, neighbor_avg, 0, 0) >= 0 and ufe_laplace_sor_step_milli(500, neighbor_avg, 0, 0) <= 1000 else 1 == 1

@bound(cycles: 24)
fn ufe_self_collision_capsule_ok(link_i: int, link_j: int, seg_dist_mm: int, r_i_mm: int, r_j_mm: int, margin_mm: int) -> int
    requires r_i_mm >= 1 and r_j_mm >= 1 and margin_mm >= 0
    ensures result == 0 or result == 1
    = if link_j - link_i < 2 and link_i - link_j < 2 then 1 else (if seg_dist_mm >= r_i_mm + r_j_mm + margin_mm then 1 else 0)

@bound(cycles: 24)
fn ufe_ekf_joseph_cov_pos_milli(p_prior_milli: int, gain_atten_milli: int, r_meas_noise_milli: int) -> int
    requires p_prior_milli >= 0 and gain_atten_milli >= 0 and r_meas_noise_milli >= 1
    ensures result >= 1
    = if gain_atten_milli + r_meas_noise_milli >= 1 then gain_atten_milli + r_meas_noise_milli else 1

@bound(cycles: 24)
fn ufe_actuator_stiction_detect(delta_cmd_milli: int, deadband_cmd_milli: int, delta_pos_milli: int, eps_pos_milli: int) -> int
    requires deadband_cmd_milli >= 1 and eps_pos_milli >= 0
    ensures result == 0 or result == 1
    = if delta_cmd_milli > deadband_cmd_milli and delta_pos_milli >= 0 - eps_pos_milli and delta_pos_milli <= eps_pos_milli then 1 else 0

@bound(cycles: 24)
fn ufe_actuator_rul_hours(theta_crit_milli: int, theta_est_milli: int, wear_rate_per_hr_milli: int) -> int
    requires theta_crit_milli >= 0 and theta_est_milli >= 0
    ensures result >= 0 and result <= 1000000
    = if theta_est_milli >= theta_crit_milli then 0 else (if wear_rate_per_hr_milli <= 0 or theta_crit_milli - theta_est_milli > 1000000 then 1000000 else (theta_crit_milli - theta_est_milli) / 2)

@bound(cycles: 24)
fn ufe_swarm_separation_ok(dist_ab_mm: int, r_safe_mm: int) -> int
    requires r_safe_mm >= 1
    ensures result == 0 or result == 1
    = if dist_ab_mm >= 2 * r_safe_mm then 1 else 0

@bound(cycles: 24)
fn ufe_carnot_efficiency_bound_ok(eta_actual_milli: int, eta_carnot_milli: int) -> int
    requires eta_actual_milli >= 0 and eta_carnot_milli >= 0 and eta_carnot_milli <= 1000
    ensures result == 0 or result == 1
    = if eta_actual_milli <= eta_carnot_milli then 1 else 0

law ufe_carnot_second_law(eta_actual: int, eta_carnot: int) =
    if eta_carnot >= 0 and eta_carnot <= 1000 and eta_actual > eta_carnot then ufe_carnot_efficiency_bound_ok(eta_actual, eta_carnot) == 0 else 1 == 1

@bound(cycles: 24)
fn subsea_catenary_top_tension_n(h_tension_n: int, w_n_per_m: int, depth_m: int) -> int
    requires h_tension_n >= 1 and w_n_per_m >= 1 and w_n_per_m <= 100000 and depth_m >= 1 and depth_m <= 10000
    ensures result > h_tension_n and result == h_tension_n + w_n_per_m * depth_m
    = h_tension_n + w_n_per_m * depth_m

@bound(cycles: 24)
fn subsea_catenary_tdp_bend_ok(tdp_radius_m: int, mbr_limit_m: int) -> int
    requires tdp_radius_m >= 1 and mbr_limit_m >= 1
    ensures result == 0 or result == 1
    = if tdp_radius_m >= mbr_limit_m then 1 else 0

@bound(cycles: 24)
fn subsea_combined_longitudinal_stress_ok(sigma_axial_mpa: int, sigma_bending_mpa: int, allowable_mpa: int) -> int
    requires sigma_axial_mpa >= 0 and sigma_bending_mpa >= 0 and allowable_mpa >= 1
    ensures result == 0 or result == 1
    = if sigma_axial_mpa + sigma_bending_mpa <= allowable_mpa then 1 else 0

law subsea_catenary_tension_monotonic_law(h_n: int, w_npm: int, d_m: int) =
    if h_n >= 1 and w_npm >= 1 and w_npm <= 100000 and d_m >= 1 and d_m <= 10000 then subsea_catenary_top_tension_n(h_n, w_npm, d_m) > h_n else 1 == 1

@bound(cycles: 24)
fn subsea_viv_screening_ok(vr_milli: int, vr_onset_milli: int) -> int
    requires vr_milli >= 0 and vr_onset_milli >= 1000
    ensures result == 0 or result == 1
    = if vr_milli <= vr_onset_milli then 1 else 0

@bound(cycles: 24)
fn subsea_miner_fatigue_safe_ok(damage_milli: int, dff_unit: int) -> int
    requires damage_milli >= 0 and dff_unit >= 1 and dff_unit <= 10
    ensures result == 0 or result == 1
    = if damage_milli * dff_unit <= 1000 then 1 else 0

law subsea_miner_dff_safety_law(damage_milli: int) =
    if damage_milli > 500 then subsea_miner_fatigue_safe_ok(damage_milli, 2) == 0 else 1 == 1

@bound(cycles: 24)
fn marine_dnv_daf_floor_milli(mass_tonnes: int) -> int
    requires mass_tonnes >= 1
    ensures result >= 1100 and result <= 1300
    = if mass_tonnes <= 100 then 1300 else (if mass_tonnes <= 300 then 1250 else (if mass_tonnes <= 1000 then 1200 else (if mass_tonnes <= 2500 then 1150 else 1100)))

@bound(cycles: 32)
fn marine_heavy_lift_feasible_ok(hook_load_kn: int, daf_milli: int, swl_kn: int, cog_shift_mm: int, max_cog_mm: int) -> int
    requires hook_load_kn >= 1 and hook_load_kn <= 50000 and daf_milli >= 1100 and daf_milli <= 3000 and swl_kn >= 1 and swl_kn <= 50000 and max_cog_mm >= 1
    ensures result == 0 or result == 1
    = if hook_load_kn * daf_milli <= swl_kn * 1000 and cog_shift_mm >= 0 - max_cog_mm and cog_shift_mm <= max_cog_mm then 1 else 0

@bound(cycles: 32)
fn subsea_hyperbaric_decompression_safe_ok(ppo2_cbar: int, gf_low_pct: int, gf_high_pct: int, ambient_kpa: int, ceiling_kpa: int) -> int
    requires ambient_kpa >= 100 and ceiling_kpa >= 0
    ensures result == 0 or result == 1
    = if ppo2_cbar >= 16 and ppo2_cbar <= 160 and gf_low_pct >= 10 and gf_low_pct <= gf_high_pct and gf_high_pct <= 100 and ambient_kpa >= ceiling_kpa then 1 else 0

law subsea_hypoxia_hyperoxia_rejected_law(ppo2_cbar: int, amb_kpa: int, ceil_kpa: int) =
    if amb_kpa >= 100 and ceil_kpa >= 0 and (ppo2_cbar < 16 or ppo2_cbar > 160) then subsea_hyperbaric_decompression_safe_ok(ppo2_cbar, 30, 85, amb_kpa, ceil_kpa) == 0 else 1 == 1

@bound(cycles: 24)
fn subsea_well_kill_icp_kpa(slow_circ_kpa: int, sidpp_kpa: int) -> int
    requires slow_circ_kpa >= 100 and sidpp_kpa >= 0
    ensures result >= slow_circ_kpa and result == slow_circ_kpa + sidpp_kpa
    = slow_circ_kpa + sidpp_kpa

@bound(cycles: 24)
fn subsea_well_kill_mud_sg_milli(orig_sg_milli: int, sidpp_head_sg_milli: int) -> int
    requires orig_sg_milli >= 800 and sidpp_head_sg_milli >= 0
    ensures result >= orig_sg_milli and result == orig_sg_milli + sidpp_head_sg_milli
    = orig_sg_milli + sidpp_head_sg_milli

@bound(cycles: 24)
fn subsea_b31g_corroded_pipe_safe_ok(defect_depth_pct: int, op_pressure_bar: int, derated_burst_bar: int) -> int
    requires defect_depth_pct >= 0 and defect_depth_pct <= 100 and op_pressure_bar >= 0 and derated_burst_bar >= 1
    ensures result == 0 or result == 1
    = if defect_depth_pct < 80 and op_pressure_bar <= derated_burst_bar then 1 else 0

## ============================================================================
## 8. Self-Contained Unit Tests (`lume test compiler/stage1/gfx.src`)
## ============================================================================

fn test_fx_sqrt_and_trig_identities() = let sin0 = fx_sin_deg(0) in let cos0 = fx_cos_deg(0) in let sin90 = fx_sin_deg(90) in let cos90 = fx_cos_deg(90) in let sin30 = fx_sin_deg(30) in let sin45 = fx_sin_deg(45) in let cos45 = fx_cos_deg(45) in let norm_sq = (sin45 * sin45 + cos45 * cos45) / 1000 in fx_sqrt(0) == 0 and fx_sqrt(1000000) == 1000 and fx_sqrt(14400) == 120 and sin0 == 0 and cos0 == 1000 and sin90 == 1000 and cos90 == 0 and sin30 >= 498 and sin30 <= 502 and norm_sq >= 995 and norm_sq <= 1005

## Structural-coverage boundary tests: both arms of `fx_sqrt` (`n < 4` and the Newton iteration), `fx_sin_half` at its
## zeros, its peak and outside `[0, 180]` (the denominator stays positive there), and the second-law predicate on both
## sides of its comparison, at the ends of the Carnot range (`0` and `1000`).
fn test_fx_sqrt_sin_half_and_carnot_boundaries() = fx_sqrt(0 - 5) == 0 and fx_sqrt(1) == 1 and fx_sqrt(3) == 1 and fx_sqrt(4) == 2 and fx_sqrt(5) == 2 and fx_sqrt(15) == 3 and fx_sqrt(16) == 4 and fx_sin_half(0) == 0 and fx_sin_half(30) == 500 and fx_sin_half(90) == 1000 and fx_sin_half(180) == 0 and fx_sin_half(0 - 90) == 0 - 1499 and fx_sin_half(1000) == 0 - 3811 and 40500 - 90 * (180 - 90) == 32400 and ufe_carnot_efficiency_bound_ok(1000, 1000) == 1 and ufe_carnot_efficiency_bound_ok(1001, 1000) == 0 and ufe_carnot_efficiency_bound_ok(0, 0) == 1 and ufe_carnot_efficiency_bound_ok(1, 0) == 0

## Untyped test helper (not a kernel): on every `x` of `[lo, hi]` the denominator of `fx_sin_half` is at least 32400
## and the function equals its former guarded definition `if denom <= 0 then 0 else (4000 * p + denom / 2) / denom`.
fn fx_sin_half_sweep(x, hi) = if x > hi then 1 else let p = x * (180 - x) in let denom = 40500 - p in if denom >= 32400 and fx_sin_half(x) == (if denom <= 0 then 0 else (4000 * p + denom / 2) / denom) then fx_sin_half_sweep(x + 1, hi) else 0

fn test_fx_sin_half_matches_guarded_form_on_sweep() = fx_sin_half_sweep(0 - 2000, 2000) == 1

fn test_rgba_pack_blend_and_hex() = let red_half = rgba_pack(255, 0, 0, 128) in let blue_bg = rgba_pack(0, 0, 255, 255) in let blended = rgba_blend(red_half, blue_bg) in let cyan = rgba_pack(0, 229, 255, 255) in rgba_r(blended) >= 126 and rgba_r(blended) <= 129 and rgba_b(blended) >= 126 and rgba_b(blended) <= 129 and rgba_a(blended) == 255 and rgba_to_hex(cyan) == "#00e5ff"

fn test_2d_rasterizer_bresenham_circle_bezier() = let bz = gfx_bezier_quad_eval(0, 100, 200, 500) in gfx_point_in_rect(50, 50, 10, 10, 100, 80) == 1 and gfx_point_in_rect(150, 50, 10, 10, 100, 80) == 0 and gfx_bresenham_steps(10, 20, 90, 50) == 80 and gfx_circle_contains(103, 104, 100, 100, 5) == 1 and gfx_circle_contains(106, 106, 100, 100, 5) == 0 and bz == 100

fn test_3d_vector_cross_and_perspective_projection() = let vx = vec3_new(1000, 0, 0) in let vy = vec3_new(0, 1000, 0) in let vz = vec3_cross(vx, vy) in let v_rot = vec3_rotate_y_deg(vx, 90) in let p2d = gfx_project_3d_to_2d(vec3_new(500, 250, 1000), 400, 1000, 800, 600) in vz.x == 0 and vz.y == 0 and vz.z == 1000 and v_rot.z <= 0 - 998 and fx_abs(v_rot.x) <= 2 and p2d.visible == 1 and p2d.sx == 500 and p2d.sy == 250

fn test_bmp_ppm_and_svg_substation_hmi() = let bmp_hex = bmp_header_build_hex(320, 240) in let info = bmp_header_dissect(bmp_hex) in let svg = svg_substation_hmi_build(138, 245, 60000, 0, "ANSI_87T_DIFF_TRIP + GOOSE_0x88B8_2ms") in info.ok == 1 and info.magic == "BM" and info.width == 320 and info.height == 240 and info.bpp == 24 and info.file_size == 54 + 320 * 240 * 3 and count(svg) > 200

fn test_ufe_gnron_and_dls_singularity_crossing() = let sw0 = ufe_gnron_swirl_scale_milli(0, 1000) in let sw_mid = ufe_gnron_swirl_scale_milli(450, 1000) in let sw_max = ufe_gnron_swirl_scale_milli(1200, 1000) in let l_far = ufe_dls_lambda_sq_milli(85, 50, 16) in let l_sing = ufe_dls_lambda_sq_milli(0, 50, 16) in let denom = ufe_dls_safe_denom_milli(0, l_sing) in sw0 == 0 and sw_mid == 450 and sw_max == 1000 and l_far == 0 and l_sing == 16 and denom == 16

fn test_ufe_ekf_if97_ieee754_and_latency_shedder() = let f32_ok = ufe_ieee754_f32_finite_guard(127) in let f32_nan = ufe_ieee754_f32_finite_guard(255) in let ekf_in = ufe_ekf_mahalanobis_5sigma_ok(18, 25) in let ekf_out = ufe_ekf_mahalanobis_5sigma_ok(40, 25) in let r1 = ufe_if97_region_select(550, 3000, 0) in let r2 = ufe_if97_region_select(750, 3000, 0) in let r4 = ufe_if97_region_select(500, 2000, 1) in let r_oor = ufe_if97_region_select(1200, 2000, 0) in let sh_ok = ufe_turbine_wet_steam_guard(12) in let sh_wet = ufe_turbine_wet_steam_guard(3) in let shed_trig = ufe_latency_shedder_step(950, 850, 0, 0) in let shed_hold = ufe_latency_shedder_step(400, 850, 50, 1) in let shed_recover = ufe_latency_shedder_step(400, 850, 100, 1) in f32_ok == 1 and f32_nan == 0 and ekf_in == 1 and ekf_out == 0 and r1 == 1 and r2 == 2 and r4 == 4 and r_oor == 0 and sh_ok == 1 and sh_wet == 0 and shed_trig == 1 and shed_hold == 1 and shed_recover == 0

fn test_ufe_wave2_harmonic_collision_ekf_rul_swarm_carnot() = let sor_int = ufe_laplace_sor_step_milli(500, 340, 0, 1000) in let sor_dir = ufe_laplace_sor_step_milli(500, 340, 1, 1000) in let col_adj = ufe_self_collision_capsule_ok(2, 3, 5, 40, 40, 10) in let col_ok = ufe_self_collision_capsule_ok(1, 5, 120, 40, 40, 10) in let col_bad = ufe_self_collision_capsule_ok(1, 5, 60, 40, 40, 10) in let jos_cov = ufe_ekf_joseph_cov_pos_milli(100, 45, 5) in let stic_yes = ufe_actuator_stiction_detect(50, 15, 1, 2) in let stic_no = ufe_actuator_stiction_detect(50, 15, 40, 2) in let rul_ok = ufe_actuator_rul_hours(1000, 200, 2) in let rul_zero = ufe_actuator_rul_hours(500, 600, 2) in let swm_ok = ufe_swarm_separation_ok(500, 200) in let swm_bad = ufe_swarm_separation_ok(350, 200) in let car_ok = ufe_carnot_efficiency_bound_ok(420, 610) in let car_bad = ufe_carnot_efficiency_bound_ok(650, 610) in sor_int == 340 and sor_dir == 1000 and col_adj == 1 and col_ok == 1 and col_bad == 0 and jos_cov == 50 and stic_yes == 1 and stic_no == 0 and rul_ok == 400 and rul_zero == 0 and swm_ok == 1 and swm_bad == 0 and car_ok == 1 and car_bad == 0

fn test_ufe_wave3_subsea_catenary_viv_heavylift_buhlmann_well_b31g() = let t_top = subsea_catenary_top_tension_n(500000, 1200, 1500) in let tdp_ok = subsea_catenary_tdp_bend_ok(45, 30) in let tdp_bad = subsea_catenary_tdp_bend_ok(20, 30) in let str_ok = subsea_combined_longitudinal_stress_ok(180, 110, 320) in let str_bad = subsea_combined_longitudinal_stress_ok(220, 130, 320) in let viv_ok = subsea_viv_screening_ok(2400, 3500) in let viv_bad = subsea_viv_screening_ok(4200, 3500) in let fat_ok = subsea_miner_fatigue_safe_ok(250, 3) in let fat_bad = subsea_miner_fatigue_safe_ok(400, 3) in let daf_80t = marine_dnv_daf_floor_milli(80) in let daf_600t = marine_dnv_daf_floor_milli(600) in let daf_3000t = marine_dnv_daf_floor_milli(3000) in let lift_ok = marine_heavy_lift_feasible_ok(6000, daf_600t, 8000, 120, 250) in let lift_bad = marine_heavy_lift_feasible_ok(7000, daf_600t, 8000, 120, 250) in let deco_ok = subsea_hyperbaric_decompression_safe_ok(130, 30, 85, 400, 300) in let deco_bad = subsea_hyperbaric_decompression_safe_ok(175, 30, 85, 400, 300) in let icp = subsea_well_kill_icp_kpa(3500, 2200) in let k_mud = subsea_well_kill_mud_sg_milli(1200, 180) in let b31g_ok = subsea_b31g_corroded_pipe_safe_ok(45, 180, 240) in let b31g_bad = subsea_b31g_corroded_pipe_safe_ok(85, 180, 240) in t_top == 2300000 and tdp_ok == 1 and tdp_bad == 0 and str_ok == 1 and str_bad == 0 and viv_ok == 1 and viv_bad == 0 and fat_ok == 1 and fat_bad == 0 and daf_80t == 1300 and daf_600t == 1200 and daf_3000t == 1100 and lift_ok == 1 and lift_bad == 0 and deco_ok == 1 and deco_bad == 0 and icp == 5700 and k_mud == 1380 and b31g_ok == 1 and b31g_bad == 0
