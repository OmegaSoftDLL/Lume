## std.gfx (`compiler/stage1/gfx.src`) — Native 100%-Lume 2D/3D Graphics, Fixed-Point Math,
## Framebuffer Rasterizer, 3D Pinhole Perspective Projection, and Binary BMP / PPM / Vector SVG Engine.
## Zero-C, Zero external dependencies (`libpng`/`cairo`/`opengl` not required).

## ============================================================================
## 1. Fixed-Point Math & Trigonometry (`scale = 1000`, `1.000 == 1000`)
## ============================================================================

@bound(cycles: 16)
fn fx_abs(x: int) -> int
    ensures result >= 0
    = if x < 0 then 0 - x else x

@bound(cycles: 24)
fn fx_clamp(x: int, lo: int, hi: int) -> int
    requires lo <= hi
    ensures result >= lo and result <= hi
    = if x < lo then lo else (if x > hi then hi else x)

@bound(cycles: 32)
fn fx_lerp(a: int, b: int, t_permil: int) -> int =
    a + ((b - a) * t_permil) / 1000

fn fx_sqrt_iter(n: int, guess: int, steps: int) -> int =
    if steps <= 0 or guess <= 0 then guess
    else
        let next = (guess + n / guess) / 2 in
        if next >= guess then guess else fx_sqrt_iter(n, next, steps - 1)

fn fx_sqrt(n: int) -> int =
    if n <= 0 then 0
    else if n < 4 then 1
    else fx_sqrt_iter(n, n / 2 + 1, 32)

fn fx_norm_deg(deg: int) -> int =
    let m = deg % 360 in
    if m < 0 then m + 360 else m

## Bhaskara I parabolic sine approximation in `[-1000..1000]` for `deg in [0..360)`:
## `sin(x) ~= 4 * x * (180 - x) / (40500 - x * (180 - x))` with < 0.16% max error.
fn fx_sin_half(x: int) -> int =
    let p = x * (180 - x) in
    let denom = 40500 - p in
    if denom <= 0 then 0 else (4000 * p + denom / 2) / denom

fn fx_sin_deg(deg: int) -> int =
    let d = fx_norm_deg(deg) in
    if d <= 180 then fx_sin_half(d) else 0 - fx_sin_half(d - 180)

fn fx_cos_deg(deg: int) -> int =
    fx_sin_deg(deg + 90)

## ============================================================================
## 2. RGBA Color Packing & Porter-Duff Source-Over Alpha Blending
## ============================================================================

@bound(cycles: 32)
fn rgba_pack(r: int, g: int, b: int, a: int) -> int
    requires r >= 0 and r <= 255
    requires g >= 0 and g <= 255
    requires b >= 0 and b <= 255
    requires a >= 0 and a <= 255
    ensures result >= 0
    = ((r * 256 + g) * 256 + b) * 256 + a

@bound(cycles: 24)
fn rgba_r(c: int) -> int
    requires c >= 0
    ensures result >= 0 and result <= 255
    = (c / 16777216) % 256

@bound(cycles: 24)
fn rgba_g(c: int) -> int
    requires c >= 0
    ensures result >= 0 and result <= 255
    = (c / 65536) % 256

@bound(cycles: 24)
fn rgba_b(c: int) -> int
    requires c >= 0
    ensures result >= 0 and result <= 255
    = (c / 256) % 256

@bound(cycles: 24)
fn rgba_a(c: int) -> int
    requires c >= 0
    ensures result >= 0 and result <= 255
    = c % 256

fn rgba_blend(fg: int, bg: int) -> int =
    let a = rgba_a(fg) in
    let inv_a = 255 - a in
    let r = (rgba_r(fg) * a + rgba_r(bg) * inv_a) / 255 in
    let g = (rgba_g(fg) * a + rgba_g(bg) * inv_a) / 255 in
    let b = (rgba_b(fg) * a + rgba_b(bg) * inv_a) / 255 in
    rgba_pack(fx_clamp(r, 0, 255), fx_clamp(g, 0, 255), fx_clamp(b, 0, 255), 255)

fn gfx_hex_nib(n: int) =
    let v = (n % 16 + 16) % 16 in
    slice("0123456789abcdef", v, v + 1)

fn gfx_hex_u8(b: int) =
    let v = (b % 256 + 256) % 256 in
    gfx_hex_nib(v / 16) + gfx_hex_nib(v % 16)

fn gfx_hex_u16_le(v: int) =
    let u = (v % 65536 + 65536) % 65536 in
    gfx_hex_u8(u % 256) + gfx_hex_u8((u / 256) % 256)

fn gfx_hex_u32_le(v: int) =
    let lo = v % 65536 in
    let hi = (v / 65536) % 65536 in
    gfx_hex_u16_le(lo) + gfx_hex_u16_le(hi)

fn rgba_to_hex(c: int) =
    "#" + gfx_hex_u8(rgba_r(c)) + gfx_hex_u8(rgba_g(c)) + gfx_hex_u8(rgba_b(c))

## ============================================================================
## 3. 2D Rasterizer Geometry (Rect, Bresenham Line, Circle, Quadratic Bezier)
## ============================================================================

@bound(cycles: 32)
fn gfx_point_in_rect(px: int, py: int, rx: int, ry: int, rw: int, rh: int) -> int
    requires rw >= 0 and rh >= 0
    ensures result >= 0 and result <= 1
    = if px >= rx then (if px < rx + rw then (if py >= ry then (if py < ry + rh then 1 else 0) else 0) else 0) else 0

@bound(cycles: 48)
fn gfx_bresenham_steps(x0: int, y0: int, x1: int, y1: int) -> int =
    let dx = fx_abs(x1 - x0) in
    let dy = fx_abs(y1 - y0) in
    if dx >= dy then dx else dy

fn gfx_circle_contains(px: int, py: int, cx: int, cy: int, radius: int) -> int =
    if radius < 0 then 0
    else
        let dx = px - cx in
        let dy = py - cy in
        if dx * dx + dy * dy <= radius * radius then 1 else 0

fn gfx_bezier_quad_eval(p0: int, p1: int, p2: int, t_permil: int) -> int =
    let t = fx_clamp(t_permil, 0, 1000) in
    let a = fx_lerp(p0, p1, t) in
    let b = fx_lerp(p1, p2, t) in
    fx_lerp(a, b, t)

## ============================================================================
## 4. 3D Vector Math & Pinhole Perspective Projection Pipeline
## ============================================================================

fn vec3_new(x: int, y: int, z: int) =
    {x: x, y: y, z: z}

fn vec3_add(a, b) =
    {x: a.x + b.x, y: a.y + b.y, z: a.z + b.z}

fn vec3_sub(a, b) =
    {x: a.x - b.x, y: a.y - b.y, z: a.z - b.z}

fn vec3_dot(a, b) -> int =
    (a.x * b.x + a.y * b.y + a.z * b.z) / 1000

fn vec3_cross(a, b) =
    {
        x: (a.y * b.z - a.z * b.y) / 1000,
        y: (a.z * b.x - a.x * b.z) / 1000,
        z: (a.x * b.y - a.y * b.x) / 1000
    }

fn vec3_rotate_y_deg(v, deg: int) =
    let s = fx_sin_deg(deg) in
    let c = fx_cos_deg(deg) in
    {
        x: (v.x * c + v.z * s) / 1000,
        y: v.y,
        z: (0 - v.x * s + v.z * c) / 1000
    }

fn vec3_rotate_x_deg(v, deg: int) =
    let s = fx_sin_deg(deg) in
    let c = fx_cos_deg(deg) in
    {
        x: v.x,
        y: (v.y * c - v.z * s) / 1000,
        z: (v.y * s + v.z * c) / 1000
    }

fn gfx_project_3d_to_2d(v, fov_focal: int, cam_z_offset: int, screen_w: int, screen_h: int) =
    let dz = v.z + cam_z_offset in
    if dz <= 10 then
        {sx: screen_w / 2, sy: screen_h / 2, depth_z: dz, visible: 0}
    else
        let sx = screen_w / 2 + (v.x * fov_focal) / dz in
        let sy = screen_h / 2 - (v.y * fov_focal) / dz in
        let vis = gfx_point_in_rect(sx, sy, 0, 0, screen_w, screen_h) in
        {sx: sx, sy: sy, depth_z: dz, visible: vis}

## ============================================================================
## 5. Binary BMP (`BM` 54-byte Header), Netpbm PPM & Vector SVG Substation HMI
## ============================================================================

fn gfx_hex_nibble_val(c) -> int =
    if c >= "0" and c <= "9" then ord(c) - 48
    else if c >= "a" and c <= "f" then ord(c) - 87
    else if c >= "A" and c <= "F" then ord(c) - 55
    else 0

fn gfx_hex_byte_at(hex, byte_idx: int) -> int =
    let pos = byte_idx * 2 in
    if pos + 2 > count(hex) then 0
    else gfx_hex_nibble_val(at(hex, pos)) * 16 + gfx_hex_nibble_val(at(hex, pos + 1))

fn gfx_hex_u32_le_at(hex, byte_idx: int) -> int =
    gfx_hex_byte_at(hex, byte_idx) +
    gfx_hex_byte_at(hex, byte_idx + 1) * 256 +
    gfx_hex_byte_at(hex, byte_idx + 2) * 65536 +
    gfx_hex_byte_at(hex, byte_idx + 3) * 16777216

fn bmp_header_build_hex(width: int, height: int) =
    let row_stride = ((width * 3 + 3) / 4) * 4 in
    let pix_bytes = row_stride * height in
    let file_size = 54 + pix_bytes in
    "424d" +
    gfx_hex_u32_le(file_size) +
    "00000000" +
    gfx_hex_u32_le(54) +
    gfx_hex_u32_le(40) +
    gfx_hex_u32_le(width) +
    gfx_hex_u32_le(height) +
    gfx_hex_u16_le(1) +
    gfx_hex_u16_le(24) +
    gfx_hex_u32_le(0) +
    gfx_hex_u32_le(pix_bytes) +
    gfx_hex_u32_le(2835) +
    gfx_hex_u32_le(2835) +
    gfx_hex_u32_le(0) +
    gfx_hex_u32_le(0)

fn bmp_header_dissect(hex_hdr) =
    if count(hex_hdr) < 108 then
        {ok: 0, magic: "", file_size: 0, width: 0, height: 0, bpp: 0}
    else
        let b0 = gfx_hex_byte_at(hex_hdr, 0) in
        let b1 = gfx_hex_byte_at(hex_hdr, 1) in
        let magic_ok = b0 == 66 and b1 == 77 in
        let fsz = gfx_hex_u32_le_at(hex_hdr, 2) in
        let w = gfx_hex_u32_le_at(hex_hdr, 18) in
        let h = gfx_hex_u32_le_at(hex_hdr, 22) in
        let bpp = gfx_hex_byte_at(hex_hdr, 28) + gfx_hex_byte_at(hex_hdr, 29) * 256 in
        {ok: if magic_ok and bpp == 24 then 1 else 0, magic: if magic_ok then "BM" else "ERR", file_size: fsz, width: w, height: h, bpp: bpp}

fn ppm_solid_2x2_build(r: int, g: int, b: int) =
    let px = str(r) + " " + str(g) + " " + str(b) in
    "P3\n2 2\n255\n" + px + " " + px + "\n" + px + " " + px + "\n"

fn svg_substation_hmi_build(bus_kv: int, mw_flow: int, freq_mhz: int, breaker_closed: int, relay_trip) =
    let brk_color = if breaker_closed == 1 then "#00e676" else "#ff1744" in
    let brk_state = if breaker_closed == 1 then "CLOSED (52a=1)" else "OPEN / TRIPPED (52a=0)" in
    "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 800 420\" width=\"800\" height=\"420\">" +
    "<rect width=\"800\" height=\"420\" fill=\"#0b1021\"/>" +
    "<line x1=\"80\" y1=\"90\" x2=\"720\" y2=\"90\" stroke=\"#00e5ff\" stroke-width=\"6\"/>" +
    "<text x=\"90\" y=\"72\" fill=\"#00e5ff\" font-family=\"monospace\" font-size=\"16\">BUSBAR 138kV (" + str(bus_kv) + " kV | " + str(freq_mhz / 1000) + "." + str((freq_mhz % 1000) / 100) + " Hz)</text>" +
    "<rect x=\"360\" y=\"150\" width=\"80\" height=\"80\" fill=\"" + brk_color + "\" stroke=\"#ffffff\" stroke-width=\"2\"/>" +
    "<text x=\"280\" y=\"265\" fill=\"#ffffff\" font-family=\"monospace\" font-size=\"15\">XCBR1: " + brk_state + " | P=" + str(mw_flow) + " MW</text>" +
    "<text x=\"280\" y=\"300\" fill=\"#ffd600\" font-family=\"monospace\" font-size=\"15\">IED ANSI Protection: " + relay_trip + "</text>" +
    "</svg>"

## ============================================================================
## 6. Self-Contained Unit Tests (`lume test compiler/stage1/gfx.src`)
## ============================================================================

fn test_fx_sqrt_and_trig_identities() =
    let sin0 = fx_sin_deg(0) in
    let cos0 = fx_cos_deg(0) in
    let sin90 = fx_sin_deg(90) in
    let cos90 = fx_cos_deg(90) in
    let sin30 = fx_sin_deg(30) in
    let sin45 = fx_sin_deg(45) in
    let cos45 = fx_cos_deg(45) in
    let norm_sq = (sin45 * sin45 + cos45 * cos45) / 1000 in
    fx_sqrt(0) == 0 and fx_sqrt(1000000) == 1000 and fx_sqrt(14400) == 120 and sin0 == 0 and cos0 == 1000 and sin90 == 1000 and cos90 == 0 and sin30 >= 498 and sin30 <= 502 and norm_sq >= 995 and norm_sq <= 1005

fn test_rgba_pack_blend_and_hex() =
    let red_half = rgba_pack(255, 0, 0, 128) in
    let blue_bg = rgba_pack(0, 0, 255, 255) in
    let blended = rgba_blend(red_half, blue_bg) in
    let cyan = rgba_pack(0, 229, 255, 255) in
    rgba_r(blended) >= 126 and rgba_r(blended) <= 129 and rgba_b(blended) >= 126 and rgba_b(blended) <= 129 and rgba_a(blended) == 255 and rgba_to_hex(cyan) == "#00e5ff"

fn test_2d_rasterizer_bresenham_circle_bezier() =
    let bz = gfx_bezier_quad_eval(0, 100, 200, 500) in
    gfx_point_in_rect(50, 50, 10, 10, 100, 80) == 1 and gfx_point_in_rect(150, 50, 10, 10, 100, 80) == 0 and gfx_bresenham_steps(10, 20, 90, 50) == 80 and gfx_circle_contains(103, 104, 100, 100, 5) == 1 and gfx_circle_contains(106, 106, 100, 100, 5) == 0 and bz == 100

fn test_3d_vector_cross_and_perspective_projection() =
    let vx = vec3_new(1000, 0, 0) in
    let vy = vec3_new(0, 1000, 0) in
    let vz = vec3_cross(vx, vy) in
    let v_rot = vec3_rotate_y_deg(vx, 90) in
    let p2d = gfx_project_3d_to_2d(vec3_new(500, 250, 1000), 400, 1000, 800, 600) in
    vz.x == 0 and vz.y == 0 and vz.z == 1000 and v_rot.z <= 0 - 998 and fx_abs(v_rot.x) <= 2 and p2d.visible == 1 and p2d.sx == 500 and p2d.sy == 250

fn test_bmp_ppm_and_svg_substation_hmi() =
    let bmp_hex = bmp_header_build_hex(320, 240) in
    let info = bmp_header_dissect(bmp_hex) in
    let svg = svg_substation_hmi_build(138, 245, 60000, 0, "ANSI_87T_DIFF_TRIP + GOOSE_0x88B8_2ms") in
    info.ok == 1 and info.magic == "BM" and info.width == 320 and info.height == 240 and info.bpp == 24 and info.file_size == 54 + 320 * 240 * 3 and count(svg) > 200
