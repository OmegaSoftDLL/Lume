## lfmt.src -- Lume's canonical source formatter written in Lume-Core (Track T, brick T2).
## Implements Principle P25 ("One canonical format; no style wars, no configuration knobs").
## Reads a Lume-Core (.src) program from stdin, parses each top-level declaration/statement into
## an AST while preserving `##` documentation/section comments and logical blank-line groupings,
## and emits the unique canonical representation:
##   - 4-space indented `match` arms with vertically aligned `=>` arrows
##   - precedence-aware minimal parenthesisation (strips redundant parens like `(2 * 3) + 4`
##     while preserving required parens like `(2 + 3) * 4` and right-nested `a - (b - c)`)
##   - canonical single-space operator, comma, and record `{k: v}` layout
##   - trailing whitespace stripped and multiple blank lines collapsed to at most one.
## Guarantees both idempotence (`lfmt(lfmt(x)) == lfmt(x)`) and codegen invariance
## (`lumec(lfmt(x)) == lumec(x)` byte-for-byte). The second one is enforced, not assumed: the parser here knows only
## part of the language, so a statement is replaced only when the compiler's own parser reads the same program from
## both texts and the statement holds no comment to lose. Anything else stays as it was written.
use lumec

## --- hot character classes & per-statement O(n) lexer (placed first for fast lookup) ---
fn lf_isws(c) = c == " " or c == "\t" or c == "\r"
fn lf_isdigit(c) = c >= "0" and c <= "9"
fn lf_isalpha(c) = c >= "a" and c <= "z" or c >= "A" and c <= "Z" or c == "_"
fn lf_isalnum(c) = lf_isdigit(c) or lf_isalpha(c)
fn lf_isctor(name) = if count(name) == 0 then 0 else let c = at(name, 0) in c >= "A" and c <= "Z"

fn lf_nlpos(s, n, i) = if i >= n then i else if at(s, i) == "\n" then i else lf_nlpos(s, n, i + 1)
fn lf_skipws(s, i, n) = if i >= n then i else if lf_isws(at(s, i)) then lf_skipws(s, i + 1, n) else i
fn lf_rtrimend(s, e) = if e <= 0 then 0 else if lf_isws(at(s, e - 1)) then lf_rtrimend(s, e - 1) else e
fn lf_rtrim(s) = let n = count(s) in slicen(s, n, 0, lf_rtrimend(s, n))
fn lf_ltrim(s) = let n = count(s) in let a = lf_skipws(s, 0, n) in if a >= n then "" else slicen(s, n, a, n)
fn lf_startswith(s, p) = if count(s) < count(p) then 0 else slice(s, 0, count(p)) == p
fn lf_isindented(raw) = if count(raw) == 0 then 0 else lf_isws(at(raw, 0))

fn lf_idend(s, i, n) = if i >= n then i else if lf_isalnum(at(s, i)) then lf_idend(s, i + 1, n) else i
fn lf_numend(s, i, n) = if i >= n then i else if lf_isdigit(at(s, i)) then lf_numend(s, i + 1, n) else i
fn lf_strend(s, i, n) = if i >= n then i else if at(s, i) == "\"" then i + 1 else if at(s, i) == "\\" then lf_strend(s, i + 2, n) else lf_strend(s, i + 1, n)

fn lf_two(s, i, n) = slicen(s, n, i, if i + 2 > n then n else i + 2)
fn lf_istwo(t) = t == "==" or t == "!=" or t == "<=" or t == ">="

fn lf_lex(s, i, n) = if i >= n then Nil else let c = at(s, i) in if lf_isws(c) or c == "\n" then lf_lex(s, i + 1, n) else if c == "#" then lf_lex(s, lf_nlpos(s, n, i), n) else if lf_isdigit(c) then let e = lf_numend(s, i, n) in Cons({kind: "int", text: slicen(s, n, i, e)}, lf_lex(s, e, n)) else if lf_isalpha(c) then let e = lf_idend(s, i, n) in Cons({kind: "id", text: slicen(s, n, i, e)}, lf_lex(s, e, n)) else if c == "\"" then let e = lf_strend(s, i + 1, n) in Cons({kind: "str", text: slicen(s, n, i, e)}, lf_lex(s, e, n)) else if lf_istwo(lf_two(s, i, n)) then Cons({kind: "op", text: lf_two(s, i, n)}, lf_lex(s, i + 2, n)) else Cons({kind: "op", text: c}, lf_lex(s, i + 1, n))
fn lf_lexall(s) = lf_lex(s, 0, count(s))

## --- list & string helpers (O(n log k) pairwise join, O(n) length-threaded line split) ---
fn lf_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, lf_app(t, ys))
fn lf_isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn lf_imax(a, b) = if a > b then a else b
fn lf_pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => lf_pairs2(a, t)
fn lf_pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, lf_pairs(r))
fn lf_joinall(xs) = match xs
    Nil        => ""
    Cons(a, t) => if lf_isnil(t) == 1 then a else lf_joinall(lf_pairs(xs))
fn lf_joinsep(xs, sep) = match xs
    Nil        => ""
    Cons(h, t) => if lf_isnil(t) == 1 then h else h + sep + lf_joinsep(t, sep)

fn lf_spaces(k) = if k <= 0 then "" else " " + lf_spaces(k - 1)
fn lf_padright(s, w) = s + lf_spaces(w - count(s))

fn lf_splitlinesn(s, n, i) = if i >= n then Nil else let e = lf_nlpos(s, n, i) in Cons(slicen(s, n, i, e), lf_splitlinesn(s, n, if e >= n then e else e + 1))
fn lf_splitlines(s) = lf_splitlinesn(s, count(s), 0)

## --- token-stream helpers ---
fn lf_headtext(ts) = match ts
    Nil        => ""
    Cons(h, t) => h.text
fn lf_droponce(ts) = match ts
    Nil        => Nil
    Cons(h, t) => t
fn lf_dropkw(ts, kw) = if lf_headtext(ts) == kw then lf_droponce(ts) else ts
fn lf_skiprp(ts) = if lf_headtext(ts) == ")" then lf_droponce(ts) else ts
fn lf_skiprb(ts) = if lf_headtext(ts) == "}" then lf_droponce(ts) else ts
fn lf_skiprk(ts) = if lf_headtext(ts) == "]" then lf_droponce(ts) else ts
fn lf_isrecbody(ts) = lf_headtext(ts) == "}" or lf_headtext(lf_droponce(ts)) == ":"
fn lf_dropin(ts) = if lf_headtext(ts) == "in" or lf_headtext(ts) == ";" then lf_droponce(ts) else ts
fn lf_isfieldsep(ts) = lf_headtext(ts) == "," or lf_headtext(ts) == ";"
fn lf_isnextfield(ts) = lf_headtext(ts) != "" and lf_headtext(ts) != "}" and lf_headtext(lf_droponce(ts)) == ":"

## --- parser: types, expressions, records, calls, comptime, match ---
fn lf_parsetype1(ts) = if lf_headtext(ts) == "[" then let r = lf_parsetype1(lf_droponce(ts)) in {ty: "[" + r.ty + "]", rest: lf_skiprk(r.rest)} else if lf_headtext(ts) == "table" and lf_headtext(lf_droponce(ts)) == "[" then let r = lf_parsetype1(lf_droponce(lf_droponce(ts))) in {ty: "table[" + r.ty + "]", rest: lf_skiprk(r.rest)} else if lf_headtext(ts) == "decimal" and lf_headtext(lf_droponce(ts)) == "(" then let p = lf_headtext(lf_droponce(lf_droponce(ts))) in let s = lf_headtext(lf_droponce(lf_droponce(lf_droponce(lf_droponce(ts))))) in {ty: "decimal(" + p + ", " + s + ")", rest: lf_skiprp(lf_droponce(lf_droponce(lf_droponce(lf_droponce(lf_droponce(ts))))))} else {ty: lf_headtext(ts), rest: lf_droponce(ts)}
fn lf_parsevpfield(ts) = if lf_headtext(lf_droponce(ts)) == ":" then lf_parsetype1(lf_droponce(lf_droponce(ts))) else lf_parsetype1(ts)
fn lf_parsetypelist(ts) = if lf_headtext(ts) == ")" then {items: Nil, rest: lf_droponce(ts)} else let r = lf_parsevpfield(ts) in if lf_headtext(r.rest) == "," then let rr = lf_parsetypelist(lf_droponce(r.rest)) in {items: Cons(r.ty, rr.items), rest: rr.rest} else {items: Cons(r.ty, Nil), rest: lf_skiprp(r.rest)}
fn lf_parsevariants(ts) = let tag = lf_headtext(ts) in let t1 = lf_droponce(ts) in let vp = if lf_headtext(t1) == "(" then let a = lf_parsetypelist(lf_droponce(t1)) in {v: tag + "(" + lf_joinsep(a.items, ", ") + ")", rest: a.rest} else {v: tag, rest: t1} in if lf_headtext(vp.rest) == "|" then let rr = lf_parsevariants(lf_droponce(vp.rest)) in {items: Cons(vp.v, rr.items), rest: rr.rest} else {items: Cons(vp.v, Nil), rest: lf_skiprb(vp.rest)}
fn lf_parsefieldmore(fstr, r) = if lf_isnextfield(r) then let rr = lf_parsefields(r) in {items: Cons(fstr, rr.items), rest: rr.rest} else {items: Cons(fstr, Nil), rest: lf_skiprb(r)}
fn lf_parsefields(ts) = let fnm = lf_headtext(ts) in let r = lf_parsetype1(lf_dropkw(lf_droponce(ts), ":")) in let fstr = fnm + ": " + r.ty in if lf_isfieldsep(r.rest) then lf_parsefieldmore(fstr, lf_droponce(r.rest)) else lf_parsefieldmore(fstr, r.rest)
fn lf_parsetypedecl(t) = let nm = lf_headtext(t) in let b = lf_dropkw(lf_droponce(t), "=") in if lf_headtext(b) == "record" then let fs = lf_parsefields(lf_dropkw(lf_droponce(b), "{")) in TypeD("type " + nm + " = record " + lf_joinsep(fs.items, ", ")) else let vs = lf_parsevariants(lf_dropkw(lf_dropkw(lf_dropkw(b, "enum"), "{"), "|")) in TypeD("type " + nm + " = enum " + lf_joinsep(vs.items, " | "))
fn lf_parseuse(t) = UseD("use " + lf_headtext(t))

fn lf_recentries(ts) = if lf_headtext(ts) == "}" then {items: Nil, rest: lf_droponce(ts)} else lf_recmore(lf_headtext(ts), lf_expr(lf_dropkw(lf_droponce(ts), ":")))
fn lf_recmore(k, rv) = if lf_headtext(rv.rest) == "," then let rr = lf_recentries(lf_droponce(rv.rest)) in {items: Cons({key: k, val: rv.node}, rr.items), rest: rr.rest} else {items: Cons({key: k, val: rv.node}, Nil), rest: lf_skiprb(rv.rest)}
fn lf_parseifelse(c, tb, rest) = if lf_headtext(rest) == "elif" then let r = lf_parseif(lf_droponce(rest)) in {node: If(c, tb, r.node), rest: r.rest} else let eb = lf_expr(lf_dropkw(rest, "else")) in {node: If(c, tb, eb.node), rest: eb.rest}
fn lf_parseif(t) = let rc = lf_expr(t) in let tb = lf_expr(lf_dropkw(rc.rest, "then")) in lf_parseifelse(rc.node, tb.node, lf_dropkw(tb.rest, ";"))
fn lf_parselet(t) = let nm = lf_headtext(t) in let rv = lf_expr(lf_dropkw(lf_droponce(t), "=")) in let rb = lf_expr(lf_dropin(rv.rest)) in {node: LetIn(nm, rv.node, rb.node), rest: rb.rest}
fn lf_parsect(t) = let r = lf_prim(t) in {node: CT(r.node), rest: r.rest}
fn lf_postloop(r) = if lf_headtext(r.rest) == "." then lf_postloop({node: Field(r.node, lf_headtext(lf_droponce(r.rest))), rest: lf_droponce(lf_droponce(r.rest))}) else r
fn lf_post(ts) = lf_postloop(lf_prim(ts))

fn lf_isbadholech(c) = c == ":" or c == "\"" or c == "\n" or c == "{" or c == "}" or c == "\\" or c == ";" or c == "'" or c == "#" or c == "$" or c == "@" or c == "`"
fn lf_isjsblock(s, n) = n >= 7 and slice(s, 0, 7) == "return " or n >= 4 and slice(s, 0, 4) == "var " or n >= 6 and slice(s, 0, 6) == "const " or n >= 8 and slice(s, 0, 8) == "function" or n >= 3 and slice(s, 0, 3) == "if(" or n >= 4 and slice(s, 0, 4) == "for(" or n >= 6 and slice(s, 0, 6) == "while("
fn lf_hasbadhole(s, i) = if i >= count(s) then 0 else if lf_isbadholech(at(s, i)) then 1 else lf_hasbadhole(s, i + 1)
fn lf_isholehead(c) = lf_isalpha(c) or lf_isdigit(c) or c == "("
fn lf_isvalidhole(s) = let n = count(s) in if n == 0 or lf_isjsblock(s, n) == 1 then 0 else if lf_isholehead(at(s, 0)) and lf_hasbadhole(s, 0) == 0 then 1 else 0
fn lf_findcloseb(s, j) = if j >= count(s) then 0 - 1 else if at(s, j) == "}" then j else lf_findcloseb(s, j + 1)
fn lf_findinterpbrace(s, i) = if i + 1 < count(s) and at(s, i + 1) == "{" then lf_findinterp(s, i + 2) else let j = lf_findcloseb(s, i + 1) in if i >= 2 and at(s, i - 2) == "/" and at(s, i - 1) == " " and j + 1 == count(s) then lf_findinterp(s, i + 1) else if j > i + 1 and lf_isvalidhole(slice(s, i + 1, j)) == 1 then i else lf_findinterp(s, i + 1)
fn lf_findinterp(s, i) = if i >= count(s) then 0 - 1 else if at(s, i) == "{" then lf_findinterpbrace(s, i) else lf_findinterp(s, i + 1)
fn lf_sjoin(acc, piece) = match acc
    Nil => piece
    _   => Bin("+", acc, piece)
fn lf_qstr(s) = Str("\"" + s + "\"")
fn lf_strinterptail(acc, s) = if count(s) == 0 then acc else lf_sjoin(acc, lf_qstr(s))
fn lf_strinterphole(acc, s, i) = let j = lf_findcloseb(s, i + 1) in let pre = slice(s, 0, i) in let hole = Call("str", Cons((lf_expr(lf_lexall(slice(s, i + 1, j)))).node, Nil)) in let acc1 = if count(pre) == 0 then acc else lf_sjoin(acc, lf_qstr(pre)) in lf_strinterploop(lf_sjoin(acc1, hole), slice(s, j + 1, count(s)))
fn lf_strinterploop(acc, s) = let i = lf_findinterp(s, 0) in if i < 0 then lf_strinterptail(acc, s) else lf_strinterphole(acc, s, i)
fn lf_strinterp(raw) = let s = slice(raw, 1, count(raw) - 1) in if lf_findinterp(s, 0) < 0 then Str(raw) else lf_strinterploop(Nil, s)

fn lf_primbrace(t) = if lf_isrecbody(t) then let a = lf_recentries(t) in {node: Rec(a.items), rest: a.rest} else let r = lf_expr(t) in {node: r.node, rest: lf_skiprb(r.rest)}
fn lf_primkw(kw, t) = if kw == "if" then lf_parseif(t) else if kw == "let" then lf_parselet(t) else if kw == "match" then lf_parsematch(t) else if kw == "comptime" then lf_parsect(t) else if kw == "do" then lf_expr(t) else lf_primid(kw, t)
fn lf_primid(name, t) = if lf_headtext(t) == "(" then let a = lf_arglist(lf_droponce(t)) in {node: Call(name, a.items), rest: a.rest} else if lf_headtext(t) == "{" and lf_isrecbody(lf_droponce(t)) then let a = lf_recentries(lf_droponce(t)) in {node: RecT(name, a.items), rest: a.rest} else {node: Var(name), rest: t}
fn lf_prim(ts) = match ts
    Nil        => {node: Num("0"), rest: Nil}
    Cons(h, t) => if h.kind == "int" then {node: Num(h.text), rest: t} else if h.kind == "str" then {node: lf_strinterp(h.text), rest: t} else if h.kind == "id" then lf_primkw(h.text, t) else if h.text == "{" then lf_primbrace(t) else if h.text == "(" then let r = lf_expr(t) in {node: r.node, rest: lf_skiprp(r.rest)} else {node: Num("0"), rest: t}
fn lf_arglist(ts) = if lf_headtext(ts) == ")" then {items: Nil, rest: lf_droponce(ts)} else lf_argmore(lf_expr(ts))
fn lf_argmore(r) = if lf_headtext(r.rest) == "," then let rr = lf_arglist(lf_droponce(r.rest)) in {items: Cons(r.node, rr.items), rest: rr.rest} else {items: Cons(r.node, Nil), rest: lf_skiprp(r.rest)}

fn lf_mulloop(r) = let op = lf_headtext(r.rest) in if op == "*" or op == "/" or op == "%" then let r2 = lf_post(lf_droponce(r.rest)) in lf_mulloop({node: Bin(op, r.node, r2.node), rest: r2.rest}) else r
fn lf_mul(ts) = lf_mulloop(lf_post(ts))
fn lf_addloop(r) = let op = lf_headtext(r.rest) in if op == "+" or op == "-" then let r2 = lf_mul(lf_droponce(r.rest)) in lf_addloop({node: Bin(op, r.node, r2.node), rest: r2.rest}) else r
fn lf_add(ts) = lf_addloop(lf_mul(ts))
fn lf_cmploop(r) = let op = lf_headtext(r.rest) in if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" then let r2 = lf_add(lf_droponce(r.rest)) in lf_cmploop({node: Bin(op, r.node, r2.node), rest: r2.rest}) else r
fn lf_cmp(ts) = lf_cmploop(lf_add(ts))
fn lf_andloop(r) = if lf_headtext(r.rest) == "and" then let r2 = lf_cmp(lf_droponce(r.rest)) in lf_andloop({node: Bin("and", r.node, r2.node), rest: r2.rest}) else r
fn lf_booland(ts) = lf_andloop(lf_cmp(ts))
fn lf_orloop(r) = if lf_headtext(r.rest) == "or" then let r2 = lf_booland(lf_droponce(r.rest)) in lf_orloop({node: Bin("or", r.node, r2.node), rest: r2.rest}) else r
fn lf_expr(ts) = lf_orloop(lf_booland(ts))

fn lf_isarrow(ts) = lf_headtext(ts) == "=" and lf_headtext(lf_droponce(ts)) == ">"
fn lf_dropamsep(ts) = if lf_headtext(ts) == "|" or lf_headtext(ts) == "," or lf_headtext(ts) == ";" then lf_droponce(ts) else ts
fn lf_parsematch(t) = let sc = lf_expr(t) in let hb = if lf_headtext(sc.rest) == "{" then 1 else 0 in let ar = lf_parsearms(lf_dropkw(sc.rest, "{")) in {node: Match(sc.node, ar.items), rest: if hb == 1 then lf_skiprb(ar.rest) else ar.rest}
fn lf_parsearms(ts) = lf_armstart(ts, lf_parsepat(lf_dropkw(ts, "|")))
fn lf_armstart(ts, p) = if lf_isarrow(p.rest) then lf_armmore(p) else {items: Nil, rest: ts}
fn lf_armmore(p) = let b = lf_expr(lf_dropkw(lf_dropkw(p.rest, "="), ">")) in let rr = lf_parsearms(lf_dropamsep(b.rest)) in {items: Cons({pat: p.node, body: b.node}, rr.items), rest: rr.rest}
fn lf_parsepat(ts) = match ts
    Nil        => {node: PWild, rest: Nil}
    Cons(h, t) => if h.kind == "int" then {node: PInt(h.text), rest: t} else if h.text == "_" then {node: PWild, rest: t} else if lf_isctor(h.text) then lf_patcons(h.text, t) else {node: PBind(h.text), rest: t}
fn lf_patcons(tag, t) = if lf_headtext(t) == "(" then let a = lf_patlist(lf_droponce(t)) in {node: PCons(tag, a.items), rest: a.rest} else {node: PCons(tag, Nil), rest: t}
fn lf_patlist(ts) = if lf_headtext(ts) == ")" then {items: Nil, rest: lf_droponce(ts)} else lf_patmore(lf_parsepat(ts))
fn lf_patmore(r) = if lf_headtext(r.rest) == "," then let rr = lf_patlist(lf_droponce(r.rest)) in {items: Cons(r.node, rr.items), rest: rr.rest} else {items: Cons(r.node, Nil), rest: lf_skiprp(r.rest)}

## --- parser: single statement (Fn, TypeD, Print, ExprS) ---
fn lf_parseparams(ts) = if lf_headtext(ts) == ")" then {items: Nil, rest: lf_droponce(ts)} else lf_parseparam(lf_headtext(ts), lf_droponce(ts))
fn lf_parseparam(nm, ts) = if lf_headtext(ts) == ":" then let r = lf_parsetype1(lf_droponce(ts)) in lf_parammore(nm + ": " + r.ty, r.rest) else lf_parammore(nm, ts)
fn lf_parammore(nm, ts) = if lf_headtext(ts) == "," then let rr = lf_parseparams(lf_droponce(ts)) in {items: Cons(nm, rr.items), rest: rr.rest} else {items: Cons(nm, Nil), rest: lf_skiprp(ts)}
fn lf_parseret(ts) = if lf_headtext(ts) == "-" and lf_headtext(lf_droponce(ts)) == ">" then let r = lf_parsetype1(lf_droponce(lf_droponce(ts))) in {ret: " -> " + r.ty, rest: r.rest} else {ret: "", rest: ts}
fn lf_parsefn(t) = let nm = lf_headtext(t) in let ps = lf_parseparams(lf_dropkw(lf_droponce(t), "(")) in let rt = lf_parseret(ps.rest) in let b = lf_expr(lf_dropkw(rt.rest, "=")) in Fn(nm, ps.items, rt.ret, b.node)
fn lf_parseprint(t) = let e = lf_expr(t) in Print(e.node)
fn lf_parseone(ts) = if lf_headtext(ts) == "fn" then lf_parsefn(lf_droponce(ts)) else if lf_headtext(ts) == "type" then lf_parsetypedecl(lf_droponce(ts)) else if lf_headtext(ts) == "use" then lf_parseuse(lf_droponce(ts)) else if lf_headtext(ts) == "print" then lf_parseprint(lf_droponce(ts)) else ExprS((lf_expr(ts)).node)

## --- canonical pretty-printer (precedence-aware minimal parens + aligned match arms) ---
fn lf_opprec(op) = if op == "or" then 1 else if op == "and" then 2 else if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" then 3 else if op == "+" or op == "-" then 4 else if op == "*" or op == "/" or op == "%" then 5 else 6
fn lf_eprec(e) = match e
    If(c, t, e2)    => 0
    LetIn(nm, v, b) => 0
    Match(sc, arms) => 0
    Bin(op, l, r)   => lf_opprec(op)
    Var(nm)         => 7
    Field(o, nm)    => 7
    _               => 6

fn lf_fmtpat(p) = match p
    PWild            => "_"
    PInt(s)          => s
    PBind(nm)        => nm
    PCons(tag, subs) => if lf_isnil(subs) == 1 then tag else tag + "(" + lf_joinsep(lf_fmtpats(subs), ", ") + ")"
fn lf_fmtpats(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(lf_fmtpat(h), lf_fmtpats(t))

fn lf_maxpatlen(arms) = match arms
    Nil        => 0
    Cons(h, t) => lf_imax(count(lf_fmtpat(h.pat)), lf_maxpatlen(t))
fn lf_fmtarms(arms, w) = match arms
    Nil        => Nil
    Cons(h, t) => Cons("\n    " + lf_padright(lf_fmtpat(h.pat), w) + " => " + lf_fmte(h.body), lf_fmtarms(t, w))

fn lf_isif(e) = match e
    If(c, t, e2) => 1
    _            => 0
fn lf_wrapl(e, p) = if lf_eprec(e) < p or p == 3 and lf_eprec(e) == 3 then "(" + lf_fmte(e) + ")" else lf_fmte(e)
fn lf_wrapr(e, p) = if lf_eprec(e) <= p then "(" + lf_fmte(e) + ")" else lf_fmte(e)
fn lf_wrapf(e) = if lf_eprec(e) < 7 then "(" + lf_fmte(e) + ")" else lf_fmte(e)
fn lf_wrapthen(e) = if lf_isif(e) == 1 then "(" + lf_fmte(e) + ")" else lf_fmte(e)

fn lf_fmtes(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(lf_fmte(h), lf_fmtes(t))
fn lf_fmtrecs(xs) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(h.key + ": " + lf_fmte(h.val), lf_fmtrecs(t))

fn lf_fmte(e) = match e
    Num(s)          => s
    Str(s)          => s
    Var(nm)         => nm
    Bin(op, l, r)   => let p = lf_opprec(op) in lf_wrapl(l, p) + " " + op + " " + lf_wrapr(r, p)
    If(c, t, e2)    => "if " + lf_wrapthen(c) + " then " + lf_wrapthen(t) + " else " + lf_fmte(e2)
    LetIn(nm, v, b) => "let " + nm + " = " + lf_fmte(v) + " in " + lf_fmte(b)
    Call(nm, args)  => if lf_isctor(nm) and lf_isnil(args) == 1 then nm else nm + "(" + lf_joinsep(lf_fmtes(args), ", ") + ")"
    CT(inner)       => "comptime(" + lf_fmte(inner) + ")"
    Rec(items)      => "{" + lf_joinsep(lf_fmtrecs(items), ", ") + "}"
    RecT(nm, items) => nm + "{" + lf_joinsep(lf_fmtrecs(items), ", ") + "}"
    Field(o, nm)    => lf_wrapf(o) + "." + nm
    Match(sc, arms) => "match " + lf_fmte(sc) + lf_joinall(lf_fmtarms(arms, lf_maxpatlen(arms)))
    _               => "0"

fn lf_fmtstmt(s) = match s
    Fn(nm, ps, rt, body) => "fn " + nm + "(" + lf_joinsep(ps, ", ") + ")" + rt + " = " + lf_fmte(body)
    TypeD(line)          => line
    UseD(line)           => line
    Print(v)             => "print " + lf_fmte(v)
    ExprS(v)             => lf_fmte(v)
    _                    => ""
fn lf_fmtchunk(src) = lf_fmtstmt(lf_parseone(lf_lexall(src)))
fn lf_real_ast(src) = if __lume_try_begin() == 0 then let p = parseprogram(src) in let z = __lume_try_end() in {ok: 1, prog: p} else {ok: 0, prog: Nil}
fn lf_try_fmt(src) = if __lume_try_begin() == 0 then let o = lf_fmtchunk(src) in let z = __lume_try_end() in {ok: 1, text: o} else {ok: 0, text: src}
fn lf_comment_at(s, n, i, instr) = if i >= n then 0 else let c = at(s, i) in if instr == 1 then (if c == "\\" then lf_comment_at(s, n, i + 2, 1) else if c == "\"" then lf_comment_at(s, n, i + 1, 0) else lf_comment_at(s, n, i + 1, 1)) else if c == "\"" then lf_comment_at(s, n, i + 1, 1) else if c == "#" then 1 else lf_comment_at(s, n, i + 1, 0)
fn lf_same(src, a, text) = let b = lf_real_ast(text) in if b.ok == 1 and a.prog == b.prog then text else src
fn lf_safe2(src, out) = if out.ok == 0 then src else let a = lf_real_ast(src) in if a.ok == 0 then src else lf_same(src, a, out.text)
fn lf_safe(src) = if lf_comment_at(src, count(src), 0, 0) == 1 then src else lf_safe2(src, lf_try_fmt(src))

## --- line grouping: group continuation lines (indented lines or unindented match arms) with statement ---
fn lf_isarmline(tr) = if tr == "" or lf_startswith(tr, "#") or lf_startswith(tr, "fn ") or lf_startswith(tr, "type ") or lf_startswith(tr, "use ") or lf_startswith(tr, "print ") then 0 else lf_isarrow((lf_parsepat(lf_lexall(tr))).rest)
fn lf_isbracecont(tr) = lf_startswith(tr, "}") or lf_startswith(tr, "elif ") or lf_startswith(tr, "else") or lf_startswith(tr, "|")
fn lf_iscont(raw, tr) = if tr == "" or lf_startswith(tr, "#") then 0 else if lf_isindented(raw) then 1 else if lf_isbracecont(tr) then 1 else lf_isarmline(tr)

fn lf_takecont(lines) = match lines
    Nil        => {cont: Nil, rest: Nil}
    Cons(h, t) => let raw = lf_rtrim(h) in lf_takecont1(raw, lf_ltrim(raw), h, t)
fn lf_takecont1(raw, tr, h, t) = if lf_iscont(raw, tr) == 1 then let r = lf_takecont(t) in {cont: Cons(raw, r.cont), rest: r.rest} else {cont: Nil, rest: Cons(h, t)}

fn lf_skipempty(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let raw = lf_rtrim(h) in if lf_ltrim(raw) == "" then lf_skipempty(t) else Cons(raw, t)

fn lf_fmtlines(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let raw = lf_rtrim(h) in lf_fmtline1(raw, lf_ltrim(raw), t)
fn lf_fmtline1(raw, tr, t) = if tr == "" then let t2 = lf_skipempty(t) in if lf_isnil(t2) == 1 then Nil else Cons("", lf_fmtlines(t2)) else if lf_startswith(tr, "#") then Cons(raw, lf_fmtlines(t)) else let c = lf_takecont(t) in Cons(lf_safe(lf_joinsep(Cons(raw, c.cont), "\n")), lf_fmtlines(c.rest))

print lf_joinsep(lf_fmtlines(lf_skipempty(lf_splitlines(readall()))), "\n")
