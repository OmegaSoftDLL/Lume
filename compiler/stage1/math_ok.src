## math_ok.src -- `use math` and f64 parameters: the developer's example, the math names, f32 rounding (ties to even,
## overflow to infinity, subnormals) and the f32 buffer accessors.
use math

fn hipotenusa(a: f64, b: f64) -> f64 = sqrt(a * a + b * b)
fn test_hip() = hipotenusa(3.0, 4.0) == f64(5)
fn test_hip_f64_args() = hipotenusa(f64(6), f64(8)) == f64(10)
fn test_math_names() = sqrt(16) == f64(4) and floor(f64("2.7")) == f64(2) and ceil(f64("2.2")) == f64(3) and round(f64("-2.5")) == f64(-3) and pow(2, 10) == f64(1024) and exp(0) == f64(1) and log(1) == f64(0) and sin(0) == f64(0) and cos(0) == f64(1) and atan2(0, 1) == f64(0) and log10(1000) == f64(3)
fn test_tofloat_round_trip() = str(tofloat("0.1")) == "0.1" and str(tofloat("1e-9")) == "1.0e-9" and tofloat(str(f64(1) / f64(3))) == f64(1) / f64(3)
fn test_nan_inf() = is_nan(tofloat("nan")) and is_inf(tofloat("inf")) and is_inf(f64(1)) == false
fn test_f32_rounding() = str(f32(tofloat("0.1"))) == "0.10000000149011612" and f32(16777217) == f64(16777216) and f32(16777219) == f64(16777220) and is_inf(f32(tofloat("1e39"))) and f32(tofloat("1e-45")) == tofloat("1.401298464324817e-45") and f32(f64(0) - f64(1)) == f64(0) - f64(1)
fn test_f32_buffer() = let b = buf_new(8) in let s = buf_f32_set(b, 0, f64(1)) in let t = buf_f32_set(b, 4, tofloat("-2.5")) in buf_get(b, 3) == 63 and buf_get(b, 2) == 128 and buf_f32_get(b, 0) == f64(1) and buf_f32_get(b, 4) == tofloat("-2.5") and str(buf_f32_get(buf_f32_set(b, 0, tofloat("0.1")), 0)) == "0.10000000149011612"
