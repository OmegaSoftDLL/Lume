## gen_runtime.src -- the runtime written in Lume becomes the text the compiler embeds (`lume run
## compiler/stage1/gen_runtime.src <repository root>`). Every source of rt_sources() is compiled by
## `build/bin/lumec --raw` and the assembly is written as Lume functions (rt_lume_core: no system calls, every
## program and @freestanding kernels too; rt_lume_os: system calls, hosted programs only; rt_lume = both) to
## compiler/stage1/runtime_lume.lume (amalgamated into lumec next to runtime_core.lume). runtime_lume.lume is generated:
## change the Lume source in compiler/stage1/rt/ and run this program again; the runtime_lume gate checks that the
## file is what this program writes now.
use hostio

fn rt_sources() = Cons("compiler/stage1/rt/rt_text.src", Cons("compiler/stage1/rt/rt_video.src", Nil))
## the routines that make system calls: never in a @freestanding kernel (it has no operating system underneath)
fn rt_os_sources() = Cons("compiler/stage1/rt/rt_pack.src", Cons("compiler/stage1/rt/rt_fail.src", Cons("compiler/stage1/rt/rt_buf.src", Cons("compiler/stage1/rt/rt_fs.src", Cons("compiler/stage1/rt/rt_io.src", Cons("compiler/stage1/rt/rt_trace.src", Nil))))))
## the routines only a program that calls a crypto_ or codec builtin, or one built by `lume debug`, gets (rt_crypto,
## chosen by has_crypto in the code generator)
fn rt_crypto_sources() = Cons("compiler/stage1/rt/rt_x25519.src", Cons("compiler/stage1/rt/rt_ed25519.src", Cons("compiler/stage1/rt/rt_simd.src", Cons("compiler/stage1/rt/rt_codec.src", Cons("compiler/stage1/rt/rt_debug.src", Nil)))))
## the f64 runtime (rt_f64, chosen by has_f64 in the code generator: a program that names no f64 builtin gets the
## stubs, and so does the seed-assembled stage 0, whose assembler knows no SSE2 or x87)
fn rt_f64_sources() = Cons("compiler/stage1/rt/rt_f64.src", Nil)
fn gr_root() = if os_arg_count() >= 2 then os_arg_at(1) else "."
fn gr_lines_go(s, i, start, n, acc) = if i >= n then (if start < n then gr_rev(Cons(slice(s, start, n), acc), Nil) else gr_rev(acc, Nil)) else if at(s, i) == "\n" then gr_lines_go(s, i + 1, i + 1, n, Cons(slice(s, start, i), acc)) else gr_lines_go(s, i + 1, start, n, acc)
fn gr_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => gr_rev(t, Cons(h, acc))
## each line of assembly as a Lume string piece: "line\n"
fn gr_pieces(ls) = match ls
    Nil        => ""
    Cons(h, t) => "\"" + gr_esc(h, 0, "") + chr(92) + "n\"" + (if gr_isnil(t) then "" else " + ") + gr_pieces(t)
## a line of assembly inside a Lume string literal: backslash, quote and braces escaped (raw messages hold them)
fn gr_esc(s, i, acc) = if i >= count(s) then acc else let c = at(s, i) in gr_esc(s, i + 1, acc + (if c == chr(92) or c == chr(34) or c == "{" or c == "}" then chr(92) + c else c))
fn gr_isnil(xs) = match xs
    Nil        => 1 == 1
    Cons(h, t) => 1 == 0
## compile one source with lumec --raw: its assembly, or a failure that stops the generator
fn gr_compile(root, src) = let out = root + "/build/gen_runtime.out" in let err = out + ".err" in let rc = os_run_input_capture_timeout(root + "/build/bin/lumec", Cons("--raw", Nil), root + "/" + src, out, err, 120000) in let asm = fs_read_file(out) in if rc != 0 or count(asm) == 0 then ctfail("gen_runtime: lumec --raw failed on " + src + ": " + fs_read_file(err) + "\n") else asm
fn gr_all(root, srcs) = match srcs
    Nil        => ""
    Cons(h, t) => gr_compile(root, h) + gr_all(root, t)
## each part becomes a function made of chunk functions of at most 400 lines (rt_lume_crypto() = rt_lume_crypto_0() +
## rt_lume_crypto_1() + ...): one expression of thousands of `+` terms is quadratic for the Stage-0 interpreter that
## runs lcaas (which bundles lumec) on macOS
fn gr_take(xs, n) = match xs
    Nil        => Nil
    Cons(h, t) => if n <= 0 then Nil else Cons(h, gr_take(t, n - 1))
fn gr_drop(xs, n) = match xs
    Nil        => Nil
    Cons(h, t) => if n <= 0 then xs else gr_drop(t, n - 1)
fn gr_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + gr_len(t)
fn gr_chunks(name, ls, k) = if gr_isnil(ls) then "" else "fn " + name + "_" + str(k) + "() = " + gr_pieces(gr_take(ls, 400)) + "\n" + gr_chunks(name, gr_drop(ls, 400), k + 1)
fn gr_calls(name, k, n) = if k >= n then "" else name + "_" + str(k) + "()" + (if k + 1 < n then " + " else "") + gr_calls(name, k + 1, n)
fn gr_fn(name, asm) = let ls = gr_lines_go(asm, 0, 0, count(asm), Nil) in let n = (gr_len(ls) + 399) / 400 in "fn " + name + "() = " + (if n == 0 then chr(34) + chr(34) else gr_calls(name, 0, n)) + "\n" + gr_chunks(name, ls, 0)
fn gr_text(asm, asmo, asmc, asmf) = "## runtime_lume.lume -- GENERATED by compiler/stage1/gen_runtime.src from compiler/stage1/rt/*.src: the runtime\n## written in Lume, compiled by lumec --raw. Do not edit; change the Lume source and run the generator.\nfn rt_lume() = rt_lume_core() + rt_lume_os()\n" + gr_fn("rt_lume_core", asm) + gr_fn("rt_lume_os", asmo) + gr_fn("rt_lume_crypto", asmc) + gr_fn("rt_lume_f64", asmf)
## `--check` (second argument): the file must already be what the sources give (the runtime_lume gate); exit 3 otherwise
fn gr_check_mode() = os_arg_count() >= 3 and os_arg_at(2) == "--check"
fn gr_main() = let root = gr_root() in let text = gr_text(gr_all(root, rt_sources()), gr_all(root, rt_os_sources()), gr_all(root, rt_crypto_sources()), gr_all(root, rt_f64_sources())) in if gr_check_mode() then (if fs_read_file(root + "/compiler/stage1/runtime_lume.lume") == text then "runtime_lume.lume: up to date with compiler/stage1/rt" else ctfail("runtime_lume.lume differs from what compiler/stage1/rt gives now: run lume run compiler/stage1/gen_runtime.src\n")) else let w = fs_write_sync(root + "/compiler/stage1/runtime_lume.lume", text) in if w == 1 then "runtime_lume.lume: " + str(count(text)) + " bytes" else ctfail("gen_runtime: cannot write runtime_lume.lume\n")
print gr_main()
