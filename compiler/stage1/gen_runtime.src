## gen_runtime.src -- the runtime written in Lume becomes the text the compiler embeds (`lume run
## compiler/stage1/gen_runtime.src <repository root>`). Every source of rt_sources() is compiled by
## `build/bin/lumec --raw` and the assembly is written as Lume functions (rt_lume_core: no system calls, every
## program and @freestanding kernels too; rt_lume_os: system calls, hosted programs only; rt_lume = both) to
## compiler/stage1/runtime_lume.lume (amalgamated into lumec next to runtime_core.lume). runtime_lume.lume is generated:
## change the Lume source in compiler/stage1/rt/ and run this program again; the runtime_lume gate checks that the
## file is what this program writes now.
use hostio

fn rt_sources() = Cons("compiler/stage1/rt/rt_text.src", Cons("compiler/stage1/rt/rt_video.src", Cons("compiler/stage1/rt/rt_sys.src", Nil)))
## the routines that make system calls: never in a @freestanding kernel (it has no operating system underneath)
fn rt_os_sources() = Cons("compiler/stage1/rt/rt_arena.src", Cons("compiler/stage1/rt/rt_pack.src", Cons("compiler/stage1/rt/rt_fail.src", Cons("compiler/stage1/rt/rt_gc.src", Cons("compiler/stage1/rt/rt_buf.src", Cons("compiler/stage1/rt/rt_fs.src", Cons("compiler/stage1/rt/rt_io.src", Cons("compiler/stage1/rt/rt_trace.src", Nil))))))))
## the routines only a program that calls a crypto_ or codec builtin, or one built by `lume debug`, gets (rt_crypto,
## chosen by has_crypto in the code generator)
fn rt_crypto_sources() = Cons("compiler/stage1/rt/rt_x25519.src", Cons("compiler/stage1/rt/rt_ed25519.src", Cons("compiler/stage1/rt/rt_simd.src", Cons("compiler/stage1/rt/rt_codec.src", Cons("compiler/stage1/rt/rt_debug.src", Nil)))))
## the f64 runtime (rt_f64, chosen by has_f64 in the code generator: a program that names no f64 builtin gets the
## stubs, and so does the seed-assembled stage 0, whose assembler knows no SSE2 or x87)
fn rt_f64_sources() = Cons("compiler/stage1/rt/rt_f64.src", Nil)
## the decimal trampolines (rt_lume_dec, chosen by has_dec in the code generator: a program that does decimal
## arithmetic through an untyped operand gets them, others get the stub); they forward to the program's __lume_dyn_* sugar
fn rt_dec_sources() = Cons("compiler/stage1/rt/rt_dec.src", Nil)
## the arena and heap builtins (rt_mem, chosen by has_mem in the code generator)
fn rt_mem_sources() = Cons("compiler/stage1/rt/rt_mem.src", Nil)
fn gr_root() = if os_arg_count() >= 2 then os_arg_at(1) else "."
fn gr_lines_go(s, i, start, n, acc) = if i >= n then (if start < n then gr_rev(Cons(slice(s, start, n), acc), Nil) else gr_rev(acc, Nil)) else if at(s, i) == "\n" then gr_lines_go(s, i + 1, i + 1, n, Cons(slice(s, start, i), acc)) else gr_lines_go(s, i + 1, start, n, acc)
fn gr_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => gr_rev(t, Cons(h, acc))
## each line of assembly as a Lume string piece: "line\n"
fn gr_pieces(ls) = match ls
    Nil        => ""
    Cons(h, t) => "\"" + gr_esc(h, 0, "") + chr(92) + "n\"" + (if gr_isnil(t) then "" else " + ") + gr_pieces(t)
## a line of assembly inside a Lume string literal: backslash, quote and braces escaped (raw messages hold them)
fn gr_esc(s, i, acc) = if i >= count(s) then acc else let c = at(s, i) in gr_esc(s, i + 1, acc + (if c == chr(92) or c == chr(34) or c == "{" or c == "}" then chr(92) + c else c))
fn gr_isnil(xs) = match xs
    Nil        => 1 == 1
    Cons(h, t) => 1 == 0
## compile one source with lumec --raw: its assembly, or a failure that stops the generator
fn gr_compile(root, src) = let out = root + "/build/gen_runtime.out" in let err = out + ".err" in let rc = os_run_input_capture_timeout(root + "/build/bin/lumec", Cons("--raw", Nil), root + "/" + src, out, err, 120000) in let asm = fs_read_file(out) in if rc != 0 or count(asm) == 0 then ctfail("gen_runtime: lumec --raw failed on " + src + ": " + fs_read_file(err) + "\n") else asm
fn gr_all(root, srcs) = match srcs
    Nil        => ""
    Cons(h, t) => gr_compile(root, h) + gr_all(root, t)
## each part becomes a function made of chunk functions of at most 400 lines (rt_lume_crypto() = rt_lume_crypto_0() +
## rt_lume_crypto_1() + ...): one expression of thousands of `+` terms is quadratic for the Stage-0 interpreter that
## runs lcaas (which bundles lumec) on macOS
fn gr_take(xs, n) = match xs
    Nil        => Nil
    Cons(h, t) => if n <= 0 then Nil else Cons(h, gr_take(t, n - 1))
fn gr_drop(xs, n) = match xs
    Nil        => Nil
    Cons(h, t) => if n <= 0 then xs else gr_drop(t, n - 1)
fn gr_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + gr_len(t)
fn gr_chunks(name, ls, k) = if gr_isnil(ls) then "" else "fn " + name + "_" + str(k) + "() = " + gr_pieces(gr_take(ls, 400)) + "\n" + gr_chunks(name, gr_drop(ls, 400), k + 1)
fn gr_calls(name, k, n) = if k >= n then "" else name + "_" + str(k) + "()" + (if k + 1 < n then " + " else "") + gr_calls(name, k + 1, n)
fn gr_fn(name, asm) = let ls = gr_lines_go(asm, 0, 0, count(asm), Nil) in let n = (gr_len(ls) + 399) / 400 in "fn " + name + "() = " + (if n == 0 then chr(34) + chr(34) else gr_calls(name, 0, n)) + "\n" + gr_chunks(name, ls, 0)
fn gr_text(asm, asmo, asmc, asmf, asmm, asmd) = "## runtime_lume.lume -- GENERATED by compiler/stage1/gen_runtime.src from compiler/stage1/rt/*.src: the runtime\n## written in Lume, compiled by lumec --raw. Do not edit; change the Lume source and run the generator.\nfn rt_lume() = rt_lume_core() + rt_lume_os()\n" + gr_fn("rt_lume_core", asm) + gr_fn("rt_lume_os", asmo) + gr_fn("rt_lume_crypto", asmc) + gr_fn("rt_lume_f64", asmf) + gr_fn("rt_lume_mem", asmm) + gr_fn("rt_lume_dec", asmd)
## `--check` (second argument): the file must already be what the sources give (the runtime_lume gate); exit 3 otherwise
fn gr_check_mode() = os_arg_count() >= 3 and os_arg_at(2) == "--check"
## --- symbol check ---------------------------------------------------------------------------------------------------
## Every name the raw runtime calls, jumps to or takes the address of (sym_addr) must be defined by the runtime itself:
## a function of compiler/stage1/rt/*.src, a label of runtime_core.lume, or one of the few names the code generator
## emits for every program (gr_always). A name the code generator emits only on demand (os_shm_map, when a program
## calls it) once got through: every program linked without it until the compiler's own next generation failed to
## link. Now gen_runtime stops at once and names it. Names are compared by a 48-bit FNV-1a hash in an open-addressing
## table (a buffer of 65536 slots of 6 bytes), one pass over the definitions and one over the references.
fn gr_h(s, i, h) = if i >= count(s) then bit_or(h, 1) else gr_h(s, i + 1, bit_and(bit_xor(h, ord_at(s, i)) *% 1099511628211, 281474976710655))
fn gr_hash(s) = gr_h(s, 0, 172505283306277)
fn gr_get6(b, o) = buf_get(b, o) + buf_get(b, o + 1) * 256 + buf_get(b, o + 2) * 65536 + buf_get(b, o + 3) * 16777216 + buf_get(b, o + 4) * 4294967296 + buf_get(b, o + 5) * 1099511627776
fn gr_put6(b, o, v) = let a = buf_set(b, o, v % 256) in let c = buf_set(b, o + 1, (v / 256) % 256) in let d = buf_set(b, o + 2, (v / 65536) % 256) in let e = buf_set(b, o + 3, (v / 16777216) % 256) in let f = buf_set(b, o + 4, (v / 4294967296) % 256) in buf_set(b, o + 5, v / 1099511627776)
## the slot of h: its own, or the first empty one after it (0 = empty; every hash is odd)
fn gr_slot(b, h, i) = let v = gr_get6(b, (i % 65536) * 6) in if v == 0 or v == h then i % 65536 else gr_slot(b, h, i + 1)
fn gr_add(b, s) = let h = gr_hash(s) in let k = gr_slot(b, h, h % 65536) in gr_put6(b, k * 6, h)
fn gr_in(b, s) = let h = gr_hash(s) in gr_get6(b, gr_slot(b, h, h % 65536) * 6) == h
fn gr_pre(l, p) = count(l) >= count(p) and slice(l, 0, count(p)) == p
fn gr_namec(c) = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 or c == 46
fn gr_nend(s, i) = if i < count(s) and gr_namec(ord_at(s, i)) then gr_nend(s, i + 1) else i
## definitions: `fn NAME(` lines of a source; labels of runtime_core.lume are `"NAME:` + backslash-n pieces
fn gr_defs_src(b, ls) = match ls
    Nil        => b
    Cons(l, t) => let z = (if gr_pre(l, "fn ") then gr_add(b, slice(l, 3, gr_nend(l, 3))) else b) in gr_defs_src(b, t)
fn gr_defs_core(b, s, i) = if i + 2 >= count(s) then b else if gr_lstart(s, i) and gr_namec(ord_at(s, i + 1)) then gr_defs_core2(b, s, i + 1, gr_nend(s, i + 1)) else if gr_lcomm(s, i) then gr_defs_lcomm(b, s, i + 7) else gr_defs_core(b, s, i + 1)
## a label starts a line of the text: right after the opening quote or after a backslash-n
fn gr_lstart(s, i) = at(s, i) == chr(34) or (at(s, i) == "n" and i > 0 and at(s, i - 1) == chr(92))
## `.lcomm NAME, size` reserves NAME in .bss
fn gr_lcomm(s, i) = i + 7 < count(s) and slice(s, i, i + 7) == ".lcomm "
fn gr_defs_lcomm(b, s, a) = let e = gr_nend(s, a) in let z = gr_add(b, slice(s, a, e)) in gr_defs_core(b, s, e)
fn gr_defs_core2(b, s, a, e) = if e + 2 < count(s) and at(s, e) == ":" and at(s, e + 1) == chr(92) and at(s, e + 2) == "n" then (let z = gr_add(b, slice(s, a, e)) in gr_defs_core(b, s, e + 3)) else gr_defs_core(b, s, e)
## __dbg_state / __lume_dbgcmd: the code generator reserves them whenever it links the group that names them (rt_debug)
## .Lrt_ar_table (the arena table, .lcomm in every hosted program) and __r_hs (the heap_stats record shape, emitted
## with the has_mem group that uses it) come from the code generator too
fn gr_always() = Cons(".Lrt_ar_table", Cons("__r_hs", Cons("__rt_fntab", Cons("__lume_dbgtab", Cons("__dbg_state", Cons("__lume_dbgcmd", Cons("main", Cons("_start", Cons("__lume_dyn_add", Cons("__lume_dyn_sub", Cons("__lume_dyn_mul", Cons("__lume_dyn_div", Cons("__lume_dyn_cmp", Nil)))))))))))))
fn gr_addall(b, xs) = match xs
    Nil        => b
    Cons(h, t) => let z = gr_add(b, h) in gr_addall(b, t)
## the name a line refers to: call / jmp / jcc NAME, leaq NAME(%rip); "" for none, a raw-local label or a register
fn gr_ref(l) = if gr_pre(l, "    call ") then gr_refn(l, 9) else if gr_pre(l, "    jmp ") then gr_refn(l, 8) else if gr_pre(l, "    j") then gr_refj(l, 5) else if gr_pre(l, "    leaq ") and gr_hasrip(l, 9) then gr_refn(l, 10 - 1) else ""
fn gr_refj(l, i) = if i >= count(l) then "" else if at(l, i) == " " then gr_refn(l, i + 1) else gr_refj(l, i + 1)
fn gr_refn(l, i) = let e = gr_nend(l, i) in let n = slice(l, i, e) in if n == "" or gr_pre(n, ".Lrw_") or (ord_at(n, 0) >= 48 and ord_at(n, 0) <= 57) then "" else n
fn gr_hasrip(l, i) = let e = gr_nend(l, i) in e + 6 <= count(l) and slice(l, e, e + 6) == "(%rip)"
fn gr_lines(s) = gr_lines_go(s, 0, 0, count(s), Nil)
## the unknown names, each once (a second table remembers what was reported)
fn gr_unknown(b, seen, ls, acc) = match ls
    Nil        => acc
    Cons(l, t) => let n = gr_ref(l) in if n == "" or gr_in(b, n) or gr_in(seen, n) then gr_unknown(b, seen, t, acc) else (let z = gr_add(seen, n) in gr_unknown(b, seen, t, acc + " " + n))
fn gr_srcs_defs(b, root, srcs) = match srcs
    Nil        => b
    Cons(h, t) => let z = gr_defs_src(b, gr_lines(fs_read_file(root + "/" + h))) in gr_srcs_defs(b, root, t)
fn gr_symcheck(root, asm) = let b = buf_new(65536 * 6) in let d1 = gr_srcs_defs(b, root, rt_sources()) in let d2 = gr_srcs_defs(b, root, rt_os_sources()) in let d3 = gr_srcs_defs(b, root, rt_crypto_sources()) in let d4 = gr_srcs_defs(b, root, rt_f64_sources()) in let d4d = gr_srcs_defs(b, root, rt_dec_sources()) in let d4m = gr_srcs_defs(b, root, rt_mem_sources()) in let d5 = gr_defs_core(b, fs_read_file(root + "/compiler/stage1/runtime_core.lume"), 0) in let d6 = gr_addall(b, gr_always()) in gr_unknown(b, buf_new(65536 * 6), gr_lines(asm), "")
## a name two runtime sources (or one source twice) define: the assembler would stop at link time on the label
## `.Lrw_NAME_top` defined twice, far from the cause; gen_runtime names it at once
fn gr_dupl(seen, ls, acc) = match ls
    Nil        => acc
    Cons(l, t) => if gr_pre(l, "fn ") then (let n = slice(l, 3, gr_nend(l, 3)) in if gr_in(seen, n) then gr_dupl(seen, t, acc + " " + n) else (let z = gr_add(seen, n) in gr_dupl(seen, t, acc))) else gr_dupl(seen, t, acc)
fn gr_dups(seen, root, srcs, acc) = match srcs
    Nil        => acc
    Cons(h, t) => gr_dups(seen, root, t, gr_dupl(seen, gr_lines(fs_read_file(root + "/" + h)), acc))
fn gr_alldups(root) = gr_dups(buf_new(65536 * 6), root, app_srcs(rt_sources(), app_srcs(rt_os_sources(), app_srcs(rt_crypto_sources(), app_srcs(rt_f64_sources(), app_srcs(rt_dec_sources(), rt_mem_sources()))))), "")
fn app_srcs(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, app_srcs(t, ys))
fn gr_main() = let root = gr_root() in let dd = gr_alldups(root) in if dd != "" then ctfail("gen_runtime: the Lume runtime defines these names more than once (rename one):" + dd + "\n") else let a = gr_all(root, rt_sources()) in let o = gr_all(root, rt_os_sources()) in let c = gr_all(root, rt_crypto_sources()) in let f = gr_all(root, rt_f64_sources()) in let d = gr_all(root, rt_dec_sources()) in let m = gr_all(root, rt_mem_sources()) in let u = gr_symcheck(root, a + o + c + f + d + m) in if u != "" then ctfail("gen_runtime: the Lume runtime refers to names nothing in the runtime defines (a typo, or a builtin the code generator emits only on demand):" + u + "\n") else gr_main2(root, gr_text(a, o, c, f, m, d))
fn gr_main2(root, text) = if gr_check_mode() then (if fs_read_file(root + "/compiler/stage1/runtime_lume.lume") == text then "runtime_lume.lume: up to date with compiler/stage1/rt" else ctfail("runtime_lume.lume differs from what compiler/stage1/rt gives now: run lume run compiler/stage1/gen_runtime.src\n")) else let w = fs_write_sync(root + "/compiler/stage1/runtime_lume.lume", text) in if w == 1 then "runtime_lume.lume: " + str(count(text)) + " bytes" else ctfail("gen_runtime: cannot write runtime_lume.lume\n")
print gr_main()
