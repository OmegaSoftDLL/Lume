## decimal_dyn_ok.src -- decimals the compiler cannot type (parameters, list elements, record fields) keep exact
## decimal arithmetic at run time; an int operand is n.0; print and str write a decimal as decimal_format does.

fn soma(a, b) = a + b
fn dif(a, b) = a - b
fn vezes(a, b) = a * b
fn media(x, y) = (x + y) / 2.0
fn maior(a, b) = if a > b then a else b
fn total(xs) = match xs
    Nil        => 0.00
    Cons(h, t) => h + total(t)

fn test_text() = str(1.5) == "1.5" and str(0.10) == "0.10" and str(0 - 0.125) == "-0.125" and str(2.00) == "2.00" and "preco: " + str(9.90) == "preco: 9.90"
fn test_through_parameters() = str(soma(1.5, 2.25)) == "3.75" and str(dif(1.00, 0.25)) == "0.75" and str(vezes(1.5, 1.5)) == "2.25" and str(media(1.5, 2.5)) == "2.0"
fn test_with_ints() = str(soma(1.5, 2)) == "3.5" and str(soma(2, 1.5)) == "3.5" and str(vezes(3, 0.5)) == "1.5"
fn test_compare_and_equal() = maior(1.20, 1.3) == 1.3 and soma(1.20, 0.0) == 1.2 and soma(0.1, 0.2) == 0.3 and soma(1.5, 0.5) > 1.9
fn test_lists_and_records() = str(total([1.10, 2.20, 3.30])) == "6.60" and str(soma({v: 1.25}.v, 1)) == "2.25"
fn test_to_f64() = f64(soma(1.5, 2.25)) == f64(3.75) and str(f64(1.5) + 1.5) == "3.0"

print soma(0.1, 0.2)
