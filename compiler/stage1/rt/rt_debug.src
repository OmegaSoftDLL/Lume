## rt_debug.src -- the run-time half of `lume debug` (Lume --raw). A program built for debugging calls
##   __rt_dbg_start()            once, before the top level runs (commands until the first resume),
##   __rt_dbg_enter(row, fp)     after the prologue of each function (its parameters are in their frame slots),
##   __rt_dbg_leave(row, fp, v)  before its epilogue, v the result.
## row is the function's row of __lume_dbgtab (n, end of the user code, then rows of 7 words in address order:
## start, name, file (0 when unknown), line, variables, 0, 0); variables is 0 or {n, number of parameters, then n
## pairs {name, frame offset}}. Commands come from the file named by __lume_dbgcmd ("-": standard input), one per line
## or separated by ';'; everything the debugger writes goes to standard error. __dbg_state (1024 bytes, zero):
##   0 mode (0 run, 1 step, 2 next, 3 finish)   8 frame of next/finish   16 command fd + 2 (0 not open, 1 none)
##   24 selected frame   32 selected row   40 breakpoints   48 end of commands seen   56 selected frame number
##   64 command line (256 bytes)   320 breakpoint rows (64 words)   832 stopped row   840 stopped frame
##   848 one byte for writes   856 eight bytes for a short string   992 output fd + 1 (0: standard error)
##   1000 follow mode   1008 a timespec (16 bytes)
## A command path that starts with `+` is followed: at its end the debugger waits for more lines (2 ms naps) instead of
## letting the program run to its end, so another process can append commands while the program waits (lume debug
## --dap). `mark` writes `debug: mark`, the end of the answer to the commands before it; `output FILE` sends everything
## the debugger writes to FILE, opened for appending (create, append: each write lands at the end, whatever another
## process does with the file meanwhile).
## Every routine here is rw_keepall (values in frame slots): str and flush are runtime assembly that may change
## %rbx and %r12-%r15.
fn rtd_s() = sym_addr("__dbg_state")
fn rtd_len(p, n) = if load8(p + n) == 0 then n else rtd_len(p, n + 1)
fn rtd_ofd() = let f = load64(rtd_s() + 992) in if f == 0 then 2 else f - 1
fn rtd_puts(p) = sys_call(1, rtd_ofd(), p, rtd_len(p, 0), 0, 0)
fn rtd_ch(c) = let b = rtd_s() + 848 in let s = store8(b, c) in sys_call(1, rtd_ofd(), b, 1, 0, 0)
fn rtd_unum(n) = if n >= 10 then (let z = rtd_unum(n / 10) in rtd_ch(48 + n % 10)) else rtd_ch(48 + n)
fn rtd_num(n) = if n < 0 then (let m = rtd_ch(45) in rtd_unum(0 - n)) else rtd_unum(n)

## a value as `str` writes it; a string between quotes; a slot never written as (not set)
fn rtd_isstr(v) = if bit_and(v, 7) == 2 then 1 else if bit_and(v, 7) != 0 or v == 0 then 0 else if load8(v) == 1 then 1 else 0
fn rtd_sw(s) = let n = rt_slen(s) in let p = rt_sptr(s, rtd_s() + 856) in sys_call(1, rtd_ofd(), p, n, 0, 0)
fn rtd_val2(v, q) = let a = (if q == 1 then rtd_ch(34) else 0) in let s = str(v) in let w = rtd_sw(s) in if q == 1 then rtd_ch(34) else 0
fn rtd_val(v) = if v == 0 then rtd_puts("(not set)") else rtd_val2(v, rtd_isstr(v))

## NAME (FILE:LINE)
fn rtd_where(e) = let a = rtd_puts(load64(e + 8)) in let f = load64(e + 16) in if load64(e + 24) <= 0 then 0 else let b = rtd_puts(" (") in let c = (if f != 0 then (let x = rtd_puts(f) in rtd_ch(58)) else rtd_puts("line ")) in let d = rtd_num(load64(e + 24)) in rtd_ch(41)
fn rtd_nloc(e) = if load64(e + 32) == 0 then 0 else load64(load64(e + 32))
fn rtd_loc(e, i) = load64(e + 32) + 16 + i * 16
## "  name = value" per local from i to n
fn rtd_vars(e, fp, i, n) = if i >= n then 0 else let l = rtd_loc(e, i) in let a = rtd_puts("  ") in let b = rtd_puts(load64(l)) in let c = rtd_puts(" = ") in let d = rtd_val(load64(fp + load64(l + 8))) in let z = rtd_ch(10) in rtd_vars(e, fp, i + 1, n)
## "name=value, ..." for the parameters (the call stack)
fn rtd_alist(e, fp, i, n) = if i >= n then 0 else let l = rtd_loc(e, i) in let s = (if i > 0 then rtd_puts(", ") else 0) in let b = rtd_puts(load64(l)) in let c = rtd_ch(61) in let d = rtd_val(load64(fp + load64(l + 8))) in rtd_alist(e, fp, i + 1, n)
fn rtd_np(e) = if load64(e + 32) == 0 then 0 else load64(load64(e + 32) + 8)

## frames: the row of a return address, the next frame checked before it is read (aligned, above, below the top)
fn rtd_tab() = sym_addr("__lume_dbgtab")
fn rtd_find(tab, ra, i, n, best) = if i >= n then best else let e = tab + 16 + i * 56 in if load64(e) <= ra then rtd_find(tab, ra, i + 1, n, e) else best
fn rtd_lookup(ra) = let tab = rtd_tab() in let n = load64(tab) in if n <= 0 or ra >= load64(tab + 8) then 0 else rtd_find(tab, ra, 0, n, 0)
fn rtd_ok(fp, prev) = let top = load64(sym_addr("__gc_stack_top")) in if fp == 0 or bit_and(fp, 7) != 0 or fp <= prev or fp >= top then 0 else 1
fn rtd_user(e) = if e == 0 then 0 else let nm = load64(e + 8) in if load8(nm) == 95 and load8(nm + 1) == 95 then 0 else 1
## the call stack from (e, fp) outwards: one line per function of the program, `*` on the selected frame
fn rtd_fline(e, fp, k) = let a = rtd_puts((if fp == load64(rtd_s() + 24) then "* #" else "  #")) in let b = rtd_num(k) in let c = rtd_ch(32) in let d = rtd_puts(load64(e + 8)) in let f = rtd_ch(40) in let g = rtd_alist(e, fp, 0, rtd_np(e)) in let h = rtd_ch(41) in let i = (if load64(e + 24) > 0 then rtd_fat(e) else 0) in rtd_ch(10)
fn rtd_fat(e) = let a = rtd_puts(" at ") in let f = load64(e + 16) in let b = (if f != 0 then (let x = rtd_puts(f) in rtd_ch(58)) else rtd_puts("line ")) in rtd_num(load64(e + 24))
fn rtd_bt(e, fp, k, d) = if d >= 256 then k else let p = (if rtd_user(e) == 1 then rtd_fline(e, fp, k) else 0) in let k2 = (if rtd_user(e) == 1 then k + 1 else k) in let nfp = load64(fp) in if rtd_ok(nfp, fp) == 0 then rtd_btend(k2) else rtd_bt(rtd_lookup(load64(fp + 8)), nfp, k2, d + 1)
fn rtd_btend(k) = let a = rtd_puts("  #") in let b = rtd_num(k) in let c = rtd_puts(" (top level)\n") in k
## select the k-th function frame (0 = the stopped one): 1 when it exists
fn rtd_sel(e, fp, k, want, d) = if d >= 256 then 0 else if rtd_user(e) == 1 and k == want then rtd_setsel(e, fp, k) else let k2 = (if rtd_user(e) == 1 then k + 1 else k) in let nfp = load64(fp) in if rtd_ok(nfp, fp) == 0 then 0 else rtd_sel(rtd_lookup(load64(fp + 8)), nfp, k2, want, d + 1)
fn rtd_setsel(e, fp, k) = let a = store64(rtd_s() + 24, fp) in let b = store64(rtd_s() + 32, e) in let c = store64(rtd_s() + 56, k) in 1
fn rtd_depth(e, fp, k, d) = if d >= 256 then k else let k2 = (if rtd_user(e) == 1 then k + 1 else k) in let nfp = load64(fp) in if rtd_ok(nfp, fp) == 0 then k2 else rtd_depth(rtd_lookup(load64(fp + 8)), nfp, k2, d + 1)

## words of a command line
fn rtd_isw(p, l) = let c = load8(l) in if c == 0 then (let d = load8(p) in if d == 0 or d == 32 then 1 else 0) else if load8(p) != c then 0 else rtd_isw(p + 1, l + 1)
fn rtd_sks(p) = if load8(p) == 32 then rtd_sks(p + 1) else p
fn rtd_skw(p) = let c = load8(p) in if c == 0 or c == 32 then rtd_sks(p) else rtd_skw(p + 1)
fn rtd_atoi(p, acc) = let c = load8(p) in if c >= 48 and c <= 57 then rtd_atoi(p + 1, acc * 10 + c - 48) else acc
fn rtd_pfx(a, b) = if load8(b) == 0 then a else if load8(a) != load8(b) then 0 else rtd_pfx(a + 1, b + 1)
## a function's label is its name, or NAME__module for a name two modules define
fn rtd_nmeq(lab, arg) = let r = rtd_pfx(lab, arg) in if r == 0 then 0 else if load8(r) == 0 then 1 else if load8(r) == 95 and load8(r + 1) == 95 then 1 else 0
fn rtd_lastc(p, best) = let c = load8(p) in if c == 0 then best else rtd_lastc(p + 1, (if c == 58 then p else best))
## f ends with s at a path boundary
fn rtd_ends(f, s) = let lf = rtd_len(f, 0) in let ls = rtd_len(s, 0) in if ls == 0 or ls > lf then 0 else if streq(f + lf - ls, s) == 0 then 0 else if ls == lf then 1 else let c = load8(f + lf - ls - 1) in if c == 47 or c == 92 then 1 else 0

## breakpoints
fn rtd_nbp() = load64(rtd_s() + 40)
fn rtd_isbp2(e, i, n) = if i >= n then 0 else if load64(rtd_s() + 320 + i * 8) == e then 1 else rtd_isbp2(e, i + 1, n)
fn rtd_isbp(e) = rtd_isbp2(e, 0, rtd_nbp())
fn rtd_addbp(e) = let n = rtd_nbp() in if rtd_isbp(e) == 1 then rtd_bpmsg(e) else if n >= 64 then rtd_puts("debug: at most 64 breakpoints\n") else let a = store64(rtd_s() + 320 + n * 8, e) in let b = store64(rtd_s() + 40, n + 1) in rtd_bpmsg(e)
fn rtd_bpmsg(e) = let a = rtd_puts("debug: breakpoint at ") in let b = rtd_where(e) in rtd_ch(10)
## by name: every function whose label is NAME (or NAME__module); the number found
fn rtd_bpname(arg, i, n, found) = if i >= n then found else let e = rtd_tab() + 16 + i * 56 in if rtd_user(e) == 1 and rtd_nmeq(load64(e + 8), arg) == 1 then (let a = rtd_addbp(e) in rtd_bpname(arg, i + 1, n, found + 1)) else rtd_bpname(arg, i + 1, n, found)
## by FILE:LINE: the function of that file declared last at or before the line
fn rtd_bpline(file, line, i, n, best) = if i >= n then best else let e = rtd_tab() + 16 + i * 56 in let f = load64(e + 16) in if rtd_user(e) == 1 and f != 0 and load64(e + 24) <= line and rtd_ends(f, file) == 1 and (best == 0 or load64(e + 24) > load64(best + 24)) then rtd_bpline(file, line, i + 1, n, e) else rtd_bpline(file, line, i + 1, n, best)
fn rtd_break(arg) = if load8(arg) == 0 then rtd_puts("debug: break needs a function name or FILE:LINE\n") else let c = rtd_lastc(arg, 0) in if c != 0 then rtd_break2(arg, c) else if rtd_bpname(arg, 0, load64(rtd_tab()), 0) == 0 then rtd_nofn(arg) else 0
fn rtd_break2(arg, c) = let z = store8(c, 0) in let e = rtd_bpline(arg, rtd_atoi(c + 1, 0), 0, load64(rtd_tab()), 0) in let r = store8(c, 58) in if e == 0 then rtd_nofn(arg) else rtd_addbp(e)
fn rtd_nofn(arg) = let a = rtd_puts("debug: no function of the program matches '") in let b = rtd_puts(arg) in rtd_puts("'\n")
fn rtd_delname(arg, i, n) = if i >= n then 0 else let p = rtd_s() + 320 + i * 8 in let e = load64(p) in let z = (if e != 0 and rtd_nmeq(load64(e + 8), arg) == 1 then store64(p, 0) else 0) in rtd_delname(arg, i + 1, n)
fn rtd_delete(arg) = if load8(arg) == 0 then (let a = store64(rtd_s() + 40, 0) in rtd_puts("debug: no breakpoints\n")) else let a = rtd_delname(arg, 0, rtd_nbp()) in rtd_puts("debug: deleted\n")

## variables of the selected frame
fn rtd_findvar(e, fp, arg, i, n, found) = if i >= n then found else let l = rtd_loc(e, i) in if streq(load64(l), arg) == 1 or rtd_fld(load64(l), arg) == 1 then (let a = rtd_puts("  ") in let b = rtd_puts(load64(l)) in let c = rtd_puts(" = ") in let d = rtd_val(load64(fp + load64(l + 8))) in let z = rtd_ch(10) in rtd_findvar(e, fp, arg, i + 1, n, found + 1)) else rtd_findvar(e, fp, arg, i + 1, n, found)
## a record kept as separate fields is listed as NAME.field: `print NAME` shows them all
fn rtd_fld(nm, arg) = let r = rtd_pfx(nm, arg) in if r == 0 then 0 else if load8(r) == 46 then 1 else 0
fn rtd_print(arg) = let e = load64(rtd_s() + 32) in if e == 0 then rtd_nostop() else if load8(arg) == 0 then rtd_puts("debug: print needs a variable name\n") else if rtd_findvar(e, load64(rtd_s() + 24), arg, 0, rtd_nloc(e), 0) == 0 then (let a = rtd_puts("debug: no variable '") in let b = rtd_puts(arg) in rtd_puts("' in this function\n")) else 0
fn rtd_locals(only_args) = let e = load64(rtd_s() + 32) in if e == 0 then rtd_nostop() else let n = (if only_args == 1 then rtd_np(e) else rtd_nloc(e)) in if n == 0 then rtd_puts("  (none)\n") else rtd_vars(e, load64(rtd_s() + 24), 0, n)
fn rtd_nostop() = rtd_puts("debug: no function is running yet (step or set a breakpoint, then continue)\n")
fn rtd_frame(k) = let e = load64(rtd_s() + 832) in if e == 0 then rtd_nostop() else if k < 0 then rtd_puts("debug: no such frame\n") else if rtd_sel(e, load64(rtd_s() + 840), 0, k, 0) == 0 then rtd_puts("debug: no such frame\n") else let a = rtd_puts("debug: frame ") in let b = rtd_num(k) in let c = rtd_ch(32) in let d = rtd_where(load64(rtd_s() + 32)) in rtd_ch(10)
fn rtd_where_cmd(x) = let e = load64(rtd_s() + 832) in if e == 0 then rtd_nostop() else rtd_bt(e, load64(rtd_s() + 840), 0, 0)

fn rtd_help(x) = rtd_puts("debug commands (one per line, or separated by ';'):\n  break NAME | break FILE:LINE   stop when that function starts (b)\n  delete [NAME]                  remove one or every breakpoint (d)\n  continue                       run to the next breakpoint (c, run)\n  step                           stop at the next function start or return (s)\n  next                           the same, but not inside the functions this one calls (n)\n  finish                         run until this function returns (f)\n  bt                             the call stack with each function's arguments (where)\n  args | locals                  the parameters / every variable of the selected frame (a, l)\n  print NAME                     one variable of the selected frame (p)\n  frame N | up | down            select another frame of the call stack\n  quit                           stop the program (q)\n  mark                           write `debug: mark` (ends an answer, for a program driving the debugger)\n  output FILE                    write everything from now on to FILE, appending\n")

## one command; 1 when it resumes the program
fn rtd_mode(m, fp) = let a = store64(rtd_s(), m) in let b = store64(rtd_s() + 8, fp) in 1
fn rtd_cmd(b) = if rtd_isw(b, "c") == 1 or rtd_isw(b, "continue") == 1 or rtd_isw(b, "run") == 1 or rtd_isw(b, "r") == 1 then rtd_mode(0, 0) else if rtd_isw(b, "s") == 1 or rtd_isw(b, "step") == 1 then rtd_mode(1, 0) else if rtd_isw(b, "n") == 1 or rtd_isw(b, "next") == 1 then rtd_next(2) else if rtd_isw(b, "f") == 1 or rtd_isw(b, "finish") == 1 then rtd_next(3) else rtd_cmd2(b)
fn rtd_next(m) = let fp = load64(rtd_s() + 840) in if fp == 0 then rtd_mode((if m == 2 then 1 else 0), 0) else rtd_mode(m, fp)
fn rtd_cmd2(b) = let a = rtd_skw(b) in if rtd_isw(b, "b") == 1 or rtd_isw(b, "break") == 1 then rtd_z(rtd_break(a)) else if rtd_isw(b, "d") == 1 or rtd_isw(b, "delete") == 1 then rtd_z(rtd_delete(a)) else if rtd_isw(b, "bt") == 1 or rtd_isw(b, "where") == 1 or rtd_isw(b, "backtrace") == 1 then rtd_z(rtd_where_cmd(0)) else if rtd_isw(b, "l") == 1 or rtd_isw(b, "locals") == 1 then rtd_z(rtd_locals(0)) else if rtd_isw(b, "a") == 1 or rtd_isw(b, "args") == 1 then rtd_z(rtd_locals(1)) else rtd_cmd3(b, a)
fn rtd_cmd3(b, a) = if rtd_isw(b, "p") == 1 or rtd_isw(b, "print") == 1 then rtd_z(rtd_print(a)) else if rtd_isw(b, "frame") == 1 then rtd_z(rtd_frame(rtd_atoi(a, 0))) else if rtd_isw(b, "up") == 1 then rtd_z(rtd_frame(load64(rtd_s() + 56) + 1)) else if rtd_isw(b, "down") == 1 then rtd_z(rtd_frame(load64(rtd_s() + 56) - 1)) else if rtd_isw(b, "h") == 1 or rtd_isw(b, "help") == 1 then rtd_z(rtd_help(0)) else if rtd_isw(b, "q") == 1 or rtd_isw(b, "quit") == 1 then rtd_quit(0) else if rtd_isw(b, "output") == 1 then rtd_z(rtd_output(a)) else if rtd_isw(b, "mark") == 1 then rtd_z(rtd_puts("debug: mark\n")) else rtd_z(rtd_unknown(b))
## output FILE: open it for appending (flags 1089: write, create, append; mode 0644) and write there from now on
fn rtd_output(a) = if load8(a) == 0 then rtd_puts("debug: output needs a file name\n") else let fd = sys_call(2, a, 1089, 420, 0, 0) in if fd < 0 then (let x = rtd_puts("debug: cannot open ") in let y = rtd_puts(a) in rtd_ch(10)) else let w = store64(rtd_s() + 992, fd + 1) in let x = rtd_puts("debug: output to ") in let y = rtd_puts(a) in rtd_ch(10)
fn rtd_z(x) = 0
fn rtd_unknown(b) = let a = rtd_puts("debug: unknown command '") in let c = rtd_puts(b) in rtd_puts("' (help lists the commands)\n")
fn rtd_quit(x) = let f = flush() in let a = rtd_puts("debug: quit\n") in sys_call(60, 0, 0, 0, 0, 0)

## reading commands: one byte at a time up to a newline or ';' (a carriage return is dropped, leading blanks too)
fn rtd_open(p) = if load8(p) == 43 then (let f = store64(rtd_s() + 1000, 1) in rtd_open2(p + 1)) else rtd_open2(p)
fn rtd_open2(p) = let fd = (if load8(p) == 45 and load8(p + 1) == 0 then 0 else sys_call(2, p, 0, 0, 0, 0)) in let s = store64(rtd_s() + 16, (if fd < 0 then 1 else fd + 2)) in (if fd < 0 then 0 - 1 else fd)
fn rtd_fd() = let f = load64(rtd_s() + 16) in if f != 0 then f - 2 else rtd_open(sym_addr("__lume_dbgcmd"))
fn rtd_rl(fd, b, n) = if n >= 250 then n else let r = sys_call(0, fd, b + n, 1, 0, 0) in if r == 0 and load64(rtd_s() + 1000) == 1 then (let z = rtd_nap(0) in rtd_rl(fd, b, n)) else if r <= 0 then (if n == 0 then 0 - 1 else n) else let c = load8(b + n) in if c == 10 or c == 59 then n else if c == 13 then rtd_rl(fd, b, n) else if (c == 32 or c == 9) and n == 0 then rtd_rl(fd, b, 0) else rtd_rl(fd, b, n + 1)
## 2 ms (nanosleep), while a followed command file has no new line
fn rtd_nap(x) = let t = rtd_s() + 1008 in let a = store64(t, 0) in let b = store64(t + 8, 2000000) in sys_call(35, t, 0, 0, 0, 0)
fn rtd_trim(b, n) = if n > 0 and (load8(b + n - 1) == 32 or load8(b + n - 1) == 9) then rtd_trim(b, n - 1) else n
fn rtd_readline(x) = let fd = rtd_fd() in if fd < 0 then 0 - 1 else let p = (if fd == 0 then rtd_puts("(lume debug) ") else 0) in rtd_rlend(fd, rtd_rl(fd, rtd_s() + 64, 0))
fn rtd_rlend(fd, n) = if n < 0 then n else let b = rtd_s() + 64 in let m = rtd_trim(b, n) in let z = store8(b + m, 0) in let e = (if fd != 0 and m > 0 then (let a = rtd_puts("(lume debug) ") in let c = rtd_puts(b) in rtd_ch(10)) else 0) in m
## no more commands: the program runs to its end without stopping again
fn rtd_eof(x) = let a = store64(rtd_s() + 16, 1) in let b = store64(rtd_s() + 40, 0) in let c = rtd_mode(0, 0) in if load64(rtd_s() + 48) == 1 then 0 else let d = store64(rtd_s() + 48, 1) in rtd_puts("debug: no more commands; the program runs to its end\n")
fn rtd_loop(x) = let n = rtd_readline(0) in if n < 0 then rtd_eof(0) else if n == 0 then rtd_loop(0) else if rtd_cmd(rtd_s() + 64) == 1 then 0 else rtd_loop(0)

## stopping
fn rtd_want(e, fp, kind) = let m = load64(rtd_s()) in if m == 1 then 1 else if kind == 1 and rtd_isbp(e) == 1 then 1 else if m == 2 then (if fp >= load64(rtd_s() + 8) then 1 else 0) else if m == 3 then (if fp > load64(rtd_s() + 8) then 1 else if kind == 2 and fp == load64(rtd_s() + 8) then 1 else 0) else 0
fn rtd_head(e, fp, kind, v) = let a = rtd_puts((if kind == 1 then "debug: stopped at the start of " else "debug: stopped at the return of ")) in let b = rtd_where(e) in let c = rtd_puts(", depth ") in let d = rtd_num(rtd_depth(e, fp, 0, 0)) in let f = rtd_ch(10) in if kind == 1 then rtd_vars(e, fp, 0, rtd_np(e)) else (let g = rtd_puts("  result = ") in let h = rtd_val(v) in rtd_ch(10))
fn rtd_stop(e, fp, kind, v) = let a = store64(rtd_s() + 832, e) in let b = store64(rtd_s() + 840, fp) in let c = rtd_setsel(e, fp, 0) in let f = flush() in let h = rtd_head(e, fp, kind, v) in rtd_loop(0)
fn __rt_dbg_enter(e, fp) = if rtd_want(e, fp, 1) == 1 then rtd_stop(e, fp, 1, 0) else 0
fn __rt_dbg_leave(e, fp, v) = if rtd_want(e, fp, 2) == 1 then rtd_stop(e, fp, 2, v) else 0
fn __rt_dbg_start() = let h = rtd_puts("debug: ready; the program has not started (help lists the commands)\n") in rtd_loop(0)
## a run-time error (called by rt_trace after the message, before the call stack): the innermost function of the
## program is the first word between the stack pointer and the frame that is a return address into its code; the
## debugger stops there while commands remain, then the call stack is printed and the program stops (exit 3)
fn rtd_inner(sp, fp, k) = if k >= 512 or sp + k * 8 >= fp then 0 else let e = rtd_lookup(load64(sp + k * 8)) in if rtd_user(e) == 1 then e else rtd_inner(sp, fp, k + 1)
fn rtd_trap2(fp, e) = if e == 0 then 0 else let a = store64(rtd_s() + 832, e) in let b = store64(rtd_s() + 840, fp) in let c = rtd_setsel(e, fp, 0) in let f = flush() in let h = rtd_puts("debug: stopped on the error above, in ") in let w = rtd_where(e) in let d = rtd_puts(", depth ") in let n = rtd_num(rtd_depth(e, fp, 0, 0)) in let z = rtd_ch(10) in rtd_loop(0)
fn __rt_dbg_trap(fp, sp) = if load64(rtd_tab()) <= 0 or load64(rtd_s() + 16) == 1 or sp <= 0 or bit_and(sp, 7) != 0 or sp >= fp then 0 else rtd_trap2(fp, rtd_inner(sp, fp, 0))
