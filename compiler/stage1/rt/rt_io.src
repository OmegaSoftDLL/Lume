## rt_io.src -- standard input builtins of the runtime, written in Lume (the golden rule: the runtime is Lume source).
## Compiled by `lumec --raw` and embedded by gen_runtime.src into runtime_lume.lume, in every program.

## one line of standard input without its "\n" (read a byte at a time, so nothing past the line is consumed); "" at
## the end of input. The buffer starts at 256 bytes and doubles.
fn read() = rt_rd_line(__lume_alloc_a(257), 0, 256)
fn rt_rd_line(b, n, cap) =
    if n >= cap then
        let nb = __lume_alloc_a(2 * cap + 1) in
        let c = rt_copyn(nb, b, 0, n) in
        rt_rd_line(nb, n, 2 * cap)
    else if sys_call(0, 0, b + n, 1, 0, 0) != 1 then
        __rt_mkstrn(b, n)
    else if load8(b + n) == 10 then
        __rt_mkstrn(b, n)
    else
        rt_rd_line(b, n + 1, cap)

## all of standard input up to its end (a buffer from 64 KiB, doubling)
fn readall() = rt_rd_all(__lume_alloc_a(65537), 0, 65536)
fn rt_rd_all(b, n, cap) =
    if n >= cap then
        let nb = __lume_alloc_a(2 * cap + 1) in
        let c = rt_copyn(nb, b, 0, n) in
        rt_rd_all(nb, n, 2 * cap)
    else
        let r = sys_call(0, 0, b + n, cap - n, 0, 0) in
        if r <= 0 then
            __rt_mkstrn(b, n)
        else
            rt_rd_all(b, n + r, cap)
