        let bx = bit_and(r, 3) * 4 in
        let by = bit_shr(r, 2) * 4 in
        let rs = load64(x + 16) in
        let a1 = rtc_p16blk(load64(x + 80) + 640 + by * 16 + bx, s + 16) in
        rtc_recdc(s + 16, load64(x) + 8 + load64(x + 8) + by * rs + bx, rs, rtc_asr(load64(s + 2176 + r * 8) + 32, 6), 0)
fn rtc_i16full(x, r) =
    let s = x - 256 in
    let bx = bit_and(r, 3) * 4 in
    let by = bit_shr(r, 2) * 4 in
    let rs = load64(x + 16) in
    let a1 = rtc_p16blk(load64(x + 80) + 640 + by * 16 + bx, s + 16) in
    let a2 = rtc_dqf(s + 1280 + r * 32, s + 128, load64(x + 112)) in
    let a3 = rtc_w16(s + 128, load64(s + 2176 + r * 8)) in
    let t = vec_idct4(s + 128, s + 160) in
    rtc_recf(s + 16, s + 160, load64(x) + 8 + load64(x + 8) + by * rs + bx, rs, 0)
fn rtc_i16recs(x, r) = if r >= 16 then 0 else let z = rtc_i16rec(x, r) in rtc_i16recs(x, r + 1)
fn rtc_cprows16(p, d, rs, y) =
    if y >= 16 then
        0
    else
        let z = rtc_cpn(p + y * 16, d + y * rs, 16) in
        rtc_cprows16(p, d, rs, y + 1)
fn buf_h264_mb_i16(src, si, ss, rec, ri, cfg) = rtc_mbi16(src, rt_int(si), rt_int(ss), rec, rt_int(ri), cfg)
fn rtc_mbi16(src, si, ss, rec, ri, cfg) =
    if rtc_fits(cfg, 0, 896) == 0 then
        mkint(0 - 1)
    else
        let c = cfg + 8 in
        let rs = load32(c) in
        let qp = load32(c + 4) in
        if ss < 16 or rs < 16 or qp > 51 or si < 0 or ri < 0 or rtc_fits(src, si, 15 * ss + 16) == 0 or rtc_fits(rec, ri, 15 * rs + 16) == 0 then
