        let a = store8(c + 64 + b, load64(s + 1792 + r * 8)) in
        let z = rtc_zzout(s + 1280 + r * 32, c + 96 + b * 32, 0) in
        rtc_acout(s, c, b + 1)
## decoding of raster block r into rec
## a block without AC levels decodes to the constant (d0 + 32) >> 6 (the inverse transform of a DC-only block):
## prediction + constant, no dequantization or inverse transform; else the full path
fn rtc_recdc(p, d, fs, k, i) =
    if i >= 16 then
        0
    else
