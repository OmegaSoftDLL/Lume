## --- one chroma plane of an inter macroblock (4:2:0, 8x8) ------------------------------------------------------------------
## buf_h264_mb_pc(src, si, ss, ref, rec, cfg): the 8x8 chroma block at src + si (rows ss apart) predicted from ref with
## the macroblock's luma vector (eighth chroma samples, 8.4.2.2.2, as buf_h264_chroma_mc; into cfg bytes 256..319, rows
## 8 apart), then the 4 residual 4x4 blocks are transformed; their DC coefficients go through the 2x2 Hadamard and the
## chroma DC quantization (8.5.11: |f| MF0 + 2 f >> qbits + 1, inter rounding), the AC through the 4x4 quantization;
## decoding mirrors it (DC: ((Hadamard(z) V0) << qPc/6) >> 1) and the reconstruction goes into rec. qPc comes from
## the luma QP plus the chroma offset through table 8-15. ref and rec: plane at offset 0, rows rs apart. cfg (at least
## 512 bytes, int32): in rs (0), QPY (4), chroma_qp_index_offset (8, signed), plane width (12) and height (16), block x
## (20) and y (24) in chroma samples, the luma vector mvx (28) and mvy (32) in quarter luma samples; out the AC nonzero
## count per 4x4 block in raster order (40..43), the DC nonzero count (44), the 4 DC levels as int16 in raster order
## (48..55, chroma DC CAVLC order), per block the 16 levels in zigzag order (64 + 32 x block; the first, the DC, is 0:
## code it with buf_h264_cavlc6 at 64 + 32 x block + 2, maxc 15) and this plane's part of the coded_block_pattern (int32
## at 200: 0, 1 DC only, 2 AC). Answers the total nonzero levels or -1 on a wrong argument.
fn rtc_qpc(q) =
    if q < 30 then
        q
    else
        let t = q - 30 in
        if t <= 2 then
            29 + t
        else if t <= 4 then
            32
        else if t == 5 then
            33
        else if t <= 7 then
            34
        else if t <= 9 then
            35
        else if t <= 11 then
            36
        else if t <= 14 then
            37
        else if t <= 17 then
            38
        else
            39
fn rtc_pblk8(p, d) =
    let a = store32(d, load32(p)) in
    let b = store32(d + 4, load32(p + 8)) in
    let c = store32(d + 8, load32(p + 16)) in
    store32(d + 12, load32(p + 24))
fn rtc_nzc(p, i, n) = if i >= 16 then n else rtc_nzc(p, i + 1, n + (if rtc_r16(p + i * 2) != 0 then 1 else 0))
## context x (scratch 256): 0 rec, 16 rs, 32 ss, 80 cfg data, 88 source block, 96 block offset in rec, 112 qPc;
## scratch: W of block b at 512 + 32 b, its levels at 640 + 32 b, DC levels (words) at 768, dequantized DC at 800
fn rtc_cfw(x, b) =
    let s = x - 256 in
    let c = load64(x + 144) in
    let ss = load64(x + 32) in
    let a1 = rtc_pblk8(c + 256 + bit_and(b, 1) * 4 + bit_shr(b, 1) * 32, s + 16) in
    let a2 = rtc_sub(load64(x + 88) + bit_shr(b, 1) * 4 * ss + bit_and(b, 1) * 4, ss, s + 16, s + 32, 0) in
    let a3 = vec_fdct4(s + 32, s + 512 + b * 32) in
    let n = rtc_q4(s + 512 + b * 32, s + 640 + b * 32, load64(x + 112), load64(x + 160)) in
    let z = rtc_w16(s + 640 + b * 32, 0) in
    rtc_nzc(s + 640 + b * 32, 0, 0)
fn rtc_qdc(f, mf, fq2, qb1) =
    let a = if f < 0 then 0 - f else f in
    let z = bit_shr(a * mf + fq2, qb1) in
    if f < 0 then
        0 - z
    else
        z
fn rtc_cdc(x) =
    let s = x - 256 in
    let q = load64(x + 112) in
    let qb = 15 + q / 6 in
    let fq2 = 2 * (bit_shl(1, qb) / (if load64(x + 160) != 0 then 3 else 6)) in
    let mf = rtc_mf(q % 6, 0) in
    let c0 = rtc_r16(s + 512) in
    let c1 = rtc_r16(s + 544) in
    let c2 = rtc_r16(s + 576) in
    let c3 = rtc_r16(s + 608) in
    let a = store64(s + 768, rtc_qdc(c0 + c1 + c2 + c3, mf, fq2, qb + 1)) in
    let b = store64(s + 776, rtc_qdc(c0 - c1 + c2 - c3, mf, fq2, qb + 1)) in
    let d = store64(s + 784, rtc_qdc(c0 + c1 - c2 - c3, mf, fq2, qb + 1)) in
    store64(s + 792, rtc_qdc(c0 - c1 - c2 + c3, mf, fq2, qb + 1))
fn rtc_cdq1(g, v, q6) = rtc_asr(g * v * bit_shl(1, q6), 1)
fn rtc_cidc(x) =
    let s = x - 256 in
    let q = load64(x + 112) in
    let v = rtc_v(q % 6, 0) in
    let q6 = q / 6 in
    let z0 = load64(s + 768) in
    let z1 = load64(s + 776) in
    let z2 = load64(s + 784) in
    let z3 = load64(s + 792) in
    let a = store64(s + 800, rtc_cdq1(z0 + z1 + z2 + z3, v, q6)) in
    let b = store64(s + 808, rtc_cdq1(z0 - z1 + z2 - z3, v, q6)) in
    let d = store64(s + 816, rtc_cdq1(z0 + z1 - z2 - z3, v, q6)) in
    store64(s + 824, rtc_cdq1(z0 - z1 - z2 + z3, v, q6))
fn rtc_cdcnz(s, k, n) = if k >= 4 then n else rtc_cdcnz(s, k + 1, n + (if load64(s + 768 + k * 8) != 0 then 1 else 0))
## decoding of block b: AC dequantized, the DC from the 2x2 path, inverse transform, added to the prediction
fn rtc_crec(x, b) =
    if load8(load64(x + 144) + 40 + b) != 0 then
        rtc_cfull(x, b)
    else
        let s = x - 256 in
        let c = load64(x + 144) in
        let rs = load64(x + 16) in
        let a1 = rtc_pblk8(c + 256 + bit_and(b, 1) * 4 + bit_shr(b, 1) * 32, s + 16) in
        rtc_recdc(s + 16, load64(x) + 8 + load64(x + 96) + bit_shr(b, 1) * 4 * rs + bit_and(b, 1) * 4, rs, rtc_asr(load64(s + 800 + b * 8) + 32, 6), 0)
fn rtc_cfull(x, b) =
    let s = x - 256 in
    let c = load64(x + 144) in
    let rs = load64(x + 16) in
    let a1 = rtc_pblk8(c + 256 + bit_and(b, 1) * 4 + bit_shr(b, 1) * 32, s + 16) in
    let a2 = rtc_dqf(s + 640 + b * 32, s + 128, load64(x + 112)) in
    let a3 = rtc_w16(s + 128, load64(s + 800 + b * 8)) in
    let t = vec_idct4(s + 128, s + 160) in
    rtc_recf(s + 16, s + 160, load64(x) + 8 + load64(x + 96) + bit_shr(b, 1) * 4 * rs + bit_and(b, 1) * 4, rs, 0)
fn rtc_ccopy(x, b) =
    let s = x - 256 in
    let c = load64(x + 144) in
    let rs = load64(x + 16) in
    let a1 = rtc_pblk8(c + 256 + bit_and(b, 1) * 4 + bit_shr(b, 1) * 32, s + 16) in
    rtc_cpf(s + 16, load64(x) + 8 + load64(x + 96) + bit_shr(b, 1) * 4 * rs + bit_and(b, 1) * 4, rs)
fn rtc_cout(x, b, nz) =
    let s = x - 256 in
    let c = load64(x + 144) in
    let a = store8(c + 40 + b, nz) in
    rtc_zzout(s + 640 + b * 32, c + 64 + b * 32, 0)
fn buf_h264_mb_pc(src, si, ss, ref, rec, cfg) = rtc_mbpc(src, rt_int(si), rt_int(ss), ref, rec, cfg)
fn rtc_mbpc(src, si, ss, ref, rec, cfg) =
    if rtc_fits(cfg, 0, 512) == 0 then
        mkint(0 - 1)
    else
        let c = cfg + 8 in
        let rs = load32(c) in
        let qy = load32(c + 4) in
        let pw = load32(c + 12) in
        let ph = load32(c + 16) in
        let bx = load32(c + 20) in
        let by = load32(c + 24) in
        let off = rtc_s32(load32(c + 8)) in
        if ss < 8 or rs < 8 or rs > 65535 or qy > 51 or off < 0 - 12 or off > 12 or pw < 8 or ph < 8 or pw > rs or ph > 65535 or bx + 8 > pw or by + 8 > ph or si < 0 or rtc_fits(src, si, 7 * ss + 8) == 0 or rtc_fits(ref, 0, (ph - 1) * rs + pw) == 0 or rtc_fits(rec, 0, (ph - 1) * rs + pw) == 0 then
            mkint(0 - 1)
        else
            rtc_mbpc2(src, si, ss, ref, rec, cfg)
fn rtc_mbpc2(src, si, ss, ref, rec, cfg) =
    let c = cfg + 8 in
    let rs = load32(c) in
    let qx = 8 * load32(c + 20) + rtc_s32(load32(c + 28)) in
    let qy = 8 * load32(c + 24) + rtc_s32(load32(c + 32)) in
    if qx <= 0 - 536870912 or qx >= 536870912 or qy <= 0 - 536870912 or qy >= 536870912 then
        mkint(0 - 1)
    else
        let r = rtc_mc(ref, cfg, rs, 256 * 65536 + 8, load32(c + 12) + load32(c + 16) * 65536 + 8 * 4294967296 + 8 * 1099511627776, (qx + 536870912 + (qy + 536870912) * 1073741824) * 4 + 3) in
        if r == mkint(0 - 1) then
            r
        else
            rtc_mbpc3(src, si, ss, rec, cfg)
fn rtc_mbpc3(src, si, ss, rec, cfg) =
    let c = cfg + 8 in
    let x = sym_addr("__rtc_scratch") + 256 in
    let s = x - 256 in
    let qi = load32(c + 4) + rtc_s32(load32(c + 8)) in
    let a1 = store64(x, rec) in
    let a2 = store64(x + 16, load32(c)) in
    let a3 = store64(x + 32, ss) in
    let a5 = store64(x + 80, c) in
    let a6 = store64(x + 88, src + 8 + si) in
    let a7 = store64(x + 96, load32(c + 24) * load32(c) + load32(c + 20)) in
    let a9 = store64(x + 112, rtc_qpc(if qi < 0 then 0 else if qi > 51 then 51 else qi)) in
    let b1 = store64(x + 144, c) in
    let b2 = store64(x + 160, 0) in
    rtc_cplane(x)
## the residual of one chroma plane once its prediction is at o + 256 (rows 8 apart): o = x[144] (the output base),
## x[160] = 1 for the intra rounding; outputs at o + 40 .. o + 203 as described for buf_h264_mb_pc; answers the count
fn rtc_cplane(x) =
    let s = x - 256 in
    let c = load64(x + 144) in
    let n0 = rtc_cfw(x, 0) in
    let n1 = rtc_cfw(x, 1) in
    let n2 = rtc_cfw(x, 2) in
    let n3 = rtc_cfw(x, 3) in
    let d = rtc_cdc(x) in
    let nd = rtc_cdcnz(s, 0, 0) in
    let o0 = rtc_cout(x, 0, n0) in
    let o1 = rtc_cout(x, 1, n1) in
    let o2 = rtc_cout(x, 2, n2) in
    let o3 = rtc_cout(x, 3, n3) in
    let na = n0 + n1 + n2 + n3 in
    let w1 = store8(c + 44, nd) in
    let w2 = rtc_w16(c + 48, load64(s + 768)) in
    let w3 = rtc_w16(c + 50, load64(s + 776)) in
    let w4 = rtc_w16(c + 52, load64(s + 784)) in
    let w5 = rtc_w16(c + 54, load64(s + 792)) in
    let w6 = store32(c + 200, if na > 0 then 2 else if nd > 0 then 1 else 0) in
    let r = if na + nd == 0 then rtc_cpy4(x) else rtc_rec4(x) in
    mkint(na + nd)
fn rtc_cpy4(x) = let a = rtc_ccopy(x, 0) in let b = rtc_ccopy(x, 1) in let c = rtc_ccopy(x, 2) in rtc_ccopy(x, 3)
fn rtc_rec4(x) =
    let i = rtc_cidc(x) in
    let a = rtc_crec(x, 0) in
    let b = rtc_crec(x, 1) in
    let c = rtc_crec(x, 2) in
    rtc_crec(x, 3)

## --- intra chroma of a macroblock (both planes, one mode) -------------------------------------------------------------------
## buf_h264_mb_ic(srcu, srcv, recu, recv, cfg): the 8x8 Cb and Cr blocks at srcu / srcv + si (rows ss apart) predicted
## from the reconstructions recu / recv (block at ri, rows rs apart) with the intra_chroma_pred_mode (0 DC with the
## per-4x4 rules of 8.3.4.1-3, 1 horizontal, 2 vertical, 3 plane; shared by both planes) of least SATD(Cb) + SATD(Cr)
## among those the neighbours allow (a tie keeps the lower mode); unless decide only, each plane is then coded as
## buf_h264_mb_pc does (2x2 DC path, AC levels, reconstruction) with the intra rounding. cfg (at least 1344 bytes,
## int32): in rs (0), ss (4), QPY (8), chroma_qp_index_offset (12, signed), si (16), ri (20), neighbours (24: 1 left,
## 2 top, 8 top-left), flags (28: 1 decide only); out the mode (32) and its cost (36); the Cb outputs at 512 + the
## offsets of buf_h264_mb_pc (AC counts 552.., DC count 556, DC levels 560..567, zigzag levels 576 + 32 x block, cbp
## part 712, prediction 768..831) and the Cr outputs at 1024 + the same offsets. Answers the cost or -1.
fn rtc_rep8(v) = v * 72340172838076673
fn rtc_ct(p, rs, i) = load8(p - rs + i)
fn rtc_cl4(p, rs, j) = load8(p + j * rs - 1)
fn rtc_cst(p, rs, x0) = rtc_ct(p, rs, x0) + rtc_ct(p, rs, x0 + 1) + rtc_ct(p, rs, x0 + 2) + rtc_ct(p, rs, x0 + 3)
fn rtc_csl(p, rs, y0) = rtc_cl4(p, rs, y0) + rtc_cl4(p, rs, y0 + 1) + rtc_cl4(p, rs, y0 + 2) + rtc_cl4(p, rs, y0 + 3)
## DC of chroma 4x4 block k (8.3.4.1-3): the corner blocks prefer both sides, the top-right one the top, the bottom-left
## one the left
fn rtc_cdcv(p, rs, k, av) =
    let x0 = bit_and(k, 1) * 4 in
    let y0 = bit_shr(k, 1) * 4 in
    let t = if bit_and(av, 2) != 0 then 1 else 0 in
    let l = if bit_and(av, 1) != 0 then 1 else 0 in
    if x0 == 0 and y0 == 0 or x0 > 0 and y0 > 0 then
        (if t == 1 and l == 1 then bit_shr(rtc_cst(p, rs, x0) + rtc_csl(p, rs, y0) + 4, 3) else if l == 1 then bit_shr(rtc_csl(p, rs, y0) + 2, 2) else if t == 1 then bit_shr(rtc_cst(p, rs, x0) + 2, 2) else 128)
    else if x0 > 0 then
        (if t == 1 then bit_shr(rtc_cst(p, rs, x0) + 2, 2) else if l == 1 then bit_shr(rtc_csl(p, rs, y0) + 2, 2) else 128)
    else if l == 1 then
        bit_shr(rtc_csl(p, rs, y0) + 2, 2)
    else if t == 1 then
        bit_shr(rtc_cst(p, rs, x0) + 2, 2)
    else
        128
fn rtc_cfill4(d, k, v) =
    let o = d + bit_shr(k, 1) * 32 + bit_and(k, 1) * 4 in
    let w = rtc_rep4(v) in
    let a = store32(o, w) in
    let b = store32(o + 8, w) in
    let c = store32(o + 16, w) in
    store32(o + 24, w)
fn rtc_crows(d, v, y) = if y >= 8 then 0 else let w = store64(d + y * 8, v) in rtc_crows(d, v, y + 1)
fn rtc_chrows(p, rs, d, y) =
    if y >= 8 then
        0
    else
        let w = store64(d + y * 8, rtc_rep8(rtc_cl4(p, rs, y))) in
        rtc_chrows(p, rs, d, y + 1)
## plane (8.3.4.4, 4:2:0): H and V over 4 pairs, b = (34 H + 32) >> 6, c = (34 V + 32) >> 6
fn rtc_cph(p, rs, k, acc) =
    if k >= 4 then
        acc
    else
        rtc_cph(p, rs, k + 1, acc + (k + 1) * (rtc_ct(p, rs, 4 + k) - rtc_ct(p, rs, 2 - k)))
fn rtc_cpv(p, rs, k, acc) =
    if k >= 4 then
        acc
    else
        rtc_cpv(p, rs, k + 1, acc + (k + 1) * (rtc_cl4(p, rs, 4 + k) - rtc_cl4(p, rs, 2 - k)))
fn rtc_cpl(d, a, b, c, i) =
    if i >= 64 then
        0
    else
        let x = bit_and(i, 7) in
        let y = bit_shr(i, 3) in
        let w = store8(d + i, rtc_clip(rtc_asr(a + b * (x - 3) + c * (y - 3) + 16, 5))) in
        rtc_cpl(d, a, b, c, i + 1)
fn rtc_cplane8(p, rs, d) =
    let a = 16 * (rtc_cl4(p, rs, 7) + rtc_ct(p, rs, 7)) in
    let b = rtc_asr(34 * rtc_cph(p, rs, 0, 0) + 32, 6) in
    let c = rtc_asr(34 * rtc_cpv(p, rs, 0, 0) + 32, 6) in
    rtc_cpl(d, a, b, c, 0)
fn rtc_cpred(p, rs, m, av, d) =
    if m == 0 then
        let a = rtc_cfill4(d, 0, rtc_cdcv(p, rs, 0, av)) in
        let b = rtc_cfill4(d, 1, rtc_cdcv(p, rs, 1, av)) in
        let c = rtc_cfill4(d, 2, rtc_cdcv(p, rs, 2, av)) in
        rtc_cfill4(d, 3, rtc_cdcv(p, rs, 3, av))
    else if m == 1 then
        rtc_chrows(p, rs, d, 0)
    else if m == 2 then
        rtc_crows(d, load64(p - rs), 0)
    else
        rtc_cplane8(p, rs, d)
fn rtc_cmok(m, av) =
    if m == 0 then
        1
    else if m == 1 then
        (if bit_and(av, 1) != 0 then 1 else 0)
    else if m == 2 then
        (if bit_and(av, 2) != 0 then 1 else 0)
    else if bit_and(av, 11) == 11 then
        1
    else
        0
fn rtc_satd8(a, sa, b) = rts_satd4(a, sa, b, 8) + rts_satd4(a + 4, sa, b + 4, 8) + rts_satd4(a + 4 * sa, sa, b + 32, 8) + rts_satd4(a + 4 * sa + 4, sa, b + 36, 8)
## decision context y (scratch 1200): 0 Cb source, 8 Cr source, 16 ss, 24 Cb rec block, 32 Cr rec block, 40 rs,
## 48 neighbours, 56 best cost, 64 best mode
fn rtc_ictry(y, m) =
    let s = sym_addr("__rtc_scratch") in
    let a = rtc_cpred(load64(y + 24), load64(y + 40), m, load64(y + 48), s + 1024) in
    let b = rtc_cpred(load64(y + 32), load64(y + 40), m, load64(y + 48), s + 1088) in
    let c = rtc_satd8(load64(y), load64(y + 16), s + 1024) + rtc_satd8(load64(y + 8), load64(y + 16), s + 1088) in
    if c < load64(y + 56) then
        let d = store64(y + 56, c) in
        store64(y + 64, m)
    else
        0
fn rtc_icsrch(y, m) =
    if m > 3 then
        0
    else
        let z = if rtc_cmok(m, load64(y + 48)) == 1 then rtc_ictry(y, m) else 0 in
        rtc_icsrch(y, m + 1)
## code one plane: rec object, its source block, output base o
fn rtc_icplane(rec, sp, c, o) =
    let x = sym_addr("__rtc_scratch") + 256 in
    let qi = load32(c + 8) + rtc_s32(load32(c + 12)) in
    let a1 = store64(x, rec) in
    let a2 = store64(x + 16, load32(c)) in
    let a3 = store64(x + 32, load32(c + 4)) in
    let a5 = store64(x + 80, c) in
    let a6 = store64(x + 88, sp) in
    let a7 = store64(x + 96, load32(c + 20)) in
    let a9 = store64(x + 112, rtc_qpc(if qi < 0 then 0 else if qi > 51 then 51 else qi)) in
    let b1 = store64(x + 144, o) in
    let b2 = store64(x + 160, 1) in
    rtc_cplane(x)
fn buf_h264_mb_ic(srcu, srcv, recu, recv, cfg) =
    if rtc_fits(cfg, 0, 1344) == 0 then
        mkint(0 - 1)
    else
        rtc_mbic(srcu, srcv, recu, recv, cfg + 8)
fn rtc_mbic(srcu, srcv, recu, recv, c) =
    let rs = load32(c) in
    let ss = load32(c + 4) in
    let qy = load32(c + 8) in
    let off = rtc_s32(load32(c + 12)) in
    let si = load32(c + 16) in
    let ri = load32(c + 20) in
    let av = bit_and(load32(c + 24), 11) in
    if ss < 8 or rs < 8 or qy > 51 or off < 0 - 12 or off > 12 or rtc_fits(srcu, si, 7 * ss + 8) == 0 or rtc_fits(srcv, si, 7 * ss + 8) == 0 or rtc_fits(recu, ri, 7 * rs + 8) == 0 or rtc_fits(recv, ri, 7 * rs + 8) == 0 or bit_and(av, 2) != 0 and ri < rs or bit_and(av, 1) != 0 and ri < 1 or bit_and(av, 8) != 0 and ri < rs + 1 then
        mkint(0 - 1)
    else
        rtc_mbic2(srcu, srcv, recu, recv, c)
fn rtc_mbic2(srcu, srcv, recu, recv, c) =
    let y = sym_addr("__rtc_scratch") + 1200 in
    let si = load32(c + 16) in
    let ri = load32(c + 20) in
    let a0 = store64(y, srcu + 8 + si) in
    let a1 = store64(y + 8, srcv + 8 + si) in
    let a2 = store64(y + 16, load32(c + 4)) in
    let a3 = store64(y + 24, recu + 8 + ri) in
    let a4 = store64(y + 32, recv + 8 + ri) in
    let a5 = store64(y + 40, load32(c)) in
    let a6 = store64(y + 48, bit_and(load32(c + 24), 11)) in
    let a7 = store64(y + 56, 1099511627776) in
    let a8 = store64(y + 64, 0) in
    let z = rtc_icsrch(y, 0) in
    let m = load64(y + 64) in
    let cost = load64(y + 56) in
    let o1 = store32(c + 32, m) in
    let o2 = store32(c + 36, cost) in
    let p1 = rtc_cpred(recu + 8 + ri, load32(c), m, load64(y + 48), c + 768) in
    let p2 = rtc_cpred(recv + 8 + ri, load32(c), m, load64(y + 48), c + 1280) in
    if bit_and(load32(c + 28), 1) != 0 then
        mkint(cost)
    else
        let u = rtc_icplane(recu, srcu + 8 + si, c, c + 512) in
        let v = rtc_icplane(recv, srcv + 8 + si, c, c + 1024) in
        mkint(cost)

## --- motion search for one 16x16 macroblock --------------------------------------------------------------------------------
## buf_h264_me16(src, si, ss, ref, cfg): the vector of the luma macroblock at src + si (rows ss apart) in the reference
## picture ref (luma plane at offset 0, rows cfg.rs apart). Integer stage: the candidates (0, 0) and the predicted vector
## rounded to whole samples, then a small diamond (right, left, down, up of the current best; move to the cheapest while
## one is cheaper, at most 64 steps), over positions whose block lies inside the picture and within the range;
## cost = SAD + lambda x the bits of the vector difference (se(v) lengths of 4x - pmx and 4y - pmy). Sub-sample stage
## (level 1: half, 2: half then quarter): the 8 neighbours of the best at distance 2 then 1 quarter samples, in the order
## (-,-) (0,-) (+,-) (-,0) (+,0) (-,+) (0,+) (+,+), cost = SATD of the quarter-sample prediction (as buf_h264_luma_mc)
## + lambda x the vector bits; ties keep the earlier candidate. cfg (at least 1088 bytes, int32 little endian): in rs
## (0), picture width (4) and height (8), macroblock x (12) and y (16), predicted vector pmx (20) and pmy (24) in
## quarter samples (signed), range in whole samples (28, 0..1024), lambda (32), sub-sample level (36, 0..2); out the
## vector mvx (40) and mvy (44) in quarter samples and its cost (48: SAD-based at level 0, SATD-based otherwise), and
## the prediction for that vector at bytes 640..895 (16 x 16, ready to compare); work words at 896..1087. Answers the cost or
## -1 on a wrong argument.
fn rtc_lg(k, n) = if k <= 1 then n else rtc_lg(bit_shr(k, 1), n + 1)
fn rtc_seb(v) = let k = if v > 0 then 2 * v - 1 else 0 - 2 * v in 2 * rtc_lg(k + 1, 0) + 1
fn rtc_mvb(w, qx, qy) = load64(w + 72) * (rtc_seb(qx - load64(w + 48)) + rtc_seb(qy - load64(w + 56)))
## work words w: 0 source block, 8 ss, 16 reference plane, 24 rs, 32 mx, 40 my, 48 pmx, 56 pmy, 64 range, 72 lambda,
## 80 width, 88 height, 96 best x, 104 best y, 112 best cost, 128 cfg, 136 ref, 144 best qx, 152 best qy, 160 cost
fn rtc_mein(w, x, y) =
    let ax = load64(w + 32) + x in
    let ay = load64(w + 40) + y in
    let r = load64(w + 64) in
    if x < 0 - r or x > r or y < 0 - r or y > r or ax < 0 or ay < 0 or ax + 16 > load64(w + 80) or ay + 16 > load64(w + 88) then
        0
    else
        1
fn rtc_mec(w, x, y) =
    if rtc_mein(w, x, y) == 0 then
        1099511627776
    else
        rts_sad_rows(load64(w), load64(w + 8), load64(w + 16) + (load64(w + 40) + y) * load64(w + 24) + load64(w + 32) + x, load64(w + 24), 16 * 64 + 16, 0) + rtc_mvb(w, 4 * x, 4 * y)
fn rtc_metry(w, x, y) =
    let c = rtc_mec(w, x, y) in
    if c < load64(w + 112) then
        let a = store64(w + 96, x) in
        let b = store64(w + 104, y) in
        store64(w + 112, c)
    else
        0
fn rtc_media(w, n) =
    if n >= 64 then
        0
    else
        let x = load64(w + 96) in
        let y = load64(w + 104) in
        let c0 = load64(w + 112) in
        let a1 = rtc_metry(w, x + 1, y) in
        let a2 = rtc_metry(w, x - 1, y) in
        let a3 = rtc_metry(w, x, y + 1) in
        let a4 = rtc_metry(w, x, y - 1) in
        if load64(w + 112) < c0 then
            rtc_media(w, n + 1)
        else
            0
## the quarter-sample prediction of vector (qx, qy) into cfg 640..895, then its SATD against the source + vector bits
fn rtc_mepred(w, qx, qy) =
    let px = 4 * load64(w + 32) + qx in
    let py = 4 * load64(w + 40) + qy in
    rtc_mc(load64(w + 136), load64(w + 128), load64(w + 24), 640 * 65536 + 16, load64(w + 80) + load64(w + 88) * 65536 + 16 * 4294967296 + 16 * 1099511627776, (px + 536870912 + (py + 536870912) * 1073741824) * 4 + 2)
fn rtc_mesp(w, qx, qy) =
    let r = rtc_mepred(w, qx, qy) in
    rts_satd_blocks(load64(w), load64(w + 8), load64(w + 128) + 8 + 640, 16, 0, 0) + rtc_mvb(w, qx, qy)
fn rtc_qtry(w, qx, qy) =
    let c = rtc_mesp(w, qx, qy) in
    if c < load64(w + 160) then
        let a = store64(w + 144, qx) in
        let b = store64(w + 152, qy) in
        store64(w + 160, c)
    else
        0
## no candidate costs less than SATD 0 + 2 lambda (one bit per vector component): at that floor the ring cannot win
fn rtc_qring(w, d) = if load64(w + 160) <= 2 * load64(w + 72) then 0 else rtc_qring2(w, d)
fn rtc_qring2(w, d) =
    let x = load64(w + 144) in
    let y = load64(w + 152) in
    let a1 = rtc_qtry(w, x - d, y - d) in
    let a2 = rtc_qtry(w, x, y - d) in
    let a3 = rtc_qtry(w, x + d, y - d) in
    let a4 = rtc_qtry(w, x - d, y) in
    let a5 = rtc_qtry(w, x + d, y) in
    let a6 = rtc_qtry(w, x - d, y + d) in
    let a7 = rtc_qtry(w, x, y + d) in
    rtc_qtry(w, x + d, y + d)
fn buf_h264_me16(src, si, ss, ref, cfg) = rtc_me(src, rt_int(si), rt_int(ss), ref, cfg)
fn rtc_me(src, si, ss, ref, cfg) =
    if rtc_fits(cfg, 0, 1088) == 0 then
        mkint(0 - 1)
    else
        let c = cfg + 8 in
        let rs = load32(c) in
        let pw = load32(c + 4) in
        let ph = load32(c + 8) in
        let mx = load32(c + 12) in
        let my = load32(c + 16) in
        if ss < 16 or rs < 16 or rs > 65535 or pw < 16 or ph < 16 or pw > rs or ph > 65535 or mx + 16 > pw or my + 16 > ph or si < 0 or load32(c + 28) > 1024 or load32(c + 36) > 2 or rtc_fits(src, si, 15 * ss + 16) == 0 or rtc_fits(ref, 0, (ph - 1) * rs + pw) == 0 then
            mkint(0 - 1)
        else
            let pmx = rtc_s32(load32(c + 20)) in
            let pmy = rtc_s32(load32(c + 24)) in
            if pmx < 0 - 1048576 or pmx > 1048576 or pmy < 0 - 1048576 or pmy > 1048576 or load32(c + 32) > 1048576 then
                mkint(0 - 1)
            else
                rtc_me2(src, si, ss, ref, cfg)
fn rtc_me2(src, si, ss, ref, cfg) =
    let c = cfg + 8 in
    let w = c + 896 in
    let pmx = rtc_s32(load32(c + 20)) in
    let pmy = rtc_s32(load32(c + 24)) in
    let a0 = store64(w, src + 8 + si) in
    let a1 = store64(w + 8, ss) in
    let a2 = store64(w + 16, ref + 8) in
    let a3 = store64(w + 24, load32(c)) in
    let a4 = store64(w + 32, load32(c + 12)) in
    let a5 = store64(w + 40, load32(c + 16)) in
    let a6 = store64(w + 48, pmx) in
    let a7 = store64(w + 56, pmy) in
    let a8 = store64(w + 64, load32(c + 28)) in
    let a9 = store64(w + 72, load32(c + 32)) in
    let b0 = store64(w + 80, load32(c + 4)) in
    let b1 = store64(w + 88, load32(c + 8)) in
    let b2 = store64(w + 128, cfg) in
    let b3 = store64(w + 136, ref) in
    rtc_me3(w, c, load32(c + 36))
fn rtc_me3(w, c, lvl) =
    let a0 = store64(w + 96, 0) in
    let a1 = store64(w + 104, 0) in
    let a2 = store64(w + 112, 1099511627776) in
    let t0 = rtc_metry(w, 0, 0) in
    let t1 = rtc_metry(w, rtc_asr(load64(w + 48) + 2, 2), rtc_asr(load64(w + 56) + 2, 2)) in
    let d = rtc_media(w, 0) in
    let b0 = store64(w + 144, 4 * load64(w + 96)) in
    let b1 = store64(w + 152, 4 * load64(w + 104)) in
    let b2 = store64(w + 160, if lvl == 0 then load64(w + 112) else rtc_mesp(w, load64(w + 144), load64(w + 152))) in
    let h = if lvl >= 1 then rtc_qring(w, 2) else 0 in
    let q = if lvl >= 2 then rtc_qring(w, 1) else 0 in
    let f = rtc_mepred(w, load64(w + 144), load64(w + 152)) in
    let o1 = store32(c + 40, bit_and(load64(w + 144), 4294967295)) in
    let o2 = store32(c + 44, bit_and(load64(w + 152), 4294967295)) in
    let o3 = store32(c + 48, load64(w + 160)) in
    mkint(load64(w + 160))
fn buf_h264_mb_i4(src, si, ss, rec, ri, cfg) = rtc_mbi4(src, rt_int(si), rt_int(ss), rec, rt_int(ri), cfg)
fn rtc_mbi4(src, si, ss, rec, ri, cfg) =
    if rtc_fits(cfg, 0, 592) == 0 then
        mkint(0 - 1)
    else
        let c = cfg + 8 in
        let rs = load32(c) in
        let qp = load32(c + 4) in
        if ss < 16 or rs < 16 or qp > 51 or si < 0 or ri < 0 or rtc_fits(src, si, 15 * ss + 16) == 0 or rtc_fits(rec, ri, 15 * rs + 16) == 0 then
            mkint(0 - 1)
        else
            let x = sym_addr("__rtc_scratch") + 256 in
            let a1 = store64(x, rec) in
            let a2 = store64(x + 16, rs) in
            let a3 = store64(x + 32, ss) in
            let a4 = store64(x + 56, load32(c + 8)) in
            let a5 = store64(x + 80, c) in
            let a6 = store64(x + 88, src + 8 + si) in
            let a7 = store64(x + 96, ri) in
            let a8 = store64(x + 104, bit_and(load32(c + 12), 15)) in
            let a9 = store64(x + 112, qp) in
            let b1 = store64(x + 120, 0) in
            let b2 = store64(x + 128, 0) in
            let z = rtc_mbloop(x, 0) in
            if load64(x + 120) != 0 then
                mkint(0 - 1)
            else
                mkint(load64(x + 128))

## --- motion compensation (8.4.2.2) --------------------------------------------------------------------------------------
## The runtime takes at most six arguments, so `use h264` (h264.src) packs the standard's argument lists:
##   buf_h264_lmc6(ref, dst, ri * 65536 + rs, di * 65536 + ds, rw + rh 2^16 + w 2^32 + h 2^40, qx + 2^29 + (qy + 2^29) 2^30)
## with qx = 4 x + mx, qy = 4 y + my (quarter samples) for luma; buf_h264_cmc6 the same with eighth samples for chroma.
## Context block c: 0 plane address, 8 stride, 16 width, 24 height, 32 fraction, 40 w, 48 dst stride, 56 h, 64 chroma.
## Reference coordinates are clamped to the picture (8-228 / 8-229).
fn rtc_cl(v, hi) = if v < 0 then 0 else if v > hi then hi else v
fn rtc_asr(v, n) = if v >= 0 then bit_shr(v, n) else 0 - bit_shr(0 - v + bit_shl(1, n) - 1, n)
fn rtc_g(c, x, y) = load8(load64(c) + rtc_cl(y, load64(c + 24) - 1) * load64(c + 8) + rtc_cl(x, load64(c + 16) - 1))
fn rtc_tap(a, b, m, d, e, f) = a - 5 * b + 20 * m + 20 * d - 5 * e + f
fn rtc_b1(c, x, y) = rtc_tap(rtc_g(c, x - 2, y), rtc_g(c, x - 1, y), rtc_g(c, x, y), rtc_g(c, x + 1, y), rtc_g(c, x + 2, y), rtc_g(c, x + 3, y))
fn rtc_h1(c, x, y) = rtc_tap(rtc_g(c, x, y - 2), rtc_g(c, x, y - 1), rtc_g(c, x, y), rtc_g(c, x, y + 1), rtc_g(c, x, y + 2), rtc_g(c, x, y + 3))
fn rtc_j1(c, x, y) = rtc_tap(rtc_b1(c, x, y - 2), rtc_b1(c, x, y - 1), rtc_b1(c, x, y), rtc_b1(c, x, y + 1), rtc_b1(c, x, y + 2), rtc_b1(c, x, y + 3))
fn rtc_r5(v) = if v + 16 < 0 then 0 else rtc_clip(bit_shr(v + 16, 5))
fn rtc_r10(v) = if v + 512 < 0 then 0 else rtc_clip(bit_shr(v + 512, 10))
fn rtc_avg(a, b) = bit_shr(a + b + 1, 1)
## the sixteen luma positions (table 8-12): G d h n / a e i p / b f j q / c g k r
fn rtc_lpx(c, x, y, fr) =
    if fr == 0 then
        rtc_g(c, x, y)
    else if bit_and(fr, 3) == 0 then
        rtc_lpx0(c, x, y, bit_shr(fr, 2))
    else if bit_and(fr, 3) == 2 then
        rtc_lpx2(c, x, y, bit_shr(fr, 2))
    else
        rtc_lpx13(c, x, y, bit_and(fr, 3), bit_shr(fr, 2))
fn rtc_lpx0(c, x, y, yf) =
    let h = rtc_r5(rtc_h1(c, x, y)) in
    if yf == 1 then
        rtc_avg(rtc_g(c, x, y), h)
    else if yf == 2 then
        h
    else
        rtc_avg(rtc_g(c, x, y + 1), h)
fn rtc_lpx2(c, x, y, yf) =
    let b = rtc_r5(rtc_b1(c, x, y)) in
    if yf == 0 then
        b
    else if yf == 1 then
        rtc_avg(b, rtc_r10(rtc_j1(c, x, y)))
    else if yf == 2 then
        rtc_r10(rtc_j1(c, x, y))
    else
        rtc_avg(rtc_r10(rtc_j1(c, x, y)), rtc_r5(rtc_b1(c, x, y + 1)))
## xf 1 uses G / h of column x, xf 3 uses H / m of column x + 1
fn rtc_lpx13(c, x, y, xf, yf) =
    let hm = rtc_r5(rtc_h1(c, if xf == 1 then x else x + 1, y)) in
    if yf == 0 then
        rtc_avg(rtc_g(c, if xf == 1 then x else x + 1, y), rtc_r5(rtc_b1(c, x, y)))
    else if yf == 1 then
        rtc_avg(rtc_r5(rtc_b1(c, x, y)), hm)
    else if yf == 2 then
        rtc_avg(hm, rtc_r10(rtc_j1(c, x, y)))
    else
        rtc_avg(hm, rtc_r5(rtc_b1(c, x, y + 1)))
## chroma (8-266): ((8 - xf)(8 - yf) A + xf (8 - yf) B + (8 - xf) yf C + xf yf D + 32) >> 6
fn rtc_cpx(c, x, y, fr) =
    let xf = bit_and(fr, 7) in
    let yf = bit_shr(fr, 3) in
    bit_shr((8 - xf) * (8 - yf) * rtc_g(c, x, y) + xf * (8 - yf) * rtc_g(c, x + 1, y) + (8 - xf) * yf * rtc_g(c, x, y + 1) + xf * yf * rtc_g(c, x + 1, y + 1) + 32, 6)
fn rtc_mrow(c, d, x, y, n) =
    if n == 0 then
        0
    else
        let v = store8(d, if load64(c + 64) == 1 then rtc_cpx(c, x, y, load64(c + 32)) else rtc_lpx(c, x, y, load64(c + 32))) in
        rtc_mrow(c, d + 1, x + 1, y, n - 1)
fn rtc_mrows(c, d, x, y, r) =
    if r == 0 then
        0
    else
        let z = rtc_mrow(c, d, x, y, load64(c + 40)) in
        rtc_mrows(c, d + load64(c + 48), x, y + 1, r - 1)
fn rtc_mcsize(w, ch) = if w == 4 or w == 8 or w == 16 then 1 else if ch == 1 and w == 2 then 1 else 0
## sh = 2 luma (quarter samples), 3 chroma (eighth samples)
fn rtc_mc(ref, dst, a, b, g, q) =
    let sh = bit_and(q, 3) in
    let qq = bit_shr(q, 2) in
    let ri = bit_shr(a, 16) in
    let rs = bit_and(a, 65535) in
    let rw = bit_and(g, 65535) in
    let rh = bit_and(bit_shr(g, 16), 65535) in
    let w = bit_and(bit_shr(g, 32), 255) in
    let h = bit_and(bit_shr(g, 40), 255) in
    let di = bit_shr(b, 16) in
    let ds = bit_and(b, 65535) in
    if rw < 1 or rh < 1 or rs < rw or ds < w or rtc_mcsize(w, sh - 2) == 0 or rtc_mcsize(h, sh - 2) == 0 or rtc_fits(ref, ri, (rh - 1) * rs + rw) == 0 or rtc_fits(dst, di, (h - 1) * ds + w) == 0 then
        mkint(0 - 1)
    else
        rtc_mc2(ref + 8 + ri, dst + 8 + di, rs + ds * 65536, g, qq, sh)
## one allocation per call holds the context (128 bytes), the luma window (at most 22 x 22, 488 reserved) and the
## b1 table (at most 17 x 8 x 22 bytes): a second allocation could run the collector, which does not look inside this
## block, and free a window it only reaches through here (LumeDesk report: different blocks for the same call)
fn rtc_mc2(plane, d, sd, g, qq, sh) =
    let c = sym_addr("__rtc_scratch") in
    let qx = bit_and(qq, 1073741823) - 536870912 in
    let qy = bit_shr(qq, 30) - 536870912 in
    let m = bit_shl(1, sh) - 1 in
    let s0 = store64(c, plane) in
    let s1 = store64(c + 8, bit_and(sd, 65535)) in
    let s8 = store64(c + 48, bit_shr(sd, 16)) in
    let s2 = store64(c + 16, bit_and(g, 65535)) in
    let s3 = store64(c + 24, bit_and(bit_shr(g, 16), 65535)) in
    let s4 = store64(c + 32, bit_and(qx, m) + bit_and(qy, m) * (m + 1)) in
    let s5 = store64(c + 40, bit_and(bit_shr(g, 32), 255)) in
    let s6 = store64(c + 56, bit_and(bit_shr(g, 40), 255)) in
    let s7 = store64(c + 64, sh - 2) in
    rtc_mc3(c, d, qx, qy, sh)
fn rtc_mc3(c, d, qx, qy, sh) =
    let z = if sh == 2 then rtc_lmc(c, d, rtc_asr(qx, 2), rtc_asr(qy, 2)) else rtc_cmc(c, d, rtc_asr(qx, sh), rtc_asr(qy, sh)) in
    mkint(0)
## chroma whose window (w + 1 by h + 1 samples) lies inside the plane: the four weights once per block (context words
## 72..96), then each sample from four direct reads (8-266), no clamping; elsewhere the clamped path above
fn rtc_cmc(c, d, xi, yi) =
    if xi >= 0 and yi >= 0 and xi + load64(c + 40) + 1 <= load64(c + 16) and yi + load64(c + 56) + 1 <= load64(c + 24) then
        rtc_cfast(c, d, xi, yi)
    else
        rtc_mrows(c, d, xi, yi, load64(c + 56))
fn rtc_cfast(c, d, xi, yi) =
    let fr = load64(c + 32) in
    let xf = bit_and(fr, 7) in
    let yf = bit_shr(fr, 3) in
    let a = store64(c + 72, (8 - xf) * (8 - yf)) in
    let b = store64(c + 80, xf * (8 - yf)) in
    let e = store64(c + 88, (8 - xf) * yf) in
    let f = store64(c + 96, xf * yf) in
    rtc_cfrows(c, load64(c) + yi * load64(c + 8) + xi, d, load64(c + 56))
fn rtc_cfrows(c, p, d, r) =
    if r == 0 then
        0
    else
        let z = rtc_cfrow(c, p, d, load64(c + 40), load64(c + 8)) in
        rtc_cfrows(c, p + load64(c + 8), d + load64(c + 48), r - 1)
fn rtc_cfrow(c, p, d, n, rs) =
    if n == 0 then
        0
    else
        let v = store8(d, bit_shr(load64(c + 72) * load8(p) + load64(c + 80) * load8(p + 1) + load64(c + 88) * load8(p + rs) + load64(c + 96) * load8(p + rs + 1) + 32, 6)) in
        rtc_cfrow(c, p + 1, d + 1, n - 1, rs)
## luma fast path (SSE2): the (w + 6) x (h + 6) window around the block is copied once into scratch at 128 (clamping
## only there; rows 32 bytes apart), then the half-sample planes are computed 8 pixels at a time, all with rows 32
## bytes apart: b (horizontal, by window row) at 864 with its raw int16 sums at 2592, h (vertical) at 1568 and j
## (centre, from the raw sums) at 2080. Every quarter position of table 8-12 is then one plane or the rounded average
## of two (pavgb), so the last pass is the same loop for all sixteen. Window coordinates of block pixel (cx, cy) are
## (cx + 2, cy + 2); the vector routines read and write a little past a row, inside the 32-byte rows.
fn rtc_wcprow(c, wp, x, y, n) =
    if n == 0 then
        0
    else
        let v = store8(wp, rtc_g(c, x, y)) in
        rtc_wcprow(c, wp + 1, x + 1, y, n - 1)
fn rtc_wcp(c, wp, x, y, r) =
    if r == 0 then
        0
    else
        let z = rtc_wcprow(c, wp, x, y, load64(c + 40) + 6) in
        rtc_wcp(c, wp + 32, x, y + 1, r - 1)
## g groups of 8 pixels per row
fn rtc_vh(sp, bp, rp, g) = if g == 0 then 0 else let z = vec_hp6h(sp, bp, rp) in rtc_vh(sp + 8, bp + 8, rp + 16, g - 1)
fn rtc_vhr(sp, bp, rp, g, n) =
    if n == 0 then
        0
    else
        let z = rtc_vh(sp, bp, rp, g) in
        rtc_vhr(sp + 32, bp + 32, rp + 32, g, n - 1)
fn rtc_vv(sp, dp, g) = if g == 0 then 0 else let z = vec_hp6v(sp, 32, dp) in rtc_vv(sp + 8, dp + 8, g - 1)
fn rtc_vvr(sp, dp, g, n) = if n == 0 then 0 else let z = rtc_vv(sp, dp, g) in rtc_vvr(sp + 32, dp + 32, g, n - 1)
fn rtc_vc(sp, dp, g) = if g == 0 then 0 else let z = vec_hp6c(sp, 32, dp) in rtc_vc(sp + 16, dp + 8, g - 1)
fn rtc_vcr(sp, dp, g, n) = if n == 0 then 0 else let z = rtc_vc(sp, dp, g) in rtc_vcr(sp + 32, dp + 32, g, n - 1)
## the last pass: d = avg(p, q) row by row (p == q copies)
fn rtc_vfin(pp, qp, d, ds, w, n) =
    if n == 0 then
        0
    else
        let z = if w == 4 then vec_avg4(pp, qp, d) else if w == 8 then vec_avg8(pp, qp, d) else let z1 = vec_avg8(pp, qp, d) in vec_avg8(pp + 8, qp + 8, d + 8) in
        rtc_vfin(pp + 32, qp + 32, d + ds, ds, w, n - 1)
fn rtc_inside(c, xi, yi) =
    if xi - 2 >= 0 and yi - 2 >= 0 and xi + load64(c + 40) + 3 < load64(c + 16) and yi + load64(c + 56) + 3 < load64(c + 24) then
        1
    else
        0
## a block whose window lies inside the picture is copied row by row without clamping
fn rtc_cprow(d, sp, n) =
    if n >= 8 then
        let v = store64(d, load64(sp)) in
        rtc_cprow(d + 8, sp + 8, n - 8)
    else if n == 0 then
        0
    else
        let v = store8(d, load8(sp)) in
        rtc_cprow(d + 1, sp + 1, n - 1)
fn rtc_cprows(d, ds, sp, ss, n, r) =
    if r == 0 then
        0
    else
        let z = rtc_cprow(d, sp, n) in
        rtc_cprows(d + ds, ds, sp + ss, ss, n, r - 1)
fn rtc_lmc(c, d, xi, yi) =
    if load64(c + 32) == 0 and rtc_inside(c, xi, yi) == 1 then
        rtc_cprows(d, load64(c + 48), load64(c) + yi * load64(c + 8) + xi, load64(c + 8), load64(c + 40), load64(c + 56))
    else
        rtc_lmc1(c, d, xi, yi)
fn rtc_lmc1(c, d, xi, yi) =
    let w = load64(c + 40) in
    let h = load64(c + 56) in
    let z1 = if rtc_inside(c, xi, yi) == 1 then rtc_cprows(c + 128, 32, load64(c) + (yi - 2) * load64(c + 8) + xi - 2, load64(c + 8), w + 6, h + 6) else rtc_wcp(c, c + 128, xi - 2, yi - 2, h + 6) in
    rtc_lmc2(c, d, w, h, bit_and(load64(c + 32), 3), bit_shr(load64(c + 32), 2))
## the planes a position needs: b when xf != 0 (window rows 2 .. h + 2), h when yf != 0 and xf != 2 (one column more
## for xf 3), j when (xf 2 and yf != 0) or (xf odd and yf 2) (raw sums of window rows 0 .. h + 4)
fn rtc_lmc2(c, d, w, h, xf, yf) =
    let nj = if xf == 2 and yf != 0 or bit_and(xf, 1) == 1 and yf == 2 then 1 else 0 in
    let zb = if xf == 0 then 0 else if nj == 1 then rtc_vhr(c + 130, c + 864, c + 2592, bit_shr(w + 7, 3), h + 5) else rtc_vhr(c + 194, c + 928, c + 2656, bit_shr(w + 7, 3), h + 1) in
    let zh = if yf == 0 or xf == 2 then 0 else rtc_vvr(c + 194, c + 1568, bit_shr(w + (if xf == 3 then 8 else 7), 3), h) in
    let zj = if nj == 0 then 0 else rtc_vcr(c + 2656, c + 2080, bit_shr(w + 7, 3), h) in
    rtc_lmc3(c, d, w, h, xf, yf)
## (p, q) per position, with G at 194 (window 2, 2), b at 928 (window row 2), h at 1568, j at 2080; k = 1 for xf 3
fn rtc_lmc3(c, d, w, h, xf, yf) =
    let ds = load64(c + 48) in
    let k = if xf == 3 then 1 else 0 in
    if xf == 0 then
        (if yf == 0 then rtc_vfin(c + 194, c + 194, d, ds, w, h) else if yf == 1 then rtc_vfin(c + 194, c + 1568, d, ds, w, h) else if yf == 2 then rtc_vfin(c + 1568, c + 1568, d, ds, w, h) else rtc_vfin(c + 226, c + 1568, d, ds, w, h))
    else if xf == 2 then
        (if yf == 0 then rtc_vfin(c + 928, c + 928, d, ds, w, h) else if yf == 1 then rtc_vfin(c + 928, c + 2080, d, ds, w, h) else if yf == 2 then rtc_vfin(c + 2080, c + 2080, d, ds, w, h) else rtc_vfin(c + 2080, c + 960, d, ds, w, h))
    else if yf == 0 then
        rtc_vfin(c + 194 + k, c + 928, d, ds, w, h)
    else if yf == 1 then
        rtc_vfin(c + 928, c + 1568 + k, d, ds, w, h)
    else if yf == 2 then
        rtc_vfin(c + 1568 + k, c + 2080, d, ds, w, h)
    else
        rtc_vfin(c + 1568 + k, c + 960, d, ds, w, h)
fn buf_h264_lmc6(ref, dst, a, b, g, q) = rtc_mc(ref, dst, rt_int(a), rt_int(b), rt_int(g), rt_int(q) * 4 + 2)
fn buf_h264_cmc6(ref, dst, a, b, g, q) = rtc_mc(ref, dst, rt_int(a), rt_int(b), rt_int(g), rt_int(q) * 4 + 3)

## --- deblocking of one edge (8.7.2.3 bS < 4, 8.7.2.4 bS = 4) ----------------------------------------------------------
##   buf_h264_dbk5(buf, q0, across + 2^24 + (along + 2^24) 2^25, lines + chroma 2^8 + alpha 2^16 + beta 2^24,
##                 bS of segment k at bits 4k + tC0 of segment k at bits 16 + 8k)
## q0 is the byte offset of q0 on the first line; p_i = q0 - (i + 1) across, q_i = q0 + i across; line k starts k along
## further. A segment is 4 luma lines or 2 chroma lines (4:2:0). Each filter routine runs the lines of one segment
## from p up to (not including) e, al apart, as a loop (its self tail call is a jump: one frame per segment), with the
## arithmetic inline and no call; k = alpha + beta 2^8 + tC0 2^16. A segment of bS 0 is skipped whole. Negative values
## are shifted with a bias instead of a call: (v + 4) >> 3 arithmetic is ((v + 4 + 16384) >> 3) - 2048 for |v| < 16384.
## luma, bS < 4 (8.7.2.3)
fn rtc_dlw(p, e, s, al, k) =
    if p == e then
        0
    else
        let p0 = load8(p - s) in
        let q0 = load8(p) in
        let p1 = load8(p - s - s) in
        let q1 = load8(p + s) in
        let a = bit_and(k, 255) in
        let b = bit_and(bit_shr(k, 8), 255) in
        let d = q0 - p0 in
        let e1 = p1 - p0 in
        let f = q1 - q0 in
        if d >= a or 0 - d >= a or e1 >= b or 0 - e1 >= b or f >= b or 0 - f >= b then
            rtc_dlw(p + al, e, s, al, k)
        else
            let t = bit_shr(k, 16) in
            let p2 = load8(p - 3 * s) in
            let q2 = load8(p + s + s) in
            let g = p2 - p0 in
            let ap = if g < b and 0 - g < b then 1 else 0 in
            let h = q2 - q0 in
            let aq = if h < b and 0 - h < b then 1 else 0 in
            let tc = t + ap + aq in
            let v = bit_shr(d * 4 + p1 - q1 + 16388, 3) - 2048 in
            let dl = if v < 0 - tc then 0 - tc else if v > tc then tc else v in
            let np = p0 + dl in
            let nq = q0 - dl in
            let w1 = store8(p - s, if np < 0 then 0 else if np > 255 then 255 else np) in
            let w2 = store8(p, if nq < 0 then 0 else if nq > 255 then 255 else nq) in
            let m = bit_shr(p0 + q0 + 1, 1) in
            let up = bit_shr(p2 + m - p1 - p1 + 1024, 1) - 512 in
            let uq = bit_shr(q2 + m - q1 - q1 + 1024, 1) - 512 in
            let w3 = if ap == 1 then store8(p - s - s, p1 + (if up < 0 - t then 0 - t else if up > t then t else up)) else 0 in
            let w4 = if aq == 1 then store8(p + s, q1 + (if uq < 0 - t then 0 - t else if uq > t then t else uq)) else 0 in
            rtc_dlw(p + al, e, s, al, k)
## luma, bS = 4 (8.7.2.4)
fn rtc_dls(p, e, s, al, k) =
    if p == e then
        0
    else
        let p0 = load8(p - s) in
        let q0 = load8(p) in
        let p1 = load8(p - s - s) in
        let q1 = load8(p + s) in
        let a = bit_and(k, 255) in
        let b = bit_and(bit_shr(k, 8), 255) in
        let d = q0 - p0 in
        let e1 = p1 - p0 in
        let f = q1 - q0 in
        if d >= a or 0 - d >= a or e1 >= b or 0 - e1 >= b or f >= b or 0 - f >= b then
            rtc_dls(p + al, e, s, al, k)
        else
            let p2 = load8(p - 3 * s) in
            let q2 = load8(p + s + s) in
            let lim = bit_shr(a, 2) + 2 in
            let sm = if d < lim and 0 - d < lim then 1 else 0 in
            let g = p2 - p0 in
            let sp = if sm == 1 and g < b and 0 - g < b then 1 else 0 in
            let h = q2 - q0 in
            let sq = if sm == 1 and h < b and 0 - h < b then 1 else 0 in
            let wp = if sp == 1 then (let p3 = load8(p - 4 * s) in let w0 = store8(p - s, bit_shr(p2 + 2 * p1 + 2 * p0 + 2 * q0 + q1 + 4, 3)) in let w1 = store8(p - s - s, bit_shr(p2 + p1 + p0 + q0 + 2, 2)) in store8(p - 3 * s, bit_shr(2 * p3 + 3 * p2 + p1 + p0 + q0 + 4, 3))) else store8(p - s, bit_shr(2 * p1 + p0 + q1 + 2, 2)) in
            let wq = if sq == 1 then (let q3 = load8(p + 3 * s) in let v0 = store8(p, bit_shr(q2 + 2 * q1 + 2 * q0 + 2 * p0 + p1 + 4, 3)) in let v1 = store8(p + s, bit_shr(q2 + q1 + q0 + p0 + 2, 2)) in store8(p + s + s, bit_shr(2 * q3 + 3 * q2 + q1 + q0 + p0 + 4, 3))) else store8(p, bit_shr(2 * q1 + q0 + p1 + 2, 2)) in
            rtc_dls(p + al, e, s, al, k)
## chroma, bS < 4: only p0 and q0 change, tC = tC0 + 1
fn rtc_dcw(p, e, s, al, k) =
    if p == e then
        0
    else
        let p0 = load8(p - s) in
        let q0 = load8(p) in
        let p1 = load8(p - s - s) in
        let q1 = load8(p + s) in
        let a = bit_and(k, 255) in
        let b = bit_and(bit_shr(k, 8), 255) in
        let d = q0 - p0 in
        let e1 = p1 - p0 in
        let f = q1 - q0 in
        if d >= a or 0 - d >= a or e1 >= b or 0 - e1 >= b or f >= b or 0 - f >= b then
            rtc_dcw(p + al, e, s, al, k)
        else
            let tc = bit_shr(k, 16) + 1 in
            let v = bit_shr(d * 4 + p1 - q1 + 16388, 3) - 2048 in
            let dl = if v < 0 - tc then 0 - tc else if v > tc then tc else v in
            let np = p0 + dl in
            let nq = q0 - dl in
            let w1 = store8(p - s, if np < 0 then 0 else if np > 255 then 255 else np) in
            let w2 = store8(p, if nq < 0 then 0 else if nq > 255 then 255 else nq) in
            rtc_dcw(p + al, e, s, al, k)
## chroma, bS = 4
fn rtc_dcs(p, e, s, al, k) =
    if p == e then
        0
    else
        let p0 = load8(p - s) in
        let q0 = load8(p) in
        let p1 = load8(p - s - s) in
        let q1 = load8(p + s) in
        let a = bit_and(k, 255) in
        let b = bit_and(bit_shr(k, 8), 255) in
        let d = q0 - p0 in
        let e1 = p1 - p0 in
        let f = q1 - q0 in
        if d >= a or 0 - d >= a or e1 >= b or 0 - e1 >= b or f >= b or 0 - f >= b then
            rtc_dcs(p + al, e, s, al, k)
        else
            let w1 = store8(p - s, bit_shr(2 * p1 + p0 + q1 + 2, 2)) in
            let w2 = store8(p, bit_shr(2 * q1 + q0 + p1 + 2, 2)) in
            rtc_dcs(p + al, e, s, al, k)
## n lines from p segment by segment; abc = alpha + beta 2^8 + chroma 2^16; cp = the bS / tC0 word of the segment
## first in line (each step moves the next segment's bS to bits 0..3 and its tC0 to bits 16..23)
fn rtc_dsegs(p, s, al, n, abc, cp) =
    if n <= 0 then
        0
    else
        let ch = bit_shr(abc, 16) in
        let m0 = if ch == 1 then 2 else 4 in
        let m = if n < m0 then n else m0 in
        let e = p + m * al in
        let bs = bit_and(cp, 15) in
        let k = bit_and(abc, 65535) + bit_shl(bit_and(bit_shr(cp, 16), 255), 16) in
        let z = if bs == 0 then 0 else if ch == 1 then (if bs < 4 then rtc_dcw(p, e, s, al, k) else rtc_dcs(p, e, s, al, k)) else if bs < 4 then rtc_dlw(p, e, s, al, k) else rtc_dls(p, e, s, al, k) in
        rtc_dsegs(e, s, al, n - m, abc, bit_and(bit_shr(cp, 4), 4095) + bit_shl(bit_shr(cp, 24), 16))
## --- the SIMD path: the bS 1..3 segments of a whole edge (16 luma or 8 chroma lines) at once ---------------------------
## vec_dbk16 (a horizontal luma edge, in place), vec_dbkv (a vertical edge: two 8x8 transposes in, the filter, the four
## changed columns back) and vec_dbkh2 (a horizontal chroma edge: the rows of two 8-line planes side by side) work on
## 16 lanes with scratch 0 .. 511 as their block; tcw holds one tC0 byte per pair of lines (255: leave the pair
## alone). bS 4 segments stay with the scalar routines.
fn rtc_wk(cp, k) = let v = bit_and(bit_shr(cp, 4 * k), 15) in if v >= 1 and v <= 3 then 1 else 0
fn rtc_wkany(cp) = rtc_wk(cp, 0) + rtc_wk(cp, 1) + rtc_wk(cp, 2) + rtc_wk(cp, 3)
fn rtc_is4(cp, k) = if bit_and(bit_shr(cp, 4 * k), 15) == 4 then 1 else 0
fn rtc_only4(cp) = rtc_is4(cp, 0) * 4 + rtc_is4(cp, 1) * 64 + rtc_is4(cp, 2) * 1024 + rtc_is4(cp, 3) * 16384
## the tC0 byte of segment k for the vector filter (chroma: tC0 + 1), 255 when the segment is not bS 1..3
fn rtc_tb(cp, k, c1) = if rtc_wk(cp, k) == 0 then 255 else bit_and(bit_shr(cp, 16 + 8 * k), 255) + c1
## luma: segment k = lines 4k .. 4k + 3 = pairs 2k, 2k + 1; chroma: segment k = lines 2k, 2k + 1 = pair k, the same for
## lanes 8 .. 15 (the second plane, or the same lines again)
fn rtc_tcl(cp) = rtc_tb(cp, 0, 0) * 257 + bit_shl(rtc_tb(cp, 1, 0) * 257, 16) + bit_shl(rtc_tb(cp, 2, 0) * 257, 32) + bit_shl(rtc_tb(cp, 3, 0) * 257, 48)
fn rtc_tcc(cp) = let w = rtc_tb(cp, 0, 1) + bit_shl(rtc_tb(cp, 1, 1), 8) + bit_shl(rtc_tb(cp, 2, 1), 16) + bit_shl(rtc_tb(cp, 3, 1), 24) in w + bit_shl(w, 32)
## one edge: lc = lines + chroma 2^8 + (the 8 samples q0 - 4 .. q0 + 3 of each line lie in the buffer) 2^9; the SIMD
## path when a whole edge can run at once and its lines do not overlap: the bS 1..3 segments with the bS < 4 filter,
## then the bS 4 segments with the strong one (vec_dbk16s / vec_dbkvs / vec_dbkh2s); otherwise the scalar routines
fn rtc_dbk3(p, across, along, lc, ab, cp) =
    let lines = bit_and(lc, 255) in
    let ch = bit_and(bit_shr(lc, 8), 1) in
    let full = if ch == 0 then (if lines == 16 then 1 else 0) else if lines == 8 then 1 else 0 in
    let hz = if along == 1 and (across >= lines or across <= 0 - lines) then 1 else 0 in
    let vt = if across == 1 and (along >= 8 or along <= 0 - 8) and (ch == 0 or bit_shr(lc, 9) == 1) then 1 else 0 in
    if full == 0 or hz + vt == 0 then
        rtc_dsegs(p, across, along, lines, ab + ch * 65536, cp)
    else
        let x = sym_addr("__rtc_scratch") in
        let z = if rtc_wkany(cp) == 0 then 0 else if ch == 0 then (if hz == 1 then vec_dbk16(p, across, ab, rtc_tcl(cp), x) else vec_dbkv(p, p + 8 * along, along, ab, rtc_tcl(cp), x)) else if hz == 1 then vec_dbkh2(p, p, across, ab + 65536, rtc_tcc(cp), x) else vec_dbkv(p, p, along, ab + 65536, rtc_tcc(cp), x) in
        let c4 = rtc_only4(cp) in
        if c4 == 0 then 0 else rtc_dstr(p, across, along, ch * 2 + hz, ab + bit_shl(bit_shr(bit_and(ab, 255), 2) + 2, 24), c4)
## the bS 4 segments of c4 (k = chroma 2 + horizontal); ab carries (alpha >> 2) + 2 in bits 24..31; tcw 0 for the
## segments to filter, 255 for the others
fn rtc_dstr(p, across, along, k, ab, c4) =
    if k == 0 then
        vec_dbkvs(p, p + 8 * along, along, ab, rtc_t4l(c4), sym_addr("__rtc_scratch"))
    else if k == 1 then
        vec_dbk16s(p, across, ab, rtc_t4l(c4), sym_addr("__rtc_scratch"))
    else if k == 2 then
        vec_dbkvs(p, p, along, ab + 65536, rtc_t4c(c4), sym_addr("__rtc_scratch"))
    else
        vec_dbkh2s(p, p, across, ab + 65536, rtc_t4c(c4), sym_addr("__rtc_scratch"))
fn rtc_t4l(c4) = (1 - rtc_is4(c4, 0)) * 65535 + bit_shl((1 - rtc_is4(c4, 1)) * 65535, 16) + bit_shl((1 - rtc_is4(c4, 2)) * 65535, 32) + bit_shl((1 - rtc_is4(c4, 3)) * 65535, 48)
fn rtc_t4c(c4) = let t = (1 - rtc_is4(c4, 0)) * 255 + bit_shl((1 - rtc_is4(c4, 1)) * 255, 8) + bit_shl((1 - rtc_is4(c4, 2)) * 255, 16) + bit_shl((1 - rtc_is4(c4, 3)) * 255, 24) in t + bit_shl(t, 32)
## the samples a line touches lie between q0 - r across and q0 + (r - 1) across (r = 4 luma, 2 chroma)
fn rtc_dfits(buf, q0, across, along, lines, r) =
    let lo1 = if across > 0 then q0 - r * across else q0 + (r - 1) * across in
    let hi1 = if across > 0 then q0 + (r - 1) * across else q0 - r * across in
    let lo2 = lo1 + (lines - 1) * along in
    let hi2 = hi1 + (lines - 1) * along in
    if rtc_isbuf(buf) == 0 then
        0
    else if lo1 < 0 or lo2 < 0 or hi1 >= rtc_len(buf) or hi2 >= rtc_len(buf) then
        0
    else
        1
fn rtc_dbk(buf, q0, a, b, cp) =
    let across = bit_and(a, 33554431) - 16777216 in
    let along = bit_shr(a, 25) - 16777216 in
    let lines = bit_and(b, 255) in
    let ch = bit_and(bit_shr(b, 8), 1) in
    if across == 0 or lines < 1 or lines > (if ch == 1 then 8 else 16) or rtc_dfits(buf, q0, across, along, lines, if ch == 1 then 2 else 4) == 0 then
        mkint(0 - 1)
    else
        let z = if bit_and(bit_shr(b, 16), 255) == 0 or bit_and(cp, 65535) == 0 then 0 else rtc_dbk3(buf + 8 + q0, across, along, lines + ch * 256 + (if ch == 1 then rtc_dfits(buf, q0, across, along, lines, 4) * 512 else 0), bit_and(bit_shr(b, 16), 65535), cp) in
        mkint(0)
fn buf_h264_dbk5(buf, q0, a, b, cp) = rtc_dbk(buf, rt_int(q0), rt_int(a), rt_int(b), rt_int(cp))

## --- deblocking of a whole macroblock (8.7, 4:2:0, frame macroblocks) -----------------------------------------------
## buf_h264_deblock_mb(y, u, v, cfg): filters the macroblock (mbx, mby) of the reconstructed picture in place, as a
## decoder does once the macroblock and everything before it in raster order is reconstructed: the luma vertical edges
## left to right, then the horizontal edges top to bottom, then the same for Cb and Cr (8.7). bS per 4-sample segment
## (8.7.2.1): 4 on a macroblock edge with an intra macroblock on either side, 3 inside an intra macroblock, 2 when the
## 4x4 block of p0 or of q0 has coefficients, 1 when their reference pictures differ or a motion vector component
## differs by 4 quarter samples or more, else 0; the chroma edges 0 and 2 (of the 8x8 block, 4:2:0) use the bS of the
## luma edges 0 and 2 (8.7.2.1 for chroma). alpha / beta / tC0 come from tables 8-16 / 8-17 with indexA =
## Clip3(0, 51, qPav + FilterOffsetA), indexB = Clip3(0, 51, qPav + FilterOffsetB); qPav is the QPY of the macroblock
## inside it and (QPY(p) + QPY(q) + 1) >> 1 on its left / top edge, for chroma the same with each macroblock's QPc
## (table 8-15 of QPY + chroma_qp_index_offset). The edge at the picture border is never filtered; neither is a
## left / top edge with disable_deblocking_filter_idc 2 when that neighbour lies in another slice; idc 1 filters
## nothing. y, u, v: byte buffers holding the luma and the two chroma planes. cfg (at least 400 bytes, int32 little
## endian): luma offset of the picture's first sample (0), luma stride (4), Cb offset (8), Cr offset (12), chroma
## stride (16), mbx (20), mby (24), picture width (28) and height (32) in macroblocks, disable_deblocking_filter_idc
## (36), FilterOffsetA (40, signed: slice_alpha_c0_offset_div2 x 2), FilterOffsetB (44, signed), chroma_qp_index_offset
## (48, signed), flags (52: 1 the left macroblock is in another slice, 2 the top one), then the three macroblocks: this
## one at 64, the left one at 176, the top one at 288 (only those that exist are read), 112 bytes each: intra (int32
## at 0, nonzero = intra), QPY (int32 at 4), the 16 coefficient flags of the 4x4 luma blocks (bytes 8..23, nonzero =
## the block has coefficients), the reference picture of each block (bytes 24..39: any identity, e.g. ref_idx in a P
## slice), the motion vectors (int16 mvx, mvy at 40 + 4 b, quarter samples), all per block in luma4x4BlkIdx order (the
## order buf_h264_mb_p and buf_h264_mb_i4 answer their block counts in). Answers 0, or -1 on a wrong argument.
## context x (scratch 512): 0 luma macroblock address, 8 ys, 16 Cb macroblock, 24 Cr macroblock, 32 cs, 40 cfg data,
## 48 filter the left edge, 56 the top edge, 64 FilterOffsetA, 72 FilterOffsetB, 80 chroma offset, 96 + 8 (4 dir + e)
## the bS word of luma edge e (dir 0 vertical, 1 horizontal), 192 .. 239 the coefficient masks and partition flags
fn buf_h264_deblock_mb(y, u, v, cfg) = rtc_dmb(y, u, v, cfg)
fn rtc_cl51(v) = if v < 0 then 0 else if v > 51 then 51 else v
## 7 bytes per word: entry j of a table split over w0 .. w4
fn rtc_pick7(j, w0, w1, w2, w3, w4) =
    let w = if j < 7 then w0 else if j < 14 then w1 else if j < 21 then w2 else if j < 28 then w3 else w4 in
    let r = if j < 7 then j else if j < 14 then j - 7 else if j < 21 then j - 14 else if j < 28 then j - 21 else j - 28 in
    bit_and(bit_shr(w, 8 * r), 255)
## table 8-16 (alpha, beta: 0 below indexA / indexB 16) and 8-17 (tC0 for bS 1..3, 0 below indexA 17)
fn rtc_alpha(i) = if i < 16 then 0 else if i >= 51 then 255 else rtc_pick7(i - 16, 2542101049181188, 6214512987147274, 14123399263558681, 31918110936612664, 72025483631562879)
fn rtc_beta(i) = if i < 16 then 0 else if i >= 51 then 18 else rtc_pick7(i - 16, 847736400380418, 1978047289099268, 3107262961354760, 3956098890206219, 5085314562395919)
fn rtc_tc0(i, bs) = if i < 17 or bs < 1 or bs > 3 then 0 else if bs == 1 then rtc_pick7(i - 17, 281474976710656, 282578800148737, 846632577007873, 1694364665643779, 3671312426338054) else if bs == 2 then rtc_pick7(i - 17, 282578783305728, 282578800148737, 847736383603202, 2259522249098244, 4801623315122696) else rtc_pick7(i - 17, 282578800148737, 565157600231681, 1411790177239811, 3107258649478662, 7062249387593229)
## luma4x4BlkIdx of the 4x4 block (bx, by)
fn rtc_b4i(bx, by) = bit_shr(by, 1) * 8 + bit_shr(bx, 1) * 4 + bit_and(by, 1) * 2 + bit_and(bx, 1)
fn rtc_qpok(m) = if load32(m + 4) > 51 then 0 else 1
fn rtc_dmb(y, u, v, cfg) =
    if rtc_fits(cfg, 0, 400) == 0 or rtc_isbuf(y) == 0 or rtc_isbuf(u) == 0 or rtc_isbuf(v) == 0 then
        mkint(0 - 1)
    else
        let c = cfg + 8 in
        let ys = load32(c + 4) in
        let cs = load32(c + 16) in
        let wm = load32(c + 28) in
        let hm = load32(c + 32) in
        if wm < 1 or hm < 1 or wm > 4096 or hm > 4096 or load32(c + 20) >= wm or load32(c + 24) >= hm or ys < 16 * wm or cs < 8 * wm or ys > 1048576 or cs > 1048576 then
            mkint(0 - 1)
        else if load32(c) + (16 * hm - 1) * ys + 16 * wm > rtc_len(y) or load32(c + 8) + (8 * hm - 1) * cs + 8 * wm > rtc_len(u) or load32(c + 12) + (8 * hm - 1) * cs + 8 * wm > rtc_len(v) then
            mkint(0 - 1)
        else
            rtc_dmb2(y, u, v, c)
fn rtc_dmb2(y, u, v, c) =
    let idc = load32(c + 36) in
    let oa = rtc_s32(load32(c + 40)) in
    let ob = rtc_s32(load32(c + 44)) in
    let co = rtc_s32(load32(c + 48)) in
    let mx = load32(c + 20) in
    let my = load32(c + 24) in
    if idc > 2 or oa < 0 - 12 or oa > 12 or ob < 0 - 12 or ob > 12 or co < 0 - 12 or co > 12 or rtc_qpok(c + 64) == 0 or (mx > 0 and rtc_qpok(c + 176) == 0) or (my > 0 and rtc_qpok(c + 288) == 0) then
        mkint(0 - 1)
    else if idc == 1 then
        mkint(0)
    else
        let x = sym_addr("__rtc_scratch") + 512 in
        let ys = load32(c + 4) in
        let cs = load32(c + 16) in
        let fl = load32(c + 52) in
        let a0 = store64(x, y + 8 + load32(c) + my * 16 * ys + mx * 16) in
        let a1 = store64(x + 8, ys) in
        let a2 = store64(x + 16, u + 8 + load32(c + 8) + my * 8 * cs + mx * 8) in
        let a3 = store64(x + 24, v + 8 + load32(c + 12) + my * 8 * cs + mx * 8) in
        let a4 = store64(x + 32, cs) in
        let a5 = store64(x + 40, c) in
        let a6 = store64(x + 48, if mx == 0 or (idc == 2 and bit_and(fl, 1) != 0) then 0 else 1) in
        let a7 = store64(x + 56, if my == 0 or (idc == 2 and bit_and(fl, 2) != 0) then 0 else 1) in
        let a8 = store64(x + 64, oa) in
        let a9 = store64(x + 72, ob) in
        let b0 = store64(x + 80, co) in
        let b1 = rtc_dmbpre(x, c, load64(x + 48), load64(x + 56)) in
        let z0 = rtc_bsall(x, c) in
        let z = rtc_dmbl(x, c) in
        let w = rtc_dmbc(x, c) in
        mkint(0)
## per macroblock, once: the coefficient flags as raster bit masks (bit 4 by + bx) and whether all 16 blocks share one
## vector and reference (the macroblock was predicted as one 16x16 partition): this one at x + 192 / 216, the left at
## 200 / 224, the top at 208 / 232 (read only when that edge is filtered)
fn rtc_dmbpre(x, c, fl, ft) =
    let a = store64(x + 192, rtc_nzm(c + 64)) in
    let b = store64(x + 216, rtc_uni(c + 64)) in
    let d = if fl == 0 then 0 else (let d1 = store64(x + 200, rtc_nzm(c + 176)) in store64(x + 224, rtc_uni(c + 176))) in
    if ft == 0 then 0 else (let e1 = store64(x + 208, rtc_nzm(c + 288)) in store64(x + 232, rtc_uni(c + 288)))
## bit i set when byte i of the word is nonzero: the high bit of each byte from ((v & 7F..) + 7F..) | v, gathered into
## the top byte by one multiplication (0x0102040810204080)
fn rtc_nz8(v) = let t = bit_and(bit_shr(bit_or(bit_and(v, 9187201950435737471) + 9187201950435737471, v), 7), 72340172838076673) in bit_and(bit_shr(t * 72624976668147840, 56), 255)
## the 16 coefficient flags (luma4x4BlkIdx order) as a raster mask: blkIdx bits (by1 bx1 by0 bx0) become (by1 by0 bx1
## bx0), a swap of index bits 1 and 2 (bits 2, 3, 10, 11 trade places with 4, 5, 12, 13)
fn rtc_nzm(m) = let k = rtc_nz8(load64(m + 8)) + bit_shl(rtc_nz8(load64(m + 16)), 8) in let t = bit_and(bit_xor(k, bit_shr(k, 2)), 3084) in bit_xor(k, bit_or(t, bit_shl(t, 2)))
fn rtc_uni(m) =
    let w = load32(m + 40) in
    let r = w + bit_shl(w, 32) in
    let rr = load8(m + 24) * 72340172838076673 in
    if load64(m + 40) != r or load64(m + 48) != r or load64(m + 56) != r or load64(m + 64) != r or load64(m + 72) != r or load64(m + 80) != r or load64(m + 88) != r or load64(m + 96) != r then
        0
    else if load64(m + 24) != rr or load64(m + 32) != rr then
        0
    else
        1
## bS 1 between block pb of pm and qb of qm when neither is intra and neither has coefficients
fn rtc_mvd(pm, pb, qm, qb) =
    if load8(pm + 24 + pb) != load8(qm + 24 + qb) then
        1
    else
        let dx = rtc_r16(pm + 40 + 4 * pb) - rtc_r16(qm + 40 + 4 * qb) in
        let dy = rtc_r16(pm + 42 + 4 * pb) - rtc_r16(qm + 42 + 4 * qb) in
        if dx >= 4 or dx <= 0 - 4 or dy >= 4 or dy <= 0 - 4 then 1 else 0
## the 4 bits of m to bits 0, 4, 8, 12
fn rtc_sp4(m) = bit_and(m, 1) + bit_shl(bit_and(m, 2), 3) + bit_shl(bit_and(m, 4), 6) + bit_shl(bit_and(m, 8), 9)
## the bS word of luma edge e: intra macroblocks at once, then the coefficient part from the bit masks (2 where either
## block has coefficients); when both macroblocks are single 16x16 partitions the motion part is one comparison
## (none inside a macroblock), otherwise segment by segment
fn rtc_bswf(x, c, dir, e) =
    let qi = c + 64 in
    let pi = if e == 0 then c + (if dir == 0 then 176 else 288) else qi in
    if load32(qi) != 0 or load32(pi) != 0 then
        (if e == 0 then 17476 else 13107)
    else
        let nzc = load64(x + 192) in
        let m = if dir == 0 then bit_and(bit_or(if e == 0 then bit_shr(load64(x + 200), 3) else bit_shr(nzc, e - 1), bit_shr(nzc, e)), 4369) else rtc_sp4(bit_and(bit_or(if e == 0 then bit_shr(load64(x + 208), 12) else bit_shr(nzc, 4 * e - 4), bit_shr(nzc, 4 * e)), 15)) in
        if load64(x + 216) == 1 and (e != 0 or load64(x + 224 + 8 * dir) == 1) then
            (if e != 0 or m == 4369 or rtc_mvd(pi, 0, qi, 0) == 0 then m * 2 else m * 2 + 4369 - m)
        else
            m * 2 + rtc_bsm(pi, qi, dir, e, m, 0) + rtc_bsm(pi, qi, dir, e, m, 1) * 16 + rtc_bsm(pi, qi, dir, e, m, 2) * 256 + rtc_bsm(pi, qi, dir, e, m, 3) * 4096
## the motion part (0 or 1) of segment k when its coefficient part is 0
fn rtc_bsm(pi, qi, dir, e, m, k) =
    if bit_and(bit_shr(m, 4 * k), 1) == 1 then
        0
    else if dir == 0 then
        rtc_mvd(pi, rtc_b4i(bit_and(e + 3, 3), k), qi, rtc_b4i(e, k))
    else
        rtc_mvd(pi, rtc_b4i(k, bit_and(e + 3, 3)), qi, rtc_b4i(k, e))
## alpha, beta and the tC0 row of an edge, kept per role (0..2 luma inside / left / top, 3..5 chroma) in scratch 3648
## (48 bytes, one word each: key qP + (oa + 16) 2^6 + (ob + 16) 2^11 + 2^16 in bits 0..16, alpha 17.., beta 25..,
## tC0 for bS 1, 2, 3 at 33, 41, 49): qP rarely changes, so the tables are read once per change
fn rtc_abt(role, qp, oa, ob) =
    let s = sym_addr("__rtc_scratch") + 3648 + 8 * role in
    let k = qp + (oa + 16) * 64 + (ob + 16) * 2048 + 65536 in
    let w = load64(s) in
    if bit_and(w, 131071) == k then w else rtc_abt2(s, k, rtc_cl51(qp + oa), rtc_cl51(qp + ob))
fn rtc_abt2(s, k, ia, ib) =
    let w = k + bit_shl(rtc_alpha(ia), 17) + bit_shl(rtc_beta(ib), 25) + bit_shl(rtc_tc0(ia, 1), 33) + bit_shl(rtc_tc0(ia, 2), 41) + bit_shl(rtc_tc0(ia, 3), 49) in
    let z = store64(s, w) in
    w
## alpha + beta 2^8 + ((alpha >> 2) + 2) 2^24 of a cached word, for the strong filter
fn rtc_ab4(w) = bit_and(bit_shr(w, 17), 65535) + bit_shl(bit_shr(bit_and(bit_shr(w, 17), 255), 2) + 2, 24)
## the vector filter's byte for each bS (byte b of tv: 255 for bS 0 and 4, tC0 (+ c1) for 1..3), made once per role
fn rtc_tvw(w, c1) = 1095216660735 + bit_shl(bit_and(bit_shr(w, 33), 255) + c1, 8) + bit_shl(bit_and(bit_shr(w, 41), 255) + c1, 16) + bit_shl(bit_and(bit_shr(w, 49), 255) + c1, 24)
## tcw of a luma edge (one byte per pair of lines, a segment = 2 pairs) and of a chroma edge (a segment = 1 pair, the
## same for lanes 8..15)
fn rtc_tclv(bsw, tv) = bit_and(bit_shr(tv, 8 * bit_and(bsw, 15)), 255) * 257 + bit_shl(bit_and(bit_shr(tv, 8 * bit_and(bit_shr(bsw, 4), 15)), 255) * 257, 16) + bit_shl(bit_and(bit_shr(tv, 8 * bit_and(bit_shr(bsw, 8), 15)), 255) * 257, 32) + bit_shl(bit_and(bit_shr(tv, 8 * bit_shr(bsw, 12)), 255) * 257, 48)
fn rtc_tccv(bsw, tv) = let t = bit_and(bit_shr(tv, 8 * bit_and(bsw, 15)), 255) + bit_shl(bit_and(bit_shr(tv, 8 * bit_and(bit_shr(bsw, 4), 15)), 255), 8) + bit_shl(bit_and(bit_shr(tv, 8 * bit_and(bit_shr(bsw, 8), 15)), 255), 16) + bit_shl(bit_and(bit_shr(tv, 8 * bit_shr(bsw, 12)), 255), 24) in t + bit_shl(t, 32)
## the bS words of the 8 luma edges at x + 96 + 8 (4 dir + e): the macroblock edges through rtc_bswf, the inner ones of
## an intra macroblock 3, of a single-partition inter macroblock from the coefficient mask alone (n | n >> 1 joins the
## blocks on both sides of each vertical edge, n | n >> 4 of each horizontal one), otherwise rtc_bswf per edge
fn rtc_bsall(x, c) =
    let a = store64(x + 96, if load64(x + 48) == 0 then 0 else rtc_bswf(x, c, 0, 0)) in
    let b = store64(x + 128, if load64(x + 56) == 0 then 0 else rtc_bswf(x, c, 1, 0)) in
    if load32(c + 64) != 0 then
        (let d = rtc_bs3(x, 104, 13107, 13107, 13107) in rtc_bs3(x, 136, 13107, 13107, 13107))
    else if load64(x + 216) == 1 then
        (let n = load64(x + 192) in let d = rtc_bs3(x, 104, bit_and(bit_or(n, bit_shr(n, 1)), 4369) * 2, bit_and(bit_shr(bit_or(n, bit_shr(n, 1)), 1), 4369) * 2, bit_and(bit_shr(bit_or(n, bit_shr(n, 1)), 2), 4369) * 2) in rtc_bs3(x, 136, rtc_sp4(bit_and(bit_or(n, bit_shr(n, 4)), 15)) * 2, rtc_sp4(bit_and(bit_shr(bit_or(n, bit_shr(n, 4)), 4), 15)) * 2, rtc_sp4(bit_and(bit_shr(bit_or(n, bit_shr(n, 4)), 8), 15)) * 2))
    else
        (let d = rtc_bs3(x, 104, rtc_bswf(x, c, 0, 1), rtc_bswf(x, c, 0, 2), rtc_bswf(x, c, 0, 3)) in rtc_bs3(x, 136, rtc_bswf(x, c, 1, 1), rtc_bswf(x, c, 1, 2), rtc_bswf(x, c, 1, 3)))
fn rtc_bs3(x, o, a, b, d) = let s1 = store64(x + o, a) in let s2 = store64(x + o + 8, b) in store64(x + o + 16, d)
## the luma edges in the order of 8.7 with alpha / beta / tC0 read once per role (inside, left, top): bS 4 only comes
## from an intra macroblock edge, where all four segments are 4 (17476): those take the strong vector filter
## (vec_dbkvs / vec_dbk16s), the rest the bS < 4 one
fn rtc_dmbl(x, c) =
    let oa = load64(x + 64) in
    let ob = load64(x + 72) in
    let qq = load32(c + 68) in
    let wi = rtc_abt(0, qq, oa, ob) in
    let wl = if load64(x + 96) == 0 then 0 else rtc_abt(1, bit_shr(load32(c + 180) + qq + 1, 1), oa, ob) in
    let wt = if load64(x + 128) == 0 then 0 else rtc_abt(2, bit_shr(load32(c + 292) + qq + 1, 1), oa, ob) in
    let ti = rtc_tvw(wi, 0) in
    let v0 = rtc_dmbe(x, 0, 0, wl, rtc_tvw(wl, 0)) in
    let v1 = rtc_dmbe(x, 0, 1, wi, ti) in
    let v2 = rtc_dmbe(x, 0, 2, wi, ti) in
    let v3 = rtc_dmbe(x, 0, 3, wi, ti) in
    let h0 = rtc_dmbe(x, 1, 0, wt, rtc_tvw(wt, 0)) in
    let h1 = rtc_dmbe(x, 1, 1, wi, ti) in
    let h2 = rtc_dmbe(x, 1, 2, wi, ti) in
    rtc_dmbe(x, 1, 3, wi, ti)
fn rtc_dmbe(x, dir, e, w, tv) =
    let bsw = load64(x + 96 + 8 * (dir * 4 + e)) in
    if bsw == 0 or bit_and(bit_shr(w, 17), 255) == 0 or bit_and(bit_shr(w, 25), 255) == 0 then
        0
    else
        let ys = load64(x + 8) in
        let p = load64(x) + (if dir == 0 then 4 * e else 4 * e * ys) in
        if bsw == 17476 then
            (if dir == 0 then vec_dbkvs(p, p + 8 * ys, ys, rtc_ab4(w), 0, sym_addr("__rtc_scratch")) else vec_dbk16s(p, ys, rtc_ab4(w), 0, sym_addr("__rtc_scratch")))
        else if dir == 0 then
            vec_dbkv(p, p + 8 * ys, ys, bit_and(bit_shr(w, 17), 65535), rtc_tclv(bsw, tv), sym_addr("__rtc_scratch"))
        else
            vec_dbk16(p, ys, bit_and(bit_shr(w, 17), 65535), rtc_tclv(bsw, tv), sym_addr("__rtc_scratch"))
## chroma edges (ce 0, 1 at chroma samples 0, 4: the bS of luma edges 0, 2), Cb and Cr together, QPc per macroblock
fn rtc_qpcl(q, co) = rtc_qpc(rtc_cl51(q + co))
fn rtc_dmbc(x, c) =
    let oa = load64(x + 64) in
    let ob = load64(x + 72) in
    let co = load64(x + 80) in
    let qc = rtc_qpcl(load32(c + 68), co) in
    let wi = if load64(x + 112) == 0 and load64(x + 144) == 0 then 0 else rtc_abt(3, qc, oa, ob) in
    let wl = if load64(x + 96) == 0 then 0 else rtc_abt(4, bit_shr(rtc_qpcl(load32(c + 180), co) + qc + 1, 1), oa, ob) in
    let wt = if load64(x + 128) == 0 then 0 else rtc_abt(5, bit_shr(rtc_qpcl(load32(c + 292), co) + qc + 1, 1), oa, ob) in
    let ti = rtc_tvw(wi, 1) in
    let v0 = rtc_dmbce(x, 0, 0, wl, rtc_tvw(wl, 1)) in
    let v1 = rtc_dmbce(x, 0, 1, wi, ti) in
    let h0 = rtc_dmbce(x, 1, 0, wt, rtc_tvw(wt, 1)) in
    rtc_dmbce(x, 1, 1, wi, ti)
fn rtc_dmbce(x, dir, ce, w, tv) =
    let bsw = load64(x + 96 + 8 * (dir * 4 + 2 * ce)) in
    if bsw == 0 or bit_and(bit_shr(w, 17), 255) == 0 or bit_and(bit_shr(w, 25), 255) == 0 then
        0
    else
        let cs = load64(x + 32) in
        let o = if dir == 0 then 4 * ce else 4 * ce * cs in
        let pu = load64(x + 16) + o in
        let pv = load64(x + 24) + o in
        if bsw == 17476 then
            (if dir == 0 then vec_dbkvs(pu, pv, cs, rtc_ab4(w) + 65536, 0, sym_addr("__rtc_scratch")) else vec_dbkh2s(pu, pv, cs, rtc_ab4(w) + 65536, 0, sym_addr("__rtc_scratch")))
        else if dir == 0 then
            vec_dbkv(pu, pv, cs, bit_and(bit_shr(w, 17), 65535) + 65536, rtc_tccv(bsw, tv), sym_addr("__rtc_scratch"))
        else
            vec_dbkh2(pu, pv, cs, bit_and(bit_shr(w, 17), 65535) + 65536, rtc_tccv(bsw, tv), sym_addr("__rtc_scratch"))

## --- bit writing for entropy coders (CAVLC, Exp-Golomb headers): bits go most significant first, bit 0 of the
## stream is the top bit of byte 0 -----------------------------------------------------------------------------------
##   buf_bits_write(b, pos, v, n)  the low n bits of v (1 <= n <= 32) at bit pos; answers pos + n (-1 when wrong)
##   buf_bits_read(b, pos, n)      the n bits at pos as an unsigned int (-1 when wrong)
##   buf_bits_ue(b, pos, v)        Exp-Golomb ue(v) (v >= 0), answers the new pos;  buf_bits_se(b, pos, v) se(v)
fn rtc_bw1(p, pos, v, n) =
    if n == 0 then
        pos
    else
        let o = bit_and(pos, 7) in
        let k = if 8 - o < n then 8 - o else n in
        let bits = bit_and(bit_shr(v, n - k), bit_shl(1, k) - 1) in
        let sh = 8 - o - k in
        let a = p + bit_shr(pos, 3) in
        let mask = bit_shl(bit_shl(1, k) - 1, sh) in
        let w = store8(a, bit_or(bit_and(load8(a), 255 - mask), bit_shl(bits, sh))) in
        rtc_bw1(p, pos + k, v, n - k)
fn rtc_bfits(b, pos, n) =
    if pos < 0 or n < 1 or n > 32 then
        0
    else
        rtc_fits(b, bit_shr(pos, 3), bit_shr(bit_and(pos, 7) + n + 7, 3))
fn rtc_bw(b, pos, v, n) = if rtc_bfits(b, pos, n) == 0 then mkint(0 - 1) else mkint(rtc_bw1(b + 8, pos, v, n))
fn buf_bits_write(b, pos, v, n) = rtc_bw(b, rt_int(pos), rt_int(v), rt_int(n))
fn rtc_br1(p, pos, n, acc) =
    if n == 0 then
        acc
    else
        let o = bit_and(pos, 7) in
        let k = if 8 - o < n then 8 - o else n in
        let bits = bit_and(bit_shr(load8(p + bit_shr(pos, 3)), 8 - o - k), bit_shl(1, k) - 1) in
        rtc_br1(p, pos + k, n - k, bit_or(bit_shl(acc, k), bits))
fn rtc_br(b, pos, n) = if rtc_bfits(b, pos, n) == 0 then mkint(0 - 1) else mkint(rtc_br1(b + 8, pos, n, 0))
fn buf_bits_read(b, pos, n) = rtc_br(b, rt_int(pos), rt_int(n))
fn rtc_blen(x, k) = if bit_shr(x, k) == 0 then k else rtc_blen(x, k + 1)
## ue(v): x = v + 1 of len bits -> (len - 1) zeros, then x in len bits
fn rtc_ue(b, pos, v) =
    let x = v + 1 in
    let len = rtc_blen(x, 1) in
    if v < 0 or len > 32 or rtc_bfits(b, pos, 1) == 0 or rtc_fits(b, bit_shr(pos, 3), bit_shr(bit_and(pos, 7) + 2 * len - 1 + 7, 3)) == 0 then
        0 - 1
    else
        rtc_bw1(b + 8, rtc_bw1(b + 8, pos, 0, len - 1), x, len)
fn buf_bits_ue(b, pos, v) = mkint(rtc_ue(b, rt_int(pos), rt_int(v)))
fn buf_bits_se(b, pos, v) = let k = rt_int(v) in mkint(rtc_ue(b, rt_int(pos), if k > 0 then 2 * k - 1 else 0 - 2 * k))

## --- CAVLC residual block (7.3.5.3.2 / 9.2) ---------------------------------------------------------------------------
##   buf_h264_cavlc6(coef, ci, nc, maxc, out, pos)  the maxc (16, 15 or 4) int16 coefficients at coef + ci (zigzag
##       order) coded with the coeff_token table nC selects (-1 chroma DC), written into out from bit pos; answers
##       newpos * 32 + TotalCoeff, or -1 (wrong argument, full buffer). `use h264` wraps it as buf_h264_cavlc4x4.
## Tables (__rtc_cavlc in the runtime's rodata, one byte each): coeff_token lengths at 0 (3 x 68, index
## TotalCoeff * 4 + TrailingOnes, columns 0..1, 2..3, 4..7) and codes at 204; chroma DC lengths at 408, codes at 428;
## total_zeros 9-7/9-8 lengths at 448 and codes at 688 (row TotalCoeff - 1, 16 wide); chroma DC total_zeros 9-9
## lengths at 928, codes at 940 (4 wide); run_before lengths at 952, codes at 1064 (row min(zerosLeft, 7) - 1).
fn rtc_cvt(o) = load8(sym_addr("__rtc_cavlc") + o)
## the bit writer: the stream's length in bits sits in scratch at 3960 (set once per block), so a write checks one sum
fn rtc_cvput(op, pos, v, n) =
    if pos < 0 then
        0 - 1
    else if n == 0 then
        pos
    else if pos + n > load32(sym_addr("__rtc_scratch") + 3960) then
        0 - 1
    else
        rtc_bw1(op, pos, v, n)
fn rtc_cvc(p, i) = rtc_r16(p + 2 * i)
## the nonzero mask (bit i: coefficient i is not 0), four coefficients per 64-bit word
fn rtc_nz4(w) = (if bit_and(w, 65535) != 0 then 1 else 0) + (if bit_and(bit_shr(w, 16), 65535) != 0 then 2 else 0) + (if bit_and(bit_shr(w, 32), 65535) != 0 then 4 else 0) + (if bit_shr(w, 48) != 0 then 8 else 0)
fn rtc_cvmask(p, maxc) =
    if maxc == 4 then
        rtc_nz4(load64(p))
    else
        let a = rtc_nz4(load64(p)) in
        let b = rtc_nz4(load64(p + 8)) in
        let c = rtc_nz4(load64(p + 16)) in
        let w3 = if maxc == 16 then load64(p + 24) else bit_or(bit_and(load32(p + 24), 4294967295), bit_shl(load8(p + 28) + load8(p + 29) * 256, 32)) in
        a + bit_shl(b, 4) + bit_shl(c, 8) + bit_shl(rtc_nz4(w3), 12)
fn rtc_pop16(x) =
    let a = x - bit_and(bit_shr(x, 1), 21845) in
    let b = bit_and(a, 13107) + bit_and(bit_shr(a, 2), 13107) in
    let c = bit_and(b + bit_shr(b, 4), 3855) in
    bit_and(c + bit_shr(c, 8), 31)
## the highest set bit of a nonzero 16-bit x
fn rtc_hib(x) =
    let a = if bit_shr(x, 8) != 0 then 8 else 0 in
    let x1 = bit_shr(x, a) in
    let b = if bit_shr(x1, 4) != 0 then 4 else 0 in
    let x2 = bit_shr(x1, b) in
    let c = if bit_shr(x2, 2) != 0 then 2 else 0 in
    let x3 = bit_shr(x2, c) in
    a + b + c + (if bit_shr(x3, 1) != 0 then 1 else 0)
## TrailingOnes: the first (at most three) nonzero coefficients from the top that are +-1
fn rtc_cvones(p, m, k) =
    if m == 0 or k >= 3 then
        k
    else
        let i = rtc_hib(m) in
        let v = rtc_cvc(p, i) in
        if v == 1 or v == 0 - 1 then
            rtc_cvones(p, m - bit_shl(1, i), k + 1)
        else
            k
## level_prefix: p zeros then a one (p + 1 <= 32 for 16-bit levels; longer prefixes write their zeros first)
fn rtc_cvpre(op, pos, p) =
    if p >= 32 then
        rtc_cvput(op, rtc_cvput(op, pos, 0, p - 31), 1, 32)
    else
        rtc_cvput(op, pos, 1, p + 1)
## escape: the shortest prefix p >= 15 whose suffix of p - 3 bits holds levelCode - base
fn rtc_cvbase(sl, p) = bit_shl(15, sl) + (if sl == 0 then 15 else 0) + (if p >= 16 then bit_shl(1, p - 3) - 4096 else 0)
fn rtc_cvesc(op, pos, lc, sl, p) =
    let base = rtc_cvbase(sl, p) in
    if p >= 16 and load32(sym_addr("__rtc_scratch") + 3964) == 0 then
        0 - 1
    else if lc - base < bit_shl(1, p - 3) then
        rtc_cvput(op, rtc_cvpre(op, pos, p), lc - base, p - 3)
    else
        rtc_cvesc(op, pos, lc, sl, p + 1)
fn rtc_cvlev(op, pos, lc, sl) =
    if sl == 0 then
        (if lc < 14 then rtc_cvpre(op, pos, lc) else if lc < 30 then rtc_cvput(op, rtc_cvpre(op, pos, 14), lc - 14, 4) else rtc_cvesc(op, pos, lc, 0, 15))
    else if lc < bit_shl(15, sl) then
        rtc_cvput(op, rtc_cvpre(op, pos, bit_shr(lc, sl)), bit_and(lc, bit_shl(1, sl) - 1), sl)
    else
        rtc_cvesc(op, pos, lc, sl, 15)
fn rtc_cvnsl(sl, v) =
    let s1 = if sl == 0 then 1 else sl in
    if rtc_abs(v) > bit_shl(3, s1 - 1) and s1 < 6 then
        s1 + 1
    else
        s1
## the trailing-one signs and the levels, highest frequency first, over the set bits of m; st packs suffixLength
## (bits 0-2), "first level after the trailing ones" (bit 3), TrailingOnes (bits 4-5) and the signs still to write
## (bits 6-7)
fn rtc_cvlc(v, st) =
    let lc = if v > 0 then 2 * v - 2 else 0 - 2 * v - 1 in
    if bit_and(st, 8) != 0 and bit_and(bit_shr(st, 4), 3) < 3 then
        lc - 2
    else
        lc
fn rtc_cvlevs(op, p, pos, m, st) =
    if m == 0 or pos < 0 then
        pos
    else
        let i = rtc_hib(m) in
        let v = rtc_cvc(p, i) in
        let m2 = m - bit_shl(1, i) in
        if bit_shr(st, 6) > 0 then
            rtc_cvlevs(op, p, rtc_cvput(op, pos, if v < 0 then 1 else 0, 1), m2, st - 64)
        else
            let sl = bit_and(st, 7) in
            let np = rtc_cvlev(op, pos, rtc_cvlc(v, st), sl) in
            rtc_cvlevs(op, p, np, m2, bit_and(st, 48) + rtc_cvnsl(sl, v))
## run_before from the mask alone: the zeros between each set bit and the next lower one, while zeros are left; the
## lowest coefficient's run is implied
fn rtc_cvrun(op, pos, m, zl, left) =
    if zl <= 0 or left <= 1 or pos < 0 then
        pos
    else
        let i = rtc_hib(m) in
        let m2 = m - bit_shl(1, i) in
        let run = i - rtc_hib(m2) - 1 in
        let z = (if zl > 7 then 6 else zl - 1) * 16 + run in
        rtc_cvrun(op, rtc_cvput(op, pos, rtc_cvt(1064 + z), rtc_cvt(952 + z)), m2, zl - run, left - 1)
fn rtc_cvtok(op, pos, nc, tc, t1) =
    let x = tc * 4 + t1 in
    if nc < 0 then
        rtc_cvput(op, pos, rtc_cvt(428 + x), rtc_cvt(408 + x))
    else if nc >= 8 then
        rtc_cvput(op, pos, if tc == 0 then 3 else x - 4, 6)
    else
        let k = if nc < 2 then 0 else if nc < 4 then 68 else 136 in
        rtc_cvput(op, pos, rtc_cvt(204 + k + x), rtc_cvt(k + x))
fn rtc_cvtz(op, pos, nc, tc, tz, maxc) =
    if tc >= maxc or tc == 0 then
        pos
    else if nc < 0 then
        rtc_cvput(op, pos, rtc_cvt(940 + (tc - 1) * 4 + tz), rtc_cvt(928 + (tc - 1) * 4 + tz))
    else
        rtc_cvput(op, pos, rtc_cvt(688 + (tc - 1) * 16 + tz), rtc_cvt(448 + (tc - 1) * 16 + tz))
fn rtc_cvres(pos, tc) = if pos < 0 then mkint(0 - 1) else mkint(pos * 32 + tc)
fn rtc_cvblk(p, nc, maxc, op, pos, m) =
    if m == 0 then
        rtc_cvres(rtc_cvtok(op, pos, nc, 0, 0), 0)
    else
        let tc = rtc_pop16(m) in
        let t1 = rtc_cvones(p, m, 0) in
        let p1 = rtc_cvtok(op, pos, nc, tc, t1) in
        let st = t1 * 64 + t1 * 16 + 8 + (if tc > 10 and t1 < 3 then 1 else 0) in
        let p2 = rtc_cvlevs(op, p, p1, m, st) in
        let tz = rtc_hib(m) + 1 - tc in
        let p3 = rtc_cvtz(op, p2, nc, tc, tz, maxc) in
        rtc_cvres(rtc_cvrun(op, p3, m, tz, tc), tc)
## nc >= 4096 (nC + 4096) allows level_prefix above 15 (High profiles); plain nC keeps the stream Baseline-valid and
## answers -1 for a level that would need it (above 2063 with suffixLength 0 .. the 15-prefix escape range)
fn rtc_cavlc(coef, ci, ncf, maxc, out, pos) = if ncf >= 4096 then rtc_cavlc2(coef, ci, ncf - 4096, maxc, out, pos, 1) else rtc_cavlc2(coef, ci, ncf, maxc, out, pos, 0)
fn rtc_cavlc2(coef, ci, nc, maxc, out, pos, hpf) =
    if maxc != 16 and maxc != 15 and maxc != 4 or nc < 0 - 1 or nc == 0 - 1 and maxc != 4 or pos < 0 or rtc_isbuf(out) == 0 or rtc_fits(coef, ci, 2 * maxc) == 0 then
        mkint(0 - 1)
    else
        let w = store32(sym_addr("__rtc_scratch") + 3960, rtc_len(out) * 8) in
        let hp = store32(sym_addr("__rtc_scratch") + 3964, hpf) in
        rtc_cvblk(coef + 8 + ci, nc, maxc, out + 8, pos, rtc_cvmask(coef + 8 + ci, maxc))
fn buf_h264_cavlc6(coef, ci, nc, maxc, out, pos) = rtc_cavlc(coef, rt_int(ci), rt_int(nc), rt_int(maxc), out, rt_int(pos))

## --- CAVLC of a whole macroblock (9.2.1 nC, 7.3.5.3 order) ---------------------------------------------------------------
## buf_h264_cavlc_luma(lev, ctx, out, pos): the luma residual of one macroblock, from the levels as the macroblock
## builtins leave them, written into out from bit pos. ctx (at least 64 bytes, int32 / bytes): in mode (0: 16 blocks
## of 16 coefficients, as buf_h264_mb_i4 / buf_h264_mb_p; 1: Intra16x16, the DC block then 16 blocks of 15 AC, as
## buf_h264_mb_i16), the luma coded_block_pattern (4: bit k for 8x8 quadrant k; for mode 1 0 or 15), the offset in
## lev of block 0's 16 zigzag levels (8; blocks 32 bytes apart, the AC of mode 1 from + 2), the offset of the 16 DC
## levels (12, mode 1), the TotalCoeff of the left macroblock's right column (bytes 16..19, rows 0..3) and of the top
## macroblock's bottom row (20..23, columns 0..3), 255 where not available; out the TotalCoeff of each block in
## luma4x4BlkIdx order (32..47; 0 for a block of an uncoded quadrant), the context the next macroblocks need. nC of a
## block (9.2.1): the left and top blocks' TotalCoeff, (nA + nB + 1) >> 1 with both, the one there is, else 0.
## Answers the new bit position, or -1 (wrong argument or full buffer).
## buf_h264_cavlc_chroma(lev, ctx, out, pos): the chroma residual (Cb and Cr DC with nC -1, then the AC blocks) as
## buf_h264_mb_pc / buf_h264_mb_ic leave it. ctx (at least 64 bytes): in the chroma coded_block_pattern (0, 1 DC, 2 DC
## and AC), the Cb output base (4) and the Cr base (8) in lev (DC levels at base + 48, the AC of block k at base + 64 +
## 32 k + 2), the TotalCoeff of the left neighbours (bytes 16, 17 Cb rows 0..1; 18, 19 Cr) and of the top ones (20, 21
## Cb columns 0..1; 22, 23 Cr), 255 where not available; out the AC TotalCoeff per block (32..35 Cb, 36..39 Cr).
fn rtc_ncv(a, b) =
    if a != 255 and b != 255 then
        bit_shr(a + b + 1, 1)
    else if a != 255 then
        a
    else if b != 255 then
        b
    else
        0
fn rtc_lna(c, bx, by) = if bx > 0 then load8(c + 32 + rtc_bidx(bx - 4, by)) else load8(c + 16 + bit_shr(by, 2))
fn rtc_lnb(c, bx, by) = if by > 0 then load8(c + 32 + rtc_bidx(bx, by - 4)) else load8(c + 20 + bit_shr(bx, 2))
fn rtc_lnc(c, b) = rtc_ncv(rtc_lna(c, rtc_bx(b), rtc_by(b)), rtc_lnb(c, rtc_bx(b), rtc_by(b)))
## one block through buf_h264_cavlc6's routine: the new position, its TotalCoeff stored at c + to; -1 on failure
fn rtc_cvone(lev, off, nc, maxc, out, pos) = let r = rt_int(rtc_cavlc(lev, off, nc, maxc, out, pos)) in r
fn rtc_cvl(lev, c, out, b, pos) =
    if b >= 16 or pos < 0 then
        pos
    else if bit_and(bit_shr(load32(c + 4), bit_shr(b, 2)), 1) == 0 then
        let z = store8(c + 32 + b, 0) in
        rtc_cvl(lev, c, out, b + 1, pos)
    else
        let m1 = load32(c) in
        let r = rtc_cvone(lev, load32(c + 8) + b * 32 + (if m1 == 1 then 2 else 0), rtc_lnc(c, b), if m1 == 1 then 15 else 16, out, pos) in
        if r < 0 then
            0 - 1
        else
            let z = store8(c + 32 + b, bit_and(r, 31)) in
            rtc_cvl(lev, c, out, b + 1, bit_shr(r, 5))
fn buf_h264_cavlc_luma(lev, ctx, out, pos) =
    if rtc_fits(ctx, 0, 64) == 0 or rtc_isbuf(lev) == 0 or rt_int(pos) < 0 then
        mkint(0 - 1)
    else
        rtc_cvlum(lev, ctx + 8, out, rt_int(pos))
fn rtc_cvlum(lev, c, out, pos) =
    let m = load32(c) in
    if m > 1 or load32(c + 4) > 15 then
        mkint(0 - 1)
    else
        let p1 = if m == 1 then let r = rtc_cvone(lev, load32(c + 12), rtc_lnc(c, 0), 16, out, pos) in if r < 0 then 0 - 1 else bit_shr(r, 5) else pos in
        mkint(rtc_cvl(lev, c, out, 0, p1))
## chroma: block k of the 2x2 (raster), plane offset po (0 Cb, 2 Cr) into the context bytes; the plane base is the
## int32 at c + 4 + 2 po (Cb at 4, Cr at 8)
fn rtc_cna(c, k, po) = if bit_and(k, 1) == 1 then load8(c + 32 + po * 2 + k - 1) else load8(c + 16 + po + bit_shr(k, 1))
fn rtc_cnb(c, k, po) = if k >= 2 then load8(c + 32 + po * 2 + k - 2) else load8(c + 20 + po + bit_and(k, 1))
fn rtc_cac(lev, c, out, k, po, pos) =
    if k >= 4 or pos < 0 then
        pos
    else
        let r = rtc_cvone(lev, load32(c + 4 + po * 2) + 64 + k * 32 + 2, rtc_ncv(rtc_cna(c, k, po), rtc_cnb(c, k, po)), 15, out, pos) in
        if r < 0 then
            0 - 1
        else
            let z = store8(c + 32 + po * 2 + k, bit_and(r, 31)) in
            rtc_cac(lev, c, out, k + 1, po, bit_shr(r, 5))
fn rtc_czero(c) = store64(c + 32, 0)
fn buf_h264_cavlc_chroma(lev, ctx, out, pos) =
    if rtc_fits(ctx, 0, 64) == 0 or rtc_isbuf(lev) == 0 or rt_int(pos) < 0 then
        mkint(0 - 1)
    else
        rtc_cvchr(lev, ctx + 8, out, rt_int(pos))
fn rtc_cvchr(lev, c, out, pos) =
    let cbp = load32(c) in
    if cbp > 2 then
        mkint(0 - 1)
    else
        let z = rtc_czero(c) in
        if cbp == 0 then
            mkint(pos)
        else
            let d1 = rt_int(rtc_cavlc(lev, load32(c + 4) + 48, 0 - 1, 4, out, pos)) in
            if d1 < 0 then
                mkint(0 - 1)
            else
                let d2 = rt_int(rtc_cavlc(lev, load32(c + 8) + 48, 0 - 1, 4, out, bit_shr(d1, 5))) in
                if d2 < 0 then
                    mkint(0 - 1)
                else if cbp == 1 then
                    mkint(bit_shr(d2, 5))
                else
                    let p1 = rtc_cac(lev, c, out, 0, 0, bit_shr(d2, 5)) in
                    mkint(rtc_cac(lev, c, out, 0, 2, p1))
