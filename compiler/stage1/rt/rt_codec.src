            mkint(0 - 1)
        else
            rtc_mbp2(src, si, ss, ref, rec, cfg)
fn rtc_mbp2(src, si, ss, ref, rec, cfg) =
    let c = cfg + 8 in
    let rs = load32(c) in
    let qx = 4 * load32(c + 16) + rtc_s32(load32(c + 24)) in
    let qy = 4 * load32(c + 20) + rtc_s32(load32(c + 28)) in
    if qx <= 0 - 536870912 or qx >= 536870912 or qy <= 0 - 536870912 or qy >= 536870912 then
