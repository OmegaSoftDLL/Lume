## rt_codec.src -- H.264 building blocks for encoders, written in Lume (compiled by --raw, linked only into programs that
## name a buf_h264_* builtin). Blocks are 4x4 int16 coefficients stored row by row (32 bytes, little endian) or 4x4 /
## 16x16 bytes; every builtin checks its buffers and offsets once and answers -1 on a wrong argument.
##   buf_h264_fdct4x4(src, si, dst, di)          forward core transform (ITU-T H.264 8.5.12 inverse's counterpart)
##   buf_h264_idct4x4(src, si, dst, di)          inverse transform with the final (x + 32) >> 6
##   buf_h264_quant4x4(src, si, qp, intra, dst, di)  Z = sign(W) (|W| MF + f) >> (15 + qp/6), f = 2^qbits/3 intra,
##                                               /6 inter; answers the number of nonzero levels
##   buf_h264_dequant4x4(src, si, qp, dst, di)   W' = Z V << (qp / 6) (4x4 blocks without a separate DC)
##   buf_h264_sub4x4(a, ai, sa, pred, pi, dst)   residual a (rows sa apart) - pred (16 contiguous bytes) -> int16 block
##   buf_h264_recon4x4(pred, pi, res, ri, dst, di)  clip(pred + res, 0, 255) -> 16 contiguous bytes
##   buf_h264_intra4x4(frame, fi, fs, mode, avail, dst)   the 9 Intra4x4 predictions (8.3.1.2) from the reconstructed
##                                               frame (block at fi, rows fs apart) into 16 bytes; avail bits: 1 left,
##                                               2 top, 4 top-right, 8 top-left (a missing top-right repeats D)
##   buf_h264_intra16x16(frame, fi, fs, mode, avail, dst)  the 4 Intra16x16 predictions (8.3.3: vertical, horizontal,
##                                               DC, plane) into 256 bytes; avail bits 1 left, 2 top, 8 top-left
##   buf_h264_mb_i4(src, si, ss, rec, ri, cfg)   a whole Intra4x4 macroblock: mode decision, transform, quantization
##                                               and reconstruction of its 16 blocks in one call (see its section)
##   buf_h264_mb_p(src, si, ss, ref, rec, cfg)   a whole inter 16x16 macroblock: quarter-sample prediction, residual,
##                                               transform, quantization and reconstruction (see its section)
##   buf_h264_mb_pc(src, si, ss, ref, rec, cfg)  one chroma plane of an inter macroblock (2x2 DC path included)
##   buf_h264_me16(src, si, ss, ref, cfg)        motion search of a 16x16 macroblock (diamond, then half / quarter)
##   buf_h264_mb_i16(src, si, ss, rec, ri, cfg)  a whole Intra16x16 macroblock (4x4 luma DC Hadamard; decide-only flag)
##   buf_h264_mb_ic(srcu, srcv, recu, recv, cfg) intra chroma of a macroblock: one mode for Cb and Cr, both planes coded
##   buf_h264_cavlc_luma / buf_h264_cavlc_chroma(lev, ctx, out, pos)  CAVLC of a whole macroblock with the nC context
##   buf_h264_deblock_mb(y, u, v, cfg)           the deblocking of a whole macroblock, luma and both chroma planes (8.7)

## scratch: one static block (runtime/rt_die's .bss __rtc_scratch, 4096 bytes) instead of an allocation per call; the
## runtime is single-threaded and no codec builtin calls another, so the parts never overlap: luma MC window and b1
## table at 0 (3616 bytes), the quantization / dequantization multiplier vectors at 3616 / 3632 (16 each), intra 4x4 neighbours at 3744 (112), the deblocking
## vector block at 0 (512 bytes: vec_dbk16 / vec_dbkv / vec_dbkh2) and the macroblock deblocking context at 512 (240),
## intra 4x4 edge and filter tables at 3912 (48), the CAVLC stream length in bits at 3960 (int32) and the profile flag
## at 3964 (int32: 1 lets level_prefix exceed 15, as the High profiles allow; 0 refuses it, Baseline / Main / Extended)
fn rtc_isbuf(b) = if b == 0 or bit_and(b, 7) != 0 then 0 else if load8(b) != 15 then 0 else 1
fn rtc_len(b) = bit_shr(load64(b), 8)
fn rtc_fits(b, o, n) =
    if rtc_isbuf(b) == 0 or o < 0 then
        0
    else if o > rtc_len(b) then
        0
    else if o + n <= rtc_len(b) then
        1
    else
        0
## int16 at p (little endian, sign-extended) and the low 16 bits of v stored at p
fn rtc_r16(p) = let v = load8(p) + load8(p + 1) * 256 in if v >= 32768 then v - 65536 else v
fn rtc_w16(p, v) = let a = store8(p, bit_and(v, 255)) in store8(p + 1, bit_and(bit_shr(v, 8), 255))
fn rtc_clip(v) = if v < 0 then 0 else if v > 255 then 255 else v
fn rtc_abs(v) = if v < 0 then 0 - v else v

## --- transforms ---------------------------------------------------------------------------------------------------------
## both in SSE2: vec_fdct4 (exact mod 2^16) and vec_idct4 (32-bit lanes, the final (x + 32) >> 6, the low 16 bits stored)
fn rtc_tr(src, si, dst, di, inv) =
    if rtc_fits(src, si, 32) == 0 or rtc_fits(dst, di, 32) == 0 then
        mkint(0 - 1)
    else if inv == 0 then
        let z = vec_fdct4(src + 8 + si, dst + 8 + di) in
        mkint(0)
    else
        let t = vec_idct4(src + 8 + si, dst + 8 + di) in
        mkint(0)
fn buf_h264_fdct4x4(src, si, dst, di) = rtc_tr(src, rt_int(si), dst, rt_int(di), 0)
fn buf_h264_idct4x4(src, si, dst, di) = rtc_tr(src, rt_int(si), dst, rt_int(di), 1)

## --- quantization ------------------------------------------------------------------------------------------------------
## MF and V by qp % 6 and position class (0 both even, 1 both odd, 2 mixed)
fn rtc_mf(q, k) =
    if q == 0 then
        (if k == 0 then 13107 else if k == 1 then 5243 else 8066)
    else if q == 1 then
        (if k == 0 then 11916 else if k == 1 then 4660 else 7490)
    else if q == 2 then
        (if k == 0 then 10082 else if k == 1 then 4194 else 6554)
    else if q == 3 then
        (if k == 0 then 9362 else if k == 1 then 3647 else 5825)
    else if q == 4 then
        (if k == 0 then 8192 else if k == 1 then 3355 else 5243)
    else if k == 0 then
        7282
    else if k == 1 then
        2893
    else
        4559
fn rtc_v(q, k) =
    if q == 0 then
        (if k == 0 then 10 else if k == 1 then 16 else 13)
    else if q == 1 then
        (if k == 0 then 11 else if k == 1 then 18 else 14)
    else if q == 2 then
        (if k == 0 then 13 else if k == 1 then 20 else 16)
    else if q == 3 then
        (if k == 0 then 14 else if k == 1 then 23 else 18)
    else if q == 4 then
        (if k == 0 then 16 else if k == 1 then 25 else 20)
    else if k == 0 then
        18
    else if k == 1 then
        29
    else
        23
fn buf_h264_quant4x4(src, si, qp, intra, dst, di) = rtc_quant(src, rt_int(si), rt_int(qp), rt_int(intra), dst, rt_int(di))
## a level is |w| MF + f >> qbits with w's sign (vec_quant4, 8 levels at a time); qbits, f and the multiplier vector
## once per block; answers the number of nonzero levels
## the 8-word multiplier vector of rows 0 and 1 (classes 0 2 0 2 / 2 1 2 1) at p: one vector serves both halves
fn rtc_wvec(p, k0, k1, k2) =
    let a = store64(p, k0 + k2 * 65536 + k0 * 4294967296 + k2 * 281474976710656) in
    store64(p + 8, k2 + k1 * 65536 + k2 * 4294967296 + k1 * 281474976710656)
fn rtc_q4(src, dst, qp, intra) =
    let qb = 15 + qp / 6 in
    let fq = bit_shl(1, qb) / (if intra != 0 then 3 else 6) * 32 + qb in
    let r = qp % 6 in
    let mp = sym_addr("__rtc_scratch") + 3616 in
    let a = rtc_wvec(mp, rtc_mf(r, 0), rtc_mf(r, 1), rtc_mf(r, 2)) in
    let z = vec_quant4(src, dst, mp, fq) in
    rtc_nzc(dst, 0, 0)
fn rtc_quant(src, si, qp, intra, dst, di) =
    if qp < 0 or qp > 51 or rtc_fits(src, si, 32) == 0 or rtc_fits(dst, di, 32) == 0 then
        mkint(0 - 1)
    else
        mkint(rtc_q4(src + 8 + si, dst + 8 + di, qp, intra))
fn rtc_dq(src, dst, i, qp) = rtc_dqf(src, dst, qp)
fn buf_h264_dequant4x4(src, si, qp, dst, di) = rtc_dequant(src, rt_int(si), rt_int(qp), dst, rt_int(di))
fn rtc_dequant(src, si, qp, dst, di) =
    if qp < 0 or qp > 51 or rtc_fits(src, si, 32) == 0 or rtc_fits(dst, di, 32) == 0 then
        mkint(0 - 1)
    else
        let z = rtc_dq(src + 8 + si, dst + 8 + di, 0, qp) in
        mkint(0)

## --- residual and reconstruction ---------------------------------------------------------------------------------------
fn rtc_sub(a, sa, p, d, i) = vec_res4(a, sa, p, d)
fn buf_h264_sub4x4(a, ai, sa, pred, pi, dst) = rtc_sub4(a, rt_int(ai), rt_int(sa), pred, rt_int(pi), dst)
fn rtc_sub4(a, ai, sa, pred, pi, dst) =
    if sa < 4 or rtc_fits(a, ai, 3 * sa + 4) == 0 or rtc_fits(pred, pi, 16) == 0 or rtc_fits(dst, 0, 32) == 0 then
        mkint(0 - 1)
    else
        let z = rtc_sub(a + 8 + ai, sa, pred + 8 + pi, dst + 8, 0) in
        mkint(0)
fn rtc_rec(p, r, d, i) = vec_rec4(p, r, d, 4)
fn buf_h264_recon4x4(pred, pi, res, ri, dst, di) = rtc_recon(pred, rt_int(pi), res, rt_int(ri), dst, rt_int(di))
fn rtc_recon(pred, pi, res, ri, dst, di) =
    if rtc_fits(pred, pi, 16) == 0 or rtc_fits(res, ri, 32) == 0 or rtc_fits(dst, di, 16) == 0 then
        mkint(0 - 1)
    else
        let z = rtc_rec(pred + 8 + pi, res + 8 + ri, dst + 8 + di, 0) in
        mkint(0)

## --- Intra4x4 prediction -----------------------------------------------------------------------------------------------
## neighbours in 13 words of n: 0..3 top A..D, 4..7 top-right E..H, 8..11 left I..L, 12 top-left M
fn rtc_nb(n, k) = load64(n + k * 8)
fn rtc_put(d, x, y, v) = store8(d + y * 4 + x, v)
fn rtc_rep(n, k, v) = if k >= 8 then 0 else let w = store64(n + k * 8, v) in rtc_rep(n, k + 1, v)
## DC: the mean of the available top and left samples, 128 without either
fn rtc_dc4(n, av) =
    let st = rtc_nb(n, 0) + rtc_nb(n, 1) + rtc_nb(n, 2) + rtc_nb(n, 3) in
    let sl = rtc_nb(n, 8) + rtc_nb(n, 9) + rtc_nb(n, 10) + rtc_nb(n, 11) in
    if bit_and(av, 1) != 0 and bit_and(av, 2) != 0 then
        bit_shr(st + sl + 4, 3)
    else if bit_and(av, 2) != 0 then
        bit_shr(st + 2, 2)
    else if bit_and(av, 1) != 0 then
        bit_shr(sl + 2, 2)
    else
        128
## p(-1,-1) = M, p(x,-1) = top/top-right x, p(-1,y) = left y
fn rtc_px(n, x) = if x < 0 then rtc_nb(n, 12) else rtc_nb(n, x)
fn rtc_py(n, y) = if y < 0 then rtc_nb(n, 12) else rtc_nb(n, 8 + y)
fn rtc_m4(n, d, mode, i) =
    if i >= 16 then
        0
    else
        let x = bit_and(i, 3) in
        let y = bit_shr(i, 2) in
        let w = rtc_put(d, x, y, rtc_m4v(n, mode, x, y)) in
        rtc_m4(n, d, mode, i + 1)
fn rtc_m4v(n, mode, x, y) =
    if mode == 0 then
        rtc_nb(n, x)
    else if mode == 1 then
        rtc_nb(n, 8 + y)
    else if mode == 3 then
        rtc_ddl(n, x, y)
    else if mode == 4 then
        rtc_ddr(n, x, y)
    else if mode == 5 then
        rtc_vr(n, x, y)
    else if mode == 6 then
        rtc_hd(n, x, y)
    else if mode == 7 then
        rtc_vl(n, x, y)
    else
        rtc_hu(n, x, y)
## 8.3.1.2.4 .. 8.3.1.2.9 (zVR / zHD / zHU as in the standard)
fn rtc_ddl(n, x, y) =
    if x == 3 and y == 3 then
        bit_shr(rtc_nb(n, 6) + 3 * rtc_nb(n, 7) + 2, 2)
    else
        bit_shr(rtc_nb(n, x + y) + 2 * rtc_nb(n, x + y + 1) + rtc_nb(n, x + y + 2) + 2, 2)
fn rtc_ddr(n, x, y) =
    if x > y then
        bit_shr(rtc_px(n, x - y - 2) + 2 * rtc_px(n, x - y - 1) + rtc_px(n, x - y) + 2, 2)
    else if x < y then
        bit_shr(rtc_py(n, y - x - 2) + 2 * rtc_py(n, y - x - 1) + rtc_py(n, y - x) + 2, 2)
    else
        bit_shr(rtc_px(n, 0) + 2 * rtc_nb(n, 12) + rtc_py(n, 0) + 2, 2)
fn rtc_vr(n, x, y) =
    let z = 2 * x - y in
    if z >= 0 and bit_and(z, 1) == 0 then
        bit_shr(rtc_px(n, x - bit_shr(y, 1) - 1) + rtc_px(n, x - bit_shr(y, 1)) + 1, 1)
    else if z >= 0 then
        bit_shr(rtc_px(n, x - bit_shr(y, 1) - 2) + 2 * rtc_px(n, x - bit_shr(y, 1) - 1) + rtc_px(n, x - bit_shr(y, 1)) + 2, 2)
    else if z == 0 - 1 then
        bit_shr(rtc_py(n, 0) + 2 * rtc_nb(n, 12) + rtc_px(n, 0) + 2, 2)
    else
        bit_shr(rtc_py(n, y - 1) + 2 * rtc_py(n, y - 2) + rtc_py(n, y - 3) + 2, 2)
fn rtc_hd(n, x, y) =
    let z = 2 * y - x in
    if z >= 0 and bit_and(z, 1) == 0 then
        bit_shr(rtc_py(n, y - bit_shr(x, 1) - 1) + rtc_py(n, y - bit_shr(x, 1)) + 1, 1)
    else if z >= 0 then
        bit_shr(rtc_py(n, y - bit_shr(x, 1) - 2) + 2 * rtc_py(n, y - bit_shr(x, 1) - 1) + rtc_py(n, y - bit_shr(x, 1)) + 2, 2)
    else if z == 0 - 1 then
        bit_shr(rtc_py(n, 0) + 2 * rtc_nb(n, 12) + rtc_px(n, 0) + 2, 2)
    else
        bit_shr(rtc_px(n, x - 1) + 2 * rtc_px(n, x - 2) + rtc_px(n, x - 3) + 2, 2)
fn rtc_vl(n, x, y) =
    if bit_and(y, 1) == 0 then
        bit_shr(rtc_nb(n, x + bit_shr(y, 1)) + rtc_nb(n, x + bit_shr(y, 1) + 1) + 1, 1)
    else
        bit_shr(rtc_nb(n, x + bit_shr(y, 1)) + 2 * rtc_nb(n, x + bit_shr(y, 1) + 1) + rtc_nb(n, x + bit_shr(y, 1) + 2) + 2, 2)
fn rtc_hu(n, x, y) =
    let z = x + 2 * y in
    if z > 5 then
        rtc_py(n, 3)
    else if z == 5 then
        bit_shr(rtc_py(n, 2) + 3 * rtc_py(n, 3) + 2, 2)
    else if bit_and(z, 1) == 0 then
        bit_shr(rtc_py(n, y + bit_shr(x, 1)) + rtc_py(n, y + bit_shr(x, 1) + 1) + 1, 1)
    else
        bit_shr(rtc_py(n, y + bit_shr(x, 1)) + 2 * rtc_py(n, y + bit_shr(x, 1) + 1) + rtc_py(n, y + bit_shr(x, 1) + 2) + 2, 2)
## the block needs a row above (fi >= fs + 1) when top or top-left is used and a column to the left (fi >= 1)
## vertical (0): the 4 samples above, as one word per row; horizontal (1): the left sample of each row repeated
fn rtc_rep4(v) = v * 16843009
fn rtc_fill4(d, v) =
    let w = rtc_rep4(v) in
    let a = store32(d, w) in
    let b = store32(d + 4, w) in
    let c = store32(d + 8, w) in
    store32(d + 12, w)
## DC from the frame directly (the mean of the available top and left samples, 128 without either)
fn rtc_dcf(b, fs, av) =
    let st = load8(b - fs) + load8(b - fs + 1) + load8(b - fs + 2) + load8(b - fs + 3) in
    let sl = load8(b - 1) + load8(b + fs - 1) + load8(b + 2 * fs - 1) + load8(b + 3 * fs - 1) in
    if bit_and(av, 1) != 0 and bit_and(av, 2) != 0 then
        bit_shr(st + sl + 4, 3)
    else if bit_and(av, 2) != 0 then
        bit_shr(st + 2, 2)
    else if bit_and(av, 1) != 0 then
        bit_shr(sl + 2, 2)
    else
        128
fn rtc_i4fast(b, fs, mode, d) =
    let z = if mode == 0 then let t = load32(b - fs) in let a = store32(d, t) in let c = store32(d + 4, t) in let e = store32(d + 8, t) in store32(d + 12, t) else let a = store32(d, rtc_rep4(load8(b - 1))) in let c = store32(d + 4, rtc_rep4(load8(b + fs - 1))) in let e = store32(d + 8, rtc_rep4(load8(b + 2 * fs - 1))) in store32(d + 12, rtc_rep4(load8(b + 3 * fs - 1))) in
    mkint(0)
## --- diagonal Intra4x4 modes (3..8) from one edge line -----------------------------------------------------------------
## E[k], k = -1..13, stored at T + k + 1: L3 L2 L1 L0 M A B C D E F G H (left y at 3 - y, M at 4, top x at 5 + x), with
## E[-1] = E[0] and E[13] = E[12]. F3[k] = (E[k-1] + 2 E[k] + E[k+1] + 2) >> 2 at T + 16 + k, F2[k] = (E[k] + E[k+1] + 1)
## >> 1 at T + 32 + k. Every diagonal prediction (8.3.1.2.4 .. 8.3.1.2.9) is one of them:
##   3 ddl F3[6 + x + y]        4 ddr F3[4 + x - y]
##   5 vr  z = 2x - y: even >= 0 F2[4 + x - y/2], odd F3[4 + x - y/2], -1 F3[4], else F3[5 - y]
##   6 hd  z = 2y - x: even >= 0 F2[3 - y + x/2], odd F3[4 - y + x/2], -1 F3[4], else F3[3 + x]
##   7 vl  y even F2[5 + x + y/2], odd F3[6 + x + y/2]
##   8 hu  z = x + 2y: > 5 E[0], 5 F3[0], even F2[2 - y - x/2], odd F3[2 - (y + x/2)]
fn rtc_e(t, k) = load8(t + k + 1)
## E straight from the frame (block at b, rows fs apart); without the top-right samples (avail bit 4) D repeats
fn rtc_eput(t, b, fs, av, k) =
    if k > 12 then
        0
    else
        let v = if k <= 3 then load8(b + (3 - k) * fs - 1) else if k == 4 then load8(b - fs - 1) else if k <= 8 or bit_and(av, 4) != 0 then load8(b - fs + k - 5) else load8(b - fs + 3) in
        let w = store8(t + k + 1, v) in
        rtc_eput(t, b, fs, av, k + 1)
fn rtc_fput(t, k) =
    if k > 12 then
        0
    else
        let a = store8(t + 16 + k, bit_shr(rtc_e(t, k - 1) + 2 * rtc_e(t, k) + rtc_e(t, k + 1) + 2, 2)) in
        let b = if k <= 11 then store8(t + 32 + k, bit_shr(rtc_e(t, k) + rtc_e(t, k + 1) + 1, 1)) else 0 in
        rtc_fput(t, k + 1)
fn rtc_edge(t, b, fs, av) =
    let a = rtc_eput(t, b, fs, av, 0) in
    let b = store8(t, load8(t + 1)) in
    let c = store8(t + 14, load8(t + 13)) in
    rtc_fput(t, 0)
fn rtc_f3(t, k) = load8(t + 16 + k)
fn rtc_f2(t, k) = load8(t + 32 + k)
fn rtc_dvr(t, x, y) =
    let z = 2 * x - y in
    if z >= 0 and bit_and(z, 1) == 0 then
        rtc_f2(t, 4 + x - bit_shr(y, 1))
    else if z >= 0 then
        rtc_f3(t, 4 + x - bit_shr(y, 1))
    else if z == 0 - 1 then
        rtc_f3(t, 4)
    else
        rtc_f3(t, 5 - y)
fn rtc_dhd(t, x, y) =
    let z = 2 * y - x in
    if z >= 0 and bit_and(z, 1) == 0 then
        rtc_f2(t, 3 - y + bit_shr(x, 1))
    else if z >= 0 then
        rtc_f3(t, 4 - y + bit_shr(x, 1))
    else if z == 0 - 1 then
        rtc_f3(t, 4)
    else
        rtc_f3(t, 3 + x)
fn rtc_dhu(t, x, y) =
    let z = x + 2 * y in
    if z > 5 then
        rtc_e(t, 0)
    else if z == 5 then
        rtc_f3(t, 0)
    else if bit_and(z, 1) == 0 then
        rtc_f2(t, 2 - y - bit_shr(x, 1))
    else
        rtc_f3(t, 2 - y - bit_shr(x, 1))
fn rtc_dv(t, mode, x, y) =
    if mode == 3 then
        rtc_f3(t, 6 + x + y)
    else if mode == 4 then
        rtc_f3(t, 4 + x - y)
    else if mode == 5 then
        rtc_dvr(t, x, y)
    else if mode == 6 then
        rtc_dhd(t, x, y)
    else if mode == 7 then
        (if bit_and(y, 1) == 0 then rtc_f2(t, 5 + x + bit_shr(y, 1)) else rtc_f3(t, 6 + x + bit_shr(y, 1)))
    else
        rtc_dhu(t, x, y)
fn rtc_dfill(t, d, mode, i) =
    if i >= 16 then
        0
    else
        let w = store8(d + i, rtc_dv(t, mode, bit_and(i, 3), bit_shr(i, 2))) in
        rtc_dfill(t, d, mode, i + 1)
fn rtc_diag(b, fs, av, d, mode) =
    let t = sym_addr("__rtc_scratch") + 3912 in
    let e = rtc_edge(t, b, fs, av) in
    let z = rtc_dfill(t, d, mode, 0) in
    mkint(0)
## --- blocks on the picture edge (first row or column): only the neighbours the mask declares must lie inside the
## buffer; an undeclared neighbour outside it reads as 128 (it takes no part in a valid prediction), and a declared one
## outside it is a caller error (-1). Interior blocks keep the paths above unchanged.
fn rtc_in(f, i) = if i >= 0 and i < rtc_len(f) then 1 else 0
fn rtc_sl(f, i) = if rtc_in(f, i) == 1 then load8(f + 8 + i) else 128
fn rtc_i4need(f, fi, fs, av) =
    if (bit_and(av, 2) == 0 or rtc_in(f, fi - fs) == 1 and rtc_in(f, fi - fs + 3) == 1) and (bit_and(av, 4) == 0 or rtc_in(f, fi - fs + 4) == 1 and rtc_in(f, fi - fs + 7) == 1) and (bit_and(av, 8) == 0 or rtc_in(f, fi - fs - 1) == 1) and (bit_and(av, 1) == 0 or rtc_in(f, fi - 1) == 1 and rtc_in(f, fi - 1 + 3 * fs) == 1) then
        1
    else
        0
fn rtc_sgtop(f, top, n, i) =
    if i >= 4 then
        0
    else
        let w = store64(n + i * 8, rtc_sl(f, top + i)) in
        rtc_sgtop(f, top, n, i + 1)
fn rtc_sgtr(f, top, n, i) =
    if i >= 4 then
        0
    else
        let w = store64(n + 32 + i * 8, rtc_sl(f, top + 4 + i)) in
        rtc_sgtr(f, top, n, i + 1)
fn rtc_sgleft(f, fi, fs, n, i) =
    if i >= 4 then
        0
    else
        let w = store64(n + 64 + i * 8, rtc_sl(f, fi - 1 + i * fs)) in
        rtc_sgleft(f, fi, fs, n, i + 1)
fn rtc_sgather(f, fi, fs, n, av) =
    let top = fi - fs in
    let a = rtc_sgtop(f, top, n, 0) in
    let b = if bit_and(av, 4) != 0 then rtc_sgtr(f, top, n, 0) else rtc_rep(n, 4, load64(n + 24)) in
    let c = rtc_sgleft(f, fi, fs, n, 0) in
    store64(n + 96, rtc_sl(f, top - 1))
fn rtc_i4edge(f, fi, fs, ma, d) =
    let mode = bit_shr(ma, 4) in
    let av = bit_and(ma, 15) in
    if rtc_fits(f, fi, 3 * fs + 4) == 0 or rtc_i4need(f, fi, fs, av) == 0 then
        mkint(0 - 1)
    else
        let n = sym_addr("__rtc_scratch") + 3744 in
        let g = rtc_sgather(f, fi, fs, n, av) in
        let z = if mode == 2 then rtc_fill4(d, rtc_dc4(n, av)) else rtc_m4(n, d, mode, 0) in
        mkint(0)
fn buf_h264_intra4x4(frame, fi, fs, mode, avail, dst) = rtc_i4(frame, rt_int(fi), rt_int(fs), rt_int(mode) * 16 + bit_and(rt_int(avail), 15), dst)
fn rtc_i4(f, fi, fs, ma, dst) = if rtc_fits(dst, 0, 16) == 0 then mkint(0 - 1) else rtc_i4p(f, fi, fs, ma, dst + 8)
## the prediction into 16 bytes at the raw address d (mkint(0), or mkint(-1) on a wrong argument)
fn rtc_i4p(f, fi, fs, ma, d) =
    let mode = bit_shr(ma, 4) in
    let av = bit_and(ma, 15) in
    if mode < 0 or mode > 8 or fs < 8 or fi < 0 then
        mkint(0 - 1)
    else if fi < fs + 1 or rtc_fits(f, fi - fs - 1, 4 * fs + 9) == 0 then
        rtc_i4edge(f, fi, fs, ma, d)
    else if mode <= 1 then
        rtc_i4fast(f + 8 + fi, fs, mode, d)
    else if mode == 2 then
        let z = rtc_fill4(d, rtc_dcf(f + 8 + fi, fs, av)) in
        mkint(0)
    else
        rtc_diag(f + 8 + fi, fs, av, d, mode)

## --- Intra16x16 prediction ----------------------------------------------------------------------------------------------
fn rtc_v16(f, fs, d, i) =
    if i >= 256 then
        0
    else
        let w = store8(d + i, load8(f - fs + bit_and(i, 15))) in
        rtc_v16(f, fs, d, i + 1)
fn rtc_h16(f, fs, d, i) =
    if i >= 256 then
        0
    else
        let w = store8(d + i, load8(f + bit_shr(i, 4) * fs - 1)) in
        rtc_h16(f, fs, d, i + 1)
fn rtc_sumtop(f, fs, i, acc) = if i >= 16 then acc else rtc_sumtop(f, fs, i + 1, acc + load8(f - fs + i))
fn rtc_sumleft(f, fs, i, acc) = if i >= 16 then acc else rtc_sumleft(f, fs, i + 1, acc + load8(f + i * fs - 1))
fn rtc_dc16(f, fs, av) =
    if bit_and(av, 3) == 3 then
        bit_shr(rtc_sumtop(f, fs, 0, 0) + rtc_sumleft(f, fs, 0, 0) + 16, 5)
    else if bit_and(av, 2) != 0 then
        bit_shr(rtc_sumtop(f, fs, 0, 0) + 8, 4)
    else if bit_and(av, 1) != 0 then
        bit_shr(rtc_sumleft(f, fs, 0, 0) + 8, 4)
    else
        128
## plane (8.3.3.4): H = sum (x'+1)(p[8+x',-1] - p[6-x',-1]), V likewise down the left column; p[-1,-1] closes both
fn rtc_ph(f, fs, k, acc) =
    if k >= 8 then
        acc
    else
        rtc_ph(f, fs, k + 1, acc + (k + 1) * (load8(f - fs + 8 + k) - load8(f - fs + 6 - k)))
fn rtc_pv(f, fs, k, acc) =
    if k >= 8 then
        acc
    else
        rtc_pv(f, fs, k + 1, acc + (k + 1) * (load8(f + (8 + k) * fs - 1) - load8(f + (6 - k) * fs - 1)))
fn rtc_plane(f, fs, d) =
    let hh = rtc_ph(f, fs, 0, 0) in
    let vv = rtc_pv(f, fs, 0, 0) in
    let a = 16 * (load8(f + 15 * fs - 1) + load8(f - fs + 15)) in
    let b = rtc_sar6(5 * hh + 32) in
    let c = rtc_sar6(5 * vv + 32) in
    rtc_pl(d, a, b, c, 0)
fn rtc_sar6(v) = if v >= 0 then bit_shr(v, 6) else 0 - bit_shr(63 - v, 6)
fn rtc_pl(d, a, b, c, i) =
    if i >= 256 then
        0
    else
        let x = bit_and(i, 15) in
        let y = bit_shr(i, 4) in
        let v = a + b * (x - 7) + c * (y - 7) + 16 in
        let w = store8(d + i, rtc_clip(if v >= 0 then bit_shr(v, 5) else 0 - bit_shr(31 - v, 5))) in
        rtc_pl(d, a, b, c, i + 1)
## what a 16x16 mode reads: vertical the 16 samples above, horizontal the 16 on the left, DC the sides the mask declares,
## plane all of them and the top-left corner
fn rtc_i16top(f, fi, fs) = if rtc_in(f, fi - fs) == 1 and rtc_in(f, fi - fs + 15) == 1 then 1 else 0
fn rtc_i16left(f, fi, fs) = if rtc_in(f, fi - 1) == 1 and rtc_in(f, fi - 1 + 15 * fs) == 1 then 1 else 0
fn rtc_i16need(f, fi, fs, mode, av) =
    if mode == 0 then
        rtc_i16top(f, fi, fs)
    else if mode == 1 then
        rtc_i16left(f, fi, fs)
    else if mode == 2 then
        (if (bit_and(av, 2) == 0 or rtc_i16top(f, fi, fs) == 1) and (bit_and(av, 1) == 0 or rtc_i16left(f, fi, fs) == 1) then 1 else 0)
    else if rtc_i16top(f, fi, fs) == 1 and rtc_i16left(f, fi, fs) == 1 and rtc_in(f, fi - fs - 1) == 1 then
        1
    else
        0
fn buf_h264_intra16x16(frame, fi, fs, mode, avail, dst) = rtc_i16(frame, rt_int(fi), rt_int(fs), rt_int(mode) * 16 + bit_and(rt_int(avail), 15), dst)
fn rtc_i16(f, fi, fs, ma, dst) = if rtc_fits(dst, 0, 256) == 0 then mkint(0 - 1) else rtc_i16p(f, fi, fs, ma, dst + 8)
## the prediction into 256 bytes at the raw address d (mkint(0), or mkint(-1) on a wrong argument)
fn rtc_i16p(f, fi, fs, ma, d) =
    let mode = bit_shr(ma, 4) in
    let av = bit_and(ma, 15) in
    if mode < 0 or mode > 3 or fs < 16 or fi < 0 or rtc_fits(f, fi, 15 * fs + 16) == 0 or rtc_i16need(f, fi, fs, mode, av) == 0 then
        mkint(0 - 1)
    else
        let p = f + 8 + fi in
        let z = if mode == 0 then rtc_v16(p, fs, d, 0) else if mode == 1 then rtc_h16(p, fs, d, 0) else if mode == 2 then rtc_fill16(d, 0, rtc_dc16(p, fs, av)) else rtc_plane(p, fs, d) in
        mkint(0)
fn rtc_fill16(d, i, v) = if i >= 256 then 0 else let w = store8(d + i, v) in rtc_fill16(d, i + 1, v)

## --- one whole Intra4x4 macroblock ---------------------------------------------------------------------------------------
## buf_h264_mb_i4(src, si, ss, rec, ri, cfg): the 16 luma 4x4 blocks of the macroblock at src + si (rows ss apart), in
## decoding order (luma4x4BlkIdx: 8x8 quadrants in raster order, 4x4 blocks in raster order inside each): for each
## block the 9 predictions allowed by its neighbours are made from the reconstruction rec (macroblock at ri, rows
## cfg.rs apart), each costs SATD(source - prediction) + lambda x (1 when it is the predicted mode, else 4), the
## cheapest wins (lower mode on a tie), and the block is transformed, quantized (intra rounding), dequantized,
## inverse transformed and reconstructed into rec, so the next block predicts from it as a decoder will.
## cfg is a buffer of at least 592 bytes; in: rs (int32 at 0), qp (4), lambda (8), the macroblock's neighbours (12:
## 1 left, 2 top, 4 top-right, 8 top-left), the Intra4x4 modes of the left macroblock's right column (bytes 16..19,
## rows 0..3) and of the top macroblock's bottom row (20..23, columns 0..3), 255 where that block has no Intra4x4
## mode. Out: per block in luma4x4BlkIdx order the chosen mode (bytes 32..47), its total nonzero levels (48..63), the
## 16 levels in zigzag order as int16 (64 + 32 * blk, ready for buf_h264_cavlc6) and the mode code (576..591: 255 =
## prev_intra4x4_pred_mode_flag 1, else rem_intra4x4_pred_mode). Answers the summed cost, or -1 on a wrong argument.
## Working storage: scratch 0..255 (prediction, best prediction, residual, transform, levels, dequantized,
## reconstructed residual) and 256..415 (the context below); the luma MC window that also lives there is never in use
## at the same time.
fn rtc_zz(k) =
    if k < 8 then
        (if k < 4 then (if k == 0 then 0 else if k == 1 then 1 else if k == 2 then 4 else 8) else if k == 4 then 5 else if k == 5 then 2 else if k == 6 then 3 else 6)
    else if k < 12 then
        (if k == 8 then 9 else if k == 9 then 12 else if k == 10 then 13 else 10)
    else if k == 12 then
        7
    else if k == 13 then
        11
    else if k == 14 then
        14
    else
        15
fn rtc_bx(b) = 4 * (bit_and(b, 1) + 2 * bit_and(bit_shr(b, 2), 1))
fn rtc_by(b) = 4 * (bit_and(bit_shr(b, 1), 1) + 2 * bit_and(bit_shr(b, 3), 1))
fn rtc_bidx(x, y) = (bit_shr(y, 3) * 2 + bit_shr(x, 3)) * 4 + bit_and(bit_shr(y, 2), 1) * 2 + bit_and(bit_shr(x, 2), 1)
## neighbours of the block at (bx, by), block index b, from the macroblock's neighbours mav (6.4.11.4)
fn rtc_tlav(bx, by, mav) =
    if bx > 0 and by > 0 then
        8
    else if bx > 0 then
        (if bit_and(mav, 2) != 0 then 8 else 0)
    else if by > 0 then
        (if bit_and(mav, 1) != 0 then 8 else 0)
    else if bit_and(mav, 8) != 0 then
        8
    else
        0
fn rtc_trav(bx, by, b, mav) =
    if by == 0 then
        (if bx < 12 then (if bit_and(mav, 2) != 0 then 4 else 0) else if bit_and(mav, 4) != 0 then 4 else 0)
    else if bx == 12 then
        0
    else if rtc_bidx(bx + 4, by - 4) < b then
        4
    else
        0
fn rtc_bav(bx, by, b, mav) = (if bx > 0 or bit_and(mav, 1) != 0 then 1 else 0) + (if by > 0 or bit_and(mav, 2) != 0 then 2 else 0) + rtc_tlav(bx, by, mav) + rtc_trav(bx, by, b, mav)
## the Intra4x4 mode of the block on the left / above (255 when it has none), and the predicted mode (8.3.1.1)
fn rtc_nml(c, bx, by, mav) =
    if bx > 0 then
        load8(c + 32 + rtc_bidx(bx - 4, by))
    else if bit_and(mav, 1) == 0 then
        255
    else
        load8(c + 16 + bit_shr(by, 2))
fn rtc_nmt(c, bx, by, mav) =
    if by > 0 then
        load8(c + 32 + rtc_bidx(bx, by - 4))
    else if bit_and(mav, 2) == 0 then
        255
    else
        load8(c + 20 + bit_shr(bx, 2))
fn rtc_pmode(a, b) = if a > 8 or b > 8 then 2 else if a < b then a else b
## a mode is possible when the samples it reads are: 0, 3, 7 the top; 1, 8 the left; 4, 5, 6 top, left and top-left
fn rtc_mok(m, av) =
    if m == 2 then
        1
    else if m == 0 or m == 3 or m == 7 then
        (if bit_and(av, 2) != 0 then 1 else 0)
    else if m == 1 or m == 8 then
        (if bit_and(av, 1) != 0 then 1 else 0)
    else if bit_and(av, 11) == 11 then
        1
    else
        0
## context words at x: 0 rec, 8 block offset in rec, 16 rs, 24 source block address, 32 ss, 40 neighbours, 48 predicted
## mode, 56 lambda, 64 best cost, 72 best mode, 80 cfg data, 88 source macroblock address, 96 ri, 104 mav, 112 qp,
## 120 error, 128 summed cost
fn rtc_cp16(a, b) = let p = store64(b, load64(a)) in store64(b + 8, load64(a + 8))
## diagonal modes of an interior block: the edge line (rtc_edge) is made once per block (x + 136 = 1 when made), and
## each sample is one byte of it at the offset the table gives (scratch 3968 + 16 * (mode - 3) + i, built once from
## the same formulas as rtc_dv; 4064 = 1 once built)
fn rtc_dvo(mode, x, y) =
    if mode == 3 then
        22 + x + y
    else if mode == 4 then
        20 + x - y
    else if mode == 5 then
        rtc_ovr(x, y)
    else if mode == 6 then
        rtc_ohd(x, y)
    else if mode == 7 then
        (if bit_and(y, 1) == 0 then 37 + x + bit_shr(y, 1) else 22 + x + bit_shr(y, 1))
    else
        rtc_ohu(x, y)
fn rtc_ovr(x, y) =
    let z = 2 * x - y in
    if z >= 0 and bit_and(z, 1) == 0 then
        36 + x - bit_shr(y, 1)
    else if z >= 0 then
        20 + x - bit_shr(y, 1)
    else if z == 0 - 1 then
        20
    else
        21 - y
fn rtc_ohd(x, y) =
    let z = 2 * y - x in
    if z >= 0 and bit_and(z, 1) == 0 then
        35 - y + bit_shr(x, 1)
    else if z >= 0 then
        20 - y + bit_shr(x, 1)
    else if z == 0 - 1 then
        20
    else
        19 + x
fn rtc_ohu(x, y) =
    let z = x + 2 * y in
    if z > 5 then
        1
    else if z == 5 then
        16
    else if bit_and(z, 1) == 0 then
        34 - y - bit_shr(x, 1)
    else
        18 - y - bit_shr(x, 1)
fn rtc_otab(tb, k) =
    if k >= 96 then
        0
    else
        let w = store8(tb + k, rtc_dvo(3 + bit_shr(k, 4), bit_and(k, 3), bit_and(bit_shr(k, 2), 3))) in
        rtc_otab(tb, k + 1)
fn rtc_tab() =
    let s = sym_addr("__rtc_scratch") in
    if load64(s + 4064) == 1 then
        s + 3968
    else
        let a = rtc_otab(s + 3968, 0) in
        let b = store64(s + 4064, 1) in
        s + 3968
fn rtc_dfast(t, d, tb, i) =
    if i >= 16 then
        0
    else
        let w = store8(d + i, load8(t + load8(tb + i))) in
        rtc_dfast(t, d, tb, i + 1)
fn rtc_pred(x, m, s) =
    if m >= 3 and load64(x + 136) == 1 then
        let z = rtc_dfast(sym_addr("__rtc_scratch") + 3912, s, rtc_tab() + 16 * (m - 3), 0) in
        mkint(0)
    else
        rtc_i4p(load64(x), load64(x + 8), load64(x + 16), m * 16 + load64(x + 40), s)
fn rtc_try(x, m) =
    let s = x - 256 in
    let r = rtc_pred(x, m, s) in
    if r == mkint(0 - 1) then
        0
    else
        let c = rts_satd4(load64(x + 24), load64(x + 32), s, 4) + load64(x + 56) * (if m == load64(x + 48) then 1 else 4) in
        if c < load64(x + 64) then
            let a = store64(x + 64, c) in
            let b = store64(x + 72, m) in
            rtc_cp16(s, s + 16)
        else
            0
## an untried mode m' >= m costs at least lambda (when it is the predicted one) or 4 lambda: once the best cost is at
## that floor no later mode can win (a tie keeps the lower mode), so the search stops with the same decision
fn rtc_floor(x, m) =
    let lam = load64(x + 56) in
    let bc = load64(x + 64) in
    if bc <= lam then
        1
    else if load64(x + 48) < m and bc <= 4 * lam then
        1
    else
        0
fn rtc_srch(x, m) =
    if m > 8 or rtc_floor(x, m) == 1 then
        0
    else
        let z = if rtc_mok(m, load64(x + 40)) == 1 then rtc_try(x, m) else 0 in
        rtc_srch(x, m + 1)
## reconstruct into the frame: clip(prediction + residual), rows fs apart
fn rtc_recf(p, r, d, fs, i) = vec_rec4(p, r, d, fs)
## the zigzag copy: two bytes per level, the scan positions as straight-line code
fn rtc_mv2(lev, i, o, k) =
    let a = store8(o + k * 2, load8(lev + i * 2)) in
    store8(o + k * 2 + 1, load8(lev + i * 2 + 1))
fn rtc_zzout(lev, o, k) =
    let a0 = rtc_mv2(lev, 0, o, 0) in
    let a1 = rtc_mv2(lev, 1, o, 1) in
    let a2 = rtc_mv2(lev, 4, o, 2) in
    let a3 = rtc_mv2(lev, 8, o, 3) in
    let a4 = rtc_mv2(lev, 5, o, 4) in
    let a5 = rtc_mv2(lev, 2, o, 5) in
    let a6 = rtc_mv2(lev, 3, o, 6) in
    let a7 = rtc_mv2(lev, 6, o, 7) in
    let a8 = rtc_mv2(lev, 9, o, 8) in
    let a9 = rtc_mv2(lev, 12, o, 9) in
    let b0 = rtc_mv2(lev, 13, o, 10) in
    let b1 = rtc_mv2(lev, 10, o, 11) in
    let b2 = rtc_mv2(lev, 7, o, 12) in
    let b3 = rtc_mv2(lev, 11, o, 13) in
    let b4 = rtc_mv2(lev, 14, o, 14) in
    rtc_mv2(lev, 15, o, 15)
## dequantization: the low 16 bits of (z V) << qp / 6 (vec_dequant4), V by position class
fn rtc_dqf(src, dst, qp) =
    let q = qp % 6 in
    let vp = sym_addr("__rtc_scratch") + 3632 in
    let a = rtc_wvec(vp, rtc_v(q, 0), rtc_v(q, 1), rtc_v(q, 2)) in
    vec_dequant4(src, dst, vp, qp / 6)
## without a nonzero level the reconstruction is the prediction (4 rows of 4 bytes); else dequantize, inverse
## transform and add
fn rtc_cpf(p, d, fs) =
    let a = store32(d, load32(p)) in
    let b = store32(d + fs, load32(p + 4)) in
    let c = store32(d + 2 * fs, load32(p + 8)) in
    store32(d + 3 * fs, load32(p + 12))
fn rtc_recon_blk(s, d, fs, qp) =
    let a3 = rtc_dqf(s + 96, s + 128, qp) in
    let t = vec_idct4(s + 128, s + 160) in
    rtc_recf(s + 16, s + 160, d, fs, 0)
## residual, transform, quantization, reconstruction and the outputs of block b (its best prediction is at s + 16)
fn rtc_enc(x, b) =
    let s = x - 256 in
    let c = load64(x + 80) in
    let qp = load64(x + 112) in
    let m = load64(x + 72) in
    let a1 = rtc_sub(load64(x + 24), load64(x + 32), s + 16, s + 32, 0) in
    let a2 = vec_fdct4(s + 32, s + 64) in
    let nz = rtc_q4(s + 64, s + 96, qp, 1) in
    let rf = load64(x) in
    let a4 = if nz == 0 then rtc_cpf(s + 16, rf + 8 + load64(x + 8), load64(x + 16)) else rtc_recon_blk(s, rf + 8 + load64(x + 8), load64(x + 16), qp) in
    let a5 = store8(c + 32 + b, m) in
    let a6 = store8(c + 48 + b, nz) in
    let a7 = rtc_zzout(s + 96, c + 64 + b * 32, 0) in
    let pm = load64(x + 48) in
    store8(c + 576 + b, if m == pm then 255 else if m < pm then m else m - 1)
fn rtc_blk(x, b) =
    let c = load64(x + 80) in
    let mav = load64(x + 104) in
    let bx = rtc_bx(b) in
    let by = rtc_by(b) in
    let a1 = store64(x + 8, load64(x + 96) + by * load64(x + 16) + bx) in
    let a2 = store64(x + 24, load64(x + 88) + by * load64(x + 32) + bx) in
    let a3 = store64(x + 40, rtc_bav(bx, by, b, mav)) in
    let a7 = rtc_edge1(x) in
    let a4 = store64(x + 48, rtc_pmode(rtc_nml(c, bx, by, mav), rtc_nmt(c, bx, by, mav))) in
    let a5 = store64(x + 64, 1099511627776) in
    let a6 = store64(x + 72, 0) in
    let z = rtc_srch(x, 0) in
    if load64(x + 64) == 1099511627776 then
        store64(x + 120, 1)
    else
        let e = rtc_enc(x, b) in
        store64(x + 128, load64(x + 128) + load64(x + 64))
## an interior block (a row above, a column on the left, all inside rec) gets its edge line once
fn rtc_edge1(x) =
    let f = load64(x) in
    let fi = load64(x + 8) in
    let fs = load64(x + 16) in
    if fi >= fs + 1 and rtc_fits(f, fi - fs - 1, 4 * fs + 9) == 1 then
        let e = rtc_edge(sym_addr("__rtc_scratch") + 3912, f + 8 + fi, fs, load64(x + 40)) in
        store64(x + 136, 1)
    else
        store64(x + 136, 0)
fn rtc_mbloop(x, b) = if b >= 16 or load64(x + 120) != 0 then 0 else let z = rtc_blk(x, b) in rtc_mbloop(x, b + 1)
## --- one whole inter (P, 16x16) macroblock -------------------------------------------------------------------------------
## buf_h264_mb_p(src, si, ss, ref, rec, cfg): the luma macroblock at src + si (rows ss apart) coded against the
## reference picture ref with one motion vector: the quarter-sample prediction (8.4.2.2.1, as buf_h264_luma_mc) goes to
## cfg bytes 640..895 (16 x 16), then each 4x4 block (luma4x4BlkIdx order) is subtracted, transformed, quantized with
## the inter rounding, dequantized, inverse transformed and reconstructed into rec. ref and rec hold their luma plane
## at offset 0, rows cfg.rs apart. cfg (at least 896 bytes, int32 little endian): in rs (0), qp (4), picture width (8)
## and height (12), the macroblock's top-left sample x (16) and y (20), the vector mvx (24) and mvy (28) in quarter
## samples (signed); out the nonzero levels per block (32..47), the zigzag levels as int16 (64 + 32 x block) and the
## luma coded_block_pattern (int32 at 576, bit k for 8x8 quadrant k). Answers the total of nonzero levels (0: nothing
## to code, a P_Skip candidate when the vector is the predicted one), or -1 on a wrong argument.
fn rtc_s32(v) = if v >= 2147483648 then v - 4294967296 else v
## the 4x4 block (bx, by) of the 16-stride prediction into 16 contiguous bytes at d
fn rtc_pblk(p, d) =
    let a = store32(d, load32(p)) in
    let b = store32(d + 4, load32(p + 16)) in
    let c = store32(d + 8, load32(p + 32)) in
    store32(d + 12, load32(p + 48))
## context words at x (scratch 256): 0 rec, 8 block offset in rec, 16 rs, 24 source block address, 32 ss, 80 cfg data,
## 88 source macroblock address, 96 macroblock offset in rec, 112 qp, 128 total levels, 136 cbp
fn rtc_pencb(x, b) =
    let s = x - 256 in
    let c = load64(x + 80) in
    let qp = load64(x + 112) in
    let bx = rtc_bx(b) in
    let by = rtc_by(b) in
    let a0 = store64(x + 8, load64(x + 96) + by * load64(x + 16) + bx) in
    let a1 = rtc_pblk(c + 640 + by * 16 + bx, s + 16) in
    let a2 = rtc_sub(load64(x + 88) + by * load64(x + 32) + bx, load64(x + 32), s + 16, s + 32, 0) in
    let a3 = vec_fdct4(s + 32, s + 64) in
    let nz = rtc_q4(s + 64, s + 96, qp, 0) in
    let rf = load64(x) in
    let a4 = if nz == 0 then rtc_cpf(s + 16, rf + 8 + load64(x + 8), load64(x + 16)) else rtc_recon_blk(s, rf + 8 + load64(x + 8), load64(x + 16), qp) in
    let a5 = store8(c + 32 + b, nz) in
    let a6 = rtc_zzout(s + 96, c + 64 + b * 32, 0) in
    let a7 = store64(x + 128, load64(x + 128) + nz) in
    store64(x + 136, bit_or(load64(x + 136), if nz == 0 then 0 else bit_shl(1, bit_shr(b, 2))))
fn rtc_ploop(x, b) = if b >= 16 then 0 else let z = rtc_pencb(x, b) in rtc_ploop(x, b + 1)
fn buf_h264_mb_p(src, si, ss, ref, rec, cfg) = rtc_mbp(src, rt_int(si), rt_int(ss), ref, rec, cfg)
fn rtc_mbp(src, si, ss, ref, rec, cfg) =
    if rtc_fits(cfg, 0, 896) == 0 then
        mkint(0 - 1)
    else
        let c = cfg + 8 in
        let rs = load32(c) in
        let qp = load32(c + 4) in
        let pw = load32(c + 8) in
        let ph = load32(c + 12) in
        let mx = load32(c + 16) in
        let my = load32(c + 20) in
