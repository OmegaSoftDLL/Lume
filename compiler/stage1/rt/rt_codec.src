            let a2 = store64(x + 8, ri) in
            let a3 = store64(x + 16, rs) in
            let a4 = store64(x + 24, src + 8 + si) in
            let a5 = store64(x + 32, ss) in
            let a6 = store64(x + 40, bit_and(load32(c + 12), 11)) in
            let a7 = store64(x + 64, 1099511627776) in
            let a8 = store64(x + 72, 0) in
            let a9 = store64(x + 80, c) in
            let b0 = store64(x + 112, qp) in
            let z = rtc_i16srch(x, 0) in
            if load64(x + 64) == 1099511627776 then
                mkint(0 - 1)
            else
                let m = store32(c + 16, load64(x + 72)) in
                if bit_and(load32(c + 8), 1) != 0 then
                    mkint(load64(x + 64))
                else
                    rtc_mbi16b(x, c)
fn rtc_mbi16b(x, c) =
    let s = x - 256 in
    let qp = load64(x + 112) in
    let qb = 15 + qp / 6 in
    let w = rtc_i16ws(x, 0) in
    let l = rtc_dcload(s, 0) in
    let h = rtc_had16(s + 1920) in
    let q = rtc_dcq(s, 0, rtc_mf(qp % 6, 0), 2 * (bit_shl(1, qb) / 3), qb + 1) in
    let nd = rtc_wnz(s, 2048, 0, 0) in
    let na = rtc_wnz(s, 1792, 0, 0) in
    let o1 = store32(c + 20, nd) in
    let o2 = rtc_dcout(s, c, 0) in
    let o3 = rtc_acout(s, c, 0) in
    let o4 = store32(c + 608, if na > 0 then 15 else 0) in
