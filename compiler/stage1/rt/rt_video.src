## rt_video.src -- colour conversion between BGRA frames (screen capture: 4 bytes per pixel, B G R A, top-down rows of
## `stride` bytes) and I420 (planar YUV 4:2:0, the input of H.264 / VP8 / AV1 encoders: the Y plane w * h bytes, then
## U and V of ((w + 1) / 2) * ((h + 1) / 2) bytes each), ITU-R BT.601 limited range in fixed point (the integer formulas
## of the video literature, 8 fractional bits). Runtime routines written in Lume (the golden rule), compiled by
## `lumec --raw`, so a 1080p frame is a few milliseconds instead of a Lume loop of buf_get / buf_set per pixel.
##   buf_bgra_to_i420(src, stride, w, h, dst) -> the bytes written (w * h + 2 * cw * ch), or -1 when an argument is
##       wrong (not a buffer, w or h outside 1..65535, stride < 4 * w, a buffer too short); chroma is the average of each
##       2x2 block (the last column / row repeats when w / h is odd)
##   buf_i420_to_bgra(src, w, h, dst, stride) -> the bytes of the image written (stride * (h - 1) + 4 * w), or -1; alpha is 255
## Only `load8` / `store8` touch the buffers, after the size checks: no pixel is read or written out of bounds.

fn rtv_isbuf(b) = if b == 0 or bit_and(b, 7) != 0 then 0 else if load8(b) != 15 then 0 else 1
fn rtv_len(b) = bit_shr(load64(b), 8)

## --- BGRA -> I420 -------------------------------------------------------------------------------------------------
## Y = ((66 R + 129 G + 25 B + 128) >> 8) + 16 (= (... + 4224) >> 8), one row: sp the first pixel, yp the first Y
## byte, se the end of the row; few live values, so they stay in registers
fn rtv_yrow(sp, yp, se) =
    if sp >= se then
        0
    else
        let a = load8(sp) * 25 in
        let b = load8(sp + 1) * 129 in
        let a2 = a + b in
        let b2 = load8(sp + 2) * 66 in
        let a3 = a2 + b2 in
        let z = store8(yp, bit_shr(a3 + 4224, 8)) in
        rtv_yrow(sp + 4, yp + 1, se)
fn rtv_y(src, s, y, ww, r, hh) =
    if r >= hh then
        0
    else
        let sp = src + 8 + r * s in
        let z = rtv_yrow(sp, y + r * ww, sp + 4 * ww) in
        rtv_y(src, s, y, ww, r + 1, hh)
## U = ((-38 R - 74 G + 112 B + 128) >> 8) + 128, V = ((112 R - 94 G - 18 B + 128) >> 8) + 128 on the 2x2 average;
## p0 the block's top-left pixel, ds the offset of the row below (0 on an odd last row), up the U byte, k = V - U
fn rtv_crow(p0, ds, up, k, i, ww) =
    if 2 * i >= ww then
        0
    else
        let dx = if 2 * i + 1 < ww then 4 else 0 in
        let p1 = p0 + ds in
        let b = bit_shr(load8(p0) + load8(p0 + dx) + load8(p1) + load8(p1 + dx) + 2, 2) in
        let g = bit_shr(load8(p0 + 1) + load8(p0 + dx + 1) + load8(p1 + 1) + load8(p1 + dx + 1) + 2, 2) in
        let r = bit_shr(load8(p0 + 2) + load8(p0 + dx + 2) + load8(p1 + 2) + load8(p1 + dx + 2) + 2, 2) in
        let zu = store8(up, bit_shr(112 * b - 74 * g - 38 * r + 32896, 8)) in
        let zv = store8(up + k, bit_shr(112 * r - 94 * g - 18 * b + 32896, 8)) in
        rtv_crow(p0 + 8, ds, up + 1, k, i + 1, ww)
## chroma row j; dims = w * 65536 + h (six parameters at most in --raw)
fn rtv_c(src, s, u, k, j, dims) =
    let ww = bit_shr(dims, 16) in
    let hh = bit_and(dims, 65535) in
    if 2 * j >= hh then
        0
    else
        let ds = if 2 * j + 1 < hh then s else 0 in
        let z = rtv_crow(src + 8 + 2 * j * s, ds, u + j * bit_shr(ww + 1, 1), k, 0, ww) in
        rtv_c(src, s, u, k, j + 1, dims)
fn buf_bgra_to_i420(src, stride, w, h, dst) =
    let s = rt_int(stride) in
    let ww = rt_int(w) in
    let hh = rt_int(h) in
    rtv_b2i(src, s, ww, hh, dst)
fn rtv_b2i(src, s, ww, hh, dst) =
    let cw = bit_shr(ww + 1, 1) in
    let ch = bit_shr(hh + 1, 1) in
    let need = ww * hh + 2 * cw * ch in
    if rtv_isbuf(src) == 0 or rtv_isbuf(dst) == 0 or ww <= 0 or hh <= 0 or ww > 65535 or hh > 65535 or s < 4 * ww then
        mkint(0 - 1)
    else if rtv_len(src) < s * (hh - 1) + 4 * ww or rtv_len(dst) < need then
        mkint(0 - 1)
    else
        let y = dst + 8 in
        let z1 = rtv_y(src, s, y, ww, 0, hh) in
        let z2 = rtv_c(src, s, y + ww * hh, cw * ch, 0, ww * 65536 + hh) in
        mkint(need)

## buf_bgra_to_i420_rows(src, stride, w, h, dst, r0, r1): the same conversion for the rows r0 .. r1 - 1 only (r0
## even, r1 even or h), written where the whole conversion puts them (Y rows r0.., chroma rows r0 / 2..), so the
## workers of a pool can each convert their own band of one frame into one shared I420 buffer. Answers the bytes
## written, or -1 (the checks of buf_bgra_to_i420, and 0 <= r0 < r1 <= h, r0 odd, r1 odd and not h)
fn buf_bgra_to_i420_rows(src, stride, w, h, dst, r0, r1) = rtv_b2ir(src, rt_int(stride), rt_int(w), rt_int(h), dst, rt_int(r0), rt_int(r1))
fn rtv_b2ir(src, s, ww, hh, dst, r0, r1) =
    let cw = bit_shr(ww + 1, 1) in
    let ch = bit_shr(hh + 1, 1) in
    if rtv_isbuf(src) == 0 or rtv_isbuf(dst) == 0 or ww <= 0 or hh <= 0 or ww > 65535 or hh > 65535 or s < 4 * ww or r0 < 0 or r1 > hh or r0 >= r1 or bit_and(r0, 1) == 1 or (bit_and(r1, 1) == 1 and r1 != hh) then
        mkint(0 - 1)
    else if rtv_len(src) < s * (hh - 1) + 4 * ww or rtv_len(dst) < ww * hh + 2 * cw * ch then
        mkint(0 - 1)
    else
        let y = dst + 8 in
        let z1 = rtv_y(src, s, y, ww, r0, r1) in
        let z2 = rtv_c2(src, s, y + ww * hh, cw * ch, bit_shr(r0, 1), ww * 65536 + hh, bit_shr(r1 + 1, 1)) in
        mkint(ww * (r1 - r0) + 2 * cw * (bit_shr(r1 + 1, 1) - bit_shr(r0, 1)))
## chroma rows j .. je - 1 (as rtv_c, which runs to the last row)
fn rtv_c2(src, s, u, k, j, dims, je) =
    let ww = bit_shr(dims, 16) in
    let hh = bit_and(dims, 65535) in
    if j >= je then
        0
    else
        let ds = if 2 * j + 1 < hh then s else 0 in
        let z = rtv_crow(src + 8 + 2 * j * s, ds, u + j * bit_shr(ww + 1, 1), k, 0, ww) in
        rtv_c2(src, s, u, k, j + 1, dims, je)

## --- I420 -> BGRA -------------------------------------------------------------------------------------------------
## C = Y - 16, D = U - 128, E = V - 128; B = (298 C + 516 D + 128) >> 8, G = (298 C - 100 D - 208 E + 128) >> 8,
## R = (298 C + 409 E + 128) >> 8, each clipped to 0..255; one row: up advances after every odd column. cc folds
## 298 * -16 + 128 and the +65536 that keeps the shift on a non-negative word (taken back as -256); no calls per pixel
fn rtv_irow(yp, up, k, dp, c, ww) =
    if c >= ww then
        0
    else
        let cc = 298 * load8(yp) + 60896 in
        let d = load8(up) - 128 in
        let e = load8(up + k) - 128 in
        let xb = bit_shr(cc + 516 * d, 8) - 256 in
        let zb = store8(dp, if xb < 0 then 0 else if xb > 255 then 255 else xb) in
        let xg = bit_shr(cc - 100 * d - 208 * e, 8) - 256 in
        let zg = store8(dp + 1, if xg < 0 then 0 else if xg > 255 then 255 else xg) in
        let xr = bit_shr(cc + 409 * e, 8) - 256 in
        let zr = store8(dp + 2, if xr < 0 then 0 else if xr > 255 then 255 else xr) in
        let za = store8(dp + 3, 255) in
        rtv_irow(yp + 1, up + bit_and(c, 1), k, dp + 4, c + 1, ww)
## row r; rd = r * 2^32 + w * 65536 + h
fn rtv_i(yp, up, k, dp, s, rd) =
    let r = bit_shr(rd, 32) in
    let ww = bit_and(bit_shr(rd, 16), 65535) in
    let hh = bit_and(rd, 65535) in
    if r >= hh then
        0
    else
        let z = rtv_irow(yp, up, k, dp, 0, ww) in
        rtv_i(yp + ww, up + (if bit_and(r, 1) == 1 then bit_shr(ww + 1, 1) else 0), k, dp + s, s, rd + 4294967296)
fn buf_i420_to_bgra(src, w, h, dst, stride) =
    let ww = rt_int(w) in
    let hh = rt_int(h) in
    let s = rt_int(stride) in
    rtv_i2b(src, ww, hh, dst, s)
fn rtv_i2b(src, ww, hh, dst, s) =
    let cw = bit_shr(ww + 1, 1) in
    let ch = bit_shr(hh + 1, 1) in
    if rtv_isbuf(src) == 0 or rtv_isbuf(dst) == 0 or ww <= 0 or hh <= 0 or ww > 65535 or hh > 65535 or s < 4 * ww then
        mkint(0 - 1)
    else if rtv_len(src) < ww * hh + 2 * cw * ch or rtv_len(dst) < s * (hh - 1) + 4 * ww then
        mkint(0 - 1)
    else
        let y = src + 8 in
        let z = rtv_i(y, y + ww * hh, cw * ch, dst + 8, s, ww * 65536 + hh) in
        mkint(s * (hh - 1) + 4 * ww)
