## rt_simd.src -- runtime routines that use the SSE2 vector intrinsics of --raw (vec_sad16, vec_sad8, vec_satd4). They live in
## the optional part of the runtime (rt_lume_crypto in runtime_lume.lume): a program links it only when it names one
## of these builtins, so the frozen seed assembler, which knows no vector instruction, never meets them.

## --- block distortion for encoders (motion and mode search) ------------------------------------------------------
## buf_sad16x16 / buf_sad8x8 / buf_sad4x4 (a, ai, as, b, bi, bs) -> the sum of absolute differences between the n x n
##     block of a at byte ai (rows sa bytes apart) and the block of b at bi (rows bs apart); -1 when an argument is
##     wrong (not a buffer, a negative offset, a stride smaller than n, a block that does not fit)
## buf_satd4x4 / buf_satd16x16 (same arguments) -> the Hadamard-transformed difference, sum |H D H| / 2 per 4x4 block
##     (the x264 / JM convention; 16x16 is the sum of its sixteen 4x4 blocks)
## One bounds check per block, then load8 only inside it. The stride and the block size travel packed (s * 64 + n):
## --raw takes six parameters at most.
fn rts_pack(s, n) = if s < 0 or s > 1099511627776 then 0 else s * 64 + n
fn rts_ok(b, o, s, n) =
    if rtv_isbuf(b) == 0 or o < 0 or s < n then
        0
    else if o > rtv_len(b) then
        0
    else if o + (n - 1) * s + n <= rtv_len(b) then
        1
    else
        0
fn rts_abs(x) = if x < 0 then 0 - x else x
## one row: psadbw on 16 or 8 bytes, byte by byte for 4
fn rts_sad_row(pa, pb, i, n, acc) =
    if n == 16 then
        vec_sad16(pa, pb)
    else if n == 8 then
        vec_sad8(pa, pb)
    else
        rts_sad4(pa, pb, i, n, acc)
fn rts_sad4(pa, pb, i, n, acc) =
    if i >= n then
        acc
    else
        let d = load8(pa + i) - load8(pb + i) in
        rts_sad4(pa, pb, i + 1, n, acc + rts_abs(d))
fn rts_sad_rows(pa, sa, pb, bs, rn, acc) =
    if rn < 64 then
        acc
    else
        let r = rts_sad_row(pa, pb, 0, bit_and(rn, 63), 0) in
        rts_sad_rows(pa + sa, sa, pb + bs, bs, rn - 64, acc + r)
fn rts_sad_go(a, ao, sa, b, bo, bsn) =
    let bs = bit_shr(bsn, 6) in
    let n = bit_and(bsn, 63) in
    if rts_ok(a, ao, sa, n) == 0 or rts_ok(b, bo, bs, n) == 0 then
        mkint(0 - 1)
    else if n == 4 then
        mkint(vec_sad4(a + 8 + ao, sa, b + 8 + bo, bs))
    else
        mkint(rts_sad_rows(a + 8 + ao, sa, b + 8 + bo, bs, n * 64 + n, 0))
fn buf_sad16x16(a, ai, sa, b, bi, bs) = rts_sad_go(a, rt_int(ai), rt_int(sa), b, rt_int(bi), rts_pack(rt_int(bs), 16))
fn buf_sad8x8(a, ai, sa, b, bi, bs) = rts_sad_go(a, rt_int(ai), rt_int(sa), b, rt_int(bi), rts_pack(rt_int(bs), 8))
fn buf_sad4x4(a, ai, sa, b, bi, bs) = rts_sad_go(a, rt_int(ai), rt_int(sa), b, rt_int(bi), rts_pack(rt_int(bs), 4))
## 4x4 Hadamard through vec_satd4 (SSE2), which returns 4 * sum |coefficient|: SATD = sum / 2 = that >> 3
fn rts_satd4(pa, sa, pb, sb) = bit_shr(vec_satd4(pa, sa, pb, sb), 3)
fn rts_satd_blocks(pa, sa, pb, sb, k, acc) =
    if k >= 16 then
        acc
    else
        let x = bit_and(k, 3) * 4 in
        let y = bit_shr(k, 2) * 4 in
        rts_satd_blocks(pa, sa, pb, sb, k + 1, acc + rts_satd4(pa + y * sa + x, sa, pb + y * sb + x, sb))
fn rts_satd_go(a, ao, sa, b, bo, bsn) =
    let bs = bit_shr(bsn, 6) in
    let n = bit_and(bsn, 63) in
    if rts_ok(a, ao, sa, n) == 0 or rts_ok(b, bo, bs, n) == 0 then
        mkint(0 - 1)
    else if n == 4 then
        mkint(rts_satd4(a + 8 + ao, sa, b + 8 + bo, bs))
    else
        mkint(rts_satd_blocks(a + 8 + ao, sa, b + 8 + bo, bs, 0, 0))
fn buf_satd4x4(a, ai, sa, b, bi, bs) = rts_satd_go(a, rt_int(ai), rt_int(sa), b, rt_int(bi), rts_pack(rt_int(bs), 4))
fn buf_satd16x16(a, ai, sa, b, bi, bs) = rts_satd_go(a, rt_int(ai), rt_int(sa), b, rt_int(bi), rts_pack(rt_int(bs), 16))
