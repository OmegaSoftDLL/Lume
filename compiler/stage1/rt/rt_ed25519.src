## rt_ed25519.src -- the point arithmetic of Ed25519 (RFC 8032) as runtime routines written in Lume (the golden rule:
## the runtime is Lume source), compiled by `lumec --raw`; the field is rt_x25519.src's (xf_*, ten limbs in memory).
## lcrypto_tls keeps SHA-512 and the scalars mod L in Lume and calls:
##   crypto_ed25519_base(s32) -> the packed point [s]B (32 bytes): public keys and R of a signature; constant time
##   crypto_ed25519_vpt(pk32, k32, s32) -> the packed point [s]B + [k](-A) for the public key A = pk (variable time:
##   every input is public), or "" when pk is not a point. A signature (R, S) is valid when this equals R.
## Points are extended coordinates (X : Y : Z : T), x = X/Z, y = Y/Z, xy = T/Z: four field elements, 320 bytes.
## Decoding follows the list implementation (lct_pt_unpack_neg) exactly, so both accept the same keys.

fn ep_x(p) = p
fn ep_y(p) = p + 80
fn ep_z(p) = p + 160
fn ep_t(p) = p + 240
fn ep_ident(p) =
    let a = xf_small(ep_x(p), 0, 0) in
    let b = xf_small(ep_y(p), 1, 0) in
    let c = xf_small(ep_z(p), 1, 0) in
    xf_small(ep_t(p), 0, 0)
fn ep_copy(d, s) =
    let a = xf_copy(ep_x(d), ep_x(s), 0) in
    let b = xf_copy(ep_y(d), ep_y(s), 0) in
    let c = xf_copy(ep_z(d), ep_z(s), 0) in
    xf_copy(ep_t(d), ep_t(s), 0)
fn ep_cswap(p, q, b) =
    let a = xf_cswap(ep_x(p), ep_x(q), b, 0) in
    let c = xf_cswap(ep_y(p), ep_y(q), b, 0) in
    let d = xf_cswap(ep_z(p), ep_z(q), b, 0) in
    xf_cswap(ep_t(p), ep_t(q), b, 0)
## r = p + q with the complete formula for a = -1 (add-2008-hwcd-3, k = 2d at s + 800): valid for doubling, any alias
## of r, p and q; s is scratch for ten field elements plus the constant
fn es(s, k) = s + 80 * k
fn ep_add(r, p, q, s) =
    let a1 = xf_sub(es(s, 0), ep_y(p), ep_x(p), 0) in
    let a2 = xf_sub(es(s, 1), ep_y(q), ep_x(q), 0) in
    let a3 = xf_mul(es(s, 2), es(s, 0), es(s, 1)) in
    let b1 = xf_add(es(s, 0), ep_y(p), ep_x(p), 0) in
    let b2 = xf_add(es(s, 1), ep_y(q), ep_x(q), 0) in
    let b3 = xf_mul(es(s, 3), es(s, 0), es(s, 1)) in
    let c1 = xf_mul(es(s, 4), ep_t(p), es(s, 10)) in
    let c2 = xf_mul(es(s, 4), es(s, 4), ep_t(q)) in
    let d1 = xf_mul(es(s, 5), ep_z(p), ep_z(q)) in
    let d2 = xf_add(es(s, 5), es(s, 5), es(s, 5), 0) in
    let e1 = xf_sub(es(s, 6), es(s, 3), es(s, 2), 0) in
    let f1 = xf_sub(es(s, 7), es(s, 5), es(s, 4), 0) in
    let g1 = xf_add(es(s, 8), es(s, 5), es(s, 4), 0) in
    let h1 = xf_add(es(s, 9), es(s, 3), es(s, 2), 0) in
    let x3 = xf_mul(ep_x(r), es(s, 6), es(s, 7)) in
    let y3 = xf_mul(ep_y(r), es(s, 8), es(s, 9)) in
    let t3 = xf_mul(ep_t(r), es(s, 6), es(s, 9)) in
    xf_mul(ep_z(r), es(s, 7), es(s, 8))
## bit i of the 32-byte little-endian scalar at a
fn es_bit(a, i) = bit_and(bit_shr(load8(a + i / 8), i % 8), 1)
## [scalar]P by the Montgomery ladder (r0 = [n]P, r1 = [n + 1]P, masked swaps): constant time
fn ep_ladder(r0, r1, a, i, s) =
    if i < 0 then
        0
    else
        let b = es_bit(a, i) in
        let c1 = ep_cswap(r0, r1, b) in
        let c2 = ep_add(r1, r0, r1, s) in
        let c3 = ep_add(r0, r0, r0, s) in
        let c4 = ep_cswap(r0, r1, b) in
        ep_ladder(r0, r1, a, i - 1, s)
## [s]B + [k](-A) in one pass (Shamir), variable time (public inputs), into the point at w: B at w + 640, -A at
## w + 960, B - A at w + 1280, the scalars at w + 3300 (s) and w + 3340 (k)
fn ep_two_go(w, i) =
    if i < 0 then
        0
    else
        let d = ep_add(w, w, w, w + 1600) in
        let sb = es_bit(w + 3300, i) in
        let kb = es_bit(w + 3340, i) in
        let a = if sb == 1 and kb == 1 then ep_add(w, w, w + 1280, w + 1600) else if sb == 1 then ep_add(w, w, w + 640, w + 1600) else if kb == 1 then ep_add(w, w, w + 960, w + 1600) else 0 in
        ep_two_go(w, i - 1)

## field helpers on top of xf_*: z^((p - 5) / 8) = z^(2^252 - 3) (bits 251 .. 0, all ones but bit 1); equality and parity
## through the canonical bytes (xf_to canonicalizes its argument in place; the value is unchanged)
fn ef_p2523_go(o, z, i) =
    if i < 0 then
        0
    else
        let a = xf_mul(o, o, o) in
        let b = if i == 1 then 0 else xf_mul(o, o, z) in
        ef_p2523_go(o, z, i - 1)
fn ef_p2523(o, z) = let a = xf_small(o, 1, 0) in ef_p2523_go(o, z, 251)
fn eb_eq(a, b, i) = if i >= 32 then 1 else if load8(a + i) != load8(b + i) then 0 else eb_eq(a, b, i + 1)
## 1 when the field elements f and g are equal mod p (b1, b2: 32-byte scratch)
fn ef_eq(f, g, b1, b2) = let x = xf_to(b1, f) in let y = xf_to(b2, g) in eb_eq(b1, b2, 0)
fn ef_parity(f, b1) = let x = xf_to(b1, f) in bit_and(load8(b1), 1)
fn ef_neg(h, f, z) = let a = xf_small(z, 0, 0) in xf_sub(h, z, f, 0)

## the workspace w: points r0 = 0, r1 = 320, B = 640, -A = 960, B - A = 1280; scratch 1600 .. 2480 (with 2d at
## 1600 + 800); field elements 2480 .. 3280 (es(w + 2480, k)); bytes: scalar s 3300, scalar k 3340, input point 3380
## (zero-padded to 40), output 3424, scratch bytes 3460 and 3500
fn ew_f(w, k) = w + 2480 + 80 * k
fn ew_init(w) = let z = xb_zero(w, 0, 3560) in ed_kd2(w + 1600 + 800)
fn ep_base(p) =
    let a = ed_kbx(ep_x(p)) in
    let b = ed_kby(ep_y(p)) in
    let c = xf_small(ep_z(p), 1, 0) in
    xf_mul(ep_t(p), ep_x(p), ep_y(p))
## the packed point: y with the parity of x in bit 255, written at o
fn ep_pack(o, p, w) =
    let zi = xf_inv(ew_f(w, 0), ep_z(p)) in
    let x = xf_mul(ew_f(w, 1), ep_x(p), ew_f(w, 0)) in
    let y = xf_mul(ew_f(w, 2), ep_y(p), ew_f(w, 0)) in
    let a = xf_to(o, ew_f(w, 2)) in
    let par = ef_parity(ew_f(w, 1), w + 3460) in
    store8(o + 31, bit_xor(load8(o + 31), par * 128))
## -A from the 32 bytes at w + 3380 into the point at q; 1 when it is a point, else 0 (lct_pt_unpack_neg)
fn ep_unpack_neg(q, w) =
    let y = xf_from(ep_y(q), w + 3380, 0, 0) in
    let one = xf_small(ew_f(w, 0), 1, 0) in
    let y2 = xf_mul(ew_f(w, 1), ep_y(q), ep_y(q)) in
    let num = xf_sub(ew_f(w, 2), ew_f(w, 1), ew_f(w, 0), 0) in
    let kd = ed_kd(ew_f(w, 3)) in
    let dy = xf_mul(ew_f(w, 3), ew_f(w, 1), ew_f(w, 3)) in
    let den = xf_add(ew_f(w, 3), ew_f(w, 0), ew_f(w, 3), 0) in
    let c1 = xf_mul(ew_f(w, 3), ew_f(w, 3), ew_f(w, 0)) in
    ep_unpack2(q, w)
fn ep_unpack2(q, w) =
    let d2 = xf_mul(ew_f(w, 4), ew_f(w, 3), ew_f(w, 3)) in
    let d4 = xf_mul(ew_f(w, 5), ew_f(w, 4), ew_f(w, 4)) in
    let d6 = xf_mul(ew_f(w, 5), ew_f(w, 5), ew_f(w, 4)) in
    let t = xf_mul(ew_f(w, 5), ew_f(w, 5), ew_f(w, 2)) in
    let t2 = xf_mul(ew_f(w, 5), ew_f(w, 5), ew_f(w, 3)) in
    let p = ef_p2523(ew_f(w, 6), ew_f(w, 5)) in
    let x1 = xf_mul(ew_f(w, 6), ew_f(w, 6), ew_f(w, 2)) in
    let x2 = xf_mul(ew_f(w, 6), ew_f(w, 6), ew_f(w, 3)) in
    let x3 = xf_mul(ew_f(w, 6), ew_f(w, 6), ew_f(w, 3)) in
    let x4 = xf_mul(ew_f(w, 6), ew_f(w, 6), ew_f(w, 3)) in
    ep_unpack3(q, w)
## x = t0 num den^3 is at f(6); den at f(3), num at f(2): x * I when x^2 den != num, then the final check and the sign
fn ep_chk(w, xi) =
    let a = xf_mul(ew_f(w, 7), ew_f(w, xi), ew_f(w, xi)) in
    let b = xf_mul(ew_f(w, 7), ew_f(w, 7), ew_f(w, 3)) in
    let c = xf_copy(ew_f(w, 8), ew_f(w, 2), 0) in
    ef_eq(ew_f(w, 7), ew_f(w, 8), w + 3460, w + 3500)
fn ep_unpack3(q, w) =
    let ok1 = ep_chk(w, 6) in
    let fix = if ok1 == 1 then 0 else let ki = ed_ki(ew_f(w, 9)) in xf_mul(ew_f(w, 6), ew_f(w, 6), ew_f(w, 9)) in
    let ok2 = ep_chk(w, 6) in
    if ok2 == 0 then
        0
    else
        let sign = bit_shr(load8(w + 3380 + 31), 7) in
        let par = ef_parity(ew_f(w, 6), w + 3460) in
        let n = if par == sign then ef_neg(ew_f(w, 6), ew_f(w, 6), ew_f(w, 7)) else 0 in
        let cx = xf_copy(ep_x(q), ew_f(w, 6), 0) in
        let cz = xf_small(ep_z(q), 1, 0) in
        let ct = xf_mul(ep_t(q), ep_x(q), ep_y(q)) in
        1

## the entry points (Lume values in, a Lume string out); xs_ok32 and xb_* are rt_x25519.src's
fn crypto_ed25519_base(sv) =
    let w = __lume_alloc_a(3560) in
    let i = ew_init(w) in
    if xs_ok32(sv) == 0 then
        __rt_mkstrn(w + 3424, 32)
    else
        let c = xb_copy(w + 3300, sv + 8, 0, 32) in
        let b = ep_base(w + 640) in
        let r0 = ep_ident(w) in
        let r1 = ep_copy(w + 320, w + 640) in
        let l = ep_ladder(w, w + 320, w + 3300, 255, w + 1600) in
        let o = ep_pack(w + 3424, w, w) in
        __rt_mkstrn(w + 3424, 32)
fn crypto_ed25519_vpt(pk, kv, sv) =
    let w = __lume_alloc_a(3560) in
    let i = ew_init(w) in
    if xs_ok32(pk) == 0 or xs_ok32(kv) == 0 or xs_ok32(sv) == 0 then
        __rt_mkstrn(w, 0)
    else
        let c1 = xb_copy(w + 3380, pk + 8, 0, 32) in
        let c2 = xb_copy(w + 3300, sv + 8, 0, 32) in
        let c3 = xb_copy(w + 3340, kv + 8, 0, 32) in
        let ok = ep_unpack_neg(w + 960, w) in
        if ok == 0 then
            __rt_mkstrn(w, 0)
        else
            let b = ep_base(w + 640) in
            let ba = ep_add(w + 1280, w + 640, w + 960, w + 1600) in
            let r = ep_ident(w) in
            let t = ep_two_go(w, 255) in
            let o = ep_pack(w + 3424, w, w) in
            __rt_mkstrn(w + 3424, 32)

## constants as limbs: d = -121665/121666, 2d, sqrt(-1), and the base point B = (x, 4/5)
fn ed_kd(h) =
    let a0 = xf_set(h, 0, 56195235) in
    let a1 = xf_set(h, 1, 13857412) in
    let a2 = xf_set(h, 2, 51736253) in
    let a3 = xf_set(h, 3, 6949390) in
    let a4 = xf_set(h, 4, 114729) in
    let a5 = xf_set(h, 5, 24766616) in
    let a6 = xf_set(h, 6, 60832955) in
    let a7 = xf_set(h, 7, 30306712) in
    let a8 = xf_set(h, 8, 48412415) in
    let a9 = xf_set(h, 9, 21499315) in
    0
fn ed_kd2(h) =
    let a0 = xf_set(h, 0, 45281625) in
    let a1 = xf_set(h, 1, 27714825) in
    let a2 = xf_set(h, 2, 36363642) in
    let a3 = xf_set(h, 3, 13898781) in
    let a4 = xf_set(h, 4, 229458) in
    let a5 = xf_set(h, 5, 15978800) in
    let a6 = xf_set(h, 6, 54557047) in
    let a7 = xf_set(h, 7, 27058993) in
    let a8 = xf_set(h, 8, 29715967) in
    let a9 = xf_set(h, 9, 9444199) in
    0
fn ed_ki(h) =
    let a0 = xf_set(h, 0, 34513072) in
    let a1 = xf_set(h, 1, 25610706) in
    let a2 = xf_set(h, 2, 9377949) in
    let a3 = xf_set(h, 3, 3500415) in
    let a4 = xf_set(h, 4, 12389472) in
    let a5 = xf_set(h, 5, 33281959) in
    let a6 = xf_set(h, 6, 41962654) in
    let a7 = xf_set(h, 7, 31548777) in
    let a8 = xf_set(h, 8, 326685) in
    let a9 = xf_set(h, 9, 11406482) in
    0
fn ed_kbx(h) =
    let a0 = xf_set(h, 0, 52811034) in
    let a1 = xf_set(h, 1, 25909283) in
    let a2 = xf_set(h, 2, 16144682) in
    let a3 = xf_set(h, 3, 17082669) in
    let a4 = xf_set(h, 4, 27570973) in
    let a5 = xf_set(h, 5, 30858332) in
    let a6 = xf_set(h, 6, 40966398) in
    let a7 = xf_set(h, 7, 8378388) in
    let a8 = xf_set(h, 8, 20764389) in
    let a9 = xf_set(h, 9, 8758491) in
    0
fn ed_kby(h) =
    let a0 = xf_set(h, 0, 40265304) in
    let a1 = xf_set(h, 1, 26843545) in
    let a2 = xf_set(h, 2, 13421772) in
    let a3 = xf_set(h, 3, 20132659) in
    let a4 = xf_set(h, 4, 26843545) in
    let a5 = xf_set(h, 5, 6710886) in
    let a6 = xf_set(h, 6, 53687091) in
    let a7 = xf_set(h, 7, 13421772) in
    let a8 = xf_set(h, 8, 40265318) in
    let a9 = xf_set(h, 9, 26843545) in
    0
