## compiler/stage1/win64_gui_and_interp_regression_ok.src
## Self-hosted regression gate for:
##   Bug A: String interpolation false positives (CSS rules, JS functions, JSON objects, Lume effect `/ {ffi}`)
##          while preserving valid `"ans={v}"` and `f"hex={v:04x}"` interpolation.
##   Bug B: Clean generic Win64 PE32+ GUI backend in `compiler/stage1/ltarget.src` with zero Notepad++ strings,
##          `Lume Sovereign Studio v1.1.0` title, disabled top menu bar (`hMenu = 0` at `rsp+72`),
##          Segoe UI `-12` font (`4220992`) on `116px-142px` toolbar buttons, and `WS_CLIPSIBLINGS` +
##          `WS_THICKFRAME` + `WS_HSCROLL | WS_VSCROLL` + `LB_SETHORIZONTALEXTENT = 680` (`SendMessageA(hwnd, 404, 680, 0)`)
##          on all 4 child panes.

fn wg_has_at(s: str, sub: str, i: int, n: int, m: int) -> int = if i + m > n then 0 else if at(s, i) == at(sub, 0) and slicen(s, n, i, i + m) == sub then 1 else wg_has_at(s, sub, i + 1, n, m)

fn wg_str_has(s: str, sub: str) -> int = let m = count(sub) in if m == 0 then 1 else wg_has_at(s, sub, 0, count(s), m)

fn wg_ltarget_path() -> str = if fs_path_exists("compiler/stage1/ltarget.src") == 1 then "compiler/stage1/ltarget.src" else "../../compiler/stage1/ltarget.src"

fn wg_read_ltarget() -> str = fs_read_file(wg_ltarget_path())

fn wg_has_ws_scroll_thickframe(style: int) -> int = let has_thick = style / 262144 % 2 in let has_hscroll = style / 1048576 % 2 in let has_vscroll = style / 2097152 % 2 in let has_clipsib = style / 67108864 % 2 in if has_thick == 1 and has_hscroll == 1 and has_vscroll == 1 and has_clipsib == 1 then 1 else 0

fn test_bug_a_css_rule_string_not_interpolated() = let css = ".panel{display:none;color:#10b981;font-weight:600}" in if count(css) == 50 and slice(css, 0, 7) == ".panel{" and slice(css, 49, 50) == "}" then 1 else 0

fn test_bug_a_js_function_strings_not_interpolated() = let js1 = "function(a){if(a)return a}" in let js2 = "function(){var x=1;return 'ok';}" in if count(js1) == 26 and slice(js1, 11, 26) == "{if(a)return a}" and count(js2) == 32 and slice(js2, 10, 32) == "{var x=1;return 'ok';}" then 1 else 0

fn test_bug_a_json_and_effect_strings_not_interpolated() = let j = "{\"ok\":true,\"count\":42}" in let eff = "extern \"c\" fn foo(x: int) -> int / {ffi}" in if count(j) == 22 and slice(j, 0, 6) == "{\"ok\":" and count(eff) == 40 and slice(eff, 33, 40) == "/ {ffi}" then 1 else 0

fn test_bug_a_valid_lume_interpolation_and_format_spec() = let v = 42 in let s1 = "ans={v}" in let s2 = f"hex={v:04x}" in if s1 == "ans=42" and s2 == "hex=002a" then 1 else 0

fn test_bug_b_zero_notepad_plus_plus_strings() = let src = wg_read_ltarget() in if count(src) > 10000 and wg_str_has(src, "LumePad++") == 0 and wg_str_has(src, "NppConverter.dll") == 0 and wg_str_has(src, "mimeTools.dll") == 0 and wg_str_has(src, "NppExport.dll") == 0 and wg_str_has(src, "GUP.exe") == 0 and wg_str_has(src, "[Code City 3D]") == 0 and wg_str_has(src, "npp.8.9.8.1") == 0 then 1 else 0

fn test_bug_b_clean_generic_studio_title() = let src = wg_read_ltarget() in if wg_str_has(src, "Lume Sovereign Studio v1.1.0") == 1 and wg_str_has(src, "LumeSovereignWin64Class") == 1 then 1 else 0

fn test_bug_b_hmenu_zero_and_segoe_ui_toolbar_buttons() = let src = wg_read_ltarget() in let hmenu_zero = wg_str_has(src, "wgui_rsp_imm(64, 0) + wgui_rsp_imm(72, 0)") in let segoe_12 = wg_str_has(src, "wgui_mov_ecx(0 - 12)") and wg_str_has(src, "wgui_mov_m64_rax(4220992)") and wg_str_has(src, "wgui_mov_r8_m64(4220992)") in let btn_widths = wg_str_has(src, "wgui_toolbar_btn(wgui_str_va(74), 6, 132, 105)") and wg_str_has(src, "wgui_toolbar_btn(wgui_str_va(77), 422, 142, 1002)") and wg_str_has(src, "wgui_toolbar_btn(wgui_str_va(79) + 32, 1244, 116, 1202)") in if hmenu_zero == 1 and segoe_12 == 1 and btn_widths == 1 then 1 else 0

fn test_bug_b_four_child_panes_thickframe_scroll_and_lb_extent() = let src = wg_read_ltarget() in let p1 = wg_str_has(src, "wgui_create_pane(2, 4210703, 1412702209, 6, 48, 300462003)") in let p2 = wg_str_has(src, "wgui_create_pane(1, 4216480, 1412698308, 312, 48, 760462002)") in let p3 = wg_str_has(src, "wgui_create_pane(2, 4210703, 1412702209, 1078, 48, 300462004)") in let p4 = wg_str_has(src, "wgui_create_pane(1, 4216096, 1412698308, 6, 516, 999136005)") in let p5 = wg_str_has(src, "wgui_create_pane(4, 4215936, 1409286144, 6, 658, 999024006)") in let lb_ext = wg_str_has(src, "wgui_mov_edx(404) + wgui_mov_r8d(680)") in let w999 = wg_str_has(src, "if w_raw == 999 then 1366 else w_raw") in let st_ok = wg_has_ws_scroll_thickframe(1412702209) == 1 and wg_has_ws_scroll_thickframe(1412698308) == 1 in if p1 == 1 and p2 == 1 and p3 == 1 and p4 == 1 and p5 == 1 and lb_ext == 1 and w999 == 1 and st_ok == 1 then 1 else 0
