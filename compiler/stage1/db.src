## db.src -- Track L (`#257`) Standard Library: B+Tree Storage & ACID Query Engine (`use std.db` / `use db`).
##
## Provides:
##   1. Multi-level B+Tree storage index with page splitting, logarithmic lookup & range-pruned scans (`BLeaf`, `BInner`)
##   2. ACID transactional engine with MVCC snapshot isolation, `commit`, and `rollback` (`db_begin_tx`, `db_commit_tx`, `db_rollback_tx`)
##   3. Cost-based query planner (`IndexPointSeek` vs `IndexRangeScan` vs `SequentialScan`) & relational aggregation
##   4. Durable WAL serialization & crash recovery (`db_wal_encode`)

fn db_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + db_len(t)

fn db_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, db_app(t, ys))

fn db_take(xs, k) = if k <= 0 then Nil else db_take2(xs, k)
fn db_take2(xs, k) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(h, db_take(t, k - 1))

fn db_drop(xs, k) = if k <= 0 then xs else db_drop2(xs, k)
fn db_drop2(xs, k) = match xs
    Nil        => Nil
    Cons(h, t) => db_drop(t, k - 1)

## --- 1. B+Tree Storage Index with Page Splitting ---
fn db_leaf_insert(entries, row) = match entries
    Nil        => Cons(row, Nil)
    Cons(h, t) => if row.k == h.k then Cons(row, t) else if row.k < h.k then Cons(row, Cons(h, t)) else Cons(h, db_leaf_insert(t, row))

fn db_leaf_delete(entries, key) = match entries
    Nil        => Nil
    Cons(h, t) => if h.k == key then t else Cons(h, db_leaf_delete(t, key))

fn db_head_key(entries) = match entries
    Nil        => 0
    Cons(h, t) => h.k

fn db_split_if_full(entries, max_keys) = let n = db_len(entries) in if n <= max_keys then BLeaf(entries) else let mid = n / 2 in let l_ents = db_take(entries, mid) in let r_ents = db_drop(entries, mid) in let sep_k = db_head_key(r_ents) in BInner(sep_k, BLeaf(l_ents), BLeaf(r_ents))

fn btree_empty() = BLeaf(Nil)

fn btree_insert_node(node, row, max_keys) = match node
    BLeaf(entries)    => db_split_if_full(db_leaf_insert(entries, row), max_keys)
    BInner(sep, l, r) => if row.k < sep then BInner(sep, btree_insert_node(l, row, max_keys), r) else BInner(sep, l, btree_insert_node(r, row, max_keys))

fn btree_delete_node(node, key) = match node
    BLeaf(entries)    => BLeaf(db_leaf_delete(entries, key))
    BInner(sep, l, r) => if key < sep then BInner(sep, btree_delete_node(l, key), r) else BInner(sep, l, btree_delete_node(r, key))

fn db_leaf_get(entries, key, fallback) = match entries
    Nil        => fallback
    Cons(h, t) => if h.k == key then h.v else if h.k > key then fallback else db_leaf_get(t, key, fallback)

fn btree_get(node, key, fallback) = match node
    BLeaf(entries)    => db_leaf_get(entries, key, fallback)
    BInner(sep, l, r) => if key < sep then btree_get(l, key, fallback) else btree_get(r, key, fallback)

fn btree_height(node) = match node
    BLeaf(entries)    => 1
    BInner(sep, l, r) => let hl = btree_height(l) in let hr = btree_height(r) in 1 + (if hl >= hr then hl else hr)

fn db_leaf_range(entries, lo_k, hi_k) = match entries
    Nil        => Nil
    Cons(h, t) => if h.k < lo_k then db_leaf_range(t, lo_k, hi_k) else if h.k > hi_k then Nil else Cons(h, db_leaf_range(t, lo_k, hi_k))

fn btree_range_scan(node, lo_k, hi_k) = match node
    BLeaf(entries)    => db_leaf_range(entries, lo_k, hi_k)
    BInner(sep, l, r) => if hi_k < sep then btree_range_scan(l, lo_k, hi_k) else if lo_k >= sep then btree_range_scan(r, lo_k, hi_k) else db_app(btree_range_scan(l, lo_k, hi_k), btree_range_scan(r, lo_k, hi_k))

fn db_check_sorted_list(entries, prev_k) = match entries
    Nil        => 1
    Cons(h, t) => if h.k <= prev_k then 0 else db_check_sorted_list(t, h.k)

fn btree_verify_invariant(node) = db_check_sorted_list(btree_range_scan(node, 0 - 1000000, 1000000), 0 - 1000001)

## --- 2. ACID Transactional & MVCC Snapshot Engine ---
fn db_open(max_leaf_keys) = let root = btree_empty() in {max_keys: max_leaf_keys, tx_id: 0, in_tx: 0, committed_root: root, working_root: root, committed_cnt: 0, rollback_cnt: 0, wal_ops: 0}

fn db_begin_tx(db) = {max_keys: db.max_keys, tx_id: db.tx_id + 1, in_tx: 1, committed_root: db.committed_root, working_root: db.committed_root, committed_cnt: db.committed_cnt, rollback_cnt: db.rollback_cnt, wal_ops: db.wal_ops}

fn db_put(db, key, val, col2) = let row = {k: key, v: val, col2: col2} in let next_work = btree_insert_node(db.working_root, row, db.max_keys) in let next_comm = if db.in_tx == 1 then db.committed_root else next_work in {max_keys: db.max_keys, tx_id: db.tx_id, in_tx: db.in_tx, committed_root: next_comm, working_root: next_work, committed_cnt: db.committed_cnt, rollback_cnt: db.rollback_cnt, wal_ops: db.wal_ops + 1}

fn db_delete(db, key) = let next_work = btree_delete_node(db.working_root, key) in let next_comm = if db.in_tx == 1 then db.committed_root else next_work in {max_keys: db.max_keys, tx_id: db.tx_id, in_tx: db.in_tx, committed_root: next_comm, working_root: next_work, committed_cnt: db.committed_cnt, rollback_cnt: db.rollback_cnt, wal_ops: db.wal_ops + 1}

fn db_commit_tx(db) = if db.in_tx == 0 then db else {max_keys: db.max_keys, tx_id: db.tx_id, in_tx: 0, committed_root: db.working_root, working_root: db.working_root, committed_cnt: db.committed_cnt + 1, rollback_cnt: db.rollback_cnt, wal_ops: db.wal_ops + 1}

fn db_rollback_tx(db) = if db.in_tx == 0 then db else {max_keys: db.max_keys, tx_id: db.tx_id, in_tx: 0, committed_root: db.committed_root, working_root: db.committed_root, committed_cnt: db.committed_cnt, rollback_cnt: db.rollback_cnt + 1, wal_ops: db.wal_ops}

fn db_read(db, key, fallback) = btree_get(db.working_root, key, fallback)

fn db_snapshot_read(db, key, fallback) = btree_get(db.committed_root, key, fallback)

## --- 3. Cost-Based Query Planner & Relational Aggregation ---
fn db_plan_query(total_rows, indexed, lo_k, hi_k) = if indexed == 1 and lo_k == hi_k then {plan: "IndexPointSeek", est_cost: 2} else if indexed == 1 and (hi_k - lo_k) < (total_rows / 2) then {plan: "IndexRangeScan", est_cost: 4 + (hi_k - lo_k)} else {plan: "SequentialScan", est_cost: total_rows}

fn db_sum_rows(rows, min_col2) = match rows
    Nil        => 0
    Cons(r, t) => (if r.col2 >= min_col2 then r.v else 0) + db_sum_rows(t, min_col2)

fn db_exec_range_query(db, lo_k, hi_k, min_col2) = let rows = btree_range_scan(db.committed_root, lo_k, hi_k) in {count: db_len(rows), sum_v: db_sum_rows(rows, min_col2)}

fn db_encode_rows_wal(rows) = match rows
    Nil        => ""
    Cons(r, t) => "PUT " + str(r.k) + " " + str(r.v) + " " + str(r.col2) + "\n" + db_encode_rows_wal(t)

fn db_wal_encode(db) = let rows = btree_range_scan(db.committed_root, 0 - 1000000, 1000000) in "LUME_DB_WAL_V1 tx=" + str(db.tx_id) + " committed=" + str(db.committed_cnt) + "\n" + db_encode_rows_wal(rows) + "COMMIT\n"

## --- 4. Arbitrary-Height Recursive Multi-Way B+Tree (`BMLeaf` / `BMInner`) ---
fn bm_nth_int(xs, idx) = match xs
    Nil        => 0
    Cons(h, t) => if idx <= 0 then h else bm_nth_int(t, idx - 1)

fn bm_ins_at_int(xs, idx, v) = if idx <= 0 then Cons(v, xs) else bm_ins_at_int2(xs, idx, v)
fn bm_ins_at_int2(xs, idx, v) = match xs
    Nil        => Cons(v, Nil)
    Cons(h, t) => Cons(h, bm_ins_at_int(t, idx - 1, v))

fn bm_replace_child(cs, idx, c_new) = match cs
    Nil        => Nil
    Cons(h, t) => if idx <= 0 then Cons(c_new, t) else Cons(h, bm_replace_child(t, idx - 1, c_new))

fn bm_splice_child(cs, idx, cl, cr) = match cs
    Nil        => Cons(cl, Cons(cr, Nil))
    Cons(h, t) => if idx <= 0 then Cons(cl, Cons(cr, t)) else Cons(h, bm_splice_child(t, idx - 1, cl, cr))

fn bm_find_child_idx(keys, k, idx) = match keys
    Nil        => idx
    Cons(h, t) => if k < h then idx else bm_find_child_idx(t, k, idx + 1)

fn bm_nth_child(cs, idx) = match cs
    Nil        => BMLeaf(Nil)
    Cons(h, t) => if idx <= 0 then h else bm_nth_child(t, idx - 1)

fn bm_split_leaf(entries, max_keys) = let n = db_len(entries) in if n <= max_keys then {split: 0, sep: 0, left: BMLeaf(entries), right: BMLeaf(Nil)} else let mid = n / 2 in let l_ents = db_take(entries, mid) in let r_ents = db_drop(entries, mid) in {split: 1, sep: db_head_key(r_ents), left: BMLeaf(l_ents), right: BMLeaf(r_ents)}

fn bm_split_inner(keys, cs, max_keys) = let n = db_len(keys) in if n <= max_keys then {split: 0, sep: 0, left: BMInner(keys, cs), right: BMLeaf(Nil)} else let mid = n / 2 in let up_sep = bm_nth_int(keys, mid) in let l_keys = db_take(keys, mid) in let r_keys = db_drop(keys, mid + 1) in let l_cs = db_take(cs, mid + 1) in let r_cs = db_drop(cs, mid + 1) in {split: 1, sep: up_sep, left: BMInner(l_keys, l_cs), right: BMInner(r_keys, r_cs)}

fn bm_insert_rec(node, row, max_keys) = match node
    BMLeaf(entries)   => bm_split_leaf(db_leaf_insert(entries, row), max_keys)
    BMInner(keys, cs) => let idx = bm_find_child_idx(keys, row.k, 0) in let sub = bm_insert_rec(bm_nth_child(cs, idx), row, max_keys) in if sub.split == 0 then {split: 0, sep: 0, left: BMInner(keys, bm_replace_child(cs, idx, sub.left)), right: BMLeaf(Nil)} else bm_split_inner(bm_ins_at_int(keys, idx, sub.sep), bm_splice_child(cs, idx, sub.left, sub.right), max_keys)

fn bm_empty() = BMLeaf(Nil)

fn bm_insert(root, row, max_keys) = let r = bm_insert_rec(root, row, max_keys) in if r.split == 0 then r.left else BMInner(Cons(r.sep, Nil), Cons(r.left, Cons(r.right, Nil)))

fn bm_put(root, k, v, col2, max_keys) = bm_insert(root, {k: k, v: v, col2: col2}, max_keys)

fn bm_get(node, key, fallback) = match node
    BMLeaf(entries)   => db_leaf_get(entries, key, fallback)
    BMInner(keys, cs) => bm_get(bm_nth_child(cs, bm_find_child_idx(keys, key, 0)), key, fallback)

fn bm_height(node) = match node
    BMLeaf(entries)   => 1
    BMInner(keys, cs) => 1 + bm_height(bm_nth_child(cs, 0))

fn bm_range_children(cs, lo_k, hi_k) = match cs
    Nil        => Nil
    Cons(c, r) => db_app(bm_range_scan(c, lo_k, hi_k), bm_range_children(r, lo_k, hi_k))

fn bm_range_scan(node, lo_k, hi_k) = match node
    BMLeaf(entries)   => db_leaf_range(entries, lo_k, hi_k)
    BMInner(keys, cs) => bm_range_children(cs, lo_k, hi_k)

fn bm_all_heights_eq(cs, exp_h) = match cs
    Nil        => 1
    Cons(c, r) => if bm_height(c) == exp_h and bm_balanced(c) == 1 then bm_all_heights_eq(r, exp_h) else 0

fn bm_balanced(node) = match node
    BMLeaf(entries)   => 1
    BMInner(keys, cs) => if db_len(cs) != db_len(keys) + 1 then 0 else bm_all_heights_eq(cs, bm_height(bm_nth_child(cs, 0)))

fn bm_verify_invariant(node) = if bm_balanced(node) == 0 then 0 else db_check_sorted_list(bm_range_scan(node, 0 - 1000000, 1000000), 0 - 1000001)

fn bm_insert_seq(root, cur, hi, max_keys) = if cur > hi then root else bm_insert_seq(bm_put(root, cur * 10, cur * 100, cur, max_keys), cur + 1, hi, max_keys)

## --- 5. Persistent File-Backed ACID WAL & Crash Recovery ---
fn db_wal_cksum(tx_id, k, v, col2) = ((tx_id * 100003) + (k * 1009) + (v * 37) + (col2 * 13) + 97) % 1000000007

fn db_wal_op_line(tx_id, k, v, col2) = "OP " + str(tx_id) + " " + str(k) + " " + str(v) + " " + str(col2) + " " + str(db_wal_cksum(tx_id, k, v, col2)) + "\n"

fn db_wal_commit_line(tx_id) = "COMMIT " + str(tx_id) + "\n"

fn db_tok_loop(s, i, n, st, in_t) = if i >= n then (if in_t == 1 then Cons(slice(s, st, n), Nil) else Nil) else let sp = if at(s, i) == " " or at(s, i) == "\r" then 1 else 0 in if in_t == 0 then (if sp == 1 then db_tok_loop(s, i + 1, n, 0, 0) else db_tok_loop(s, i + 1, n, i, 1)) else (if sp == 1 then Cons(slice(s, st, i), db_tok_loop(s, i + 1, n, 0, 0)) else db_tok_loop(s, i + 1, n, st, 1))

fn db_tokens(line) = db_tok_loop(line, 0, count(line), 0, 0)

fn db_line_end(s, i, n) = if i >= n then n else if at(s, i) == "\n" then i else db_line_end(s, i + 1, n)

fn db_lines_lp(s, i, n) = if i >= n then Nil else let e = db_line_end(s, i, n) in Cons(db_tokens(slice(s, i, e)), db_lines_lp(s, e + 1, n))

fn db_lines(s) = db_lines_lp(s, 0, count(s))

fn db_tok_at(xs, idx) = match xs
    Nil        => ""
    Cons(h, t) => if idx <= 0 then h else db_tok_at(t, idx - 1)

fn db_int_in(xs, v) = match xs
    Nil        => 0
    Cons(h, t) => if h == v then 1 else db_int_in(t, v)

fn db_committed_txs(ls) = match ls
    Nil        => Nil
    Cons(l, r) => if db_len(l) == 2 and db_tok_at(l, 0) == "COMMIT" then Cons(toint(db_tok_at(l, 1)), db_committed_txs(r)) else db_committed_txs(r)

fn db_replay_wal_lines(ls, c_txs, db, rep, disc) = match ls
    Nil        => {ok: 1, db: db, replayed: rep, discarded: disc}
    Cons(l, r) => if db_len(l) == 6 and db_tok_at(l, 0) == "OP" then (let tx = toint(db_tok_at(l, 1)) in let k = toint(db_tok_at(l, 2)) in let v = toint(db_tok_at(l, 3)) in let c2 = toint(db_tok_at(l, 4)) in let ck = toint(db_tok_at(l, 5)) in if db_int_in(c_txs, tx) == 1 and ck == db_wal_cksum(tx, k, v, c2) then db_replay_wal_lines(r, c_txs, db_put(db, k, v, c2), rep + 1, disc) else db_replay_wal_lines(r, c_txs, db, rep, disc + 1)) else db_replay_wal_lines(r, c_txs, db, rep, disc)

fn db_wal_recover_file(path, max_keys) = let raw = fs_read_file(path) in if count(raw) == 0 then {ok: 0, db: db_open(max_keys), replayed: 0, discarded: 0} else let ls = db_lines(raw) in let c_txs = db_committed_txs(ls) in db_replay_wal_lines(ls, c_txs, db_open(max_keys), 0, 0)

fn db_crash_recovery_probe(path) = let pid = os_fork() in if pid == 0 then (let w1 = fs_write_sync(path, db_wal_op_line(1, 10, 100, 1) + db_wal_op_line(1, 20, 200, 2) + db_wal_commit_line(1)) in let w2 = fs_append_sync(path, db_wal_op_line(2, 10, 999, 9) + "OP 1 30 300 3 999999\n") in os_exit(9)) else (let st = os_waitpid_status(pid) in let rec = db_wal_recover_file(path, 2) in let rm = fs_remove(path) in {crashed_nonzero: if st != 0 then 1 else 0, ok: rec.ok, replayed: rec.replayed, discarded: rec.discarded, v10: db_read(rec.db, 10, 0), v20: db_read(rec.db, 20, 0), v30: db_read(rec.db, 30, 0 - 1)})

## --- Unit tests (`lume test compiler/stage1/db.src`) ---
fn test_btree_page_split_and_logarithmic_lookup() = let d0 = db_open(2) in let d1 = db_put(d0, 30, 300, 1) in let d2 = db_put(d1, 10, 100, 1) in let d3 = db_put(d2, 20, 200, 1) in let d4 = db_put(d3, 40, 400, 2) in let d5 = db_put(d4, 25, 250, 2) in let h = btree_height(d5.committed_root) in h >= 2 and btree_verify_invariant(d5.committed_root) == 1 and db_read(d5, 10, 0) == 100 and db_read(d5, 25, 0) == 250 and db_read(d5, 40, 0) == 400 and db_read(d5, 99, 0 - 1) == (0 - 1)

fn test_btree_range_scan_pruning_and_sorted_invariant() = let d0 = db_open(2) in let d1 = db_put(db_put(db_put(db_put(db_put(d0, 50, 5, 10), 10, 1, 20), 40, 4, 30), 20, 2, 40), 30, 3, 50) in let q = db_exec_range_query(d1, 20, 40, 0) in let q_filt = db_exec_range_query(d1, 10, 50, 30) in q.count == 3 and q.sum_v == 9 and q_filt.count == 5 and q_filt.sum_v == 9 and btree_verify_invariant(d1.committed_root) == 1

fn test_acid_transaction_commit_and_snapshot_isolation() = let d0 = db_put(db_open(2), 1, 100, 1) in let tx = db_begin_tx(d0) in let tx2 = db_put(tx, 1, 999, 1) in let tx3 = db_put(tx2, 2, 200, 1) in let snap_before = db_snapshot_read(tx3, 1, 0) in let snap_missing = db_snapshot_read(tx3, 2, 0 - 1) in let work_inside = db_read(tx3, 1, 0) in let committed = db_commit_tx(tx3) in snap_before == 100 and snap_missing == (0 - 1) and work_inside == 999 and db_snapshot_read(committed, 1, 0) == 999 and db_snapshot_read(committed, 2, 0) == 200 and committed.committed_cnt == 1

fn test_acid_transaction_rollback_restores_state() = let d0 = db_put(db_put(db_open(2), 10, 1000, 5), 20, 2000, 5) in let tx = db_begin_tx(d0) in let tx2 = db_put(tx, 10, 0, 0) in let tx3 = db_delete(tx2, 20) in let tx4 = db_put(tx3, 30, 3000, 5) in let rb = db_rollback_tx(tx4) in rb.in_tx == 0 and rb.rollback_cnt == 1 and db_read(rb, 10, 0) == 1000 and db_read(rb, 20, 0) == 2000 and db_read(rb, 30, 0 - 1) == (0 - 1)

fn test_cost_based_query_planner_and_wal_encoding() = let p_seek = db_plan_query(1000, 1, 42, 42) in let p_range = db_plan_query(1000, 1, 10, 30) in let p_scan = db_plan_query(100, 0, 10, 30) in let d = db_commit_tx(db_put(db_begin_tx(db_open(2)), 7, 70, 3)) in let wal = db_wal_encode(d) in p_seek.plan == "IndexPointSeek" and p_range.plan == "IndexRangeScan" and p_scan.plan == "SequentialScan" and p_seek.est_cost < p_range.est_cost and p_range.est_cost < p_scan.est_cost and count(wal) > 20

fn test_btree_recursive_internal_split_multiheight() = let t9 = bm_insert_seq(bm_empty(), 1, 9, 2) in let rows = bm_range_scan(t9, 30, 70) in bm_height(t9) == 4 and bm_verify_invariant(t9) == 1 and bm_get(t9, 10, 0) == 100 and bm_get(t9, 50, 0) == 500 and bm_get(t9, 90, 0) == 900 and bm_get(t9, 999, 0 - 1) == (0 - 1) and db_len(rows) == 5 and db_sum_rows(rows, 0) == 2500

fn test_durable_acid_wal_crash_recovery() = let p = "/tmp/lume_db_wal_crash_" + str(os_getpid()) + ".wal" in let r = db_crash_recovery_probe(p) in r.crashed_nonzero == 1 and r.ok == 1 and r.replayed == 2 and r.discarded == 2 and r.v10 == 100 and r.v20 == 200 and r.v30 == (0 - 1)

## --- 6. SaaS Schema Migration, Snapshot Backup/Restore & Structured Metrics (#332) ---
fn db_sha_u32(x) = let r = x % 4294967296 in if r < 0 then r + 4294967296 else r
fn db_sha_pow2(n) = if n <= 0 then 1 else if n >= 16 then 65536 * db_sha_pow2(n - 16) else if n >= 8 then 256 * db_sha_pow2(n - 8) else if n >= 4 then 16 * db_sha_pow2(n - 4) else if n == 3 then 8 else if n == 2 then 4 else 2
fn db_sha_shr(x, n) = x / db_sha_pow2(n)
fn db_sha_rotr(x, n) = let p = db_sha_pow2(n) in (x / p) + ((x % p) * db_sha_pow2(32 - n))
fn db_sha_xor3_4(x, y, z) = let b0 = ((x % 2) + (y % 2) + (z % 2)) % 2 in let b1 = (((x / 2) % 2) + ((y / 2) % 2) + ((z / 2) % 2)) % 2 in let b2 = (((x / 4) % 2) + ((y / 4) % 2) + ((z / 4) % 2)) % 2 in let b3 = (((x / 8) % 2) + ((y / 8) % 2) + ((z / 8) % 2)) % 2 in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn db_sha_xor3_n(x, y, z, nibs) = if nibs <= 0 then 0 else db_sha_xor3_4(x % 16, y % 16, z % 16) + 16 * db_sha_xor3_n(x / 16, y / 16, z / 16, nibs - 1)
fn db_sha_ch_4(e, f, g) = let b0 = (if (e % 2) == 1 then (f % 2) else (g % 2)) in let b1 = (if ((e / 2) % 2) == 1 then ((f / 2) % 2) else ((g / 2) % 2)) in let b2 = (if ((e / 4) % 2) == 1 then ((f / 4) % 2) else ((g / 4) % 2)) in let b3 = (if ((e / 8) % 2) == 1 then ((f / 8) % 2) else ((g / 8) % 2)) in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn db_sha_ch_n(e, f, g, nibs) = if nibs <= 0 then 0 else db_sha_ch_4(e % 16, f % 16, g % 16) + 16 * db_sha_ch_n(e / 16, f / 16, g / 16, nibs - 1)
fn db_sha_maj_4(a, b, c) = let b0 = (if (a % 2) + (b % 2) + (c % 2) >= 2 then 1 else 0) in let b1 = (if ((a / 2) % 2) + ((b / 2) % 2) + ((c / 2) % 2) >= 2 then 1 else 0) in let b2 = (if ((a / 4) % 2) + ((b / 4) % 2) + ((c / 4) % 2) >= 2 then 1 else 0) in let b3 = (if ((a / 8) % 2) + ((b / 8) % 2) + ((c / 8) % 2) >= 2 then 1 else 0) in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn db_sha_maj_n(a, b, c, nibs) = if nibs <= 0 then 0 else db_sha_maj_4(a % 16, b % 16, c % 16) + 16 * db_sha_maj_n(a / 16, b / 16, c / 16, nibs - 1)
fn db_sha_big_sig0(a) = db_sha_xor3_n(db_sha_rotr(a, 2), db_sha_rotr(a, 13), db_sha_rotr(a, 22), 8)
fn db_sha_big_sig1(e) = db_sha_xor3_n(db_sha_rotr(e, 6), db_sha_rotr(e, 11), db_sha_rotr(e, 25), 8)
fn db_sha_sml_sig0(x) = db_sha_xor3_n(db_sha_rotr(x, 7), db_sha_rotr(x, 18), db_sha_shr(x, 3), 8)
fn db_sha_sml_sig1(x) = db_sha_xor3_n(db_sha_rotr(x, 17), db_sha_rotr(x, 19), db_sha_shr(x, 10), 8)
fn db_sha_k(t) = if t < 16 then (if t == 0 then 1116352408 else if t == 1 then 1899447441 else if t == 2 then 3049323471 else if t == 3 then 3921009573 else if t == 4 then 961987163 else if t == 5 then 1508970993 else if t == 6 then 2453635748 else if t == 7 then 2870763221 else if t == 8 then 3624381080 else if t == 9 then 310598401 else if t == 10 then 607225278 else if t == 11 then 1426881987 else if t == 12 then 1925078388 else if t == 13 then 2162078206 else if t == 14 then 2614888103 else 3248222580) else if t < 32 then (if t == 16 then 3835390401 else if t == 17 then 4022224774 else if t == 18 then 264347078 else if t == 19 then 604807628 else if t == 20 then 770255983 else if t == 21 then 1249150122 else if t == 22 then 1555081692 else if t == 23 then 1996064986 else if t == 24 then 2554220882 else if t == 25 then 2821834349 else if t == 26 then 2952996808 else if t == 27 then 3210313671 else if t == 28 then 3336571891 else if t == 29 then 3584528711 else if t == 30 then 113926993 else 338241895) else if t < 48 then (if t == 32 then 666307205 else if t == 33 then 773529912 else if t == 34 then 1294757372 else if t == 35 then 1396182291 else if t == 36 then 1695183700 else if t == 37 then 1986661051 else if t == 38 then 2177026350 else if t == 39 then 2456956037 else if t == 40 then 2730485921 else if t == 41 then 2820302411 else if t == 42 then 3259730800 else if t == 43 then 3345764771 else if t == 44 then 3516065817 else if t == 45 then 3600352804 else if t == 46 then 4094571909 else 275423344) else (if t == 48 then 430227734 else if t == 49 then 506948616 else if t == 50 then 659060556 else if t == 51 then 883997877 else if t == 52 then 958139571 else if t == 53 then 1322822218 else if t == 54 then 1537002063 else if t == 55 then 1747873779 else if t == 56 then 1955562222 else if t == 57 then 2024104815 else if t == 58 then 2227730452 else if t == 59 then 2361852424 else if t == 60 then 2428436474 else if t == 61 then 2756734187 else if t == 62 then 3204031479 else 3329325298)
fn db_sha_nth(xs, i) = match xs
    Nil        => 0
    Cons(h, t) => if i <= 0 then h else db_sha_nth(t, i - 1)
fn db_sha_msg_byte(s, len, total, idx) = if idx < len then ord(at(s, idx)) else if idx == len then 128 else if idx >= total - 8 then ((len * 8) / db_sha_pow2(8 * (total - 1 - idx))) % 256 else 0
fn db_sha_msg_word(s, len, total, base) = db_sha_msg_byte(s, len, total, base) * 16777216 + db_sha_msg_byte(s, len, total, base + 1) * 65536 + db_sha_msg_byte(s, len, total, base + 2) * 256 + db_sha_msg_byte(s, len, total, base + 3)
fn db_sha_w_build(s, len, total, blk_off, t, w_rev) = if t >= 64 then w_rev else let wt = (if t < 16 then db_sha_msg_word(s, len, total, blk_off + t * 4) else db_sha_u32(db_sha_nth(w_rev, 15) + db_sha_sml_sig0(db_sha_nth(w_rev, 14)) + db_sha_nth(w_rev, 6) + db_sha_sml_sig1(db_sha_nth(w_rev, 1)))) in db_sha_w_build(s, len, total, blk_off, t + 1, Cons(wt, w_rev))
fn db_sha_round(st, wt, kt) = let t1 = db_sha_u32(st.h + db_sha_big_sig1(st.e) + db_sha_ch_n(st.e, st.f, st.g, 8) + kt + wt) in let t2 = db_sha_u32(db_sha_big_sig0(st.a) + db_sha_maj_n(st.a, st.b, st.c, 8)) in {a: db_sha_u32(t1 + t2), b: st.a, c: st.b, d: st.c, e: db_sha_u32(st.d + t1), f: st.e, g: st.f, h: st.g}
fn db_sha_rounds(st, w_rev, t) = if t >= 64 then st else db_sha_rounds(db_sha_round(st, db_sha_nth(w_rev, 63 - t), db_sha_k(t)), w_rev, t + 1)
fn db_sha_blocks(s, len, total, blk_off, st) = if blk_off >= total then st else let w_rev = db_sha_w_build(s, len, total, blk_off, 0, Nil) in let r = db_sha_rounds(st, w_rev, 0) in db_sha_blocks(s, len, total, blk_off + 64, {a: db_sha_u32(st.a + r.a), b: db_sha_u32(st.b + r.b), c: db_sha_u32(st.c + r.c), d: db_sha_u32(st.d + r.d), e: db_sha_u32(st.e + r.e), f: db_sha_u32(st.f + r.f), g: db_sha_u32(st.g + r.g), h: db_sha_u32(st.h + r.h)})
fn db_sha_hex1(n) = at("0123456789abcdef", n % 16)
fn db_sha_hex32(w) = db_sha_hex1(w / 268435456) + db_sha_hex1(w / 16777216) + db_sha_hex1(w / 1048576) + db_sha_hex1(w / 65536) + db_sha_hex1(w / 4096) + db_sha_hex1(w / 256) + db_sha_hex1(w / 16) + db_sha_hex1(w)
fn db_sha256_hex(s) = let len = count(s) in let total = ((len + 9 + 63) / 64) * 64 in let init = {a: 1779033703, b: 3144134277, c: 1013904242, d: 2773480762, e: 1359893119, f: 2600822924, g: 528734635, h: 1541459225} in let fin = db_sha_blocks(s, len, total, 0, init) in db_sha_hex32(fin.a) + db_sha_hex32(fin.b) + db_sha_hex32(fin.c) + db_sha_hex32(fin.d) + db_sha_hex32(fin.e) + db_sha_hex32(fin.f) + db_sha_hex32(fin.g) + db_sha_hex32(fin.h)

fn db_migrate_rows_v2_lp(rows, scale_v, min_col2, root, max_keys) = match rows
    Nil        => root
    Cons(r, t) => let c2 = if r.col2 < min_col2 then min_col2 else r.col2 in db_migrate_rows_v2_lp(t, scale_v, min_col2, btree_insert_node(root, {k: r.k, v: r.v * scale_v, col2: c2}, max_keys), max_keys)

fn db_migrate_schema_v2(db, scale_v, min_col2) = let rows = btree_range_scan(db.committed_root, 0 - 1000000, 1000000) in let new_root = db_migrate_rows_v2_lp(rows, scale_v, min_col2, btree_empty(), db.max_keys) in {max_keys: db.max_keys, tx_id: db.tx_id + 1, in_tx: 0, committed_root: new_root, working_root: new_root, committed_cnt: db.committed_cnt + 1, rollback_cnt: db.rollback_cnt, wal_ops: db.wal_ops + db_len(rows)}

fn db_backup_ops(rows, tx_id) = match rows
    Nil        => ""
    Cons(r, t) => db_wal_op_line(tx_id, r.k, r.v, r.col2) + db_backup_ops(t, tx_id)

fn db_backup_snapshot_file(path, db) = let rows = btree_range_scan(db.committed_root, 0 - 1000000, 1000000) in let tx = if db.tx_id <= 0 then 1 else db.tx_id in let body = db_backup_ops(rows, tx) + db_wal_commit_line(tx) in let hdr = "SNAP_SHA256 " + db_sha256_hex(body) + "\n" in fs_write_sync(path, hdr + body)

fn db_restore_snapshot_file(path, max_keys) = let raw = fs_read_file(path) in if count(raw) < 77 or slice(raw, 0, 12) != "SNAP_SHA256 " or at(raw, 76) != "\n" then {ok: 0, db: db_open(max_keys), replayed: 0, discarded: 0} else let exp_sha = slice(raw, 12, 76) in let body = slice(raw, 77, count(raw)) in if db_sha256_hex(body) != exp_sha then {ok: 0, db: db_open(max_keys), replayed: 0, discarded: 0} else let ls = db_lines(body) in let c_txs = db_committed_txs(ls) in db_replay_wal_lines(ls, c_txs, db_open(max_keys), 0, 0)

fn db_metrics_prometheus(db) = "lume_db_tx_total " + str(db.tx_id) + "\nlume_db_committed_total " + str(db.committed_cnt) + "\nlume_db_rollback_total " + str(db.rollback_cnt) + "\nlume_db_wal_ops_total " + str(db.wal_ops) + "\n"

fn test_saas_schema_migration_backup_restore_and_metrics() = let d0 = db_commit_tx(db_put(db_put(db_begin_tx(db_open(2)), 10, 50, 1), 20, 80, 9)) in let d_mig = db_migrate_schema_v2(d0, 10, 5) in let snap = "/tmp/lume_db_snap_" + str(os_getpid()) + ".bak" in let w_ok = db_backup_snapshot_file(snap, d_mig) in let rest = db_restore_snapshot_file(snap, 2) in let raw_snap = fs_read_file(snap) in let w_bad = fs_write_sync(snap, slice(raw_snap, 0, count(raw_snap) - 4) + "999\n") in let rest_bad = db_restore_snapshot_file(snap, 2) in let rm = fs_remove(snap) in let prom = db_metrics_prometheus(d_mig) in w_ok == 1 and rest.ok == 1 and rest.replayed == 2 and rest_bad.ok == 0 and db_read(rest.db, 10, 0) == 500 and db_read(rest.db, 20, 0) == 800 and (db_exec_range_query(d_mig, 10, 20, 5)).count == 2 and count(prom) > 40
