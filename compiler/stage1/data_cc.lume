## data_cc.lume — compile an ML-core (.src) program to native x86-64 assembly.
## Usage: lume0 run data_cc.lume in.src out.s  (then lume0 asm out.s prog ; ./prog)
use data_ast
use data_parser
use data_codegen
use std.io

fn main() -> int!str
    let args = env.args()
    if args.len() < 2
        io.println("usage: data_cc.lume <in.src> <out.s>")
        return 1
    let r = parse_data_checked(io.read_file(args[0]))
    if r.err != ""
        fail r.err
    let asm = cgen_data(r.prog)
    let w = io.write_file(args[1], asm)
    io.println("emitted asm {args[0]} -> {args[1]}")
    return 0
