## datetime.src -- dates, times and time zones in Lume (`use std/datetime`). Times are Unix seconds (UTC); a date-time
## is the record {y, mo, d, h, mi, s}. Proleptic Gregorian calendar, no leap seconds.
##   dt_from_unix(t)                 -> {y, mo, d, h, mi, s} in UTC
##   dt_to_unix(y, mo, d, h, mi, s)  -> Unix seconds of that UTC date-time
##   dt_days_from_civil(y, mo, d)    days since 1970-01-01 (negative before)
##   dt_weekday(t)                   0 Sunday .. 6 Saturday
##   dt_leap(y) / dt_days_in_month(y, mo)
##   dt_add_days(t, n) / dt_add_months(t, n)   (a day past the end of the month is clamped)
##   dt_iso(t)                       "2026-11-19T13:05:00Z"
##   dt_parse_iso(s)                 Unix seconds from "YYYY-MM-DD", "YYYY-MM-DDTHH:MM[:SS][.fff](Z|+HH:MM|-HH:MM)";
##                                   -1 when malformed (a time without a zone is UTC); see dt_parse
##   dt_parse(s)                     -> {ok, t, ns, off, zone}: ISO 8601 / RFC 3339 in the extended (2023-11-14T22:13:20)
##                                   or basic (20231114T221320) form; T, t or a space between date and time; seconds
##                                   optional; a fraction after . or , (ns: its nanoseconds, 9 digits kept); the zone
##                                   Z, z, +HH, +HH:MM or +HHMM, which must end the text (off: its seconds east of UTC,
##                                   zone: whether one was written); 24:00:00 is the next midnight; ok false otherwise
##   dt_yday(t)                      day of the year, 1..366
##   dt_iso_week(t)                  {year, week}: the ISO 8601 week (1..53) and the year that owns it
##   dt_format(t, off, pattern)      strftime-style text of instant t at offset off (seconds east of UTC): %Y %m %d %H
##                                   %M %S %F (%Y-%m-%d) %T (%H:%M:%S) %y %e %I %p %j %a %A %b %B (English names) %u
##                                   (1 Monday..7) %w (0 Sunday..6) %V %G (ISO week and its year) %z (+hhmm) %:z
##                                   (+hh:mm) %s (Unix seconds) %%; any other %x is copied as written
## For IANA zones read from tzdata (TZif files) and POSIX TZ rules see std/tz.
##   dt_offset(zone, t)              the zone's offset from UTC at instant t, in seconds; zone is "UTC", "+03:00" /
##                                   "-0530" or a named zone: America/Sao_Paulo, America/New_York, America/Chicago,
##                                   America/Denver, America/Los_Angeles (US daylight rule), Europe/London,
##                                   Europe/Lisbon, Europe/Paris, Europe/Berlin, Europe/Madrid, Europe/Rome (EU rule),
##                                   Asia/Tokyo, Asia/Shanghai, Asia/Kolkata, Australia/Sydney (southern rule)
##   dt_local(zone, t)               {y, mo, d, h, mi, s} local time in that zone
##   dt_iso_local(zone, t)           "2026-11-19T10:05:00-03:00"

## days from civil (Howard Hinnant's algorithm)
fn dt_floordiv(a, b) = if a >= 0 then a / b else 0 - (0 - a + b - 1) / b
fn dt_days_from_civil(y0, m, d) =
    let y = if m <= 2 then y0 - 1 else y0 in
    let era = dt_floordiv(y, 400) in
    let yoe = y - era * 400 in
    let mp = if m > 2 then m - 3 else m + 9 in
    let doy = (153 * mp + 2) / 5 + d - 1 in
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy in
    era * 146097 + doe - 719468
fn dt_civil(z0) =
    let z = z0 + 719468 in
    let era = dt_floordiv(z, 146097) in
    let doe = z - era * 146097 in
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365 in
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100) in
    let mp = (5 * doy + 2) / 153 in
    let d = doy - (153 * mp + 2) / 5 + 1 in
    let m = if mp < 10 then mp + 3 else mp - 9 in
    {y: yoe + era * 400 + (if m <= 2 then 1 else 0), mo: m, d: d}
fn dt_from_unix(t) =
    let days = dt_floordiv(t, 86400) in
    let sec = t - days * 86400 in
    let c = dt_civil(days) in
    {y: c.y, mo: c.mo, d: c.d, h: sec / 3600, mi: sec % 3600 / 60, s: sec % 60}
fn dt_to_unix(y, mo, d, h, mi, s) = dt_days_from_civil(y, mo, d) * 86400 + h * 3600 + mi * 60 + s
fn dt_weekday(t) = let days = dt_floordiv(t, 86400) in (days % 7 + 11) % 7
fn dt_leap(y) = y % 4 == 0 and y % 100 != 0 or y % 400 == 0
fn dt_days_in_month(y, mo) =
    if mo == 2 then
        (if dt_leap(y) then 29 else 28)
    else if mo == 4 or mo == 6 or mo == 9 or mo == 11 then
        30
    else
        31
fn dt_add_days(t, n) = t + n * 86400
fn dt_add_months(t, n) =
    let r = dt_from_unix(t) in
    let m0 = r.mo - 1 + n in
    let y = r.y + dt_floordiv(m0, 12) in
    let mo = m0 - dt_floordiv(m0, 12) * 12 + 1 in
    let d = if r.d > dt_days_in_month(y, mo) then dt_days_in_month(y, mo) else r.d in
    dt_to_unix(y, mo, d, r.h, r.mi, r.s)

fn dt_p2(n) = if n < 10 then "0" + str(n) else str(n)
fn dt_p4(n) =
    if n < 10 then
        "000" + str(n)
    else if n < 100 then
        "00" + str(n)
    else if n < 1000 then
        "0" + str(n)
    else
        str(n)
fn dt_fmt(r) = dt_p4(r.y) + "-" + dt_p2(r.mo) + "-" + dt_p2(r.d) + "T" + dt_p2(r.h) + ":" + dt_p2(r.mi) + ":" + dt_p2(r.s)
fn dt_iso(t) = dt_fmt(dt_from_unix(t)) + "Z"
fn dt_zfmt(off) =
    if off == 0 then
        "Z"
    else
        (if off < 0 then "-" else "+") + dt_p2((if off < 0 then 0 - off else off) / 3600) + ":" + dt_p2((if off < 0 then 0 - off else off) % 3600 / 60)

## --- parsing --------------------------------------------------------------------------------------------------------
fn dt_digits(s, i, k) =
    if k == 0 then
        0
    else if i >= count(s) or at(s, i) < "0" or at(s, i) > "9" then
        0 - 1000000000
    else
        let r = dt_digits(s, i + 1, k - 1) in
        if r < 0 then
            r
        else
            (ord(at(s, i)) - 48) * dt_pow10(k - 1) + r
fn dt_pow10(k) = if k == 0 then 1 else 10 * dt_pow10(k - 1)
fn dt_ch(s, i, c) = i < count(s) and at(s, i) == c
fn dt_parse_iso(s) = let r = dt_parse(s) in if r.ok then r.t else 0 - 1
fn dt_nop() = {ok: false, t: 0, ns: 0, off: 0, zone: false}
## the date: extended YYYY-MM-DD or basic YYYYMMDD
fn dt_parse(s) =
    let y = dt_digits(s, 0, 4) in
    let ext = dt_ch(s, 4, "-") in
    let mo = if ext then dt_digits(s, 5, 2) else dt_digits(s, 4, 2) in
    let d = if ext then (if dt_ch(s, 7, "-") then dt_digits(s, 8, 2) else 0 - 1) else dt_digits(s, 6, 2) in
    let i = if ext then 10 else 8 in
    if y < 0 or mo < 1 or mo > 12 or d < 1 or d > dt_days_in_month(y, mo) then
        dt_nop()
    else if count(s) == i then
        {ok: true, t: dt_days_from_civil(y, mo, d) * 86400, ns: 0, off: 0, zone: false}
    else if not(dt_ch(s, i, "T") or dt_ch(s, i, "t") or dt_ch(s, i, " ")) then
        dt_nop()
    else
        dt_ptime(s, i + 1, dt_days_from_civil(y, mo, d) * 86400)
## the time: HH:MM[:SS] or HHMM[SS], a fraction after . or , and the zone
fn dt_ptime(s, i, base) =
    let h = dt_digits(s, i, 2) in
    let ext = dt_ch(s, i + 2, ":") in
    let mi = dt_digits(s, if ext then i + 3 else i + 2, 2) in
    let hass = if ext then dt_ch(s, i + 5, ":") else dt_digits(s, i + 4, 2) >= 0 in
    let sec = if not hass then 0 else if ext then dt_digits(s, i + 6, 2) else dt_digits(s, i + 4, 2) in
    let j = if ext then (if hass then i + 8 else i + 5) else (if hass then i + 6 else i + 4) in
    let fr = dt_frac(s, j) in
    let z = dt_pzone(s, fr.i) in
    if h < 0 or h > 24 or mi < 0 or mi > 59 or sec < 0 or sec > 60 or fr.i < 0 or z == 0 - 1000000 then
        dt_nop()
    else if h == 24 and (mi != 0 or sec != 0 or fr.ns != 0) then
        dt_nop()
    else
        {ok: true, t: base + h * 3600 + mi * 60 + sec - z, ns: fr.ns, off: z, zone: fr.i < count(s)}
## {i, ns}: the end of an optional fraction and its value in nanoseconds (i -1 when a separator has no digits)
fn dt_frac(s, i) = if dt_ch(s, i, ".") or dt_ch(s, i, ",") then dt_fracd(s, i + 1, i + 1, 0) else {i: i, ns: 0}
fn dt_fracd(s, st, i, v) =
    if i < count(s) and at(s, i) >= "0" and at(s, i) <= "9" then
        dt_fracd(s, st, i + 1, if i - st < 9 then v * 10 + ord_at(s, i) - 48 else v)
    else if i == st then
        {i: 0 - 1, ns: 0}
    else
        {i: i, ns: v * dt_pow10(if i - st < 9 then 9 - (i - st) else 0)}
## the zone at i (which must end the text) in seconds east of UTC; 0 when nothing is written; -1000000 when malformed
fn dt_pzone(s, i) =
    if i >= count(s) then
        0
    else if (dt_ch(s, i, "Z") or dt_ch(s, i, "z")) and i + 1 == count(s) then
        0
    else if dt_ch(s, i, "+") or dt_ch(s, i, "-") then
        dt_pzone2(s, i)
    else
        0 - 1000000
## +HH, +HH:MM or +HHMM, then the end of the text
fn dt_pzone2(s, i) =
    let h = dt_digits(s, i + 1, 2) in
    let colon = dt_ch(s, i + 3, ":") in
    let mi = if i + 3 == count(s) then 0 else if colon then dt_digits(s, i + 4, 2) else dt_digits(s, i + 3, 2) in
    let e = if i + 3 == count(s) then i + 3 else if colon then i + 6 else i + 5 in
    if h < 0 or h > 23 or mi < 0 or mi > 59 or e != count(s) then
        0 - 1000000
    else
        (if dt_ch(s, i, "-") then 0 - 1 else 1) * (h * 3600 + mi * 60)

## --- calendar facts and formatting ------------------------------------------------------------------------------------
fn dt_yday(t) = let r = dt_from_unix(t) in dt_days_from_civil(r.y, r.mo, r.d) - dt_days_from_civil(r.y, 1, 1) + 1
## ISO 8601 week: the week (1..53) and its year, which owns the week's Thursday
fn dt_iso_week(t) =
    let days = dt_floordiv(t, 86400) in
    let wd = (dt_weekday(t) + 6) % 7 + 1 in
    let th = (days + 4 - wd) * 86400 in
    {year: (dt_from_unix(th)).y, week: (dt_yday(th) - 1) / 7 + 1}
fn dt_wname(w) = slice("SunMonTueWedThuFriSat", w * 3, w * 3 + 3)
fn dt_wlong(w) =
    if w == 0 then
        "Sunday"
    else if w == 1 then
        "Monday"
    else if w == 2 then
        "Tuesday"
    else if w == 3 then
        "Wednesday"
    else if w == 4 then
        "Thursday"
    else if w == 5 then
        "Friday"
    else
        "Saturday"
fn dt_mname(m) = slice("JanFebMarAprMayJunJulAugSepOctNovDec", m * 3 - 3, m * 3)
fn dt_mlong(m) =
    if m == 1 then
        "January"
    else if m == 2 then
        "February"
    else if m == 3 then
        "March"
    else if m == 4 then
        "April"
    else if m == 5 then
        "May"
    else if m == 6 then
        "June"
    else if m == 7 then
        "July"
    else if m == 8 then
        "August"
    else if m == 9 then
        "September"
    else if m == 10 then
        "October"
    else if m == 11 then
        "November"
    else
        "December"
fn dt_p3(n) = if n < 10 then "00" + str(n) else if n < 100 then "0" + str(n) else str(n)
fn dt_zbasic(off) =
    let a = if off < 0 then 0 - off else off in
    (if off < 0 then "-" else "+") + dt_p2(a / 3600) + dt_p2(a % 3600 / 60)
fn dt_zext(off) =
    let a = if off < 0 then 0 - off else off in
    (if off < 0 then "-" else "+") + dt_p2(a / 3600) + ":" + dt_p2(a % 3600 / 60)
## strftime-style formatting of instant t shown at offset off (seconds east of UTC)
fn dt_format(t, off, pat) = dt_fgo(t, off, dt_from_unix(t + off), pat, 0, "")
fn dt_fgo(t, off, r, p, i, acc) =
    if i >= count(p) then
        acc
    else if at(p, i) != "%" or i + 1 >= count(p) then
        dt_fgo(t, off, r, p, i + 1, acc + at(p, i))
    else if at(p, i + 1) == ":" and i + 2 < count(p) and at(p, i + 2) == "z" then
        dt_fgo(t, off, r, p, i + 3, acc + dt_zext(off))
    else
        dt_fgo(t, off, r, p, i + 2, acc + dt_fone(t, off, r, at(p, i + 1)))
fn dt_fone(t, off, r, c) =
    if c == "Y" then
        dt_p4(r.y)
    else if c == "m" then
        dt_p2(r.mo)
    else if c == "d" then
        dt_p2(r.d)
    else if c == "H" then
        dt_p2(r.h)
    else if c == "M" then
        dt_p2(r.mi)
    else if c == "S" then
        dt_p2(r.s)
    else if c == "F" then
        dt_p4(r.y) + "-" + dt_p2(r.mo) + "-" + dt_p2(r.d)
    else if c == "T" then
        dt_p2(r.h) + ":" + dt_p2(r.mi) + ":" + dt_p2(r.s)
    else if c == "y" then
        dt_p2(r.y % 100)
    else if c == "e" then
        (if r.d < 10 then " " + str(r.d) else str(r.d))
    else if c == "I" then
        dt_p2(if r.h % 12 == 0 then 12 else r.h % 12)
    else if c == "p" then
        (if r.h < 12 then "AM" else "PM")
    else if c == "j" then
        dt_p3(dt_yday(t + off))
    else if c == "a" then
        dt_wname(dt_weekday(t + off))
    else if c == "A" then
        dt_wlong(dt_weekday(t + off))
    else if c == "b" then
        dt_mname(r.mo)
    else if c == "B" then
        dt_mlong(r.mo)
    else if c == "u" then
        str((dt_weekday(t + off) + 6) % 7 + 1)
    else if c == "w" then
        str(dt_weekday(t + off))
    else if c == "V" then
        dt_p2((dt_iso_week(t + off)).week)
    else if c == "G" then
        dt_p4((dt_iso_week(t + off)).year)
    else if c == "z" then
        dt_zbasic(off)
    else if c == "s" then
        str(t)
    else if c == "%" then
        "%"
    else
        "%" + c

## --- time zones -----------------------------------------------------------------------------------------------------
## the Unix second of the n-th weekday wd (0 Sunday) of month mo at hour h UTC; n = -1 is the last one
fn dt_nth(y, mo, wd, n, h) =
    if n > 0 then
        let first = dt_days_from_civil(y, mo, 1) in
        let fw = dt_weekday(first * 86400) in
        (first + (wd - fw + 7) % 7 + (n - 1) * 7) * 86400 + h * 3600
    else
        let last = dt_days_from_civil(y, mo, dt_days_in_month(y, mo)) in
        let lw = dt_weekday(last * 86400) in
        (last - (lw - wd + 7) % 7) * 86400 + h * 3600
## US: second Sunday of March 2:00 local to first Sunday of November 2:00 local (std offset so)
fn dt_us(so, t) =
    let y = (dt_from_unix(t + so)).y in
    let a = dt_nth(y, 3, 0, 2, 2) - so in
    let b = dt_nth(y, 11, 0, 1, 2) - so - 3600 in
    if t >= a and t < b then
        so + 3600
    else
        so
## EU: last Sunday of March 01:00 UTC to last Sunday of October 01:00 UTC
fn dt_eu(so, t) =
    let y = (dt_from_unix(t)).y in
    if t >= dt_nth(y, 3, 0, 0 - 1, 1) and t < dt_nth(y, 10, 0, 0 - 1, 1) then
        so + 3600
    else
        so
## Australia (NSW): first Sunday of October 2:00 standard to first Sunday of April 3:00 daylight (= 2:00 standard)
fn dt_au(so, t) =
    let y = (dt_from_unix(t + so)).y in
    let end1 = dt_nth(y, 4, 0, 1, 2) - so in
    let start1 = dt_nth(y, 10, 0, 1, 2) - so in
    if t < end1 or t >= start1 then
        so + 3600
    else
        so
fn dt_offset(zone, t) =
    if zone == "UTC" or zone == "Z" or zone == "GMT" then
        0
    else if zone == "America/Sao_Paulo" then
        0 - 10800
    else if zone == "America/New_York" then
        dt_us(0 - 18000, t)
    else if zone == "America/Chicago" then
        dt_us(0 - 21600, t)
    else if zone == "America/Denver" then
        dt_us(0 - 25200, t)
    else if zone == "America/Los_Angeles" then
        dt_us(0 - 28800, t)
    else if zone == "Europe/London" or zone == "Europe/Lisbon" then
        dt_eu(0, t)
    else if zone == "Europe/Paris" or zone == "Europe/Berlin" or zone == "Europe/Madrid" or zone == "Europe/Rome" then
        dt_eu(3600, t)
    else if zone == "Asia/Tokyo" then
        32400
    else if zone == "Asia/Shanghai" then
        28800
    else if zone == "Asia/Kolkata" then
        19800
    else if zone == "Australia/Sydney" then
        dt_au(36000, t)
    else
        let z = dt_pzone(zone, 0) in
        if z == 0 - 1000000 then
            ctfail("datetime: unknown time zone '" + zone + "'\n")
        else
            z
fn dt_local(zone, t) = dt_from_unix(t + dt_offset(zone, t))
fn dt_iso_local(zone, t) = let off = dt_offset(zone, t) in dt_fmt(dt_from_unix(t + off)) + dt_zfmt(off)
