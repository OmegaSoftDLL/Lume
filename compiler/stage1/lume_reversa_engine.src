        "[Lume-Reversa 7-Layer Engine] Desempacotado npp.8.9.8.1.Installer.x64.exe (NSIS Solid LZMA 7z -> 94 arquivos, 13 binarios PE64, " + str(arch.total_functions) + " funcoes).\r\n" +
        "[Lume Native PE64 GUI] Executavel grafico compilado 100% pela Lume (Zero C#/.NET/C) com protecao P33 Anti-REA (secao .data criptografada com XOR k=178 em disco e descriptografada no _start).\r\n", 384, k) in
    let s_code = rv_str_slot_hex(
        "## ============================================================================\r\n" +
        "## LumePad++ Sovereign Edition (100% Pure Lume Reconstructed Program)\r\n" +
        "## Extraido do Instalador NSIS 7z: 13 Binarios PE64 | " + str(arch.total_functions) + " Funcoes Reconstruidas\r\n" +
