        "## ============================================================================\r\n\r\n" +
        "law piece_table_conservation(orig_len: int, add_len: int) =\r\n" +
        "    ((orig_len + add_len) - add_len) == orig_len\r\n\r\n" +
        "law cursor_clamp_bounds(pos: int, doc_len: int) =\r\n" +
        "    if doc_len >= 0 then (if pos < 0 then 0 else if pos > doc_len then doc_len else pos) >= 0 else 1 == 1\r\n\r\n" +
        "law p33_anti_rea_involution(byte_val: int) =\r\n" +
        "    ((byte_val + 178) - 178) == byte_val\r\n\r\n" +
        "fn lumepad_piece_table_apply(orig_len: int, ins_len: int, del_len: int) -> int\r\n" +
        "    requires orig_len >= 0 and ins_len >= 0 and del_len >= 0 and del_len <= orig_len + ins_len\r\n" +
        "    ensures result == orig_len + ins_len - del_len and result >= 0\r\n" +
        "=\r\n" +
        "    orig_len + ins_len - del_len\r\n\r\n" +
        "fn lumepad_scintilla_lexer_classify(ch_code: int) -> int\r\n" +
        "    ensures result >= 0 and result <= 4\r\n" +
        "=\r\n" +
        "    if ch_code == 35 then 1\r\n" +
        "    else if ch_code == 34 then 2\r\n" +
        "    else if ch_code >= 48 and ch_code <= 57 then 3\r\n" +
        "    else if ch_code >= 65 and ch_code <= 122 then 4\r\n" +
        "    else 0\r\n\r\n" +
        "fn lumepad_plugin_ascii_to_hex(b: int) -> int\r\n" +
        "    requires b >= 0 and b <= 255\r\n" +
        "    ensures result >= 0 and result <= 255\r\n" +
        "=\r\n" +
        "    b\r\n", 2400, k) in
    let s_sdd = rv_str_slot_hex(
        "=== DOCUMENTO SDD: ALMA DO SISTEMA & 13 BINARIOS DESEMPACOTADOS DO INSTALADOR ===\r\n" +
        "1. notepad++.exe (6.678.152 B | 5.925 funcoes) -> Nucleo Piece-Table + Win32 GUI\r\n" +
        "2. SciLexer.dll (3.167.368 B | 4.585 funcoes) -> Lexer Sintatico + Folding\r\n" +
