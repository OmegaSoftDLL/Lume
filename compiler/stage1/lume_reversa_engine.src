fn rv_pe64_data_hex(scout: ReversaScoutReport, arch: ReversaArchitectureMap, protect_mode: int) -> str =
    let k = if protect_mode == 1 then 178 else 0 in
    let s_title = rv_str_slot_hex("LumePad++ v8.9.8.1 Sovereign Edition (100% Nativo Lume PE64 GUI | P33 Anti-REA Ativo | " + str(arch.total_functions) + " Funcoes Reconstruidas)", 128, k) in
    let s_status = rv_str_slot_hex(" PRONTO | 100% Binario Nativo Lume PE32+ x86-64 GUI (Zero C#/.NET) | 13 Binarios Desempacotados | " + str(arch.total_functions) + " Funcoes | P33 Anti-REA: XOR k=178 + MBA + CFF + LUME_SEAL:178", 160, k) in
