fn lct_kat_aead() = let k0 = lct_kat_new() in let a0k = lct_hex_to_bytes("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f") in let a0n = lct_hex_to_bytes("070000004041424344454647") in let a0a = lct_hex_to_bytes("50515253c0c1c2c3c4c5c6c7") in let a0p = lct_hex_to_bytes("4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e") in let a0c = lct_hex_to_bytes("d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116") in let a0t = lct_hex_to_bytes("1ae10b594f09e26a7e902ecbd0600691") in let a0s = lct_aead_seal(a0k, a0n, a0a, a0p) in let k1 = lct_kat_hex(k0, "AEAD seal ciphertext RFC 8439 2.8.2", a0s.ct, "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116") in let k2 = lct_kat_hex(k1, "AEAD seal tag RFC 8439 2.8.2", a0s.tag, "1ae10b594f09e26a7e902ecbd0600691") in let a0o = lct_aead_open(a0k, a0n, a0a, a0c, a0t) in let k3 = lct_kat_int(k2, "AEAD open accepts RFC 8439 2.8.2", a0o.ok, 1) in let k4 = lct_kat_hex(k3, "AEAD open plaintext RFC 8439 2.8.2", a0o.pt, "4c616469657320616e642047656e746c656d656e206f662074686520636c617373206f66202739393a204966204920636f756c64206f6666657220796f75206f6e6c79206f6e652074697020666f7220746865206675747572652c2073756e73637265656e20776f756c642062652069742e") in let k5 = lct_kat_int(k4, "AEAD rejects a flipped tag bit RFC 8439 2.8.2", (lct_aead_open(a0k, a0n, a0a, a0c, lct_flip(a0t, 15, 128))).ok, 0) in let k6 = lct_kat_int(k5, "AEAD rejects a flipped first tag bit RFC 8439 2.8.2", (lct_aead_open(a0k, a0n, a0a, a0c, lct_flip(a0t, 0, 1))).ok, 0) in let k7 = lct_kat_int(k6, "AEAD rejects a flipped ciphertext bit RFC 8439 2.8.2", (lct_aead_open(a0k, a0n, a0a, lct_flip(a0c, 7, 1), a0t)).ok, 0) in let k8 = lct_kat_int(k7, "AEAD rejects altered AAD RFC 8439 2.8.2", (lct_aead_open(a0k, a0n, lct_flip(a0a, 0, 2), a0c, a0t)).ok, 0) in let k9 = lct_kat_int(k8, "AEAD rejects a wrong nonce RFC 8439 2.8.2", (lct_aead_open(a0k, lct_flip(a0n, 11, 1), a0a, a0c, a0t)).ok, 0) in let k10 = lct_kat_int(k9, "AEAD rejects a wrong key RFC 8439 2.8.2", (lct_aead_open(lct_flip(a0k, 31, 64), a0n, a0a, a0c, a0t)).ok, 0) in let k11 = lct_kat_int(k10, "AEAD rejects a truncated ciphertext RFC 8439 2.8.2", (lct_aead_open(a0k, a0n, a0a, lct_take(a0c, 113), a0t)).ok, 0) in let k12 = lct_kat_int(k11, "AEAD wire form round trip RFC 8439 2.8.2", (lct_aead_open_bytes(a0k, a0n, a0a, lct_aead_seal_bytes(a0k, a0n, a0a, a0p))).ok, 1) in let a1k = lct_hex_to_bytes("1c9240a5eb55d38af333888604f6b5f0473917c1402b80099dca5cbc207075c0") in let a1n = lct_hex_to_bytes("000000000102030405060708") in let a1a = lct_hex_to_bytes("f33388860000000000004e91") in let a1p = lct_hex_to_bytes("") in let a1c = lct_hex_to_bytes("") in let a1t = lct_hex_to_bytes("eead9d67890cbb22392336fea1851f38") in let a1s = lct_aead_seal(a1k, a1n, a1a, a1p) in let k13 = lct_kat_hex(k12, "AEAD seal ciphertext RFC 8439 A.5", a1s.ct, "") in let k14 = lct_kat_hex(k13, "AEAD seal tag RFC 8439 A.5", a1s.tag, "eead9d67890cbb22392336fea1851f38") in let a1o = lct_aead_open(a1k, a1n, a1a, a1c, a1t) in let k15 = lct_kat_int(k14, "AEAD open accepts RFC 8439 A.5", a1o.ok, 1) in let k16 = lct_kat_hex(k15, "AEAD open plaintext RFC 8439 A.5", a1o.pt, "") in let k17 = lct_kat_int(k16, "AEAD rejects a flipped tag bit RFC 8439 A.5", (lct_aead_open(a1k, a1n, a1a, a1c, lct_flip(a1t, 15, 128))).ok, 0) in let k18 = lct_kat_int(k17, "AEAD rejects a flipped first tag bit RFC 8439 A.5", (lct_aead_open(a1k, a1n, a1a, a1c, lct_flip(a1t, 0, 1))).ok, 0) in let k19 = lct_kat_int(k18, "AEAD rejects a flipped ciphertext bit RFC 8439 A.5", (lct_aead_open(a1k, a1n, a1a, lct_flip(a1c, 7, 1), a1t)).ok, 0) in let k20 = lct_kat_int(k19, "AEAD rejects altered AAD RFC 8439 A.5", (lct_aead_open(a1k, a1n, lct_flip(a1a, 0, 2), a1c, a1t)).ok, 0) in let k21 = lct_kat_int(k20, "AEAD rejects a wrong nonce RFC 8439 A.5", (lct_aead_open(a1k, lct_flip(a1n, 11, 1), a1a, a1c, a1t)).ok, 0) in let k22 = lct_kat_int(k21, "AEAD rejects a wrong key RFC 8439 A.5", (lct_aead_open(lct_flip(a1k, 31, 64), a1n, a1a, a1c, a1t)).ok, 0) in let k23 = lct_kat_int(k22, "AEAD rejects a truncated ciphertext RFC 8439 A.5", (lct_aead_open(a1k, a1n, a1a, lct_take(a1c, 264), a1t)).ok, 0) in let k24 = lct_kat_int(k23, "AEAD wire form round trip RFC 8439 A.5", (lct_aead_open_bytes(a1k, a1n, a1a, lct_aead_seal_bytes(a1k, a1n, a1a, a1p))).ok, 1) in let k25 = lct_kat_int(k24, "AEAD rejects a sealed text shorter than a tag", (lct_aead_open_bytes(a0k, a0n, a0a, lct_take(a0t, 15))).ok, 0) in k25
## pk from the seed, deterministic signature, verification, and rejection of an altered message, R, S and key
fn lct_kat_ed25519_one(k, name, seed, pk, msg, sig, full) = if k.err != "" then k else let sd = lct_hex_to_bytes(seed) in let m = lct_hex_to_bytes(msg) in let p = lct_hex_to_bytes(pk) in let s = lct_hex_to_bytes(sig) in let k1 = lct_kat_hex(k, name + " public key", lct_ed25519_public_key(sd), pk) in let k2 = lct_kat_hex(k1, name + " signature", lct_ed25519_sign(sd, m), sig) in let k3 = lct_kat_int(k2, name + " verify", lct_ed25519_verify(p, m, s), 1) in if full == 0 then k3 else let k4 = lct_kat_int(k3, name + " rejects an altered message", lct_ed25519_verify(p, lct_app(m, Cons(0, Nil)), s), 0) in let k5 = lct_kat_int(k4, name + " rejects an altered R", lct_ed25519_verify(p, m, lct_flip(s, 3, 4)), 0) in let k6 = lct_kat_int(k5, name + " rejects an altered S", lct_ed25519_verify(p, m, lct_flip(s, 40, 1)), 0) in lct_kat_int(k6, name + " rejects another public key", lct_ed25519_verify(lct_flip(p, 5, 16), m, s), 0)
