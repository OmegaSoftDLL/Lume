## lcrypto_tls.src -- sovereign cryptography and TLS 1.3, 100% Lume (no C, no OpenSSL).
##
##   SHA-256 / SHA-512 (FIPS 180-4), HMAC-SHA256 (RFC 2104 / 4231), HKDF-SHA256 (RFC 5869),
##   ChaCha20, Poly1305 and the ChaCha20-Poly1305 AEAD (RFC 8439), Ed25519 (RFC 8032), X25519 (RFC 7748),
##   the TLS 1.3 key schedule, encrypted record layer and 1-RTT handshake state machines (RFC 8446).
##
## Bytes are lists of ints 0..255 (`lct_hex_to_bytes` / `lct_bytes_to_hex` convert). Lume integers are signed 64-bit
## and `+ - *` trap on overflow, so 32-bit words are kept in 0..2^32-1 behind explicit masks, 64-bit words (SHA-512)
## use the wrapping `+%` and a logical shift built from the arithmetic `bit_shr`, Poly1305 runs on five 26-bit limbs
## and the field GF(2^255 - 19) of Ed25519 and X25519 on sixteen 16-bit limbs (the TweetNaCl layout), where every
## partial product fits.
##
## Constant time: no branch, no table index and no division depends on a secret. Secret-dependent choices are
## masked selections (`lct_fe_sel`), the Ed25519 scalar multiplication is a fixed 256-step ladder of add / double with
## masked swaps, X25519 is a fixed 255-step Montgomery ladder with masked swaps and its all-zero check ORs every byte,
## the scalar reduction mod L is a fixed 512-step shift / conditional-subtract with a masked select, and tags and
## Finished values are compared by accumulating the XOR of every byte (`lct_ct_eq`). Branches only test public data:
## lengths, loop counters, limb positions, handshake message types and states, and the final accept / reject bit.
## This claim is about the Lume-level operations only: the timing of the host allocator, of the code the compiler
## emits for `*` (with its overflow check) and of the machine underneath is outside it and has not been measured.
##
## TLS 1.3 scope (details and the list of what is NOT implemented are at the handshake section): one suite
## (TLS_CHACHA20_POLY1305_SHA256), one group (x25519), Ed25519 server authentication with a pinned raw public key --
## no X.509 parsing or path validation --, no PSK / resumption / 0-RTT / HelloRetryRequest / client certificates /
## KeyUpdate, and no random number generator: randoms and ephemeral private keys are supplied by the caller.
##
## `lct_kat_*` run the official vectors (extracted from the RFC texts and cross-checked against independent
## implementations when this file was generated); the unit tests and tests/harness/crypto_tls_gate.src call them.

## --- byte lists -----------------------------------------------------------------------------------------------
fn lct_rev_acc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => lct_rev_acc(t, Cons(h, acc))
fn lct_rev(xs) = lct_rev_acc(xs, Nil)
fn lct_isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn lct_app(xs, ys) = if lct_isnil(ys) == 1 then xs else lct_rev_acc(lct_rev(xs), ys)
fn lct_len_acc(xs, n) = match xs
    Nil        => n
    Cons(h, t) => lct_len_acc(t, n + 1)
fn lct_len(xs) = lct_len_acc(xs, 0)
fn lct_hd(xs) = match xs
    Nil        => 0
    Cons(h, t) => h
fn lct_tl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => t
fn lct_take1(xs, n, acc) = match xs
    Nil        => {a: lct_rev(acc), b: Nil}
    Cons(h, t) => lct_take_acc(t, n - 1, Cons(h, acc))
fn lct_take_acc(xs, n, acc) = if n <= 0 then {a: lct_rev(acc), b: xs} else lct_take1(xs, n, acc)
## {a: the first n elements, b: the rest}
fn lct_split(xs, n) = lct_take_acc(xs, n, Nil)
fn lct_take(xs, n) = (lct_split(xs, n)).a
fn lct_drop(xs, n) = if n <= 0 then xs else lct_drop(lct_tl(xs), n - 1)
fn lct_repeat(v, n, acc) = if n <= 0 then acc else lct_repeat(v, n - 1, Cons(v, acc))
fn lct_zeros(n) = lct_repeat(0, n, Nil)
fn lct_concat(xss) = match xss
    Nil        => Nil
    Cons(h, t) => lct_app(h, lct_concat(t))
fn lct_xor_lists_acc(a, b, acc) = match a
    Nil        => lct_rev(acc)
    Cons(h, t) => lct_xor_lists_acc(t, lct_tl(b), Cons(bit_xor(h, lct_hd(b)), acc))
fn lct_xor_lists(a, b) = lct_xor_lists_acc(a, b, Nil)
## xor `mask` into the byte at position idx (the tamper tests use it)
fn lct_flip(bs, idx, mask) = match bs
    Nil        => Nil
    Cons(h, t) => if idx == 0 then Cons(bit_xor(h, mask), t) else Cons(h, lct_flip(t, idx - 1, mask))
fn lct_hexval(o) = if o >= 48 and o <= 57 then o - 48 else if o >= 97 and o <= 102 then o - 87 else if o >= 65 and o <= 70 then o - 55 else 0
fn lct_hex_loop(s, i, acc) = if i < 0 then acc else lct_hex_loop(s, i - 2, Cons(lct_hexval(ord(at(s, i))) * 16 + lct_hexval(ord(at(s, i + 1))), acc))
fn lct_hex_to_bytes(s) = lct_hex_loop(s, count(s) - 2, Nil)
fn lct_hex_byte(b) = at("0123456789abcdef", bit_and(bit_shr(b, 4), 15)) + at("0123456789abcdef", bit_and(b, 15))
fn lct_b2h(bs, acc) = match bs
    Nil        => acc
    Cons(h, t) => lct_b2h(t, acc + lct_hex_byte(h))
fn lct_bytes_to_hex(bs) = lct_b2h(bs, "")
fn lct_str_loop(s, i, acc) = if i < 0 then acc else lct_str_loop(s, i - 1, Cons(ord(at(s, i)), acc))
fn lct_str_to_bytes(s) = lct_str_loop(s, count(s) - 1, Nil)
## constant-time equality of two byte strings of public length: every byte is read, the differences are OR-ed
fn lct_ct_acc(a, b, acc) = match a
    Nil        => acc
    Cons(h, t) => lct_ct_acc(t, lct_tl(b), bit_or(acc, bit_xor(h, lct_hd(b))))
fn lct_ct_eq(a, b) = if lct_len(a) != lct_len(b) then 0 else if lct_ct_acc(a, b, 0) == 0 then 1 else 0

## --- verified length / framing arithmetic (QF_LIA contracts and laws) -------------------------------------------
fn lct_sha256_pad_zeros(left: int) -> int
    requires left >= 0 and left <= 63
    ensures result >= 0 and result <= 63
= if left <= 55 then 55 - left else 119 - left
fn lct_sha512_pad_zeros(left: int) -> int
    requires left >= 0 and left <= 127
    ensures result >= 0 and result <= 127
= if left <= 111 then 111 - left else 239 - left
fn lct_aead_sealed_len(plain_len: int) -> int
    requires plain_len >= 0
    ensures result == plain_len + 16 and result >= 16
= plain_len + 16
fn lct_tls13_record_len(data_len: int) -> int
    requires data_len >= 0 and data_len <= 16384
    ensures result == data_len + 22 and result >= 22 and result <= 16406
= 5 + data_len + 1 + 16
fn lct_tls13_seq_next(seq: int) -> int
    requires seq >= 0 and seq < 4611686018427387903
    ensures result == seq + 1 and result > seq
= seq + 1
fn lct_pad16(n: int) -> int
    requires n >= 0
    ensures result >= 0 and result <= 15
= let r = n % 16 in if r == 0 then 0 else 16 - r
law lct_sha256_pad_fills_block(left: int) = if left >= 0 and left <= 55 then left + 1 + (55 - left) + 8 == 64 else if left >= 56 and left <= 63 then left + 1 + (119 - left) + 8 == 128 else 1 == 1
law lct_sha512_pad_fills_block(left: int) = if left >= 0 and left <= 111 then left + 1 + (111 - left) + 16 == 128 else if left >= 112 and left <= 127 then left + 1 + (239 - left) + 16 == 256 else 1 == 1
law lct_be16_roundtrip(n: int) = if n >= 0 and n <= 65535 then (n / 256) * 256 + n % 256 == n else 1 == 1
law lct_be16_hi_is_a_byte(n: int) = if n >= 0 and n <= 65535 then n / 256 >= 0 and n / 256 <= 255 else 1 == 1
law lct_rotation_complement(n: int) = if n >= 1 and n <= 31 then 32 - n >= 1 and 32 - n <= 31 else 1 == 1
law lct_tls13_record_overhead(data_len: int) = if data_len >= 0 and data_len <= 16384 then 5 + (data_len + 1) + 16 - data_len == 22 else 1 == 1
law lct_poly1305_limbs_cover_130_bits(k: int) = if k == 5 then 26 * k == 130 else 1 == 1
law lct_ed25519_limbs_cover_256_bits(k: int) = if k == 16 then 16 * k == 256 else 1 == 1

## --- 32-bit words -------------------------------------------------------------------------------------------------
fn lct_rotr32(x, n) = bit_or(bit_shr(x, n), bit_and(bit_shl(x, 32 - n), 4294967295))
fn lct_rotl32(x, n) = bit_or(bit_and(bit_shl(x, n), 4294967295), bit_shr(x, 32 - n))
fn lct_be32_1(bs, k, acc) = match bs
    Cons(a, Cons(b, Cons(c, Cons(d, r)))) => lct_be32(r, k - 1, Cons(a * 16777216 + b * 65536 + c * 256 + d, acc))
    _                                     => {w: acc, rest: Nil}
## read k big-endian 32-bit words: {w: the words, LAST ONE FIRST, rest}
fn lct_be32(bs, k, acc) = if k <= 0 then {w: acc, rest: bs} else lct_be32_1(bs, k, acc)
fn lct_le32_take(bs) = match bs
    Cons(a, Cons(b, Cons(c, Cons(d, r)))) => {v: a + b * 256 + c * 65536 + d * 16777216, rest: r}
    _                                     => {v: 0, rest: Nil}
fn lct_be32_push(w, acc) = Cons(bit_shr(w, 24), Cons(bit_and(bit_shr(w, 16), 255), Cons(bit_and(bit_shr(w, 8), 255), Cons(bit_and(w, 255), acc))))
fn lct_le32_push(w, acc) = Cons(bit_and(w, 255), Cons(bit_and(bit_shr(w, 8), 255), Cons(bit_and(bit_shr(w, 16), 255), Cons(bit_and(bit_shr(w, 24), 255), acc))))
fn lct_be64_push(v, acc) = Cons(bit_and(bit_shr(v, 56), 255), Cons(bit_and(bit_shr(v, 48), 255), Cons(bit_and(bit_shr(v, 40), 255), Cons(bit_and(bit_shr(v, 32), 255), Cons(bit_and(bit_shr(v, 24), 255), Cons(bit_and(bit_shr(v, 16), 255), Cons(bit_and(bit_shr(v, 8), 255), Cons(bit_and(v, 255), acc))))))))
fn lct_le64_push(v, acc) = Cons(bit_and(v, 255), Cons(bit_and(bit_shr(v, 8), 255), Cons(bit_and(bit_shr(v, 16), 255), Cons(bit_and(bit_shr(v, 24), 255), Cons(bit_and(bit_shr(v, 32), 255), Cons(bit_and(bit_shr(v, 40), 255), Cons(bit_and(bit_shr(v, 48), 255), Cons(bit_and(bit_shr(v, 56), 255), acc))))))))
fn lct_nth(xs, i) = match xs
    Nil        => 0
    Cons(h, t) => if i <= 0 then h else lct_nth(t, i - 1)

## --- SHA-256 (FIPS 180-4) -----------------------------------------------------------------------------------------
## the schedule is kept newest word first, so W[t-2], W[t-7], W[t-15], W[t-16] are at depths 1, 6, 14, 15
fn lct_s256_expand(t, w) = if t >= 64 then w else let x15 = lct_nth(w, 14) in let x2 = lct_nth(w, 1) in lct_s256_expand(t + 1, Cons(bit_and(lct_nth(w, 15) + bit_xor(bit_xor(lct_rotr32(x15, 7), lct_rotr32(x15, 18)), bit_shr(x15, 3)) + lct_nth(w, 6) + bit_xor(bit_xor(lct_rotr32(x2, 17), lct_rotr32(x2, 19)), bit_shr(x2, 10)), 4294967295), w))
## (W newest first) + (K last first) -> W[t] + K[t], oldest first
fn lct_zip_add_rev(ws, ks, acc) = match ws
    Nil        => acc
    Cons(w, r) => lct_zip_add_rev(r, lct_tl(ks), Cons(w + lct_hd(ks), acc))
fn lct_s256_rounds(kw, a, b, c, d, e, f, g, h) = match kw
    Nil        => {a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h}
    Cons(x, r) => let t1 = h + bit_xor(bit_xor(lct_rotr32(e, 6), lct_rotr32(e, 11)), lct_rotr32(e, 25)) + bit_xor(g, bit_and(e, bit_xor(f, g))) + x in let t2 = bit_xor(bit_xor(lct_rotr32(a, 2), lct_rotr32(a, 13)), lct_rotr32(a, 22)) + bit_or(bit_and(a, b), bit_and(c, bit_or(a, b))) in lct_s256_rounds(r, bit_and(t1 + t2, 4294967295), a, b, c, bit_and(d + t1, 4294967295), e, f, g)
fn lct_s256_block(w16, st) = let r = lct_s256_rounds(lct_zip_add_rev(lct_s256_expand(16, w16), lct_sha256_k_rev(), Nil), st.a, st.b, st.c, st.d, st.e, st.f, st.g, st.h) in {a: bit_and(st.a + r.a, 4294967295), b: bit_and(st.b + r.b, 4294967295), c: bit_and(st.c + r.c, 4294967295), d: bit_and(st.d + r.d, 4294967295), e: bit_and(st.e + r.e, 4294967295), f: bit_and(st.f + r.f, 4294967295), g: bit_and(st.g + r.g, 4294967295), h: bit_and(st.h + r.h, 4294967295)}
fn lct_s256_tail(bs, st) = if lct_isnil(bs) == 1 then st else let r = lct_be32(bs, 16, Nil) in lct_s256_tail(r.rest, lct_s256_block(r.w, st))
fn lct_s256_run(bs, left, total, st) = if left >= 64 then (let r = lct_be32(bs, 16, Nil) in lct_s256_run(r.rest, left - 64, total, lct_s256_block(r.w, st))) else lct_s256_tail(lct_app(bs, Cons(128, lct_repeat(0, lct_sha256_pad_zeros(left), lct_be64_push(total * 8, Nil)))), st)
fn lct_sha256(bs) = let n = lct_len(bs) in let st = lct_s256_run(bs, n, n, {a: 1779033703, b: 3144134277, c: 1013904242, d: 2773480762, e: 1359893119, f: 2600822924, g: 528734635, h: 1541459225}) in lct_be32_push(st.a, lct_be32_push(st.b, lct_be32_push(st.c, lct_be32_push(st.d, lct_be32_push(st.e, lct_be32_push(st.f, lct_be32_push(st.g, lct_be32_push(st.h, Nil))))))))

## --- SHA-512 (FIPS 180-4): 64-bit words in signed ints, wrapping adds, logical shifts built on the arithmetic one ---
fn lct_w64(hi, lo) = bit_or(bit_shl(hi, 32), lo)
fn lct_lshr64(x, n) = bit_and(bit_shr(x, n), bit_shr(9223372036854775807, n - 1))
fn lct_rotr64(x, n) = bit_or(lct_lshr64(x, n), bit_shl(x, 64 - n))
fn lct_s512_expand(t, w) = if t >= 80 then w else let x15 = lct_nth(w, 14) in let x2 = lct_nth(w, 1) in lct_s512_expand(t + 1, Cons(lct_nth(w, 15) +% bit_xor(bit_xor(lct_rotr64(x15, 1), lct_rotr64(x15, 8)), lct_lshr64(x15, 7)) +% lct_nth(w, 6) +% bit_xor(bit_xor(lct_rotr64(x2, 19), lct_rotr64(x2, 61)), lct_lshr64(x2, 6)), w))
fn lct_zip_addw_rev(ws, ks, acc) = match ws
    Nil        => acc
    Cons(w, r) => lct_zip_addw_rev(r, lct_tl(ks), Cons(w +% lct_hd(ks), acc))
fn lct_s512_rounds(kw, a, b, c, d, e, f, g, h) = match kw
    Nil        => {a: a, b: b, c: c, d: d, e: e, f: f, g: g, h: h}
    Cons(x, r) => let t1 = h +% bit_xor(bit_xor(lct_rotr64(e, 14), lct_rotr64(e, 18)), lct_rotr64(e, 41)) +% bit_xor(g, bit_and(e, bit_xor(f, g))) +% x in let t2 = bit_xor(bit_xor(lct_rotr64(a, 28), lct_rotr64(a, 34)), lct_rotr64(a, 39)) +% bit_or(bit_and(a, b), bit_and(c, bit_or(a, b))) in lct_s512_rounds(r, t1 +% t2, a, b, c, d +% t1, e, f, g)
fn lct_s512_pair(ws, acc) = match ws
    Cons(lo, Cons(hi, r)) => lct_s512_pair(r, Cons(lct_w64(hi, lo), acc))
    _                     => acc
fn lct_s512_block(w32, st) = let r = lct_s512_rounds(lct_zip_addw_rev(lct_s512_expand(16, lct_rev(lct_s512_pair(w32, Nil))), lct_sha512_k_rev(), Nil), st.a, st.b, st.c, st.d, st.e, st.f, st.g, st.h) in {a: st.a +% r.a, b: st.b +% r.b, c: st.c +% r.c, d: st.d +% r.d, e: st.e +% r.e, f: st.f +% r.f, g: st.g +% r.g, h: st.h +% r.h}
fn lct_s512_tail(bs, st) = if lct_isnil(bs) == 1 then st else let r = lct_be32(bs, 32, Nil) in lct_s512_tail(r.rest, lct_s512_block(r.w, st))
fn lct_s512_run(bs, left, total, st) = if left >= 128 then (let r = lct_be32(bs, 32, Nil) in lct_s512_run(r.rest, left - 128, total, lct_s512_block(r.w, st))) else lct_s512_tail(lct_app(bs, Cons(128, lct_repeat(0, lct_sha512_pad_zeros(left) + 8, lct_be64_push(total * 8, Nil)))), st)
fn lct_sha512(bs) = let n = lct_len(bs) in let st = lct_s512_run(bs, n, n, {a: lct_w64(1779033703, 4089235720), b: lct_w64(3144134277, 2227873595), c: lct_w64(1013904242, 4271175723), d: lct_w64(2773480762, 1595750129), e: lct_w64(1359893119, 2917565137), f: lct_w64(2600822924, 725511199), g: lct_w64(528734635, 4215389547), h: lct_w64(1541459225, 327033209)}) in lct_be64_push(st.a, lct_be64_push(st.b, lct_be64_push(st.c, lct_be64_push(st.d, lct_be64_push(st.e, lct_be64_push(st.f, lct_be64_push(st.g, lct_be64_push(st.h, Nil))))))))

## --- HMAC-SHA256 (RFC 2104) and HKDF-SHA256 (RFC 5869) ---------------------------------------------------------------
fn lct_hmac_pad(key, c, n, acc) = if n <= 0 then lct_rev(acc) else lct_hmac_pad(lct_tl(key), c, n - 1, Cons(bit_xor(lct_hd(key), c), acc))
fn lct_hmac_sha256(key, msg) = let k = if lct_len(key) > 64 then lct_sha256(key) else key in lct_sha256(lct_app(lct_hmac_pad(k, 92, 64, Nil), lct_sha256(lct_app(lct_hmac_pad(k, 54, 64, Nil), msg))))
fn lct_hkdf_extract(salt, ikm) = lct_hmac_sha256(if lct_isnil(salt) == 1 then lct_zeros(32) else salt, ikm)
fn lct_hkdf_x(prk, info, prev, i, left, out) = if left <= 0 then out else let t = lct_hmac_sha256(prk, lct_app(prev, lct_app(info, Cons(i, Nil)))) in lct_hkdf_x(prk, info, t, i + 1, left - 32, lct_app(out, t))
fn lct_hkdf_expand(prk, info, len) = lct_take(lct_hkdf_x(prk, info, Nil, 1, len, Nil), len)
fn lct_hkdf(salt, ikm, info, len) = lct_hkdf_expand(lct_hkdf_extract(salt, ikm), info, len)

## --- ChaCha20 (RFC 8439 section 2.1 - 2.4) ----------------------------------------------------------------------------
fn lct_cc_qr(a, b, c, d) = let a1 = bit_and(a + b, 4294967295) in let d1 = lct_rotl32(bit_xor(d, a1), 16) in let c1 = bit_and(c + d1, 4294967295) in let b1 = lct_rotl32(bit_xor(b, c1), 12) in let a2 = bit_and(a1 + b1, 4294967295) in let d2 = lct_rotl32(bit_xor(d1, a2), 8) in let c2 = bit_and(c1 + d2, 4294967295) in {a: a2, b: lct_rotl32(bit_xor(b1, c2), 7), c: c2, d: d2}
## one column round and one diagonal round
fn lct_cc_dround(s) = let q0 = lct_cc_qr(s.x0, s.x4, s.x8, s.x12) in let q1 = lct_cc_qr(s.x1, s.x5, s.x9, s.x13) in let q2 = lct_cc_qr(s.x2, s.x6, s.x10, s.x14) in let q3 = lct_cc_qr(s.x3, s.x7, s.x11, s.x15) in let d0 = lct_cc_qr(q0.a, q1.b, q2.c, q3.d) in let d1 = lct_cc_qr(q1.a, q2.b, q3.c, q0.d) in let d2 = lct_cc_qr(q2.a, q3.b, q0.c, q1.d) in let d3 = lct_cc_qr(q3.a, q0.b, q1.c, q2.d) in {x0: d0.a, x1: d1.a, x2: d2.a, x3: d3.a, x4: d3.b, x5: d0.b, x6: d1.b, x7: d2.b, x8: d2.c, x9: d3.c, x10: d0.c, x11: d1.c, x12: d1.d, x13: d2.d, x14: d3.d, x15: d0.d}
fn lct_cc_iter(s, n) = if n <= 0 then s else lct_cc_iter(lct_cc_dround(s), n - 1)
## the key and nonce as little-endian words
fn lct_cc_key(key, nonce) = let a0 = lct_le32_take(key) in let a1 = lct_le32_take(a0.rest) in let a2 = lct_le32_take(a1.rest) in let a3 = lct_le32_take(a2.rest) in let a4 = lct_le32_take(a3.rest) in let a5 = lct_le32_take(a4.rest) in let a6 = lct_le32_take(a5.rest) in let a7 = lct_le32_take(a6.rest) in let n0 = lct_le32_take(nonce) in let n1 = lct_le32_take(n0.rest) in let n2 = lct_le32_take(n1.rest) in {k0: a0.v, k1: a1.v, k2: a2.v, k3: a3.v, k4: a4.v, k5: a5.v, k6: a6.v, k7: a7.v, n0: n0.v, n1: n1.v, n2: n2.v}
fn lct_cc_block(ks, ctr) = let i = {x0: 1634760805, x1: 857760878, x2: 2036477234, x3: 1797285236, x4: ks.k0, x5: ks.k1, x6: ks.k2, x7: ks.k3, x8: ks.k4, x9: ks.k5, x10: ks.k6, x11: ks.k7, x12: bit_and(ctr, 4294967295), x13: ks.n0, x14: ks.n1, x15: ks.n2} in let s = lct_cc_iter(i, 10) in lct_le32_push(bit_and(s.x0 + i.x0, 4294967295), lct_le32_push(bit_and(s.x1 + i.x1, 4294967295), lct_le32_push(bit_and(s.x2 + i.x2, 4294967295), lct_le32_push(bit_and(s.x3 + i.x3, 4294967295), lct_le32_push(bit_and(s.x4 + i.x4, 4294967295), lct_le32_push(bit_and(s.x5 + i.x5, 4294967295), lct_le32_push(bit_and(s.x6 + i.x6, 4294967295), lct_le32_push(bit_and(s.x7 + i.x7, 4294967295), lct_le32_push(bit_and(s.x8 + i.x8, 4294967295), lct_le32_push(bit_and(s.x9 + i.x9, 4294967295), lct_le32_push(bit_and(s.x10 + i.x10, 4294967295), lct_le32_push(bit_and(s.x11 + i.x11, 4294967295), lct_le32_push(bit_and(s.x12 + i.x12, 4294967295), lct_le32_push(bit_and(s.x13 + i.x13, 4294967295), lct_le32_push(bit_and(s.x14 + i.x14, 4294967295), lct_le32_push(bit_and(s.x15 + i.x15, 4294967295), Nil))))))))))))))))
fn lct_chacha20_block(key, counter, nonce) = lct_cc_block(lct_cc_key(key, nonce), counter)
fn lct_cc_xor_take1(data, k, kr, acc) = match data
    Nil        => {rest: Nil, acc: acc}
    Cons(d, r) => lct_cc_xor_take(r, kr, Cons(bit_xor(d, k), acc))
fn lct_cc_xor_take(data, kb, acc) = match kb
    Nil        => {rest: data, acc: acc}
    Cons(k, r) => lct_cc_xor_take1(data, k, r, acc)
fn lct_cc_xor(ks, ctr, data, acc) = if lct_isnil(data) == 1 then lct_rev(acc) else let r = lct_cc_xor_take(data, lct_cc_block(ks, ctr), acc) in lct_cc_xor(ks, ctr + 1, r.rest, r.acc)
## encryption and decryption are the same operation
fn lct_chacha20_xor(key, counter, nonce, data) = lct_cc_xor(lct_cc_key(key, nonce), counter, data, Nil)

## --- Poly1305 (RFC 8439 section 2.5): h = (h + block) * r mod 2^130 - 5 on five 26-bit limbs -----------------------------
fn lct_p_key(key) = let t0 = lct_le32_take(key) in let t1 = lct_le32_take(t0.rest) in let t2 = lct_le32_take(t1.rest) in let t3 = lct_le32_take(t2.rest) in let s0 = lct_le32_take(t3.rest) in let s1 = lct_le32_take(s0.rest) in let s2 = lct_le32_take(s1.rest) in let s3 = lct_le32_take(s2.rest) in let r1 = bit_and(bit_or(bit_shr(t0.v, 26), bit_shl(t1.v, 6)), 67108611) in let r2 = bit_and(bit_or(bit_shr(t1.v, 20), bit_shl(t2.v, 12)), 67092735) in let r3 = bit_and(bit_or(bit_shr(t2.v, 14), bit_shl(t3.v, 18)), 66076671) in let r4 = bit_and(bit_shr(t3.v, 8), 1048575) in {r0: bit_and(t0.v, 67108863), r1: r1, r2: r2, r3: r3, r4: r4, s1: r1 * 5, s2: r2 * 5, s3: r3 * 5, s4: r4 * 5, p0: s0.v, p1: s1.v, p2: s2.v, p3: s3.v}
fn lct_p_block(h, k, t0, t1, t2, t3, hibit) = let h0 = h.h0 + bit_and(t0, 67108863) in let h1 = h.h1 + bit_and(bit_or(bit_shr(t0, 26), bit_shl(t1, 6)), 67108863) in let h2 = h.h2 + bit_and(bit_or(bit_shr(t1, 20), bit_shl(t2, 12)), 67108863) in let h3 = h.h3 + bit_and(bit_or(bit_shr(t2, 14), bit_shl(t3, 18)), 67108863) in let h4 = h.h4 + bit_or(bit_shr(t3, 8), hibit) in let d0 = h0 * k.r0 + h1 * k.s4 + h2 * k.s3 + h3 * k.s2 + h4 * k.s1 in let d1 = h0 * k.r1 + h1 * k.r0 + h2 * k.s4 + h3 * k.s3 + h4 * k.s2 + bit_shr(d0, 26) in let d2 = h0 * k.r2 + h1 * k.r1 + h2 * k.r0 + h3 * k.s4 + h4 * k.s3 + bit_shr(d1, 26) in let d3 = h0 * k.r3 + h1 * k.r2 + h2 * k.r1 + h3 * k.r0 + h4 * k.s4 + bit_shr(d2, 26) in let d4 = h0 * k.r4 + h1 * k.r3 + h2 * k.r2 + h3 * k.r1 + h4 * k.r0 + bit_shr(d3, 26) in let f0 = bit_and(d0, 67108863) + bit_shr(d4, 26) * 5 in {h0: bit_and(f0, 67108863), h1: bit_and(d1, 67108863) + bit_shr(f0, 26), h2: bit_and(d2, 67108863), h3: bit_and(d3, 67108863), h4: bit_and(d4, 67108863)}
fn lct_p_run(bs, left, k, h) = if left >= 16 then (let a = lct_le32_take(bs) in let b = lct_le32_take(a.rest) in let c = lct_le32_take(b.rest) in let d = lct_le32_take(c.rest) in lct_p_run(d.rest, left - 16, k, lct_p_block(h, k, a.v, b.v, c.v, d.v, 16777216))) else if left > 0 then (let a = lct_le32_take(lct_app(bs, Cons(1, lct_zeros(15 - left)))) in let b = lct_le32_take(a.rest) in let c = lct_le32_take(b.rest) in let d = lct_le32_take(c.rest) in lct_p_block(h, k, a.v, b.v, c.v, d.v, 0)) else h
## full carry, then h - p is computed and selected by the sign mask (no branch on h), then s is added mod 2^128
fn lct_p_finish(h, k) = let c1 = bit_shr(h.h1, 26) in let a1 = bit_and(h.h1, 67108863) in let b2 = h.h2 + c1 in let a2 = bit_and(b2, 67108863) in let b3 = h.h3 + bit_shr(b2, 26) in let a3 = bit_and(b3, 67108863) in let b4 = h.h4 + bit_shr(b3, 26) in let a4 = bit_and(b4, 67108863) in let b0 = h.h0 + bit_shr(b4, 26) * 5 in let a0 = bit_and(b0, 67108863) in let e1 = a1 + bit_shr(b0, 26) in let g0 = a0 + 5 in let g1 = e1 + bit_shr(g0, 26) in let g2 = a2 + bit_shr(g1, 26) in let g3 = a3 + bit_shr(g2, 26) in let g4 = a4 + bit_shr(g3, 26) - 67108864 in let keep = bit_shr(g4, 63) in let take = bit_xor(keep, 0 - 1) in let f0 = bit_or(bit_and(a0, keep), bit_and(bit_and(g0, 67108863), take)) in let f1 = bit_or(bit_and(e1, keep), bit_and(bit_and(g1, 67108863), take)) in let f2 = bit_or(bit_and(a2, keep), bit_and(bit_and(g2, 67108863), take)) in let f3 = bit_or(bit_and(a3, keep), bit_and(bit_and(g3, 67108863), take)) in let f4 = bit_or(bit_and(a4, keep), bit_and(g4, take)) in let w0 = bit_and(bit_or(f0, bit_shl(f1, 26)), 4294967295) + k.p0 in let w1 = bit_and(bit_or(bit_shr(f1, 6), bit_shl(f2, 20)), 4294967295) + k.p1 + bit_shr(w0, 32) in let w2 = bit_and(bit_or(bit_shr(f2, 12), bit_shl(f3, 14)), 4294967295) + k.p2 + bit_shr(w1, 32) in let w3 = bit_and(bit_or(bit_shr(f3, 18), bit_shl(f4, 8)), 4294967295) + k.p3 + bit_shr(w2, 32) in lct_le32_push(bit_and(w0, 4294967295), lct_le32_push(bit_and(w1, 4294967295), lct_le32_push(bit_and(w2, 4294967295), lct_le32_push(bit_and(w3, 4294967295), Nil))))
## key: 32 bytes (r || s), one-time
fn lct_poly1305(key, msg) = let k = lct_p_key(key) in lct_p_finish(lct_p_run(msg, lct_len(msg), k, {h0: 0, h1: 0, h2: 0, h3: 0, h4: 0}), k)
fn lct_poly1305_keygen(key, nonce) = lct_take(lct_chacha20_block(key, 0, nonce), 32)

## --- AEAD_CHACHA20_POLY1305 (RFC 8439 section 2.8) -------------------------------------------------------------------
fn lct_aead_mac_data(aad, ct) = let la = lct_len(aad) in let lc = lct_len(ct) in lct_app(aad, lct_repeat(0, lct_pad16(la), lct_app(ct, lct_repeat(0, lct_pad16(lc), lct_le64_push(la, lct_le64_push(lc, Nil))))))
## {ct, tag}
fn lct_aead_seal(key, nonce, aad, plaintext) = let ks = lct_cc_key(key, nonce) in let ct = lct_cc_xor(ks, 1, plaintext, Nil) in {ct: ct, tag: lct_poly1305(lct_take(lct_cc_block(ks, 0), 32), lct_aead_mac_data(aad, ct))}
## {ok, pt}: the tag is checked in constant time over all 16 bytes BEFORE any plaintext is produced
fn lct_aead_open(key, nonce, aad, ct, tag) = let ks = lct_cc_key(key, nonce) in if lct_ct_eq(lct_poly1305(lct_take(lct_cc_block(ks, 0), 32), lct_aead_mac_data(aad, ct)), tag) == 1 then {ok: 1, pt: lct_cc_xor(ks, 1, ct, Nil)} else {ok: 0, pt: Nil}
## ciphertext || tag, as carried on the wire
fn lct_aead_seal_bytes(key, nonce, aad, plaintext) = let s = lct_aead_seal(key, nonce, aad, plaintext) in lct_app(s.ct, s.tag)
fn lct_aead_open_bytes(key, nonce, aad, sealed) = let n = lct_len(sealed) in if n < 16 then {ok: 0, pt: Nil} else let s = lct_split(sealed, n - 16) in lct_aead_open(key, nonce, aad, s.a, s.b)

## --- Ed25519 (RFC 8032): GF(2^255 - 19) on sixteen 16-bit limbs ---------------------------------------------------------
fn lct_fe_add(a, b) = match a
    Nil        => Nil
    Cons(x, r) => Cons(x + lct_hd(b), lct_fe_add(r, lct_tl(b)))
fn lct_fe_sub(a, b) = match a
    Nil        => Nil
    Cons(x, r) => Cons(x - lct_hd(b), lct_fe_sub(r, lct_tl(b)))
fn lct_fe_car_pass(o, cin, acc) = match o
    Nil        => {l: acc, c: cin}
    Cons(x, r) => let v = x + cin + 65536 in let c = bit_shr(v, 16) in lct_fe_car_pass(r, c - 1, Cons(v - c * 65536, acc))
fn lct_fe_car_fix(l, c) = match l
    Nil        => Nil
    Cons(h, t) => Cons(h + 38 * c, t)
## one carry pass; the carry out of limb 15 comes back into limb 0 times 38 (2^256 = 38 mod p)
fn lct_fe_car(o) = let p = lct_fe_car_pass(o, 0, Nil) in lct_fe_car_fix(lct_rev(p.l), p.c)
fn lct_conv_row(ai, b, acc) = match b
    Nil         => Nil
    Cons(bj, r) => Cons(ai * bj + lct_hd(acc), lct_conv_row(ai, r, lct_tl(acc)))
fn lct_conv_step(row, ar, b, out) = match row
    Nil        => lct_rev(out)
    Cons(h, t) => lct_conv_loop(ar, b, t, Cons(h, out))
## schoolbook product of two limb lists (length m and n -> m + n - 1 column sums, no carries)
fn lct_conv_loop(a, b, acc, out) = match a
    Nil         => lct_rev_acc(out, acc)
    Cons(ai, r) => lct_conv_step(lct_conv_row(ai, b, acc), r, b, out)
fn lct_fe_fold(lo, hi) = match lo
    Nil        => Nil
    Cons(x, r) => Cons(x + 38 * lct_hd(hi), lct_fe_fold(r, lct_tl(hi)))
## the product, schoolbook reference: column sums, columns 16..30 folded back times 38 (2^256 = 38 mod p), two carry passes
fn lct_fe_mul_ref(a, b) = let s = lct_split(lct_conv_loop(a, b, Nil, Nil), 16) in lct_fe_car(lct_fe_car(lct_fe_fold(s.a, s.b)))
## the same sixteen folded column sums and the same two carry passes written out on named limbs (straight-line code,
## no list traversal): limb for limb the value of lct_fe_mul_ref, which the known-answer tests compare it against
fn lct_fe_car16(again, t0, t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t11, t12, t13, t14, t15) = let v0 = t0 + 65536 in let c0 = bit_shr(v0, 16) in let v1 = t1 + c0 + 65535 in let c1 = bit_shr(v1, 16) in let v2 = t2 + c1 + 65535 in let c2 = bit_shr(v2, 16) in let v3 = t3 + c2 + 65535 in let c3 = bit_shr(v3, 16) in let v4 = t4 + c3 + 65535 in let c4 = bit_shr(v4, 16) in let v5 = t5 + c4 + 65535 in let c5 = bit_shr(v5, 16) in let v6 = t6 + c5 + 65535 in let c6 = bit_shr(v6, 16) in let v7 = t7 + c6 + 65535 in let c7 = bit_shr(v7, 16) in let v8 = t8 + c7 + 65535 in let c8 = bit_shr(v8, 16) in let v9 = t9 + c8 + 65535 in let c9 = bit_shr(v9, 16) in let v10 = t10 + c9 + 65535 in let c10 = bit_shr(v10, 16) in let v11 = t11 + c10 + 65535 in let c11 = bit_shr(v11, 16) in let v12 = t12 + c11 + 65535 in let c12 = bit_shr(v12, 16) in let v13 = t13 + c12 + 65535 in let c13 = bit_shr(v13, 16) in let v14 = t14 + c13 + 65535 in let c14 = bit_shr(v14, 16) in let v15 = t15 + c14 + 65535 in let c15 = bit_shr(v15, 16) in if again == 1 then lct_fe_car16(0, v0 - c0 * 65536 + 38 * (c15 - 1), v1 - c1 * 65536, v2 - c2 * 65536, v3 - c3 * 65536, v4 - c4 * 65536, v5 - c5 * 65536, v6 - c6 * 65536, v7 - c7 * 65536, v8 - c8 * 65536, v9 - c9 * 65536, v10 - c10 * 65536, v11 - c11 * 65536, v12 - c12 * 65536, v13 - c13 * 65536, v14 - c14 * 65536, v15 - c15 * 65536) else Cons(v0 - c0 * 65536 + 38 * (c15 - 1), Cons(v1 - c1 * 65536, Cons(v2 - c2 * 65536, Cons(v3 - c3 * 65536, Cons(v4 - c4 * 65536, Cons(v5 - c5 * 65536, Cons(v6 - c6 * 65536, Cons(v7 - c7 * 65536, Cons(v8 - c8 * 65536, Cons(v9 - c9 * 65536, Cons(v10 - c10 * 65536, Cons(v11 - c11 * 65536, Cons(v12 - c12 * 65536, Cons(v13 - c13 * 65536, Cons(v14 - c14 * 65536, Cons(v15 - c15 * 65536, Nil))))))))))))))))
fn lct_fe_mul_b(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, b) = match b
    Cons(b0, Cons(b1, Cons(b2, Cons(b3, Cons(b4, Cons(b5, Cons(b6, Cons(b7, Cons(b8, Cons(b9, Cons(b10, Cons(b11, Cons(b12, Cons(b13, Cons(b14, Cons(b15, r)))))))))))))))) => lct_fe_car16(1, a0 * b0 + 38 * (a1 * b15 + a2 * b14 + a3 * b13 + a4 * b12 + a5 * b11 + a6 * b10 + a7 * b9 + a8 * b8 + a9 * b7 + a10 * b6 + a11 * b5 + a12 * b4 + a13 * b3 + a14 * b2 + a15 * b1), a0 * b1 + a1 * b0 + 38 * (a2 * b15 + a3 * b14 + a4 * b13 + a5 * b12 + a6 * b11 + a7 * b10 + a8 * b9 + a9 * b8 + a10 * b7 + a11 * b6 + a12 * b5 + a13 * b4 + a14 * b3 + a15 * b2), a0 * b2 + a1 * b1 + a2 * b0 + 38 * (a3 * b15 + a4 * b14 + a5 * b13 + a6 * b12 + a7 * b11 + a8 * b10 + a9 * b9 + a10 * b8 + a11 * b7 + a12 * b6 + a13 * b5 + a14 * b4 + a15 * b3), a0 * b3 + a1 * b2 + a2 * b1 + a3 * b0 + 38 * (a4 * b15 + a5 * b14 + a6 * b13 + a7 * b12 + a8 * b11 + a9 * b10 + a10 * b9 + a11 * b8 + a12 * b7 + a13 * b6 + a14 * b5 + a15 * b4), a0 * b4 + a1 * b3 + a2 * b2 + a3 * b1 + a4 * b0 + 38 * (a5 * b15 + a6 * b14 + a7 * b13 + a8 * b12 + a9 * b11 + a10 * b10 + a11 * b9 + a12 * b8 + a13 * b7 + a14 * b6 + a15 * b5), a0 * b5 + a1 * b4 + a2 * b3 + a3 * b2 + a4 * b1 + a5 * b0 + 38 * (a6 * b15 + a7 * b14 + a8 * b13 + a9 * b12 + a10 * b11 + a11 * b10 + a12 * b9 + a13 * b8 + a14 * b7 + a15 * b6), a0 * b6 + a1 * b5 + a2 * b4 + a3 * b3 + a4 * b2 + a5 * b1 + a6 * b0 + 38 * (a7 * b15 + a8 * b14 + a9 * b13 + a10 * b12 + a11 * b11 + a12 * b10 + a13 * b9 + a14 * b8 + a15 * b7), a0 * b7 + a1 * b6 + a2 * b5 + a3 * b4 + a4 * b3 + a5 * b2 + a6 * b1 + a7 * b0 + 38 * (a8 * b15 + a9 * b14 + a10 * b13 + a11 * b12 + a12 * b11 + a13 * b10 + a14 * b9 + a15 * b8), a0 * b8 + a1 * b7 + a2 * b6 + a3 * b5 + a4 * b4 + a5 * b3 + a6 * b2 + a7 * b1 + a8 * b0 + 38 * (a9 * b15 + a10 * b14 + a11 * b13 + a12 * b12 + a13 * b11 + a14 * b10 + a15 * b9), a0 * b9 + a1 * b8 + a2 * b7 + a3 * b6 + a4 * b5 + a5 * b4 + a6 * b3 + a7 * b2 + a8 * b1 + a9 * b0 + 38 * (a10 * b15 + a11 * b14 + a12 * b13 + a13 * b12 + a14 * b11 + a15 * b10), a0 * b10 + a1 * b9 + a2 * b8 + a3 * b7 + a4 * b6 + a5 * b5 + a6 * b4 + a7 * b3 + a8 * b2 + a9 * b1 + a10 * b0 + 38 * (a11 * b15 + a12 * b14 + a13 * b13 + a14 * b12 + a15 * b11), a0 * b11 + a1 * b10 + a2 * b9 + a3 * b8 + a4 * b7 + a5 * b6 + a6 * b5 + a7 * b4 + a8 * b3 + a9 * b2 + a10 * b1 + a11 * b0 + 38 * (a12 * b15 + a13 * b14 + a14 * b13 + a15 * b12), a0 * b12 + a1 * b11 + a2 * b10 + a3 * b9 + a4 * b8 + a5 * b7 + a6 * b6 + a7 * b5 + a8 * b4 + a9 * b3 + a10 * b2 + a11 * b1 + a12 * b0 + 38 * (a13 * b15 + a14 * b14 + a15 * b13), a0 * b13 + a1 * b12 + a2 * b11 + a3 * b10 + a4 * b9 + a5 * b8 + a6 * b7 + a7 * b6 + a8 * b5 + a9 * b4 + a10 * b3 + a11 * b2 + a12 * b1 + a13 * b0 + 38 * (a14 * b15 + a15 * b14), a0 * b14 + a1 * b13 + a2 * b12 + a3 * b11 + a4 * b10 + a5 * b9 + a6 * b8 + a7 * b7 + a8 * b6 + a9 * b5 + a10 * b4 + a11 * b3 + a12 * b2 + a13 * b1 + a14 * b0 + 38 * (a15 * b15), a0 * b15 + a1 * b14 + a2 * b13 + a3 * b12 + a4 * b11 + a5 * b10 + a6 * b9 + a7 * b8 + a8 * b7 + a9 * b6 + a10 * b5 + a11 * b4 + a12 * b3 + a13 * b2 + a14 * b1 + a15 * b0)
    _ => lct_fe_zero()
fn lct_fe_mul(a, b) = match a
    Cons(a0, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Cons(a8, Cons(a9, Cons(a10, Cons(a11, Cons(a12, Cons(a13, Cons(a14, Cons(a15, r)))))))))))))))) => lct_fe_mul_b(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, b)
    _ => lct_fe_zero()
## masked selection: mask == 0 gives a, mask == -1 gives b; the same instructions run either way
fn lct_fe_sel(a, b, mask) = match a
    Nil        => Nil
    Cons(x, r) => Cons(bit_xor(x, bit_and(mask, bit_xor(x, lct_hd(b)))), lct_fe_sel(r, lct_tl(b), mask))
fn lct_fe_pack_sub(t, i, bor, acc) = match t
    Nil        => {l: acc, b: bor}
    Cons(x, r) => let m = x - (if i == 0 then 65517 else if i == 15 then 32767 else 65535) - bor in if i == 15 then {l: Cons(m, acc), b: bit_and(bit_shr(m, 16), 1)} else lct_fe_pack_sub(r, i + 1, bit_and(bit_shr(m, 16), 1), Cons(bit_and(m, 65535), acc))
## t - p, kept when it did not borrow
fn lct_fe_pack_red(t) = let m = lct_fe_pack_sub(t, 0, 0, Nil) in lct_fe_sel(t, lct_rev(m.l), m.b - 1)
fn lct_fe_bytes(t) = match t
    Nil        => Nil
    Cons(x, r) => Cons(bit_and(x, 255), Cons(bit_and(bit_shr(x, 8), 255), lct_fe_bytes(r)))
## the canonical 32-byte little-endian encoding
fn lct_fe_pack(n) = lct_fe_bytes(lct_fe_pack_red(lct_fe_pack_red(lct_fe_car(lct_fe_car(lct_fe_car(n))))))
fn lct_fe_unpack_l(bs, i) = match bs
    Cons(a, Cons(b, r)) => Cons(a + (if i == 15 then bit_and(b, 127) else b) * 256, lct_fe_unpack_l(r, i + 1))
    _                   => Nil
fn lct_fe_unpack(bs) = lct_fe_unpack_l(bs, 0)
fn lct_fe_eq(a, b) = lct_ct_eq(lct_fe_pack(a), lct_fe_pack(b))
fn lct_fe_parity(a) = bit_and(lct_hd(lct_fe_pack(a)), 1)
## fixed exponentiation chains (the exponents p - 2 and (p - 5) / 8 are public constants)
fn lct_fe_inv_loop(c, i, a) = if a < 0 then c else let c2 = lct_fe_mul(c, c) in lct_fe_inv_loop(if a != 2 and a != 4 then lct_fe_mul(c2, i) else c2, i, a - 1)
fn lct_fe_inv(i) = lct_fe_inv_loop(i, i, 253)
fn lct_fe_pow2523_loop(c, i, a) = if a < 0 then c else let c2 = lct_fe_mul(c, c) in lct_fe_pow2523_loop(if a != 1 then lct_fe_mul(c2, i) else c2, i, a - 1)
fn lct_fe_pow2523(i) = lct_fe_pow2523_loop(i, i, 250)
fn lct_fe_zero() = lct_zeros(16)
fn lct_fe_one() = Cons(1, lct_zeros(15))

## extended twisted Edwards points {x, y, z, t} with x * y = z * t
fn lct_pt_add(p, q) = let a = lct_fe_mul(lct_fe_sub(p.y, p.x), lct_fe_sub(q.y, q.x)) in let b = lct_fe_mul(lct_fe_add(p.x, p.y), lct_fe_add(q.x, q.y)) in let c = lct_fe_mul(lct_fe_mul(p.t, q.t), lct_ed_d2()) in let d0 = lct_fe_mul(p.z, q.z) in let d = lct_fe_add(d0, d0) in let e = lct_fe_sub(b, a) in let f = lct_fe_sub(d, c) in let g = lct_fe_add(d, c) in let h = lct_fe_add(b, a) in {x: lct_fe_mul(e, f), y: lct_fe_mul(h, g), z: lct_fe_mul(g, f), t: lct_fe_mul(e, h)}
fn lct_pt_sel(p, q, mask) = {x: lct_fe_sel(p.x, q.x, mask), y: lct_fe_sel(p.y, q.y, mask), z: lct_fe_sel(p.z, q.z, mask), t: lct_fe_sel(p.t, q.t, mask)}
fn lct_bits8(b, i, acc) = if i >= 8 then acc else lct_bits8(b, i + 1, Cons(bit_and(bit_shr(b, i), 1), acc))
## the bits of a little-endian byte string, most significant first
fn lct_bits_msb(bs, acc) = match bs
    Nil        => acc
    Cons(b, r) => lct_bits_msb(r, lct_bits8(b, 0, acc))
## fixed ladder: every step swaps under a mask, adds, doubles and swaps back
fn lct_pt_mul_loop(bits, p, q) = match bits
    Nil        => p
    Cons(b, r) => let m = 0 - b in let p1 = lct_pt_sel(p, q, m) in let q1 = lct_pt_sel(q, p, m) in let q2 = lct_pt_add(q1, p1) in let p2 = lct_pt_add(p1, p1) in lct_pt_mul_loop(r, lct_pt_sel(p2, q2, m), lct_pt_sel(q2, p2, m))
fn lct_pt_mul(q, scalar) = lct_pt_mul_loop(lct_bits_msb(scalar, Nil), {x: lct_fe_zero(), y: lct_fe_one(), z: lct_fe_one(), t: lct_fe_zero()}, q)
fn lct_pt_base() = {x: lct_ed_bx(), y: lct_ed_by(), z: lct_fe_one(), t: lct_fe_mul(lct_ed_bx(), lct_ed_by())}
fn lct_pt_base_mul(scalar) = lct_pt_mul(lct_pt_base(), scalar)
fn lct_xor_last(bs, v) = match bs
    Nil        => Nil
    Cons(h, t) => if lct_isnil(t) == 1 then Cons(bit_xor(h, v), Nil) else Cons(h, lct_xor_last(t, v))
fn lct_pt_pack(p) = let zi = lct_fe_inv(p.z) in lct_xor_last(lct_fe_pack(lct_fe_mul(p.y, zi)), lct_fe_parity(lct_fe_mul(p.x, zi)) * 128)
## decode a public key and negate it: {ok, pt}. Only public data is handled here, so the branches are free.
fn lct_pt_unpack_neg2(x, y, num, den, sign) = let chk = lct_fe_mul(lct_fe_mul(x, x), den) in if lct_fe_eq(chk, num) == 0 then {ok: 0, pt: lct_pt_base()} else let x2 = if lct_fe_parity(x) == sign then lct_fe_sub(lct_fe_zero(), x) else x in {ok: 1, pt: {x: x2, y: y, z: lct_fe_one(), t: lct_fe_mul(x2, y)}}
fn lct_pt_unpack_neg(pk) = let y = lct_fe_unpack(pk) in let y2 = lct_fe_mul(y, y) in let num = lct_fe_sub(y2, lct_fe_one()) in let den = lct_fe_add(lct_fe_one(), lct_fe_mul(y2, lct_ed_d())) in let den2 = lct_fe_mul(den, den) in let den4 = lct_fe_mul(den2, den2) in let den6 = lct_fe_mul(den4, den2) in let t0 = lct_fe_pow2523(lct_fe_mul(lct_fe_mul(den6, num), den)) in let x = lct_fe_mul(lct_fe_mul(lct_fe_mul(lct_fe_mul(t0, num), den), den), den) in let chk = lct_fe_mul(lct_fe_mul(x, x), den) in lct_pt_unpack_neg2(if lct_fe_eq(chk, num) == 1 then x else lct_fe_mul(x, lct_ed_i()), y, num, den, bit_shr(lct_nth(pk, 31), 7))

## scalars mod L = 2^252 + 27742317777372353535851937790883648493, eleven 24-bit limbs
fn lct_sc_dbl(acc, cin, out) = match acc
    Nil        => lct_rev(out)
    Cons(x, r) => let v = x * 2 + cin in lct_sc_dbl(r, bit_shr(v, 24), Cons(bit_and(v, 16777215), out))
fn lct_sc_subl(a, l, bor, out) = match a
    Nil        => {l: lct_rev(out), b: bor}
    Cons(x, r) => let v = x - lct_hd(l) - bor in lct_sc_subl(r, lct_tl(l), bit_and(bit_shr(v, 24), 1), Cons(bit_and(v, 16777215), out))
## acc < L  ->  (2 * acc + bit) mod L: double, subtract L, keep the difference unless it borrowed (masked select)
fn lct_sc_step(acc, bit, l) = let d = lct_sc_dbl(acc, bit, Nil) in let s = lct_sc_subl(d, l, 0, Nil) in lct_fe_sel(s.l, d, 0 - s.b)
fn lct_sc_bits(bits, acc, l) = match bits
    Nil        => acc
    Cons(b, r) => lct_sc_bits(r, lct_sc_step(acc, b, l), l)
fn lct_sc_bytes(ls) = match ls
    Nil        => Nil
    Cons(x, r) => Cons(bit_and(x, 255), Cons(bit_and(bit_shr(x, 8), 255), Cons(bit_shr(x, 16), lct_sc_bytes(r))))
## reduce a little-endian byte string (any length, 64 bytes after SHA-512) mod L: one fixed step per input bit
fn lct_sc_modl(bs) = lct_take(lct_sc_bytes(lct_sc_bits(lct_bits_msb(bs, Nil), lct_zeros(11), lct_ed_l24())), 32)
fn lct_carry256(xs, c, out) = match xs
    Nil        => lct_rev(Cons(bit_and(c, 255), out))
    Cons(x, r) => let v = x + c in lct_carry256(r, bit_shr(v, 8), Cons(bit_and(v, 255), out))
## (r + h * a) mod L
fn lct_sc_muladd(h, a, r) = lct_sc_modl(lct_carry256(lct_fe_add(lct_conv_loop(h, a, Nil, Nil), r), 0, Nil))
fn lct_sc_limbs(bs) = match bs
    Cons(a, Cons(b, Cons(c, r))) => Cons(a + b * 256 + c * 65536, lct_sc_limbs(r))
    Cons(a, Cons(b, Nil))        => Cons(a + b * 256, Nil)
    Cons(a, Nil)                 => Cons(a, Nil)
    _                            => Nil
## 1 when the 32-byte little-endian S is below L (RFC 8032 5.1.7: reject any other S, they are malleable)
fn lct_sc_lt_l(s) = (lct_sc_subl(lct_sc_limbs(s), lct_ed_l24(), 0, Nil)).b

fn lct_ed_clamp_l(bs, i) = match bs
    Nil        => Nil
    Cons(h, t) => if i == 0 then Cons(bit_and(h, 248), lct_ed_clamp_l(t, 1)) else if i == 31 then Cons(bit_or(bit_and(h, 127), 64), Nil) else Cons(h, lct_ed_clamp_l(t, i + 1))
## {a: the clamped secret scalar, prefix: the nonce-derivation key}
fn lct_ed25519_expand(seed) = let s = lct_split(lct_sha512(seed), 32) in {a: lct_ed_clamp_l(s.a, 0), prefix: s.b}
fn lct_ed25519_public_key(seed) = lct_pt_pack(lct_pt_base_mul((lct_ed25519_expand(seed)).a))
## deterministic signature R || S (64 bytes) of msg under the 32-byte seed
fn lct_ed25519_sign(seed, msg) = let e = lct_ed25519_expand(seed) in let pk = lct_pt_pack(lct_pt_base_mul(e.a)) in let r = lct_sc_modl(lct_sha512(lct_app(e.prefix, msg))) in let rb = lct_pt_pack(lct_pt_base_mul(r)) in lct_app(rb, lct_sc_muladd(lct_sc_modl(lct_sha512(lct_app(rb, lct_app(pk, msg)))), e.a, r))
fn lct_ed25519_verify2(up, pk, msg, rb, s) = if up.ok == 0 then 0 else lct_ct_eq(lct_pt_pack(lct_pt_add(lct_pt_mul(up.pt, lct_sc_modl(lct_sha512(lct_app(rb, lct_app(pk, msg))))), lct_pt_base_mul(s))), rb)
## 1 when sig is a valid signature of msg under the 32-byte public key pk, else 0
fn lct_ed25519_verify(pk, msg, sig) = if lct_len(pk) != 32 or lct_len(sig) != 64 then 0 else let sp = lct_split(sig, 32) in if lct_sc_lt_l(sp.b) == 0 then 0 else lct_ed25519_verify2(lct_pt_unpack_neg(pk), pk, msg, sp.a, sp.b)

## --- X25519 (RFC 7748): Montgomery ladder on the u-coordinate, same field and limbs as Ed25519 -------------------------
fn lct_fe_small(a, k) = match a
    Nil        => Nil
    Cons(x, r) => Cons(x * k, lct_fe_small(r, k))
## a * a24 with a24 = (486662 - 2) / 4 = 121665 (RFC 7748 section 5); limbs below 2^18 in magnitude stay below 2^35
fn lct_fe_mul121665(a) = lct_fe_car(lct_fe_car(lct_fe_small(a, 121665)))
## one ladder step per scalar bit, most significant first: (a : c) = [n]P and (b : d) = [n + 1]P are swapped under the
## mask 0 - bit, differentially added and doubled, and swapped back. The list of bits has a public length (255).
fn lct_x25519_loop(bits, x, a, b, c, d) = match bits
    Nil         => {a: a, c: c}
    Cons(r, rs) => let m = 0 - r in let a1 = lct_fe_sel(a, b, m) in let b1 = lct_fe_sel(b, a, m) in let c1 = lct_fe_sel(c, d, m) in let d1 = lct_fe_sel(d, c, m) in let e = lct_fe_add(a1, c1) in let a2 = lct_fe_sub(a1, c1) in let c2 = lct_fe_add(b1, d1) in let b2 = lct_fe_sub(b1, d1) in let d2 = lct_fe_mul(e, e) in let f = lct_fe_mul(a2, a2) in let a3 = lct_fe_mul(c2, a2) in let c3 = lct_fe_mul(b2, e) in let e2 = lct_fe_add(a3, c3) in let a4 = lct_fe_sub(a3, c3) in let b3 = lct_fe_mul(a4, a4) in let c4 = lct_fe_sub(d2, f) in let a5 = lct_fe_add(lct_fe_mul121665(c4), d2) in let c5 = lct_fe_mul(c4, a5) in let a6 = lct_fe_mul(d2, f) in let d3 = lct_fe_mul(b3, x) in let b4 = lct_fe_mul(e2, e2) in lct_x25519_loop(rs, x, lct_fe_sel(a6, b4, m), lct_fe_sel(b4, a6, m), lct_fe_sel(c5, d3, m), lct_fe_sel(d3, c5, m))
fn lct_x25519_raw(k, u) = let x = lct_fe_unpack(u) in let r = lct_x25519_loop(lct_tl(lct_bits_msb(lct_ed_clamp_l(k, 0), Nil)), x, lct_fe_one(), x, lct_fe_zero(), lct_fe_one()) in lct_fe_pack(lct_fe_mul(r.a, lct_fe_inv(r.c)))
## X25519(k, u), 32 bytes. The scalar is clamped (k[0] &= 248, k[31] &= 127, k[31] |= 64: the same clamp as Ed25519),
## bit 255 of u is masked, a non-canonical u is accepted and reduced mod p, as RFC 7748 section 5 requires. The inverse
## of 0 is 0, so a small-order u gives 32 zero bytes. Wrong lengths (public) also give 32 zero bytes: fail closed.
fn lct_x25519(k, u) = if lct_len(k) != 32 or lct_len(u) != 32 then lct_zeros(32) else lct_x25519_raw(k, u)
## the public key of a 32-byte private key: X25519(k, 9)
fn lct_x25519_base(k) = lct_x25519(k, Cons(9, lct_zeros(31)))
## Diffie-Hellman with the all-zero check of RFC 7748 section 6.1 / RFC 8446 section 7.4.2: {ok, secret}. Every byte of
## the result is OR-ed and the accept bit comes from the sign of (or - 1); nothing branches on the secret itself.
fn lct_x25519_shared(k, peer_u) = let s = lct_x25519(k, peer_u) in {ok: 1 + bit_shr(lct_ct_acc(s, Nil, 0) - 1, 63), secret: s}

## --- TLS 1.3 key schedule (RFC 8446 section 7.1) -----------------------------------------------------------------------
fn lct_tls13_hkdf_label(len, label, ctx) = let full = lct_str_to_bytes("tls13 " + label) in Cons(len / 256, Cons(len % 256, Cons(lct_len(full), lct_app(full, Cons(lct_len(ctx), ctx)))))
fn lct_tls13_expand_label(secret, label, ctx, len) = lct_hkdf_expand(secret, lct_tls13_hkdf_label(len, label, ctx), len)
## Derive-Secret(secret, label, messages), given Transcript-Hash(messages)
fn lct_tls13_derive_secret(secret, label, transcript_hash) = lct_tls13_expand_label(secret, label, transcript_hash, 32)
## Transcript-Hash over the concatenated handshake messages (a list of byte lists)
fn lct_tls13_transcript_hash(messages) = lct_sha256(lct_concat(messages))
fn lct_tls13_early_secret(psk) = lct_hkdf_extract(lct_zeros(32), if lct_isnil(psk) == 1 then lct_zeros(32) else psk)
fn lct_tls13_handshake_secret(early, ecdhe) = lct_hkdf_extract(lct_tls13_derive_secret(early, "derived", lct_sha256(Nil)), ecdhe)
fn lct_tls13_master_secret(handshake) = lct_hkdf_extract(lct_tls13_derive_secret(handshake, "derived", lct_sha256(Nil)), lct_zeros(32))
## Early Secret -> Handshake Secret -> Master Secret with the four traffic secrets and the exporter master secret.
## hello_hash = Transcript-Hash(ClientHello..ServerHello), finished_hash = Transcript-Hash(ClientHello..server Finished)
fn lct_tls13_key_schedule(psk, ecdhe, hello_hash, finished_hash) = let early = lct_tls13_early_secret(psk) in let hs = lct_tls13_handshake_secret(early, ecdhe) in let ms = lct_tls13_master_secret(hs) in {early: early, handshake: hs, master: ms, c_hs: lct_tls13_derive_secret(hs, "c hs traffic", hello_hash), s_hs: lct_tls13_derive_secret(hs, "s hs traffic", hello_hash), c_ap: lct_tls13_derive_secret(ms, "c ap traffic", finished_hash), s_ap: lct_tls13_derive_secret(ms, "s ap traffic", finished_hash), exp_master: lct_tls13_derive_secret(ms, "exp master", finished_hash)}
## {key, iv} of a traffic secret (key_len 32 for TLS_CHACHA20_POLY1305_SHA256, 16 for the AES-128 suites)
fn lct_tls13_traffic_keys(secret, key_len) = {key: lct_tls13_expand_label(secret, "key", Nil, key_len), iv: lct_tls13_expand_label(secret, "iv", Nil, 12)}
fn lct_tls13_finished_key(secret) = lct_tls13_expand_label(secret, "finished", Nil, 32)
fn lct_tls13_finished_verify(secret, transcript_hash) = lct_hmac_sha256(lct_tls13_finished_key(secret), transcript_hash)
## next-generation traffic secret (KeyUpdate)
fn lct_tls13_update_secret(secret) = lct_tls13_expand_label(secret, "traffic upd", Nil, 32)

## --- TLS 1.3 record layer (RFC 8446 section 5.2 - 5.3), TLS_CHACHA20_POLY1305_SHA256 -----------------------------------
## per-record nonce: the 64-bit sequence number, big-endian, left-padded to 12 bytes, XOR the write IV
fn lct_tls13_nonce(iv, seq) = lct_xor_lists(iv, Cons(0, Cons(0, Cons(0, Cons(0, lct_be64_push(seq, Nil))))))
## TLSCiphertext: header(23, 3, 3, length) || AEAD(TLSInnerPlaintext = data || content_type), header as AAD
fn lct_tls13_record_seal(key, iv, seq, content_type, data) = let n = lct_tls13_record_len(lct_len(data)) - 5 in let hdr = Cons(23, Cons(3, Cons(3, Cons(n / 256, Cons(n % 256, Nil))))) in lct_app(hdr, lct_aead_seal_bytes(key, lct_tls13_nonce(iv, seq), hdr, lct_app(data, Cons(content_type, Nil))))
fn lct_tls13_strip(rev_inner) = match rev_inner
    Nil        => {ok: 0, ctype: 0, data: Nil}
    Cons(h, t) => if h == 0 then lct_tls13_strip(t) else {ok: 1, ctype: h, data: lct_rev(t)}
fn lct_tls13_open2(o) = if o.ok == 0 then {ok: 0, ctype: 0, data: Nil} else lct_tls13_strip(lct_rev(o.pt))
## {ok, ctype, data}: ok == 0 for a malformed header, a failed tag (tampering, wrong key, wrong sequence number) or an
## inner plaintext with no content type; zero padding after the content type is removed
fn lct_tls13_record_open(key, iv, seq, record) = let n = lct_len(record) in if n < 22 or n > 16645 then {ok: 0, ctype: 0, data: Nil} else let s = lct_split(record, 5) in if lct_nth(s.a, 0) != 23 or lct_nth(s.a, 1) != 3 or lct_nth(s.a, 2) != 3 or lct_nth(s.a, 3) * 256 + lct_nth(s.a, 4) != n - 5 then {ok: 0, ctype: 0, data: Nil} else lct_tls13_open2(lct_aead_open_bytes(key, lct_tls13_nonce(iv, seq), s.a, s.b))

## --- TLS 1.3 handshake (RFC 8446 section 4 and Appendix A): 1-RTT, x25519, Ed25519, TLS_CHACHA20_POLY1305_SHA256 ------
## Scope, stated once and meant literally:
##   * one cipher suite (0x1303), one group (x25519), one signature scheme (ed25519, 0x0807), server authentication only;
##   * the server key travels as an RFC 7250 raw public key (server_certificate_type = RawPublicKey, the certificate
##     entry is the 44-byte Ed25519 SubjectPublicKeyInfo). X.509 parsing and path validation are NOT implemented: the
##     client accepts exactly the 32-byte key it was configured with (a pin) and nothing else;
##   * NOT implemented: PSK, session tickets and resumption, 0-RTT, HelloRetryRequest (a server needing one answers
##     handshake_failure, a client receiving one aborts), client certificates (a CertificateRequest is answered with the
##     empty Certificate of section 4.4.2 and the server accepts only that), KeyUpdate, server_name, ALPN, sending
##     the change_cipher_spec compatibility record of Appendix D.4 (a received one is dropped during the handshake, as
##     section 5 requires), record padding on send, half-close (any alert, close_notify included, ends the connection);
##   * there is no random number generator in here: the 32-byte randoms and the X25519 private keys are supplied by
##     the caller, who must draw fresh, unpredictable values for every connection. The tests use fixed ones;
##   * a state is a value: `lct_tls13_feed` returns the next state, `.out` are the records to transmit, `.app` the
##     application data received. Any failure moves to the sticky state 99 with the secrets, keys and configuration
##     erased from the state value and one alert record in `.out`; from there every input is ignored.
## States (RFC 8446 A.1 / A.2): client 0 START, 1 WAIT_SH, 2 WAIT_EE, 3 WAIT_CERT_CR, 4 WAIT_CERT, 5 WAIT_CV,
## 6 WAIT_FINISHED, 7 CONNECTED; server 10 START, 11 RECVD_CH, 12 NEGOTIATED, 13 WAIT_FLIGHT2, 14 WAIT_CERT,
## 15 WAIT_FINISHED, 16 CONNECTED; 99 is the fail-closed error state. Events are the handshake message types (1
## ClientHello, 2 ServerHello, 8 EncryptedExtensions, 11 Certificate, 13 CertificateRequest, 15 CertificateVerify,
## 20 Finished) and the local steps 100 (ClientHello sent), 101 (parameters selected), 102 (server flight sent),
## 103 (no 0-RTT, no client authentication), 104 (no 0-RTT, CertificateRequest sent).
## The only legal moves; everything else is 99. Proven: no move goes backwards, so 99 is absorbing and 7 / 16 are final.
fn lct_tls13_hs_next(state: int, ev: int) -> int
    requires state >= 0 and ev >= 0
    ensures result == 99 or (result > state and result <= 16)
= if state == 0 then (if ev == 100 then 1 else 99) else if state == 1 then (if ev == 2 then 2 else 99) else if state == 2 then (if ev == 8 then 3 else 99) else if state == 3 then (if ev == 13 then 4 else if ev == 11 then 5 else 99) else if state == 4 then (if ev == 11 then 5 else 99) else if state == 5 then (if ev == 15 then 6 else 99) else if state == 6 then (if ev == 20 then 7 else 99) else if state == 10 then (if ev == 1 then 11 else 99) else if state == 11 then (if ev == 101 then 12 else 99) else if state == 12 then (if ev == 102 then 13 else 99) else if state == 13 then (if ev == 103 then 15 else if ev == 104 then 14 else 99) else if state == 14 then (if ev == 11 then 15 else 99) else if state == 15 then (if ev == 20 then 16 else 99) else 99
fn lct_tls13_state_name(s) = if s == 0 then "START" else if s == 1 then "WAIT_SH" else if s == 2 then "WAIT_EE" else if s == 3 then "WAIT_CERT_CR" else if s == 4 then "WAIT_CERT" else if s == 5 then "WAIT_CV" else if s == 6 then "WAIT_FINISHED" else if s == 7 then "CONNECTED" else if s == 10 then "S_START" else if s == 11 then "S_RECVD_CH" else if s == 12 then "S_NEGOTIATED" else if s == 13 then "S_WAIT_FLIGHT2" else if s == 14 then "S_WAIT_CERT" else if s == 15 then "S_WAIT_FINISHED" else if s == 16 then "S_CONNECTED" else "ERROR"

## wire encoding: big-endian integers and length-prefixed vectors
fn lct_u16_push(n, acc) = Cons(n / 256, Cons(n % 256, acc))
fn lct_vec8(bs) = Cons(lct_len(bs), bs)
fn lct_vec16(bs) = lct_u16_push(lct_len(bs), bs)
fn lct_vec24(bs) = let n = lct_len(bs) in Cons(n / 65536, Cons(n / 256 % 256, Cons(n % 256, bs)))
fn lct_mem(xs, v) = match xs
    Nil        => 0
    Cons(h, t) => if h == v then 1 else lct_mem(t, v)
## total readers: {ok, v, rest} for integers, {ok, b, rest} for byte strings; after a failure `rest` is empty
fn lct_rd_u8(bs) = match bs
    Nil        => {ok: 0, v: 0, rest: Nil}
    Cons(a, r) => {ok: 1, v: a, rest: r}
fn lct_rd_u16(bs) = match bs
    Cons(a, Cons(b, r)) => {ok: 1, v: a * 256 + b, rest: r}
    _                   => {ok: 0, v: 0, rest: Nil}
fn lct_rd_u24(bs) = match bs
    Cons(a, Cons(b, Cons(c, r))) => {ok: 1, v: a * 65536 + b * 256 + c, rest: r}
    _                            => {ok: 0, v: 0, rest: Nil}
fn lct_rd_bytes(bs, n) = if lct_len(bs) < n then {ok: 0, b: Nil, rest: Nil} else let s = lct_split(bs, n) in {ok: 1, b: s.a, rest: s.b}
fn lct_rd_vec8(bs) = let n = lct_rd_u8(bs) in if n.ok == 0 then {ok: 0, b: Nil, rest: Nil} else lct_rd_bytes(n.rest, n.v)
fn lct_rd_vec16(bs) = let n = lct_rd_u16(bs) in if n.ok == 0 then {ok: 0, b: Nil, rest: Nil} else lct_rd_bytes(n.rest, n.v)
fn lct_rd_vec24(bs) = let n = lct_rd_u24(bs) in if n.ok == 0 then {ok: 0, b: Nil, rest: Nil} else lct_rd_bytes(n.rest, n.v)
## an extension block: 1 when it parses to the last byte and no type occurs twice (RFC 8446 section 4.2)
fn lct_ext_scan(bs, seen) = if lct_isnil(bs) == 1 then 1 else let t = lct_rd_u16(bs) in let d = lct_rd_vec16(t.rest) in if t.ok == 0 or d.ok == 0 or lct_mem(seen, t.v) == 1 then 0 else lct_ext_scan(d.rest, Cons(t.v, seen))
## {ok: 1 when present, b: extension_data}
fn lct_ext_find(bs, typ) = if lct_isnil(bs) == 1 then {ok: 0, b: Nil} else let t = lct_rd_u16(bs) in let d = lct_rd_vec16(t.rest) in if t.ok == 0 or d.ok == 0 then {ok: 0, b: Nil} else if t.v == typ then {ok: 1, b: d.b} else lct_ext_find(d.rest, typ)
## the first extension type outside `allowed`, or -1
fn lct_ext_other(bs, allowed) = if lct_isnil(bs) == 1 then 0 - 1 else let t = lct_rd_u16(bs) in let d = lct_rd_vec16(t.rest) in if t.ok == 0 or d.ok == 0 then 0 - 1 else if lct_mem(allowed, t.v) == 1 then lct_ext_other(d.rest, allowed) else t.v
fn lct_u16s_has(bs, v) = match bs
    Cons(a, Cons(b, r)) => if a * 256 + b == v then 1 else lct_u16s_has(r, v)
    _                   => 0
## the x25519 entry of a ClientHello key_share list: {ok, b: key_exchange}
fn lct_ks_find(bs) = if lct_isnil(bs) == 1 then {ok: 0, b: Nil} else let g = lct_rd_u16(bs) in let k = lct_rd_vec16(g.rest) in if g.ok == 0 or k.ok == 0 then {ok: 0, b: Nil} else if g.v == 29 then {ok: 1, b: k.b} else lct_ks_find(k.rest)

## handshake messages (RFC 8446 section 4): type, 24-bit length, body
fn lct_tls13_hs_msg(typ, body) = Cons(typ, lct_vec24(body))
fn lct_tls13_ext(typ, data) = lct_u16_push(typ, lct_vec16(data))
## the extensions this client offers: supported_versions = TLS 1.3, supported_groups = x25519, signature_algorithms =
## ed25519, one x25519 key_share, server_certificate_type = RawPublicKey (RFC 7250)
fn lct_tls13_client_exts(x_pub) = lct_concat([lct_tls13_ext(43, [2, 3, 4]), lct_tls13_ext(10, [0, 2, 0, 29]), lct_tls13_ext(13, [0, 2, 8, 7]), lct_tls13_ext(51, lct_vec16(Cons(0, Cons(29, lct_vec16(x_pub))))), lct_tls13_ext(20, [1, 2])])
fn lct_tls13_client_hello_ex(rnd, sid, suites, exts) = lct_tls13_hs_msg(1, lct_concat([[3, 3], rnd, lct_vec8(sid), lct_vec16(suites), [1, 0], lct_vec16(exts)]))
fn lct_tls13_client_hello(rnd, sid, x_pub) = lct_tls13_client_hello_ex(rnd, sid, [19, 3], lct_tls13_client_exts(x_pub))
fn lct_tls13_server_exts(x_pub) = lct_app(lct_tls13_ext(43, [3, 4]), lct_tls13_ext(51, Cons(0, Cons(29, lct_vec16(x_pub)))))
fn lct_tls13_server_hello_ex(rnd, sid, suite, exts) = lct_tls13_hs_msg(2, lct_concat([[3, 3], rnd, lct_vec8(sid), lct_u16_push(suite, [0]), lct_vec16(exts)]))
fn lct_tls13_server_hello(rnd, sid, x_pub) = lct_tls13_server_hello_ex(rnd, sid, 4867, lct_tls13_server_exts(x_pub))
fn lct_tls13_encrypted_extensions() = lct_tls13_hs_msg(8, lct_vec16(lct_tls13_ext(20, [2])))
fn lct_tls13_certificate_request() = lct_tls13_hs_msg(13, Cons(0, lct_vec16(lct_tls13_ext(13, [0, 2, 8, 7]))))
## DER header of an Ed25519 SubjectPublicKeyInfo (RFC 8410): SEQUENCE { SEQUENCE { OID 1.3.101.112 }, BIT STRING (32 bytes) }
fn lct_tls13_spki_ed25519() = [48, 42, 48, 5, 6, 3, 43, 101, 112, 3, 33, 0]
## Certificate with one entry: the raw public key, no entry extensions. NOT an X.509 certificate.
fn lct_tls13_certificate(pk) = lct_tls13_hs_msg(11, Cons(0, lct_vec24(lct_app(lct_vec24(lct_app(lct_tls13_spki_ed25519(), pk)), [0, 0]))))
fn lct_tls13_certificate_empty() = lct_tls13_hs_msg(11, [0, 0, 0, 0])
## the signed content of the server CertificateVerify (section 4.4.3): 64 spaces, the context string, 0, Transcript-Hash
fn lct_tls13_cv_content(transcript_hash) = lct_repeat(32, 64, lct_app(lct_str_to_bytes("TLS 1.3, server CertificateVerify"), Cons(0, transcript_hash)))
fn lct_tls13_certificate_verify(seed, transcript_hash) = lct_tls13_hs_msg(15, Cons(8, Cons(7, lct_vec16(lct_ed25519_sign(seed, lct_tls13_cv_content(transcript_hash))))))
## Finished (section 4.4.4): HMAC(finished_key(base secret), Transcript-Hash)
fn lct_tls13_finished(base_secret, transcript_hash) = lct_tls13_hs_msg(20, lct_tls13_finished_verify(base_secret, transcript_hash))
## the ServerHello.random that marks a HelloRetryRequest: SHA-256("HelloRetryRequest") (section 4.1.3)
fn lct_tls13_hrr_random() = lct_sha256(lct_str_to_bytes("HelloRetryRequest"))
fn lct_tls13_plain_record(ctype, data) = Cons(ctype, Cons(3, Cons(3, lct_u16_push(lct_len(data), data))))
## cut the first record off a byte stream: {ok, record, rest}; ok == 0 while the record is incomplete
fn lct_tls13_next_record(bs) = let n = lct_len(bs) in let l = lct_nth(bs, 3) * 256 + lct_nth(bs, 4) in if n < 5 or n < 5 + l then {ok: 0, record: Nil, rest: bs} else let s = lct_split(bs, 5 + l) in {ok: 1, record: s.a, rest: s.b}

## parsing. {ok, ver, rnd, sid, suite, comp, exts}
fn lct_tls13_parse_server_hello(body) = let v = lct_rd_u16(body) in let r = lct_rd_bytes(v.rest, 32) in let s = lct_rd_vec8(r.rest) in let c = lct_rd_u16(s.rest) in let m = lct_rd_u8(c.rest) in let e = lct_rd_vec16(m.rest) in {ok: if v.ok == 1 and r.ok == 1 and s.ok == 1 and c.ok == 1 and m.ok == 1 and e.ok == 1 and lct_isnil(e.rest) == 1 and lct_ext_scan(e.b, Nil) == 1 then 1 else 0, ver: v.v, rnd: r.b, sid: s.b, suite: c.v, comp: m.v, exts: e.b}
## 0 when the ServerHello is acceptable, else the alert to send: 50 decode_error, 47 illegal_parameter (wrong legacy
## version, session id echo, unoffered cipher suite / compression / version / group), 40 a HelloRetryRequest (not
## implemented), 70 protocol_version (no supported_versions: a TLS 1.2 answer), 110 unsupported_extension, 109 no key_share
fn lct_tls13_server_hello_check(p, sid) = if p.ok == 0 then 50 else if p.ver != 771 then 47 else if lct_ct_eq(p.rnd, lct_tls13_hrr_random()) == 1 then 40 else if lct_ct_eq(p.sid, sid) == 0 or p.suite != 4867 or p.comp != 0 then 47 else let sv = lct_ext_find(p.exts, 43) in let ks = lct_ext_find(p.exts, 51) in let g = lct_rd_u16(ks.b) in let k = lct_rd_vec16(g.rest) in if sv.ok == 0 then 70 else if lct_ct_eq(sv.b, [3, 4]) == 0 then 47 else if lct_ext_other(p.exts, [43, 51]) != 0 - 1 then 110 else if ks.ok == 0 then 109 else if g.ok == 0 or k.ok == 0 or lct_isnil(k.rest) == 0 then 50 else if g.v != 29 or lct_len(k.b) != 32 then 47 else 0
fn lct_tls13_server_hello_key(exts) = (lct_rd_vec16(lct_drop((lct_ext_find(exts, 51)).b, 2))).b
## {ok, ver, rnd, sid, suites, comp, exts}; a ClientHello that ends after the compression methods has no extensions
fn lct_tls13_parse_client_hello(body) = let v = lct_rd_u16(body) in let r = lct_rd_bytes(v.rest, 32) in let s = lct_rd_vec8(r.rest) in let c = lct_rd_vec16(s.rest) in let m = lct_rd_vec8(c.rest) in let e = if m.ok == 1 and lct_isnil(m.rest) == 1 then {ok: 1, b: Nil, rest: Nil} else lct_rd_vec16(m.rest) in {ok: if v.ok == 1 and r.ok == 1 and s.ok == 1 and c.ok == 1 and m.ok == 1 and e.ok == 1 and lct_isnil(e.rest) == 1 and lct_len(s.b) <= 32 and lct_len(c.b) >= 2 and lct_len(c.b) % 2 == 0 and lct_ext_scan(e.b, Nil) == 1 then 1 else 0, ver: v.v, rnd: r.b, sid: s.b, suites: c.b, comp: m.b, exts: e.b}
## 0 when this server can answer the ClientHello, else the alert: 50 decode_error, 70 protocol_version (TLS 1.3 not
## offered), 47 illegal_parameter, 40 handshake_failure (no common suite / group / signature scheme, or an x25519 share
## would need a HelloRetryRequest), 109 missing_extension, 43 unsupported_certificate (raw public keys not offered)
fn lct_tls13_client_hello_check(p) = if p.ok == 0 then 50 else if p.ver != 771 then 70 else if lct_ct_eq(p.comp, [0]) == 0 then 47 else let sv = lct_ext_find(p.exts, 43) in let svl = lct_rd_vec8(sv.b) in let sg = lct_ext_find(p.exts, 10) in let sgl = lct_rd_vec16(sg.b) in let sa = lct_ext_find(p.exts, 13) in let sal = lct_rd_vec16(sa.b) in let ks = lct_ext_find(p.exts, 51) in let ksl = lct_rd_vec16(ks.b) in let ct = lct_ext_find(p.exts, 20) in let ctl = lct_rd_vec8(ct.b) in let k = lct_ks_find(ksl.b) in if sv.ok == 0 then 70 else if svl.ok == 0 or lct_isnil(svl.rest) == 0 then 50 else if lct_u16s_has(svl.b, 772) == 0 then 70 else if lct_u16s_has(p.suites, 4867) == 0 then 40 else if sg.ok == 0 or sa.ok == 0 or ks.ok == 0 then 109 else if sgl.ok == 0 or lct_isnil(sgl.rest) == 0 or sal.ok == 0 or lct_isnil(sal.rest) == 0 or ksl.ok == 0 or lct_isnil(ksl.rest) == 0 then 50 else if lct_u16s_has(sgl.b, 29) == 0 or lct_u16s_has(sal.b, 2055) == 0 then 40 else if ct.ok == 0 or ctl.ok == 0 or lct_isnil(ctl.rest) == 0 or lct_mem(ctl.b, 2) == 0 then 43 else if k.ok == 0 then 40 else if lct_len(k.b) != 32 then 47 else 0
fn lct_tls13_client_hello_key(exts) = (lct_ks_find((lct_rd_vec16((lct_ext_find(exts, 51)).b)).b)).b
fn lct_tls13_cert_bad(a) = {alert: a, pk: Nil}
## {alert: 0 or the alert, pk}: exactly one entry holding an Ed25519 SubjectPublicKeyInfo, empty request context, no
## entry extensions. An empty list is a decode_error (section 4.4.2.4), any other key type unsupported_certificate.
fn lct_tls13_parse_certificate(body) = let c = lct_rd_vec8(body) in let l = lct_rd_vec24(c.rest) in let d = lct_rd_vec24(l.b) in let x = lct_rd_vec16(d.rest) in let s = lct_split(d.b, 12) in if c.ok == 0 or l.ok == 0 or lct_isnil(l.rest) == 0 then lct_tls13_cert_bad(50) else if lct_isnil(c.b) == 0 then lct_tls13_cert_bad(47) else if lct_isnil(l.b) == 1 or d.ok == 0 or x.ok == 0 then lct_tls13_cert_bad(50) else if lct_isnil(x.rest) == 0 then lct_tls13_cert_bad(47) else if lct_isnil(x.b) == 0 then lct_tls13_cert_bad(110) else if lct_len(d.b) != 44 or lct_ct_eq(s.a, lct_tls13_spki_ed25519()) == 0 then lct_tls13_cert_bad(43) else {alert: 0, pk: s.b}

## connection state
fn lct_hs_keys0() = {live: 0, key: Nil, iv: Nil, seq: 0}
fn lct_hs_keys(secret) = let k = lct_tls13_traffic_keys(secret, 32) in {live: 1, key: k.key, iv: k.iv, seq: 0}
fn lct_hs_keys_next(k) = {live: k.live, key: k.key, iv: k.iv, seq: k.seq + 1}
fn lct_hs_sec(hs, c_hs, s_hs, c_ap, s_ap, exp_master) = {hs: hs, c_hs: c_hs, s_hs: s_hs, c_ap: c_ap, s_ap: s_ap, exp_master: exp_master}
fn lct_hs_cfg(rnd, sid, x_priv, pin, seed, cert_pk, req_cert) = {rnd: rnd, sid: sid, x_priv: x_priv, pin: pin, seed: seed, cert_pk: cert_pk, req_cert: req_cert}
## client: 32-byte random, legacy_session_id (0..32 bytes, normally empty), 32-byte X25519 private key, the pinned
## 32-byte Ed25519 public key of the server. All of it is caller-supplied; random and private key must be fresh.
fn lct_tls13_client_config(rnd, sid, x25519_private, pinned_server_key) = lct_hs_cfg(rnd, sid, x25519_private, pinned_server_key, Nil, Nil, 0)
## server: 32-byte random, 32-byte X25519 private key (both fresh per connection), the Ed25519 seed of its long-term
## key, and 1 to send a CertificateRequest (only the empty client Certificate is accepted in answer)
fn lct_tls13_server_config(rnd, x25519_private, ed25519_seed, request_client_cert) = lct_hs_cfg(rnd, Nil, x25519_private, Nil, ed25519_seed, lct_ed25519_public_key(ed25519_seed), request_client_cert)
## {state, alert: the alert sent or -1, peer_alert: the alert received or -1, steps: legal transitions taken, cfg,
##  tr: the handshake transcript, hbuf: handshake bytes not yet forming a message, sec: secrets, rd / wr: record
##  protection of each direction, cr: CertificateRequest seen / sent, out: records to transmit, app: data received}
fn lct_hs_mk(state, alert, peer_alert, steps, cfg, tr, hbuf, sec, rd, wr, cr, out, app) = {state: state, alert: alert, peer_alert: peer_alert, steps: steps, cfg: cfg, tr: tr, hbuf: hbuf, sec: sec, rd: rd, wr: wr, cr: cr, out: out, app: app}
fn lct_hs_io(st, out, app) = lct_hs_mk(st.state, st.alert, st.peer_alert, st.steps, st.cfg, st.tr, st.hbuf, st.sec, st.rd, st.wr, st.cr, out, app)
fn lct_hs_buf(st, hbuf) = lct_hs_mk(st.state, st.alert, st.peer_alert, st.steps, st.cfg, st.tr, hbuf, st.sec, st.rd, st.wr, st.cr, st.out, st.app)
fn lct_hs_keyed(st, sec, rd, wr) = lct_hs_mk(st.state, st.alert, st.peer_alert, st.steps, st.cfg, st.tr, st.hbuf, sec, rd, wr, st.cr, st.out, st.app)
## take the legal transition for `ev` (the caller has checked that there is one) and extend the transcript
fn lct_hs_adv(st, ev, tr, cr) = lct_hs_mk(lct_tls13_hs_next(st.state, ev), st.alert, st.peer_alert, st.steps + 1, st.cfg, tr, st.hbuf, st.sec, st.rd, st.wr, cr, st.out, st.app)
fn lct_hs_alert_record(wr, desc) = let body = Cons(if desc == 0 then 1 else 2, Cons(desc, Nil)) in if wr.live == 1 then lct_tls13_record_seal(wr.key, wr.iv, wr.seq, 21, body) else lct_tls13_plain_record(21, body)
fn lct_hs_wiped(alert, peer_alert, steps, out) = lct_hs_mk(99, alert, peer_alert, steps, lct_hs_cfg(Nil, Nil, Nil, Nil, Nil, Nil, 0), Nil, Nil, lct_hs_sec(Nil, Nil, Nil, Nil, Nil, Nil), lct_hs_keys0(), lct_hs_keys0(), 0, out, Nil)
## fail closed: state 99, every secret, key and private value dropped from the state, one alert for the peer
fn lct_hs_fail(st, desc) = lct_hs_wiped(desc, 0 - 1, st.steps, Cons(lct_hs_alert_record(st.wr, desc), Nil))
## the peer sent an alert: same erasure, nothing is sent back
fn lct_hs_dead(st, peer_desc) = lct_hs_wiped(0 - 1, peer_desc, st.steps, Nil)

## client side. ServerHello: checks, then ECDHE (all-zero result refused), then the handshake traffic keys
fn lct_hs_c_sh2(st, tr, dh) = if dh.ok == 0 then lct_hs_fail(st, 47) else let hh = lct_sha256(tr) in let hs = lct_tls13_handshake_secret(lct_tls13_early_secret(Nil), dh.secret) in let c_hs = lct_tls13_derive_secret(hs, "c hs traffic", hh) in let s_hs = lct_tls13_derive_secret(hs, "s hs traffic", hh) in lct_hs_keyed(lct_hs_adv(st, 2, tr, 0), lct_hs_sec(hs, c_hs, s_hs, Nil, Nil, Nil), lct_hs_keys(s_hs), lct_hs_keys(c_hs))
fn lct_hs_c_sh(st, cfg, body, msg) = let p = lct_tls13_parse_server_hello(body) in let bad = lct_tls13_server_hello_check(p, cfg.sid) in if bad != 0 then lct_hs_fail(st, bad) else if lct_isnil(st.hbuf) == 0 then lct_hs_fail(st, 10) else lct_hs_c_sh2(st, lct_app(st.tr, msg), lct_x25519_shared(cfg.x_priv, lct_tls13_server_hello_key(p.exts)))
## EncryptedExtensions: only what was offered may come back, and the raw-public-key certificate type must be confirmed
fn lct_hs_c_ee(st, body, msg) = let e = lct_rd_vec16(body) in let ct = lct_ext_find(e.b, 20) in if e.ok == 0 or lct_isnil(e.rest) == 0 or lct_ext_scan(e.b, Nil) == 0 then lct_hs_fail(st, 50) else if lct_ext_other(e.b, [10, 20]) != 0 - 1 then lct_hs_fail(st, 110) else if ct.ok == 0 then lct_hs_fail(st, 43) else if lct_ct_eq(ct.b, [2]) == 0 then lct_hs_fail(st, 47) else lct_hs_adv(st, 8, lct_app(st.tr, msg), st.cr)
fn lct_hs_c_cr(st, body, msg) = let c = lct_rd_vec8(body) in let e = lct_rd_vec16(c.rest) in if c.ok == 0 or e.ok == 0 or lct_isnil(e.rest) == 0 or lct_ext_scan(e.b, Nil) == 0 then lct_hs_fail(st, 50) else if lct_isnil(c.b) == 0 then lct_hs_fail(st, 47) else if (lct_ext_find(e.b, 13)).ok == 0 then lct_hs_fail(st, 109) else lct_hs_adv(st, 13, lct_app(st.tr, msg), 1)
## Certificate: the raw key must be the pinned one (46 certificate_unknown otherwise). No chain, no X.509.
fn lct_hs_c_cert(st, cfg, body, msg) = let p = lct_tls13_parse_certificate(body) in if p.alert != 0 then lct_hs_fail(st, p.alert) else if lct_ct_eq(p.pk, cfg.pin) == 0 then lct_hs_fail(st, 46) else lct_hs_adv(st, 11, lct_app(st.tr, msg), st.cr)
## CertificateVerify: Ed25519 under the pinned key over the transcript up to Certificate (51 decrypt_error otherwise)
fn lct_hs_c_cv(st, cfg, body, msg) = let a = lct_rd_u16(body) in let s = lct_rd_vec16(a.rest) in if a.ok == 0 or s.ok == 0 or lct_isnil(s.rest) == 0 then lct_hs_fail(st, 50) else if a.v != 2055 then lct_hs_fail(st, 47) else if lct_ed25519_verify(cfg.pin, lct_tls13_cv_content(lct_sha256(st.tr)), s.b) == 0 then lct_hs_fail(st, 51) else lct_hs_adv(st, 15, lct_app(st.tr, msg), st.cr)
## server Finished (constant-time compare), then the client flight ([empty Certificate,] Finished) under the client
## handshake key, then the application traffic keys in both directions
fn lct_hs_c_fin2(st, sec, wr, tr, fh, ms) = let cert = if st.cr == 1 then lct_tls13_certificate_empty() else Nil in let r0 = if st.cr == 1 then Cons(lct_tls13_record_seal(wr.key, wr.iv, wr.seq, 22, cert), Nil) else Nil in let tr2 = lct_app(tr, cert) in let fin = lct_tls13_finished(sec.c_hs, lct_sha256(tr2)) in let c_ap = lct_tls13_derive_secret(ms, "c ap traffic", fh) in let s_ap = lct_tls13_derive_secret(ms, "s ap traffic", fh) in lct_hs_io(lct_hs_keyed(lct_hs_adv(st, 20, lct_app(tr2, fin), st.cr), lct_hs_sec(Nil, Nil, Nil, c_ap, s_ap, lct_tls13_derive_secret(ms, "exp master", fh)), lct_hs_keys(s_ap), lct_hs_keys(c_ap)), lct_app(r0, Cons(lct_tls13_record_seal(wr.key, wr.iv, wr.seq + st.cr, 22, fin), Nil)), Nil)
fn lct_hs_c_fin(st, sec, body, msg) = if lct_ct_eq(body, lct_tls13_finished_verify(sec.s_hs, lct_sha256(st.tr))) == 0 then lct_hs_fail(st, 51) else if lct_isnil(st.hbuf) == 0 then lct_hs_fail(st, 10) else let tr = lct_app(st.tr, msg) in lct_hs_c_fin2(st, sec, st.wr, tr, lct_sha256(tr), lct_tls13_master_secret(sec.hs))

## server side. The whole flight: ServerHello in the clear, then EncryptedExtensions, [CertificateRequest,]
## Certificate, CertificateVerify and Finished under the server handshake key, one message per record
fn lct_hs_seal_all(k, seq, msgs, acc) = match msgs
    Nil        => lct_rev(acc)
    Cons(m, r) => if lct_isnil(m) == 1 then lct_hs_seal_all(k, seq, r, acc) else lct_hs_seal_all(k, seq + 1, r, Cons(lct_tls13_record_seal(k.key, k.iv, seq, 22, m), acc))
fn lct_hs_s_flight3(st, cfg, sh, c_hs, s_hs, ms, msgs, tr) = let fh = lct_sha256(tr) in let s_ap = lct_tls13_derive_secret(ms, "s ap traffic", fh) in lct_hs_io(lct_hs_keyed(lct_hs_adv(lct_hs_adv(st, 102, tr, cfg.req_cert), if cfg.req_cert == 1 then 104 else 103, tr, cfg.req_cert), lct_hs_sec(Nil, c_hs, Nil, lct_tls13_derive_secret(ms, "c ap traffic", fh), s_ap, lct_tls13_derive_secret(ms, "exp master", fh)), lct_hs_keys(c_hs), lct_hs_keys(s_ap)), Cons(lct_tls13_plain_record(22, sh), lct_hs_seal_all(lct_hs_keys(s_hs), 0, msgs, Nil)), Nil)
fn lct_hs_s_flight2(st, cfg, sh, hs, c_hs, s_hs, ee, cr, cert, t2) = let cv = lct_tls13_certificate_verify(cfg.seed, lct_sha256(t2)) in let t3 = lct_app(t2, cv) in let fin = lct_tls13_finished(s_hs, lct_sha256(t3)) in lct_hs_s_flight3(st, cfg, sh, c_hs, s_hs, lct_tls13_master_secret(hs), [ee, cr, cert, cv, fin], lct_app(t3, fin))
fn lct_hs_s_flight(st, cfg, sid, ecdhe) = let sh = lct_tls13_server_hello(cfg.rnd, sid, lct_x25519_base(cfg.x_priv)) in let t1 = lct_app(st.tr, sh) in let hh = lct_sha256(t1) in let hs = lct_tls13_handshake_secret(lct_tls13_early_secret(Nil), ecdhe) in let ee = lct_tls13_encrypted_extensions() in let cr = if cfg.req_cert == 1 then lct_tls13_certificate_request() else Nil in let cert = lct_tls13_certificate(cfg.cert_pk) in lct_hs_s_flight2(st, cfg, sh, hs, lct_tls13_derive_secret(hs, "c hs traffic", hh), lct_tls13_derive_secret(hs, "s hs traffic", hh), ee, cr, cert, lct_concat([t1, ee, cr, cert]))
fn lct_hs_s_ch2(st, cfg, sid, dh) = if dh.ok == 0 then lct_hs_fail(st, 47) else lct_hs_s_flight(lct_hs_adv(st, 101, st.tr, 0), cfg, sid, dh.secret)
## ClientHello: START -> RECVD_CH, checks, ECDHE (all-zero result refused) -> NEGOTIATED -> flight -> WAIT_FLIGHT2 -> ...
fn lct_hs_s_ch1(st, cfg, p, bad) = if bad != 0 then lct_hs_fail(st, bad) else if lct_isnil(st.hbuf) == 0 then lct_hs_fail(st, 10) else lct_hs_s_ch2(st, cfg, p.sid, lct_x25519_shared(cfg.x_priv, lct_tls13_client_hello_key(p.exts)))
fn lct_hs_s_ch(st, cfg, body, msg) = let p = lct_tls13_parse_client_hello(body) in lct_hs_s_ch1(lct_hs_adv(st, 1, msg, 0), cfg, p, lct_tls13_client_hello_check(p))
## after a CertificateRequest only the empty Certificate is accepted: client certificates are not implemented
fn lct_hs_s_cert(st, body, msg) = if lct_ct_eq(body, [0, 0, 0, 0]) == 0 then lct_hs_fail(st, 43) else lct_hs_adv(st, 11, lct_app(st.tr, msg), st.cr)
## client Finished (constant-time compare), then the client application traffic key for reading
fn lct_hs_s_fin(st, sec, body, msg) = if lct_ct_eq(body, lct_tls13_finished_verify(sec.c_hs, lct_sha256(st.tr))) == 0 then lct_hs_fail(st, 51) else if lct_isnil(st.hbuf) == 0 then lct_hs_fail(st, 10) else lct_hs_keyed(lct_hs_adv(st, 20, lct_app(st.tr, msg), st.cr), lct_hs_sec(Nil, Nil, Nil, sec.c_ap, sec.s_ap, sec.exp_master), lct_hs_keys(sec.c_ap), st.wr)

## one complete handshake message. A message with no legal transition from the current state is an
## unexpected_message (10); after CONNECTED a client ignores NewSessionTicket (4) and refuses everything else.
fn lct_hs_msg_in(st, s, typ, body, msg) = if s == 7 then (if typ == 4 then st else lct_hs_fail(st, 10)) else if lct_tls13_hs_next(s, typ) == 99 then lct_hs_fail(st, 10) else if s == 1 then lct_hs_c_sh(st, st.cfg, body, msg) else if s == 2 then lct_hs_c_ee(st, body, msg) else if s == 3 and typ == 13 then lct_hs_c_cr(st, body, msg) else if s == 3 or s == 4 then lct_hs_c_cert(st, st.cfg, body, msg) else if s == 5 then lct_hs_c_cv(st, st.cfg, body, msg) else if s == 6 then lct_hs_c_fin(st, st.sec, body, msg) else if s == 10 then lct_hs_s_ch(st, st.cfg, body, msg) else if s == 14 then lct_hs_s_cert(st, body, msg) else if s == 15 then lct_hs_s_fin(st, st.sec, body, msg) else lct_hs_fail(st, 80)
fn lct_hs_pump2(st, buf, n, m) = if m > 65536 then lct_hs_fail(st, 50) else if n < 4 + m then st else let s = lct_split(buf, 4 + m) in lct_hs_pump(lct_hs_msg_in(lct_hs_buf(st, s.b), st.state, lct_hd(buf), lct_drop(s.a, 4), s.a))
## handle every complete message in the reassembly buffer (messages may share a record or span records, section 5.1;
## the handlers refuse a key change while bytes are left over)
fn lct_hs_pump(st) = if st.state == 99 then st else let buf = st.hbuf in let n = lct_len(buf) in if n < 4 then st else lct_hs_pump2(st, buf, n, lct_nth(buf, 1) * 65536 + lct_nth(buf, 2) * 256 + lct_nth(buf, 3))
fn lct_hs_content(st, ctype, data) = if ctype == 22 then (if lct_isnil(data) == 1 then lct_hs_fail(st, 10) else lct_hs_pump(lct_hs_buf(st, lct_app(st.hbuf, data)))) else if ctype == 21 then (if lct_len(data) == 2 then lct_hs_dead(st, lct_nth(data, 1)) else lct_hs_fail(st, 50)) else if ctype == 23 and (st.state == 7 or st.state == 16) and lct_isnil(st.hbuf) == 1 then lct_hs_io(st, st.out, Cons(data, Nil)) else lct_hs_fail(st, 10)
fn lct_hs_feed_enc(st, rd, record) = if lct_hd(record) != 23 then lct_hs_fail(st, 10) else let o = lct_tls13_record_open(rd.key, rd.iv, rd.seq, record) in if o.ok == 0 then lct_hs_fail(st, 20) else if lct_len(o.data) > 16384 then lct_hs_fail(st, 22) else lct_hs_content(lct_hs_keyed(st, st.sec, lct_hs_keys_next(rd), st.wr), o.ctype, o.data)
## the middlebox-compatibility record: dropped between the first ClientHello and the peer's Finished (section 5),
## an unexpected_message anywhere else or with any other content (it then falls through to the checks below)
fn lct_hs_ccs_dropped(st, record) = if lct_ct_eq(record, [20, 3, 3, 0, 1, 1]) == 1 and st.state != 10 and st.state != 7 and st.state != 16 then 1 else 0
fn lct_hs_feed1(st, rd, record, n) = if lct_hs_ccs_dropped(st, record) == 1 then st else if n < 5 or lct_nth(record, 3) * 256 + lct_nth(record, 4) != n - 5 then lct_hs_fail(st, 50) else if rd.live == 1 then (if n > 16645 then lct_hs_fail(st, 22) else lct_hs_feed_enc(st, rd, record)) else if n > 16389 then lct_hs_fail(st, 22) else if lct_nth(record, 1) != 3 then lct_hs_fail(st, 70) else if lct_hd(record) == 23 then lct_hs_fail(st, 10) else lct_hs_content(st, lct_hd(record), lct_drop(record, 5))

## --- TLS 1.3 connection API --------------------------------------------------------------------------------------------
fn lct_hs_start_bad() = lct_hs_wiped(80, 0 - 1, 0, Nil)
## START -> WAIT_SH: `.out` is the ClientHello record. A malformed configuration gives the error state (alert 80).
fn lct_tls13_client_start(cfg) = if lct_len(cfg.rnd) != 32 or lct_len(cfg.x_priv) != 32 or lct_len(cfg.pin) != 32 or lct_len(cfg.sid) > 32 then lct_hs_start_bad() else let ch = lct_tls13_client_hello(cfg.rnd, cfg.sid, lct_x25519_base(cfg.x_priv)) in lct_hs_mk(lct_tls13_hs_next(0, 100), 0 - 1, 0 - 1, 1, cfg, ch, Nil, lct_hs_sec(Nil, Nil, Nil, Nil, Nil, Nil), lct_hs_keys0(), lct_hs_keys0(), 0, Cons(lct_tls13_plain_record(22, ch), Nil), Nil)
## a server in START, waiting for the ClientHello record
fn lct_tls13_server_start(cfg) = if lct_len(cfg.rnd) != 32 or lct_len(cfg.x_priv) != 32 or lct_len(cfg.seed) != 32 or lct_len(cfg.cert_pk) != 32 then lct_hs_start_bad() else lct_hs_mk(10, 0 - 1, 0 - 1, 0, cfg, Nil, Nil, lct_hs_sec(Nil, Nil, Nil, Nil, Nil, Nil), lct_hs_keys0(), lct_hs_keys0(), 0, Nil, Nil)
## give one received record (header included) to a client or server state: the next state, with `.out` = the records
## to transmit now and `.app` = the application data it carried. The error state absorbs every input.
fn lct_tls13_feed(st, record) = if st.state == 99 then lct_hs_io(st, Nil, Nil) else lct_hs_feed1(lct_hs_io(st, Nil, Nil), st.rd, record, lct_len(record))
fn lct_hs_feed_all(st, recs, out, app) = match recs
    Nil        => lct_hs_io(st, out, app)
    Cons(r, t) => let s = lct_tls13_feed(st, r) in lct_hs_feed_all(s, t, lct_app(out, s.out), lct_app(app, s.app))
## the same for a list of records, in order; `.out` and `.app` accumulate
fn lct_tls13_feed_all(st, recs) = lct_hs_feed_all(st, recs, Nil, Nil)
fn lct_tls13_connected(st) = if st.state == 7 or st.state == 16 then 1 else 0
## {ok, st}: protect up to 2^14 bytes of application data; `st.out` is the record. Refused (ok == 0) before CONNECTED.
fn lct_tls13_send(st, data) = if lct_tls13_connected(st) == 0 or lct_len(data) > 16384 then {ok: 0, st: lct_hs_io(st, Nil, Nil)} else let wr = st.wr in {ok: 1, st: lct_hs_io(lct_hs_keyed(st, st.sec, st.rd, lct_hs_keys_next(wr)), Cons(lct_tls13_record_seal(wr.key, wr.iv, wr.seq, 23, data), Nil), Nil)}
## close_notify: `.out` is the alert record, the state is 99 with alert == 0 and everything erased
fn lct_tls13_close(st) = if st.state == 99 then lct_hs_io(st, Nil, Nil) else lct_hs_fail(st, 0)
## {ok, c_ap, s_ap, exp_master}: the application traffic secrets and the exporter master secret, only once CONNECTED
fn lct_tls13_secrets(st) = let s = st.sec in if lct_tls13_connected(st) == 1 then {ok: 1, c_ap: s.c_ap, s_ap: s.s_ap, exp_master: s.exp_master} else {ok: 0, c_ap: Nil, s_ap: Nil, exp_master: Nil}
## 1 when a state holds no secret, key or private value at all (what the error state must look like)
fn lct_tls13_holds_nothing(st) = let s = st.sec in let c = st.cfg in let r = st.rd in let w = st.wr in if lct_isnil(s.hs) == 1 and lct_isnil(s.c_hs) == 1 and lct_isnil(s.s_hs) == 1 and lct_isnil(s.c_ap) == 1 and lct_isnil(s.s_ap) == 1 and lct_isnil(s.exp_master) == 1 and lct_isnil(c.x_priv) == 1 and lct_isnil(c.seed) == 1 and lct_isnil(r.key) == 1 and lct_isnil(r.iv) == 1 and lct_isnil(w.key) == 1 and lct_isnil(w.iv) == 1 and r.live == 0 and w.live == 0 and lct_isnil(st.tr) == 1 and lct_isnil(st.hbuf) == 1 then 1 else 0

