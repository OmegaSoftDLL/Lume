## --- known-answer tests: official vectors (FIPS 180-4, RFC 4231, RFC 5869, RFC 8439, RFC 8032, RFC 8448) ----------------
## each returns {n: checks passed, err: "" or the first mismatch}
fn lct_kat_new() = {n: 0, err: ""}
fn lct_kat_hex(k, name, got, want) = if k.err != "" then k else if lct_bytes_to_hex(got) == want then {n: k.n + 1, err: ""} else {n: k.n, err: name + ": got " + lct_bytes_to_hex(got) + ", expected " + want}
fn lct_kat_int(k, name, got, want) = if k.err != "" then k else if got == want then {n: k.n + 1, err: ""} else {n: k.n, err: name + ": got " + str(got) + ", expected " + str(want)}
fn lct_kat_join(a, b) = if a.err != "" then a else {n: a.n + b.n, err: b.err}
