fn test_remove_file() = let written = fs_write_sync("fs_remove_probe", "x") in written == 1 and fs_remove("fs_remove_probe") == 1 and fs_path_exists("fs_remove_probe") == 0

fn test_remove_missing() = fs_remove("definitely_missing_remove_probe") == 0

fn test_remove_preserves_other_files() = let written = fs_write_sync("fs_remove_other_probe", "keep") in let removed = fs_remove("fs_remove_probe") in written == 1 and fs_read_file("fs_remove_other_probe") == "keep"

fn test_remove_directory_rejected() = let made = fs_mkdir("fs_remove_dir_probe") in made == 1 and fs_remove("fs_remove_dir_probe") == 0

fn fs_remove_gate() = if test_remove_file() and test_remove_missing() and test_remove_preserves_other_files() and test_remove_directory_rejected() then "native file removal passed" else ctfail("native file removal gate failed\n")

print fs_remove_gate()
