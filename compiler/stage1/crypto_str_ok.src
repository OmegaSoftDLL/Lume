## crypto_str_ok.src -- the string API of lcrypto_tls (lcs_*) against the RFC test vectors (6234 SHA-256, 4231 HMAC,
## 8439 ChaCha20 / Poly1305 / AEAD), against the list API on many lengths, and its refusals (tampering, bad sizes).
use lcrypto_tls

fn rep(s, n) = if n <= 0 then "" else if n == 1 then s else let h = rep(s, n / 2) in h + h + (if n % 2 == 1 then s else "")
fn bytes_of(n, seed) = if n <= 0 then "" else chr((seed * 31 + n * 7) % 256) + bytes_of(n - 1, seed)
fn list_hex(s) = lct_bytes_to_hex(lct_sha256(lct_str_to_bytes(s)))

fn test_sha256_vectors() = lcs_hex(lcs_sha256("abc")) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" and lcs_hex(lcs_sha256("")) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" and lcs_hex(lcs_sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
fn test_sha256_million_a() = lcs_hex(lcs_sha256(rep("a", 1000000))) == lct_sha256_million_a_hex()
fn same_as_list(n) = if n > 200 then 1 else if lcs_hex(lcs_sha256(bytes_of(n, n))) == list_hex(bytes_of(n, n)) then same_as_list(n + 1) else 0
fn test_sha256_same_as_list_api() = same_as_list(0) == 1
fn test_hmac_vectors() = lcs_hex(lcs_hmac_sha256(rep(chr(11), 20), "Hi There")) == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7" and lcs_hex(lcs_hmac_sha256("Jefe", "what do ya want for nothing?")) == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843" and lcs_hex(lcs_hmac_sha256(rep(chr(170), 131), "Test Using Larger Than Block-Size Key - Hash Key First")) == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54"
fn sunscreen() = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
fn test_chacha20_vector() = lcs_hex(lcs_chacha20(lcs_unhex("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"), lcs_unhex("000000000000004a00000000"), 1, sunscreen())) == "6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d"
fn test_poly1305_vector() = lcs_hex(lcs_poly1305(lcs_unhex("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b"), "Cryptographic Forum Research Group")) == "a8061dc1305136c6c22b8baf0c0127a9"
fn akey() = lcs_unhex("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
fn anonce() = lcs_unhex("070000004041424344454647")
fn aaad() = lcs_unhex("50515253c0c1c2c3c4c5c6c7")
fn test_aead_seal_vector() = lcs_hex(lcs_aead_seal(akey(), anonce(), aaad(), sunscreen())) == "d31a8d34648e60db7b86afbc53ef7ec2a4aded51296e08fea9e2b5a736ee62d63dbea45e8ca9671282fafb69da92728b1a71de0a9e060b2905d6a5b67ecd3b3692ddbd7f2d778b8c9803aee328091b58fab324e4fad675945585808b4831d7bc3ff4def08e4b7a9de576d26586cec64b6116" + "1ae10b594f09e26a7e902ecbd0600691"
fn test_aead_open_round_trip() = let sealed = lcs_aead_seal(akey(), anonce(), aaad(), sunscreen()) in let r = lcs_aead_open(akey(), anonce(), aaad(), sealed) in r.ok == 1 and r.plain == sunscreen()
fn flip(s, i) = slice(s, 0, i) + chr(bit_xor(ord_at(s, i), 1)) + slice(s, i + 1, count(s))
fn test_aead_refuses_tampering() = let sealed = lcs_aead_seal(akey(), anonce(), aaad(), sunscreen()) in (lcs_aead_open(akey(), anonce(), aaad(), flip(sealed, 3))).ok == 0 and (lcs_aead_open(akey(), anonce(), aaad(), flip(sealed, count(sealed) - 1))).ok == 0 and (lcs_aead_open(akey(), anonce(), flip(aaad(), 0), sealed)).ok == 0 and (lcs_aead_open(akey(), flip(anonce(), 0), aaad(), sealed)).ok == 0 and (lcs_aead_open(akey(), anonce(), aaad(), "short")).ok == 0
fn test_aead_binary_and_sizes() = let p = bytes_of(1000, 3) + chr(0) + chr(255) in let s = lcs_aead_seal(akey(), anonce(), "", p) in count(s) == count(p) + 16 and (lcs_aead_open(akey(), anonce(), "", s)).plain == p and lcs_aead_seal(akey(), anonce(), "", "") == lcs_aead_tag(akey(), anonce(), "", "")
fn test_hex_round_trip() = lcs_unhex(lcs_hex(bytes_of(300, 9))) == bytes_of(300, 9) and lcs_hex(chr(0) + chr(171)) == "00ab"

print lcs_hex(lcs_sha256("abc"))

## the native routines against their Lume reference, on every length around the block sizes and on a long input
fn nat_sha(n) = if n > 200 then 1 else if lcs_sha256(bytes_of(n, n)) == lcs_ref_sha256(bytes_of(n, n)) then nat_sha(n + 1) else 0
fn nat_cc(n) = if n > 300 then 1 else if lcs_chacha20(akey(), anonce(), n, bytes_of(n, n + 1)) == lcs_ref_chacha20(akey(), anonce(), n, bytes_of(n, n + 1)) then nat_cc(n + 1) else 0
fn nat_poly(n) = if n > 200 then 1 else if lcs_poly1305(bytes_of(32, n), bytes_of(n, n + 2)) == lcs_ref_poly1305(bytes_of(32, n), bytes_of(n, n + 2)) then nat_poly(n + 1) else 0
fn test_native_sha256_equals_reference() = nat_sha(0) == 1 and lcs_sha256(rep("ab", 50000)) == lcs_ref_sha256(rep("ab", 50000))
fn test_native_chacha20_equals_reference() = nat_cc(0) == 1
fn test_native_poly1305_equals_reference() = nat_poly(0) == 1 and lcs_poly1305(rep(chr(255), 32), rep(chr(255), 64)) == lcs_ref_poly1305(rep(chr(255), 32), rep(chr(255), 64))
