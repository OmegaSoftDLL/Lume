## bits_ok.src -- buf_bits_write / buf_bits_read / buf_bits_ue / buf_bits_se against a reference written bit by bit.
fn rnd(s) = (s * 1103515245 + 12345) % 2147483648
## reference: bit i of the stream as a list of 0/1 kept in a buffer of one byte per bit
fn ref_put(r, pos, v, n) = if n == 0 then pos else let z = buf_set(r, pos, (v / pow2(n - 1)) % 2) in ref_put(r, pos + 1, v, n - 1)
fn pow2(k) = if k == 0 then 1 else 2 * pow2(k - 1)
fn ref_byte(r, i, k, acc) = if k == 8 then acc else ref_byte(r, i, k + 1, acc * 2 + buf_get(r, i * 8 + k))
fn same(b, r, i, n) = if i >= n then 1 else if buf_get(b, i) != ref_byte(r, i, 0, 0) then 0 else same(b, r, i + 1, n)
## random field widths 1..32 written back to back, then compared byte by byte and read back
fn wr(b, r, pos, i, s) = if i == 0 then pos else let n = rnd(s) % 32 + 1 in let v = rnd(rnd(s)) % pow2(n) in let p = buf_bits_write(b, pos, v, n) in let q = ref_put(r, pos, v, n) in if p != q then 0 - 1 else wr(b, r, p, i - 1, rnd(rnd(s)))
fn rd(b, pos, i, s) = if i == 0 then 1 else let n = rnd(s) % 32 + 1 in let v = rnd(rnd(s)) % pow2(n) in if buf_bits_read(b, pos, n) != v then 0 else rd(b, pos + n, i - 1, rnd(rnd(s)))
fn test_write_read_random_widths() = let b = buf_new(1200) in let r = buf_new(9600) in let end = wr(b, r, 0, 200, 99) in end > 0 and same(b, r, 0, end / 8) == 1 and rd(b, 0, 200, 99) == 1
## Exp-Golomb (9.1): ue 0 -> 1, 1 -> 010, 2 -> 011, 3 -> 00100, 7 -> 0001000; se 1 -> 010, -1 -> 011, 2 -> 00100
fn eg(f, v) = let b = buf_new(8) in let p = (if f == 0 then buf_bits_ue(b, 0, v) else buf_bits_se(b, 0, v)) in str(p) + ":" + str(buf_bits_read(b, 0, p))
fn test_exp_golomb() = eg(0, 0) == "1:1" and eg(0, 1) == "3:2" and eg(0, 2) == "3:3" and eg(0, 3) == "5:4" and eg(0, 7) == "7:8" and eg(1, 1) == "3:2" and eg(1, 0 - 1) == "3:3" and eg(1, 2) == "5:4" and eg(1, 0) == "1:1"
fn test_wrong_arguments() = let b = buf_new(2) in buf_bits_write(b, 0, 1, 0) == 0 - 1 and buf_bits_write(b, 0, 1, 33) == 0 - 1 and buf_bits_write(b, 10, 1, 7) == 0 - 1 and buf_bits_read(b, 0 - 1, 3) == 0 - 1 and buf_bits_ue(b, 0, 0 - 1) == 0 - 1 and buf_bits_write(7, 0, 1, 1) == 0 - 1
