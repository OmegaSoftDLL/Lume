## datetime_ok.src -- `use std/datetime`: civil dates, ISO 8601, weekdays and the daylight rules
use datetime

fn test_epoch() = dt_iso(0) == "1970-01-01T00:00:00Z" and dt_to_unix(1970, 1, 1, 0, 0, 0) == 0 and dt_iso(0 - 1) == "1969-12-31T23:59:59Z"
fn test_known_instants() = dt_iso(1700000000) == "2023-11-14T22:13:20Z" and dt_to_unix(2000, 2, 29, 12, 0, 0) == 951825600 and dt_iso(4102444800) == "2100-01-01T00:00:00Z"
fn test_weekday() = dt_weekday(0) == 4 and dt_weekday(dt_to_unix(2026, 11, 19, 12, 0, 0)) == 4 and dt_weekday(dt_to_unix(2000, 1, 1, 0, 0, 0)) == 6
fn test_leap() = dt_leap(2000) and dt_leap(2024) and dt_leap(1900) == false and dt_days_in_month(2023, 2) == 28 and dt_days_in_month(2024, 2) == 29
fn test_add() = dt_iso(dt_add_months(dt_to_unix(2024, 1, 31, 8, 0, 0), 1)) == "2024-02-29T08:00:00Z" and dt_iso(dt_add_days(0, 365)) == "1971-01-01T00:00:00Z" and dt_iso(dt_add_months(dt_to_unix(2024, 11, 15, 0, 0, 0), 3)) == "2025-02-15T00:00:00Z"
fn test_parse() = dt_parse_iso("2023-11-14T22:13:20Z") == 1700000000 and dt_parse_iso("2023-11-14T19:13:20-03:00") == 1700000000 and dt_parse_iso("2023-11-14T22:13:20.500+00:00") == 1700000000 and dt_parse_iso("2023-11-14") == 1699920000 and dt_parse_iso("2023-02-30") == 0 - 1 and dt_parse_iso("nope") == 0 - 1
fn test_zones_fixed() = dt_iso_local("America/Sao_Paulo", 1700000000) == "2023-11-14T19:13:20-03:00" and dt_iso_local("+05:30", 0) == "1970-01-01T05:30:00+05:30" and dt_offset("Asia/Tokyo", 0) == 32400
## US 2024: daylight from 2024-03-10 07:00 UTC to 2024-11-03 06:00 UTC in New York
fn test_us_rule() = dt_offset("America/New_York", dt_to_unix(2024, 3, 10, 6, 59, 59)) == 0 - 18000 and dt_offset("America/New_York", dt_to_unix(2024, 3, 10, 7, 0, 0)) == 0 - 14400 and dt_offset("America/New_York", dt_to_unix(2024, 11, 3, 5, 59, 59)) == 0 - 14400 and dt_offset("America/New_York", dt_to_unix(2024, 11, 3, 6, 0, 0)) == 0 - 18000
## EU 2024: summer time from 2024-03-31 01:00 UTC to 2024-10-27 01:00 UTC
fn test_eu_rule() = dt_offset("Europe/Paris", dt_to_unix(2024, 3, 31, 0, 59, 59)) == 3600 and dt_offset("Europe/Paris", dt_to_unix(2024, 3, 31, 1, 0, 0)) == 7200 and dt_offset("Europe/London", dt_to_unix(2024, 10, 27, 0, 59, 59)) == 3600 and dt_offset("Europe/London", dt_to_unix(2024, 10, 27, 1, 0, 0)) == 0
## Sydney: daylight until the first Sunday of April (2024-04-07 03:00 local) and from the first Sunday of October
fn test_au_rule() = dt_offset("Australia/Sydney", dt_to_unix(2024, 1, 15, 0, 0, 0)) == 39600 and dt_offset("Australia/Sydney", dt_to_unix(2024, 6, 15, 0, 0, 0)) == 36000 and dt_offset("Australia/Sydney", dt_to_unix(2024, 4, 6, 16, 0, 0)) == 36000 and dt_offset("Australia/Sydney", dt_to_unix(2024, 4, 6, 15, 59, 59)) == 39600
