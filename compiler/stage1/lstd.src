fn lumeputer_inweights_lcert_check(obligation_slack: int, cert_sig_ok: int) -> int / pure requires obligation_slack >= 0 - 1000000 and obligation_slack <= 1000000 and cert_sig_ok >= 0 and cert_sig_ok <= 1 ensures result >= 0 and result <= 1 = if cert_sig_ok == 1 and obligation_slack >= 0 then 1 else 0

