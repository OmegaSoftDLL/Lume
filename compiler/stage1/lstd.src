fn prover_nonlinear_horner_lower_bound(x_lo: int, c2: int, c1: int, c0: int) -> int / pure requires x_lo >= 1 and x_lo <= 4 and c2 >= 0 and c2 <= 1000000 and c1 >= 0 and c1 <= 1000000 and c0 >= 0 and c0 <= 1000000 ensures result >= c0 = if x_lo == 1 then c2 + c1 + c0 else if x_lo == 2 then c2 * 4 + c1 * 2 + c0 else if x_lo == 3 then c2 * 9 + c1 * 3 + c0 else c2 * 16 + c1 * 4 + c0

