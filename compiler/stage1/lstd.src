fn vex_simd_hardware_add4_sum(lane_a: int, lane_b: int) -> int / pure requires lane_a >= 0 and lane_a <= 100000000 and lane_b >= 0 and lane_b <= 100000000 ensures result == 4 * (lane_a + lane_b) and result >= 0 = simd_add4_i64(lane_a, lane_b)

