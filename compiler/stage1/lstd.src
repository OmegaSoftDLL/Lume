fn c_header_preprocessor_macro_strip_ok(ifdef_depth: int, extern_decls: int, has_unterminated_macro: int) -> int / pure requires ifdef_depth >= 0 and extern_decls >= 0 and has_unterminated_macro >= 0 and has_unterminated_macro <= 1 ensures result >= 0 and result <= 1 = if ifdef_depth == 0 and extern_decls >= 1 and has_unterminated_macro == 0 then 1 else 0

