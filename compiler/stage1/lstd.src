fn incremental_can_reuse_downstream_mod(old_iface_digest: int, new_iface_digest: int, lumec_hash_match: int) -> int / pure requires old_iface_digest >= 0 and new_iface_digest >= 0 and lumec_hash_match >= 0 and lumec_hash_match <= 1 ensures result >= 0 and result <= 1 = if lumec_hash_match == 1 and old_iface_digest == new_iface_digest then 1 else 0

@bound(24)
fn lumeputer_ecall_save_mepc(pc_bytes: int) -> int / pure requires pc_bytes >= 262144 and pc_bytes <= 524280 ensures result == pc_bytes + 4 and result > pc_bytes = pc_bytes + 4

