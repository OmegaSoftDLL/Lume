## Lume Standard Library Core (`use lstd`)
## Formally verified QF_LIA math (`0001_math_clamp`) and generic collection invariants (`vec`, `map`).

@bound(16)
fn std_clamp(x: int, lo: int, hi: int) -> int / pure requires lo <= hi ensures result >= lo and result <= hi = if x < lo then lo else if x > hi then hi else x

@bound(16)
fn std_vec_clamp_index(idx: int, len: int) -> int / pure requires len >= 1 ensures result >= 0 and result < len = if idx < 0 then 0 else if idx >= len then len - 1 else idx

@bound(8)
fn std_vec_checked_slice_len(start: int, end_idx: int, total_len: int) -> int / pure requires start >= 0 and end_idx >= start and end_idx <= total_len ensures result == end_idx - start and result >= 0 and result <= total_len = end_idx - start

@bound(8)
fn std_map_checked_slot(hash_pos: int, cap: int) -> int / pure requires hash_pos >= 0 and cap >= 1 and hash_pos < cap ensures result >= 0 and result < cap = hash_pos

law std_vec_slice_conservation_law(start: int, end_idx: int) = start + (end_idx - start) == end_idx

law std_clamp_idempotent_in_range(x: int, lo: int, hi: int) = if lo <= x and x <= hi then (if x < lo then lo else if x > hi then hi else x) == x else true

fn test_std_clamp() = if std_clamp(5, 0, 10) == 5 and std_clamp(0 - 3, 0, 10) == 0 and std_clamp(25, 0, 10) == 10 and std_clamp(4, 4, 4) == 4 then 1 else 0

fn test_std_vec_clamp_index() = if std_vec_clamp_index(0 - 5, 8) == 0 and std_vec_clamp_index(0, 8) == 0 and std_vec_clamp_index(3, 8) == 3 and std_vec_clamp_index(8, 8) == 7 and std_vec_clamp_index(99, 8) == 7 then 1 else 0

fn test_std_vec_checked_slice_len() = if std_vec_checked_slice_len(0, 0, 10) == 0 and std_vec_checked_slice_len(2, 7, 10) == 5 and std_vec_checked_slice_len(0, 10, 10) == 10 then 1 else 0

fn test_std_map_checked_slot() = if std_map_checked_slot(0, 16) == 0 and std_map_checked_slot(7, 16) == 7 and std_map_checked_slot(15, 16) == 15 then 1 else 0

print str(std_clamp(15, 0, 10)) + ":" + str(std_vec_clamp_index(9, 4)) + ":" + str(std_vec_checked_slice_len(2, 6, 8)) + ":" + str(std_map_checked_slot(3, 8))
