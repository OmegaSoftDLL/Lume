## Lume Standard Library Core (`use lstd`)
## Formally verified QF_LIA math (`0001_math_clamp`) and generic collection invariants (`vec`, `map`).

@bound(16)
fn std_clamp(x: int, lo: int, hi: int) -> int / pure requires lo <= hi ensures result >= lo and result <= hi = if x < lo then lo else if x > hi then hi else x

@bound(16)
fn std_vec_clamp_index(idx: int, len: int) -> int / pure requires len >= 1 ensures result >= 0 and result < len = if idx < 0 then 0 else if idx >= len then len - 1 else idx

@bound(8)
fn std_vec_checked_slice_len(start: int, end_idx: int, total_len: int) -> int / pure requires start >= 0 and end_idx >= start and end_idx <= total_len ensures result == end_idx - start and result >= 0 and result <= total_len = end_idx - start

@bound(8)
fn std_map_checked_slot(hash_pos: int, cap: int) -> int / pure requires hash_pos >= 0 and cap >= 1 and hash_pos < cap ensures result >= 0 and result < cap = hash_pos

@bound(16)
fn std_lumeputer_deltanet_ram_step(old_val: int, new_val: int, beta_gate: int) -> int / pure requires beta_gate == 0 or beta_gate == 1 ensures (beta_gate == 1 and result == new_val) or (beta_gate == 0 and result == old_val) = if beta_gate == 1 then new_val else old_val

@bound(16)
fn std_lumeputer_swiglu_relu_gate(val: int, gate_active: int, k_gain: int) -> int / pure requires (gate_active == 0 or gate_active == 1) and k_gain >= 18 ensures (gate_active == 0 and result == 0) or (gate_active == 1 and result == val) = if gate_active == 1 then val else 0

@bound(16)
fn std_lumepu_vx_vmat_mac(acc: int, act_i8: int, w_i4: int, scale: int) -> int / pure requires scale >= 1 ensures result == acc + act_i8 * w_i4 * scale = acc + act_i8 * w_i4 * scale

@bound(24)
fn lumeputer_stack_push_frame_sp(sp_bytes: int, frame_words: int) -> int / pure requires sp_bytes >= 1024 and sp_bytes <= 32768 and frame_words >= 1 and frame_words <= 64 ensures result >= 0 and result < sp_bytes = sp_bytes - frame_words * 4

@bound(24)
fn lumeputer_stack_pop_frame_sp(sp_bytes: int, frame_words: int) -> int / pure requires sp_bytes >= 0 and sp_bytes <= 32764 and frame_words >= 1 and frame_words <= 64 ensures result > sp_bytes = sp_bytes + frame_words * 4

@bound(24)
fn prover_octagon_transitive_upper(c_xy: int, c_yz: int) -> int / pure requires c_xy >= 0 - 1000000 and c_xy <= 1000000 and c_yz >= 0 - 1000000 and c_yz <= 1000000 ensures result == c_xy + c_yz = c_xy + c_yz

@bound(24)
fn prover_loop_ranking_steps_remaining(cur_measure: int, step_dec: int) -> int / pure requires cur_measure >= 1 and cur_measure <= 1000000000 and step_dec >= 1 and step_dec <= cur_measure ensures result >= 0 and result < cur_measure = cur_measure - step_dec

@bound(28)
fn incremental_module_iface_digest(pub_fn_count: int, contract_count: int, effect_row_mask: int, law_count: int) -> int / pure requires pub_fn_count >= 0 and contract_count >= 0 and effect_row_mask >= 0 and law_count >= 0 ensures result >= pub_fn_count = pub_fn_count * 131 + contract_count * 37 + effect_row_mask * 17 + law_count * 7

