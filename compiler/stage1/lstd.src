fn prover_bitshift_shl_exact_bound(val: int, shift_k: int) -> int / pure requires val >= 0 and val <= 100000000 and shift_k >= 0 and shift_k <= 3 ensures result >= val = if shift_k == 0 then val else if shift_k == 1 then val * 2 else if shift_k == 2 then val * 4 else val * 8

