fn ast_native_horner_quadratic_eval(x: int, c0: int) -> int / pure requires x >= 0 - 1000000 and x <= 1000000 and c0 >= 0 and c0 <= 1000000 ensures result >= c0 = x * x + 2 * x + 1 + c0

