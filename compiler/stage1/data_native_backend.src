fn eval(e) = match e
    Lit(n) => n
    Neg(inner) => 0 - eval(inner)
    Add(left, right) => eval(left) + eval(right)
fn sum(xs, i) = if i >= count(xs) then 0 else xs[i] + sum(xs, i + 1)
fn label(r) = let state = if r.enabled == 1 then "on" else "off" in r.name + ":" + state
print eval(Add(Lit(20), Add(Lit(3), Neg(Lit(1)))))
print sum([2, 3, 5, 7], 0)
print label({name: "native", enabled: 1})
print label({name: "legacy", enabled: 0})
print "text" + ":" + str(42)
print eval(Neg(Lit(9)))
