## video_sad_ok.src -- block distortion builtins (buf_sad16x16 / 8x8 / 4x4, buf_satd4x4 / 16x16) against a reference
## written with buf_get, on pseudo-random frames of different strides; wrong arguments give -1.
## `lume test compiler/stage1/video_sad_ok.src`

## a frame of w * h bytes filled by a linear congruential sequence (deterministic)
fn fill(b, i, n, x) = if i >= n then b else let v = (x * 1103515245 + 12345) % 2147483648 in let s = buf_set(b, i, v / 65536 % 256) in fill(b, i + 1, n, v)
fn frame(w, h, seed) = fill(buf_new(w * h), 0, w * h, seed)

fn iabs(x) = if x < 0 then 0 - x else x
fn ref_sad_row(a, ai, b, bi, i, n, acc) = if i >= n then acc else ref_sad_row(a, ai, b, bi, i + 1, n, acc + iabs(buf_get(a, ai + i) - buf_get(b, bi + i)))
fn ref_sad(a, ai, sa, b, bi, sb, n, r, acc) = if r >= n then acc else ref_sad(a, ai, sa, b, bi, sb, n, r + 1, acc + ref_sad_row(a, ai + r * sa, b, bi + r * sb, 0, n, 0))

fn dif(a, ai, sa, b, bi, sb, x, y) = buf_get(a, ai + y * sa + x) - buf_get(b, bi + y * sb + x)
## 4x4 Hadamard written out: rows of the difference, then columns, sum of |coefficients| / 2
fn h4(d0, d1, d2, d3) = [d0 + d1 + d2 + d3, d0 + d1 - d2 - d3, d0 - d1 - d2 + d3, d0 - d1 + d2 - d3]
fn row4(a, ai, sa, b, bi, sb, y) = h4(dif(a, ai, sa, b, bi, sb, 0, y), dif(a, ai, sa, b, bi, sb, 1, y), dif(a, ai, sa, b, bi, sb, 2, y), dif(a, ai, sa, b, bi, sb, 3, y))
fn col_abs(r0, r1, r2, r3, j) = let c = h4(lidx(r0, j), lidx(r1, j), lidx(r2, j), lidx(r3, j)) in iabs(lidx(c, 0)) + iabs(lidx(c, 1)) + iabs(lidx(c, 2)) + iabs(lidx(c, 3))
fn ref_satd4(a, ai, sa, b, bi, sb) = let r0 = row4(a, ai, sa, b, bi, sb, 0) in let r1 = row4(a, ai, sa, b, bi, sb, 1) in let r2 = row4(a, ai, sa, b, bi, sb, 2) in let r3 = row4(a, ai, sa, b, bi, sb, 3) in (col_abs(r0, r1, r2, r3, 0) + col_abs(r0, r1, r2, r3, 1) + col_abs(r0, r1, r2, r3, 2) + col_abs(r0, r1, r2, r3, 3)) / 2
fn ref_satd16(a, ai, sa, b, bi, sb, k, acc) = if k >= 16 then acc else let x = k % 4 * 4 in let y = k / 4 * 4 in ref_satd16(a, ai, sa, b, bi, sb, k + 1, acc + ref_satd4(a, ai + y * sa + x, sa, b, bi + y * sb + x, sb))

## positions inside a 64 x 48 frame (stride 64) and a 40 x 40 one (stride 40)
fn sad_ok(a, b, k) = if k == 0 then 1 else let ai = (k * 37) % 30 + (k * 11) % 20 * 64 in let bi = (k * 13) % 20 + (k * 7) % 20 * 40 in if buf_sad16x16(a, ai, 64, b, bi, 40) != ref_sad(a, ai, 64, b, bi, 40, 16, 0, 0) or buf_sad8x8(a, ai, 64, b, bi, 40) != ref_sad(a, ai, 64, b, bi, 40, 8, 0, 0) or buf_sad4x4(a, ai, 64, b, bi, 40) != ref_sad(a, ai, 64, b, bi, 40, 4, 0, 0) then 0 else sad_ok(a, b, k - 1)
fn satd_ok(a, b, k) = if k == 0 then 1 else let ai = (k * 29) % 30 + (k * 5) % 20 * 64 in let bi = (k * 17) % 20 + (k * 3) % 20 * 40 in if buf_satd4x4(a, ai, 64, b, bi, 40) != ref_satd4(a, ai, 64, b, bi, 40) or buf_satd16x16(a, ai, 64, b, bi, 40) != ref_satd16(a, ai, 64, b, bi, 40, 0, 0) then 0 else satd_ok(a, b, k - 1)

fn test_sad_matches_reference() = sad_ok(frame(64, 48, 7), frame(40, 40, 99), 40) == 1
fn test_satd_matches_reference() = satd_ok(frame(64, 48, 3), frame(40, 40, 51), 25) == 1
fn test_identical_blocks_are_zero() = let a = frame(32, 32, 5) in buf_sad16x16(a, 0, 32, a, 0, 32) == 0 and buf_satd16x16(a, 33, 32, a, 33, 32) == 0
## a flat difference of 1 on every pixel: SAD = 256, SATD = only the DC term 16 per 4x4 block -> 16 / 2 * 16 = 128
fn test_flat_difference() = let a = fill(buf_new(256), 0, 0, 0) in let b = buf_new(256) in let z = set_all(b, 0, 256) in buf_sad16x16(a, 0, 16, b, 0, 16) == 256 and buf_satd16x16(a, 0, 16, b, 0, 16) == 128 and buf_satd4x4(a, 0, 16, b, 0, 16) == 8
fn set_all(b, i, n) = if i >= n then b else let s = buf_set(b, i, 1) in set_all(b, i + 1, n)
fn test_wrong_arguments_give_minus_one() = let a = frame(16, 16, 1) in buf_sad16x16(a, 1, 16, a, 0, 16) == 0 - 1 and buf_sad8x8(a, 0, 4, a, 0, 16) == 0 - 1 and buf_sad4x4(a, 0 - 1, 16, a, 0, 16) == 0 - 1 and buf_satd4x4(a, 0, 16, 7, 0, 16) == 0 - 1 and buf_satd16x16(a, 0, 16, a, 0, 15) == 0 - 1 and buf_sad4x4(a, 252, 16, a, 0, 16) == 0 - 1
