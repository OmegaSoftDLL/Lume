## data_codegen.lume — native code generation for the ML-core language.
## The historical cgen_data entry point now emits x86-64 assembly directly through
## data_asmgen; assemble the result with lume0 asm, without a C compiler or as/ld.
use data_ast
use data_asmgen

fn cgen_data(prog: [DStmt]) -> str
    agen(prog)
