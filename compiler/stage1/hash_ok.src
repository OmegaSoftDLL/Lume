## hash_ok.src -- `use std/hash` against the published test vectors (RFC 1321, RFC 3174, FIPS 180-4, zlib)
use hash

fn test_crc32() = crc32("123456789") == 3421780262 and crc32("") == 0 and hex32(crc32("The quick brown fox jumps over the lazy dog")) == "414fa339"
fn test_adler32() = adler32("Wikipedia") == 300286872 and adler32("") == 1
fn test_md5() = md5("") == "d41d8cd98f00b204e9800998ecf8427e" and md5("abc") == "900150983cd24fb0d6963f7d28e17f72" and md5("The quick brown fox jumps over the lazy dog") == "9e107d9d372bb6826bd81d3542a419d6"
fn test_sha1() = sha1("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709" and sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d" and sha1("The quick brown fox jumps over the lazy dog") == "2fd4e1c67a2d28fced849ee1bb76e7391b93eb12"
fn test_sha256() = sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" and sha256("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" and sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
## 64 bytes exactly: the padding goes into a second block
fn test_block_edge() = sha1("0123456789012345678901234567890123456789012345678901234567890123") == "cf0800f7644ace3cb4c3fa33388d3ba0ea3c8b6e" and md5("0123456789012345678901234567890123456789012345678901234567890123") == "7f7bfd348709deeaace19e3f535f8c54"
