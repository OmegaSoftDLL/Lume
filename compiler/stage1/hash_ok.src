## hash_ok.src -- `use std/hash` against the published test vectors (RFC 1321, RFC 3174, FIPS 180-4, zlib)
use hash

fn test_crc32() = crc32("123456789") == 3421780262 and crc32("") == 0 and hex32(crc32("The quick brown fox jumps over the lazy dog")) == "414fa339"
## short messages go bit by bit, long ones through the table: both give the same CRC around the 2048-byte switch
fn crc_fill(b, i, n) = if i >= n then b else let w = buf_set(b, i, bit_and(i * 7 + 3, 255)) in crc_fill(b, i + 1, n)
fn test_crc32_paths_agree() = let b = crc_fill(buf_new(4096), 0, 4096) in crc32_buf(b, 0, 2047) == hs_not(hs_crc(hs_tab(), b, 0, 2047, 4294967295)) and crc32_buf(b, 0, 4096) == hs_not(hs_crcb(b, 0, 4096, 4294967295)) and crc32_buf(b, 5, 2048) == hs_not(hs_crcb(b, 5, 2053, 4294967295))
fn test_adler32() = adler32("Wikipedia") == 300286872 and adler32("") == 1
fn test_md5() = md5("") == "d41d8cd98f00b204e9800998ecf8427e" and md5("abc") == "900150983cd24fb0d6963f7d28e17f72" and md5("The quick brown fox jumps over the lazy dog") == "9e107d9d372bb6826bd81d3542a419d6"
fn test_sha1() = sha1("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709" and sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d" and sha1("The quick brown fox jumps over the lazy dog") == "2fd4e1c67a2d28fced849ee1bb76e7391b93eb12"
fn test_sha256() = sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" and sha256("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" and sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1"
## FIPS 180-4 / NIST example vectors (cross-checked with Python hashlib)
fn test_sha224() = sha224("abc") == "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7" and sha224("") == "d14a028c2a3a2bc9476102bb288234c415a2b01f828ea62ac5b3e42f"
fn test_sha512() = sha512("abc") == "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f" and sha512("") == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e" and sha512("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu") == "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909"
fn reps(s, k) = if k == 0 then "" else s + reps(s, k - 1)
## 111 and 112 bytes: the length still fits the first block, or moves the padding into a second one
fn test_sha512_block_edge() = sha512(reps("a", 112)) == "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca" and sha512(reps("a", 111)) == "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2"
fn test_sha384() = sha384("abc") == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7" and sha384(reps("0123456789", 100)) == "a38444770a3b0811f193ca02b1de3291e79e51f7bad116ed7cf16c8c028a80561350974199f85d32f4e67d236440c925"
fn test_hash_by_name() = hash_hex("sha256", "abc") == sha256("abc") and count(hash_raw("sha512", "abc")) == 64 and count(hash_raw("md5", "")) == 16 and ord_at(hash_raw("sha1", "abc"), 0) == 169
## RFC 4231 (SHA-2), RFC 2202 (SHA-1) and RFC 2104 (MD5) test cases, including a key longer than the block
fn k0b(n) = reps(chr(11), n)
fn test_hmac_rfc4231() = hmac_sha256(k0b(20), "Hi There") == "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7" and hmac_sha512(k0b(20), "Hi There") == "87aa7cdea5ef619d4ff0b4241a1d6cb02379f4e2ce4ec2787ad0b30545e17cdedaa833b7d6b8a702038b274eaea3f4e4be9d914eeb61f1702e696c203a126854"
fn test_hmac_jefe() = hmac_sha256("Jefe", "what do ya want for nothing?") == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843" and hmac_sha384("Jefe", "what do ya want for nothing?") == "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649" and hmac_sha512("Jefe", "what do ya want for nothing?") == "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737"
fn test_hmac_long_key() = hmac_sha256(reps(chr(170), 131), "Test Using Larger Than Block-Size Key - Hash Key First") == "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54" and hmac_sha512(reps(chr(170), 131), "Test Using Larger Than Block-Size Key - Hash Key First") == "80b24263c7c1a3ebb71493c1dd7be8b49b46d1f41b4aeec1121b013783f8f3526b56d037e05f2598bd0fd2215d6a1e5295e64f73f63f0aec8b915a985d786598"
fn test_hmac_md5_sha1() = hmac_md5(k0b(16), "Hi There") == "9294727a3638bb1c13f48ef8158bfc9d" and hmac_sha1(k0b(20), "Hi There") == "b617318655057264e28bc0b6fb378c8ef146be00" and hmac_sha256("key", "msg") != hmac_sha256("kez", "msg")
## RFC 7914 section 11 (PBKDF2-HMAC-SHA256) and RFC 6070 (PBKDF2-HMAC-SHA1)
fn test_pbkdf2() = pbkdf2_sha256("passwd", "salt", 1, 64) == "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783" and pbkdf2_sha256("password", "salt", 2, 32) == "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43" and pbkdf2_hex("sha1", "password", "salt", 1, 20) == "0c60c80f961f0e71f3a9b524af6012062fe037a6" and pbkdf2_hex("sha1", "password", "salt", 2, 20) == "ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957" and pbkdf2_hex("sha1", "passwordPASSWORDpassword", "saltSALTsaltSALTsaltSALTsaltSALTsalt", 2, 25) == "8f2c3482e40bdbe537935153ef1692de0c7f4740bef78dd940"
fn test_crc32c() = crc32c("123456789") == 3808858755 and crc32c("") == 0 and crc32c("The quick brown fox jumps over the lazy dog") == 576848900
fn test_fnv1a() = fnv1a32("") == 2166136261 and fnv1a32("a") == 3826002220 and fnv1a32("foobar") == 3214735720 and fnv1a64("") == "cbf29ce484222325" and fnv1a64("a") == "af63dc4c8601ec8c" and fnv1a64("foobar") == "85944171f73967e8"
## 64 bytes exactly: the padding goes into a second block
fn test_block_edge() = sha1("0123456789012345678901234567890123456789012345678901234567890123") == "cf0800f7644ace3cb4c3fa33388d3ba0ea3c8b6e" and md5("0123456789012345678901234567890123456789012345678901234567890123") == "7f7bfd348709deeaace19e3f535f8c54"
