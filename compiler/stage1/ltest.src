## ltest.src -- Lume-Core native unit-test harness generator (Track T, brick T1).
## Reads a .src file from stdin, discovers all zero-argument `fn test_<name>()` functions, strips
## non-test top-level `print` statements, and appends a Lume-Core test runner that executes each
## `test_<name>()`, prints `  ok   test_<name>` or `  FAIL test_<name>`, prints `<P> passed, <F> failed`,
## and aborts with exit code 3 via `ctfail` if any test returned 0 (false).
## Compiled to a standalone native ELF by `lumec` + `lasm` with zero C in the loop.

## --- list & string helpers ---
fn app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, app(t, ys))
fn len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + len(t)
fn isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => pairs2(a, t)
fn pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, pairs(r))
fn joinall(xs) = match xs
    Nil        => ""
    Cons(a, t) => if isnil(t) == 1 then a else joinall(pairs(xs))
fn addsep(xs, sep) = match xs
    Nil        => Nil
    Cons(h, t) => if isnil(t) == 1 then Cons(h, Nil) else Cons(h + sep, addsep(t, sep))
fn joinsep(xs, sep) = joinall(addsep(xs, sep))

fn nlpos(s, n, i) = if i >= n then i else if at(s, i) == "\n" then i else nlpos(s, n, i + 1)
fn rnlpos(s, i) = if i < 0 then 0 - 1 else if at(s, i) == "\n" then i else rnlpos(s, i - 1)
fn splitlines_leaf(s, n, i) = if i >= n then Nil else let e = nlpos(s, n, i) in Cons(slicen(s, n, i, e), splitlines_leaf(s, n, if e >= n then e else e + 1))
fn find_nl_from(s, n, mid) = let wn = if mid + 256 <= n then 256 else n - mid in let w = slicen(s, n, mid, mid + wn) in let k = nlpos(w, wn, 0) in if k < wn then mid + k else if mid + wn >= n then n else find_nl_from(s, n, mid + wn)
fn rfind_nl_from(s, n, end_pos) = if end_pos <= 0 then 0 - 1 else let start = if end_pos >= 256 then end_pos - 256 else 0 in let wn = end_pos - start in let w = slicen(s, n, start, end_pos) in let k = rnlpos(w, wn - 1) in if k >= 0 then start + k else rfind_nl_from(s, n, start)
fn splitlines_no_right_nl(s, n, half) = let sp0 = rfind_nl_from(s, n, half) in if sp0 < 0 then Cons(s, Nil) else app(splitlines_dc(slicen(s, n, 0, sp0), sp0), Cons(slicen(s, n, sp0 + 1, n), Nil))
fn splitlines_dc(s, n) = if n <= 256 then splitlines_leaf(s, n, 0) else let half = n / 2 in let sp = find_nl_from(s, n, half) in if sp >= n then splitlines_no_right_nl(s, n, half) else app(splitlines_dc(slicen(s, n, 0, sp), sp), splitlines_dc(slicen(s, n, sp + 1, n), n - sp - 1))
fn splitlines(s) = splitlines_dc(s, count(s))

fn isws(c) = c == " " or c == "\t" or c == "\r"
fn rtrimend(s, e) = if e <= 0 then 0 else if isws(at(s, e - 1)) then rtrimend(s, e - 1) else e
fn rtrim(s) = let n = count(s) in if n <= 0 then s else if isws(at(s, n - 1)) then slicen(s, n, 0, rtrimend(s, n - 1)) else s
fn startswith(s, p) = if count(s) < count(p) then 0 else slice(s, 0, count(p)) == p

fn isdigit(c) = c >= "0" and c <= "9"
fn isalpha(c) = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
fn isalnum(c) = isdigit(c) or isalpha(c)
fn idend(s, i) = if i >= count(s) then i else if isalnum(at(s, i)) then idend(s, i + 1) else i

## --- zero-arg `fn test_<name>()` or `pub fn test_<name>()` detection ---
fn strip_pub(raw) = if count(raw) >= 4 and startswith(raw, "pub ") then slice(raw, 4, count(raw)) else raw
fn testfnname(raw) = let s = strip_pub(raw) in if count(s) < 10 then "" else if at(s, 0) == "f" and startswith(s, "fn test_") then testfnname2(s, idend(s, 3)) else ""
fn testfnname2(raw, e) = if e > 8 and startswith(slice(raw, e, count(raw)), "()") then slice(raw, 3, e) else ""

fn findtests(lines) = match lines
    Nil        => Nil
    Cons(h, t) => findtests1(testfnname(rtrim(h)), t)
fn findtests1(nm, t) = if nm == "" then findtests(t) else Cons(nm, findtests(t))

## Strip top-level `print ...` statements when synthesizing a unit-test harness
fn is_top_print(raw) = count(raw) >= 6 and at(raw, 0) == "p" and startswith(raw, "print ")
fn has_top_print(lines) = match lines
    Nil        => 0
    Cons(h, t) => if is_top_print(h) then 1 else has_top_print(t)
fn keepdef(lines) = match lines
    Nil        => Nil
    Cons(h, t) => keepdef1(rtrim(h), t)
## a top-level print becomes an empty line, so the harness keeps the line numbers of the bundle (diagnostics map back)
fn keepdef1(raw, t) = if is_top_print(raw) then Cons("", keepdef(t)) else Cons(raw, keepdef(t))

## --- synthesize runner statements for discovered tests ---
## Test number i (0-based, in source order) runs when it is selected at run time by the environment the driver sets:
##   LUME_TEST_FILTER=s       only tests whose name contains s (`lume test --filter s`)
##   LUME_TEST_SHARDS=n, LUME_TEST_SHARD=k   only tests with i % n == k (`lume test --jobs n`: one process per k)
##   LUME_TEST_REPORT=1       machine lines instead of the human ones: `@lume-test-plan i name` for every selected test
##                            first, then `@lume-test i ns <human line>` per test and `@lume-test-sum passed selected`
## With none of them set the output is the historical one: `  ok   name` / `  FAIL name` per test, `P passed, F failed`.
fn q(s) = "\"" + s + "\""
fn plancalls(ts, i) = match ts
    Nil        => Nil
    Cons(h, t) => Cons("_t_plan(" + str(i) + ", " + q(h) + ")", plancalls(t, i + 1))
fn runcalls(ts, i) = match ts
    Nil        => Nil
    Cons(h, t) => Cons("_t_start(" + str(i) + ", " + q(h) + ")", Cons("_t_line(" + str(i) + ", if _t_sel(" + str(i) + ", " + q(h) + ") == 0 then \"\" else (if __lume_try_begin() == 0 then (let _t_r = " + h + "() in let _t_z = __lume_try_end() in _t_msg(_t_r, " + q(h) + ")) else _t_abort(" + q(h) + ", __lume_try_msg())))", runcalls(t, i + 1)))

## the runner's functions, one generated line each (slot 0 of the scratch page counts passes, 1 the selected tests,
## 2 holds the start time of the running test)
fn rd01() = "fn _t_slot(k) = hw_scratch_addr() + 4096 + k * 8"
fn rd02() = "fn _t_msg(ok, nm) = if ok != 0 then (let z = mmio_volatile_write64(_t_slot(0), mmio_volatile_read64(_t_slot(0)) + 1) in \"  ok   \" + nm) else \"  FAIL \" + nm"
fn rd03() = "fn _t_chomp(s) = if count(s) > 0 and at(s, count(s) - 1) == \"\\n\" then _t_chomp(slice(s, 0, count(s) - 1)) else s"
fn rd04() = "fn _t_abort(nm, msg) = \"  FAIL \" + nm + \" (aborted: \" + _t_chomp(msg) + \")\""
fn rd05() = "fn _t_sum(p, tot) = str(p) + \" passed, \" + str(tot - p) + \" failed\""
fn rd06() = "fn _t_has(s, p, i) = if i + count(p) > count(s) then 0 else if slice(s, i, i + count(p)) == p then 1 else _t_has(s, p, i + 1)"
fn rd07() = "fn _t_num(s, i, acc) = if i >= count(s) then acc else if at(s, i) < \"0\" or at(s, i) > \"9\" then acc else _t_num(s, i + 1, acc * 10 + ord(at(s, i)) - 48)"
fn rd08() = "fn _t_shards() = _t_num(os_getenv(\"LUME_TEST_SHARDS\"), 0, 0)"
fn rd09() = "fn _t_rep() = if os_getenv(\"LUME_TEST_REPORT\") == \"\" then 0 else 1"
fn rd10() = "fn _t_sel(i, nm) = let f = os_getenv(\"LUME_TEST_FILTER\") in let n = _t_shards() in if f != \"\" and _t_has(nm, f, 0) == 0 then 0 else if n > 1 and i % n != _t_num(os_getenv(\"LUME_TEST_SHARD\"), 0, 0) then 0 else 1"
fn rd11() = "fn _t_plan(i, nm) = if _t_rep() == 1 and _t_sel(i, nm) == 1 then (let z = emit(\"@lume-test-plan \" + str(i) + \" \" + nm + \"\\n\") in 0) else 0"
fn rd12() = "fn _t_start(i, nm) = if _t_sel(i, nm) == 1 then (let z = mmio_volatile_write64(_t_slot(2), os_monotonic_ns()) in 0) else 0"
fn rd13() = "fn _t_line(i, s) = if s == \"\" then 0 else let ns = os_monotonic_ns() - mmio_volatile_read64(_t_slot(2)) in let c = mmio_volatile_write64(_t_slot(1), mmio_volatile_read64(_t_slot(1)) + 1) in let z = emit(if _t_rep() == 1 then \"@lume-test \" + str(i) + \" \" + str(ns) + \" \" + s + \"\\n\" else s + \"\\n\") in 0"
fn rd14() = "fn _t_fin(tot) = let p = mmio_volatile_read64(_t_slot(0)) in let sel = mmio_volatile_read64(_t_slot(1)) in let f = os_getenv(\"LUME_TEST_FILTER\") in if sel == 0 and f != \"\" and _t_shards() <= 1 and _t_rep() == 0 then ctfail(\"lume test: no test function name contains '\" + f + \"' (\" + str(tot) + \" test functions in the file)\\n\") else let z = emit(if _t_rep() == 1 then \"@lume-test-sum \" + str(p) + \" \" + str(sel) + \"\\n\" else _t_sum(p, sel) + \"\\n\") in let zf = flush() in if p == sel then 0 else ctfail(\"lume test: failed\\n\")"
fn runner_defs() = rd01() + "\n" + rd02() + "\n" + rd03() + "\n" + rd04() + "\n" + rd05() + "\n" + rd06() + "\n" + rd07() + "\n" + rd08() + "\n" + rd09() + "\n" + rd10() + "\n" + rd11() + "\n" + rd12() + "\n" + rd13() + "\n" + rd14()

fn synth(src, lines, ts) = if isnil(ts) == 1 then src else let n = str(len(ts)) in let defs = if has_top_print(lines) == 1 then joinsep(keepdef(lines), "\n") else rtrim(src) in defs + "\n" + runner_defs() + "\n" + joinsep(plancalls(ts, 0), "\n") + "\n" + joinsep(runcalls(ts, 0), "\n") + "\n_t_fin(" + n + ")"

fn run_ltest(src) = let lines = splitlines(src) in synth(src, lines, findtests(lines))

print rtrim(run_ltest(readall()))
