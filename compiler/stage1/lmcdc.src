## lmcdc.src -- structural coverage obligation analyzer (decision coverage + masking MC/DC) for the integer fragment.
##
## For every typed integer function of a module it
##   1. lists the decisions of the lowered AST the code generator receives (`nf_late(lumec_expand(src))`): the
##      `requires` check, a runtime-checked `ensures`, every `if` condition, and every Boolean expression used as a
##      value, including those nested in the operands of a condition of another decision;
##   2. derives the obligations: each decision must evaluate to true and to false, and each atomic condition must be
##      shown to independently affect its decision with the value true and with the value false (masking MC/DC: the
##      condition was evaluated, and flipping it alone flips the outcome);
##   3. searches input vectors with a reference interpreter that records, per decision, the truth value of every
##      condition, and keeps one witness vector per obligation. The candidates of passes (a)-(c) are the literals of
##      the function not larger than 2^30 in magnitude, their neighbours and their negations:
##      (a) every parameter restricted to the candidates that satisfy the `requires` clauses about that parameter
##          alone, exhaustively when the product is small and pseudo-randomly otherwise (this reaches the decisions
##          of the body);
##      (b) from a vector that satisfies `requires`, each parameter in turn swept over all candidates (this reaches
##          "one clause of `requires` false, the others true");
##      (c) unrestricted pseudo-random vectors, twelve times the budget, while an obligation is still open;
##      (d) while an obligation is still open, (a)-(c) again over EVERY literal whatever its magnitude, with the
##          neighbours at distance 1 and 2 (a bound such as `sats <= 2100000000000000` or `days > 1000000000000`,
##          and a chain such as `c <= 1000 and a > c`, are only reachable this way).
##      The interpreter evaluates calls to typed integer functions, the directly recursive ones included, down to a
##      call depth of 6; a vector that needs more, overflows or divides by zero is undefined and is discarded.
##   4. with @exec 1, runs every witness on the REAL binary (lumec + lasm, one process per vector, arguments through
##      argv so that no call is folded or refuted at compile time) and requires the value, or the contract trap, the
##      interpreter predicted. A witness is a test case only if the machine agrees with it. What the machine confirms
##      is the observable result of the vector (value or trap); which branch the object code took is not observed
##      here (the correspondence between the lowered AST and the object code is the translation validator's job).
## The witnesses come from this search only: the `test_*` functions of the module are not read.
## An obligation with no witness is reported as it is. Two kinds are classified, never silently dropped:
##   theorem_false  the false outcome of a CONCLUSION of a declared `law` (a decision in result position of the law's
##                  body, e.g. `C` and `1 == 1` in `if H then C else 1 == 1`). lmcdc does not prove the law: the claim
##                  "unreachable" is exactly the claim that the law holds, and rests on the prover's verdict for that
##                  law (`lume prove`: lqualify requires every law and contract of a certified module to be proven,
##                  none runtime-checked or refuted). Nothing else is in this class: not the hypothesis `H` of a law,
##                  not a decision nested in a condition, not a function that is merely named `law_*`, and not the
##                  false outcome of an `ensures` check the code generator kept (it kept it because the prover did
##                  NOT discharge it; that outcome needs a witness, and counts as uncovered without one);
##   infeasible     the combination is contradictory and lcert's independent QF_LIA kernel proves it: for a
##                  conjunction, "condition i false while the others hold" is impossible when the other conditions
##                  (and the function's `requires`, and the conditions of the `if` branches that enclose the
##                  decision) imply condition i; dually for a disjunction. Such a condition is redundant or guards
##                  dead code, and is listed with its proof term for review rather than counted as covered. The
##                  clauses of `requires` are hypotheses only when the check has the generated shape at the root of
##                  the body and no `let` of the body rebinds a parameter name; an enclosing condition is a
##                  hypothesis only when it is a comparison of linear-form terms and no `let` in between rebinds
##                  one of its variables;
##   uncovered      everything else: the search found no witness and no proof. It counts against the module.
## Scope: typed int/bool functions whose body stays in the modelled forms and that do not call themselves. The report
## gives `typed_integer_functions_in_source` next to `functions` (the analyzed ones); the difference is not measured.
##
## stdin:  @root <repo>   @src <file.src, self-contained>   [@fn <name>]   [@exec 1]   [@budget <vectors per function>]
## stdout: one JSON object; non-zero exit when a witness disagrees with the real machine.
use lumec
use lcert

fn mc_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else mc_line_end(s, i + 1)
fn mc_get_at(s, key, i) = if i >= count(s) then "" else let e = mc_line_end(s, i) in let n = count(key) in if e - i > n + 2 and slice(s, i, i + n + 2) == "@" + key + " " then slice(s, i + n + 2, e) else mc_get_at(s, key, e + 1)
fn mc_get(s, key) = mc_get_at(s, key, 0)
fn mc_or(v, d) = if v == "" then d else v
fn mc_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128
fn mc_index(text, part, i) = if i + count(part) > count(text) then 0 - 1 else if slice(text, i, i + count(part)) == part then i else mc_index(text, part, i + 1)
fn mc_join(xs) = match xs
    Nil        => ""
    Cons(h, t) => h + mc_join(t)
fn mc_has(xs, x) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else mc_has(t, x)
fn mc_nth(xs, i) = match xs
    Nil        => 0
    Cons(h, t) => if i <= 0 then h else mc_nth(t, i - 1)
fn mc_jesc1(c) = if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then "\\n" else if c == "\t" then " " else c
fn mc_jesc_at(s, i, n) = if i >= n then Nil else Cons(mc_jesc1(at(s, i)), mc_jesc_at(s, i + 1, n))
fn mc_jesc(s) = mc_join(mc_jesc_at(s, 0, count(s)))

## --- reference interpreter: st 1 value, 0 contract trap (ctfail), 2 undefined (overflow, division by zero, fuel) ---
fn mc_r(st, v) = {st: st, v: v}
fn mc_abs(a) = if a < 0 then 0 - a else a
fn mc_big(a) = if a > 2000000000000000000 or a < 0 - 2000000000000000000 then 1 else 0
fn mc_add(a, b) = if mc_big(a) == 1 or mc_big(b) == 1 then mc_r(2, 0) else mc_r(1, a + b)
fn mc_sub(a, b) = if mc_big(a) == 1 or mc_big(b) == 1 then mc_r(2, 0) else mc_r(1, a - b)
fn mc_mul(a, b) = if a == 0 or b == 0 then mc_r(1, 0) else if mc_big(a) == 1 or mc_big(b) == 1 then mc_r(2, 0) else if mc_abs(a) > 2000000000000000000 / mc_abs(b) then mc_r(2, 0) else mc_r(1, a * b)
fn mc_iscmp(op) = if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=" then 1 else 0
fn mc_cmp(op, a, b) = if op == "==" then a == b else if op == "!=" then a != b else if op == "<" then a < b else if op == ">" then a > b else if op == "<=" then a <= b else a >= b
fn mc_arith(op, a, b) = if op == "+" then mc_add(a, b) else if op == "-" then mc_sub(a, b) else if op == "*" then mc_mul(a, b) else if op == "/" then (if b == 0 then mc_r(2, 0) else mc_r(1, a / b)) else if op == "%" then (if b == 0 then mc_r(2, 0) else mc_r(1, a % b)) else mc_r(2, 0)
fn mc_env(env, nm) = match env
    Nil        => {ok: 0, v: 0}
    Cons(h, t) => if h.n == nm then {ok: 1, v: h.v} else mc_env(t, nm)
fn mc_fn_get(fs, nm) = match fs
    Nil        => {ok: 0, nm: "", ps: Nil, tys: Nil, rt: "int", body: Num(0)}
    Cons(h, t) => if h.nm == nm then h else mc_fn_get(t, nm)
fn mc_val(x, env, fs, fuel) = match x
    Num(n)          => mc_r(1, n)
    Var(nm)         => mc_val_var(nm, mc_env(env, nm))
    Bin(op, l, r)   => if op == "and" then mc_val_and(mc_val(l, env, fs, fuel), r, env, fs, fuel) else if op == "or" then mc_val_or(mc_val(l, env, fs, fuel), r, env, fs, fuel) else mc_val_bin(op, mc_val(l, env, fs, fuel), mc_val(r, env, fs, fuel))
    If(c, t, e2)    => mc_val_if(mc_val(c, env, fs, fuel), t, e2, env, fs, fuel)
    LetIn(nm, v, b) => mc_val_let(nm, mc_val(v, env, fs, fuel), b, env, fs, fuel)
    Call(nm, args)  => if nm == "ctfail" then mc_r(0, 0) else mc_val_call(mc_fn_get(fs, nm), mc_val_args(args, env, fs, fuel), fs, fuel)
    _               => mc_r(2, 0)
fn mc_val_var(nm, r) = if r.ok == 1 then mc_r(1, r.v) else if nm == "true" then mc_r(1, 1) else if nm == "false" then mc_r(1, 0) else mc_r(2, 0)
fn mc_val_and(a, r, env, fs, fuel) = if a.st != 1 then a else if a.v == 0 then mc_r(1, 0) else mc_truth(mc_val(r, env, fs, fuel))
fn mc_val_or(a, r, env, fs, fuel) = if a.st != 1 then a else if a.v != 0 then mc_r(1, 1) else mc_truth(mc_val(r, env, fs, fuel))
fn mc_truth(a) = if a.st != 1 then a else mc_r(1, if a.v != 0 then 1 else 0)
fn mc_val_bin(op, a, b) = if a.st != 1 then a else if b.st != 1 then b else if mc_iscmp(op) == 1 then mc_r(1, if mc_cmp(op, a.v, b.v) then 1 else 0) else mc_arith(op, a.v, b.v)
fn mc_val_if(c, t, e2, env, fs, fuel) = if c.st != 1 then c else if c.v != 0 then mc_val(t, env, fs, fuel) else mc_val(e2, env, fs, fuel)
fn mc_val_let(nm, a, b, env, fs, fuel) = if a.st != 1 then a else mc_val(b, Cons({n: nm, v: a.v}, env), fs, fuel)
fn mc_val_args(args, env, fs, fuel) = match args
    Nil        => {st: 1, vs: Nil}
    Cons(h, t) => mc_val_args2(mc_val(h, env, fs, fuel), mc_val_args(t, env, fs, fuel))
fn mc_val_args2(a, r) = if a.st != 1 then {st: a.st, vs: Nil} else if r.st != 1 then r else {st: 1, vs: Cons(a.v, r.vs)}
fn mc_zip(ps, vs) = match ps
    Nil        => Nil
    Cons(h, t) => mc_zip2(h, t, vs)
fn mc_zip2(h, t, vs) = match vs
    Nil        => Nil
    Cons(v, r) => Cons({n: h, v: v}, mc_zip(t, r))
fn mc_val_call(f, a, fs, fuel) = if a.st != 1 then mc_r(a.st, 0) else if f.ok == 0 or fuel <= 0 then mc_r(2, 0) else mc_val(f.body, mc_zip(f.ps, a.vs), fs, fuel - 1)

## --- decisions: the Boolean tree of a condition, its atoms left to right ---
fn mc_isbool(x) = match x
    Bin(op, l, r) => if op == "and" or op == "or" then 1 else 0
    _             => 0
fn mc_atoms(c) = match c
    Bin(op, l, r) => if op == "and" or op == "or" then app(mc_atoms(l), mc_atoms(r)) else Cons(c, Nil)
    _             => Cons(c, Nil)
fn mc_atom_vals(ats, env, fs, fuel) = match ats
    Nil        => Nil
    Cons(a, t) => let r = mc_val(a, env, fs, fuel) in Cons(if r.st != 1 then 2 else if r.v != 0 then 1 else 0, mc_atom_vals(t, env, fs, fuel))
## three-valued outcome of the tree under the atom values `vals` (2 = unknown); returns the unconsumed values too
fn mc_bt(c, vals) = match c
    Bin(op, l, r) => if op == "and" then mc_bt_and(mc_bt(l, vals), r) else if op == "or" then mc_bt_or(mc_bt(l, vals), r) else mc_bt_leaf(vals)
    _             => mc_bt_leaf(vals)
fn mc_bt_leaf(vals) = match vals
    Nil        => {v: 2, rest: Nil}
    Cons(h, t) => {v: h, rest: t}
fn mc_bt_and(a, r) = let b = mc_bt(r, a.rest) in {v: if a.v == 0 then 0 else if a.v == 1 then b.v else if b.v == 0 then 0 else 2, rest: b.rest}
fn mc_bt_or(a, r) = let b = mc_bt(r, a.rest) in {v: if a.v == 1 then 1 else if a.v == 0 then b.v else if b.v == 1 then 1 else 2, rest: b.rest}
## which atoms the short-circuit evaluation really ran
fn mc_ran(c, vals, active) = match c
    Bin(op, l, r) => if op == "and" then mc_ran_sc(1, l, r, vals, active) else if op == "or" then mc_ran_sc(0, l, r, vals, active) else mc_ran_leaf(vals, active)
    _             => mc_ran_leaf(vals, active)
fn mc_ran_leaf(vals, active) = match vals
    Nil        => {fl: Nil, rest: Nil}
    Cons(h, t) => {fl: Cons(active, Nil), rest: t}
fn mc_ran_sc(want, l, r, vals, active) = let lv = mc_bt(l, vals) in let a = mc_ran(l, vals, active) in let b = mc_ran(r, a.rest, if active == 1 and lv.v == want then 1 else 0) in {fl: app(a.fl, b.fl), rest: b.rest}
fn mc_flip(vals, i) = match vals
    Nil        => Nil
    Cons(h, t) => if i == 0 then Cons(1 - h, t) else Cons(h, mc_flip(t, i - 1))
## condition i independently affects the outcome in this evaluation
fn mc_det(c, vals, ran, i, out) = let v = mc_nth(vals, i) in if mc_nth(ran, i) != 1 or v == 2 then 0 else let f = (mc_bt(c, mc_flip(vals, i))).v in if f != 2 and f != out then 1 else 0

## --- static list of decisions {id, cls, c}; ids are AST paths, the same the tracing walk produces ---
## A decision is a contract check only when it has the shape the code generator emits, `if <cond> then 1 else
## ctfail(..)`, bound to `_vreq_ok` at the root of the body (it then dominates every other decision, so its clauses
## may serve as hypotheses) or to `_vens_ok`. A user binding that merely reuses one of the names is an ordinary `if`.
fn mc_is_chk(v) = match v
    If(c, t, e2) => mc_is_chk2(e2)
    _            => 0
fn mc_is_chk2(e2) = match e2
    Call(nm, args) => if nm == "ctfail" then 1 else 0
    _              => 0
## A decision may sit inside a condition of another one, as in `(if a > 0 then 1 else 0) + (if b > 0 then 1 else 0)
## >= 2`: the operands of every condition are searched too (ids `<decision>c<condition index>l|r|x`), and the tracing
## walk records such a nested decision whenever the short-circuit evaluation really ran the condition that holds it.
fn mc_hasdec(x) = match x
    Bin(op, l, r)   => if op == "and" or op == "or" or mc_iscmp(op) == 1 then 1 else if mc_hasdec(l) == 1 then 1 else mc_hasdec(r)
    If(c, t, e2)    => 1
    LetIn(nm, v, b) => if mc_hasdec(v) == 1 then 1 else mc_hasdec(b)
    Call(nm, args)  => mc_hasdec_l(args)
    _               => 0
fn mc_hasdec_l(xs) = match xs
    Nil        => 0
    Cons(h, t) => if mc_hasdec(h) == 1 then 1 else mc_hasdec_l(t)
fn mc_decs_atoms(ats, path, i, ph) = match ats
    Nil        => Nil
    Cons(a, t) => app(mc_decs_atom(a, path + "c" + str(i), ph), mc_decs_atoms(t, path, i + 1, ph))
fn mc_decs_atom(a, p, ph) = match a
    Bin(op, l, r) => if mc_iscmp(op) == 1 then app(mc_decs(l, p + "l", "if", ph), mc_decs(r, p + "r", "if", ph)) else mc_decs(a, p + "x", "if", ph)
    _             => mc_decs(a, p + "x", "if", ph)
## Path hypotheses `ph`: what is known to hold whenever a decision is evaluated, because of the `if` branches that
## enclose it. The then-branch of a pure conjunction of comparisons adds each of them; the else-branch of a single
## comparison, or of a pure disjunction of comparisons, adds each negation. Only comparisons of linear-form terms
## (literals, variables, + - *) are kept, a hypothesis is DROPPED (never invented) when in doubt, and a `let` that
## binds a name drops every hypothesis that mentions it for its body. Each is {vs: variables, sx: kernel term}.
fn mc_plain(x) = match x
    Num(n)        => 1
    Var(nm)       => 1
    Bin(op, l, r) => if op == "+" or op == "-" or op == "*" then (if mc_plain(l) == 1 then mc_plain(r) else 0) else 0
    _             => 0
fn mc_plain_cmp(a) = match a
    Bin(op, l, r) => if mc_iscmp(op) == 1 and mc_plain(l) == 1 then mc_plain(r) else 0
    _             => 0
fn mc_ph_atoms(ats, pol, ph) = match ats
    Nil        => ph
    Cons(a, t) => mc_ph_atoms(t, pol, if mc_plain_cmp(a) == 1 then Cons({vs: mc_vars(a, Nil), sx: " " + (if pol == 1 then mc_sx(a) else mc_sx_neg(a))}, ph) else ph)
fn mc_ph_then(c, ph) = if mc_allop(c, "and") == 1 then mc_ph_atoms(mc_atoms(c), 1, ph) else ph
fn mc_ph_else(c, ph) = if mc_allop(c, "or") == 1 then mc_ph_atoms(mc_atoms(c), 0, ph) else ph
fn mc_ph_drop(ph, nm) = match ph
    Nil        => Nil
    Cons(h, t) => if mc_has(h.vs, nm) == 1 then mc_ph_drop(t, nm) else Cons(h, mc_ph_drop(t, nm))
fn mc_ph_sx(ph) = match ph
    Nil        => ""
    Cons(h, t) => h.sx + mc_ph_sx(t)
fn mc_decs(x, path, cls, ph) = match x
    Bin(op, l, r)   => if op == "and" or op == "or" or mc_iscmp(op) == 1 then Cons({id: path, cls: "value", c: x, ph: ph}, mc_decs_atoms(mc_atoms(x), path, 0, ph)) else app(mc_decs(l, path + "l", "value", ph), mc_decs(r, path + "r", "value", ph))
    If(c, t, e2)    => Cons({id: path, cls: cls, c: c, ph: ph}, app(mc_decs_atoms(mc_atoms(c), path, 0, ph), app(mc_decs(t, path + "t", "if", mc_ph_then(c, ph)), mc_decs(e2, path + "e", "if", mc_ph_else(c, ph)))))
    LetIn(nm, v, b) => app(mc_decs(v, path + "v", if nm == "_vreq_ok" and path == "" and mc_is_chk(v) == 1 then "requires" else if nm == "_vens_ok" and mc_is_chk(v) == 1 then "ensures" else "if", ph), mc_decs(b, path + "b", "if", mc_ph_drop(ph, nm)))
    Call(nm, args)  => mc_decs_args(args, path, 0, ph)
    _               => Nil
fn mc_decs_args(args, path, i, ph) = match args
    Nil        => Nil
    Cons(h, t) => app(mc_decs(h, path + "a" + str(i), "value", ph), mc_decs_args(t, path, i + 1, ph))

## --- tracing walk along one concrete evaluation: {st, v, recs: [{id, vals, ran, out}]} ---
fn mc_w(st, v, recs) = {st: st, v: v, recs: recs}
fn mc_rec(id, c, env, fs, fuel) = let vals = mc_atom_vals(mc_atoms(c), env, fs, fuel) in {id: id, c: c, vals: vals, ran: (mc_ran(c, vals, 1)).fl, out: (mc_bt(c, vals)).v}
fn mc_walk(x, path, env, fs, fuel) = match x
    Bin(op, l, r)   => if op == "and" or op == "or" or mc_iscmp(op) == 1 then mc_walk_dec(mc_rec(path, x, env, fs, fuel), path, env, fs, fuel) else mc_walk_bin(op, mc_walk(l, path + "l", env, fs, fuel), mc_walk(r, path + "r", env, fs, fuel))
    If(c, t, e2)    => mc_walk_if(mc_rec(path, c, env, fs, fuel), t, e2, path, env, fs, fuel)
    LetIn(nm, v, b) => mc_walk_let(nm, mc_walk(v, path + "v", env, fs, fuel), b, path, env, fs, fuel)
    Call(nm, args)  => if nm == "ctfail" then mc_w(0, 0, Nil) else mc_walk_call(mc_fn_get(fs, nm), mc_walk_args(args, path, 0, env, fs, fuel), fs, fuel)
    _               => let r = mc_val(x, env, fs, fuel) in mc_w(r.st, r.v, Nil)
## the records of the decisions nested in the conditions the evaluation ran
fn mc_nest(ats, ran, p, i, env, fs, fuel) = match ats
    Nil        => Nil
    Cons(a, t) => app(if mc_nth(ran, i) == 1 and mc_hasdec_atom(a) == 1 then mc_nest_atom(a, p + "c" + str(i), env, fs, fuel) else Nil, mc_nest(t, ran, p, i + 1, env, fs, fuel))
fn mc_hasdec_atom(a) = match a
    Bin(op, l, r) => if mc_iscmp(op) == 1 then (if mc_hasdec(l) == 1 then 1 else mc_hasdec(r)) else mc_hasdec(a)
    _             => mc_hasdec(a)
fn mc_nest_atom(a, p, env, fs, fuel) = match a
    Bin(op, l, r) => if mc_iscmp(op) == 1 then app((mc_walk(l, p + "l", env, fs, fuel)).recs, (mc_walk(r, p + "r", env, fs, fuel)).recs) else (mc_walk(a, p + "x", env, fs, fuel)).recs
    _             => (mc_walk(a, p + "x", env, fs, fuel)).recs
fn mc_walk_dec(rec, path, env, fs, fuel) = if rec.out == 2 then mc_w(2, 0, Nil) else mc_w(1, rec.out, Cons(rec, mc_nest(mc_atoms(rec.c), rec.ran, path, 0, env, fs, fuel)))
fn mc_walk_bin(op, a, b) = if a.st != 1 then a else if b.st != 1 then mc_w(b.st, 0, app(a.recs, b.recs)) else let r = mc_arith(op, a.v, b.v) in mc_w(r.st, r.v, app(a.recs, b.recs))
fn mc_walk_if(rec, t, e2, path, env, fs, fuel) = if rec.out == 2 then mc_w(2, 0, Nil) else let r = if rec.out == 1 then mc_walk(t, path + "t", env, fs, fuel) else mc_walk(e2, path + "e", env, fs, fuel) in mc_w(r.st, r.v, Cons(rec, app(mc_nest(mc_atoms(rec.c), rec.ran, path, 0, env, fs, fuel), r.recs)))
fn mc_walk_let(nm, a, b, path, env, fs, fuel) = if a.st != 1 then a else let r = mc_walk(b, path + "b", Cons({n: nm, v: a.v}, env), fs, fuel) in mc_w(r.st, r.v, app(a.recs, r.recs))
fn mc_walk_args(args, path, i, env, fs, fuel) = match args
    Nil        => {st: 1, vs: Nil, recs: Nil}
    Cons(h, t) => mc_walk_args2(mc_walk(h, path + "a" + str(i), env, fs, fuel), mc_walk_args(t, path, i + 1, env, fs, fuel))
fn mc_walk_args2(a, r) = if a.st != 1 then {st: a.st, vs: Nil, recs: a.recs} else if r.st != 1 then {st: r.st, vs: Nil, recs: app(a.recs, r.recs)} else {st: 1, vs: Cons(a.v, r.vs), recs: app(a.recs, r.recs)}
fn mc_walk_call(f, a, fs, fuel) = if a.st != 1 then mc_w(a.st, 0, a.recs) else let r = mc_val_call(f, {st: 1, vs: a.vs}, fs, fuel) in mc_w(r.st, r.v, a.recs)

## --- obligations and coverage. A key is "<decision id>|<condition index or o>|<value>" ---
fn mc_obl_atoms(id, n, i) = if i >= n then Nil else Cons(id + "|" + str(i) + "|1", Cons(id + "|" + str(i) + "|0", mc_obl_atoms(id, n, i + 1)))
fn mc_obls(ds) = match ds
    Nil        => Nil
    Cons(d, t) => Cons(d.id + "|o|1", Cons(d.id + "|o|0", app(mc_obl_atoms(d.id, len(mc_atoms(d.c)), 0), mc_obls(t))))
fn mc_cov_rec_atoms(rec, i, n, cov) = if i >= n then cov else let v = mc_nth(rec.vals, i) in let k = rec.id + "|" + str(i) + "|" + str(v) in mc_cov_rec_atoms(rec, i + 1, n, if mc_det(rec.c, rec.vals, rec.ran, i, rec.out) == 1 and mc_has(cov, k) == 0 then Cons(k, cov) else cov)
fn mc_cov_recs(recs, cov) = match recs
    Nil        => cov
    Cons(r, t) => let k = r.id + "|o|" + str(r.out) in mc_cov_recs(t, mc_cov_rec_atoms(r, 0, len(r.vals), if mc_has(cov, k) == 0 then Cons(k, cov) else cov))

## --- vectors ---
fn mc_consts(x, acc) = match x
    Num(n)          => Cons(n, acc)
    Bin(op, l, r)   => mc_consts(l, mc_consts(r, acc))
    If(c, t, e2)    => mc_consts(c, mc_consts(t, mc_consts(e2, acc)))
    LetIn(nm, v, b) => mc_consts(v, mc_consts(b, acc))
    Call(nm, args)  => mc_consts_l(args, acc)
    _               => acc
fn mc_consts_l(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => mc_consts(h, mc_consts_l(t, acc))
fn mc_cand_add(acc, v) = if v > 1073741824 or v < 0 - 1073741824 or mc_has(acc, v) == 1 then acc else Cons(v, acc)
fn mc_cand3(acc, h) = mc_cand_add(mc_cand_add(mc_cand_add(acc, h), h - 1), h + 1)
## a negative bound is written `0 - k`, so the negated literals are candidates too
fn mc_cands(cs, acc) = match cs
    Nil        => acc
    Cons(h, t) => mc_cands(t, mc_cand3(mc_cand3(acc, h), 0 - h))
fn mc_prng(s) = (s * 1103515245 + 12345) % 2147483648
fn mc_tyname(tys) = match tys
    Nil        => "int"
    Cons(h, t) => h
fn mc_tyrest(tys) = match tys
    Nil        => Nil
    Cons(h, t) => t
## per-parameter candidate lists: `cl` holds one list per parameter
fn mc_vars(x, acc) = match x
    Var(nm)         => if nm == "true" or nm == "false" then acc else Cons(nm, acc)
    Bin(op, l, r)   => mc_vars(l, mc_vars(r, acc))
    If(c, t, e2)    => mc_vars(c, mc_vars(t, mc_vars(e2, acc)))
    LetIn(nm, v, b) => Cons("?", acc)
    Call(nm, args)  => mc_vars_l(args, acc)
    _               => acc
fn mc_vars_l(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => mc_vars(h, mc_vars_l(t, acc))
fn mc_only(vs, p) = match vs
    Nil        => 1
    Cons(h, t) => if h == p then mc_only(t, p) else 0
## the clauses of a conjunctive `requires` that mention the parameter p and nothing else
fn mc_unary(ats, p) = match ats
    Nil        => Nil
    Cons(a, t) => let vs = mc_vars(a, Nil) in if isnil(vs) == 0 and mc_only(vs, p) == 1 then Cons(a, mc_unary(t, p)) else mc_unary(t, p)
fn mc_req_atoms(ds) = match ds
    Nil        => Nil
    Cons(d, t) => if d.cls == "requires" and mc_allop(d.c, "and") == 1 then mc_atoms(d.c) else mc_req_atoms(t)
fn mc_holds(ats, p, v, fs) = match ats
    Nil        => 1
    Cons(a, t) => let r = mc_val(a, Cons({n: p, v: v}, Nil), fs, 4) in if r.st == 1 and r.v != 0 then mc_holds(t, p, v, fs) else 0
fn mc_filter(cands, ats, p, fs) = match cands
    Nil        => Nil
    Cons(v, t) => if mc_holds(ats, p, v, fs) == 1 then Cons(v, mc_filter(t, ats, p, fs)) else mc_filter(t, ats, p, fs)
fn mc_cl(ps, cands, rq, fs, restrict) = match ps
    Nil        => Nil
    Cons(p, t) => let un = if restrict == 1 then mc_unary(rq, p) else Nil in let ok = if isnil(un) == 1 then cands else mc_filter(cands, un, p, fs) in Cons(if isnil(ok) == 1 then cands else ok, mc_cl(t, cands, rq, fs, restrict))
fn mc_clhead(cl) = match cl
    Nil        => Nil
    Cons(h, t) => h
fn mc_cltail(cl) = match cl
    Nil        => Nil
    Cons(h, t) => t
## pass (d): every literal of the body whatever its magnitude, with the neighbours at distance 1 and 2
fn mc_candx_add(acc, v) = if mc_has(acc, v) == 1 then acc else Cons(v, acc)
fn mc_candx5(acc, h) = if h > 4000000000000000000 or h < 0 - 4000000000000000000 then acc else mc_candx_add(mc_candx_add(mc_candx_add(mc_candx_add(mc_candx_add(acc, h), h - 1), h + 1), h - 2), h + 2)
fn mc_cands_x(cs, acc) = match cs
    Nil        => acc
    Cons(h, t) => mc_cands_x(t, mc_candx5(mc_candx5(acc, h), 0 - h))
## the k-th vector of the exhaustive enumeration (mixed radix), or a pseudo-random one
fn mc_vec_enum(ps, tys, cl, k) = match ps
    Nil        => Nil
    Cons(h, t) => let c = mc_clhead(cl) in let nc = len(c) in if mc_tyname(tys) == "bool" then Cons({n: h, v: k % 2}, mc_vec_enum(t, mc_tyrest(tys), mc_cltail(cl), k / 2)) else Cons({n: h, v: mc_nth(c, k % nc)}, mc_vec_enum(t, mc_tyrest(tys), mc_cltail(cl), k / nc))
fn mc_vec_rand(ps, tys, cl, s) = match ps
    Nil        => {env: Nil, s: s}
    Cons(h, t) => let s1 = mc_prng(s) in let c = mc_clhead(cl) in let r = mc_vec_rand(t, mc_tyrest(tys), mc_cltail(cl), s1) in {env: Cons({n: h, v: if mc_tyname(tys) == "bool" then s1 / 65536 % 2 else mc_nth(c, s1 / 65536 % len(c))}, r.env), s: r.s}
fn mc_space(tys, cl, lim) = match tys
    Nil        => 1
    Cons(h, t) => let r = mc_space(t, mc_cltail(cl), lim) in if r > lim then r else r * (if h == "bool" then 2 else len(mc_clhead(cl)))
fn mc_args(env) = match env
    Nil        => Nil
    Cons(h, t) => Cons(h.v, mc_args(t))
## st = {cov: covered keys, wit: [{args, st, v}], k, s}
fn mc_try(f, fs, env, st, s) = let r = mc_walk(f.body, "", env, fs, 6) in if r.st == 2 then {cov: st.cov, wit: st.wit, k: st.k + 1, s: s} else let cov2 = mc_cov_recs(r.recs, st.cov) in {cov: cov2, wit: if len(cov2) > len(st.cov) then Cons({args: mc_args(env), st: r.st, v: r.v}, st.wit) else st.wit, k: st.k + 1, s: s}
fn mc_search(f, fs, cl, total, exhaustive, need, off, st) = if st.k >= total or len(st.cov) >= need then st else let vr = if exhaustive == 1 then {env: mc_vec_enum(f.ps, f.tys, cl, st.k - off), s: st.s} else mc_vec_rand(f.ps, f.tys, cl, st.s) in mc_search(f, fs, cl, total, exhaustive, need, off, mc_try(f, fs, vr.env, st, vr.s))
## pass (b): from a vector that satisfies `requires`, sweep one parameter at a time over all candidates
fn mc_base(wit) = match wit
    Nil        => {ok: 0, args: Nil}
    Cons(w, t) => let r = mc_base(t) in if r.ok == 1 then r else if w.st == 1 then {ok: 1, args: w.args} else r
fn mc_setarg(ps, args, i, v) = match ps
    Nil        => Nil
    Cons(p, t) => mc_setarg2(p, t, args, i, v)
fn mc_setarg2(p, t, args, i, v) = match args
    Nil        => Nil
    Cons(a, r) => Cons({n: p, v: if i == 0 then v else a}, mc_setarg(t, r, i - 1, v))
fn mc_sweep_vals(f, fs, base, i, vals, st) = match vals
    Nil        => st
    Cons(v, t) => mc_sweep_vals(f, fs, base, i, t, mc_try(f, fs, mc_setarg(f.ps, base, i, v), st, st.s))
fn mc_sweep(f, fs, base, tys, i, cands, st) = match tys
    Nil        => st
    Cons(ty, t) => mc_sweep(f, fs, base, t, i + 1, cands, mc_sweep_vals(f, fs, base, i, if ty == "bool" then Cons(0, Cons(1, Nil)) else cands, st))
fn mc_fill(ps, c) = match ps
    Nil        => Nil
    Cons(h, t) => Cons(c, mc_fill(t, c))

## --- per function report ---
fn mc_dec_cls(ds, id) = match ds
    Nil        => "if"
    Cons(d, t) => if d.id == id then d.cls else mc_dec_cls(t, id)
fn mc_dec_text(ds, id) = match ds
    Nil        => ""
    Cons(d, t) => if d.id == id then lcs_e(d.c) else mc_dec_text(t, id)
fn mc_key_id(k) = slice(k, 0, mc_index(k, "|", 0))
fn mc_key_val(k) = slice(k, count(k) - 1, count(k))
## --- classification of an obligation without a witness ---
## The false outcome of the conclusion of a declared `law` is a violation of the law. `concl` lists the conclusion
## decisions of a law (Nil for any other function): the decisions in result position. A hypothesis (`if H then C else
## 1 == 1`: the decision H) or a decision nested in a condition is NOT a conclusion: its false outcome is ordinary
## control flow and needs a witness or a kernel proof. So does the false outcome of a kept `ensures` check: the code
## generator drops an `ensures` its prover discharged, so one that is still in the lowered AST is unproven.
fn mc_concl(x, path) = match x
    Bin(op, l, r)   => if op == "and" or op == "or" or mc_iscmp(op) == 1 then Cons(path, if mc_allop(x, "and") == 1 then mc_concl_atoms(mc_atoms(x), path, 0) else Nil) else Nil
    If(c, t, e2)    => app(mc_concl(t, path + "t"), mc_concl(e2, path + "e"))
    LetIn(nm, v, b) => mc_concl(b, path + "b")
    _               => Nil
## In a conclusion that is a pure conjunction, a condition that is itself an `if` (or a `let`) is false exactly when
## the decision in its result position is false, and then the whole conclusion is false: those decisions are
## conclusions too (`A and (if p then B else C)`: B and C). The operands of a comparison are values, not conclusions.
fn mc_concl_atoms(ats, path, i) = match ats
    Nil        => Nil
    Cons(a, t) => app(mc_concl_atom(a, path + "c" + str(i) + "x"), mc_concl_atoms(t, path, i + 1))
fn mc_concl_atom(a, p) = match a
    Bin(op, l, r) => Nil
    _             => mc_concl(a, p)
fn mc_laws(prog) = match prog
    Nil        => Nil
    Cons(h, t) => mc_laws2(h, t)
fn mc_laws2(h, t) = match h
    VLawDecl(nm, ps, b) => Cons("law_" + nm, mc_laws(t))
    _                   => mc_laws(t)
fn mc_is_thm_false(concl, ds, k, cov) = if mc_has(concl, mc_key_id(k)) == 0 then 0 else if mc_has(cov, mc_key_id(k) + "|o|0") == 1 then 0 else if mc_key_val(k) == "0" then 1 else 0
## a `let` of the body rebinds a parameter name: the clauses of `requires` then speak about another variable than
## the atoms of a later decision, and may not be used as hypotheses about them
fn mc_rebinds(x, ps) = match x
    Bin(op, l, r)   => if mc_rebinds(l, ps) == 1 then 1 else mc_rebinds(r, ps)
    If(c, t, e2)    => if mc_rebinds(c, ps) == 1 then 1 else if mc_rebinds(t, ps) == 1 then 1 else mc_rebinds(e2, ps)
    LetIn(nm, v, b) => if mc_has(ps, nm) == 1 then 1 else if mc_rebinds(v, ps) == 1 then 1 else mc_rebinds(b, ps)
    Call(nm, args)  => mc_rebinds_l(args, ps)
    _               => 0
fn mc_rebinds_l(xs, ps) = match xs
    Nil        => 0
    Cons(h, t) => if mc_rebinds(h, ps) == 1 then 1 else mc_rebinds_l(t, ps)
fn mc_sx_n(n) = if n < 0 then "(- 0 " + str(0 - n) + ")" else str(n)
fn mc_sx(x) = match x
    Num(n)          => mc_sx_n(n)
    Var(nm)         => if nm == "true" then "1" else if nm == "false" then "0" else nm
    Bin(op, l, r)   => "(" + op + " " + mc_sx(l) + " " + mc_sx(r) + ")"
    If(c, t, e2)    => "(if " + mc_sx(c) + " " + mc_sx(t) + " " + mc_sx(e2) + ")"
    LetIn(nm, v, b) => "(let " + nm + " " + mc_sx(v) + " " + mc_sx(b) + ")"
    _               => "(unsupported)"
fn mc_negop(op) = if op == "==" then "!=" else if op == "!=" then "==" else if op == "<" then ">=" else if op == ">=" then "<" else if op == ">" then "<=" else ">"
fn mc_sx_neg(x) = match x
    Bin(op, l, r) => if mc_iscmp(op) == 1 then "(" + mc_negop(op) + " " + mc_sx(l) + " " + mc_sx(r) + ")" else "(unsupported)"
    _             => "(unsupported)"
fn mc_allop(c, want) = match c
    Bin(op, l, r) => if op == want then (if mc_allop(l, want) == 1 then mc_allop(r, want) else 0) else if op == "and" or op == "or" then 0 else 1
    _             => 1
## the other conditions of the decision, positive (pol 1) or negated (pol 0), as kernel hypotheses
fn mc_others(ats, i, k, pol) = match ats
    Nil        => ""
    Cons(a, t) => (if k == i then "" else " " + (if pol == 1 then mc_sx(a) else mc_sx_neg(a))) + mc_others(t, i, k + 1, pol)
fn mc_req_hyps(ds) = match ds
    Nil        => ""
    Cons(d, t) => if d.cls == "requires" and mc_allop(d.c, "and") == 1 then mc_others(mc_atoms(d.c), 0 - 1, 0, 1) else mc_req_hyps(t)
fn mc_dec_get(ds, id) = match ds
    Nil        => {id: "", cls: "", c: Num(0), ph: Nil}
    Cons(d, t) => if d.id == id then d else mc_dec_get(t, id)
fn mc_key_idx(k) = let a = mc_index(k, "|", 0) in let b = mc_index(k, "|", a + 1) in slice(k, a + 1, b)
fn mc_elem(xs, i) = match xs
    Nil        => Num(0)
    Cons(h, t) => if i <= 0 then h else mc_elem(t, i - 1)
## The kernel term that states the obligation cannot occur, or "" when the decision is not a pure conjunction or
## disjunction. In a conjunction a condition is determining only when all the others are true, so
##   "condition i false and determining" is impossible when the others imply condition i (it is redundant), and
##   "condition i true and determining" (equally: the decision true) is impossible when the others refute it.
## A disjunction is the dual, with the other conditions false.
fn mc_inf_term(ds, k, noreq) = let d = mc_dec_get(ds, mc_key_id(k)) in let ats = mc_atoms(d.c) in let ix = mc_key_idx(k) in let v = mc_key_val(k) in let isand = mc_allop(d.c, "and") in let isor = mc_allop(d.c, "or") in let i = if ix != "o" then toint(ix) else if len(ats) == 1 or (isand == 1 and v == "1") or (isor == 1 and v == "0") then len(ats) - 1 else 0 - 1 in let rq = (if d.cls == "requires" or noreq == 1 then "" else mc_req_hyps(ds)) + mc_ph_sx(d.ph) in if i < 0 then "" else if isand == 1 and (ix != "o" or len(ats) == 1 or v == "1") then "(implies (and (>= 0 0)" + rq + mc_others(ats, i, 0, 1) + ") " + (if v == "0" then mc_sx(mc_elem(ats, i)) else mc_sx_neg(mc_elem(ats, i))) + ")" else if isor == 1 then "(implies (and (>= 0 0)" + rq + mc_others(ats, i, 0, 0) + ") " + (if v == "1" then mc_sx_neg(mc_elem(ats, i)) else mc_sx(mc_elem(ats, i))) + ")" else ""
fn mc_infeasible(ds, k, noreq) = let t = mc_inf_term(ds, k, noreq) in if t == "" then 0 else lk_prove_term(t)
fn mc_tally(cx, obls, ds, cov, acc) = match obls
    Nil        => acc
    Cons(k, t) => if mc_has(cov, k) == 1 then mc_tally(cx, t, ds, cov, {cv: acc.cv + 1, ens: acc.ens, inf: acc.inf, un: acc.un, list: acc.list, ilist: acc.ilist}) else if mc_is_thm_false(cx.concl, ds, k, cov) == 1 then mc_tally(cx, t, ds, cov, {cv: acc.cv, ens: acc.ens + 1, inf: acc.inf, un: acc.un, list: acc.list, ilist: acc.ilist}) else if mc_infeasible(ds, k, cx.noreq) == 1 then mc_tally(cx, t, ds, cov, {cv: acc.cv, ens: acc.ens, inf: acc.inf + 1, un: acc.un, list: acc.list, ilist: Cons(k, acc.ilist)}) else mc_tally(cx, t, ds, cov, {cv: acc.cv, ens: acc.ens, inf: acc.inf, un: acc.un + 1, list: Cons(k, acc.list), ilist: acc.ilist})
fn mc_conds(ds) = match ds
    Nil        => 0
    Cons(d, t) => len(mc_atoms(d.c)) + mc_conds(t)
fn mc_unc_json(f, ds, ks, withproof, noreq) = match ks
    Nil        => ""
    Cons(k, t) => "{\"function\":\"" + f + "\",\"obligation\":\"" + k + "\",\"class\":\"" + mc_dec_cls(ds, mc_key_id(k)) + "\",\"decision\":\"" + mc_jesc(mc_dec_text(ds, mc_key_id(k))) + "\"" + (if withproof == 1 then ",\"kernel_proof_term\":\"" + mc_jesc(mc_inf_term(ds, k, noreq)) + "\"" else "") + "}" + (if isnil(t) == 1 then "" else ",") + mc_unc_json(f, ds, t, withproof, noreq)
fn mc_ty0() = {cv: 0, ens: 0, inf: 0, un: 0, list: Nil, ilist: Nil}
fn mc_ext(f, fs, ds, obls, cx, budget, st0) = let cl = mc_cl(f.ps, cx, mc_req_atoms(ds), fs, 1) in let space = mc_space(f.tys, cl, budget) in let sta = mc_search(f, fs, cl, st0.k + (if space <= budget then space else budget), if space <= budget then 1 else 0, len(obls), st0.k, st0) in let base = mc_base(sta.wit) in let stb = if base.ok == 1 and len(sta.cov) < len(obls) then mc_sweep(f, fs, base.args, f.tys, 0, cx, sta) else sta in mc_search(f, fs, mc_fill(f.ps, cx), stb.k + budget * 12, 0, len(obls), 0, stb)
fn mc_one(f, fs, budget, laws) = let ds = mc_decs(f.body, "", "if", Nil) in let obls = mc_obls(ds) in let cx = {concl: if mc_has(laws, f.nm) == 1 then mc_concl(f.body, "") else Nil, noreq: mc_rebinds(f.body, f.ps)} in let consts = mc_consts(f.body, Cons(0, Cons(1, Cons(2, Cons(7, Nil))))) in let cands = mc_cands(consts, Nil) in let cl = mc_cl(f.ps, cands, mc_req_atoms(ds), fs, 1) in let space = mc_space(f.tys, cl, budget) in let sta = mc_search(f, fs, cl, if space <= budget then space else budget, if space <= budget then 1 else 0, len(obls), 0, {cov: Nil, wit: Nil, k: 0, s: 20261110 + count(f.nm)}) in let base = mc_base(sta.wit) in let st1 = if base.ok == 1 and len(sta.cov) < len(obls) then mc_sweep(f, fs, base.args, f.tys, 0, cands, sta) else sta in let ty1 = mc_tally(cx, obls, ds, st1.cov, mc_ty0()) in let st2 = if ty1.un > 0 then mc_search(f, fs, mc_fill(f.ps, cands), st1.k + budget * 12, 0, len(obls), 0, st1) else st1 in let ty2 = if st2.k > st1.k then mc_tally(cx, obls, ds, st2.cov, mc_ty0()) else ty1 in let st = if ty2.un > 0 then mc_ext(f, fs, ds, obls, mc_cands_x(consts, Nil), budget, st2) else st2 in let ty = if st.k > st2.k then mc_tally(cx, obls, ds, st.cov, mc_ty0()) else ty2 in {nm: f.nm, decisions: len(ds), conds: mc_conds(ds), obls: len(obls), cv: ty.cv, ens: ty.ens, inf: ty.inf, un: ty.un, unc: mc_unc_json(f.nm, ds, ty.list, 0, cx.noreq), infl: mc_unc_json(f.nm, ds, ty.ilist, 1, cx.noreq), wit: st.wit, tried: st.k, f: f}
fn mc_all(sel, fs, budget, laws) = match sel
    Nil        => Nil
    Cons(f, t) => Cons(mc_one(f, fs, budget, laws), mc_all(t, fs, budget, laws))

## --- the program: typed integer functions whose bodies stay inside the fragment ---
fn mc_tyint(ty) = match ty
    TyName(n) => if n == "int" or n == "bool" then 1 else 0
    _         => 0
fn mc_tynm(ty) = match ty
    TyName(n) => n
    _         => "?"
fn mc_tys(tys) = match tys
    Nil        => {ok: 1, ns: Nil}
    Cons(h, t) => let r = mc_tys(t) in {ok: if mc_tyint(h) == 1 then r.ok else 0, ns: Cons(mc_tynm(h), r.ns)}
fn mc_sigs(prog) = match prog
    Nil        => Nil
    Cons(h, t) => mc_sigs2(h, t)
fn mc_sigs2(h, t) = match h
    Sig(nm, ps, tys, rt) => let ts = mc_tys(tys) in Cons({nm: nm, ok: if len(ps) == len(tys) and ts.ok == 1 and mc_tyint(rt) == 1 then 1 else 0, tys: ts.ns, rt: mc_tynm(rt)}, mc_sigs(t))
    _                    => mc_sigs(t)
fn mc_sig_okn(sigs) = match sigs
    Nil        => 0
    Cons(h, t) => h.ok + mc_sig_okn(t)
fn mc_sig_get(sigs, nm) = match sigs
    Nil        => {nm: "", ok: 0, tys: Nil, rt: "int"}
    Cons(h, t) => if h.nm == nm then h else mc_sig_get(t, nm)
## the body uses only forms the interpreter models, and only calls typed integer functions other than itself
fn mc_infrag(x, self, sigs) = match x
    Num(n)          => 1
    Var(nm)         => 1
    Bin(op, l, r)   => if op == "and" or op == "or" or mc_iscmp(op) == 1 or op == "+" or op == "-" or op == "*" or op == "/" or op == "%" then (if mc_infrag(l, self, sigs) == 1 then mc_infrag(r, self, sigs) else 0) else 0
    If(c, t, e2)    => if mc_infrag(c, self, sigs) == 1 and mc_infrag(t, self, sigs) == 1 then mc_infrag(e2, self, sigs) else 0
    LetIn(nm, v, b) => if mc_infrag(v, self, sigs) == 1 then mc_infrag(b, self, sigs) else 0
    Call(nm, args)  => if nm == "ctfail" then 1 else if nm == self or (mc_sig_get(sigs, nm)).ok == 0 then 0 else mc_infrag_l(args, self, sigs)
    _               => 0
fn mc_infrag_l(xs, self, sigs) = match xs
    Nil        => 1
    Cons(h, t) => if mc_infrag(h, self, sigs) == 1 then mc_infrag_l(t, self, sigs) else 0
## strict 1: the functions that are analyzed (no call to itself). strict 0: the functions the reference interpreter
## may CALL, which adds the directly recursive ones; the fuel bounds their depth, and a vector that exhausts it is
## undefined and discarded, exactly like an overflow.
fn mc_fns(prog, sigs, strict) = match prog
    Nil        => Nil
    Cons(h, t) => mc_fns2(h, t, sigs, strict)
fn mc_fns2(h, t, sigs, strict) = match h
    Fn(nm, ps, body) => let sg = mc_sig_get(sigs, nm) in if sg.ok == 1 and mc_infrag(body, if strict == 1 then nm else "", sigs) == 1 then Cons({ok: 1, nm: nm, ps: ps, tys: sg.tys, rt: sg.rt, body: body}, mc_fns(t, sigs, strict)) else mc_fns(t, sigs, strict)
    _                => mc_fns(t, sigs, strict)
fn mc_pick(fs, only) = match fs
    Nil        => Nil
    Cons(f, t) => if only == "" or f.nm == only then Cons(f, mc_pick(t, only)) else mc_pick(t, only)

## --- native execution of the witnesses ---
fn mc_maxar(rs, m) = match rs
    Nil        => m
    Cons(r, t) => mc_maxar(t, if len(r.f.ps) > m then len(r.f.ps) else m)
fn mc_params(i, n) = if i >= n then "" else ", a" + str(i) + ": int" + mc_params(i + 1, n)
fn mc_argis(i, n) = if i >= n then "" else ", mc_argi(" + str(i + 2) + ")" + mc_argis(i + 1, n)
fn mc_callargs(tys, i) = match tys
    Nil        => ""
    Cons(h, t) => (if h == "bool" then "a" + str(i) + " == 1" else "a" + str(i)) + (if isnil(t) == 1 then "" else ", ") + mc_callargs(t, i + 1)
fn mc_dispatch(rs) = match rs
    Nil        => "0"
    Cons(r, t) => if isnil(r.wit) == 1 then mc_dispatch(t) else "if f == \"" + r.nm + "\" then " + (if r.f.rt == "bool" then "(if " + r.nm + "(" + mc_callargs(r.f.tys, 0) + ") then 1 else 0)" else r.nm + "(" + mc_callargs(r.f.tys, 0) + ")") + " else " + mc_dispatch(t)
fn mc_nl(s, n, i) = if i >= n then n else if at(s, i) == "\n" then i else mc_nl(s, n, i + 1)
fn mc_noprint(s, n, i) = if i >= n then Nil else let e = mc_nl(s, n, i) in if e - i >= 6 and slicen(s, n, i, i + 6) == "print " then mc_noprint(s, n, e + 1) else Cons(slicen(s, n, i, e) + "\n", mc_noprint(s, n, e + 1))
fn mc_driver(src, rs) = let m = mc_maxar(rs, 0) in mc_join(mc_noprint(src, count(src), 0)) + "\nfn mc_argi(k: int) -> int = let s = os_arg_at(k) in if count(s) > 0 and at(s, 0) == \"-\" then 0 - toint(slice(s, 1, count(s))) else toint(s)\nfn mc_dispatch_fn(f: str" + mc_params(0, m) + ") -> int = " + mc_dispatch(rs) + "\nprint mc_dispatch_fn(os_arg_at(1)" + mc_argis(0, m) + ")\n"
fn mc_argv(vs, pad) = match vs
    Nil        => if pad <= 0 then Nil else Cons("0", mc_argv(Nil, pad - 1))
    Cons(h, t) => Cons(if h < 0 then "-" + str(0 - h) else str(h), mc_argv(t, pad - 1))
fn mc_show_args(vs) = match vs
    Nil        => ""
    Cons(h, t) => str(h) + (if isnil(t) == 1 then "" else ",") + mc_show_args(t)
fn mc_run_wits(elf, nm, ws, m, out, acc) = match ws
    Nil        => acc
    Cons(w, t) => if acc.bad != "" then acc else let st = mc_wait_exit(os_run_capture_timeout(elf, Cons(nm, mc_argv(w.args, m)), out, out + ".err", 20000)) in let o = fs_read_file(out) in let e = fs_read_file(out + ".err") in if w.st == 1 and (st != 0 or o != str(w.v) + "\n") then {n: acc.n, traps: acc.traps, bad: nm + "(" + mc_show_args(w.args) + "): the interpreter gives " + str(w.v) + ", the real binary exits " + str(st) + " and prints " + mc_jesc(o) + mc_jesc(e)} else if w.st == 0 and (st == 0 or mc_index(e, "runtime contract violation", 0) < 0) then {n: acc.n, traps: acc.traps, bad: nm + "(" + mc_show_args(w.args) + "): the interpreter predicts a contract trap, the real binary exits " + str(st) + " and prints " + mc_jesc(o) + mc_jesc(e)} else mc_run_wits(elf, nm, t, m, out, {n: acc.n + 1, traps: acc.traps + (if w.st == 0 then 1 else 0), bad: ""})
fn mc_run_all(elf, rs, m, out, acc) = match rs
    Nil        => acc
    Cons(r, t) => if acc.bad != "" then acc else mc_run_all(elf, t, m, out, mc_run_wits(elf, r.nm, r.wit, m, out, acc))
fn mc_exec(root, src, rs, tmp) = let mk = os_run("/bin/mkdir", Cons("-p", Cons(tmp, Nil))) in let w = fs_write_sync(tmp + "/mcdc.src", mc_driver(src, rs)) in let c = mc_wait_exit(os_run_input_capture_timeout(root + "/build/bin/lumec", Nil, tmp + "/mcdc.src", tmp + "/mcdc.s", tmp + "/mcdc.err", 900000)) in if c != 0 then {n: 0, traps: 0, bad: "lumec rejected the witness driver: " + mc_jesc(fs_read_file(tmp + "/mcdc.err"))} else let a = mc_wait_exit(os_run_capture_timeout(root + "/build/bin/lasm", Cons("--strict", Cons(tmp + "/mcdc.s", Nil)), tmp + "/mcdc.elf", tmp + "/mcdc.err", 900000)) in if a != 0 then {n: 0, traps: 0, bad: "lasm rejected the witness driver"} else let ch = os_run("/bin/chmod", Cons("+x", Cons(tmp + "/mcdc.elf", Nil))) in let r = mc_run_all(tmp + "/mcdc.elf", rs, mc_maxar(rs, 0), tmp + "/mcdc.out", {n: 0, traps: 0, bad: ""}) in let rm = if r.bad == "" then os_run("/bin/rm", Cons("-rf", Cons(tmp, Nil))) else 0 in r

## --- report ---
fn mc_sum(rs, acc) = match rs
    Nil        => acc
    Cons(r, t) => mc_sum(t, {fns: acc.fns + 1, decisions: acc.decisions + r.decisions, conds: acc.conds + r.conds, obls: acc.obls + r.obls, cv: acc.cv + r.cv, ens: acc.ens + r.ens, inf: acc.inf + r.inf, un: acc.un + r.un, wit: acc.wit + len(r.wit), full: acc.full + (if r.un == 0 then 1 else 0)})
fn mc_unc_all(rs) = match rs
    Nil        => ""
    Cons(r, t) => let rest = mc_unc_all(t) in if r.unc == "" then rest else r.unc + (if rest == "" then "" else ",") + rest
fn mc_inf_all(rs) = match rs
    Nil        => ""
    Cons(r, t) => let rest = mc_inf_all(t) in if r.infl == "" then rest else r.infl + (if rest == "" then "" else ",") + rest
fn mc_fn_json(rs) = match rs
    Nil        => ""
    Cons(r, t) => "{\"name\":\"" + r.nm + "\",\"decisions\":" + str(r.decisions) + ",\"conditions\":" + str(r.conds) + ",\"obligations\":" + str(r.obls) + ",\"covered\":" + str(r.cv) + ",\"theorem_false\":" + str(r.ens) + ",\"infeasible_proved\":" + str(r.inf) + ",\"uncovered\":" + str(r.un) + ",\"witness_vectors\":" + str(len(r.wit)) + ",\"vectors_tried\":" + str(r.tried) + "}" + (if isnil(t) == 1 then "" else ",") + mc_fn_json(t)
fn mc_main(input) = let root = mc_get(input, "root") in let srcp = mc_get(input, "src") in if root == "" or srcp == "" then ctfail("lmcdc: usage: @root <repo> and @src <file.src> are required on stdin\n") else if fs_path_exists(srcp) == 0 then ctfail("lmcdc: cannot read " + srcp + "\n") else let src = fs_read_file(srcp) in let prog = nf_late(lumec_expand(src)) in let sigs = mc_sigs(prog) in let fs = mc_fns(prog, sigs, 1) in let rs = mc_all(mc_pick(fs, mc_get(input, "fn")), mc_fns(prog, sigs, 0), toint(mc_or(mc_get(input, "budget"), "6000")), mc_laws(parseprogram(src))) in let s = mc_sum(rs, {fns: 0, decisions: 0, conds: 0, obls: 0, cv: 0, ens: 0, inf: 0, un: 0, wit: 0, full: 0}) in let ex = if mc_get(input, "exec") == "1" then mc_exec(root, src, rs, "/tmp/lume-mcdc." + str(os_getpid())) else {n: 0, traps: 0, bad: ""} in mc_finish("{\"ok\":" + (if ex.bad == "" then "true" else "false") + ",\"tool\":\"lmcdc\",\"criterion\":\"decision coverage + masking MC/DC over the lowered AST (requires, runtime-checked ensures, if conditions, Boolean values)\",\"theorem_false_basis\":\"false outcome of the conclusion of a declared law; not proven by lmcdc, it rests on the proof status of that law\",\"source\":\"" + mc_jesc(srcp) + "\",\"typed_integer_functions_in_source\":" + str(mc_sig_okn(sigs)) + ",\"functions\":" + str(s.fns) + ",\"functions_fully_covered\":" + str(s.full) + ",\"decisions\":" + str(s.decisions) + ",\"conditions\":" + str(s.conds) + ",\"obligations\":" + str(s.obls) + ",\"covered\":" + str(s.cv) + ",\"theorem_false_unreachable\":" + str(s.ens) + ",\"infeasible_proved_by_kernel\":" + str(s.inf) + ",\"uncovered\":" + str(s.un) + ",\"witness_vectors\":" + str(s.wit) + ",\"native_witnesses_agreeing\":" + str(ex.n) + ",\"native_contract_traps_confirmed\":" + str(ex.traps) + ",\"error\":\"" + mc_jesc(ex.bad) + "\",\"uncovered_list\":[" + mc_unc_all(rs) + "],\"infeasible_list\":[" + mc_inf_all(rs) + "],\"per_function\":[" + mc_fn_json(rs) + "]}", if ex.bad == "" then 0 else 1)
fn mc_finish(json, code) = if code == 0 then json else let w = fs_write_sync("/dev/stdout", json + "\n") in ctfail("lmcdc: a coverage witness disagrees with the real machine; the report is on stdout\n")

print mc_main(readall())
