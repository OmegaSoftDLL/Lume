## tun.src -- layer-3 virtual network interfaces (TUN) for VPNs, written in Lume over the system calls.
##   Linux: /dev/net/tun + ioctl(TUNSETIFF, IFF_TUN | IFF_NO_PI): every read is one IP packet, every write sends one.
##          tun_set_ipv4 / tun_set_mtu / tun_set_up configure the interface through ioctls on an AF_INET socket.
##          Needs CAP_NET_ADMIN (root). The descriptor works with epoll (use net / the os_epoll_* builtins).
##   Windows: Wintun (wintun.dll, the WireGuard driver; found next to the program, in System32 or in the folder named by
##          LUME_WINTUN_DLL). Needs an elevated process. tun_wait blocks on the session's read event.
## Every function answers a record or a number; a failure says why (errno, or the Win32 error), never in silence.
use winsys

## --- bytes --------------------------------------------------------------------------------------------------------
fn tun_put(b, o, s, i) = if i >= count(s) then b else tun_put(buf_set(b, o + i, ord_at(s, i)), o, s, i + 1)
fn tun_put16(b, o, v) = let x = buf_set(b, o, bit_and(v, 255)) in buf_set(b, o + 1, bit_and(bit_shr(v, 8), 255))
fn tun_put32(b, o, v) = let x = tun_put16(b, o, bit_and(v, 65535)) in tun_put16(b, o + 2, bit_and(bit_shr(v, 16), 65535))
fn tun_cstr(s) = tun_put(buf_new(count(s) + 1), 0, s, 0)
fn tun_name_at(b, o, i, acc) = if i >= 16 or buf_get(b, o + i) == 0 then acc else tun_name_at(b, o, i + 1, acc + chr(buf_get(b, o + i)))
fn tun_fail(why) = {ok: 0, fd: 0 - 1, sess: 0, name: "", err: why}

## "a.b.c.d" -> its four bytes as a list, or Nil when it is not a dotted IPv4 address
fn tun_digits(s, i, n, v, k) = if i >= n then {v: v, i: i, k: k} else let c = ord_at(s, i) in if c < 48 or c > 57 then {v: v, i: i, k: k} else tun_digits(s, i + 1, n, v * 10 + c - 48, k + 1)
fn tun_octets(s, i, left, acc) = let d = tun_digits(s, i, count(s), 0, 0) in if d.k == 0 or d.k > 3 or d.v > 255 then Nil else if left == 1 then (if d.i == count(s) then tun_rev(Cons(d.v, acc), Nil) else Nil) else if d.i < count(s) and at(s, d.i) == "." then tun_octets(s, d.i + 1, left - 1, Cons(d.v, acc)) else Nil
fn tun_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => tun_rev(t, Cons(h, acc))
fn tun_isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn tun_parse_ipv4(s) = tun_octets(s, 0, 4, Nil)
## the netmask of a prefix length as four bytes (24 -> 255.255.255.0)
fn tun_mask_byte(prefix, k) = let bits = prefix - 8 * k in if bits >= 8 then 255 else if bits <= 0 then 0 else 256 - bit_shl(1, 8 - bits)
fn tun_mask(prefix) = Cons(tun_mask_byte(prefix, 0), Cons(tun_mask_byte(prefix, 1), Cons(tun_mask_byte(prefix, 2), Cons(tun_mask_byte(prefix, 3), Nil))))
fn tun_put_bytes(b, o, xs) = match xs
    Nil        => b
    Cons(h, t) => tun_put_bytes(buf_set(b, o, h), o + 1, t)

## --- Linux ---------------------------------------------------------------------------------------------------------
## struct ifreq: the name in 16 bytes, then a union at +16 (flags as a short, a sockaddr_in, an int)
fn tun_ifreq(name) = tun_put(buf_new(40), 0, name, 0)
fn tun_errno(r) = " (errno " + str(0 - r) + (if r == 0 - 1 or r == 0 - 13 then ": needs CAP_NET_ADMIN, run as root" else if r == 0 - 2 or r == 0 - 19 then ": no TUN driver (/dev/net/tun)" else "") + ")"
fn tun_open_linux(name) = if count(name) > 15 then tun_fail("interface name longer than 15 bytes: " + name) else let fd = sys_call(2, buf_addr(tun_cstr("/dev/net/tun")), 524290, 0, 0, 0) in if fd < 0 then tun_fail("cannot open /dev/net/tun" + tun_errno(fd)) else tun_setiff(fd, tun_put16(tun_ifreq(name), 16, 4097))
fn tun_setiff(fd, ifr) = let r = sys_call(16, fd, 1074025674, buf_addr(ifr), 0, 0) in if r < 0 then (let c = sys_call(3, fd, 0, 0, 0, 0) in tun_fail("TUNSETIFF failed" + tun_errno(r))) else {ok: 1, fd: fd, sess: 0, name: tun_name_at(ifr, 0, 0, ""), err: ""}
## one ioctl on a throwaway AF_INET datagram socket: 0, or the negative errno
fn tun_sock_ioctl(req, ifr) = let s = sys_call(41, 2, 2, 0, 0, 0) in if s < 0 then s else let r = sys_call(16, s, req, buf_addr(ifr), 0, 0) in let c = sys_call(3, s, 0, 0, 0, 0) in r
fn tun_sockaddr(name, octets) = tun_put_bytes(tun_put16(tun_ifreq(name), 16, 2), 20, octets)
fn tun_linux_ipv4(name, addr, prefix) = let ip = tun_parse_ipv4(addr) in if tun_isnil(ip) == 1 or prefix < 0 or prefix > 32 then "not an IPv4 address / prefix: " + addr + "/" + str(prefix) else let r1 = tun_sock_ioctl(35094, tun_sockaddr(name, ip)) in if r1 < 0 then "SIOCSIFADDR failed" + tun_errno(r1) else let r2 = tun_sock_ioctl(35100, tun_sockaddr(name, tun_mask(prefix))) in if r2 < 0 then "SIOCSIFNETMASK failed" + tun_errno(r2) else ""
fn tun_linux_mtu(name, mtu) = let r = tun_sock_ioctl(35106, tun_put32(tun_ifreq(name), 16, mtu)) in if r < 0 then "SIOCSIFMTU failed" + tun_errno(r) else ""
## SIOCGIFFLAGS, then SIOCSIFFLAGS with IFF_UP | IFF_RUNNING added
fn tun_linux_up(name) = let ifr = tun_ifreq(name) in let r = tun_sock_ioctl(35091, ifr) in if r < 0 then "SIOCGIFFLAGS failed" + tun_errno(r) else let f = buf_get(ifr, 16) + 256 * buf_get(ifr, 17) in let r2 = tun_sock_ioctl(35092, tun_put16(ifr, 16, bit_or(f, 65))) in if r2 < 0 then "SIOCSIFFLAGS failed" + tun_errno(r2) else ""

## --- Windows (Wintun) ----------------------------------------------------------------------------------------------
fn tun_dll() = let d = os_getenv("LUME_WINTUN_DLL") in if d != "" then d else "wintun.dll"
fn tun_wcall(name, xs) = ws_callq(tun_dll(), name, xs)
fn tun_open_win(name) = if ws_fn(tun_dll(), "WintunCreateAdapter") <= 0 then tun_fail("wintun.dll not found (install Wintun, put wintun.dll next to the program, or set LUME_WINTUN_DLL)") else let w = ws_wstr(name) in let t = ws_wstr("Lume") in let ad = tun_wcall("WintunCreateAdapter", Cons(buf_addr(w), Cons(buf_addr(t), Cons(0, Nil)))) in if ad == 0 then tun_fail("WintunCreateAdapter failed (Win32 error " + str(ws_callq("kernel32.dll", "GetLastError", Nil)) + "; an elevated process is needed)") else tun_win_session(ad, name)
fn tun_win_session(ad, name) = let s = tun_wcall("WintunStartSession", Cons(ad, Cons(4194304, Nil))) in if s == 0 then (let c = tun_wcall("WintunCloseAdapter", Cons(ad, Nil)) in tun_fail("WintunStartSession failed (Win32 error " + str(ws_callq("kernel32.dll", "GetLastError", Nil)) + ")")) else {ok: 1, fd: ad, sess: s, name: name, err: ""}
## one packet into buf: its size, 0 when none is waiting, -1 when it does not fit (the packet is dropped)
fn tun_win_read(t, buf) = let sz = buf_new(8) in let p = tun_wcall("WintunReceivePacket", Cons(t.sess, Cons(buf_addr(sz), Nil))) in if p == 0 then 0 else let n = ws_u32(sz, 0) in let ok = (if n <= buf_len(buf) then ws_callq("kernel32.dll", "RtlMoveMemory", Cons(buf_addr(buf), Cons(p, Cons(n, Nil)))) else 0) in let r = tun_wcall("WintunReleaseReceivePacket", Cons(t.sess, Cons(p, Nil))) in if n <= buf_len(buf) then n else 0 - 1
fn tun_win_write(t, buf, n) = let p = tun_wcall("WintunAllocateSendPacket", Cons(t.sess, Cons(n, Nil))) in if p == 0 then 0 - 1 else let c = ws_callq("kernel32.dll", "RtlMoveMemory", Cons(p, Cons(buf_addr(buf), Cons(n, Nil)))) in let s = tun_wcall("WintunSendPacket", Cons(t.sess, Cons(p, Nil))) in n
## the address through the IP Helper API (MIB_UNICASTIPADDRESS_ROW: SOCKADDR_INET at 0, InterfaceLuid at 32,
## OnLinkPrefixLength at 60, DadState at 64)
fn tun_win_ipv4(t, addr, prefix) = let ip = tun_parse_ipv4(addr) in if tun_isnil(ip) == 1 or prefix < 0 or prefix > 32 then "not an IPv4 address / prefix: " + addr + "/" + str(prefix) else let row = buf_new(80) in let i = ws_callq("iphlpapi.dll", "InitializeUnicastIpAddressEntry", Cons(buf_addr(row), Nil)) in let l = tun_wcall("WintunGetAdapterLUID", Cons(t.fd, Cons(buf_addr(row) + 32, Nil))) in let a = tun_put_bytes(tun_put16(row, 0, 2), 4, ip) in let p = buf_set(row, 60, prefix) in let d = tun_put32(row, 64, 4) in let r = ws_callq("iphlpapi.dll", "CreateUnicastIpAddressEntry", Cons(buf_addr(row), Nil)) in if r != 0 then "CreateUnicastIpAddressEntry failed (Win32 error " + str(r) + ")" else ""

## --- the API ---------------------------------------------------------------------------------------------------------
## tun_open(name) -> {ok, fd, sess, name, err}: the interface (ok 1) or why it could not be made (ok 0, err)
fn tun_open(name) = if os_platform() == "windows" then tun_open_win(name) else tun_open_linux(name)
## one IP packet into buf: its length; 0 when none is waiting (non-blocking Linux / Windows); -1 on an error
fn tun_read(t, buf) = if t.ok != 1 then 0 - 1 else if t.sess != 0 then tun_win_read(t, buf) else let r = sys_call(0, t.fd, buf_addr(buf), buf_len(buf), 0, 0) in if r == 0 - 11 then 0 else if r < 0 then 0 - 1 else r
## send the first n bytes of buf as one IP packet: n, or -1
fn tun_write(t, buf, n) = if t.ok != 1 or n < 0 or n > buf_len(buf) then 0 - 1 else if t.sess != 0 then tun_win_write(t, buf, n) else let r = sys_call(1, t.fd, buf_addr(buf), n, 0, 0) in if r < 0 then 0 - 1 else r
## reads return 0 instead of blocking (Linux O_NONBLOCK; a Wintun session never blocks)
fn tun_set_nonblocking(t) = if t.ok != 1 then 0 else if t.sess != 0 then 1 else let fl = sys_call(72, t.fd, 3, 0, 0, 0) in if fl < 0 then 0 else if sys_call(72, t.fd, 4, bit_or(fl, 2048), 0, 0) < 0 then 0 else 1
## wait up to ms milliseconds for a packet: 1 when one is waiting, 0 on timeout
fn tun_wait(t, ms) = if t.ok != 1 then 0 else if t.sess != 0 then (let e = tun_wcall("WintunGetReadWaitEvent", Cons(t.sess, Nil)) in if ws_callq("kernel32.dll", "WaitForSingleObject", Cons(e, Cons(ms, Nil))) == 0 then 1 else 0) else let pfd = tun_put16(tun_put32(buf_new(8), 0, t.fd), 4, 1) in let r = sys_call(7, buf_addr(pfd), 1, ms, 0, 0) in if r > 0 then 1 else 0
## address, MTU, link up: "" on success, else the reason
fn tun_set_ipv4(t, addr, prefix) = if t.ok != 1 then "the interface is not open" else if t.sess != 0 then tun_win_ipv4(t, addr, prefix) else tun_linux_ipv4(t.name, addr, prefix)
fn tun_set_mtu(t, mtu) = if t.ok != 1 then "the interface is not open" else if mtu < 68 or mtu > 65535 then "MTU outside 68..65535: " + str(mtu) else if t.sess != 0 then "" else tun_linux_mtu(t.name, mtu)
fn tun_set_up(t) = if t.ok != 1 then "the interface is not open" else if t.sess != 0 then "" else tun_linux_up(t.name)
fn tun_close(t) = if t.ok != 1 then 0 else if t.sess != 0 then (let e = tun_wcall("WintunEndSession", Cons(t.sess, Nil)) in let c = tun_wcall("WintunCloseAdapter", Cons(t.fd, Nil)) in 1) else (if sys_call(3, t.fd, 0, 0, 0, 0) == 0 then 1 else 0)
