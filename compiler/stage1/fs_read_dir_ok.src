fn fs_dir_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else fs_dir_line_end(text, i + 1)

fn fs_dir_has_line_at(text, name, i) = if i >= count(text) then 0 else let end = fs_dir_line_end(text, i) in if slice(text, i, end) == name then 1 else fs_dir_has_line_at(text, name, end + 1)

fn fs_dir_has_line(text, name) = fs_dir_has_line_at(text, name, 0)

fn test_fs_read_dir_lists_names_and_spaces() = let dir = "build/fs_read_dir_probe" in let made = fs_mkdir(dir) in let nested = fs_mkdir(dir + "/nested") in let alpha = fs_write_sync(dir + "/alpha with space.src", "alpha") in let beta = fs_write_sync(dir + "/beta.lume", "beta") in let entries = fs_read_dir(dir) in made == 1 and nested == 1 and alpha == 1 and beta == 1 and fs_dir_has_line(entries, "alpha with space.src") == 1 and fs_dir_has_line(entries, "beta.lume") == 1 and fs_dir_has_line(entries, "nested") == 1

fn test_fs_read_dir_excludes_dot_entries_and_rejects_invalid_paths() = let dir = "build/fs_read_dir_probe" in let entries = fs_read_dir(dir) in fs_dir_has_line(entries, ".") == 0 and fs_dir_has_line(entries, "..") == 0 and fs_read_dir("build/definitely-missing-directory") == "" and fs_read_dir(dir + "/alpha with space.src") == ""

fn test_fs_current_dir_is_native_and_readable() = let cwd = fs_current_dir() in count(cwd) > 0 and at(cwd, 0) == "/" and fs_read_dir(cwd) != ""
