## The initial native toolchain is assembled by lume0 asm, so the hosted runtime may only use forms that
## encoder knows. Value words depend on shifts (word >> 1 is the integer), so they must be in the runtime.
use std.io
use data_ast
use data_asmgen

let prog = [
    DLet(name: "xs", value: DArray(size: DInt(n: 2))),
    DExprS(value: DSetIndex(coll: DVar(name: "xs"), idx: DInt(n: 0), value: DInt(n: 42))),
    DPrint(value: DIndex(coll: DVar(name: "xs"), idx: DInt(n: 0)))
]
let asm = agen(prog)
if not asm.contains("sarq $1, %rax")
    io.println("native runtime lost the value-word decoding")
elif not asm.contains("imulq $8, %rdi")
    io.println("missing native array size computation")
else
    io.println("native runtime seed subset ok")
