## The initial native toolchain is assembled by lume0 asm. Its frozen encoder
## deliberately has no shift instructions, so every runtime path must avoid them.
use std.io
use data_ast
use data_asmgen

let prog = [
    DLet(name: "xs", value: DArray(size: DInt(n: 2))),
    DExprS(value: DSetIndex(coll: DVar(name: "xs"), idx: DInt(n: 0), value: DInt(n: 42))),
    DPrint(value: DIndex(coll: DVar(name: "xs"), idx: DInt(n: 0)))
]
let asm = agen(prog)
if asm.contains("shlq") or asm.contains("shrq") or asm.contains("salq") or asm.contains("sarq")
    io.println("seed-incompatible shift in native runtime")
elif not asm.contains("imulq $8, %rdi")
    io.println("missing native array size computation")
else
    io.println("native runtime seed subset ok")
