## deflate.src -- DEFLATE (RFC 1951) with the zlib (RFC 1950) and gzip (RFC 1952) wrappers, in Lume (`use std/deflate`)
##   inflate_buf(b, off, n)    raw DEFLATE data -> {ok, buf, n, err, next}: stored, fixed and dynamic Huffman blocks,
##                             table-driven decoding (10-bit first-level tables); refuses over-subscribed and incomplete
##                             codes, distances past the output and truncated data
##   deflate_level(b, off, n, level)   -> {buf, n}: zlib's algorithm and parameters for levels 1..9 (0 = stored only):
##                             hash chains over a 32 KiB window, lazy matching from level 4 (good / lazy / nice / chain as
##                             zlib's configuration table), a block every 16383 symbols, each block written in the
##                             smallest of stored / fixed / dynamic Huffman (code lengths limited to 15 / 7 bits)
##   deflate_buf(b, off, n)    level 6 (zlib's default)
##   zlib_decompress(b, n) / zlib_compress(b, n) / zlib_compress_level(b, n, level)   RFC 1950: header, Adler-32 (checked)
##   gunzip(b, n) / gzip(b, n) / gzip_level(b, n, level)   RFC 1952: FEXTRA, FNAME, FCOMMENT, FHCRC; CRC-32 and size
##                                                          (checked)
##   gunzip_str(s) / gzip_str(s)                    the same on strings (the bytes of s)
## Results that can fail are {ok, buf, n, err}: ok 0 and err the reason on corrupt input.
use hash

## --- 16-bit and 32-bit words in buffers (little endian) --------------------------------------------------------------
fn df_w16(t, i, v) = let a = buf_set(t, i * 2, v % 256) in buf_set(t, i * 2 + 1, v / 256)
fn df_r16(t, i) = buf_get(t, i * 2) + buf_get(t, i * 2 + 1) * 256
fn dz_r32(t, i) = buf_get(t, i * 4) + buf_get(t, i * 4 + 1) * 256 + buf_get(t, i * 4 + 2) * 65536 + buf_get(t, i * 4 + 3) * 16777216
fn dz_w32(t, i, v) =
    let a = buf_set(t, i * 4, v % 256) in
    let b = buf_set(t, i * 4 + 1, (v / 256) % 256) in
    let c = buf_set(t, i * 4 + 2, (v / 65536) % 256) in
    buf_set(t, i * 4 + 3, (v / 16777216) % 256)
fn df_bad(err) = {ok: 0, buf: buf_new(0), n: 0, err: err}
## a buffer holding n used bytes with room for need more (the same buffer when it fits)
fn df_room(o, n, need) =
    if n + need <= buf_len(o) then
        o
    else
        let nb = buf_new((buf_len(o) + need) * 2) in
        let c = buf_copy(nb, 0, o, 0, n) in
        nb
## growable byte list {b, n} for headers and trailers
fn df_out() = {b: buf_new(256), n: 0}
fn df_put(o, v) = let g = df_room(o.b, o.n, 1) in let w = buf_set(g, o.n, v) in {b: g, n: o.n + 1}
fn df_cat(o, b, n) = let g = df_room(o.b, o.n, n) in let c = buf_copy(g, o.n, b, 0, n) in {b: g, n: o.n + n}

## --- bits, least significant first --------------------------------------------------------------------------------------
fn df_bit(b, p) = bit_and(bit_shr(buf_get(b, p / 8), p % 8), 1)
## at least 25 bits from bit p (the input buffer is padded with 16 zero bytes)
fn df_peek(b, p) =
    let q = p / 8 in
    bit_shr(buf_get(b, q) + buf_get(b, q + 1) * 256 + buf_get(b, q + 2) * 65536 + buf_get(b, q + 3) * 16777216, p % 8)
fn df_bits(b, p, k) = if k == 0 then 0 else bit_and(df_peek(b, p), bit_shl(1, k) - 1)

## --- length and distance codes (RFC 1951 3.2.5) --------------------------------------------------------------------------
fn df_lbase(i) = if i < 8 then 3 + i else if i >= 28 then 258 else bit_shl(4 + i % 4, (i - 4) / 4) + 3
fn df_lext(i) = if i < 8 or i >= 28 then 0 else (i - 4) / 4
fn df_dbase(i) = if i < 4 then i + 1 else bit_shl(2 + i % 2, (i - 2) / 2) + 1
fn df_dext(i) = if i < 4 then 0 else (i - 2) / 2
fn df_clorder(i) = if i < 3 then 16 + i else if i == 3 then 0 else if i % 2 == 0 then 8 + (i - 4) / 2 else 7 - (i - 5) / 2

## --- canonical Huffman decoding tables ---------------------------------------------------------------------------------
## lens: 16-bit code lengths of n symbols -> {cnt, sym, fast, mask}: cnt[0..15], the symbols in code order, and a table of
## 2^fb entries indexed by the next fb input bits: symbol * 16 + length, 0 for a longer (or invalid) code
fn df_table(lens, n) =
    let cnt = buf_new(32) in
    let a = df_count(lens, cnt, 0, n) in
    let offs = buf_new(34) in
    let b = df_offs(cnt, offs, 1, 0) in
    let sym = buf_new(n * 2 + 2) in
    let c = df_syms(lens, offs, sym, 0, n) in
    {cnt: cnt, sym: sym}
fn df_count(lens, cnt, i, n) =
    if i >= n then
        0
    else
        let l = df_r16(lens, i) in
        let w = if l > 0 then df_w16(cnt, l, df_r16(cnt, l) + 1) else 0 in
        df_count(lens, cnt, i + 1, n)
fn df_offs(cnt, offs, l, acc) =
    if l > 15 then
        0
    else
        let w = df_w16(offs, l, acc) in
        df_offs(cnt, offs, l + 1, acc + df_r16(cnt, l))
fn df_syms(lens, offs, sym, i, n) =
    if i >= n then
        0
    else
        let l = df_r16(lens, i) in
        let w = if l > 0 then let o = df_r16(offs, l) in let z = df_w16(sym, o, i) in df_w16(offs, l, o + 1) else 0 in
        df_syms(lens, offs, sym, i + 1, n)
fn ih_table(lens, n, fb) =
    let t = df_table(lens, n) in
    let fast = buf_new(bit_shl(1, fb) * 2) in
    let left = ih_left(t.cnt, 1, 1) in
    let next = buf_new(34) in
    let a = if left >= 0 then let z = ih_next(t.cnt, next, 1, 0) in ih_fill(lens, n, next, fast, fb, 0) else 0 in
    {cnt: t.cnt, sym: t.sym, fast: fast, mask: bit_shl(1, fb) - 1, left: left, total: ih_total(t.cnt, 1, 0)}
## the unused part of the code space (Kraft): -1 over-subscribed, 0 complete, > 0 incomplete
fn ih_left(cnt, l, left) =
    if l > 15 then
        left
    else
        let x = left * 2 - df_r16(cnt, l) in
        if x < 0 then 0 - 1 else ih_left(cnt, l + 1, x)
fn ih_total(cnt, l, acc) = if l > 15 then acc else ih_total(cnt, l + 1, acc + df_r16(cnt, l))
fn ih_next(cnt, next, l, code) =
    if l > 15 then
        0
    else
        let c = (code + df_r16(cnt, l - 1)) * 2 in
        let z = df_w16(next, l, c) in
        ih_next(cnt, next, l + 1, c)
fn ih_fill(lens, n, next, fast, fb, s) =
    if s >= n then
        0
    else
        let l = df_r16(lens, s) in
        let z = if l > 0 then ih_fill1(next, fast, fb, s, l) else 0 in
        ih_fill(lens, n, next, fast, fb, s + 1)
fn ih_fill1(next, fast, fb, s, l) =
    let c = df_r16(next, l) in
    let y = df_w16(next, l, c + 1) in
    if l <= fb then ih_rep(fast, dw_rev(c, l, 0), bit_shl(1, l), bit_shl(1, fb), s * 16 + l) else 0
fn ih_rep(fast, r, step, lim, e) = if r >= lim then 0 else let w = df_w16(fast, r, e) in ih_rep(fast, r + step, step, lim, e)
## one complete code, or a single code of one bit (zlib accepts that incomplete code for literals and distances)
fn ih_ok(t) = t.left == 0 or (t.total == 1 and df_r16(t.cnt, 1) == 1)
## decode one symbol at bit p: (new p) * 512 + symbol; symbol 511 on a bad code
fn ih_dec(b, p, t) =
    let e = df_r16(t.fast, bit_and(df_peek(b, p), t.mask)) in
    if e > 0 then (p + e % 16) * 512 + e / 16 else ih_slow(b, p, t, 1, 0, 0, 0)
fn ih_slow(b, p, t, len, code, first, index) =
    if len > 15 then
        p * 512 + 511
    else
        let c2 = code + df_bit(b, p) in
        let count = df_r16(t.cnt, len) in
        if c2 - first < count then
            (p + 1) * 512 + df_r16(t.sym, index + c2 - first)
        else
            ih_slow(b, p + 1, t, len + 1, c2 * 2, (first + count) * 2, index + count)

## --- inflate ----------------------------------------------------------------------------------------------------------
fn inflate_buf(b, off, n) =
    let bp = buf_new(n + 16) in
    let c = buf_copy(bp, 0, b, off, n) in
    let r = ib_blocks(bp, 0, n * 8, buf_new(if n < 2048 then 8192 else n * 4), 0) in
    if r.ok == 0 then
        df_bad(r.err)
    else
        {ok: 1, buf: r.o, n: r.n, err: "", next: off + (r.p + 7) / 8}
fn ib_err(p, o, on, err) = {ok: 0, p: p, o: o, n: on, err: err}
fn ib_blocks(bp, p, end, o, on) =
    if p + 3 > end then
        ib_err(p, o, on, "truncated data")
    else
        let final = df_bits(bp, p, 1) in
        let typ = df_bits(bp, p + 1, 2) in
        let r = if typ == 0 then ib_stored(bp, p + 3, end, o, on) else if typ == 1 then ib_huff(bp, p + 3, end, o, on, ib_fixed_lit(), ib_fixed_dist()) else if typ == 2 then ib_dynamic(bp, p + 3, end, o, on) else ib_err(p, o, on, "reserved block type") in
        if r.ok == 0 then
            r
        else if r.p > end then
            ib_err(p, o, on, "truncated data")
        else if final == 1 then
            r
        else
            ib_blocks(bp, r.p, end, r.o, r.n)
fn ib_stored(bp, p, end, o, on) =
    let i = (p + 7) / 8 in
    if i * 8 + 32 > end then
        ib_err(p, o, on, "truncated stored block")
    else
        let len = buf_get(bp, i) + buf_get(bp, i + 1) * 256 in
        let nlen = buf_get(bp, i + 2) + buf_get(bp, i + 3) * 256 in
        if len + nlen != 65535 then
            ib_err(p, o, on, "stored block length check")
        else if (i + 4 + len) * 8 > end then
            ib_err(p, o, on, "truncated stored block")
        else
            let g = df_room(o, on, len) in
            let c = buf_copy(g, on, bp, i + 4, len) in
            {ok: 1, p: (i + 4 + len) * 8, o: g, n: on + len, err: ""}
fn ib_fixed_lit() =
    let l = buf_new(288 * 2) in
    let a = df_fill(l, 0, 144, 8) in
    let b = df_fill(l, 144, 256, 9) in
    let c = df_fill(l, 256, 280, 7) in
    let d = df_fill(l, 280, 288, 8) in
    ih_table(l, 288, 9)
fn ib_fixed_dist() = let l = buf_new(30 * 2) in let a = df_fill(l, 0, 30, 5) in ih_table(l, 30, 5)
fn df_fill(l, i, e, v) = if i >= e then 0 else let w = df_w16(l, i, v) in df_fill(l, i + 1, e, v)
## the symbols of one Huffman block
fn ib_huff(bp, p, end, o, on, lt, dt) =
    if p > end then
        ib_err(p, o, on, "truncated data")
    else
        let o2 = if on + 258 > buf_len(o) then df_room(o, on, 258) else o in
        let q = p / 8 in
        let v = bit_shr(buf_get(bp, q) + buf_get(bp, q + 1) * 256 + buf_get(bp, q + 2) * 65536 + buf_get(bp, q + 3) * 16777216, p % 8) in
        let fast = lt.fast in
        let fi = bit_and(v, lt.mask) * 2 in
        let e = buf_get(fast, fi) + buf_get(fast, fi + 1) * 256 in
        let r = if e > 0 then (p + e % 16) * 512 + e / 16 else ih_slow(bp, p, lt, 1, 0, 0, 0) in
        let s = r % 512 in
        if s < 256 then
            let w = buf_set(o2, on, s) in
            ib_huff(bp, r / 512, end, o2, on + 1, lt, dt)
        else if s == 256 then
            {ok: 1, p: r / 512, o: o2, n: on, err: ""}
        else if s > 285 then
            ib_err(p, o2, on, "bad literal/length code")
        else
            let li = s - 257 in
            let p1 = r / 512 in
            let le = df_lext(li) in
            let len = df_lbase(li) + df_bits(bp, p1, le) in
            let rd = ih_dec(bp, p1 + le, dt) in
            let ds = rd % 512 in
            if ds > 29 then
                ib_err(p, o2, on, "bad distance code")
            else
                let p2 = rd / 512 in
                let de = df_dext(ds) in
                let dist = df_dbase(ds) + df_bits(bp, p2, de) in
                if dist > on then
                    ib_err(p, o2, on, "distance too far back")
                else
                    let z = ib_copy(o2, on, dist, len) in
                    ib_huff(bp, p2 + de, end, o2, on + len, lt, dt)
## copy len bytes from dist back; an overlapping copy repeats the period, which doubles with each chunk
fn ib_copy(o, on, dist, len) =
    if dist >= len then
        buf_copy(o, on, o, on - dist, len)
    else
        let c = buf_copy(o, on, o, on - dist, dist) in
        ib_copy(o, on + dist, dist * 2, len - dist)
fn ib_dynamic(bp, p, end, o, on) =
    let hlit = df_bits(bp, p, 5) + 257 in
    let hdist = df_bits(bp, p + 5, 5) + 1 in
    let hclen = df_bits(bp, p + 10, 4) + 4 in
    if hlit > 286 or hdist > 30 then
        ib_err(p, o, on, "too many length or distance codes")
    else if p + 14 + hclen * 3 > end then
        ib_err(p, o, on, "truncated data")
    else
        let cl = buf_new(38) in
        let a = ib_cl(bp, p + 14, cl, 0, hclen) in
        let ct = ih_table(cl, 19, 7) in
        if ct.left != 0 then
            ib_err(p, o, on, "bad code-length code")
        else
            let lens = buf_new((hlit + hdist) * 2) in
            let q = ib_lens(bp, p + 14 + hclen * 3, end, ct, lens, 0, hlit + hdist, 0) in
            if q < 0 then
                ib_err(p, o, on, if q == 0 - 2 then "repeat with no previous length" else if q == 0 - 3 then "code lengths overflow" else if q == 0 - 4 then "truncated data" else "bad code-length code")
            else
                ib_dyn2(bp, q, end, o, on, lens, hlit, hdist)
fn ib_dyn2(bp, q, end, o, on, lens, hlit, hdist) =
    let ll = buf_new(hlit * 2) in
    let c1 = buf_copy(ll, 0, lens, 0, hlit * 2) in
    let dl = buf_new(hdist * 2) in
    let c2 = buf_copy(dl, 0, lens, hlit * 2, hdist * 2) in
    if df_r16(ll, 256) == 0 then
        ib_err(q, o, on, "missing end-of-block code")
    else
        let lt = ih_table(ll, hlit, 10) in
        let dt = ih_table(dl, hdist, 10) in
        if not ih_ok(lt) then
            ib_err(q, o, on, "bad literal/length code lengths")
        else if not (ih_ok(dt) or dt.total == 0) then
            ib_err(q, o, on, "bad distance code lengths")
        else
            ib_huff(bp, q, end, o, on, lt, dt)
fn ib_cl(bp, p, cl, i, n) =
    if i >= n then
        0
    else
        let w = df_w16(cl, df_clorder(i), df_bits(bp, p + i * 3, 3)) in
        ib_cl(bp, p, cl, i + 1, n)
## the code lengths of the literal/length and distance codes: the new bit position, or < 0 on an error
fn ib_lens(bp, p, end, ct, lens, i, n, prev) =
    if i >= n then
        p
    else if p > end then
        0 - 4
    else
        let r = ih_dec(bp, p, ct) in
        let s = r % 512 in
        let q = r / 512 in
        if s < 16 then
            let w = df_w16(lens, i, s) in
            ib_lens(bp, q, end, ct, lens, i + 1, n, s)
        else if s == 16 then
            (if i == 0 then 0 - 2 else ib_rep(bp, q + 2, end, ct, lens, i, n, prev, 3 + df_bits(bp, q, 2)))
        else if s == 17 then
            ib_rep(bp, q + 3, end, ct, lens, i, n, 0, 3 + df_bits(bp, q, 3))
        else if s == 18 then
            ib_rep(bp, q + 7, end, ct, lens, i, n, 0, 11 + df_bits(bp, q, 7))
        else
            0 - 1
fn ib_rep(bp, p, end, ct, lens, i, n, v, k) =
    if i + k > n then
        0 - 3
    else
        let z = df_fill(lens, i, i + k, v) in
        ib_lens(bp, p, end, ct, lens, i + k, n, v)

## --- bit writer {o, n, acc, k}: n bytes written, k < 8 pending bits in acc between calls -----------------------------------
fn dw_new(cap) = {o: buf_new(cap), n: 0, acc: 0, k: 0}
fn dw_bits(w, v, k) = dw_norm(w.o, w.n, w.acc + bit_shl(v, w.k), w.k + k)
fn dw_norm(o, n, acc, k) =
    if k < 8 then
        {o: o, n: n, acc: acc, k: k}
    else
        let z = buf_set(o, n, acc % 256) in
        dw_norm(o, n + 1, acc / 256, k - 8)
fn dw_room(w, need) = {o: df_room(w.o, w.n, need + 16), n: w.n, acc: w.acc, k: w.k}
fn dw_end(w) = if w.k == 0 then w else let z = buf_set(w.o, w.n, w.acc % 256) in {o: w.o, n: w.n + 1, acc: 0, k: 0}
fn dw_rev(v, k, acc) = if k == 0 then acc else dw_rev(v / 2, k - 1, acc * 2 + v % 2)

## --- Huffman code lengths (limited) and canonical codes -----------------------------------------------------------------
fn hf_inc(f, i, k) = dz_w32(f, i, dz_r32(f, i) + k)
fn hf_used(f, i, n, k) = if i >= n then k else hf_used(f, i + 1, n, if dz_r32(f, i) > 0 then k + 1 else k)
fn hf_first(f, i, n) = if i >= n or dz_r32(f, i) > 0 then i else hf_first(f, i + 1, n)
## the code lengths (one byte per symbol) of n frequencies (32-bit words), none longer than limit: a Huffman tree by the
## two-queue method over the symbols sorted by frequency, then lengths over the limit clamped and the Kraft sum repaired
## (the longest codes go to the rarest symbols)
fn hf_lengths(f, n, limit) =
    let used = hf_used(f, 0, n, 0) in
    let lens = buf_new(n) in
    if used == 0 then
        let a = buf_set(lens, 0, 1) in
        buf_set(lens, 1, 1)
    else if used == 1 then
        let u = hf_first(f, 0, n) in
        let a = buf_set(lens, u, 1) in
        buf_set(lens, if u == 0 then 1 else 0, 1)
    else
        hf_build(f, n, limit, lens, used)
fn hf_keys(f, i, acc) = if i < 0 then acc else hf_keys(f, i - 1, if dz_r32(f, i) > 0 then Cons(dz_r32(f, i) * 1024 + i, acc) else acc)
fn ms_sort(xs, n) = if n <= 1 then xs else ms_merge(ms_sort(ms_take(xs, n / 2), n / 2), ms_sort(ms_drop(xs, n / 2), n - n / 2))
fn ms_take(xs, k) = match xs
    Nil        => Nil
    Cons(h, t) => if k == 0 then Nil else Cons(h, ms_take(t, k - 1))
fn ms_drop(xs, k) = match xs
    Nil        => Nil
    Cons(h, t) => if k == 0 then xs else ms_drop(t, k - 1)
fn ms_merge(a, b) = match a
    Nil         => b
    Cons(x, xt) => ms_merge1(x, xt, a, b)
fn ms_merge1(x, xt, a, b) = match b
    Nil         => a
    Cons(y, yt) => if x <= y then Cons(x, ms_merge(xt, b)) else Cons(y, ms_merge(a, yt))
fn hf_store(xs, lw, ls, j) = match xs
    Nil        => j
    Cons(h, t) => let a = dz_w32(lw, j, h / 1024) in let b = df_w16(ls, j, h % 1024) in hf_store(t, lw, ls, j + 1)
fn hf_build(f, n, limit, lens, m) =
    let lw = buf_new(m * 4) in
    let ls = buf_new(m * 2) in
    let a = hf_store(ms_sort(hf_keys(f, n - 1, Nil), m), lw, ls, 0) in
    let nw = buf_new(m * 4) in
    let lp = buf_new(m * 4) in
    let np = buf_new(m * 4) in
    let nk = hf_tq(lw, nw, lp, np, m, 0, 0, 0) in
    let nd = buf_new(m * 4) in
    let z = hf_ndepth(np, nd, nk - 2) in
    let bl = buf_new((limit + 2) * 4) in
    let y = hf_hist(lp, nd, bl, 0, m, limit) in
    let x = hf_fix(bl, limit, hf_total(bl, 1, limit, 0)) in
    hf_give(bl, ls, lens, 0, m, limit, dz_r32(bl, limit))
## 0 = take the next leaf, 1 = the next internal node (internal nodes are made in nondecreasing weight order)
fn hf_pick(lw, nw, m, li, ni, nk) = if li < m and (ni >= nk or dz_r32(lw, li) <= dz_r32(nw, ni)) then 0 else 1
fn hf_tq(lw, nw, lp, np, m, li, ni, nk) =
    if (m - li) + (nk - ni) <= 1 then
        nk
    else
        let p1 = hf_pick(lw, nw, m, li, ni, nk) in
        let w1 = if p1 == 0 then dz_r32(lw, li) else dz_r32(nw, ni) in
        let z1 = if p1 == 0 then dz_w32(lp, li, nk) else dz_w32(np, ni, nk) in
        let li1 = li + 1 - p1 in
        let ni1 = ni + p1 in
        let p2 = hf_pick(lw, nw, m, li1, ni1, nk) in
        let w2 = if p2 == 0 then dz_r32(lw, li1) else dz_r32(nw, ni1) in
        let z2 = if p2 == 0 then dz_w32(lp, li1, nk) else dz_w32(np, ni1, nk) in
        let z3 = dz_w32(nw, nk, w1 + w2) in
        hf_tq(lw, nw, lp, np, m, li1 + 1 - p2, ni1 + p2, nk + 1)
## depths of the internal nodes, root (the last one made) first
fn hf_ndepth(np, nd, t) = if t < 0 then 0 else let z = dz_w32(nd, t, dz_r32(nd, dz_r32(np, t)) + 1) in hf_ndepth(np, nd, t - 1)
fn hf_hist(lp, nd, bl, j, m, limit) =
    if j >= m then
        0
    else
        let d = dz_r32(nd, dz_r32(lp, j)) + 1 in
        let z = hf_inc(bl, if d > limit then limit else d, 1) in
        hf_hist(lp, nd, bl, j + 1, m, limit)
fn hf_total(bl, i, limit, acc) = if i > limit then acc else hf_total(bl, i + 1, limit, acc + dz_r32(bl, i) * bit_shl(1, limit - i))
fn hf_fix(bl, limit, total) =
    if total <= bit_shl(1, limit) then
        0
    else
        let a = hf_inc(bl, limit, 0 - 1) in
        let b = hf_fix1(bl, limit - 1) in
        hf_fix(bl, limit, total - 1)
fn hf_fix1(bl, i) =
    if i < 1 then
        0
    else if dz_r32(bl, i) > 0 then
        let a = hf_inc(bl, i, 0 - 1) in
        hf_inc(bl, i + 1, 2)
    else
        hf_fix1(bl, i - 1)
fn hf_give(bl, ls, lens, j, m, len, left) =
    if j >= m then
        lens
    else if left == 0 then
        hf_give(bl, ls, lens, j, m, len - 1, dz_r32(bl, len - 1))
    else
        let a = buf_set(lens, df_r16(ls, j), len) in
        hf_give(bl, ls, lens, j + 1, m, len, left - 1)
## canonical codes (RFC 1951 3.2.2) of n lengths: 32-bit words
fn hf_codes(lens, n) =
    let cnt = buf_new(16 * 4) in
    let a = hf_cnt(lens, cnt, 0, n) in
    let next = buf_new(16 * 4) in
    let b = hf_next(cnt, next, 1, 0) in
    hf_assign(lens, next, buf_new(n * 4), 0, n)
fn hf_cnt(lens, cnt, i, n) =
    if i >= n then
        0
    else
        let l = buf_get(lens, i) in
        let z = if l > 0 then hf_inc(cnt, l, 1) else 0 in
        hf_cnt(lens, cnt, i + 1, n)
fn hf_next(cnt, next, l, code) =
    if l > 15 then
        0
    else
        let c = (code + dz_r32(cnt, l - 1)) * 2 in
        let z = dz_w32(next, l, c) in
        hf_next(cnt, next, l + 1, c)
fn hf_assign(lens, next, codes, i, n) =
    if i >= n then
        codes
    else
        let l = buf_get(lens, i) in
        let z = if l > 0 then let c = dz_r32(next, l) in let y = dz_w32(codes, i, c) in dz_w32(next, l, c + 1) else 0 in
        hf_assign(lens, next, codes, i + 1, n)
## the codes bit-reversed for the LSB-first writer: 16-bit words
fn hf_rev(lens, n) = let c = hf_codes(lens, n) in hf_rev_go(lens, c, buf_new(n * 2), 0, n)
fn hf_rev_go(lens, c, r, i, n) = if i >= n then r else let z = df_w16(r, i, dw_rev(dz_r32(c, i), buf_get(lens, i), 0)) in hf_rev_go(lens, c, r, i + 1, n)
fn hf_cost(f, lens, i, n, acc) = if i >= n then acc else hf_cost(f, lens, i + 1, n, acc + dz_r32(f, i) * buf_get(lens, i))
fn hf_last(lens, i, lo) = if i < lo then lo else if buf_get(lens, i) > 0 then i + 1 else hf_last(lens, i - 1, lo)

## the code-length sequence run-length coded with 16 / 17 / 18 (as zlib): tokens [symbol, extra value] in a {b, n}
fn hr_run(a, i, n, v, k) = if i + k < n and buf_get(a, i + k) == v then hr_run(a, i, n, v, k + 1) else k
fn hr_rle(a, i, n, o, prev) =
    if i >= n then
        o
    else
        let v = buf_get(a, i) in
        let run = hr_run(a, i, n, v, 1) in
        if v == 0 and run >= 11 then
            let k = if run > 138 then 138 else run in
            hr_rle(a, i + k, n, df_put(df_put(o, 18), k - 11), 0)
        else if v == 0 and run >= 3 then
            hr_rle(a, i + run, n, df_put(df_put(o, 17), run - 3), 0)
        else if v != 0 and v == prev and run >= 3 then
            let k = if run > 6 then 6 else run in
            hr_rle(a, i + k, n, df_put(df_put(o, 16), k - 3), v)
        else
            hr_rle(a, i + 1, n, df_put(df_put(o, v), 0), v)
fn hr_ext(s) = if s == 16 then 2 else if s == 17 then 3 else if s == 18 then 7 else 0
fn hr_freqs(r, f, i) = if i >= r.n then f else let z = hf_inc(f, buf_get(r.b, i), 1) in hr_freqs(r, f, i + 2)
fn hr_bits(r, cl, i, acc) = if i >= r.n then acc else hr_bits(r, cl, i + 2, acc + buf_get(cl, buf_get(r.b, i)) + hr_ext(buf_get(r.b, i)))
fn hr_hclen(cl, k) = if k <= 4 then 4 else if buf_get(cl, df_clorder(k - 1)) > 0 then k else hr_hclen(cl, k - 1)

## --- deflate: zlib's parameters (good, lazy, nice, chain); levels 1-3 insert all match positions only for short matches
## and take the first match (deflate_fast), levels 4-9 evaluate lazily (deflate_slow) --------------------------------------
fn dl_cfg(level) =
    if level <= 1 then
        {good: 4, lazy: 4, nice: 8, chain: 4, fast: 1}
    else if level == 2 then
        {good: 4, lazy: 5, nice: 16, chain: 8, fast: 1}
    else if level == 3 then
        {good: 4, lazy: 6, nice: 32, chain: 32, fast: 1}
    else if level == 4 then
        {good: 4, lazy: 4, nice: 16, chain: 16, fast: 0}
    else if level == 5 then
        {good: 8, lazy: 16, nice: 32, chain: 32, fast: 0}
    else if level == 6 then
        {good: 8, lazy: 16, nice: 128, chain: 128, fast: 0}
    else if level == 7 then
        {good: 8, lazy: 32, nice: 128, chain: 256, fast: 0}
    else if level == 8 then
        {good: 32, lazy: 128, nice: 258, chain: 1024, fast: 0}
    else
        {good: 32, lazy: 258, nice: 258, chain: 4096, fast: 0}
## length - 3 -> length code (0..28); distance - 1 -> distance code through d < 256 ? t[d] : t[256 + d / 128] (zlib's)
fn dz_lcode() = dz_lfill(buf_new(256), 0)
fn dz_lfill(t, li) = if li > 28 then t else let z = dz_span(t, df_lbase(li) - 3, if li == 28 then 1 else bit_shl(1, df_lext(li)), li) in dz_lfill(t, li + 1)
fn dz_span(t, a, k, v) = if k == 0 or a > 255 then 0 else let z = buf_set(t, a, v) in dz_span(t, a + 1, k - 1, v)
fn dz_dcode() = dz_dfill(buf_new(512), 0)
fn dz_dfill(t, di) = if di > 29 then t else let z = dz_dspan(t, df_dbase(di) - 1, bit_shl(1, df_dext(di)), di) in dz_dfill(t, di + 1)
fn dz_dspan(t, d, k, v) = if k == 0 then 0 else let z = buf_set(t, if d < 256 then d else 256 + d / 128, v) in dz_dspan(t, d + 1, k - 1, v)
fn dz_di(st, d) = if d < 256 then buf_get(st.dcode, d) else buf_get(st.dcode, 256 + d / 128)
## head[h] keeps (position + 1) % 65536 of the last position with hash h (0 = none): a 16-bit entry names the one
## position within the last 64 KiB that wrote it. prev[i % 32768] keeps the distance from i back to the position before
## it with the same hash (0 = none or farther than 32768). Every candidate is checked against the window and its bytes
## compared, so an aliased entry can only cost time. Answers the candidate for i, or -1.
fn dz_ins(st, i) =
    let b = st.b in
    let h2 = ((buf_get(b, i) * 1024 + buf_get(b, i + 1) * 32 + buf_get(b, i + 2)) % 32768) * 2 in
    let hd = st.head in
    let s = buf_get(hd, h2) + buf_get(hd, h2 + 1) * 256 in
    let d = (i + 65537 - s) % 65536 in
    let dd = if s == 0 or d > 32768 or i - d < st.s then 0 else d in
    let p2 = (i % 32768) * 2 in
    let pv = st.prev in
    let a = buf_set(pv, p2, dd % 256) in
    let a2 = buf_set(pv, p2 + 1, dd / 256) in
    let i1 = (i + 1) % 65536 in
    let c = buf_set(hd, h2, i1 % 256) in
    let c2 = buf_set(hd, h2 + 1, i1 / 256) in
    if dd == 0 then 0 - 1 else i - dd
fn dz_mlen(b, x, y, k, max) = if k >= max or buf_get(b, x + k) != buf_get(b, y + k) then k else dz_mlen(b, x, y, k + 1, max)
## the longest match at i among the chain from c, longer than best: length * 65536 + distance (best, bd when none)
fn dz_longest(st, i, c, chain, best, bd, nice, max) =
    if c < 0 or chain == 0 then
        best * 65536 + bd
    else
        let b = st.b in
        let l = if buf_get(b, c + best) == buf_get(b, i + best) and buf_get(b, c) == buf_get(b, i) then dz_mlen(b, c, i, 1, max) else 0 in
        let p2 = (c % 32768) * 2 in
        let pv = st.prev in
        let s = buf_get(pv, p2) + buf_get(pv, p2 + 1) * 256 in
        let c2 = if s == 0 or i - c + s > 32768 then 0 - 1 else c - s in
        if l > best then
            (if l >= nice then l * 65536 + (i - c) else dz_longest(st, i, c2, chain - 1, l, i - c, nice, max))
        else
            dz_longest(st, i, c2, chain - 1, best, bd, nice, max)
fn dz_ins_range(st, i, e) = if i >= e or i + 2 >= st.e then 0 else let z = dz_ins(st, i) in dz_ins_range(st, i + 1, e)
## tokens, 3 bytes each: [literal, 0, 0] or [length - 3, distance (16 bits LE, 1..32768)]
fn dz_tlit(st, tn, v) =
    let a = buf_set(st.tk, tn * 3, v) in
    let b = buf_set(st.tk, tn * 3 + 1, 0) in
    let c = buf_set(st.tk, tn * 3 + 2, 0) in
    tn + 1
fn dz_tmatch(st, tn, len, dist) =
    let a = buf_set(st.tk, tn * 3, len - 3) in
    let b = buf_set(st.tk, tn * 3 + 1, dist % 256) in
    let c = buf_set(st.tk, tn * 3 + 2, dist / 256) in
    tn + 1
fn dz_min(a, b) = if a < b then a else b
## lazy evaluation (zlib's deflate_slow): a match at i - 1 of plen bytes is kept unless the match at i is longer
fn dz_slow(st, i, plen, pm, avail, tn, bs, w) =
    let e = st.e in
    if i >= e then
        dz_block(st, if avail == 1 then dz_tlit(st, tn, buf_get(st.b, i - 1)) else tn, bs, e, 1, w)
    else
        let c = if i + 2 < e then dz_ins(st, i) else 0 - 1 in
        let max = dz_min(e - i, 258) in
        let m = if c >= 0 and plen < st.lazy and plen < max then dz_longest(st, i, c, if plen >= st.good then st.chain / 4 else st.chain, plen, 0, dz_min(st.nice, max), max) else 2 * 65536 in
        let ml0 = m / 65536 in
        let md = m % 65536 in
        let ml = if ml0 == 3 and md > 4096 then 2 else ml0 in
        if plen >= 3 and ml <= plen then
            let tn1 = dz_tmatch(st, tn, plen, i - 1 - pm) in
            let z = dz_ins_range(st, i + 1, i + plen - 1) in
            let ni = i + plen - 1 in
            if tn1 >= 16383 then dz_slow(st, ni, 2, 0, 0, 0, ni, dz_block(st, tn1, bs, ni, 0, w)) else dz_slow(st, ni, 2, 0, 0, tn1, bs, w)
        else if avail == 1 then
            let tn1 = dz_tlit(st, tn, buf_get(st.b, i - 1)) in
            if tn1 >= 16383 then dz_slow(st, i + 1, ml, i - md, 1, 0, i, dz_block(st, tn1, bs, i, 0, w)) else dz_slow(st, i + 1, ml, i - md, 1, tn1, bs, w)
        else
            dz_slow(st, i + 1, ml, i - md, 1, tn, bs, w)
## greedy (zlib's deflate_fast): the first match is taken; its positions are hashed only when it is short
fn dz_fast(st, i, tn, bs, w) =
    let e = st.e in
    if i >= e then
        dz_block(st, tn, bs, e, 1, w)
    else
        let c = if i + 2 < e then dz_ins(st, i) else 0 - 1 in
        let max = dz_min(e - i, 258) in
        let m = if c >= 0 then dz_longest(st, i, c, st.chain, 2, 0, dz_min(st.nice, max), max) else 2 * 65536 in
        let ml = m / 65536 in
        if ml >= 3 then
            let tn1 = dz_tmatch(st, tn, ml, m % 65536) in
            let z = if ml <= st.lazy and e - (i + ml) >= 3 then dz_ins_range(st, i + 1, i + ml) else 0 in
            if tn1 >= 16383 then dz_fast(st, i + ml, 0, i + ml, dz_block(st, tn1, bs, i + ml, 0, w)) else dz_fast(st, i + ml, tn1, bs, w)
        else
            let tn1 = dz_tlit(st, tn, buf_get(st.b, i)) in
            if tn1 >= 16383 then dz_fast(st, i + 1, 0, i + 1, dz_block(st, tn1, bs, i + 1, 0, w)) else dz_fast(st, i + 1, tn1, bs, w)

## --- writing a block: the frequencies of its tokens, then the smallest of stored / fixed / dynamic -----------------------
fn dz_freqs(st, fl, fd, i, tn, extra) =
    if i >= tn then
        extra
    else
        let v = buf_get(st.tk, i * 3) in
        let dist = buf_get(st.tk, i * 3 + 1) + buf_get(st.tk, i * 3 + 2) * 256 in
        if dist == 0 then
            let z = hf_inc(fl, v, 1) in
            dz_freqs(st, fl, fd, i + 1, tn, extra)
        else
            let li = buf_get(st.lcode, v) in
            let di = dz_di(st, dist - 1) in
            let z1 = hf_inc(fl, 257 + li, 1) in
            let z2 = hf_inc(fd, di, 1) in
            dz_freqs(st, fl, fd, i + 1, tn, extra + df_lext(li) + df_dext(di))
fn hf_fixlen(s) = if s < 144 then 8 else if s < 256 then 9 else if s < 280 then 7 else 8
fn hf_fixcost(f, i, n, acc) = if i >= n then acc else hf_fixcost(f, i + 1, n, acc + dz_r32(f, i) * hf_fixlen(i))
fn dz_dsum(fd, i, acc) = if i >= 30 then acc else dz_dsum(fd, i + 1, acc + dz_r32(fd, i))
fn dz_block(st, tn, bs, be, last, w0) =
    let w = dw_room(w0, (be - bs) + (be - bs) / 8 + tn * 6 + 1024) in
    let fl = buf_new(286 * 4) in
    let fd = buf_new(30 * 4) in
    let extra = dz_freqs(st, fl, fd, 0, tn, 0) in
    let e = hf_inc(fl, 256, 1) in
    let ll = hf_lengths(fl, 286, 15) in
    let dl = hf_lengths(fd, 30, 15) in
    let hlit = hf_last(ll, 285, 257) in
    let hdist = hf_last(dl, 29, 1) in
    let all = buf_new(hlit + hdist) in
    let c1 = buf_copy(all, 0, ll, 0, hlit) in
    let c2 = buf_copy(all, hlit, dl, 0, hdist) in
    let r = hr_rle(all, 0, hlit + hdist, {b: buf_new(64), n: 0}, 0 - 1) in
    let cl = hf_lengths(hr_freqs(r, buf_new(19 * 4), 0), 19, 7) in
    let hclen = hr_hclen(cl, 19) in
    let dynbits = 17 + hclen * 3 + hr_bits(r, cl, 0, 0) + hf_cost(fl, ll, 0, 286, 0) + hf_cost(fd, dl, 0, 30, 0) + extra in
    let fixbits = 3 + hf_fixcost(fl, 0, 286, 0) + dz_dsum(fd, 0, 0) * 5 + extra in
    let n = be - bs in
    let storedbits = (n + 5 * (if n == 0 then 1 else (n + 65534) / 65535)) * 8 in
    if storedbits <= fixbits and storedbits <= dynbits then
        dw_stored(w, st.b, bs, be, last)
    else if fixbits <= dynbits then
        de_block(st, dw_bits(w, last + 2, 3), tn, st.fixc, st.fixl, st.fdc, st.fdl)
    else
        let w1 = dw_bits(dw_bits(dw_bits(dw_bits(w, last + 4, 3), hlit - 257, 5), hdist - 1, 5), hclen - 4, 4) in
        let w2 = dw_rle(dw_cls(w1, cl, 0, hclen), r, hf_rev(cl, 19), cl, 0) in
        de_block(st, w2, tn, hf_rev(ll, 286), ll, hf_rev(dl, 30), dl)
fn de_block(st, w, tn, lc, ll, dc, dl) =
    let w2 = de_toks(st, 0, tn, 0, w.o, w.n, w.acc, w.k, lc, ll, dc, dl) in
    let w3 = dw_norm(w2.o, w2.n, w2.acc, w2.k) in
    dw_bits(w3, df_r16(lc, 256), buf_get(ll, 256))
## the tokens: a match is written in two steps (length, then distance) so that at most 59 bits are pending
fn de_toks(st, i, tn, ph, o, n, acc, k, lc, ll, dc, dl) =
    if k >= 32 then
        let a = buf_set(o, n, acc % 256) in
        let b = buf_set(o, n + 1, (acc / 256) % 256) in
        let c = buf_set(o, n + 2, (acc / 65536) % 256) in
        let d = buf_set(o, n + 3, (acc / 16777216) % 256) in
        de_toks(st, i, tn, ph, o, n + 4, acc / 4294967296, k - 32, lc, ll, dc, dl)
    else if i >= tn then
        {o: o, n: n, acc: acc, k: k}
    else
        let v = buf_get(st.tk, i * 3) in
        let dist = buf_get(st.tk, i * 3 + 1) + buf_get(st.tk, i * 3 + 2) * 256 in
        if dist == 0 then
            de_toks(st, i + 1, tn, 0, o, n, acc + bit_shl(df_r16(lc, v), k), k + buf_get(ll, v), lc, ll, dc, dl)
        else if ph == 0 then
            let li = buf_get(st.lcode, v) in
            let s = 257 + li in
            let sl = buf_get(ll, s) in
            let x = df_r16(lc, s) + bit_shl(v + 3 - df_lbase(li), sl) in
            de_toks(st, i, tn, 1, o, n, acc + bit_shl(x, k), k + sl + df_lext(li), lc, ll, dc, dl)
        else
            let di = dz_di(st, dist - 1) in
            let sl = buf_get(dl, di) in
            let x = df_r16(dc, di) + bit_shl(dist - df_dbase(di), sl) in
            de_toks(st, i + 1, tn, 0, o, n, acc + bit_shl(x, k), k + sl + df_dext(di), lc, ll, dc, dl)
fn dw_sym(w, rc, lens, s) = dw_bits(w, df_r16(rc, s), buf_get(lens, s))
fn dw_cls(w, cl, i, k) = if i >= k then w else dw_cls(dw_bits(w, buf_get(cl, df_clorder(i)), 3), cl, i + 1, k)
fn dw_rle(w, r, cc, cl, i) =
    if i >= r.n then
        w
    else
        let s = buf_get(r.b, i) in
        dw_rle(dw_bits(dw_sym(w, cc, cl, s), buf_get(r.b, i + 1), hr_ext(s)), r, cc, cl, i + 2)
## stored blocks of up to 65535 bytes (one empty block for an empty range); the last one is final when last == 1
fn dw_stored(w, b, i, e, last) =
    let k = dz_min(e - i, 65535) in
    let fin = if i + k >= e then last else 0 in
    let w1 = dw_bits(w, fin, 3) in
    let w2 = if w1.k > 0 then dw_bits(w1, 0, 8 - w1.k) else w1 in
    let g = df_room(w2.o, w2.n, k + 8) in
    let a = buf_set(g, w2.n, k % 256) in
    let a2 = buf_set(g, w2.n + 1, k / 256) in
    let a3 = buf_set(g, w2.n + 2, (65535 - k) % 256) in
    let a4 = buf_set(g, w2.n + 3, (65535 - k) / 256) in
    let c = buf_copy(g, w2.n + 4, b, i, k) in
    let w3 = {o: g, n: w2.n + 4 + k, acc: 0, k: 0} in
    if i + k >= e then w3 else dw_stored(w3, b, i + k, e, last)
fn dz_fixed_lens() =
    let l = buf_new(288) in
    let a = dz_bfill(l, 0, 144, 8) in
    let b = dz_bfill(l, 144, 256, 9) in
    let c = dz_bfill(l, 256, 280, 7) in
    let d = dz_bfill(l, 280, 288, 8) in
    l
fn dz_bfill(l, i, e, v) = if i >= e then 0 else let w = buf_set(l, i, v) in dz_bfill(l, i + 1, e, v)
fn deflate_level(b, off, n, level) =
    if level <= 0 then
        let w = dw_stored(dw_new(n + n / 8 + 64), b, off, off + n, 1) in
        {buf: w.o, n: w.n}
    else
        let cfg = dl_cfg(level) in
        let fl = dz_fixed_lens() in
        let dl = buf_new(30) in
        let z = dz_bfill(dl, 0, 30, 5) in
        let st = {b: b, s: off, e: off + n, head: buf_new(32768 * 2), prev: buf_new(32768 * 2), tk: buf_new(16384 * 3), lcode: dz_lcode(), dcode: dz_dcode(), good: cfg.good, lazy: cfg.lazy, nice: cfg.nice, chain: cfg.chain, fixc: hf_rev(fl, 288), fixl: fl, fdc: hf_rev(dl, 30), fdl: dl} in
        let w0 = dw_new(n / 2 + 1024) in
        let w = if cfg.fast == 1 then dz_fast(st, off, 0, off, w0) else dz_slow(st, off, 2, 0, 0, 0, off, w0) in
        let w2 = dw_end(w) in
        {buf: w2.o, n: w2.n}
fn deflate_buf(b, off, n) = deflate_level(b, off, n, 6)

## --- zlib and gzip wrappers -----------------------------------------------------------------------------------------
fn df_be32(b, i) = buf_get(b, i) * 16777216 + buf_get(b, i + 1) * 65536 + buf_get(b, i + 2) * 256 + buf_get(b, i + 3)
fn df_le32(b, i) = buf_get(b, i) + buf_get(b, i + 1) * 256 + buf_get(b, i + 2) * 65536 + buf_get(b, i + 3) * 16777216
fn zlib_decompress(b, n) =
    if n < 6 then
        df_bad("truncated zlib data")
    else
        let cmf = buf_get(b, 0) in
        let flg = buf_get(b, 1) in
        if cmf % 16 != 8 or cmf / 16 > 7 or (cmf * 256 + flg) % 31 != 0 then
            df_bad("not zlib data")
        else if bit_and(flg, 32) != 0 then
            df_bad("zlib preset dictionary not supported")
        else
            let r = inflate_buf(b, 2, n - 2) in
            if r.ok == 0 then
                r
            else if r.next + 4 > n then
                df_bad("truncated zlib trailer")
            else if df_be32(b, r.next) != adler32_buf(r.buf, 0, r.n) then
                df_bad("zlib Adler-32 mismatch")
            else
                r
fn df_bytes(o, v, k) = if k == 0 then o else df_bytes(df_put(o, v % 256), v / 256, k - 1)
fn df_bytes_be(o, v) = df_put(df_put(df_put(df_put(o, (v / 16777216) % 256), (v / 65536) % 256), (v / 256) % 256), v % 256)
## FLEVEL in the header: 0 fastest (1), 1 fast (2-5), 2 default (6), 3 maximum (7-9); 0x78 = deflate, 32 KiB window
fn zlib_compress_level(b, n, level) =
    let d = deflate_level(b, 0, n, level) in
    let flg = if level <= 1 then 1 else if level <= 5 then 94 else if level == 6 then 156 else 218 in
    let o = df_cat(df_put(df_put({b: buf_new(d.n + 16), n: 0}, 120), flg), d.buf, d.n) in
    let f = df_bytes_be(o, adler32_buf(b, 0, n)) in
    {buf: f.b, n: f.n}
fn zlib_compress(b, n) = zlib_compress_level(b, n, 6)
fn df_skipz(b, i, n) = if i >= n then n else if buf_get(b, i) == 0 then i + 1 else df_skipz(b, i + 1, n)
fn gunzip(b, n) =
    if n < 18 or buf_get(b, 0) != 31 or buf_get(b, 1) != 139 or buf_get(b, 2) != 8 then
        df_bad("not gzip data")
    else
        let flg = buf_get(b, 3) in
        let i1 = if bit_and(flg, 4) != 0 then 12 + buf_get(b, 10) + buf_get(b, 11) * 256 else 10 in
        let i2 = if bit_and(flg, 8) != 0 then df_skipz(b, i1, n) else i1 in
        let i3 = if bit_and(flg, 16) != 0 then df_skipz(b, i2, n) else i2 in
        let i4 = if bit_and(flg, 2) != 0 then i3 + 2 else i3 in
        if i4 >= n then
            df_bad("truncated gzip header")
        else
            let r = inflate_buf(b, i4, n - i4) in
            if r.ok == 0 then
                r
            else if r.next + 8 > n then
                df_bad("truncated gzip trailer")
            else if df_le32(b, r.next) != crc32_buf(r.buf, 0, r.n) then
                df_bad("gzip CRC-32 mismatch")
            else if df_le32(b, r.next + 4) != r.n % 4294967296 then
                df_bad("gzip size mismatch")
            else
                r
## XFL 2 = maximum compression (level 9), 4 = fastest (level 1); OS 255 = unknown
fn gzip_level(b, n, level) =
    let d = deflate_level(b, 0, n, level) in
    let h = df_put(df_put(df_bytes(df_put(df_put(df_put(df_put({b: buf_new(d.n + 32), n: 0}, 31), 139), 8), 0), 0, 4), if level >= 9 then 2 else if level <= 1 then 4 else 0), 255) in
    let o = df_cat(h, d.buf, d.n) in
    let f = df_bytes(df_bytes(o, crc32_buf(b, 0, n), 4), n % 4294967296, 4) in
    {buf: f.b, n: f.n}
fn gzip(b, n) = gzip_level(b, n, 6)
fn gzip_str(s) = let b = buf_from_str(s) in let g = gzip(b, buf_len(b)) in buf_to_str(g.buf, 0, g.n)
fn gunzip_str(s) =
    let b = buf_from_str(s) in
    let r = gunzip(b, buf_len(b)) in
    if r.ok == 0 then
        ctfail("gunzip: " + r.err + "\n")
    else
        buf_to_str(r.buf, 0, r.n)
