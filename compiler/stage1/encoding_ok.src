## encoding_ok.src -- `use std/encoding`: hex and base64 (RFC 4648 section 10 vectors, base64url, strict padding and
## trailing bits, MIME white space, every byte value round trip)
use encoding

fn allbytes(i, acc) = if i < 0 then acc else allbytes(i - 1, chr(i) + acc)
fn dec(t) = (base64_decode(t)).bytes
fn bad(t) = (base64_decode(t)).ok == false
fn test_hex() = hex_encode("") == "" and hex_encode("Az" + chr(0) + chr(255)) == "417a00ff" and (hex_decode("417A00ff")).bytes == "Az" + chr(0) + chr(255) and (hex_decode("abc")).ok == false and (hex_decode("zz")).ok == false and (hex_decode("")).ok
fn test_hex_all_bytes() = let s = allbytes(255, "") in (hex_decode(hex_encode(s))).bytes == s and count(hex_encode(s)) == 512
## RFC 4648 section 10
fn test_base64_rfc4648() = base64_encode("") == "" and base64_encode("f") == "Zg==" and base64_encode("fo") == "Zm8=" and base64_encode("foo") == "Zm9v" and base64_encode("foob") == "Zm9vYg==" and base64_encode("fooba") == "Zm9vYmE=" and base64_encode("foobar") == "Zm9vYmFy"
fn test_base64_decode_rfc4648() = dec("") == "" and dec("Zg==") == "f" and dec("Zm8=") == "fo" and dec("Zm9v") == "foo" and dec("Zm9vYg==") == "foob" and dec("Zm9vYmE=") == "fooba" and dec("Zm9vYmFy") == "foobar"
fn test_base64_alphabets() = base64_encode(chr(251) + chr(255) + chr(191)) == "+/+/" and base64url_encode(chr(251) + chr(255) + chr(191)) == "-_-_" and base64url_encode("f") == "Zg" and (base64url_decode("Zg")).bytes == "f" and (base64url_decode("Zg==")).bytes == "f" and (base64url_decode("-_-_")).bytes == chr(251) + chr(255) + chr(191) and (base64url_decode("+/+/")).ok == false and bad("-_-_")
fn test_base64_strict() = bad("Zg") and bad("Zg=") and bad("Zm9v=") and bad("Z===") and bad("Zm9 v") and bad("Zm=v") and bad("Zh==") and bad("Zm9=") and (base64_decode("Zm8=")).ok and bad("Zm9vY") and (base64url_decode("Zm9vY")).ok == false
fn test_base64_mime() = (base64_decode_mime("Zm9v" + chr(13) + chr(10) + "YmFy" + chr(10) + " ")).bytes == "foobar" and bad("Zm9v" + chr(10) + "YmFy")
fn test_base64_all_bytes() = let s = allbytes(255, "") in dec(base64_encode(s)) == s and (base64url_decode(base64url_encode(s))).bytes == s and dec(base64_encode(slice(s, 0, 254))) == slice(s, 0, 254) and dec(base64_encode(slice(s, 0, 253))) == slice(s, 0, 253)
