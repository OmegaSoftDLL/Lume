## process_probe.src -- child-process fixture for the `std.process` conformance
## tests (issue #406). Built by bootstrap/lume0/tests/run.sh with lumec+lasm; its
## path reaches the tests through the `process_probe_path` file (same indirection
## as os_run_probe_path for os_run_ok.src).
## Modes via argv[1]:
##   "stdin"  -> echo one stdin line as "probe-echo:<line>" on stdout
##   "exit7"  -> exit with status 7 and produce no output
##   anything else (including "") -> stdout marker "probe-out:<arg>" and stderr
##                marker "probe-err:<arg>" (stderr via /dev/stderr, the same
##                mechanism lume_driver uses for check success diagnostics)

fn probe_stderr(arg1) = fs_write_sync("/dev/stderr", "probe-err:" + arg1 + "\n")

fn probe_main(arg1) = if arg1 == "stdin" then printval("probe-echo:" + read()) else if arg1 == "exit7" then os_exit(7) else let w = probe_stderr(arg1) in printval("probe-out:" + arg1)

probe_main(os_arg_at(1))
