## par_ok.src - `use par` and buf_shared: workers write into a shared buffer, the parent sees every byte
use par

fn fill(b, i, e, v) = if i >= e then 0 else (let s = buf_set(b, i, v) in fill(b, i + 1, e, v))
fn sumb(b, i, e, acc) = if i >= e then acc else sumb(b, i + 1, e, acc + buf_get(b, i))

fn test_shared_buffer_is_zero_and_sized() = let b = buf_shared(4096) in buf_len(b) == 4096 and sumb(b, 0, 4096, 0) == 0

fn test_child_writes_are_seen() = let b = buf_shared(64) in let pid = os_fork() in let r = (if pid == 0 then (let s = buf_set(b, 7, 42) in os_exit(0)) else os_waitpid(pid)) in buf_get(b, 7) == 42

fn test_pool_slices_cover_buffer() = let n = 100000 in let b = buf_shared(n) in let pool = par_pool(4, fn(k, job) => fill(b, par_slice(k, 4, n), par_slice(k + 1, 4, n), job + k) + 1) in let a = par_run(pool, 10) in let s1 = sumb(b, 0, n, 0) in let c = par_run(pool, 20) in let s2 = sumb(b, 0, n, 0) in let d = par_close(pool) in a == 4 and c == 4 and d == 4 and s1 == 25000 * (10 + 11 + 12 + 13) and s2 == 25000 * (20 + 21 + 22 + 23)

fn test_answers_are_summed() = let pool = par_pool(3, fn(k, job) => job * 10 + k) in let r = par_run(pool, 5) in let d = par_close(pool) in r == 150 + 3

fn test_slices_partition() = par_slice(0, 3, 10) == 0 and par_slice(1, 3, 10) == 3 and par_slice(2, 3, 10) == 6 and par_slice(3, 3, 10) == 10

fn test_shared_buffer_survives_collections() = let b = buf_shared(16) in let s = buf_set(b, 3, 9) in let g = churn(200000, 0) in buf_get(b, 3) == 9 and g > 0
fn churn(n, acc) = if n == 0 then acc else churn(n - 1, acc + count(str(n) + "x"))
