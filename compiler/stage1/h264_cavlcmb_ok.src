## h264_cavlcmb_ok.src -- buf_h264_cavlc_luma / buf_h264_cavlc_chroma (the residual of a whole macroblock) against the
## same blocks coded one by one with buf_h264_cavlc6, nC computed here from 9.2.1 and the order of 7.3.5.3.
## `lume test compiler/stage1/h264_cavlcmb_ok.src`

fn w32(b, o, v) = let u = if v < 0 then v + 4294967296 else v in let a = buf_set(b, o, u % 256) in let c = buf_set(b, o + 1, (u / 256) % 256) in let d = buf_set(b, o + 2, (u / 65536) % 256) in buf_set(b, o + 3, u / 16777216)
fn put16(b, o, v) = let u = if v < 0 then v + 65536 else v in let x = buf_set(b, o, u % 256) in buf_set(b, o + 1, u / 256)
fn setb(b, o, xs, i) = match xs
    Nil        => b
    Cons(h, t) => let w = buf_set(b, o + i, h) in setb(b, o, t, i + 1)

## levels: mostly zero, a few small values, a seed per block (the shapes CAVLC sees in practice)
fn lv(seed, k) = let v = (seed * 7919 + k * 104729 + seed * k * 13) % 23 in if v < 14 then 0 else if v < 18 then 1 else if v < 20 then 0 - 1 else if v < 21 then 2 else if v < 22 then 0 - 3 else 5
fn fill_blk(b, o, seed, n, k) = if k >= n then b else let w = put16(b, o + k * 2, lv(seed, k)) in fill_blk(b, o, seed, n, k + 1)
fn fill_all(b, o, seed, n, i) = if i >= 16 then b else let w = fill_blk(b, o + i * 32, seed + i, n, 0) in fill_all(b, o, seed, n, i + 1)

fn bx(b) = 4 * (b % 2 + 2 * ((b / 4) % 2))
fn by(b) = 4 * ((b / 2) % 2 + 2 * ((b / 8) % 2))
fn bidx(x, y) = ((y / 8) * 2 + x / 8) * 4 + ((y / 4) % 2) * 2 + (x / 4) % 2
fn ncv(a, b) = if a != 255 and b != 255 then (a + b + 1) / 2 else if a != 255 then a else if b != 255 then b else 0
## tots: the TotalCoeff of the blocks so far (a 16-byte buffer), left / top: the neighbour macroblocks' lists
fn lnc(tots, left, top, b) = ncv(if bx(b) > 0 then buf_get(tots, bidx(bx(b) - 4, by(b))) else buf_get(left, by(b) / 4), if by(b) > 0 then buf_get(tots, bidx(bx(b), by(b) - 4)) else buf_get(top, bx(b) / 4))
fn ref_luma(lev, base, mode, cbp, left, top, out, pos, tots, b) = if b >= 16 then pos else if (cbp / pow2(b / 4)) % 2 == 0 then (let w = buf_set(tots, b, 0) in ref_luma(lev, base, mode, cbp, left, top, out, pos, tots, b + 1)) else let r = buf_h264_cavlc6(lev, base + b * 32 + (if mode == 1 then 2 else 0), lnc(tots, left, top, b), if mode == 1 then 15 else 16, out, pos) in let w = buf_set(tots, b, r % 32) in ref_luma(lev, base, mode, cbp, left, top, out, r / 32, tots, b + 1)
fn pow2(k) = if k == 0 then 1 else 2 * pow2(k - 1)

fn luma_ctx(mode, cbp, base, dco, left, top) = let c = buf_new(64) in let a = w32(c, 0, mode) in let b = w32(c, 4, cbp) in let d = w32(c, 8, base) in let e = w32(c, 12, dco) in let f = setb(c, 16, left, 0) in setb(c, 20, top, 0)
fn same_bits(a, b, n, i) = if i >= n then true else if buf_get(a, i) != buf_get(b, i) then false else same_bits(a, b, n, i + 1)
fn same_tots(ctx, tots, o, n, i) = if i >= n then true else if buf_get(ctx, 32 + i) != buf_get(tots, o + i) then false else same_tots(ctx, tots, o, n, i + 1)

fn check_luma(mode, cbp, seed, left, top) = let lev = buf_new(640) in let z = fill_all(lev, 96, seed, if mode == 1 then 16 else 16, 0) in let d = fill_blk(lev, 24, seed + 99, 16, 0) in let ctx = luma_ctx(mode, cbp, 96, 24, left, top) in let out1 = buf_new(1024) in let out2 = buf_new(1024) in let got = buf_h264_cavlc_luma(lev, ctx, out1, 5) in let tots = buf_new(16) in let lb = setb(buf_new(4), 0, left, 0) in let tb = setb(buf_new(4), 0, top, 0) in let p0 = (if mode == 1 then buf_h264_cavlc6(lev, 24, lnc(tots, lb, tb, 0), 16, out2, 5) / 32 else 5) in let want = ref_luma(lev, 96, mode, cbp, lb, tb, out2, p0, tots, 0) in got == want and same_bits(out1, out2, 1024, 0) and same_tots(ctx, tots, 0, 16, 0)
## chroma: the outputs of buf_h264_mb_pc at two bases (Cb 0, Cr 256)
fn ref_cac(lev, base, po, left, top, out, pos, tots, k) = if k >= 4 then pos else let a = if k % 2 == 1 then buf_get(tots, po * 2 + k - 1) else buf_get(left, po + k / 2) in let b = if k >= 2 then buf_get(tots, po * 2 + k - 2) else buf_get(top, po + k % 2) in let r = buf_h264_cavlc6(lev, base + 64 + k * 32 + 2, ncv(a, b), 15, out, pos) in let w = buf_set(tots, po * 2 + k, r % 32) in ref_cac(lev, base, po, left, top, out, r / 32, tots, k + 1)
fn ref_chroma(lev, cbp, left, top, out, pos, tots) = if cbp == 0 then pos else let d1 = buf_h264_cavlc6(lev, 48, 0 - 1, 4, out, pos) / 32 in let d2 = buf_h264_cavlc6(lev, 256 + 48, 0 - 1, 4, out, d1) / 32 in if cbp == 1 then d2 else ref_cac(lev, 256, 2, left, top, out, ref_cac(lev, 0, 0, left, top, out, d2, tots, 0), tots, 0)
fn check_chroma(cbp, seed, left, top) = let lev = buf_new(512) in let a = fill_blk(lev, 48, seed, 4, 0) in let b = fill_blk(lev, 304, seed + 5, 4, 0) in let c = fill_all4(lev, 64, seed + 9, 0) in let d = fill_all4(lev, 320, seed + 13, 0) in let ctx = buf_new(64) in let e = w32(ctx, 0, cbp) in let f = w32(ctx, 4, 0) in let g = w32(ctx, 8, 256) in let h = setb(ctx, 16, left, 0) in let i = setb(ctx, 20, top, 0) in let out1 = buf_new(512) in let out2 = buf_new(512) in let got = buf_h264_cavlc_chroma(lev, ctx, out1, 3) in let tots = buf_new(8) in let want = ref_chroma(lev, cbp, setb(buf_new(4), 0, left, 0), setb(buf_new(4), 0, top, 0), out2, 3, tots) in got == want and same_bits(out1, out2, 512, 0) and same_tots(ctx, tots, 0, 8, 0)
fn fill_all4(b, o, seed, i) = if i >= 4 then b else let w = fill_blk(b, o + i * 32 + 2, seed + i, 15, 0) in fill_all4(b, o, seed, i + 1)

fn test_luma_4x4_all_quadrants() = check_luma(0, 15, 1, [3, 0, 7, 2], [1, 1, 0, 5]) and check_luma(0, 15, 7, [255, 255, 255, 255], [255, 255, 255, 255])
fn test_luma_some_quadrants_and_none() = check_luma(0, 5, 3, [2, 2, 2, 2], [255, 255, 255, 255]) and check_luma(0, 10, 4, [255, 255, 255, 255], [4, 0, 9, 1]) and check_luma(0, 0, 5, [1, 1, 1, 1], [1, 1, 1, 1])
fn test_luma_intra16x16() = check_luma(1, 15, 11, [0, 3, 6, 1], [2, 255, 4, 4]) and check_luma(1, 0, 12, [255, 255, 255, 255], [3, 3, 3, 3])
fn test_chroma_dc_and_ac() = check_chroma(2, 1, [1, 2, 0, 4], [3, 0, 1, 1]) and check_chroma(2, 8, [255, 255, 255, 255], [255, 255, 255, 255]) and check_chroma(1, 4, [1, 1, 1, 1], [1, 1, 1, 1]) and check_chroma(0, 2, [1, 1, 1, 1], [1, 1, 1, 1])
fn test_full_buffer_and_wrong_arguments() = let lev = fill_all(buf_new(640), 96, 1, 16, 0) in buf_h264_cavlc_luma(lev, luma_ctx(0, 15, 96, 0, [0, 0, 0, 0], [0, 0, 0, 0]), buf_new(2), 0) == 0 - 1 and buf_h264_cavlc_luma(lev, buf_new(10), buf_new(64), 0) == 0 - 1 and buf_h264_cavlc_luma(lev, luma_ctx(2, 15, 96, 0, [0, 0, 0, 0], [0, 0, 0, 0]), buf_new(64), 0) == 0 - 1 and buf_h264_cavlc_chroma(lev, buf_new(10), buf_new(64), 0) == 0 - 1
