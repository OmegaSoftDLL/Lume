## fs_stream_ok.src -- fs_read_file on a file whose size the system reports as 0 (/proc, /sys) reads it to end of
## file (it used to read ""). Linux only (other systems have no /proc): the tests pass trivially elsewhere.
fn linux() = os_platform() == "linux"
fn has(s, part, i) = if i + count(part) > count(s) then 0 else if slice(s, i, i + count(part)) == part then 1 else has(s, part, i + 1)
fn test_proc_self_status_is_read() = if linux() then has(fs_read_file("/proc/self/status"), "Name:", 0) == 1 else 1
fn test_proc_loadavg_is_read() = if linux() then count(fs_read_file("/proc/loadavg")) > 10 else 1
fn test_proc_large_file_is_read_whole() = if linux() then count(fs_read_file("/proc/self/maps")) > 100 else 1
fn test_regular_file_unchanged() = let w = fs_write_sync("fs_stream_probe", "abc" + chr(0) + "def") in let r = fs_read_file("fs_stream_probe") in let z = fs_remove("fs_stream_probe") in w == 1 and r == "abc" + chr(0) + "def"
