## f64_ok.src -- IEEE 754 doubles (builtins, no `use`): f64(...) from an int, a decimal, an f64 or text; + - * / and
## comparisons, an int operand converted; str/print give the shortest text that reads back to the same double;
## f64_str with fixed decimals; floor, ceil, round (half away from zero), int (toward zero); sqrt, sin, cos, tan,
## atan2, exp, log, log10, pow; NaN, infinities, -0.0; the 64 bits.

fn near(a, b) = f64_abs(a - b) < f64("1e-12")
fn avg(a, b) = (a + b) / 2

fn test_from_values() = str(f64(3)) == "3.0" and str(f64(1.5)) == "1.5" and str(f64("2.25")) == "2.25" and str(f64("-1e3")) == "-1000.0" and str(f64(f64(7))) == "7.0" and str(f64(0 - 0.125)) == "-0.125"
fn test_arith() = str(f64(1.5) + f64(2.25)) == "3.75" and str(f64(10) / 4) == "2.5" and str(f64(3) * 2) == "6.0" and str(1 - f64(0.5)) == "0.5" and str(f64(7) - 10) == "-3.0"
fn test_shortest_text() = str(f64("0.1") + f64("0.2")) == "0.30000000000000004" and str(f64("0.1")) == "0.1" and str(f64(1) / 3) == "0.3333333333333333" and str(f64("1e21")) == "1.0e21" and str(f64("1.5e-7")) == "1.5e-7" and str(f64("123456789012345680")) == "1.2345678901234568e17" and str(f64("0.00001")) == "0.00001" and str(f64("1e15")) == "1000000000000000.0"
fn test_round_trip() = let x = f64(2) / 3 in f64(str(x)) == x and f64(str(f64("5e-324"))) == f64("5e-324") and str(f64("5e-324")) == "5.0e-324" and str(f64("1.7976931348623157e308")) == "1.7976931348623157e308" and str(f64("2.2250738585072014e-308")) == "2.2250738585072014e-308"
fn test_compare() = f64(1.5) < f64(2) and f64(2) > 1 and f64(2) <= 2 and 3 >= f64(2.5) and f64(0.5) == f64("0.5") and f64(1) != f64(2)
fn test_fixed_decimals() = f64_str(f64(3.14159), 2) == "3.14" and f64_str(f64(2), 3) == "2.000" and f64_str(f64("-2.5678"), 2) == "-2.57" and f64_str(f64("0.007"), 2) == "0.01" and f64_str(f64(42), 0) == "42" and f64_str(f64("inf"), 2) == "inf"
fn test_round_family() = str(f64_floor(f64("-1.5"))) == "-2.0" and str(f64_ceil(f64("1.2"))) == "2.0" and str(f64_round(f64("2.5"))) == "3.0" and str(f64_round(f64("-2.5"))) == "-3.0" and str(f64_round(f64("2.4"))) == "2.0" and f64_int(f64("-3.9")) == 0 - 3 and f64_int(f64("1e15")) == 1000000000000000
fn test_math() = str(f64_sqrt(f64(2))) == "1.4142135623730951" and near(f64_sin(f64(0)), f64(0)) and near(f64_cos(f64(0)), f64(1)) and near(f64_tan(f64("0.7853981633974483")), f64(1)) and near(f64_atan2(f64(1), f64(1)) * 4, f64("3.141592653589793")) and near(f64_exp(f64(1)), f64("2.718281828459045")) and near(f64_log(f64_exp(f64(2))), f64(2)) and near(f64_log10(f64(1000)), f64(3)) and str(f64_pow(f64(2), f64(10))) == "1024.0" and str(f64_pow(f64(0 - 2), f64(3))) == "-8.0" and near(f64_pow(f64(9), f64("0.5")), f64(3))
fn test_special_values() = str(f64("inf")) == "inf" and str(f64("-inf")) == "-inf" and str(f64(1) / f64(0)) == "inf" and f64_is_nan(f64("nan")) == 1 and f64_is_nan(f64(0) / f64(0)) == 1 and f64_is_nan(f64(1)) == 0 and str(f64("-0")) == "-0.0" and str(f64_exp(f64("-inf"))) == "0.0" and str(f64_log(f64(0))) == "-inf" and str(f64_pow(f64(0), f64(0 - 1))) == "inf" and str(f64("nan")) == "nan"
fn test_bits() = f64_bits(f64(1)) == 4607182418800017408 and f64_from_bits(4607182418800017408) == f64(1) and str(f64_from_bits(0 - 9223372036854775807 - 1)) == "-0.0"
fn test_text_and_functions() = "x=" + str(f64(0.25)) == "x=0.25" and "y=" + str(f64(0.75)) == "y=0.75" and avg(f64(1), f64(2)) == f64(1.5) and str(avg(f64(1), 2)) == "1.5"

print f64(1) / 3
print [f64(1.5), f64(2), f64("1e100")]
