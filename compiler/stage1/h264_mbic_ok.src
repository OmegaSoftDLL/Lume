## h264_mbic_ok.src -- buf_h264_mb_ic (intra chroma of a macroblock, both planes, one mode) against the same coded
## here: the chroma predictions of 8.3.4 (DC per 4x4 block with its neighbour rules, horizontal, vertical, plane)
## and the mode of least SATD(Cb) + SATD(Cr) written from the formulas, then each plane through the block builtins
## (intra rounding) and the 2x2 DC path of 8.5.11. `lume test compiler/stage1/h264_mbic_ok.src`
use seq

fn w32(b, o, v) = let u = if v < 0 then v + 4294967296 else v in let a = buf_set(b, o, u % 256) in let c = buf_set(b, o + 1, (u / 256) % 256) in let d = buf_set(b, o + 2, (u / 65536) % 256) in buf_set(b, o + 3, u / 16777216)
fn rd32(b, o) = let u = buf_get(b, o) + 256 * buf_get(b, o + 1) + 65536 * buf_get(b, o + 2) + 16777216 * buf_get(b, o + 3) in if u >= 2147483648 then u - 4294967296 else u
fn get16(b, o) = let v = buf_get(b, o) + 256 * buf_get(b, o + 1) in if v >= 32768 then v - 65536 else v
fn put16(b, o, v) = let u = if v < 0 then v + 65536 else v in let x = buf_set(b, o, u % 256) in buf_set(b, o + 1, u / 256)

fn pix(x, y, k) = if (x / 3 + y / 5 + k) % 7 == 0 then 200 else if y % 8 < 1 then 60 else 64 + (x * 5 + y * 3 + k * 11) % 120
fn smooth(x, y, k) = 70 + (x * 4 + y * 3 + k) % 90
fn fillpic(b, w, h, k, sm, i) = if i >= w * h then b else let q = buf_set(b, i, if sm then smooth(i % w, i / w, k) else pix(i % w, i / w, k)) in fillpic(b, w, h, k, sm, i + 1)
fn pic(w, h, k, sm) = fillpic(buf_new(w * h), w, h, k, sm, 0)
fn cfg_new(rs, ss, qy, off, si, ri, av, flags) = let c = buf_new(1344) in let a = w32(c, 0, rs) in let b = w32(c, 4, ss) in let d = w32(c, 8, qy) in let e = w32(c, 12, off) in let f = w32(c, 16, si) in let g = w32(c, 20, ri) in let h = w32(c, 24, av) in let i = w32(c, 28, flags) in c

## --- predictions (8.3.4) ----------------------------------------------------------------------------------------------
fn has(m, k) = (m / k) % 2 == 1
fn clip(v) = if v < 0 then 0 else if v > 255 then 255 else v
fn fl(v, d) = if v >= 0 then v / d else 0 - ((0 - v + d - 1) / d)
fn top(r, ri, rs, i) = buf_get(r, ri - rs + i)
fn left(r, ri, rs, j) = buf_get(r, ri + j * rs - 1)
fn st(r, ri, rs, x0) = top(r, ri, rs, x0) + top(r, ri, rs, x0 + 1) + top(r, ri, rs, x0 + 2) + top(r, ri, rs, x0 + 3)
fn sl(r, ri, rs, y0) = left(r, ri, rs, y0) + left(r, ri, rs, y0 + 1) + left(r, ri, rs, y0 + 2) + left(r, ri, rs, y0 + 3)
fn dcblk(r, ri, rs, k, av) = let x0 = (k % 2) * 4 in let y0 = (k / 2) * 4 in let t = has(av, 2) in let l = has(av, 1) in if (x0 == 0 and y0 == 0) or (x0 > 0 and y0 > 0) then (if t and l then (st(r, ri, rs, x0) + sl(r, ri, rs, y0) + 4) / 8 else if l then (sl(r, ri, rs, y0) + 2) / 4 else if t then (st(r, ri, rs, x0) + 2) / 4 else 128) else if x0 > 0 then (if t then (st(r, ri, rs, x0) + 2) / 4 else if l then (sl(r, ri, rs, y0) + 2) / 4 else 128) else (if l then (sl(r, ri, rs, y0) + 2) / 4 else if t then (st(r, ri, rs, x0) + 2) / 4 else 128)
fn hsum(r, ri, rs, k) = if k >= 4 then 0 else (k + 1) * (top(r, ri, rs, 4 + k) - top(r, ri, rs, 2 - k)) + hsum(r, ri, rs, k + 1)
fn vsum(r, ri, rs, k) = if k >= 4 then 0 else (k + 1) * (left(r, ri, rs, 4 + k) - left(r, ri, rs, 2 - k)) + vsum(r, ri, rs, k + 1)
fn predv(r, ri, rs, m, av, x, y) = if m == 0 then dcblk(r, ri, rs, (y / 4) * 2 + x / 4, av) else if m == 1 then left(r, ri, rs, y) else if m == 2 then top(r, ri, rs, x) else let a = 16 * (left(r, ri, rs, 7) + top(r, ri, rs, 7)) in let b = fl(34 * hsum(r, ri, rs, 0) + 32, 64) in let c = fl(34 * vsum(r, ri, rs, 0) + 32, 64) in clip(fl(a + b * (x - 3) + c * (y - 3) + 16, 32))
fn pred(r, ri, rs, m, av) = pfill(r, ri, rs, m, av, buf_new(64), 0)
fn pfill(r, ri, rs, m, av, p, i) = if i >= 64 then p else let w = buf_set(p, i, predv(r, ri, rs, m, av, i % 8, i / 8)) in pfill(r, ri, rs, m, av, p, i + 1)
fn mok(m, av) = if m == 0 then true else if m == 1 then has(av, 1) else if m == 2 then has(av, 2) else has(av, 1) and has(av, 2) and has(av, 8)
fn satd8(src, si, ss, p) = buf_satd4x4(src, si, ss, p, 0, 8) + buf_satd4x4(src, si + 4, ss, p, 4, 8) + buf_satd4x4(src, si + 4 * ss, ss, p, 32, 8) + buf_satd4x4(src, si + 4 * ss + 4, ss, p, 36, 8)
fn best(su, sv, si, ss, ru, rv, ri, rs, av, m, b) = if m > 3 then b else if mok(m, av) == false then best(su, sv, si, ss, ru, rv, ri, rs, av, m + 1, b) else let c = satd8(su, si, ss, pred(ru, ri, rs, m, av)) + satd8(sv, si, ss, pred(rv, ri, rs, m, av)) in best(su, sv, si, ss, ru, rv, ri, rs, av, m + 1, if c < b.c then {m: m, c: c} else b)

## --- one plane coded with the intra rounding ----------------------------------------------------------------------------
fn qpc(q) = if q < 30 then q else seq_nth([29, 30, 31, 32, 32, 33, 34, 34, 35, 35, 36, 36, 37, 37, 37, 38, 38, 38, 39, 39, 39, 39], q - 30)
fn mf0(r) = seq_nth([13107, 11916, 10082, 9362, 8192, 7282], r)
fn v0(r) = seq_nth([10, 11, 13, 14, 16, 18], r)
fn pow2(k) = if k == 0 then 1 else 2 * pow2(k - 1)
fn iabs(v) = if v < 0 then 0 - v else v
fn had(c0, c1, c2, c3) = [c0 + c1 + c2 + c3, c0 - c1 + c2 - c3, c0 + c1 - c2 - c3, c0 - c1 - c2 + c3]
fn qdc(f, q) = let qb = 15 + q / 6 in let z = (iabs(f) * mf0(q % 6) + 2 * (pow2(qb) / 3)) / pow2(qb + 1) in if f < 0 then 0 - z else z
fn dqdc(g, q) = fl(g * v0(q % 6) * pow2(q / 6), 2)
fn zz(k) = buf_get(buf_from_str("ABEIFCDGJMNKHLOP"), k) - 65
fn blk8(p, b) = blk8f(p, b, buf_new(16), 0)
fn blk8f(p, b, d, i) = if i >= 16 then d else let w = buf_set(d, i, buf_get(p, ((b / 2) * 4 + i / 4) * 8 + (b % 2) * 4 + i % 4)) in blk8f(p, b, d, i + 1)
fn coefs(src, si, ss, p, b) = let res = buf_new(32) in let r = buf_h264_sub4x4(src, si + (b / 2) * 4 * ss + (b % 2) * 4, ss, blk8(p, b), 0, res) in let w = buf_new(32) in let r2 = buf_h264_fdct4x4(res, 0, w, 0) in w
fn aclev(w, q) = let lev = buf_new(32) in let n = buf_h264_quant4x4(w, 0, q, 1, lev, 0) in put16(lev, 0, 0)
fn nzc(l, i) = if i >= 16 then 0 else (if get16(l, i * 2) != 0 then 1 else 0) + nzc(l, i + 1)
fn nzl(xs) = match xs
    Nil        => 0
    Cons(h, t) => (if h != 0 then 1 else 0) + nzl(t)
fn recon(rec, ri, rs, p, b, lev, dc, q) = let dq = buf_new(32) in let r = buf_h264_dequant4x4(lev, 0, q, dq, 0) in let s = put16(dq, 0, dc) in let rr = buf_new(32) in let r2 = buf_h264_idct4x4(dq, 0, rr, 0) in let rc = buf_new(16) in let r3 = buf_h264_recon4x4(blk8(p, b), 0, rr, 0, rc, 0) in copyb(rc, rec, ri + (b / 2) * 4 * rs + (b % 2) * 4, rs, 0)
fn copyb(rc, rec, rb, rs, i) = if i >= 16 then 0 else let w = buf_set(rec, rb + (i / 4) * rs + i % 4, buf_get(rc, i)) in copyb(rc, rec, rb, rs, i + 1)
fn copyp(p, rec, ri, rs, i) = if i >= 64 then 0 else let w = buf_set(rec, ri + (i / 8) * rs + i % 8, buf_get(p, i)) in copyp(p, rec, ri, rs, i + 1)
fn plane(src, si, ss, rec, ri, rs, p, q) = let ws = [coefs(src, si, ss, p, 0), coefs(src, si, ss, p, 1), coefs(src, si, ss, p, 2), coefs(src, si, ss, p, 3)] in let z = seq_map(had(get16(seq_nth(ws, 0), 0), get16(seq_nth(ws, 1), 0), get16(seq_nth(ws, 2), 0), get16(seq_nth(ws, 3), 0)), fn(v) => qdc(v, q)) in let ls = seq_map(ws, fn(w) => aclev(w, q)) in let na = nzc(seq_nth(ls, 0), 0) + nzc(seq_nth(ls, 1), 0) + nzc(seq_nth(ls, 2), 0) + nzc(seq_nth(ls, 3), 0) in let nd = nzl(z) in let dc = seq_map(had(seq_nth(z, 0), seq_nth(z, 1), seq_nth(z, 2), seq_nth(z, 3)), fn(g) => dqdc(g, q)) in let rr = (if na + nd == 0 then copyp(p, rec, ri, rs, 0) else let a = recon(rec, ri, rs, p, 0, seq_nth(ls, 0), seq_nth(dc, 0), q) in let b = recon(rec, ri, rs, p, 1, seq_nth(ls, 1), seq_nth(dc, 1), q) in let c = recon(rec, ri, rs, p, 2, seq_nth(ls, 2), seq_nth(dc, 2), q) in recon(rec, ri, rs, p, 3, seq_nth(ls, 3), seq_nth(dc, 3), q)) in {z: z, ls: ls, nd: nd, cbp: if na > 0 then 2 else if nd > 0 then 1 else 0}

fn same_range(a, ao, b, bo, n, i) = if i >= n then true else if buf_get(a, ao + i) != buf_get(b, bo + i) then false else same_range(a, ao, b, bo, n, i + 1)
fn same_blk(a, b, ri, rs, y) = if y >= 8 then true else if same_range(a, ri + y * rs, b, ri + y * rs, 8, 0) == false then false else same_blk(a, b, ri, rs, y + 1)
fn plane_ok(cfg, o, pl, k) = if k >= 4 then buf_get(cfg, o + 44) == pl.nd and rd32(cfg, o + 200) == pl.cbp else let l = seq_nth(pl.ls, k) in let t = buf_new(32) in let w = zzc(l, t, 0) in if get16(cfg, o + 48 + k * 2) != seq_nth(pl.z, k) or buf_get(cfg, o + 40 + k) != nzc(l, 0) or same_range(cfg, o + 64 + k * 32, t, 0, 32, 0) == false then false else plane_ok(cfg, o, pl, k + 1)
fn zzc(l, o, k) = if k >= 16 then 0 else let w = put16(o, k * 2, get16(l, zz(k) * 2)) in zzc(l, o, k + 1)

fn check(bx, by, qy, off, av, sm) = let w = 48 in let h = 32 in let su = pic(w, h, 0, sm) in let sv = pic(w, h, 3, sm) in let ru1 = pic(w, h, 1, sm) in let rv1 = pic(w, h, 4, sm) in let ru2 = pic(w, h, 1, sm) in let rv2 = pic(w, h, 4, sm) in let o = by * w + bx in let cfg = cfg_new(w, w, qy, off, o, o, av, 0) in let got = buf_h264_mb_ic(su, sv, ru1, rv1, cfg) in let b = best(su, sv, o, w, ru2, rv2, o, w, av, 0, {m: 0, c: 1099511627776}) in let qi = qy + off in let q = qpc(if qi < 0 then 0 else if qi > 51 then 51 else qi) in let pu = pred(ru2, o, w, b.m, av) in let pv = pred(rv2, o, w, b.m, av) in let plu = plane(su, o, w, ru2, o, w, pu, q) in let plv = plane(sv, o, w, rv2, o, w, pv, q) in got == b.c and rd32(cfg, 32) == b.m and same_range(cfg, 768, pu, 0, 64, 0) and same_range(cfg, 1280, pv, 0, 64, 0) and plane_ok(cfg, 512, plu, 0) and plane_ok(cfg, 1024, plv, 0) and same_blk(ru1, ru2, o, w, 0) and same_blk(rv1, rv2, o, w, 0)

fn test_interior_all_modes_possible() = check(8, 8, 26, 0, 11, false) and check(8, 8, 26, 0, 11, true) and check(16, 16, 30, 0, 11, true)
fn test_dc_rules_on_the_edges() = check(0, 0, 26, 0, 0, true) and check(8, 0, 26, 0, 1, false) and check(0, 8, 26, 0, 2, true) and check(8, 8, 26, 0, 3, false)
fn test_qp_offset_and_extremes() = check(8, 8, 40, 6, 11, false) and check(8, 8, 0, 0, 11, false) and check(8, 8, 51, 12, 11, true)
fn test_decide_only_leaves_rec_alone() = let w = 48 in let su = pic(w, 32, 0, true) in let ru = pic(w, 32, 1, true) in let rv = pic(w, 32, 4, true) in let cu = pic(w, 32, 1, true) in let cfg = cfg_new(w, w, 26, 0, 8 * w + 8, 8 * w + 8, 11, 1) in let c = buf_h264_mb_ic(su, su, ru, rv, cfg) in c >= 0 and same_blk(ru, cu, 8 * w + 8, w, 0)
fn test_wrong_arguments_answer_minus_one() = let s = pic(48, 32, 0, true) in buf_h264_mb_ic(s, s, s, s, buf_new(100)) == 0 - 1 and buf_h264_mb_ic(s, s, s, s, cfg_new(48, 48, 26, 0, 0, 0, 2, 0)) == 0 - 1 and buf_h264_mb_ic(s, s, s, s, cfg_new(48, 48, 26, 13, 8, 8, 0, 0)) == 0 - 1 and buf_h264_mb_ic(s, s, s, s, cfg_new(48, 48, 52, 0, 8, 8, 0, 0)) == 0 - 1
