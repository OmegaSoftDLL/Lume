## fs_path_exists_ok.src -- present, missing and empty paths; every fixture is made here, relative to the working
## directory, so the file passes from any directory (the repository root, bootstrap/lume0/tests, a test runner).
fn test_fs_path_exists_present() = let path = "fs_path_exists_present_probe" in let written = fs_write_sync(path, "x") in let found = fs_path_exists(path) in let z = fs_remove(path) in written == 1 and found == 1

fn test_fs_path_exists_missing() = fs_path_exists("definitely_missing_fs_probe_dir/definitely_missing_fs_probe") == 0

fn test_fs_path_exists_empty_file() = let path = "fs_path_exists_empty_probe" in let written = fs_write_sync(path, "") in let found = fs_path_exists(path) in let text = fs_read_file(path) in let z = fs_remove(path) in written == 1 and found == 1 and text == ""
