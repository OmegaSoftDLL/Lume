## closure_poly_ok.src -- lambdas of different types in one program that also has fully annotated functions. The closures
## are defunctionalized into one dispatcher per arity (__closure_call_N), whose parameters take the union of the
## lambdas' types: the type checker must not give it, or the functions that call it, a single type.

fn um(n: int) -> int = n + 1
fn laco(a, b, acc, f) = if a >= b then acc else laco(a + 1, b, f(a, acc), f)
fn ap(acc, f) = f(1, acc)

fn test_int_and_str_accumulators() = laco(0, 3, 0, fn(i, s) => s + i) == 3 and laco(0, 3, "", fn(i, s) => s + "x") == "xxx"
fn test_non_recursive_higher_order() = ap(0, fn(i, s) => s + i) == 1 and ap("", fn(i, s) => s + "y") == "y"
fn test_list_accumulator() = let xs = laco(0, 3, Nil, fn(i, acc) => Cons(i, acc)) in match xs
    Cons(h, t) => h == 2
    Nil        => 0
fn test_annotated_still_checked() = um(41) == 42

print laco(0, 4, "", fn(i, s) => s + str(i))
