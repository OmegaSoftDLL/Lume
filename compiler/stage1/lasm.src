fn mbr_part1_iso() = Cons(250, Cons(252, Cons(49, Cons(192, Cons(142, Cons(216, Cons(142, Cons(192, Cons(142, Cons(208, Cons(188, Cons(0, Cons(124, Cons(190, Cons(240, Cons(124, Cons(144, Cons(144, Cons(144, Cons(144, Cons(191, Cons(0, Cons(16, Cons(185, Cons(0, Cons(32, Cons(49, Cons(192, Cons(243, Cons(171, Cons(199, Cons(6, Cons(0, Cons(16, Cons(3, Cons(32, Cons(199, Cons(6, Cons(0, Cons(32, Cons(3, Cons(48, Cons(199, Cons(6, Cons(0, Cons(48, Cons(131, Cons(0, Cons(199, Cons(6, Cons(8, Cons(48, Cons(131, Cons(0, Cons(199, Cons(6, Cons(10, Cons(48, Cons(32, Cons(0, Cons(15, Cons(32, Cons(224, Cons(12, Cons(32, Cons(15, Cons(34, Cons(224, Cons(102, Cons(184, Cons(0, Cons(16, Cons(0, Cons(0, Cons(15, Cons(34, Cons(216, Cons(102, Cons(185, Cons(128, Cons(0, Cons(0, Cons(192, Cons(15, Cons(50, Cons(128, Cons(204, Cons(1, Cons(15, Cons(48, Cons(15, Cons(1, Cons(22, Cons(216, Cons(124, Cons(15, Cons(32, Cons(192, Cons(102, Cons(13, Cons(1, Cons(0, Cons(0, Cons(128, Cons(15, Cons(34, Cons(192, Cons(234, Cons(128, Cons(124, Cons(8, Cons(0, Nil))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))
fn mbr_part2(entry) = app(Cons(102, Cons(184, Cons(16, Cons(0, Cons(142, Cons(216, Cons(142, Cons(192, Cons(142, Cons(208, Cons(72, Cons(199, Cons(196, Cons(0, Cons(124, Cons(0, Cons(0, Cons(72, Cons(199, Cons(199, Cons(0, Cons(0, Cons(7, Cons(0, Cons(72, Cons(199, Cons(193, Cons(0, Cons(16, Cons(0, Cons(0, Cons(72, Cons(49, Cons(192, Cons(243, Cons(72, Cons(171, Cons(72, Cons(199, Cons(192, Nil)))))))))))))))))))))))))))))))))))))))), app(b4(entry), Cons(255, Cons(224, Nil))))
