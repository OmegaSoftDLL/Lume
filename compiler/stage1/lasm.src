fn iso_both16(n) = Cons(n % 256, Cons(n / 256 % 256, Cons(n / 256 % 256, Cons(n % 256, Nil))))
fn iso_both32(n) = app(b4(n), Cons(n / 16777216 % 256, Cons(n / 65536 % 256, Cons(n / 256 % 256, Cons(n % 256, Nil)))))
