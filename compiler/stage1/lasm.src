fn asmkernel(lay, strict) = let cs = lay.co in let rs = len(lay.robytes) in let syms = app(mapsym(lay.tls, 32768), app(mapsym(lay.rls, 32768 + cs), mapsym(lay.bls, 458752))) in let zref = chkrefs(lay.encs, syms, strict) in let zentry = chkentry(syms, strict) in let code = emitcode2b(lay.encs, syms, 32768) in let body = app(code, ro_final(lay, syms)) in let blen = len(body) in let nsects = (blen + 511) / 512 in let nsects_clamped = if nsects < 1 then 1 else if nsects > 127 then 127 else nsects in let target_sects = if nsects_clamped <= 64 then 64 else nsects_clamped in let pad_sz = target_sects * 512 - blen in emitall(app(mbr_sector(symaddr(syms, "_start"), nsects_clamped), app(body, zeros(if pad_sz >= 0 then pad_sz else 512))))
