## --- strict mode (#428): fail closed on unresolved symbols instead of silently encoding
## address 0. Every relocatable reference (jump/call/jcc target, %rip-relative operand) must
## resolve against the final symbol table; the first missing symbol aborts with [L0001] naming
## it, on stderr, with a non-zero exit (via ctfail), before a single ELF byte is flushed. ---
fn chksym(syms, nm, ctx) = if nm == "" then 0 else if symlocated(syms, nm) == 1 then 0 else ctfail("lasm: link error [L0001]: undefined symbol '" + nm + "' (" + ctx + ")\n")
fn chkinsref(r, syms) = if isjump(r.mn) then chksym(syms, r.tgt, r.mn + " target") else if r.a.rip == 1 then chksym(syms, r.a.sym, r.mn + " operand") else if r.b.rip == 1 then chksym(syms, r.b.sym, r.mn + " operand") else 0
fn chkrefs(encs, syms, strict) = if strict == 0 then chkrefs0(encs, syms) else chkrefs1(encs, syms)
## lenient mode keeps the historical "unresolved symbol = address 0", but only for something that can be
## a symbol: `jmp *%rax`, `call f, g`, `jmp sym+4` (none implemented) must not become a jump to 0.
fn badname(s, i, n) = if i >= n then 0 else let c = at(s, i) in if c == " " or c == "\t" or c == "," or c == "*" or c == "%" or c == "(" or c == ")" or c == "+" or c == "-" then 1 else badname(s, i + 1, n)
fn chkname(syms, nm, ctx) = if nm == "" then 0 else if symlocated(syms, nm) == 1 then 0 else if badname(nm, 0, count(nm)) == 1 then lerr("malformed symbol reference '" + nm + "' (" + ctx + ")") else 0
fn chkinsref0(r, syms) = if isjump(r.mn) then chkname(syms, r.tgt, r.mn + " target") else if r.a.rip == 1 then chkname(syms, r.a.sym, r.mn + " operand") else if r.b.rip == 1 then chkname(syms, r.b.sym, r.mn + " operand") else 0
fn chkrefs0(encs, syms) = match encs
    Nil        => 0
    Cons(e, t) => let z = if e.reloc == 1 then chkinsref0(e.ins, syms) else 0 in chkrefs0(t, syms)
fn chkrefs1(encs, syms) = match encs
    Nil        => 0
    Cons(e, t) => let z = if e.reloc == 1 then chkinsref(e.ins, syms) else 0 in chkrefs1(t, syms)
## a symbol defined twice stops the link: otherwise one definition silently wins and every jump goes there
fn dupmem(nm, es) = match es
    Nil        => 0
    Cons(h, t) => if h.nm == nm then 1 else dupmem(nm, t)
fn dupentries(es) = match es
    Nil        => 0
    Cons(h, t) => if dupmem(h.nm, t) == 1 then ctfail("lasm: link error [L0010]: symbol '" + h.nm + "' is defined twice\n") else dupentries(t)
fn dupbuckets(bs) = match bs
    Nil        => 0
    Cons(b, t) => let z = dupentries(b.entries) in dupbuckets(t)
fn chkdups(lay, strict) = if strict == 0 then 0 else dupbuckets(mapsym(app(lay.tls, app(lay.rls, lay.bls)), 0))
fn chkentry(syms, strict) = if strict == 1 and symlocated(syms, "_start") == 0 then ctfail("lasm: link error [L0001]: undefined entry symbol '_start'\n") else 0

## --- ELF64 container (VBASE 0x400000, 120-byte headers, one RWX PT_LOAD; or 232-byte dynamic ELF64 with PT_INTERP/PT_DYNAMIC/DT_NEEDED/PLT/GOT) ---
fn identbytes() = Cons(127, Cons(69, Cons(76, Cons(70, Cons(2, Cons(1, Cons(1, Cons(0, Cons(0, Cons(0, Cons(0, Cons(0, Cons(0, Cons(0, Cons(0, Cons(0, Nil))))))))))))))))
fn ehdr(entry) = app(identbytes(), app(b2(2), app(b2(62), app(b4(1), app(b8(entry), app(b8(64), app(b8(0), app(b4(0), app(b2(64), app(b2(56), app(b2(1), app(b2(0), app(b2(0), b2(0))))))))))))))
fn phdr(filesz, memsz) = app(b4(1), app(b4(7), app(b8(0), app(b8(4194304), app(b8(4194304), app(b8(filesz), app(b8(memsz), b8(4096))))))))

fn has_str(xs, s) = match xs
    Nil        => 0
    Cons(h, t) => if h == s then 1 else has_str(t, s)
fn collect_needs(items) = match items
    Nil        => Nil
    Cons(h, t) => collect_need1(h, collect_needs(t))
fn collect_need1(h, rest) = match h
    ND(s) => if has_str(rest, s) == 1 then rest else Cons(s, rest)
    _     => rest
fn collect_exts(items) = match items
    Nil        => Nil
    Cons(h, t) => collect_ext1(h, collect_exts(t))
fn collect_ext1(h, rest) = match h
    EX(s) => if has_str(rest, s) == 1 then rest else Cons(s, rest)
    _     => rest
fn zeros_acc(n, acc) = if n <= 0 then acc else zeros_acc(n - 1, Cons(0, acc))
fn zeros(n) = zeros_acc(n, Nil)
fn str_nul_bytes(s, i, n) = if i >= n then Cons(0, Nil) else Cons(ord(at(s, i)), str_nul_bytes(s, i + 1, n))
fn dynstr_pack(xs, off) = match xs
