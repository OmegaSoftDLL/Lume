    Cons(h, t) => let bs = str_nul_bytes(h, 0, count(h)) in let r = dynstr_pack(t, off + count(h) + 1) in {bytes: app(bs, r.bytes), offs: Cons(off, r.offs), end: r.end}
fn mk_plt_tls(exts, cs0, i) = match exts
