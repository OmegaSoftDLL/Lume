fn iso_brvd() = app(iso_cd001(0), app(str_nul_bytes("EL TORITO SPECIFICATION", 0, 23), app(zeros(40), app(b4(19), zeros(1973)))))
fn iso_vdst() = app(iso_cd001(255), zeros(2041))
