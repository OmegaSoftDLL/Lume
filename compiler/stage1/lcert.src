## Stage 5 Track G3 / H3: Minimal Trusted Proof Certificate Kernel (`lume verify-cert <cert.json>`).
## Standalone, zero-dependency proof-certificate verifier:
##   1. ZERO compiler imports (`use lcaas` is NOT imported; `lumec` is never invoked).
##   2. Cryptographic SHA-256 (FIPS 180-4) tamper-evidence check over `source_hash`, `proof_terms`, and `obligations`.
##   3. Independent S-expression parser + standalone Fourier-Motzkin `QF_LIA` solver over Z that re-derives
##      every `"status":"proven"` obligation from its proof term `(implies (and ...) <goal>)` and rejects
##      false, nonlinear, garbled, or overclaimed obligations regardless of the certificate's stored status.
##   4. Independent structural cycle-budget check for `"kind":"wcet"` obligations (`wcet_budget(est <= bound)`),
##      requiring `"status":"budget_checked"` and rejecting `"status":"proven"` overclaims.

fn lk_isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0

fn lk_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + lk_len(t)

fn lk_app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, lk_app(t, ys))

fn lk_omem(s, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == s then 1 else lk_omem(s, t)

fn lk_jesc_plain(s, i, n) = if i >= n then i else let c = at(s, i) in if c == "\"" or c == "\\" or c == "\n" or c == "\r" or c == "\t" then i else lk_jesc_plain(s, i + 1, n)
fn lk_jesc_chunks(s, i, n, acc) = if i >= n then acc else let j = lk_jesc_plain(s, i, n) in if j > i then lk_jesc_chunks(s, j, n, Cons(slice(s, i, j), acc)) else let c = at(s, i) in lk_jesc_chunks(s, i + 1, n, Cons(if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then "\\n" else if c == "\r" then "\\r" else "\\t", acc))
fn lk_jesc(s) = let n = count(s) in if lk_jesc_plain(s, 0, n) >= n then s else lk_join(lk_rev(lk_jesc_chunks(s, 0, n, Nil), Nil))

fn lk_startswith_at(s, p, i, m) = if i >= m then 1 else if at(s, i) == at(p, i) then lk_startswith_at(s, p, i + 1, m) else 0
fn lk_startswith(s, p) = let m = count(p) in if count(s) < m then 0 else lk_startswith_at(s, p, 0, m)

## --- 1. Real Cryptographic 256-bit SHA-256 (FIPS 180-4) ---
fn sha_ord(c) = ord(c)
fn sha_u32(x) = let r = x % 4294967296 in if r < 0 then r + 4294967296 else r
fn sha_pow2(n) = if n <= 0 then 1 else if n >= 16 then 65536 * sha_pow2(n - 16) else if n >= 8 then 256 * sha_pow2(n - 8) else if n >= 4 then 16 * sha_pow2(n - 4) else if n == 3 then 8 else if n == 2 then 4 else 2
fn sha_shr(x, n) = x / sha_pow2(n)
fn sha_rotr(x, n) = let p = sha_pow2(n) in x / p + x % p * sha_pow2(32 - n)
fn sha_xor3_4(x, y, z) = let b0 = (x % 2 + y % 2 + z % 2) % 2 in let b1 = (x / 2 % 2 + y / 2 % 2 + z / 2 % 2) % 2 in let b2 = (x / 4 % 2 + y / 4 % 2 + z / 4 % 2) % 2 in let b3 = (x / 8 % 2 + y / 8 % 2 + z / 8 % 2) % 2 in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_xor3_n(x, y, z, nibs) = if nibs == 8 then bv_xor(bv_xor(x, y), z) else if nibs <= 0 then 0 else sha_xor3_4(x % 16, y % 16, z % 16) + 16 * sha_xor3_n(x / 16, y / 16, z / 16, nibs - 1)
fn sha_ch_4(e, f, g) = let b0 = if e % 2 == 1 then f % 2 else g % 2 in let b1 = if e / 2 % 2 == 1 then f / 2 % 2 else g / 2 % 2 in let b2 = if e / 4 % 2 == 1 then f / 4 % 2 else g / 4 % 2 in let b3 = if e / 8 % 2 == 1 then f / 8 % 2 else g / 8 % 2 in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_ch_n(e, f, g, nibs) = if nibs == 8 then bv_xor(bv_and(e, f), bv_and(bv_xor(e, 4294967295), g)) else if nibs <= 0 then 0 else sha_ch_4(e % 16, f % 16, g % 16) + 16 * sha_ch_n(e / 16, f / 16, g / 16, nibs - 1)
fn sha_maj_4(a, b, c) = let b0 = if a % 2 + b % 2 + c % 2 >= 2 then 1 else 0 in let b1 = if a / 2 % 2 + b / 2 % 2 + c / 2 % 2 >= 2 then 1 else 0 in let b2 = if a / 4 % 2 + b / 4 % 2 + c / 4 % 2 >= 2 then 1 else 0 in let b3 = if a / 8 % 2 + b / 8 % 2 + c / 8 % 2 >= 2 then 1 else 0 in b0 + 2 * b1 + 4 * b2 + 8 * b3
fn sha_maj_n(a, b, c, nibs) = if nibs == 8 then bv_xor(bv_xor(bv_and(a, b), bv_and(a, c)), bv_and(b, c)) else if nibs <= 0 then 0 else sha_maj_4(a % 16, b % 16, c % 16) + 16 * sha_maj_n(a / 16, b / 16, c / 16, nibs - 1)
fn sha_big_sig0(a) = sha_xor3_n(sha_rotr(a, 2), sha_rotr(a, 13), sha_rotr(a, 22), 8)
fn sha_big_sig1(e) = sha_xor3_n(sha_rotr(e, 6), sha_rotr(e, 11), sha_rotr(e, 25), 8)
fn sha_sml_sig0(x) = sha_xor3_n(sha_rotr(x, 7), sha_rotr(x, 18), sha_shr(x, 3), 8)
fn sha_sml_sig1(x) = sha_xor3_n(sha_rotr(x, 17), sha_rotr(x, 19), sha_shr(x, 10), 8)
fn sha_k(t) = if t < 16 then (if t == 0 then 1116352408 else if t == 1 then 1899447441 else if t == 2 then 3049323471 else if t == 3 then 3921009573 else if t == 4 then 961987163 else if t == 5 then 1508970993 else if t == 6 then 2453635748 else if t == 7 then 2870763221 else if t == 8 then 3624381080 else if t == 9 then 310598401 else if t == 10 then 607225278 else if t == 11 then 1426881987 else if t == 12 then 1925078388 else if t == 13 then 2162078206 else if t == 14 then 2614888103 else 3248222580) else if t < 32 then (if t == 16 then 3835390401 else if t == 17 then 4022224774 else if t == 18 then 264347078 else if t == 19 then 604807628 else if t == 20 then 770255983 else if t == 21 then 1249150122 else if t == 22 then 1555081692 else if t == 23 then 1996064986 else if t == 24 then 2554220882 else if t == 25 then 2821834349 else if t == 26 then 2952996808 else if t == 27 then 3210313671 else if t == 28 then 3336571891 else if t == 29 then 3584528711 else if t == 30 then 113926993 else 338241895) else if t < 48 then (if t == 32 then 666307205 else if t == 33 then 773529912 else if t == 34 then 1294757372 else if t == 35 then 1396182291 else if t == 36 then 1695183700 else if t == 37 then 1986661051 else if t == 38 then 2177026350 else if t == 39 then 2456956037 else if t == 40 then 2730485921 else if t == 41 then 2820302411 else if t == 42 then 3259730800 else if t == 43 then 3345764771 else if t == 44 then 3516065817 else if t == 45 then 3600352804 else if t == 46 then 4094571909 else 275423344) else if t == 48 then 430227734 else if t == 49 then 506948616 else if t == 50 then 659060556 else if t == 51 then 883997877 else if t == 52 then 958139571 else if t == 53 then 1322822218 else if t == 54 then 1537002063 else if t == 55 then 1747873779 else if t == 56 then 1955562222 else if t == 57 then 2024104815 else if t == 58 then 2227730452 else if t == 59 then 2361852424 else if t == 60 then 2428436474 else if t == 61 then 2756734187 else if t == 62 then 3204031479 else 3329325298
fn sha_nth(xs, i) = match xs
    Nil        => 0
    Cons(h, t) => if i <= 0 then h else sha_nth(t, i - 1)
fn sha_msg_byte(s, len, total, idx) = if idx < len then sha_ord(at(s, idx)) else if idx == len then 128 else if idx >= total - 8 then len * 8 / sha_pow2(8 * (total - 1 - idx)) % 256 else 0
fn sha_msg_word(s, len, total, base) = sha_msg_byte(s, len, total, base) * 16777216 + sha_msg_byte(s, len, total, base + 1) * 65536 + sha_msg_byte(s, len, total, base + 2) * 256 + sha_msg_byte(s, len, total, base + 3)
fn sha_w_build(s, len, total, blk_off, t, w_rev) = if t >= 64 then w_rev else let wt = if t < 16 then sha_msg_word(s, len, total, blk_off + t * 4) else sha_u32(sha_nth(w_rev, 15) + sha_sml_sig0(sha_nth(w_rev, 14)) + sha_nth(w_rev, 6) + sha_sml_sig1(sha_nth(w_rev, 1))) in sha_w_build(s, len, total, blk_off, t + 1, Cons(wt, w_rev))
fn sha_round(st, wt, kt) = let t1 = sha_u32(st.h + sha_big_sig1(st.e) + sha_ch_n(st.e, st.f, st.g, 8) + kt + wt) in let t2 = sha_u32(sha_big_sig0(st.a) + sha_maj_n(st.a, st.b, st.c, 8)) in {a: sha_u32(t1 + t2), b: st.a, c: st.b, d: st.c, e: sha_u32(st.d + t1), f: st.e, g: st.f, h: st.g}
fn sha_rounds(st, w_rev, t) = if t >= 64 then st else sha_rounds(sha_round(st, sha_nth(w_rev, 63 - t), sha_k(t)), w_rev, t + 1)
fn sha_blocks(s, len, total, blk_off, st) = if blk_off >= total then st else let w_rev = sha_w_build(s, len, total, blk_off, 0, Nil) in let r = sha_rounds(st, w_rev, 0) in sha_blocks(s, len, total, blk_off + 64, {a: sha_u32(st.a + r.a), b: sha_u32(st.b + r.b), c: sha_u32(st.c + r.c), d: sha_u32(st.d + r.d), e: sha_u32(st.e + r.e), f: sha_u32(st.f + r.f), g: sha_u32(st.g + r.g), h: sha_u32(st.h + r.h)})
fn sha_hex1(n) = at("0123456789abcdef", n % 16)
fn sha_hex32(w) = sha_hex1(w / 268435456) + sha_hex1(w / 16777216) + sha_hex1(w / 1048576) + sha_hex1(w / 65536) + sha_hex1(w / 4096) + sha_hex1(w / 256) + sha_hex1(w / 16) + sha_hex1(w)
fn sha256_hex(s) = let len = count(s) in let total = (len + 9 + 63) / 64 * 64 in let init = {a: 1779033703, b: 3144134277, c: 1013904242, d: 2773480762, e: 1359893119, f: 2600822924, g: 528734635, h: 1541459225} in let fin = sha_blocks(s, len, total, 0, init) in sha_hex32(fin.a) + sha_hex32(fin.b) + sha_hex32(fin.c) + sha_hex32(fin.d) + sha_hex32(fin.e) + sha_hex32(fin.f) + sha_hex32(fin.g) + sha_hex32(fin.h)

fn lc_sha256(s) = "sha256:" + sha256_hex(s)

fn lk_is_hex_ch(c) = if c >= "0" and c <= "9" or c >= "a" and c <= "f" then 1 else 0
fn lk_all_hex(s, i, n) = if i >= n then 1 else if lk_is_hex_ch(at(s, i)) == 1 then lk_all_hex(s, i + 1, n) else 0
fn lk_valid_sha256_tag(h) = if count(h) == 71 and lk_startswith(h, "sha256:") == 1 and lk_all_hex(h, 7, 71) == 1 then 1 else 0

## --- 2. Standalone S-Expression Proof-Term Parser ---
fn lk_is_ws(c) = if c == " " or c == "\t" or c == "\n" or c == "\r" then 1 else 0
fn lk_skip_ws(s, i, n) = if i >= n then i else if lk_is_ws(at(s, i)) == 1 then lk_skip_ws(s, i + 1, n) else i
fn lk_is_digit(c) = if c >= "0" and c <= "9" then 1 else 0
fn lk_atom_end(s, i, n) = if i >= n then i else let c = at(s, i) in if lk_is_ws(c) == 1 or c == "(" or c == ")" then i else lk_atom_end(s, i + 1, n)
fn lk_all_digits(s, i, n) = if i >= n then 1 else if lk_is_digit(at(s, i)) == 1 then lk_all_digits(s, i + 1, n) else 0
## An integer literal has at most 18 digits (below 10^18, inside the 64-bit range). A longer run of digits used to reach
## `toint` and abort the kernel with an integer-overflow trap; it is now an atom that is not a number, and (not being an
## identifier either) not a variable: a term that mentions it is not proven.
fn lk_is_int_tok(tok) = let n = count(tok) in if n == 0 then 0 else if at(tok, 0) == "-" then (if n > 1 and n <= 19 and lk_all_digits(tok, 1, n) == 1 then 1 else 0) else if n <= 18 then lk_all_digits(tok, 0, n) else 0
## A free variable of a proof term is an identifier. The solver names its own unknowns by strings built from the terms
## they stand for (`x*y` for a product, `div(x,2)`, `select(a,0+2*x)`, `field(r.f)`); an atom spelled like one of those
## was taken for that unknown, so `(== x*y 6)` was "proved" from x == 2 and y == 3 about an atom that no hypothesis
## constrains. Atoms that are not identifiers are refused.
fn lk_is_ident_at(s, i, n) = if i >= n then 1 else let c = at(s, i) in if c >= "a" and c <= "z" or c >= "A" and c <= "Z" or c == "_" then lk_is_ident_at(s, i + 1, n) else if i > 0 and lk_is_digit(c) == 1 then lk_is_ident_at(s, i + 1, n) else 0
fn lk_is_ident(s) = let n = count(s) in if n == 0 then 0 else lk_is_ident_at(s, 0, n)
fn lk_to_int(tok) = if at(tok, 0) == "-" then 0 - toint(slice(tok, 1, count(tok))) else toint(tok)

fn lk_parse_sexpr(s, i, n) = let j = lk_skip_ws(s, i, n) in if j >= n then {ok: 0, node: SNum(0), next: j} else if at(s, j) == "(" then lk_parse_slist(s, j + 1, n) else let k = lk_atom_end(s, j, n) in if k <= j then {ok: 0, node: SNum(0), next: j} else let tok = slice(s, j, k) in if lk_is_int_tok(tok) == 1 then {ok: 1, node: SNum(lk_to_int(tok)), next: k} else {ok: 1, node: SVar(tok), next: k}

fn lk_parse_slist(s, i, n) = let j = lk_skip_ws(s, i, n) in if j >= n then {ok: 0, node: SNum(0), next: j} else if at(s, j) == ")" then {ok: 1, node: SList(Nil), next: j + 1} else let r1 = lk_parse_sexpr(s, j, n) in if r1.ok == 0 then {ok: 0, node: SNum(0), next: r1.next} else let r2 = lk_parse_slist(s, r1.next, n) in if r2.ok == 0 then {ok: 0, node: SNum(0), next: r2.next} else {ok: 1, node: SList(Cons(r1.node, lk_slist_items(r2.node))), next: r2.next}

fn lk_slist_items(sx) = match sx
    SList(xs) => xs
    _         => Nil

fn lk_shd(xs) = match xs
    Nil        => SNum(0)
    Cons(h, t) => h

fn lk_stl(xs) = match xs
    Nil        => Nil
    Cons(h, t) => t

fn lk_svar_name(sx) = match sx
    SVar(nm) => nm
    _        => ""

## --- 3. Standalone Fourier-Motzkin QF_LIA Decision Procedure in the Kernel ---
fn lk_lin_ovf(x) = if x > 100000000000000000 or x < 0 - 100000000000000000 then 1 else 0
fn lk_lin_coeff_ovf(x) = if x > 2000000000 or x < 0 - 2000000000 then 1 else 0
fn lk_lin_abs(x) = if x < 0 then 0 - x else x
fn lk_lin_mul_ovf(k, c) = if k == 0 or c == 0 then 0 else if lk_lin_ovf(k) == 1 or lk_lin_ovf(c) == 1 then 1 else if lk_lin_abs(c) > 100000000000000000 / lk_lin_abs(k) then 1 else 0
fn lk_lin_cs_ovf(cs) = match cs
    Nil        => 0
    Cons(h, t) => if lk_lin_coeff_ovf(h.c) == 1 then 1 else lk_lin_cs_ovf(t)
fn lk_lin_scale_ovf(k, cs) = match cs
    Nil        => 0
    Cons(h, t) => if lk_lin_coeff_ovf(k) == 1 or lk_lin_coeff_ovf(h.c) == 1 or k != 0 and lk_lin_abs(h.c) > 2000000000 / lk_lin_abs(k) then 1 else lk_lin_scale_ovf(k, t)
fn lk_lin_const(n) = if lk_lin_ovf(n) == 1 then lk_lin_err() else {ok: 1, c0: n, cs: Nil}
fn lk_lin_var(nm) = {ok: 1, c0: 0, cs: Cons({k: nm, c: 1}, Nil)}
fn lk_lin_err() = {ok: 0, c0: 0, cs: Nil}
fn lk_lin_coeff(nm, cs) = match cs
    Nil        => 0
    Cons(h, t) => if h.k == nm then h.c else lk_lin_coeff(nm, t)
fn lk_lin_add_term(nm, c, cs) = if c == 0 then cs else lk_lin_add_t1(nm, c, cs)
fn lk_lin_add_t1(nm, c, cs) = match cs
    Nil        => Cons({k: nm, c: c}, Nil)
    Cons(h, t) => if h.k == nm then (if h.c + c == 0 then t else Cons({k: nm, c: h.c + c}, t)) else Cons(h, lk_lin_add_t1(nm, c, t))
fn lk_lin_add_cs(cs1, cs2) = match cs1
    Nil        => cs2
    Cons(h, t) => lk_lin_add_cs(t, lk_lin_add_term(h.k, h.c, cs2))
fn lk_lin_scale_cs(k, cs) = if k == 0 then Nil else lk_lin_scale_cs1(k, cs)
fn lk_lin_scale_cs1(k, cs) = match cs
    Nil        => Nil
    Cons(h, t) => Cons({k: h.k, c: k * h.c}, lk_lin_scale_cs1(k, t))
fn lk_lin_add(a, b) = if a.ok == 0 or b.ok == 0 or lk_lin_ovf(a.c0) == 1 or lk_lin_ovf(b.c0) == 1 or lk_lin_ovf(a.c0 + b.c0) == 1 then lk_lin_err() else let cs = lk_lin_add_cs(a.cs, b.cs) in if lk_lin_cs_ovf(cs) == 1 then lk_lin_err() else {ok: 1, c0: a.c0 + b.c0, cs: cs}
fn lk_lin_scale(k, a) = if a.ok == 0 or lk_lin_ovf(k) == 1 or lk_lin_mul_ovf(k, a.c0) == 1 or lk_lin_scale_ovf(k, a.cs) == 1 then lk_lin_err() else {ok: 1, c0: k * a.c0, cs: lk_lin_scale_cs(k, a.cs)}
fn lk_lin_sub(a, b) = lk_lin_add(a, lk_lin_scale(0 - 1, b))
fn lk_mono_key(k1, k2) = if k1 <= k2 then k1 + "*" + k2 else k2 + "*" + k1
fn lk_lin_mul_term_ovf(c1, cs2) = match cs2
    Nil        => 0
    Cons(h, t) => if lk_lin_mul_ovf(c1, h.c) == 1 or lk_lin_coeff_ovf(c1 * h.c) == 1 then 1 else lk_lin_mul_term_ovf(c1, t)
fn lk_lin_mul_cs_ovf(cs1, cs2) = match cs1
    Nil        => 0
    Cons(h, t) => if lk_lin_mul_term_ovf(h.c, cs2) == 1 then 1 else lk_lin_mul_cs_ovf(t, cs2)
fn lk_lin_mul_term_cs(k1, c1, cs2) = match cs2
    Nil        => Nil
    Cons(h, t) => lk_lin_add_term(lk_mono_key(k1, h.k), c1 * h.c, lk_lin_mul_term_cs(k1, c1, t))
fn lk_lin_mul_cs(cs1, cs2) = match cs1
    Nil        => Nil
    Cons(h, t) => lk_lin_add_cs(lk_lin_mul_term_cs(h.k, h.c, cs2), lk_lin_mul_cs(t, cs2))
fn lk_lin_mul(a, b) = if a.ok == 0 or b.ok == 0 then lk_lin_err() else if lk_isnil(a.cs) == 1 then lk_lin_scale(a.c0, b) else if lk_isnil(b.cs) == 1 then lk_lin_scale(b.c0, a) else let t0 = lk_lin_add(lk_lin_scale(a.c0, b), lk_lin_scale(b.c0, {ok: 1, c0: 0, cs: a.cs})) in if t0.ok == 0 or lk_lin_mul_cs_ovf(a.cs, b.cs) == 1 then lk_lin_err() else let cs = lk_lin_add_cs(t0.cs, lk_lin_mul_cs(a.cs, b.cs)) in if lk_lin_cs_ovf(cs) == 1 then lk_lin_err() else {ok: 1, c0: t0.c0, cs: cs}
fn lk_lin_is_zero(l) = if l.ok == 1 and l.c0 == 0 and lk_isnil(l.cs) == 1 then 1 else 0
fn lk_lin_eq(a, b) = lk_lin_is_zero(lk_lin_sub(a, b))
fn lk_phd_cs(cs) = match cs
    Nil        => {k: "", c: 0}
    Cons(h, t) => h
fn lk_tl_cs(cs) = match cs
    Nil        => Nil
    Cons(h, t) => t
fn lk_lin_key_cs(cs) = match cs
    Nil        => ""
    Cons(h, t) => str(h.c) + "*" + h.k + (if lk_isnil(t) == 1 then "" else "+" + lk_lin_key_cs(t))
fn lk_lin_key_str(l) = if l.ok == 0 then "?" else if lk_isnil(l.cs) == 1 then str(l.c0) else if l.c0 == 0 and lk_len(l.cs) == 1 and lk_lin_coeff((lk_phd_cs(l.cs)).k, l.cs) == 1 then (lk_phd_cs(l.cs)).k else str(l.c0) + "+" + lk_lin_key_cs(l.cs)
fn lk_lin_is_contra(l) = if l.ok == 1 and lk_isnil(l.cs) == 1 and l.c0 < 0 then 1 else 0
fn lk_fm_any_contra(hyps) = match hyps
    Nil        => 0
    Cons(h, t) => if lk_lin_is_contra(h) == 1 then 1 else lk_fm_any_contra(t)
fn lk_fm_vars_cs(cs, acc) = match cs
    Nil        => acc
    Cons(h, t) => lk_fm_vars_cs(t, if lk_omem(h.k, acc) == 1 then acc else Cons(h.k, acc))
fn lk_fm_vars(hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => lk_fm_vars(t, lk_fm_vars_cs(h.cs, acc))
fn lk_fm_part_pos(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if lk_lin_coeff(v, h.cs) > 0 then Cons(h, lk_fm_part_pos(v, t)) else lk_fm_part_pos(v, t)
fn lk_fm_part_neg(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if lk_lin_coeff(v, h.cs) < 0 then Cons(h, lk_fm_part_neg(v, t)) else lk_fm_part_neg(v, t)
fn lk_fm_part_zer(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if lk_lin_coeff(v, h.cs) == 0 then Cons(h, lk_fm_part_zer(v, t)) else lk_fm_part_zer(v, t)
fn lk_fm_pair1(v, p, cp, negs) = match negs
    Nil        => Nil
    Cons(n, r) => let cn = 0 - lk_lin_coeff(v, n.cs) in Cons(lk_lin_add(lk_lin_scale(cn, p), lk_lin_scale(cp, n)), lk_fm_pair1(v, p, cp, r))
fn lk_fm_pairs(v, pos, negs) = match pos
    Nil        => Nil
    Cons(p, r) => let pairs1 = lk_fm_pair1(v, p, lk_lin_coeff(v, p.cs), negs) in if lk_len(pairs1) > 24 then pairs1 else lk_app(pairs1, lk_fm_pairs(v, r, negs))
fn lk_fm_fdiv(c0, a) = if c0 >= 0 then c0 / a else (c0 - a + 1) / a
fn lk_fm_tighten_h(h) = if h.ok == 1 and lk_len(h.cs) == 1 then let t = lk_phd_cs(h.cs) in let a = if t.c < 0 then 0 - t.c else t.c in if a > 1 then {ok: 1, c0: lk_fm_fdiv(h.c0, a), cs: Cons({k: t.k, c: if t.c > 0 then 1 else 0 - 1}, Nil)} else h else h
fn lk_fm_tighten_list(hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => Cons(lk_fm_tighten_h(h), lk_fm_tighten_list(t))
fn lk_fm_elim_var(v, hyps) = lk_fm_tighten_list(lk_app(lk_fm_part_zer(v, hyps), lk_fm_pairs(v, lk_fm_part_pos(v, hyps), lk_fm_part_neg(v, hyps))))
fn lk_fm_unsat(hyps, vars) = if lk_fm_any_contra(hyps) == 1 then 1 else lk_fm_unsat1(hyps, vars)
fn lk_fm_cnt_sign(v, hyps, sg, n) = match hyps
    Nil        => n
    Cons(h, t) => let c = lk_lin_coeff(v, h.cs) in lk_fm_cnt_sign(v, t, sg, if sg > 0 and c > 0 or sg < 0 and c < 0 then n + 1 else n)
fn lk_fm_pick(vars, hyps, best, bestc) = match vars
    Nil        => best
    Cons(v, r) => let c = lk_fm_cnt_sign(v, hyps, 1, 0) * lk_fm_cnt_sign(v, hyps, 0 - 1, 0) in if bestc < 0 or c < bestc then lk_fm_pick(r, hyps, v, c) else lk_fm_pick(r, hyps, best, bestc)
fn lk_fm_drop_var(v, vars) = match vars
    Nil        => Nil
    Cons(h, t) => if h == v then t else Cons(h, lk_fm_drop_var(v, t))
fn lk_fm_row_cs(cs) = match cs
    Nil        => ""
    Cons(h, t) => str(h.c) + "*" + h.k + "+" + lk_fm_row_cs(t)
fn lk_fm_simplify(hyps, seen) = match hyps
    Nil        => Nil
    Cons(h, t) => if h.ok == 0 or lk_isnil(h.cs) == 1 and h.c0 >= 0 then lk_fm_simplify(t, seen) else let k = str(h.c0) + "|" + lk_fm_row_cs(h.cs) in if lk_omem(k, seen) == 1 then lk_fm_simplify(t, seen) else Cons(h, lk_fm_simplify(t, Cons(k, seen)))
fn lk_fm_unsat1(hyps, vars) = match vars
    Nil          => lk_fm_any_contra(hyps)
    Cons(v0, r0) => let v = lk_fm_pick(vars, hyps, v0, 0 - 1) in let next = lk_fm_simplify(lk_fm_elim_var(v, hyps), Nil) in if lk_fm_any_contra(next) == 1 then 1 else if lk_len(next) > 96 then 0 else lk_fm_unsat(next, lk_fm_drop_var(v, vars))
fn lk_fm_check_unsat(hyps) = let thyps = lk_fm_simplify(lk_fm_tighten_list(hyps), Nil) in lk_fm_unsat(thyps, lk_fm_vars(thyps, Nil))

fn lk_nia_var_lb(v, hyps) = match hyps
    Nil        => 0 - 999999
    Cons(h, t) => let r = lk_nia_var_lb(v, t) in if lk_len(h.cs) == 1 and lk_lin_coeff(v, h.cs) == 1 then let b = 0 - h.c0 in if b > r then b else r else r
fn lk_nia_var_ub(v, hyps) = match hyps
    Nil        => 999999
    Cons(h, t) => let r = lk_nia_var_ub(v, t) in if lk_len(h.cs) == 1 and lk_lin_coeff(v, h.cs) == 0 - 1 then let b = h.c0 in if b < r then b else r else r
fn lk_nia_split_star(s, idx, n) = if idx >= n then Nil else if at(s, idx) == "*" then Cons(slice(s, 0, idx), Cons(slice(s, idx + 1, n), Nil)) else lk_nia_split_star(s, idx + 1, n)
fn lk_nia_add_bvar(v, acc) = if v == "" or lk_omem(v, acc) == 1 then acc else Cons(v, acc)
fn lk_nia_add_bvars(vs, acc) = match vs
    Nil        => acc
    Cons(v, r) => lk_nia_add_bvars(r, lk_nia_add_bvar(v, acc))
fn lk_nia_vars_cs(cs, acc) = match cs
    Nil        => acc
    Cons(h, t) => lk_nia_vars_cs(t, lk_nia_add_bvars(lk_nia_split_star(h.k, 0, count(h.k)), acc))
fn lk_nia_base_vars(hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => lk_nia_base_vars(t, if lk_len(h.cs) <= 6 then lk_nia_vars_cs(h.cs, acc) else acc)
fn lk_nia_sq_one(v, nvars) = let vv = lk_lin_var(lk_mono_key(v, v)) in if nvars > 2 then Cons(vv, Nil) else let lv = lk_lin_var(v) in Cons(vv, Cons(lk_lin_add(vv, lk_lin_add(lk_lin_scale(2, lv), lk_lin_const(1))), Cons(lk_lin_add(vv, lk_lin_add(lk_lin_scale(0 - 2, lv), lk_lin_const(1))), Cons(lk_lin_add(vv, lv), Cons(lk_lin_sub(vv, lv), Nil)))))
fn lk_nia_sq_hyps(vars, hyps) = match vars
    Nil        => Nil
    Cons(v, r) => if lk_nia_var_lb(v, hyps) > 3037000499 or lk_nia_var_ub(v, hyps) < 0 - 3037000499 then lk_nia_sq_hyps(r, hyps) else lk_app(lk_nia_sq_one(v, lk_len(vars)), lk_nia_sq_hyps(r, hyps))
fn lk_nia_diff_sq_pairs(v1, vars) = match vars
    Nil         => Nil
    Cons(v2, r) => let dv = lk_lin_sub(lk_lin_var(v1), lk_lin_var(v2)) in let sv = lk_lin_add(lk_lin_var(v1), lk_lin_var(v2)) in Cons(lk_lin_mul(dv, dv), Cons(lk_lin_mul(sv, sv), lk_nia_diff_sq_pairs(v1, r)))
fn lk_nia_all_diff_sq(vars) = match vars
    Nil        => Nil
    Cons(v, r) => lk_app(lk_nia_diff_sq_pairs(v, r), lk_nia_all_diff_sq(r))
fn lk_nia_prod_pair(v1, lb1, vars, hyps) = match vars
    Nil         => Nil
    Cons(v2, r) => let lb2 = lk_nia_var_lb(v2, hyps) in let ub1 = lk_nia_var_ub(v1, hyps) in let ub2 = lk_nia_var_ub(v2, hyps) in let rest0 = lk_nia_prod_pair(v1, lb1, r, hyps) in let rest = if lb1 >= 0 and lb2 >= 0 and ub1 < 999999 and ub2 < 999999 then Cons({ok: 1, c0: ub1 * ub2, cs: Cons({k: lk_mono_key(v1, v2), c: 0 - 1}, Nil)}, Cons(lk_lin_mul(lk_lin_sub(lk_lin_const(ub1), lk_lin_var(v1)), lk_lin_sub(lk_lin_const(ub2), lk_lin_var(v2))), rest0)) else rest0 in if lb1 >= 0 and lb2 >= 0 and lb1 < 999999 and lb2 < 999999 then Cons({ok: 1, c0: 0 - lb1 * lb2, cs: Cons({k: lk_mono_key(v1, v2), c: 1}, Nil)}, Cons(lk_lin_mul(lk_lin_sub(lk_lin_var(v1), lk_lin_const(lb1)), lk_lin_sub(lk_lin_var(v2), lk_lin_const(lb2))), rest)) else rest
fn lk_nia_prod_hyps(vars, hyps) = match vars
    Nil         => Nil
    Cons(v1, r) => let lb1 = lk_nia_var_lb(v1, hyps) in lk_app(if lb1 >= 0 and lb1 < 999999 then lk_nia_prod_pair(v1, lb1, vars, hyps) else Nil, lk_nia_prod_hyps(r, hyps))
fn lk_nia_mono_z(x, y, vars, hyps) = match vars
    Nil        => Nil
    Cons(z, r) => let lbz = lk_nia_var_lb(z, hyps) in let rest0 = lk_nia_mono_z(x, y, r, hyps) in let d_xy = lk_lin_sub(lk_lin_var(lk_mono_key(x, z)), lk_lin_var(lk_mono_key(y, z))) in let rest = if lbz > 0 and lbz < 999999 then Cons(lk_lin_sub(d_xy, lk_lin_scale(lbz, lk_lin_sub(lk_lin_var(x), lk_lin_var(y)))), rest0) else rest0 in if lbz >= 0 and lbz < 999999 then Cons(d_xy, rest) else rest
fn lk_nia_mono_h1(h, vars, hyps) = if h.c0 <= 0 and lk_len(h.cs) == 2 then let c1 = lk_phd_cs(h.cs) in let c2 = lk_phd_cs(lk_tl_cs(h.cs)) in if c1.c == 1 and c2.c == 0 - 1 then lk_nia_mono_z(c1.k, c2.k, vars, hyps) else if c2.c == 1 and c1.c == 0 - 1 then lk_nia_mono_z(c2.k, c1.k, vars, hyps) else Nil else Nil
fn lk_nia_mono_hyps(cur, vars, hyps) = match cur
    Nil        => Nil
    Cons(h, t) => lk_app(lk_nia_mono_h1(h, vars, hyps), lk_nia_mono_hyps(t, vars, hyps))
fn lk_nia_enrich_hyps(goal_hyps, hyps) = let bvars = lk_nia_base_vars(goal_hyps, lk_nia_base_vars(hyps, Nil)) in let sqs = if lk_isnil(bvars) == 0 then lk_app(lk_nia_sq_hyps(bvars, hyps), lk_nia_all_diff_sq(bvars)) else Nil in lk_app(sqs, lk_app(lk_nia_prod_hyps(bvars, hyps), lk_app(lk_nia_mono_hyps(hyps, bvars, hyps), hyps)))
fn lk_lin_u_div_hyps(la, k, q) = let r = lk_lin_sub(la, lk_lin_scale(k, q)) in Cons(r, Cons(lk_lin_sub(lk_lin_const(k - 1), r), Nil))
fn lk_lin_div_hyps(la, k, q, hyps) = let r = lk_lin_sub(la, lk_lin_scale(k, q)) in let base = Cons(lk_lin_add(r, lk_lin_const(k - 1)), Cons(lk_lin_sub(lk_lin_const(k - 1), r), Nil)) in if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0 - 1), la), hyps)) == 1 then Cons(q, Cons(r, base)) else base
fn lk_bv_mod(x, m) = let r = x % m in if r < 0 then r + m else r
fn lk_bv_and(x, y, b) = if b <= 0 or x <= 0 or y <= 0 then 0 else x % 2 * (y % 2) + 2 * lk_bv_and(x / 2, y / 2, b - 1)
fn lk_bv_or(x, y, b) = if b <= 0 or x <= 0 and y <= 0 then 0 else (if x % 2 + y % 2 >= 1 then 1 else 0) + 2 * lk_bv_or(x / 2, y / 2, b - 1)
fn lk_bv_xor(x, y, b) = if b <= 0 or x <= 0 and y <= 0 then 0 else (x % 2 + y % 2) % 2 + 2 * lk_bv_xor(x / 2, y / 2, b - 1)

fn lk_mentions(sx, nm) = match sx
    SVar(x)   => if x == nm then 1 else 0
    SList(xs) => lk_mentions_list(xs, nm)
    _         => 0
fn lk_mentions_list(xs, nm) = match xs
    Nil        => 0
    Cons(h, t) => if lk_mentions(h, nm) == 1 then 1 else lk_mentions_list(t, nm)
## a binder name that occurs neither in the replacement nor in the body (it contains a space, so no parsed atom equals it)
fn lk_fresh(nm, rep, body) = let c = "(av " + nm + ")" in if lk_mentions(rep, c) == 1 or lk_mentions(body, c) == 1 then lk_fresh(c, rep, body) else c
fn lk_subst_sx(sx, vnm, rep) = match sx
    SVar(nm)  => if nm == vnm then rep else sx
    SList(xs) => lk_subst_form(xs, vnm, rep)
    _         => sx
fn lk_subst_form(xs, vnm, rep) = let op = lk_svar_name(lk_shd(xs)) in let args = lk_stl(xs) in if (op == "let" or op == "var") and lk_len(args) == 3 then lk_subst_bind(op, lk_svar_name(lk_shd(args)), Cons(lk_shd(lk_stl(args)), Nil), lk_shd(lk_stl(lk_stl(args))), {vnm: vnm, rep: rep}) else if (op == "forall_range" or op == "exists_range") and lk_len(args) == 4 then lk_subst_bind(op, lk_svar_name(lk_shd(args)), Cons(lk_shd(lk_stl(args)), Cons(lk_shd(lk_stl(lk_stl(args))), Nil)), lk_shd(lk_stl(lk_stl(lk_stl(args)))), {vnm: vnm, rep: rep}) else SList(lk_subst_slist(xs, vnm, rep))
## (op binder outer... body): the `outer` operands are evaluated outside the binder, `body` inside it. A malformed binder
## yields the empty list, which is neither a provable goal nor a linear term.
fn lk_subst_bind(op, bnm, outer, body, sb) = let o2 = lk_subst_slist(outer, sb.vnm, sb.rep) in if bnm == "" then SList(Nil) else if bnm == sb.vnm then SList(Cons(SVar(op), Cons(SVar(bnm), lk_app(o2, Cons(body, Nil))))) else if lk_mentions(sb.rep, bnm) == 1 then let f = lk_fresh(bnm, sb.rep, body) in SList(Cons(SVar(op), Cons(SVar(f), lk_app(o2, Cons(lk_subst_sx(lk_subst_sx(body, bnm, SVar(f)), sb.vnm, sb.rep), Nil))))) else SList(Cons(SVar(op), Cons(SVar(bnm), lk_app(o2, Cons(lk_subst_sx(body, sb.vnm, sb.rep), Nil)))))
fn lk_subst_slist(xs, vnm, rep) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(lk_subst_sx(h, vnm, rep), lk_subst_slist(t, vnm, rep))

fn lk_is_struct_call(op) = if op == "array_new" or op == "array_const" or op == "array_store" or op == "heap_write" or op == "points_to" or op == "heap_new" or op == "sep_conj" then 1 else 0
fn lk_is_struct_sx(sx) = match sx
    SList(xs) => if lk_isnil(xs) == 1 then 0 else lk_is_struct_call(lk_svar_name(lk_shd(xs)))
    _         => 0

## --- Separation Logic Non-Aliasing (`sep_disjoint` / `sep_conj`, F4) ---
## Formal semantics: `sep_disjoint(a, b)` asserts pointer/handle address non-aliasing (`a != b`),
## proven in QF_LIA/QF_NIA via strict ordering (`a > b` or `a < b`) or squared difference (`(a - b)^2 >= 1`)
## over finite abstract heap domains (`points_to`, `heap_new`, `heap_write`).
fn lk_sep_dom_ptr(sx) = match sx
    SList(xs) => if lk_isnil(xs) == 1 then Nil else let op = lk_svar_name(lk_shd(xs)) in let args = lk_stl(xs) in if (op == "points_to" or op == "heap_new") and lk_len(args) == 2 then Cons(lk_shd(args), Nil) else if op == "sep_conj" and lk_len(args) == 2 then lk_app(lk_sep_dom_ptr(lk_shd(args)), lk_sep_dom_ptr(lk_shd(lk_stl(args)))) else if op == "heap_write" and lk_len(args) == 3 then Cons(lk_shd(lk_stl(args)), lk_sep_dom_ptr(lk_shd(args))) else Nil
    _         => Nil
fn lk_sep_disjoint_one(p, ps, hyps, lenv) = match ps
    Nil         => 1
    Cons(q, qr) => let diff = SList(Cons(SVar("-"), Cons(p, Cons(q, Nil)))) in if (lk_prove_goal(SList(Cons(SVar(">"), Cons(p, Cons(q, Nil)))), hyps, lenv) == 1 or lk_prove_goal(SList(Cons(SVar("<"), Cons(p, Cons(q, Nil)))), hyps, lenv) == 1 or lk_prove_goal(SList(Cons(SVar(">="), Cons(SList(Cons(SVar("*"), Cons(diff, Cons(diff, Nil)))), Cons(SNum(1), Nil)))), hyps, lenv) == 1) and lk_sep_disjoint_one(p, qr, hyps, lenv) == 1 then 1 else 0
fn lk_sep_disjoint_lists(ps1, ps2, hyps, lenv) = match ps1
    Nil         => 1
    Cons(p, pr) => if lk_sep_disjoint_one(p, ps2, hyps, lenv) == 1 then lk_sep_disjoint_lists(pr, ps2, hyps, lenv) else 0
fn lk_sep_valid(sx, hyps, lenv) = match sx
    SList(xs) => if lk_isnil(xs) == 1 then 0 else let op = lk_svar_name(lk_shd(xs)) in let args = lk_stl(xs) in if (op == "points_to" or op == "heap_new") and lk_len(args) == 2 then 1 else if op == "sep_conj" and lk_len(args) == 2 then let h1 = lk_shd(args) in let h2 = lk_shd(lk_stl(args)) in if lk_sep_valid(h1, hyps, lenv) == 1 and lk_sep_valid(h2, hyps, lenv) == 1 and lk_sep_disjoint_lists(lk_sep_dom_ptr(h1), lk_sep_dom_ptr(h2), hyps, lenv) == 1 then 1 else 0 else if op == "heap_write" and lk_len(args) == 3 then lk_sep_valid(lk_shd(args), hyps, lenv) else 0
    _         => 0
fn lk_arr_select(arr_sx, idx_sx, hyps, lenv) = match arr_sx
    SList(xs) => if lk_isnil(xs) == 1 then lk_lin_err() else let op = lk_svar_name(lk_shd(xs)) in let args = lk_stl(xs) in if (op == "array_store" or op == "heap_write") and lk_len(args) == 3 then let base_a = lk_shd(args) in let st_i = lk_shd(lk_stl(args)) in let st_v = lk_shd(lk_stl(lk_stl(args))) in let diff = SList(Cons(SVar("-"), Cons(idx_sx, Cons(st_i, Nil)))) in if op == "heap_write" and lk_sep_valid(base_a, hyps, lenv) == 0 and lk_svar_name(base_a) == "" then lk_lin_err() else if lk_prove_goal(SList(Cons(SVar("=="), Cons(idx_sx, Cons(st_i, Nil)))), hyps, lenv) == 1 then lk_lin_sexpr(st_v, hyps, lenv) else if lk_prove_goal(SList(Cons(SVar(">"), Cons(idx_sx, Cons(st_i, Nil)))), hyps, lenv) == 1 or lk_prove_goal(SList(Cons(SVar("<"), Cons(idx_sx, Cons(st_i, Nil)))), hyps, lenv) == 1 or lk_prove_goal(SList(Cons(SVar(">="), Cons(SList(Cons(SVar("*"), Cons(diff, Cons(diff, Nil)))), Cons(SNum(1), Nil)))), hyps, lenv) == 1 then lk_arr_select(base_a, idx_sx, hyps, lenv) else lk_lin_err() else if (op == "array_new" or op == "array_const") and lk_len(args) == 1 then lk_lin_sexpr(lk_shd(args), hyps, lenv) else if (op == "points_to" or op == "heap_new") and lk_len(args) == 2 then (if lk_prove_goal(SList(Cons(SVar("=="), Cons(idx_sx, Cons(lk_shd(args), Nil)))), hyps, lenv) == 1 then lk_lin_sexpr(lk_shd(lk_stl(args)), hyps, lenv) else lk_lin_err()) else if op == "sep_conj" and lk_len(args) == 2 then (if lk_sep_valid(arr_sx, hyps, lenv) == 0 then lk_lin_err() else let r1 = lk_arr_select(lk_shd(args), idx_sx, hyps, lenv) in if r1.ok == 1 then r1 else lk_arr_select(lk_shd(lk_stl(args)), idx_sx, hyps, lenv)) else lk_lin_err()
    SVar(anm) => let li = lk_lin_sexpr(idx_sx, hyps, lenv) in if li.ok == 0 then lk_lin_err() else let la = lk_env_lookup(anm, lenv) in if la.ok == 0 then lk_lin_err() else lk_lin_var("select(" + lk_lin_key_str(la) + "," + lk_lin_key_str(li) + ")")
    _         => lk_lin_err()

fn lk_xor_cancel(a, lb, hyps, lenv) = match a
    SList(xs) => if lk_len(xs) == 3 then let op = lk_svar_name(lk_shd(xs)) in if op == "bv_xor" or op == "bit_xor" then let x = lk_shd(lk_stl(xs)) in let k = lk_shd(lk_stl(lk_stl(xs))) in let lx = lk_lin_sexpr(x, hyps, lenv) in let lk = lk_lin_sexpr(k, hyps, lenv) in if lk.ok == 1 and lk_lin_eq(lk, lb) == 1 then lx else if lx.ok == 1 and lk_lin_eq(lx, lb) == 1 then lk else lk_lin_err() else lk_lin_err() else lk_lin_err()
    _         => lk_lin_err()
fn lk_and_idem(a, lb, hyps, lenv) = match a
    SList(xs) => if lk_len(xs) == 3 then let op = lk_svar_name(lk_shd(xs)) in if op == "bv_and" or op == "bit_and" then let lk = lk_lin_sexpr(lk_shd(lk_stl(lk_stl(xs))), hyps, lenv) in if lk.ok == 1 and lk_lin_eq(lk, lb) == 1 then lk_lin_sexpr(a, hyps, lenv) else lk_lin_err() else lk_lin_err() else lk_lin_err()
    _         => lk_lin_err()
fn lk_lin_bv_xor(a, b, hyps, lenv) = let la = lk_lin_sexpr(a, hyps, lenv) in let lb = lk_lin_sexpr(b, hyps, lenv) in if la.ok == 0 or lb.ok == 0 then lk_lin_err() else if lk_lin_eq(la, lb) == 1 then lk_lin_const(0) else if lk_lin_is_zero(la) == 1 then lb else if lk_lin_is_zero(lb) == 1 then la else if lk_isnil(la.cs) == 1 and lk_isnil(lb.cs) == 1 then (if la.c0 < 0 or la.c0 >= 65536 or lb.c0 < 0 or lb.c0 >= 65536 then lk_lin_err() else lk_lin_const(lk_bv_xor(la.c0, lb.c0, 16))) else let cx = lk_xor_cancel(a, lb, hyps, lenv) in if cx.ok == 1 then cx else let cy = lk_xor_cancel(b, la, hyps, lenv) in if cy.ok == 1 then cy else lk_lin_var("bv_xor(" + lk_mono_key(lk_lin_key_str(la), lk_lin_key_str(lb)) + ")")
fn lk_lin_bv_and(a, b, hyps, lenv) = let la = lk_lin_sexpr(a, hyps, lenv) in let lb = lk_lin_sexpr(b, hyps, lenv) in if la.ok == 0 or lb.ok == 0 then lk_lin_err() else if lk_lin_is_zero(la) == 1 or lk_lin_is_zero(lb) == 1 then lk_lin_const(0) else if lk_lin_eq(la, lb) == 1 then la else if lk_isnil(la.cs) == 1 and lk_isnil(lb.cs) == 1 then (if la.c0 < 0 or la.c0 >= 65536 or lb.c0 < 0 or lb.c0 >= 65536 then lk_lin_err() else lk_lin_const(lk_bv_and(la.c0, lb.c0, 16))) else let ci = lk_and_idem(a, lb, hyps, lenv) in if ci.ok == 1 then ci else if lk_isnil(lb.cs) == 1 and (lb.c0 == 1 or lb.c0 == 3 or lb.c0 == 7 or lb.c0 == 15 or lb.c0 == 31 or lb.c0 == 63 or lb.c0 == 127 or lb.c0 == 255) then (if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0 - 1), la), hyps)) == 1 and lk_fm_check_unsat(Cons(lk_lin_sub(la, lk_lin_const(lb.c0 + 1)), hyps)) == 1 then la else lk_lin_sub(la, lk_lin_scale(lb.c0 + 1, lk_lin_var("div(" + lk_lin_key_str(la) + "," + str(lb.c0 + 1) + ")")))) else lk_lin_var("bv_and(" + lk_mono_key(lk_lin_key_str(la), lk_lin_key_str(lb)) + ")")
fn lk_lin_bv_or(a, b, hyps, lenv) = let la = lk_lin_sexpr(a, hyps, lenv) in let lb = lk_lin_sexpr(b, hyps, lenv) in if la.ok == 0 or lb.ok == 0 then lk_lin_err() else if lk_lin_is_zero(la) == 1 then lb else if lk_lin_is_zero(lb) == 1 then la else if lk_lin_eq(la, lb) == 1 then la else if lk_isnil(la.cs) == 1 and lk_isnil(lb.cs) == 1 then (if la.c0 < 0 or la.c0 >= 65536 or lb.c0 < 0 or lb.c0 >= 65536 then lk_lin_err() else lk_lin_const(lk_bv_or(la.c0, lb.c0, 16))) else lk_lin_var("bv_or(" + lk_mono_key(lk_lin_key_str(la), lk_lin_key_str(lb)) + ")")
fn lk_lin_bv_u8(a, hyps, lenv) = let la = lk_lin_sexpr(a, hyps, lenv) in if la.ok == 0 then lk_lin_err() else if lk_isnil(la.cs) == 1 then lk_lin_const(lk_bv_mod(la.c0, 256)) else if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0 - 1), la), hyps)) == 1 and lk_fm_check_unsat(Cons(lk_lin_sub(la, lk_lin_const(256)), hyps)) == 1 then la else if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(255), la), hyps)) == 1 and lk_fm_check_unsat(Cons(lk_lin_sub(la, lk_lin_const(512)), hyps)) == 1 then lk_lin_sub(la, lk_lin_const(256)) else lk_lin_sub(la, lk_lin_scale(256, lk_lin_var("div(" + lk_lin_key_str(la) + ",256)")))

fn lk_mem_int(x, xs) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else lk_mem_int(x, t)
fn lk_lin_add_k(k, ks) = if k < 0 or lk_mem_int(k, ks) == 1 then ks else Cons(k, ks)
fn lk_lin_cand_ks(vb, hyps, acc) = match hyps
    Nil        => acc
    Cons(h, t) => let c = lk_lin_coeff(vb, h.cs) in let a = if c < 0 then 0 - c else c in lk_lin_cand_ks(vb, t, if a > 0 then lk_lin_add_k(a - 1, lk_lin_add_k(a, acc)) else acc)
fn lk_lin_vardiv_ratios(la, lb, q, ks, hyps) = match ks
    Nil        => Nil
    Cons(k, r) => let rest = lk_lin_vardiv_ratios(la, lb, q, r, hyps) in let r1 = if lk_fm_check_unsat(Cons(lk_lin_sub(la, lk_lin_scale(k + 1, lb)), hyps)) == 1 then Cons(lk_lin_sub(lk_lin_const(k), q), rest) else rest in if k > 0 and lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_sub(lk_lin_scale(k, lb), la), lk_lin_const(1)), hyps)) == 1 then Cons(lk_lin_sub(q, lk_lin_const(k)), r1) else r1
fn lk_lin_vardiv_hyps(la, lb, q, hyps) = if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0 - 1), la), hyps)) == 0 or lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0), lb), hyps)) == 0 then Nil else let ks = lk_lin_cand_ks((lk_phd_cs(lb.cs)).k, hyps, Cons(0, Cons(1, Cons(2, Cons(10, Cons(100, Nil)))))) in let base = Cons(q, Cons(lk_lin_sub(la, q), lk_lin_vardiv_ratios(la, lb, q, ks, hyps))) in let b0 = if lk_lin_eq(la, lb) == 1 then Cons(lk_lin_sub(q, lk_lin_const(1)), Cons(lk_lin_sub(lk_lin_const(1), q), base)) else base in if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0), la), hyps)) == 1 and lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(1), lb), hyps)) == 1 then Cons(lk_lin_sub(lk_lin_sub(la, q), lk_lin_const(1)), b0) else b0
## `%` truncates toward zero, so for b >= 1 (entailed) and ANY a: -(b - 1) <= a % b <= b - 1. That two-sided bound is
## all that is asserted when the sign of a is unknown; the sharper facts below (a % b >= 0, a % b <= a, ...) still
## need a >= 0. Without b >= 1 nothing is asserted.
fn lk_lin_varmod_hyps(la, lb, m, hyps) = if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0), lb), hyps)) == 0 then Nil else if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0 - 1), la), hyps)) == 0 then Cons(lk_lin_sub(lk_lin_sub(lb, lk_lin_const(1)), m), Cons(lk_lin_add(m, lk_lin_sub(lb, lk_lin_const(1))), Nil)) else let base = Cons(m, Cons(lk_lin_sub(lk_lin_sub(lb, lk_lin_const(1)), m), Cons(lk_lin_sub(la, m), Nil))) in if lk_lin_eq(la, lb) == 1 then Cons(lk_lin_sub(lk_lin_const(0), m), base) else if lk_fm_check_unsat(Cons(lk_lin_sub(la, lb), hyps)) == 1 then Cons(lk_lin_sub(m, la), base) else base

fn lk_collect_div_hyps_sx(sx, hyps, lenv) = match sx
    SList(xs) => if lk_isnil(xs) == 1 then Nil else let op = lk_svar_name(lk_shd(xs)) in let args = lk_stl(xs) in let h1 = lk_collect_div_hyps_list(args, hyps, lenv) in let hcur = lk_app(h1, hyps) in if (op == "/" or op == "%") and lk_len(args) == 2 then let la = lk_lin_sexpr(lk_shd(args), hcur, lenv) in let lb = lk_lin_sexpr(lk_shd(lk_stl(args)), hcur, lenv) in if la.ok == 1 and lb.ok == 1 and lk_isnil(lb.cs) == 1 and lb.c0 > 0 then lk_app(lk_lin_div_hyps(la, lb.c0, lk_lin_var("div(" + lk_lin_key_str(la) + "," + str(lb.c0) + ")"), hcur), h1) else if op == "/" and la.ok == 1 and lb.ok == 1 and lk_isnil(lb.cs) == 0 then lk_app(lk_lin_vardiv_hyps(la, lb, lk_lin_var("div(" + lk_lin_key_str(la) + "," + lk_lin_key_str(lb) + ")"), hcur), h1) else if op == "%" and la.ok == 1 and lb.ok == 1 and lk_isnil(lb.cs) == 0 then lk_app(lk_lin_varmod_hyps(la, lb, lk_lin_var("mod(" + lk_lin_key_str(la) + "," + lk_lin_key_str(lb) + ")"), hcur), h1) else h1 else if (op == "bv_and" or op == "bit_and") and lk_len(args) == 2 then let la = lk_lin_sexpr(lk_shd(args), hcur, lenv) in let lb = lk_lin_sexpr(lk_shd(lk_stl(args)), hcur, lenv) in if la.ok == 1 and lb.ok == 1 and lk_isnil(lb.cs) == 1 and (lb.c0 == 1 or lb.c0 == 3 or lb.c0 == 7 or lb.c0 == 15 or lb.c0 == 31 or lb.c0 == 63 or lb.c0 == 127 or lb.c0 == 255) then lk_app(lk_lin_u_div_hyps(la, lb.c0 + 1, lk_lin_var("div(" + lk_lin_key_str(la) + "," + str(lb.c0 + 1) + ")")), h1) else h1 else if (op == "bv_u8" or op == "bv_not_u8") and lk_len(args) == 1 then let la = lk_lin_sexpr(lk_shd(args), hcur, lenv) in if la.ok == 1 then lk_app(lk_lin_u_div_hyps(la, 256, lk_lin_var("div(" + lk_lin_key_str(la) + ",256)")), h1) else h1 else if op == "bv_add_u8" and lk_len(args) == 2 then let la = lk_lin_sexpr(SList(Cons(SVar("+"), args)), hcur, lenv) in if la.ok == 1 then lk_app(lk_lin_u_div_hyps(la, 256, lk_lin_var("div(" + lk_lin_key_str(la) + ",256)")), h1) else h1 else h1
    _         => Nil
fn lk_collect_div_hyps_list(xs, hyps, lenv) = match xs
    Nil        => Nil
    Cons(h, t) => lk_app(lk_collect_div_hyps_sx(h, hyps, lenv), lk_collect_div_hyps_list(t, hyps, lenv))

fn lk_env_lookup(nm, lenv) = match lenv
    Nil        => if lk_is_ident(nm) == 1 then lk_lin_var(nm) else lk_lin_err()
    Cons(h, t) => if h.k == nm then h.v else lk_env_lookup(nm, t)

fn lk_norm_if_changed(c) = match c
    SList(cxs) => if lk_len(cxs) == 3 and (lk_svar_name(lk_shd(cxs)) == "and" or lk_svar_name(lk_shd(cxs)) == "or") or lk_len(cxs) == 4 and lk_svar_name(lk_shd(cxs)) == "if" then 1 else 0
    _          => 0

fn lk_norm_if(c, t, e2) = match c
    SList(cxs) => let cop = lk_svar_name(lk_shd(cxs)) in let a = lk_shd(lk_stl(cxs)) in let b = lk_shd(lk_stl(lk_stl(cxs))) in if cop == "and" then SList(Cons(SVar("if"), Cons(a, Cons(SList(Cons(SVar("if"), Cons(b, Cons(t, Cons(e2, Nil))))), Cons(e2, Nil))))) else if cop == "or" then SList(Cons(SVar("if"), Cons(a, Cons(t, Cons(SList(Cons(SVar("if"), Cons(b, Cons(t, Cons(e2, Nil))))), Nil))))) else if cop == "if" and lk_len(cxs) == 4 then let c3 = lk_shd(lk_stl(lk_stl(lk_stl(cxs)))) in SList(Cons(SVar("if"), Cons(a, Cons(SList(Cons(SVar("if"), Cons(b, Cons(t, Cons(e2, Nil))))), Cons(SList(Cons(SVar("if"), Cons(c3, Cons(t, Cons(e2, Nil))))), Nil))))) else SList(Cons(SVar("if"), Cons(c, Cons(t, Cons(e2, Nil)))))
    _          => SList(Cons(SVar("if"), Cons(c, Cons(t, Cons(e2, Nil)))))

fn lk_lin_sexpr(sx, hyps, lenv) = match sx
    SNum(n)   => lk_lin_const(n)
    SVar(nm)  => lk_env_lookup(nm, lenv)
    SList(xs) => lk_lin_slist(xs, hyps, lenv)

fn lk_field_root(sx, hyps, lenv) = match sx
    SVar(nm)  => let lv = lk_env_lookup(nm, lenv) in if lv.ok == 1 then lk_lin_key_str(lv) else ""
    SList(xs) => if lk_len(xs) == 3 and lk_svar_name(lk_shd(xs)) == "field" then let r = lk_field_root(lk_shd(lk_stl(xs)), hyps, lenv) in let fnm = lk_svar_name(lk_shd(lk_stl(lk_stl(xs)))) in if r == "" or lk_is_ident(fnm) == 0 then "" else r + "." + fnm else ""
    _         => ""

## bit_shl wraps silently at runtime, unlike the trapping `*`: `a * 2^k` is sound only when hyps prove |a| <= 2^46 (k <= 16).
fn lk_shl_fits(a, k, hyps, lenv) = let lim = sha_pow2(46) in if lk_prove_goal(SList(Cons(SVar(">="), Cons(a, Cons(SList(Cons(SVar("-"), Cons(SNum(0), Cons(SNum(lim), Nil)))), Nil)))), hyps, lenv) == 1 and lk_prove_goal(SList(Cons(SVar("<="), Cons(a, Cons(SNum(lim), Nil)))), hyps, lenv) == 1 then 1 else 0
fn lk_lin_slist(xs, hyps, lenv) = if lk_isnil(xs) == 1 then lk_lin_err() else let op = lk_svar_name(lk_shd(xs)) in let args = lk_stl(xs) in if (op == "+" or op == "-" or op == "*" or op == "/" or op == "%") and lk_len(args) == 2 then let la = lk_lin_sexpr(lk_shd(args), hyps, lenv) in let lb = lk_lin_sexpr(lk_shd(lk_stl(args)), hyps, lenv) in if op == "+" then lk_lin_add(la, lb) else if op == "-" then lk_lin_sub(la, lb) else if op == "*" then lk_lin_mul(la, lb) else if op == "/" then (if la.ok == 0 or lb.ok == 0 then lk_lin_err() else if lk_isnil(lb.cs) == 1 then (if lb.c0 <= 0 then lk_lin_err() else if lk_isnil(la.cs) == 1 then lk_lin_const(la.c0 / lb.c0) else if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0 - 1), la), hyps)) == 1 then lk_lin_var("div(" + lk_lin_key_str(la) + "," + str(lb.c0) + ")") else lk_lin_err()) else if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0), lb), hyps)) == 1 then lk_lin_var("div(" + lk_lin_key_str(la) + "," + lk_lin_key_str(lb) + ")") else lk_lin_err()) else if la.ok == 0 or lb.ok == 0 then lk_lin_err() else if lk_isnil(lb.cs) == 1 then (if lb.c0 <= 0 then lk_lin_err() else if lk_isnil(la.cs) == 1 then lk_lin_const(la.c0 % lb.c0) else if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0 - 1), la), hyps)) == 1 then lk_lin_sub(la, lk_lin_scale(lb.c0, lk_lin_var("div(" + lk_lin_key_str(la) + "," + str(lb.c0) + ")"))) else lk_lin_err()) else if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_const(0), lb), hyps)) == 1 then lk_lin_var("mod(" + lk_lin_key_str(la) + "," + lk_lin_key_str(lb) + ")") else lk_lin_err() else if (op == "let" or op == "var") and lk_len(args) == 3 then let vnm = lk_svar_name(lk_shd(args)) in let v_sx = lk_shd(lk_stl(args)) in let b_sx = lk_shd(lk_stl(lk_stl(args))) in if vnm == "" then lk_lin_err() else if lk_is_struct_sx(v_sx) == 1 then lk_lin_sexpr(lk_subst_sx(b_sx, vnm, v_sx), hyps, lenv) else let lv = lk_lin_sexpr(v_sx, hyps, lenv) in if lv.ok == 0 then lk_lin_err() else lk_lin_sexpr(b_sx, hyps, Cons({k: vnm, v: lv}, lenv)) else if op == "if" and lk_len(args) == 3 then let c = lk_shd(args) in let t = lk_shd(lk_stl(args)) in let e2 = lk_shd(lk_stl(lk_stl(args))) in if lk_norm_if_changed(c) == 1 then lk_lin_sexpr(lk_norm_if(c, t, e2), hyps, lenv) else let rp = lk_cond_pos(c, hyps, lenv) in let rn = lk_cond_neg(c, hyps, lenv) in if rp.ok == 1 and rn.ok == 1 and lk_fm_check_unsat(lk_app(rn.hyps, hyps)) == 1 then lk_lin_sexpr(t, hyps, lenv) else if rp.ok == 1 and rn.ok == 1 and lk_fm_check_unsat(lk_app(rp.hyps, hyps)) == 1 then lk_lin_sexpr(e2, hyps, lenv) else lk_lin_err() else if (op == "bv_xor" or op == "bit_xor") and lk_len(args) == 2 then lk_lin_bv_xor(lk_shd(args), lk_shd(lk_stl(args)), hyps, lenv) else if (op == "bv_and" or op == "bit_and") and lk_len(args) == 2 then lk_lin_bv_and(lk_shd(args), lk_shd(lk_stl(args)), hyps, lenv) else if (op == "bv_or" or op == "bit_or") and lk_len(args) == 2 then lk_lin_bv_or(lk_shd(args), lk_shd(lk_stl(args)), hyps, lenv) else if (op == "bv_shl" or op == "bit_shl") and lk_len(args) == 2 then let la = lk_lin_sexpr(lk_shd(args), hyps, lenv) in let lk = lk_lin_sexpr(lk_shd(lk_stl(args)), hyps, lenv) in if la.ok == 1 and lk.ok == 1 and lk_isnil(lk.cs) == 1 and lk.c0 >= 0 then (if lk_isnil(la.cs) == 1 then (if lk.c0 < 62 and lk_lin_mul_ovf(la.c0, sha_pow2(lk.c0)) == 0 then lk_lin_const(la.c0 * sha_pow2(lk.c0)) else lk_lin_err()) else if lk.c0 <= 16 and lk_shl_fits(lk_shd(args), lk.c0, hyps, lenv) == 1 then lk_lin_scale(sha_pow2(lk.c0), la) else lk_lin_err()) else lk_lin_err() else if (op == "bv_shr" or op == "bit_shr") and lk_len(args) == 2 then let la = lk_lin_sexpr(lk_shd(args), hyps, lenv) in let lk = lk_lin_sexpr(lk_shd(lk_stl(args)), hyps, lenv) in if la.ok == 1 and lk.ok == 1 and lk_isnil(lk.cs) == 1 and lk.c0 >= 0 and lk.c0 < 63 then (if lk_isnil(la.cs) == 1 and la.c0 >= 0 then lk_lin_const(la.c0 / sha_pow2(lk.c0)) else lk_lin_var("shr(" + lk_lin_key_str(la) + "," + str(lk.c0) + ")")) else lk_lin_err() else if op == "bv_u8" and lk_len(args) == 1 then lk_lin_bv_u8(lk_shd(args), hyps, lenv) else if op == "bv_not_u8" and lk_len(args) == 1 then lk_lin_sub(lk_lin_const(255), lk_lin_bv_u8(lk_shd(args), hyps, lenv)) else if op == "bv_add_u8" and lk_len(args) == 2 then lk_lin_bv_u8(SList(Cons(SVar("+"), args)), hyps, lenv) else if op == "bv_sub_u8" and lk_len(args) == 2 then lk_lin_bv_u8(SList(Cons(SVar("-"), args)), hyps, lenv) else if (op == "array_select" or op == "heap_read") and lk_len(args) == 2 then lk_arr_select(lk_shd(args), lk_shd(lk_stl(args)), hyps, lenv) else if op == "sep_valid" and lk_len(args) == 1 then (if lk_sep_valid(lk_shd(args), hyps, lenv) == 1 then lk_lin_const(1) else lk_lin_err()) else if op == "sep_disjoint" and lk_len(args) == 2 then (if lk_prove_goal(SList(Cons(SVar("!="), args)), hyps, lenv) == 1 then lk_lin_const(1) else lk_lin_err()) else if op == "forall_range" and lk_len(args) == 4 then (if lk_prove_forall_range(args, hyps, lenv) == 1 then lk_lin_const(1) else lk_lin_err()) else if op == "exists_range" and lk_len(args) == 4 then (if lk_prove_exists_range(args, hyps, lenv) == 1 then lk_lin_const(1) else lk_lin_err()) else if op == "field" and lk_len(args) == 2 then let rt = lk_field_root(lk_shd(args), hyps, lenv) in let fnm = lk_svar_name(lk_shd(lk_stl(args))) in if rt == "" or lk_is_ident(fnm) == 0 then lk_lin_err() else lk_lin_var("field(" + rt + "." + fnm + ")") else lk_lin_err()

fn lk_cmp_pos_hyps(op, la, lb, hyps) = if la.ok == 0 or lb.ok == 0 then {ok: 0, hyps: Nil} else if op == ">=" then {ok: 1, hyps: Cons(lk_lin_sub(la, lb), Nil)} else if op == ">" then {ok: 1, hyps: Cons(lk_lin_sub(lk_lin_sub(la, lb), lk_lin_const(1)), Nil)} else if op == "<=" then {ok: 1, hyps: Cons(lk_lin_sub(lb, la), Nil)} else if op == "<" then {ok: 1, hyps: Cons(lk_lin_sub(lk_lin_sub(lb, la), lk_lin_const(1)), Nil)} else if op == "==" then {ok: 1, hyps: Cons(lk_lin_sub(la, lb), Cons(lk_lin_sub(lb, la), Nil))} else if op == "!=" then let d = lk_lin_sub(la, lb) in let base = Cons(lk_lin_sub(lk_lin_mul(d, d), lk_lin_const(1)), Nil) in let b1 = if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_sub(lb, la), lk_lin_const(1)), hyps)) == 1 then Cons(lk_lin_sub(lk_lin_sub(la, lb), lk_lin_const(1)), base) else base in let b2 = if lk_fm_check_unsat(Cons(lk_lin_sub(lk_lin_sub(la, lb), lk_lin_const(1)), hyps)) == 1 then Cons(lk_lin_sub(lk_lin_sub(lb, la), lk_lin_const(1)), b1) else b1 in {ok: 1, hyps: b2} else {ok: 0, hyps: Nil}
fn lk_cmp_neg_hyps(op, la, lb, hyps) = if la.ok == 0 or lb.ok == 0 then {ok: 0, hyps: Nil} else if op == ">=" then lk_cmp_pos_hyps("<", la, lb, hyps) else if op == ">" then lk_cmp_pos_hyps("<=", la, lb, hyps) else if op == "<=" then lk_cmp_pos_hyps(">", la, lb, hyps) else if op == "<" then lk_cmp_pos_hyps(">=", la, lb, hyps) else if op == "!=" then lk_cmp_pos_hyps("==", la, lb, hyps) else if op == "==" then lk_cmp_pos_hyps("!=", la, lb, hyps) else {ok: 0, hyps: Nil}
fn lk_cmp_pos(op, la, lb) = lk_cmp_pos_hyps(op, la, lb, Nil)
fn lk_cmp_neg(op, la, lb) = lk_cmp_neg_hyps(op, la, lb, Nil)

fn lk_cond_pos(sx, hyps, lenv) = match sx
    SList(xs) => if lk_isnil(xs) == 1 then {ok: 0, hyps: Nil} else let op = lk_svar_name(lk_shd(xs)) in let args = lk_stl(xs) in if op == "and" then lk_cond_pos_list(args, hyps, lenv) else if op == "sep_disjoint" and lk_len(args) == 2 then lk_cmp_neg_hyps("==", lk_lin_sexpr(lk_shd(args), hyps, lenv), lk_lin_sexpr(lk_shd(lk_stl(args)), hyps, lenv), hyps) else if lk_len(args) == 2 then lk_cmp_pos_hyps(op, lk_lin_sexpr(lk_shd(args), hyps, lenv), lk_lin_sexpr(lk_shd(lk_stl(args)), hyps, lenv), hyps) else {ok: 0, hyps: Nil}
    _         => {ok: 0, hyps: Nil}

fn lk_cond_pos_list(xs, hyps, lenv) = match xs
    Nil        => {ok: 1, hyps: Nil}
    Cons(h, t) => let r1 = lk_cond_pos(h, hyps, lenv) in if r1.ok == 0 then {ok: 0, hyps: Nil} else let r2 = lk_cond_pos_list(t, lk_app(r1.hyps, hyps), lenv) in if r2.ok == 0 then {ok: 0, hyps: Nil} else {ok: 1, hyps: lk_app(r1.hyps, r2.hyps)}

fn lk_cond_neg(sx, hyps, lenv) = match sx
    SList(xs) => if lk_len(xs) == 3 then let op = lk_svar_name(lk_shd(xs)) in let a1 = lk_shd(lk_stl(xs)) in let a2 = lk_shd(lk_stl(lk_stl(xs))) in if op == "or" then let r1 = lk_cond_neg(a1, hyps, lenv) in let r2 = lk_cond_neg(a2, hyps, lenv) in if r1.ok == 1 and r2.ok == 1 then {ok: 1, hyps: lk_app(r1.hyps, r2.hyps)} else {ok: 0, hyps: Nil} else if op == "sep_disjoint" then lk_cmp_pos_hyps("==", lk_lin_sexpr(a1, hyps, lenv), lk_lin_sexpr(a2, hyps, lenv), hyps) else lk_cmp_neg_hyps(op, lk_lin_sexpr(a1, hyps, lenv), lk_lin_sexpr(a2, hyps, lenv), hyps) else {ok: 0, hyps: Nil}
    _         => {ok: 0, hyps: Nil}

fn lk_filter_no_var(v, hyps) = match hyps
    Nil        => Nil
    Cons(h, t) => if lk_lin_coeff(v, h.cs) == 0 then Cons(h, lk_filter_no_var(v, t)) else lk_filter_no_var(v, t)

fn lk_prove_forall_range(args, hyps, lenv) = let vnm = lk_svar_name(lk_shd(args)) in let lo_sx = lk_shd(lk_stl(args)) in let hi_sx = lk_shd(lk_stl(lk_stl(args))) in let pred_sx = lk_shd(lk_stl(lk_stl(lk_stl(args)))) in let llo = lk_lin_sexpr(lo_sx, hyps, lenv) in let lhi = lk_lin_sexpr(hi_sx, hyps, lenv) in if vnm == "" or llo.ok == 0 or lhi.ok == 0 then 0 else let qnm = "(q " + str(lk_len(lenv)) + " " + vnm + ")" in let lv = lk_lin_var(qnm) in let hyps0 = lk_filter_no_var(qnm, hyps) in let hyps2 = Cons(lk_lin_sub(lv, llo), Cons(lk_lin_sub(lhi, lv), hyps0)) in lk_prove_goal(pred_sx, hyps2, Cons({k: vnm, v: lv}, lenv))
fn lk_prove_exists_w(vnm, w, lo_sx, hi_sx, pred_sx, ctx) = if lk_prove_goal(SList(Cons(SVar(">="), Cons(w, Cons(lo_sx, Nil)))), ctx.hyps, ctx.lenv) == 1 and lk_prove_goal(SList(Cons(SVar("<="), Cons(w, Cons(hi_sx, Nil)))), ctx.hyps, ctx.lenv) == 1 and lk_prove_goal(lk_subst_sx(pred_sx, vnm, w), ctx.hyps, ctx.lenv) == 1 then 1 else 0
fn lk_prove_exists_list(vnm, ws, lo_sx, hi_sx, pred_sx, ctx) = match ws
    Nil         => 0
    Cons(w, wr) => if lk_prove_exists_w(vnm, w, lo_sx, hi_sx, pred_sx, ctx) == 1 then 1 else lk_prove_exists_list(vnm, wr, lo_sx, hi_sx, pred_sx, ctx)
fn lk_prove_exists_range(args, hyps, lenv) = let vnm = lk_svar_name(lk_shd(args)) in let lo_sx = lk_shd(lk_stl(args)) in let hi_sx = lk_shd(lk_stl(lk_stl(args))) in let pred_sx = lk_shd(lk_stl(lk_stl(lk_stl(args)))) in if vnm == "" then 0 else let ws = Cons(lo_sx, Cons(hi_sx, Cons(SList(Cons(SVar("+"), Cons(lo_sx, Cons(SNum(1), Nil)))), Cons(SList(Cons(SVar("-"), Cons(hi_sx, Cons(SNum(1), Nil)))), Cons(SList(Cons(SVar("/"), Cons(SList(Cons(SVar("+"), Cons(lo_sx, Cons(hi_sx, Nil)))), Cons(SNum(2), Nil)))), Nil))))) in lk_prove_exists_list(vnm, ws, lo_sx, hi_sx, pred_sx, {hyps: hyps, lenv: lenv})

fn lk_prove_goal(g, hyps, lenv) = match g
    SNum(n)   => if n != 0 then 1 else 0
    SVar(nm)  => if nm == "true" then 1 else 0
    SList(xs) => lk_prove_goal_list(g, xs, hyps, lenv)
    _         => 0

fn lk_prove_goal_list(g, xs, hyps, lenv) = if lk_isnil(xs) == 1 then 0 else let op = lk_svar_name(lk_shd(xs)) in let args = lk_stl(xs) in if (op == "let" or op == "var") and lk_len(args) == 3 then let vnm = lk_svar_name(lk_shd(args)) in let v_sx = lk_shd(lk_stl(args)) in let b_sx = lk_shd(lk_stl(lk_stl(args))) in if vnm == "" then 0 else lk_prove_let_val(vnm, v_sx, b_sx, hyps, lenv) else if op == "if" and lk_len(args) == 3 then let c = lk_shd(args) in let t = lk_shd(lk_stl(args)) in let e2 = lk_shd(lk_stl(lk_stl(args))) in if lk_norm_if_changed(c) == 1 then lk_prove_goal(lk_norm_if(c, t, e2), hyps, lenv) else let rp = lk_cond_pos(c, hyps, lenv) in let rn = lk_cond_neg(c, hyps, lenv) in if rp.ok == 1 and rn.ok == 1 and lk_prove_goal(t, lk_app(rp.hyps, hyps), lenv) == 1 and lk_prove_goal(e2, lk_app(rn.hyps, hyps), lenv) == 1 then 1 else 0 else if op == "and" and lk_len(args) == 2 then (if lk_prove_goal(lk_shd(args), hyps, lenv) == 1 and lk_prove_goal(lk_shd(lk_stl(args)), hyps, lenv) == 1 then 1 else 0) else if op == "or" and lk_len(args) == 2 then let a = lk_shd(args) in let b = lk_shd(lk_stl(args)) in if lk_prove_goal(a, hyps, lenv) == 1 or lk_prove_goal(b, hyps, lenv) == 1 then 1 else let rna = lk_cond_neg(a, hyps, lenv) in if rna.ok == 1 and lk_prove_goal(b, lk_app(rna.hyps, hyps), lenv) == 1 then 1 else let rnb = lk_cond_neg(b, hyps, lenv) in if rnb.ok == 1 and lk_prove_goal(a, lk_app(rnb.hyps, hyps), lenv) == 1 then 1 else 0 else if op == "==" and lk_len(args) == 2 then let a = lk_shd(args) in let b = lk_shd(lk_stl(args)) in if lk_prove_goal(SList(Cons(SVar(">="), Cons(a, Cons(b, Nil)))), hyps, lenv) == 1 and lk_prove_goal(SList(Cons(SVar("<="), Cons(a, Cons(b, Nil)))), hyps, lenv) == 1 then 1 else 0 else if (op == "!=" or op == "sep_disjoint") and lk_len(args) == 2 then let a = lk_shd(args) in let b = lk_shd(lk_stl(args)) in let dab = SList(Cons(SVar("-"), Cons(a, Cons(b, Nil)))) in if lk_prove_goal(SList(Cons(SVar(">"), Cons(a, Cons(b, Nil)))), hyps, lenv) == 1 or lk_prove_goal(SList(Cons(SVar("<"), Cons(a, Cons(b, Nil)))), hyps, lenv) == 1 or lk_prove_goal(SList(Cons(SVar(">="), Cons(SList(Cons(SVar("*"), Cons(dab, Cons(dab, Nil)))), Cons(SNum(1), Nil)))), hyps, lenv) == 1 then 1 else 0 else if op == "sep_valid" and lk_len(args) == 1 then lk_sep_valid(lk_shd(args), hyps, lenv) else if op == "sep_conj" and lk_len(args) == 2 then lk_sep_valid(g, hyps, lenv) else if op == "forall_range" and lk_len(args) == 4 then lk_prove_forall_range(args, hyps, lenv) else if op == "exists_range" and lk_len(args) == 4 then lk_prove_exists_range(args, hyps, lenv) else let dhyps = lk_app(lk_collect_div_hyps_sx(g, hyps, lenv), hyps) in let rn = lk_cond_neg(g, dhyps, lenv) in if rn.ok == 1 then (if lk_fm_check_unsat(lk_app(rn.hyps, dhyps)) == 1 then 1 else lk_fm_check_unsat(lk_app(rn.hyps, lk_nia_enrich_hyps(rn.hyps, dhyps)))) else 0

fn lk_prove_let_val(vnm, v_sx, b_sx, hyps, lenv) = match v_sx
    SList(vxs) => if lk_len(vxs) == 4 and lk_svar_name(lk_shd(vxs)) == "if" then let c = lk_shd(lk_stl(vxs)) in let t = lk_shd(lk_stl(lk_stl(vxs))) in let e2 = lk_shd(lk_stl(lk_stl(lk_stl(vxs)))) in if lk_norm_if_changed(c) == 1 then lk_prove_let_val(vnm, lk_norm_if(c, t, e2), b_sx, hyps, lenv) else let rp = lk_cond_pos(c, hyps, lenv) in let rn = lk_cond_neg(c, hyps, lenv) in if rp.ok == 1 and rn.ok == 1 and lk_prove_let_val(vnm, t, b_sx, lk_app(rp.hyps, hyps), lenv) == 1 and lk_prove_let_val(vnm, e2, b_sx, lk_app(rn.hyps, hyps), lenv) == 1 then 1 else 0 else if lk_is_struct_sx(v_sx) == 1 then lk_prove_goal(lk_subst_sx(b_sx, vnm, v_sx), hyps, lenv) else let lv = lk_lin_sexpr(v_sx, hyps, lenv) in if lv.ok == 0 then 0 else lk_prove_goal(b_sx, lk_app(lk_collect_div_hyps_sx(v_sx, hyps, lenv), hyps), Cons({k: vnm, v: lv}, lenv))
    _          => let lv = lk_lin_sexpr(v_sx, hyps, lenv) in if lv.ok == 0 then 0 else lk_prove_goal(b_sx, lk_app(lk_collect_div_hyps_sx(v_sx, hyps, lenv), hyps), Cons({k: vnm, v: lv}, lenv))

fn lk_prove_with_req_list(reqs, goal_sx, hyps) = match reqs
    Nil        => lk_prove_goal(goal_sx, hyps, Nil)
    Cons(h, t) => lk_prove_with_req1(h, t, goal_sx, hyps)

fn lk_prove_with_req1(req, rest_reqs, goal_sx, hyps) = match req
    SList(rxs) => if lk_isnil(rxs) == 1 then 0 else let rop = lk_svar_name(lk_shd(rxs)) in let rargs = lk_stl(rxs) in if rop == "and" then lk_prove_with_req_list(lk_app(rargs, rest_reqs), goal_sx, hyps) else if rop == "or" and lk_len(rargs) == 2 then (if lk_prove_with_req_list(Cons(lk_shd(rargs), rest_reqs), goal_sx, hyps) == 1 and lk_prove_with_req_list(Cons(lk_shd(lk_stl(rargs)), rest_reqs), goal_sx, hyps) == 1 then 1 else 0) else let r1 = lk_cond_pos(req, hyps, Nil) in if r1.ok == 0 then 0 else lk_prove_with_req_list(rest_reqs, goal_sx, lk_app(r1.hyps, hyps))
    _          => let r1 = lk_cond_pos(req, hyps, Nil) in if r1.ok == 0 then 0 else lk_prove_with_req_list(rest_reqs, goal_sx, lk_app(r1.hyps, hyps))

fn lk_prove_implies_sx(sx) = match sx
    SList(xs) => if lk_len(xs) == 3 and lk_svar_name(lk_shd(xs)) == "implies" then let reqs_sx = lk_shd(lk_stl(xs)) in let goal_sx = lk_shd(lk_stl(lk_stl(xs))) in let rh = lk_cond_pos(reqs_sx, Nil, Nil) in if rh.ok == 1 then lk_prove_goal(goal_sx, rh.hyps, Nil) else lk_prove_with_req_list(Cons(reqs_sx, Nil), goal_sx, Nil) else 0
    _         => 0

## --- Inductive Temporal & Termination Verification (`temporal-*` & `terminates`, F1 & F3) ---
## Formal semantics:
##   - `temporal-always` / `temporal-eventually` / `temporal-until`: discrete transition-system
##     inductive step implications in QF_LIA (`init => inv` and `(inv /\ step) => inv'`, plus
##     ranking-function positivity and strict decrease across transitions for liveness/until).
##   - `terminates`: `(terminates f (measure M1 .. Mk) (call H A1 .. Ak) ...)`, one `call` per recursive call of f,
##     H its path hypothesis `(and ...)` and Ai the measure evaluated at the callee. The KERNEL builds and proves the
##     descent goals itself: for some i, H => Aj == Mj for every j < i, H => Ai < Mi and H => Mi >= 0. A bare
##     measure, a parameter list, or any formula that merely happens to be true is not a termination proof and is
##     rejected (the former kernel accepted `(terminates f (n))` on the word of whoever wrote it).
fn lk_is_op_sym(s) = if s == "implies" or s == "and" or s == "or" or s == "not" or s == ">=" or s == ">" or s == "<=" or s == "<" or s == "==" or s == "!=" or s == "+" or s == "-" or s == "*" or s == "/" or s == "%" or s == "let" or s == "var" or s == "if" or s == "false" or s == "refuted" or s == "terminates" or s == "forall_range" or s == "exists_range" then 1 else 0

fn lk_mk3(op, a, b) = SList(Cons(SVar(op), Cons(a, Cons(b, Nil))))
fn lk_term_lex(h, avs, ms) = match avs
    Nil         => 0
    Cons(a, ar) => lk_term_lex1(h, a, ar, ms)
fn lk_term_lex1(h, a, ar, ms) = match ms
    Nil         => 0
    Cons(m, mr) => if lk_prove_implies_sx(lk_mk3("implies", h, lk_mk3("<", a, m))) == 1 and lk_prove_implies_sx(lk_mk3("implies", h, lk_mk3(">=", m, SNum(0)))) == 1 then 1 else if lk_prove_implies_sx(lk_mk3("implies", h, lk_mk3("==", a, m))) == 1 then lk_term_lex(h, ar, mr) else 0
fn lk_term_call(c, ms) = match c
    SList(xs) => if lk_svar_name(lk_shd(xs)) == "call" and lk_len(xs) == lk_len(ms) + 2 then lk_term_lex(lk_shd(lk_stl(xs)), lk_stl(lk_stl(xs)), ms) else 0
    _         => 0
fn lk_term_calls(calls, ms) = match calls
    Nil        => 1
    Cons(c, r) => if lk_term_call(c, ms) == 1 then lk_term_calls(r, ms) else 0
fn lk_term_measures(m_sx) = match m_sx
    SList(xs) => if lk_svar_name(lk_shd(xs)) == "measure" then lk_stl(xs) else Nil
    _         => Nil
## at least one measure and at least one call: a function that does not recurse has nothing to prove and gets no term
fn lk_prove_terminates(xs) = let ms = lk_term_measures(lk_shd(lk_stl(lk_stl(xs)))) in let calls = lk_stl(lk_stl(lk_stl(xs))) in if lk_svar_name(lk_shd(lk_stl(xs))) == "" or lk_isnil(ms) == 1 or lk_isnil(calls) == 1 then 0 else lk_term_calls(calls, ms)

fn lk_prove_all_implies(xs) = match xs
    Nil        => 1
    Cons(h, t) => if lk_prove_implies_sx(h) == 1 then lk_prove_all_implies(t) else 0

fn lk_prove_sx(sx) = match sx
    SList(xs) => let tag = lk_svar_name(lk_shd(xs)) in if tag == "implies" then lk_prove_implies_sx(sx) else if tag == "terminates" then (if lk_len(xs) >= 4 then lk_prove_terminates(xs) else 0) else if (tag == "temporal-always" or tag == "temporal-eventually") and lk_len(xs) == 3 then lk_prove_all_implies(lk_stl(xs)) else if tag == "temporal-until" and lk_len(xs) == 5 then lk_prove_all_implies(lk_stl(xs)) else lk_prove_goal(sx, Nil, Nil)
    _         => 0

fn lk_prove_term(term_str) = let n = count(term_str) in let r = lk_parse_sexpr(term_str, 0, n) in if r.ok == 1 and lk_skip_ws(term_str, r.next, n) == n then lk_prove_sx(r.node) else 0

## --- 4. Independent WCET Structural Budget Checker ---
fn lk_find_sub_at(s, pat, i, n, m) = if i + m > n then 0 - 1 else if slice(s, i, i + m) == pat then i else lk_find_sub_at(s, pat, i + 1, n, m)
fn lk_find_sub(s, pat, start) = lk_find_sub_at(s, pat, start, count(s), count(pat))

fn lk_check_wcet_term(term_str) = let n = count(term_str) in if lk_startswith(term_str, "wcet_budget(") == 0 or n < 15 or at(term_str, n - 1) != ")" then 0 else let inner = slice(term_str, 12, n - 1) in let sep = lk_find_sub(inner, " <= ", 0) in if sep <= 0 then 0 else let s_est = slice(inner, 0, sep) in let s_bnd = slice(inner, sep + 4, count(inner)) in if lk_is_int_tok(s_est) == 0 or lk_is_int_tok(s_bnd) == 0 then 0 else let est = lk_to_int(s_est) in let bnd = lk_to_int(s_bnd) in if est > 0 and bnd > 0 and est <= bnd then 1 else 0

## --- 5. Certificate Artifact JSON Parser & Tamper-Evidence Verifier ---
fn lk_str_end(s, i, n) = if i >= n then n else let c = at(s, i) in if c == "\\" then lk_str_end(s, i + 2, n) else if c == "\"" then i else lk_str_end(s, i + 1, n)
## Unescaping copies the runs between backslashes and joins the pieces pairwise. It used to prepend one character at a
## time, which is quadratic in the length of the string: a 600 KB proof term kept the kernel busy for more than 120 s.
fn lk_join_pairs(xs, acc) = match xs
    Nil        => lk_rev(acc, Nil)
    Cons(a, t) => lk_join_pairs1(a, t, acc)
fn lk_join_pairs1(a, t, acc) = match t
    Nil        => lk_rev(Cons(a, acc), Nil)
    Cons(b, r) => lk_join_pairs(r, Cons(a + b, acc))
fn lk_join(xs) = match xs
    Nil        => ""
    Cons(a, t) => if lk_isnil(t) == 1 then a else lk_join(lk_join_pairs(xs, Nil))
fn lk_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => lk_rev(t, Cons(h, acc))
fn lk_unesc_plain(s, i, n) = if i >= n then i else if at(s, i) == "\\" then i else lk_unesc_plain(s, i + 1, n)
fn lk_unesc_chunks(s, i, n, acc) = if i >= n then acc else let j = lk_unesc_plain(s, i, n) in if j > i then lk_unesc_chunks(s, j, n, Cons(slice(s, i, j), acc)) else if i + 1 < n then (let nx = at(s, i + 1) in lk_unesc_chunks(s, i + 2, n, Cons(if nx == "n" then "\n" else if nx == "r" then "\r" else if nx == "t" then "\t" else nx, acc))) else lk_unesc_chunks(s, i + 1, n, Cons("\\", acc))
fn lk_unesc(s) = let n = count(s) in if lk_unesc_plain(s, 0, n) >= n then s else lk_join(lk_rev(lk_unesc_chunks(s, 0, n, Nil), Nil))

fn lk_jstr(json, key) = let pat = "\"" + key + "\":\"" in let p = lk_find_sub(json, pat, 0) in if p < 0 then "" else let start = p + count(pat) in let endp = lk_str_end(json, start, count(json)) in lk_unesc(slice(json, start, endp))

fn lk_arr_end(s, i, n, depth, in_str) = if i >= n then n else let c = at(s, i) in if in_str == 1 then (if c == "\\" then lk_arr_end(s, i + 2, n, depth, 1) else if c == "\"" then lk_arr_end(s, i + 1, n, depth, 0) else lk_arr_end(s, i + 1, n, depth, 1)) else if c == "\"" then lk_arr_end(s, i + 1, n, depth, 1) else if c == "[" then lk_arr_end(s, i + 1, n, depth + 1, 0) else if c == "]" then (if depth == 1 then i else lk_arr_end(s, i + 1, n, depth - 1, 0)) else lk_arr_end(s, i + 1, n, depth, 0)

fn lk_jarr_raw(json, key) = let pat = "\"" + key + "\":[" in let p = lk_find_sub(json, pat, 0) in if p < 0 then {ok: 0, raw: ""} else let start = p + count(pat) in let endp = lk_arr_end(json, start - 1, count(json), 0, 0) in if endp >= count(json) then {ok: 0, raw: ""} else {ok: 1, raw: slice(json, start, endp)}

fn lk_obj_end(s, i, n, depth, in_str) = if i >= n then n else let c = at(s, i) in if in_str == 1 then (if c == "\\" then lk_obj_end(s, i + 2, n, depth, 1) else if c == "\"" then lk_obj_end(s, i + 1, n, depth, 0) else lk_obj_end(s, i + 1, n, depth, 1)) else if c == "\"" then lk_obj_end(s, i + 1, n, depth, 1) else if c == "{" then lk_obj_end(s, i + 1, n, depth + 1, 0) else if c == "}" then (if depth == 1 then i + 1 else lk_obj_end(s, i + 1, n, depth - 1, 0)) else lk_obj_end(s, i + 1, n, depth, 0)

fn lk_split_objs_loop(s, i, n) = if i >= n then Nil else let p = lk_find_sub(s, "{", i) in if p < 0 then Nil else let endp = lk_obj_end(s, p, n, 0, 0) in if endp <= p then Nil else Cons(slice(s, p, endp), lk_split_objs_loop(s, endp, n))
fn lk_split_objs(s) = lk_split_objs_loop(s, 0, count(s))

## A key the kernel reads is read at its FIRST occurrence; a reader that keeps the LAST one would see another term,
## status or hash behind the kernel's verdict. A certificate (or an entry) that states such a key twice is malformed.
fn lk_count_sub(s, pat, i, acc) = let p = lk_find_sub(s, pat, i) in if p < 0 then acc else lk_count_sub(s, pat, p + count(pat), acc + 1)
fn lk_dup_key(json, key, open) = if lk_count_sub(json, "\"" + key + "\":" + open, 0, 0) > 1 then 1 else 0
fn lk_top_dups(json) = if lk_dup_key(json, "proof_terms", "") == 1 or lk_dup_key(json, "obligations", "") == 1 or lk_dup_key(json, "source_hash", "") == 1 or lk_dup_key(json, "certificate_hash", "") == 1 then 1 else 0
fn lk_obj_dups(tm, ob) = if lk_dup_key(tm, "name", "") == 1 or lk_dup_key(tm, "kind", "") == 1 or lk_dup_key(tm, "term", "") == 1 or lk_dup_key(ob, "name", "") == 1 or lk_dup_key(ob, "kind", "") == 1 or lk_dup_key(ob, "status", "") == 1 or lk_dup_key(ob, "counterexample", "") == 1 then 1 else 0

fn lk_check_structural_term(term_str, nm) = if nm != "" and (term_str == "structural_recursion(" + nm + ")" or term_str == "nonrecursive(" + nm + ")") then 1 else 0

fn lk_verify_pairs(terms, obls) = match terms
    Nil         => if lk_isnil(obls) == 1 then {ok: 1, proven: 0, budgeted: 0, reason: ""} else {ok: 0, proven: 0, budgeted: 0, reason: "mismatched proof_terms and obligations count"}
    Cons(tm, r) => lk_verify_pair1(tm, r, obls)

fn lk_verify_pair1(tm, r_terms, obls) = match obls
    Nil          => {ok: 0, proven: 0, budgeted: 0, reason: "mismatched proof_terms and obligations count"}
    Cons(ob, ro) => let t_nm = lk_jstr(tm, "name") in let t_kd = lk_jstr(tm, "kind") in let t_str = lk_jstr(tm, "term") in let o_nm = lk_jstr(ob, "name") in let o_kd = lk_jstr(ob, "kind") in let o_st = lk_jstr(ob, "status") in let o_cex = lk_jstr(ob, "counterexample") in if t_nm == "" or t_nm != o_nm or t_kd != o_kd or o_cex != "" or lk_obj_dups(tm, ob) == 1 then {ok: 0, proven: 0, budgeted: 0, reason: "invalid obligation header for '" + o_nm + "'"} else if o_kd == "wcet" then (if o_st != "budget_checked" then {ok: 0, proven: 0, budgeted: 0, reason: "wcet obligation '" + o_nm + "' overclaimed as '" + o_st + "' (must be 'budget_checked')"} else if lk_check_wcet_term(t_str) == 0 then {ok: 0, proven: 0, budgeted: 0, reason: "wcet budget check failed for '" + o_nm + "'"} else let rest = lk_verify_pairs(r_terms, ro) in if rest.ok == 0 then rest else {ok: 1, proven: rest.proven, budgeted: 1 + rest.budgeted, reason: ""}) else if o_kd == "termination" and o_st == "structural_checked" then (if lk_check_structural_term(t_str, o_nm) == 0 then {ok: 0, proven: 0, budgeted: 0, reason: "structural termination entry for '" + o_nm + "' is malformed"} else let rest = lk_verify_pairs(r_terms, ro) in if rest.ok == 0 then rest else {ok: 1, proven: rest.proven, budgeted: 1 + rest.budgeted, reason: ""}) else if lk_startswith(t_str, "structural_recursion(") == 1 or lk_startswith(t_str, "nonrecursive(") == 1 then {ok: 0, proven: 0, budgeted: 0, reason: "structural termination of '" + o_nm + "' overclaimed as '" + o_st + "' (must be 'structural_checked')"} else if o_st != "proven" then {ok: 0, proven: 0, budgeted: 0, reason: "obligation '" + o_nm + "' is not proven (status='" + o_st + "')"} else if lk_prove_term(t_str) == 0 then {ok: 0, proven: 0, budgeted: 0, reason: "independent QF_LIA kernel rejected proof term for '" + o_nm + "': " + t_str} else let rest = lk_verify_pairs(r_terms, ro) in if rest.ok == 0 then rest else {ok: 1, proven: 1 + rest.proven, budgeted: rest.budgeted, reason: ""}

fn lk_envelope_ok(cert_json, proven, budgeted, total) = if lk_find_sub(cert_json, "\"ok\":false", 0) >= 0 or lk_find_sub(cert_json, "\"badge\":\"unverified\"", 0) >= 0 or lk_find_sub(cert_json, "\"zero_c\":false", 0) >= 0 then 0 else let b_att = lk_jstr(cert_json, "bootstrap_attestation") in if b_att != "" and b_att != "stage2==stage3" then 0 else if lk_find_sub(cert_json, "\"proven_count\":", 0) >= 0 and lk_find_sub(cert_json, "\"proven_count\":" + str(proven), 0) < 0 then 0 else if lk_find_sub(cert_json, "\"budget_checked_count\":", 0) >= 0 and lk_find_sub(cert_json, "\"budget_checked_count\":" + str(budgeted), 0) < 0 then 0 else if lk_find_sub(cert_json, "\"total_obligations\":", 0) >= 0 and lk_find_sub(cert_json, "\"total_obligations\":" + str(total), 0) < 0 then 0 else 1

fn lcert_verify_artifact(cert_json) = lcert_verify_core(cert_json, 0, {ok: 0, text: ""})

## `sb_on` = 1 adds the source-binding check of section 6 (`--check-source`); with `sb_on` = 0 the reply is the one above.
fn lk_sb_skipped(sb_on) = if sb_on == 1 then ",\"source_binding\":{\"checked\":false,\"reason\":\"the certificate was rejected before the source binding\"}" else ""
fn lcert_verify_core(cert_json, sb_on, src) = let src_hash = lk_jstr(cert_json, "source_hash") in let cert_hash = lk_jstr(cert_json, "certificate_hash") in let tr = lk_jarr_raw(cert_json, "proof_terms") in let obr = lk_jarr_raw(cert_json, "obligations") in if tr.ok == 0 or obr.ok == 0 or lk_top_dups(cert_json) == 1 then "{\"ok\":false,\"badge\":\"unverified\",\"kernel_verified\":false,\"reason\":\"malformed certificate artifact JSON\"" + lk_sb_skipped(sb_on) + "}" else let expected_cert_hash = lc_sha256(src_hash + "|" + tr.raw + "|" + obr.raw) in let hash_ok = if lk_valid_sha256_tag(src_hash) == 1 and lk_valid_sha256_tag(cert_hash) == 1 and cert_hash == expected_cert_hash then 1 else 0 in if hash_ok == 0 then "{\"ok\":false,\"badge\":\"unverified\",\"kernel_verified\":false,\"hash_verified\":false,\"reason\":\"cryptographic SHA-256 certificate hash mismatch or invalid sha256 digest\",\"source_hash\":\"" + lk_jesc(src_hash) + "\",\"certificate_hash\":\"" + lk_jesc(cert_hash) + "\"" + lk_sb_skipped(sb_on) + "}" else let terms = lk_split_objs(tr.raw) in let obls = lk_split_objs(obr.raw) in let total = lk_len(obls) in let vr = lk_verify_pairs(terms, obls) in let env_ok = lk_envelope_ok(cert_json, vr.proven, vr.budgeted, total) in let sb = if sb_on == 1 then sb_check(cert_json, src, terms, obls) else {ok: 1, json: "", reason: ""} in let k_ok = if total > 0 and vr.ok == 1 and vr.proven + vr.budgeted == total and env_ok == 1 and sb.ok == 1 then 1 else 0 in let reason = if vr.reason != "" then vr.reason else if env_ok == 0 then "certificate envelope metadata is inconsistent with verified proof obligations" else if sb.ok == 0 then sb.reason else "no obligations verified" in let badge = if k_ok == 1 then "Lume Verified ✓" else "unverified" in "{\"ok\":" + (if k_ok == 1 then "true" else "false") + ",\"badge\":\"" + lk_jesc(badge) + "\",\"kernel_verified\":" + (if k_ok == 1 then "true" else "false") + ",\"hash_verified\":true,\"kernel_id\":\"lume-minimal-kernel-v1\",\"bootstrap_attestation\":\"stage2==stage3\",\"zero_c\":true,\"source_hash\":\"" + lk_jesc(src_hash) + "\",\"certificate_hash\":\"" + lk_jesc(cert_hash) + "\",\"proven_count\":" + str(vr.proven) + ",\"budget_checked_count\":" + str(vr.budgeted) + ",\"total_obligations\":" + str(total) + (if k_ok == 1 then "" else ",\"reason\":\"" + lk_jesc(reason) + "\"") + ",\"proof_terms\":[" + tr.raw + "],\"obligations\":[" + obr.raw + "]" + sb.json + "}"

## --- 6. Source-to-Obligation Binding (`lcert --check-source <file.src>`, certificate on stdin) ---
## Sections 1-5 establish that every proof term is a theorem. They do NOT establish that the terms are the obligations
## of the source: a producer could certify weaker or unrelated theorems. This section closes that gap without importing
## the compiler. It (a) hashes the source file and requires the certificate's `source_hash` to be that hash, (b) reads
## the declarations of the source with its own lexer and parser, (c) rebuilds from them, with its own lowering, the
## obligation every contract / law / `@bound` / termination clause states, and (d) requires each certificate term to BE
## that obligation (equality up to the names of `let` binders), each source obligation to have exactly one certificate
## entry, and each certificate entry to have a source obligation. Whatever the reader does not understand is reported
## in `unbound` and makes the reply `"ok":false`; nothing is skipped.
##
## Fragment that is bound (everything else is refused with [K0014]):
##   declarations  `[@attr(..)]* [pub] [total] fn name(p [: int], ..) [-> int] [/ effects] {requires e | ensures e |
##                 terminates (e, ..)} = e` and `[pub] law name(p [: int], ..) [-> int] = e`, each starting in column 0
##   expressions   decimal literals, parameters and `let` names, `true`/`false`, unary `-`, `not`, `+ - * / %`,
##                 `== != < <= > >=`, `and`, `or`, parentheses, `if/then/elif/else`, `let x = v in|;|newline b`, and
##                 calls `f(a, ..)` of functions of the same file that are themselves inside the fragment (they are
##                 inlined by capture-avoiding substitution, at most 5 levels deep)
## Lowering (the obligation of `fn f(ps) requires R1..Rn ensures E1..Em = B`):
##   (implies (and R1' .. Rn') G)  where  X' = X with calls inlined and `if` lifted out of arithmetic/comparisons, and
##   G = B with (E1 and .. and Em)[result := leaf] placed at every leaf of B's `let`/`if` skeleton. No hypothesis other
##   than the source `requires` is admitted: path conditions stay inside G as `if`, callee contracts are never assumed.
## Diagnostics: [K0010] source hash mismatch, [K0011] source obligation without certificate entry, [K0012] certificate
## entry without source obligation, [K0013] term is not the obligation the source states, [K0014] declaration or
## expression outside the fragment, [K0015] source unreadable as a whole, [K0016] obligation kind outside the fragment,
## [K0017] duplicate declaration or duplicate certificate entry.

fn sb_rev(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => sb_rev(t, Cons(h, acc))
fn sb_a1(xs) = lk_shd(xs)
fn sb_a2(xs) = lk_shd(lk_stl(xs))
fn sb_a3(xs) = lk_shd(lk_stl(lk_stl(xs)))

## -- 6.1 lexer: the token boundaries of compiler/stage1/lume/01_lexer.src; tokens carry (col, line) --
fn sb_isalpha(c) = if c >= "a" and c <= "z" or c >= "A" and c <= "Z" or c == "_" then 1 else 0
fn sb_isupper1(w) = if count(w) > 0 and at(w, 0) >= "A" and at(w, 0) <= "Z" then 1 else 0
fn sb_idend(s, n, i) = if i >= n then i else if sb_isalpha(at(s, i)) == 1 or lk_is_digit(at(s, i)) == 1 then sb_idend(s, n, i + 1) else i
fn sb_digend(s, n, i) = if i >= n then i else if lk_is_digit(at(s, i)) == 1 then sb_digend(s, n, i + 1) else i
fn sb_lineend(s, n, i) = if i >= n then i else if at(s, i) == "\n" then i else sb_lineend(s, n, i + 1)
fn sb_strend(s, n, i, ls, ln) = if i >= n then {ok: 0, j: n, ls: ls, ln: ln} else let c = at(s, i) in if c == "\"" then {ok: 1, j: i + 1, ls: ls, ln: ln} else if c == "\n" then sb_strend(s, n, i + 1, i + 1, ln + 1) else if c == "\\" and i + 1 < n then (if at(s, i + 1) == "\n" then sb_strend(s, n, i + 2, i + 2, ln + 1) else sb_strend(s, n, i + 2, ls, ln)) else sb_strend(s, n, i + 1, ls, ln)
fn sb_is3q(s, n, i) = if i + 2 < n then (if at(s, i) == "\"" and at(s, i + 1) == "\"" and at(s, i + 2) == "\"" then 1 else 0) else 0
fn sb_end3q(s, n, i) = if sb_is3q(s, n, i) == 0 then 0 else if i + 3 >= n then 1 else if at(s, i + 3) != "\"" then 1 else 0
fn sb_strend3(s, n, i, ls, ln) = if i >= n then {ok: 0, j: n, ls: ls, ln: ln} else if sb_end3q(s, n, i) == 1 then {ok: 1, j: i + 3, ls: ls, ln: ln} else let c = at(s, i) in if c == "\n" then sb_strend3(s, n, i + 1, i + 1, ln + 1) else if c == "\\" and i + 1 < n then (if at(s, i + 1) == "\n" then sb_strend3(s, n, i + 2, i + 2, ln + 1) else sb_strend3(s, n, i + 2, ls, ln)) else sb_strend3(s, n, i + 1, ls, ln)
## a literal the reader does not evaluate (19+ digits, `_` separators, radix prefixes, decimals) is a "bad" token
fn sb_numbad(s, n, i, j) = if j - i > 18 then 1 else if j >= n then 0 else let c = at(s, j) in if sb_isalpha(c) == 1 then 1 else if c == "." and j + 1 < n then lk_is_digit(at(s, j + 1)) else 0
fn sb_two(s, n, i) = if i + 1 >= n then "" else let p = slice(s, i, i + 2) in if p == "==" or p == "!=" or p == "<=" or p == ">=" or p == "+%" or p == "-%" or p == "*%" then p else ""
fn sb_tok(k, t, i, ls, ln) = {k: k, t: t, c: i - ls, l: ln}
fn sb_lex(s, n, i, ls, ln, acc) = if i >= n then {ok: 1, toks: sb_rev(acc, Nil)} else let c = at(s, i) in if c == "\n" then sb_lex(s, n, i + 1, i + 1, ln + 1, acc) else if c == " " or c == "\t" or c == "\r" then sb_lex(s, n, i + 1, ls, ln, acc) else if c == "#" then sb_lex(s, n, sb_lineend(s, n, i), ls, ln, acc) else if lk_is_digit(c) == 1 then (let j = sb_digend(s, n, i) in sb_lex(s, n, j, ls, ln, Cons(sb_tok(if sb_numbad(s, n, i, j) == 1 then "bad" else "int", slice(s, i, j), i, ls, ln), acc))) else if sb_isalpha(c) == 1 then (let j = sb_idend(s, n, i) in sb_lex(s, n, j, ls, ln, Cons(sb_tok("id", slice(s, i, j), i, ls, ln), acc))) else if c == "\"" then sb_lex_str(s, n, i, ls, ln, acc) else let p = sb_two(s, n, i) in if p != "" then sb_lex(s, n, i + 2, ls, ln, Cons(sb_tok("op", p, i, ls, ln), acc)) else sb_lex(s, n, i + 1, ls, ln, Cons(sb_tok("op", c, i, ls, ln), acc))
fn sb_lex_str(s, n, i, ls, ln, acc) = let r = if sb_is3q(s, n, i) == 1 then sb_strend3(s, n, i + 3, ls, ln) else sb_strend(s, n, i + 1, ls, ln) in if r.ok == 0 then {ok: 0, toks: Nil} else sb_lex(s, n, r.j, r.ls, r.ln, Cons(sb_tok("str", "\"", i, ls, ln), acc))

fn sb_ht(ts) = match ts
    Nil        => ""
    Cons(h, t) => h.t
fn sb_hk(ts) = match ts
    Nil        => ""
    Cons(h, t) => h.k
fn sb_hl(ts) = match ts
    Nil        => 0 - 1
    Cons(h, t) => h.l
fn sb_hc(ts) = match ts
    Nil        => 0 - 1
    Cons(h, t) => h.c
fn sb_tl(ts) = match ts
    Nil        => Nil
    Cons(h, t) => t
fn sb_isop(ts, s) = if sb_hk(ts) == "op" and sb_ht(ts) == s then 1 else 0
fn sb_iskw(ts, s) = if sb_hk(ts) == "id" and sb_ht(ts) == s then 1 else 0
fn sb_starter_kw(w) = if w == "fn" or w == "pub" or w == "law" or w == "type" or w == "print" or w == "const" or w == "let" or w == "total" or w == "llm" or w == "async" or w == "extern" or w == "kernel" or w == "effect" or w == "trait" or w == "impl" or w == "temporal" or w == "rule" or w == "resource" or w == "model" or w == "use" or w == "import" then 1 else 0
## words that are never a parameter, binder or variable for the reader (the declaration keywords other than `fn`/`let`
## are ordinary names inside an expression, as in the compiler's grammar: a parameter may be called `total`)
fn sb_reserved(w) = if w == "fn" or w == "let" then 1 else if w == "if" or w == "then" or w == "else" or w == "elif" or w == "in" or w == "var" or w == "not" or w == "and" or w == "or" or w == "requires" or w == "ensures" or w == "terminates" or w == "where" or w == "from" or w == "match" or w == "with" or w == "own" or w == "mut" or w == "defer" or w == "errdefer" or w == "scope" or w == "spawn" or w == "shard" or w == "comptime" or w == "quote" or w == "splice" or w == "do" or w == "_" then 1 else sb_isupper1(w)
## a declaration starts at a column-0 token that opens a top-level statement (or at the end of the file)
fn sb_at_starter(ts) = if lk_isnil(ts) == 1 then 1 else if sb_hc(ts) != 0 then 0 else if sb_hk(ts) == "op" then (if sb_ht(ts) == "@" then 1 else 0) else if sb_hk(ts) == "id" then sb_starter_kw(sb_ht(ts)) else 0

## -- 6.2 expression parser: the precedence and the layout rules of 02_parser.src on the fragment; anything else fails --
## {ok, node, rest}. Nodes are the kernel's S-expressions: (op a b), (if c t e), (let x v b), (f a ..) for a call.
fn sb_pfail(ts) = {ok: 0, node: SNum(0), rest: ts}
fn sb_pok(nd, rest) = {ok: 1, node: nd, rest: rest}
fn sb_mk2(op, a, b) = SList(Cons(SVar(op), Cons(a, Cons(b, Nil))))
fn sb_mk3(op, a, b, c) = SList(Cons(SVar(op), Cons(a, Cons(b, Cons(c, Nil)))))
fn sb_expr(ts) = let r = sb_orloop(sb_and(ts)) in if r.ok == 1 and sb_isop(r.rest, "|") == 1 then sb_pfail(ts) else r
fn sb_orloop(l) = if l.ok == 0 then l else if sb_iskw(l.rest, "or") == 0 then l else let r = sb_and(sb_tl(l.rest)) in if r.ok == 0 then r else sb_orloop(sb_pok(sb_mk2("or", l.node, r.node), r.rest))
fn sb_and(ts) = sb_andloop(sb_cmp(ts))
fn sb_andloop(l) = if l.ok == 0 then l else if sb_iskw(l.rest, "and") == 0 then l else let r = sb_cmp(sb_tl(l.rest)) in if r.ok == 0 then r else sb_andloop(sb_pok(sb_mk2("and", l.node, r.node), r.rest))
fn sb_is_cmp(o) = if o == "==" or o == "!=" or o == "<" or o == ">" or o == "<=" or o == ">=" then 1 else 0
fn sb_cmpop(ts) = if sb_hk(ts) == "op" then sb_is_cmp(sb_ht(ts)) else 0
fn sb_cmp(ts) = if sb_iskw(ts, "not") == 1 then sb_not(sb_cmp(sb_tl(ts))) else let l = sb_add(ts) in if l.ok == 0 then l else if sb_cmpop(l.rest) == 0 then l else let r = sb_add(sb_tl(l.rest)) in if r.ok == 0 then r else if sb_cmpop(r.rest) == 1 then sb_pfail(ts) else sb_pok(sb_mk2(sb_ht(l.rest), l.node, r.node), r.rest)
fn sb_not(r) = if r.ok == 0 then r else sb_pok(sb_mk2("==", r.node, SNum(0)), r.rest)
fn sb_add(ts) = sb_addloop(sb_mul(ts))
## `- <literal> =>` opens a match arm in the compiler's grammar; the reader has no `match`, so it stops and fails there
fn sb_negpat(ts) = if sb_isop(ts, "-") == 1 and sb_isop(sb_tl(sb_tl(ts)), "=") == 1 and sb_isop(sb_tl(sb_tl(sb_tl(ts))), ">") == 1 then 1 else 0
fn sb_addloop(l) = if l.ok == 0 then l else if sb_isop(l.rest, "+") == 0 and sb_isop(l.rest, "-") == 0 then l else if sb_negpat(l.rest) == 1 then sb_pfail(l.rest) else let r = sb_mul(sb_tl(l.rest)) in if r.ok == 0 then r else sb_addloop(sb_pok(sb_mk2(sb_ht(l.rest), l.node, r.node), r.rest))
fn sb_mul(ts) = sb_mulloop(sb_post(ts))
fn sb_mulloop(l) = if l.ok == 0 then l else if sb_isop(l.rest, "*") == 0 and sb_isop(l.rest, "/") == 0 and sb_isop(l.rest, "%") == 0 then l else let r = sb_post(sb_tl(l.rest)) in if r.ok == 0 then r else sb_mulloop(sb_pok(sb_mk2(sb_ht(l.rest), l.node, r.node), r.rest))
## field access, method calls, indexing and calls of a computed value are outside the fragment
fn sb_post(ts) = let r = sb_prim(ts) in if r.ok == 0 then r else if sb_isop(r.rest, ".") == 1 then sb_pfail(ts) else if (sb_isop(r.rest, "(") == 1 or sb_isop(r.rest, "[") == 1) and sb_hl(r.rest) == sb_hl(ts) then sb_pfail(ts) else r
fn sb_prim(ts) = if sb_hk(ts) == "int" then sb_pok(SNum(toint(sb_ht(ts))), sb_tl(ts)) else if sb_hk(ts) == "op" then sb_prim_op(sb_ht(ts), sb_tl(ts), ts) else if sb_hk(ts) == "id" then sb_prim_id(sb_ht(ts), sb_tl(ts), ts) else sb_pfail(ts)
fn sb_prim_op(o, t, ts) = if o == "-" then (let r = sb_post(t) in if r.ok == 0 then r else sb_pok(sb_mk2("-", SNum(0), r.node), r.rest)) else if o == "(" then (let r = sb_expr(t) in if r.ok == 0 then r else if sb_isop(r.rest, ")") == 1 then sb_pok(r.node, sb_tl(r.rest)) else sb_pfail(ts)) else sb_pfail(ts)
fn sb_prim_id(w, t, ts) = if w == "if" then sb_if(t, ts) else if w == "let" then sb_let(t, ts) else if w == "not" then sb_not(sb_post(t)) else if sb_reserved(w) == 1 then sb_pfail(ts) else if sb_isop(t, "(") == 1 then sb_call(w, sb_tl(t), Nil, ts) else if sb_isop(t, "{") == 1 or sb_isop(t, "[") == 1 or sb_hk(t) == "str" then sb_pfail(ts) else sb_pok(SVar(w), t)
fn sb_call(nm, ts, acc, ts0) = if sb_isop(ts, ")") == 1 then sb_pok(SList(Cons(SVar(nm), sb_rev(acc, Nil))), sb_tl(ts)) else let r = sb_expr(ts) in if r.ok == 0 then r else if sb_isop(r.rest, ",") == 1 then sb_call(nm, sb_tl(r.rest), Cons(r.node, acc), ts0) else if sb_isop(r.rest, ")") == 1 then sb_pok(SList(Cons(SVar(nm), sb_rev(Cons(r.node, acc), Nil))), sb_tl(r.rest)) else sb_pfail(ts0)
fn sb_if(t, ts) = let c = sb_expr(t) in if c.ok == 0 then c else if sb_iskw(c.rest, "then") == 0 then sb_pfail(ts) else let a = sb_expr(sb_tl(c.rest)) in if a.ok == 0 then a else let r1 = if sb_isop(a.rest, ";") == 1 then sb_tl(a.rest) else a.rest in if sb_iskw(r1, "elif") == 1 then sb_if_end(c.node, a.node, sb_if(sb_tl(r1), ts)) else if sb_iskw(r1, "else") == 1 then sb_if_end(c.node, a.node, sb_expr(sb_tl(r1))) else sb_pfail(ts)
fn sb_if_end(c, a, e) = if e.ok == 0 then e else sb_pok(sb_mk3("if", c, a, e.node), e.rest)
## `let x = v` is followed by `in`, by `;`, or by its body on a later line than `x`
fn sb_let(t, ts) = if sb_hk(t) != "id" or sb_reserved(sb_ht(t)) == 1 or sb_isop(sb_tl(t), "=") == 0 then sb_pfail(ts) else let v = sb_expr(sb_tl(sb_tl(t))) in if v.ok == 0 then v else let r1 = if sb_iskw(v.rest, "in") == 1 or sb_isop(v.rest, ";") == 1 then sb_tl(v.rest) else if sb_hl(v.rest) == sb_hl(t) then Nil else v.rest in let b = sb_expr(r1) in if b.ok == 0 then b else sb_pok(sb_mk3("let", SVar(sb_ht(t)), v.node, b.node), b.rest)

## -- 6.3 declaration reader --
## A declaration is {kind: "fn"|"law", nm, ok, ps, reqs, enss, terms, body, bound, hasc, hast}: `ok` = 0 when the reader
## could not parse it (then only the name and the flags are known), `bound` the `@bound` cycles (0 none, -1 unreadable),
## `hasc` = it carries `requires`/`ensures`, `hast` = it is `total` or carries `terminates`.
fn sb_decl(kind, nm, ok, sig, body, fl) = {kind: kind, nm: nm, ok: ok, ps: sig.ps, reqs: sig.reqs, enss: sig.enss, terms: sig.terms, body: body, bound: fl.bound, hasc: fl.hasc, hast: fl.hast}
fn sb_nosig() = {ps: Nil, reqs: Nil, enss: Nil, terms: Nil}
fn sb_params(ts, acc) = if sb_isop(ts, ")") == 1 then {ok: 1, ps: sb_rev(acc, Nil), rest: sb_tl(ts)} else if sb_hk(ts) != "id" or sb_reserved(sb_ht(ts)) == 1 or lk_omem(sb_ht(ts), acc) == 1 then {ok: 0, ps: Nil, rest: ts} else let t1 = sb_tl(ts) in let t2 = if sb_isop(t1, ":") == 0 then t1 else if sb_iskw(sb_tl(t1), "int") == 1 then sb_tl(sb_tl(t1)) else Nil in if sb_isop(t2, ",") == 1 then sb_params(sb_tl(t2), Cons(sb_ht(ts), acc)) else if sb_isop(t2, ")") == 1 then {ok: 1, ps: sb_rev(Cons(sb_ht(ts), acc), Nil), rest: sb_tl(t2)} else {ok: 0, ps: Nil, rest: ts}
fn sb_ret(ts) = if sb_isop(ts, "-") == 1 and sb_isop(sb_tl(ts), ">") == 1 then (if sb_iskw(sb_tl(sb_tl(ts)), "int") == 1 then {ok: 1, rest: sb_tl(sb_tl(sb_tl(ts)))} else {ok: 0, rest: ts}) else {ok: 1, rest: ts}
fn sb_eff(ts) = if sb_isop(ts, "/") == 0 then {ok: 1, rest: ts} else if sb_isop(sb_tl(ts), "{") == 1 then sb_effitems(sb_tl(sb_tl(ts))) else if sb_hk(sb_tl(ts)) == "id" then {ok: 1, rest: sb_tl(sb_tl(ts))} else {ok: 0, rest: ts}
fn sb_effitems(ts) = if sb_isop(ts, "}") == 1 then {ok: 1, rest: sb_tl(ts)} else if sb_hk(ts) != "id" then {ok: 0, rest: ts} else if sb_isop(sb_tl(ts), ",") == 1 then sb_effitems(sb_tl(sb_tl(ts))) else if sb_isop(sb_tl(ts), "}") == 1 then {ok: 1, rest: sb_tl(sb_tl(ts))} else {ok: 0, rest: ts}
fn sb_cfail(ts) = {ok: 0, reqs: Nil, enss: Nil, terms: Nil, rest: ts}
fn sb_contracts(ts, reqs, enss, terms) = if sb_iskw(ts, "requires") == 1 then (let r = sb_expr(sb_tl(ts)) in if r.ok == 0 then sb_cfail(ts) else sb_contracts(r.rest, Cons(r.node, reqs), enss, terms)) else if sb_iskw(ts, "ensures") == 1 then (let r = sb_expr(sb_tl(ts)) in if r.ok == 0 then sb_cfail(ts) else sb_contracts(r.rest, reqs, Cons(r.node, enss), terms)) else if sb_iskw(ts, "terminates") == 1 then (if sb_isop(sb_tl(ts), "(") == 0 then sb_cfail(ts) else let m = sb_call("measure", sb_tl(sb_tl(ts)), Nil, ts) in if m.ok == 0 or lk_len(lk_slist_items(m.node)) < 2 then sb_cfail(ts) else sb_contracts(m.rest, reqs, enss, lk_app(terms, lk_stl(lk_slist_items(m.node))))) else {ok: 1, reqs: sb_rev(reqs, Nil), enss: sb_rev(enss, Nil), terms: terms, rest: ts}
fn sb_hfail() = {ok: 0, nm: "", ps: Nil, reqs: Nil, enss: Nil, terms: Nil, body: SNum(0), rest: Nil}
## `ts` is at the name. The declaration is accepted only when it is parsed to its last token AND the next token opens
## a new column-0 declaration: a body that the compiler's grammar would continue is never cut short.
fn sb_fnhead(ts) = if sb_hk(ts) != "id" or sb_reserved(sb_ht(ts)) == 1 or sb_isop(sb_tl(ts), "(") == 0 then sb_hfail() else let p = sb_params(sb_tl(sb_tl(ts)), Nil) in if p.ok == 0 then sb_hfail() else let rt = sb_ret(p.rest) in if rt.ok == 0 then sb_hfail() else let ef = sb_eff(rt.rest) in if ef.ok == 0 then sb_hfail() else let c = sb_contracts(ef.rest, Nil, Nil, Nil) in if c.ok == 0 or sb_isop(c.rest, "=") == 0 then sb_hfail() else let b = sb_expr(sb_tl(c.rest)) in if b.ok == 0 or sb_at_starter(b.rest) == 0 then sb_hfail() else {ok: 1, nm: sb_ht(ts), ps: p.ps, reqs: c.reqs, enss: c.enss, terms: c.terms, body: b.node, rest: b.rest}

## Tokens the reader cannot parse are skipped up to the next column-0 declaration, but never silently: every
## `fn <name>` / `law <name>(` met on the way becomes an unreadable declaration carrying the contract flags of the
## skipped text, so a contract hidden in unread text is reported, not lost.
fn sb_st0() = {hasc: 0, hast: 0, fns: Nil, laws: Nil, bad: ""}
fn sb_skip1(ts, st) = if sb_hk(ts) == "op" then (if sb_isop(ts, "@") == 1 and sb_iskw(sb_tl(ts), "bound") == 1 then {hasc: st.hasc, hast: st.hast, fns: st.fns, laws: st.laws, bad: "an '@bound' attribute sits on a declaration the kernel reader cannot delimit"} else st) else if sb_hk(ts) != "id" then st else let w = sb_ht(ts) in if w == "requires" or w == "ensures" or w == "where" then {hasc: 1, hast: st.hast, fns: st.fns, laws: st.laws, bad: st.bad} else if w == "terminates" or w == "total" and sb_iskw(sb_tl(ts), "fn") == 1 then {hasc: st.hasc, hast: 1, fns: st.fns, laws: st.laws, bad: st.bad} else if w == "fn" and sb_hk(sb_tl(ts)) == "id" then {hasc: st.hasc, hast: st.hast, fns: Cons(sb_ht(sb_tl(ts)), st.fns), laws: st.laws, bad: st.bad} else if w == "law" and sb_hk(sb_tl(ts)) == "id" and sb_isop(sb_tl(sb_tl(ts)), "(") == 1 then {hasc: st.hasc, hast: st.hast, fns: st.fns, laws: Cons(sb_ht(sb_tl(ts)), st.laws), bad: st.bad} else if w == "type" and sb_iskw(sb_tl(ts), "int") == 1 then {hasc: st.hasc, hast: st.hast, fns: st.fns, laws: st.laws, bad: "the source redefines the type 'int'"} else if w == "invariant" then {hasc: st.hasc, hast: st.hast, fns: st.fns, laws: st.laws, bad: "the source states a type 'invariant', an obligation outside the source-binding fragment"} else st
fn sb_skip(ts, st) = if sb_at_starter(ts) == 1 then {rest: ts, st: st} else sb_skip(sb_tl(ts), sb_skip1(ts, st))
fn sb_bad_fns(names, bound, st, acc) = match names
    Nil        => acc
    Cons(n, r) => sb_bad_fns(r, bound, st, Cons(sb_decl("fn", n, 0, sb_nosig(), SNum(0), {bound: bound, hasc: st.hasc, hast: st.hast}), acc))
fn sb_law_fn(n) = sb_decl("fn", "law_" + n, 0, sb_nosig(), SNum(0), {bound: 0, hasc: 0, hast: 0})
fn sb_bad_laws(names, acc) = match names
    Nil        => acc
    Cons(n, r) => sb_bad_laws(r, Cons(sb_decl("law", n, 0, sb_nosig(), SNum(0), {bound: 0, hasc: 0, hast: 0}), Cons(sb_law_fn(n), acc)))
fn sb_const_name(ts) = let p = if sb_iskw(ts, "pub") == 1 then sb_tl(ts) else ts in if (sb_iskw(p, "const") == 1 or sb_iskw(p, "let") == 1) and sb_hk(sb_tl(p)) == "id" then sb_ht(sb_tl(p)) else ""
fn sb_g0() = {decls: Nil, consts: Nil, bad: ""}
fn sb_item_opaque(ts, bound, g) = if lk_isnil(ts) == 1 then g else let sk = sb_skip(sb_tl(ts), sb_skip1(ts, sb_st0())) in let cn = sb_const_name(ts) in sb_items(sk.rest, {decls: sb_bad_laws(sk.st.laws, sb_bad_fns(sk.st.fns, bound, sk.st, g.decls)), consts: if cn == "" then g.consts else Cons(cn, g.consts), bad: if g.bad != "" then g.bad else sk.st.bad})
fn sb_item_fn(ts, total, bound, ts_item, g) = let h = sb_fnhead(ts) in if h.ok == 0 then sb_item_opaque(ts_item, bound, g) else sb_items(h.rest, {decls: Cons(sb_decl("fn", h.nm, 1, h, h.body, {bound: bound, hasc: if lk_isnil(h.reqs) == 1 and lk_isnil(h.enss) == 1 then 0 else 1, hast: if total == 1 or lk_isnil(h.terms) == 0 then 1 else 0}), g.decls), consts: g.consts, bad: g.bad})
fn sb_item_law(ts, ts_item, g) = let h = sb_fnhead(ts) in if h.ok == 0 or lk_isnil(h.reqs) == 0 or lk_isnil(h.enss) == 0 or lk_isnil(h.terms) == 0 then sb_item_opaque(ts_item, 0, g) else sb_items(h.rest, {decls: Cons(sb_decl("law", h.nm, 1, h, h.body, {bound: 0, hasc: 0, hast: 0}), Cons(sb_law_fn(h.nm), g.decls)), consts: g.consts, bad: g.bad})
fn sb_item_kw(ts, bound, aok, g) = let p = if sb_iskw(ts, "pub") == 1 then sb_tl(ts) else ts in if aok == 0 then sb_item_opaque(ts, bound, g) else if sb_iskw(p, "total") == 1 and sb_iskw(sb_tl(p), "fn") == 1 then sb_item_fn(sb_tl(sb_tl(p)), 1, bound, ts, g) else if sb_iskw(p, "fn") == 1 then sb_item_fn(sb_tl(p), 0, bound, ts, g) else if sb_iskw(p, "law") == 1 and bound == 0 then sb_item_law(sb_tl(p), ts, g) else sb_item_opaque(ts, bound, g)
fn sb_skip_paren(ts) = if sb_isop(ts, "(") == 1 then sb_skip_paren1(sb_tl(ts), 1) else {ok: 1, rest: ts}
fn sb_skip_paren1(ts, d) = if d <= 0 then {ok: 1, rest: ts} else if lk_isnil(ts) == 1 then {ok: 0, rest: Nil} else if sb_isop(ts, "(") == 1 then sb_skip_paren1(sb_tl(ts), d + 1) else if sb_isop(ts, ")") == 1 then sb_skip_paren1(sb_tl(ts), d - 1) else sb_skip_paren1(sb_tl(ts), d)
## `@bound(cycles: N)` or `@bound(N)`; any other shape is unreadable (-1), which makes the WCET obligation unbound
fn sb_boundval(ts) = if sb_isop(ts, "(") == 0 then 0 else let t1 = sb_tl(ts) in let t2 = if sb_hk(t1) == "id" and sb_isop(sb_tl(t1), ":") == 1 then sb_tl(sb_tl(t1)) else t1 in if sb_hk(t2) == "int" and sb_isop(sb_tl(t2), ")") == 1 then toint(sb_ht(t2)) else 0 - 1
fn sb_attr_other(nm) = if nm == "gc" or nm == "soa" or nm == "capability" or nm == "grant" or nm == "link" or nm == "need" then 1 else 0
fn sb_item_attrs(ts, bound, aok, g) = if sb_isop(ts, "@") == 0 then sb_item_kw(ts, bound, aok, g) else let nm = sb_ht(sb_tl(ts)) in let t2 = sb_tl(sb_tl(ts)) in if sb_hk(sb_tl(ts)) != "id" or sb_attr_other(nm) == 1 then sb_item_opaque(ts, bound, g) else let sp = sb_skip_paren(t2) in if sp.ok == 0 then {decls: g.decls, consts: g.consts, bad: "an attribute parenthesis is never closed"} else sb_item_attrs(sp.rest, if nm == "bound" then sb_boundval(t2) else bound, if nm == "export" or nm == "overflow" then 0 else aok, g)
fn sb_items(ts, g) = if lk_isnil(ts) == 1 then g else if sb_isop(ts, "@") == 1 then sb_item_attrs(ts, 0, 1, g) else sb_item_kw(ts, 0, 1, g)

## -- 6.4 lowering: the obligation a declaration states, as a kernel S-expression --
## ctx = {decls, consts, names, pairs}. A construct the lowering refuses becomes the atom `?unbound` (not spellable in a
## source), and a term that mentions it is never bound.
fn sb_poison() = SVar("?unbound")
fn sb_is_binop(op) = if op == "+" or op == "-" or op == "*" or op == "/" or op == "%" or op == "and" or op == "or" then 1 else sb_is_cmp(op)
fn sb_is_form(sx, op, n) = match sx
    SList(xs) => if lk_len(xs) == n and lk_svar_name(lk_shd(xs)) == op then 1 else 0
    _         => 0
fn sb_decls_named(nm, kind, ds) = match ds
    Nil        => Nil
    Cons(d, r) => if d.nm == nm and d.kind == kind then Cons(d, sb_decls_named(nm, kind, r)) else sb_decls_named(nm, kind, r)
fn sb_decl_names(ds) = match ds
    Nil        => Nil
    Cons(d, r) => Cons(d.nm, sb_decl_names(r))
## names of kernel operators: a source function of such a name is never inlined (its call would read as the operator)
fn sb_kernel_op(nm) = if lk_is_op_sym(nm) == 1 or lk_is_struct_call(nm) == 1 or lk_startswith(nm, "bv_") == 1 or lk_startswith(nm, "bit_") == 1 or lk_startswith(nm, "temporal") == 1 or nm == "array_select" or nm == "heap_read" or nm == "sep_valid" or nm == "sep_disjoint" or nm == "field" or nm == "call" or nm == "measure" or nm == "old" then 1 else 0
## a parameter or binder may not be `result`/`ret`/`true`/`false`, a top-level constant, or the name of a declaration
fn sb_name_ok(nm, ctx) = if nm == "" or nm == "result" or nm == "ret" or nm == "true" or nm == "false" or lk_omem(nm, ctx.consts) == 1 or lk_omem(nm, ctx.names) == 1 then 0 else 1
fn sb_names_ok(ps, ctx) = match ps
    Nil        => 1
    Cons(p, r) => if sb_name_ok(p, ctx) == 1 then sb_names_ok(r, ctx) else 0
## every free name is a parameter (or `true`/`false`); every binder is admissible
fn sb_scope(sx, vars, ctx) = match sx
    SNum(n)   => 1
    SVar(nm)  => if lk_omem(nm, vars) == 1 then 1 else if nm == "true" or nm == "false" then (if lk_omem(nm, ctx.consts) == 1 or lk_omem(nm, ctx.names) == 1 then 0 else 1) else 0
    SList(xs) => sb_scope_l(lk_svar_name(lk_shd(xs)), lk_stl(xs), vars, ctx)
fn sb_scope_l(op, args, vars, ctx) = if op != "let" then sb_scope_all(args, vars, ctx) else let nm = lk_svar_name(sb_a1(args)) in if sb_name_ok(nm, ctx) == 0 then 0 else if sb_scope(sb_a2(args), vars, ctx) == 0 then 0 else sb_scope(sb_a3(args), Cons(nm, vars), ctx)
fn sb_scope_all(xs, vars, ctx) = match xs
    Nil        => 1
    Cons(h, t) => if sb_scope(h, vars, ctx) == 1 then sb_scope_all(t, vars, ctx) else 0
fn sb_fn_ok(d, ctx) = if sb_names_ok(d.ps, ctx) == 1 and sb_scope(d.body, d.ps, ctx) == 1 and sb_scope_all(d.reqs, d.ps, ctx) == 1 and sb_scope_all(d.enss, Cons("result", Cons("ret", d.ps)), ctx) == 1 and sb_scope_all(d.terms, d.ps, ctx) == 1 then 1 else 0
fn sb_has_call(e) = match e
    SList(xs) => let op = lk_svar_name(lk_shd(xs)) in if op == "if" or op == "let" or sb_is_binop(op) == 1 then sb_has_call_l(lk_stl(xs)) else 1
    _         => 0
fn sb_has_call_l(xs) = match xs
    Nil        => 0
    Cons(h, t) => if sb_has_call(h) == 1 then 1 else sb_has_call_l(t)
## simultaneous, capture-avoiding substitution of the arguments for the parameters (two passes through transient names)
fn sb_subst_tmp(body, ps, i) = match ps
    Nil        => body
    Cons(p, r) => sb_subst_tmp(lk_subst_sx(body, p, SVar("(p " + str(i) + ")")), r, i + 1)
fn sb_subst_args(body, args, i) = match args
    Nil        => body
    Cons(a, r) => sb_subst_args(lk_subst_sx(body, "(p " + str(i) + ")", a), r, i + 1)
fn sb_subst_ps(body, ps, args) = sb_subst_args(sb_subst_tmp(body, ps, 0), args, 0)
fn sb_fresh3(nm, a, b, c) = let f = "(av " + nm + ")" in if lk_mentions(a, f) == 1 or lk_mentions(b, f) == 1 or lk_mentions(c, f) == 1 then sb_fresh3(f, a, b, c) else f
## clean: inline calls, lift `if` out of arithmetic and comparisons, split `if` on and/or, hoist a `let` out of a `let` value
fn sb_clean(e, ctx, d) = match e
    SList(xs) => if d > 4 then (if sb_has_call(e) == 1 then sb_poison() else e) else sb_clean_l(lk_svar_name(lk_shd(xs)), lk_stl(xs), ctx, d)
    _         => e
fn sb_clean_l(op, args, ctx, d) = if op == "if" then sb_clean_if(sb_a1(args), sb_a2(args), sb_a3(args), ctx, d) else if op == "let" then sb_clean_let(lk_svar_name(sb_a1(args)), sb_clean(sb_a2(args), ctx, d), sb_a3(args), ctx, d) else if sb_is_binop(op) == 1 then sb_mk_bin(op, sb_clean(sb_a1(args), ctx, d), sb_clean(sb_a2(args), ctx, d)) else if sb_is_simd(op, args, ctx) == 1 then sb_mk_bin("*", SNum(4), sb_mk_bin(sb_simd(op), sb_clean(sb_a1(args), ctx, d), sb_clean(sb_a2(args), ctx, d))) else sb_inline(sb_decls_named(op, "fn", ctx.decls), sb_clean_args(args, ctx, d), ctx, d)
## The two SIMD intrinsics the prover models: four equal lanes summed, so simd_add4_i64(a, b) is 4 * (a + b) and
## simd_sub4_i64(a, b) is 4 * (a - b). That equation is an axiom about the runtime helper (lasm emits the VEX
## instructions; the lowering is the one lcaas and lumec use), stated here so the binding can follow it. A source
## function of the same name takes precedence, as it does in lcaas. In the cycle estimate an intrinsic is a call
## without a body: 4 plus its arguments.
fn sb_simd(op) = if op == "simd_add4_i64" then "+" else if op == "simd_sub4_i64" then "-" else ""
fn sb_is_simd(op, args, ctx) = if sb_simd(op) != "" and lk_len(args) == 2 and lk_isnil(sb_decls_named(op, "fn", ctx.decls)) == 1 then 1 else 0
fn sb_clean_args(xs, ctx, d) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(sb_clean(h, ctx, d), sb_clean_args(t, ctx, d))
fn sb_clean_if(c, t, e2, ctx, d) = if lk_norm_if_changed(c) == 1 then sb_clean(lk_norm_if(c, t, e2), ctx, d) else sb_mk3("if", sb_clean(c, ctx, d), sb_clean(t, ctx, d), sb_clean(e2, ctx, d))
## (let nm (let nm1 v1 b1) b) => (let nm1 v1 (let nm b1 b)); nm1 is renamed first when b mentions it, so b is never captured
fn sb_clean_let(nm, cv, b, ctx, d) = if sb_is_form(cv, "let", 4) == 0 then sb_mk3("let", SVar(nm), cv, sb_clean(b, ctx, d)) else let xs = lk_stl(lk_slist_items(cv)) in let nm1 = lk_svar_name(sb_a1(xs)) in if lk_mentions(b, nm1) == 0 then sb_mk3("let", SVar(nm1), sb_a2(xs), sb_clean_let(nm, sb_a3(xs), b, ctx, d)) else let f = sb_fresh3(nm1, b, sb_a3(xs), b) in sb_mk3("let", SVar(f), sb_a2(xs), sb_clean_let(nm, lk_subst_sx(sb_a3(xs), nm1, SVar(f)), b, ctx, d))
fn sb_mk_bin(op, ca, cb) = if op == "and" or op == "or" then sb_mk2(op, ca, cb) else if sb_is_form(ca, "if", 4) == 1 then (let xs = lk_stl(lk_slist_items(ca)) in sb_mk3("if", sb_a1(xs), sb_mk_bin(op, sb_a2(xs), cb), sb_mk_bin(op, sb_a3(xs), cb))) else if sb_is_form(cb, "if", 4) == 1 then (let xs = lk_stl(lk_slist_items(cb)) in sb_mk3("if", sb_a1(xs), sb_mk_bin(op, ca, sb_a2(xs)), sb_mk_bin(op, ca, sb_a3(xs)))) else sb_mk2(op, ca, cb)
## a call is inlined only when exactly one readable function of that name and arity exists and its body is closed
fn sb_inline(ds, cargs, ctx, d) = match ds
    Nil        => sb_poison()
    Cons(f, r) => if lk_isnil(r) == 0 or f.ok == 0 or sb_kernel_op(f.nm) == 1 or lk_len(f.ps) != lk_len(cargs) or sb_names_ok(f.ps, ctx) == 0 or sb_scope(f.body, f.ps, ctx) == 0 then sb_poison() else sb_clean(sb_subst_ps(f.body, f.ps, cargs), ctx, d + 1)
## body binders become `?L<depth>.<name>` (not spellable in a source), so the `ensures` placed under them is not captured
fn sb_alpha(e, d) = match e
    SList(xs) => sb_alpha_l(lk_svar_name(lk_shd(xs)), xs, d)
    _         => e
fn sb_alpha_l(op, xs, d) = if op != "let" then SList(Cons(lk_shd(xs), sb_alpha_list(lk_stl(xs), d))) else let args = lk_stl(xs) in let nm = lk_svar_name(sb_a1(args)) in let f = "?L" + str(d) + "." + nm in sb_mk3("let", SVar(f), sb_alpha(sb_a2(args), d + 1), sb_alpha(lk_subst_sx(sb_a3(args), nm, SVar(f)), d + 1))
fn sb_alpha_list(xs, d) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(sb_alpha(h, d), sb_alpha_list(t, d))
## embed: the postcondition at every leaf of the body's let/if skeleton, `result` (alias `ret`) replaced by the leaf
fn sb_embed(body, ens, ctx) = match body
    SList(xs) => sb_embed_l(lk_svar_name(lk_shd(xs)), lk_stl(xs), body, ens, ctx)
    _         => sb_leaf(body, ens, ctx)
fn sb_leaf(body, ens, ctx) = sb_clean(lk_subst_sx(lk_subst_sx(ens, "result", body), "ret", body), ctx, 0)
fn sb_embed_l(op, args, body, ens, ctx) = if op == "let" then sb_embed_let(lk_svar_name(sb_a1(args)), sb_clean(sb_a2(args), ctx, 0), sb_a3(args), ens, ctx) else if op != "if" then sb_leaf(body, ens, ctx) else if lk_norm_if_changed(sb_a1(args)) == 1 then sb_embed(lk_norm_if(sb_a1(args), sb_a2(args), sb_a3(args)), ens, ctx) else sb_mk3("if", sb_clean(sb_a1(args), ctx, 0), sb_embed(sb_a2(args), ens, ctx), sb_embed(sb_a3(args), ens, ctx))
fn sb_embed_let(nm, cv, b, ens, ctx) = if sb_is_form(cv, "let", 4) == 0 then sb_mk3("let", SVar(nm), cv, sb_embed(b, ens, ctx)) else let xs = lk_stl(lk_slist_items(cv)) in let nm1 = lk_svar_name(sb_a1(xs)) in if lk_mentions(b, nm1) == 0 and lk_mentions(ens, nm1) == 0 then sb_mk3("let", SVar(nm1), sb_a2(xs), sb_embed_let(nm, sb_a3(xs), b, ens, ctx)) else let f = sb_fresh3(nm1, b, sb_a3(xs), ens) in sb_mk3("let", SVar(f), sb_a2(xs), sb_embed_let(nm, lk_subst_sx(sb_a3(xs), nm1, SVar(f)), b, ens, ctx))
fn sb_conj(es) = match es
    Nil        => SNum(1)
    Cons(h, t) => if lk_isnil(t) == 1 then h else sb_mk2("and", h, sb_conj(t))
## Size budget of the lowering. sb_clean inlines callees five levels deep (argument expressions included) and lifts `if`
## out of arithmetic, so the term of a small source can be exponentially larger than the source: a six-level call tree
## of fan-out 4 made this reader exhaust 2 GB before it could answer. sb_cw counts, without building anything, the nodes
## the lowering would build: {s: nodes, lv: leaves of the `if` tree on top, w: steps left} (an upper estimate). An
## obligation whose count passes sb_cw_cap() nodes, or whose count itself needs more than sb_cw_fuel() steps, is not
## lowered: its term is the atom `?unbound`, so it is reported and never bound. (lcaas.src applies its own budget,
## cs_cw_*, to the term it emits and writes the atom `oversize` instead, which no kernel proves.)
fn sb_cw_cap() = 200000
fn sb_cw_fuel() = 400000
fn sb_cw_sat(x) = if x > sb_cw_cap() then sb_cw_cap() + 1 else x
fn sb_cw_r(s, lv, w) = {s: s, lv: lv, w: w}
fn sb_cw_one(nm) = {nm: nm, s: 1, lv: 1}
fn sb_cw_env(nm, env) = match env
    Nil        => sb_cw_one(nm)
    Cons(h, t) => if h.nm == nm then h else sb_cw_env(nm, t)
fn sb_cw(e, ctx, d, env, w) = if w < 0 then sb_cw_r(sb_cw_cap() + 1, 1, w) else sb_cw1(e, ctx, d, env, w - 1)
fn sb_cw1(e, ctx, d, env, w) = match e
    SNum(n)   => sb_cw_r(1, 1, w)
    SVar(nm)  => let v = sb_cw_env(nm, env) in sb_cw_r(v.s, v.lv, w)
    SList(xs) => sb_cw_l(lk_svar_name(lk_shd(xs)), lk_stl(xs), ctx, {d: d, env: env}, w)
fn sb_cw_l(op, args, ctx, k, w) = if op == "if" and lk_len(args) == 3 then sb_cw_if(sb_a1(args), sb_a2(args), sb_a3(args), ctx, k, w) else if op == "let" and lk_len(args) == 3 then (let rv = sb_cw(sb_a2(args), ctx, k.d, k.env, w) in let rb = sb_cw(sb_a3(args), ctx, k.d, Cons(sb_cw_one(lk_svar_name(sb_a1(args))), k.env), rv.w) in sb_cw_r(sb_cw_sat(1 + rv.s + rb.s), 1, rb.w)) else if (sb_is_binop(op) == 1 or sb_is_simd(op, args, ctx) == 1) and lk_len(args) == 2 then (let ra = sb_cw(sb_a1(args), ctx, k.d, k.env, w) in let rb = sb_cw(sb_a2(args), ctx, k.d, k.env, ra.w) in if op == "and" or op == "or" then sb_cw_r(sb_cw_sat(1 + ra.s + rb.s), 1, rb.w) else sb_cw_r(sb_cw_sat(3 + ra.s + ra.lv * rb.s + ra.lv * rb.lv), sb_cw_sat(ra.lv * rb.lv), rb.w)) else sb_cw_call(sb_decls_named(op, "fn", ctx.decls), sb_cw_args(args, ctx, k, {vals: Nil, s: 1, w: w}), ctx, k.d)
fn sb_cw_if(c, t, e2, ctx, k, w) = if lk_norm_if_changed(c) == 1 then sb_cw(lk_norm_if(c, t, e2), ctx, k.d, k.env, w) else let rc = sb_cw(c, ctx, k.d, k.env, w) in let rt = sb_cw(t, ctx, k.d, k.env, rc.w) in let r3 = sb_cw(e2, ctx, k.d, k.env, rt.w) in sb_cw_r(sb_cw_sat(1 + rc.s + rt.s + r3.s), sb_cw_sat(rt.lv + r3.lv), r3.w)
## acc = {vals: the counts of the arguments, last first, s: 1 + their sum, w}
fn sb_cw_args(xs, ctx, k, acc) = match xs
    Nil        => acc
    Cons(h, t) => let r = sb_cw(h, ctx, k.d, k.env, acc.w) in sb_cw_args(t, ctx, k, {vals: Cons({nm: "", s: r.s, lv: r.lv}, acc.vals), s: sb_cw_sat(acc.s + r.s), w: r.w})
fn sb_cw_bind(ps, vals, acc) = match ps
    Nil        => acc
    Cons(p, r) => sb_cw_bind1(p, r, vals, acc)
fn sb_cw_bind1(p, r, vals, acc) = match vals
    Nil        => acc
    Cons(v, u) => sb_cw_bind(r, u, Cons({nm: p, s: v.s, lv: v.lv}, acc))
## a call that sb_inline would not inline (or that is past the inlining depth) costs its arguments
fn sb_cw_call(ds, ra, ctx, d) = match ds
    Nil        => sb_cw_r(ra.s, 1, ra.w)
    Cons(f, r) => if d > 4 or lk_isnil(r) == 0 or f.ok == 0 or lk_len(f.ps) != lk_len(ra.vals) then sb_cw_r(ra.s, 1, ra.w) else sb_cw(f.body, ctx, d + 1, sb_cw_bind(f.ps, sb_rev(ra.vals, Nil), Nil), ra.w)
## the body with the postcondition at every leaf of its let/if skeleton, as sb_embed lays it out
fn sb_cw_embed(body, ens, ctx, env, w) = if w < 0 then sb_cw_r(sb_cw_cap() + 1, 1, w) else sb_cw_embed1(body, ens, ctx, env, w - 1)
fn sb_cw_embed1(body, ens, ctx, env, w) = match body
    SList(xs) => sb_cw_embed_l(lk_svar_name(lk_shd(xs)), lk_stl(xs), body, ens, {ctx: ctx, env: env}, w)
    _         => sb_cw_leaf(body, ens, ctx, env, w)
fn sb_cw_leaf(body, ens, ctx, env, w) = let rl = sb_cw(body, ctx, 0, env, w) in sb_cw(ens, ctx, 0, Cons({nm: "result", s: rl.s, lv: rl.lv}, Cons({nm: "ret", s: rl.s, lv: rl.lv}, env)), rl.w)
fn sb_cw_embed_l(op, args, body, ens, k, w) = if op == "let" and lk_len(args) == 3 then (let rv = sb_cw(sb_a2(args), k.ctx, 0, k.env, w) in let rb = sb_cw_embed(sb_a3(args), ens, k.ctx, Cons(sb_cw_one(lk_svar_name(sb_a1(args))), k.env), rv.w) in sb_cw_r(sb_cw_sat(1 + rv.s + rb.s), 1, rb.w)) else if op != "if" or lk_len(args) != 3 then sb_cw_leaf(body, ens, k.ctx, k.env, w) else if lk_norm_if_changed(sb_a1(args)) == 1 then sb_cw_embed(lk_norm_if(sb_a1(args), sb_a2(args), sb_a3(args)), ens, k.ctx, k.env, w) else let rc = sb_cw(sb_a1(args), k.ctx, 0, k.env, w) in let rt = sb_cw_embed(sb_a2(args), ens, k.ctx, k.env, rc.w) in let r3 = sb_cw_embed(sb_a3(args), ens, k.ctx, k.env, rt.w) in sb_cw_r(sb_cw_sat(1 + rc.s + rt.s + r3.s), 1, r3.w)
fn sb_cw_over(r) = if r.w < 0 or r.s > sb_cw_cap() then 1 else 0
fn sb_cw_e_over(e, ctx) = sb_cw_over(sb_cw(e, ctx, 0, Nil, sb_cw_fuel()))
fn sb_cw_fn_over(d, ctx) = let r1 = sb_cw_args(d.reqs, ctx, {d: 0, env: Nil}, {vals: Nil, s: 1, w: sb_cw_fuel()}) in if r1.w < 0 or r1.s > sb_cw_cap() then 1 else sb_cw_over(sb_cw_embed(d.body, sb_conj(d.enss), ctx, Nil, r1.w))
## sb_clean at depth 0 under the budget (measures and path atoms of the termination check)
fn sb_clean_top(e, ctx) = if sb_cw_e_over(e, ctx) == 1 then sb_poison() else sb_clean(e, ctx, 0)
fn sb_contract_term(d, ctx) = if sb_cw_fn_over(d, ctx) == 1 then sb_poison() else sb_mk2("implies", SList(Cons(SVar("and"), sb_clean_args(d.reqs, ctx, 0))), sb_embed(sb_alpha(d.body, 0), sb_conj(d.enss), ctx))
fn sb_law_term(d, ctx) = if sb_cw_e_over(d.body, ctx) == 1 then sb_poison() else sb_mk2("implies", SList(Cons(SVar("and"), Nil)), sb_clean(d.body, ctx, 0))

## -- 6.5 comparison: equality of S-expressions up to the names of `let` binders --
fn sb_env_eq(x, y, env) = match env
    Nil        => if x == y then 1 else 0
    Cons(h, t) => if h.a == x or h.b == y then (if h.a == x and h.b == y then 1 else 0) else sb_env_eq(x, y, t)
fn sb_aeq(a, b, env) = match a
    SNum(x)   => sb_aeq_num(x, b)
    SVar(x)   => sb_aeq_var(x, b, env)
    SList(xs) => sb_aeq_list(xs, b, env)
fn sb_aeq_num(x, b) = match b
    SNum(y) => if x == y then 1 else 0
    _       => 0
fn sb_aeq_var(x, b, env) = match b
    SVar(y) => sb_env_eq(x, y, env)
    _       => 0
fn sb_aeq_list(xs, b, env) = match b
    SList(ys) => if lk_len(xs) == 4 and lk_len(ys) == 4 and lk_svar_name(lk_shd(xs)) == "let" and lk_svar_name(lk_shd(ys)) == "let" then sb_aeq_let(lk_stl(xs), lk_stl(ys), env) else sb_aeq_items(xs, ys, env)
    _         => 0
fn sb_aeq_let(xa, ya, env) = let nx = lk_svar_name(sb_a1(xa)) in let ny = lk_svar_name(sb_a1(ya)) in if nx == "" or ny == "" then 0 else if sb_aeq(sb_a2(xa), sb_a2(ya), env) == 0 then 0 else sb_aeq(sb_a3(xa), sb_a3(ya), Cons({a: nx, b: ny}, env))
fn sb_aeq_items(xs, ys, env) = match xs
    Nil        => lk_isnil(ys)
    Cons(h, t) => if lk_isnil(ys) == 1 then 0 else if sb_aeq(h, lk_shd(ys), env) == 1 then sb_aeq_items(t, lk_stl(ys), env) else 0
fn sb_show(sx) = match sx
    SNum(n)   => str(n)
    SVar(nm)  => nm
    SList(xs) => "(" + sb_show_l(xs) + ")"
fn sb_show_l(xs) = match xs
    Nil        => ""
    Cons(h, t) => if lk_isnil(t) == 1 then sb_show(h) else sb_show(h) + " " + sb_show_l(t)

## -- 6.6 WCET: the structural cycle estimate of the body, recomputed, and the bound the source states --
fn sb_calls_name(e, nm) = match e
    SList(xs) => if lk_svar_name(lk_shd(xs)) == nm then 1 else sb_calls_name_l(lk_stl(xs), nm)
    _         => 0
fn sb_calls_name_l(xs, nm) = match xs
    Nil        => 0
    Cons(h, t) => if sb_calls_name(h, nm) == 1 then 1 else sb_calls_name_l(t, nm)
fn sb_max(a, b) = if a >= b then a else b
fn sb_w(e, ctx, d) = if d <= 0 then 100000 else sb_w1(e, ctx, d)
fn sb_w1(e, ctx, d) = match e
    SList(xs) => sb_w_l(lk_svar_name(lk_shd(xs)), lk_stl(xs), ctx, d)
    _         => 1
fn sb_w_l(op, args, ctx, d) = if op == "if" then 2 + sb_w(sb_a1(args), ctx, d) + sb_max(sb_w(sb_a2(args), ctx, d), sb_w(sb_a3(args), ctx, d)) else if op == "let" then 1 + sb_w(sb_a2(args), ctx, d) + sb_w(sb_a3(args), ctx, d) else if sb_is_binop(op) == 1 then (if op == "*" or op == "/" or op == "%" then 4 else 1) + sb_w(sb_a1(args), ctx, d) + sb_w(sb_a2(args), ctx, d) else 4 + sb_w_args(args, ctx, d) + sb_w_call(op, sb_decls_named(op, "fn", ctx.decls), ctx, d)
fn sb_w_args(xs, ctx, d) = match xs
    Nil        => 0
    Cons(h, t) => sb_w(h, ctx, d) + sb_w_args(t, ctx, d)
fn sb_w_call(nm, ds, ctx, d) = match ds
    Nil        => 0
    Cons(f, r) => if sb_calls_name(f.body, nm) == 1 then 100000 else sb_w(f.body, ctx, d - 1)
## 1 when every call the estimate walks through resolves to exactly one readable function
fn sb_w_res(e, ctx, d) = if d <= 0 then 1 else sb_w_res1(e, ctx, d)
fn sb_w_res1(e, ctx, d) = match e
    SList(xs) => let op = lk_svar_name(lk_shd(xs)) in if sb_w_res_l(if op == "let" then lk_stl(lk_stl(xs)) else lk_stl(xs), ctx, d) == 0 then 0 else if op == "if" or op == "let" or sb_is_binop(op) == 1 or sb_is_simd(op, lk_stl(xs), ctx) == 1 then 1 else sb_w_res_call(sb_decls_named(op, "fn", ctx.decls), ctx, d)
    _         => 1
fn sb_w_res_l(xs, ctx, d) = match xs
    Nil        => 1
    Cons(h, t) => if sb_w_res(h, ctx, d) == 1 then sb_w_res_l(t, ctx, d) else 0
fn sb_w_res_call(ds, ctx, d) = match ds
    Nil        => 0
    Cons(f, r) => if lk_isnil(r) == 0 or f.ok == 0 then 0 else if sb_calls_name(f.body, f.nm) == 1 then 1 else sb_w_res(f.body, ctx, d - 1)

## -- 6.7 termination: every recursive call of the source needs a descent entry whose hypotheses are source facts --
## A call site is {atoms, args}: the comparisons that hold on its path (then-branches as written, else-branches
## negated) and its arguments, both closed over the enclosing `let`s. An entry `(call (and H..) A..)` covers a site
## when A is the measure at the site's arguments and every H is a `requires` conjunct or one of the site's atoms.
fn sb_flat(sx, op, acc) = match sx
    SList(xs) => if lk_svar_name(lk_shd(xs)) == op then sb_flat_l(lk_stl(xs), op, acc) else Cons(sx, acc)
    _         => Cons(sx, acc)
fn sb_flat_l(xs, op, acc) = match xs
    Nil        => acc
    Cons(h, t) => sb_flat(h, op, sb_flat_l(t, op, acc))
fn sb_flip(op) = if op == "<" then ">=" else if op == "<=" then ">" else if op == ">" then "<=" else if op == ">=" then "<" else if op == "==" then "!=" else "=="
fn sb_cmp_atoms(xs, neg) = match xs
    Nil        => Nil
    Cons(h, t) => sb_cmp_atom(h, neg, sb_cmp_atoms(t, neg))
fn sb_cmp_atom(a, neg, rest) = match a
    SList(xs) => let op = lk_svar_name(lk_shd(xs)) in if lk_len(xs) != 3 or sb_is_cmp(op) == 0 then rest else if neg == 0 then Cons(a, rest) else Cons(sb_mk2(sb_flip(op), sb_a1(lk_stl(xs)), sb_a2(lk_stl(xs))), rest)
    _         => rest
fn sb_frame(k, atoms, nm, v) = {k: k, atoms: atoms, nm: nm, v: v}
fn sb_subst_list(xs, nm, v) = match xs
    Nil        => Nil
    Cons(h, t) => Cons(lk_subst_sx(h, nm, v), sb_subst_list(t, nm, v))
fn sb_close(path, atoms, args) = match path
    Nil        => {atoms: atoms, args: args}
    Cons(f, r) => if f.k == 0 then sb_close(r, lk_app(f.atoms, atoms), args) else sb_close(r, sb_subst_list(atoms, f.nm, f.v), sb_subst_list(args, f.nm, f.v))
fn sb_sites(e, fnm, path, acc) = match e
    SList(xs) => sb_sites_l(lk_svar_name(lk_shd(xs)), lk_stl(xs), fnm, path, acc)
    _         => acc
fn sb_sites_l(op, args, fnm, path, acc) = if op == "if" then sb_sites(sb_a3(args), fnm, Cons(sb_frame(0, sb_cmp_atoms(sb_flat(sb_a1(args), "or", Nil), 1), "", SNum(0)), path), sb_sites(sb_a2(args), fnm, Cons(sb_frame(0, sb_cmp_atoms(sb_flat(sb_a1(args), "and", Nil), 0), "", SNum(0)), path), sb_sites(sb_a1(args), fnm, path, acc))) else if op == "let" then sb_sites(sb_a3(args), fnm, Cons(sb_frame(1, Nil, lk_svar_name(sb_a1(args)), sb_a2(args)), path), sb_sites(sb_a2(args), fnm, path, acc)) else let acc1 = sb_sites_args(args, fnm, path, acc) in if op == fnm then Cons(sb_close(path, Nil, args), acc1) else acc1
fn sb_sites_args(xs, fnm, path, acc) = match xs
    Nil        => acc
    Cons(h, t) => sb_sites_args(t, fnm, path, sb_sites(h, fnm, path, acc))
fn sb_arith(sx, ps) = match sx
    SNum(n)   => 1
    SVar(nm)  => lk_omem(nm, ps)
    SList(xs) => let op = lk_svar_name(lk_shd(xs)) in if lk_len(xs) == 3 and (op == "+" or op == "-" or op == "*") then (if sb_arith(sb_a1(lk_stl(xs)), ps) == 1 then sb_arith(sb_a2(lk_stl(xs)), ps) else 0) else 0
fn sb_all_arith(ms, ps) = match ms
    Nil        => 1
    Cons(m, r) => if sb_arith(m, ps) == 1 then sb_all_arith(r, ps) else 0
fn sb_same_measures(src, cms, ctx) = match src
    Nil        => lk_isnil(cms)
    Cons(m, r) => if lk_isnil(cms) == 1 then 0 else let want = sb_clean_top(m, ctx) in if lk_mentions(want, "?unbound") == 0 and sb_aeq(want, lk_shd(cms), Nil) == 1 then sb_same_measures(r, lk_stl(cms), ctx) else 0
fn sb_args_match(ms, avs, site, tx) = match ms
    Nil        => 1
    Cons(m, r) => let want = sb_clean_top(sb_subst_ps(m, tx.d.ps, site.args), tx.ctx) in if lk_mentions(want, "?unbound") == 0 and sb_aeq(want, lk_shd(avs), Nil) == 1 then sb_args_match(r, lk_stl(avs), site, tx) else 0
fn sb_site_atoms(atoms, tx) = match atoms
    Nil        => Nil
    Cons(a, r) => if sb_calls_name(a, tx.d.nm) == 1 then sb_site_atoms(r, tx) else Cons(sb_clean_top(a, tx.ctx), sb_site_atoms(r, tx))
fn sb_atom_in(a, allowed) = match allowed
    Nil        => 0
    Cons(h, t) => if lk_mentions(h, "?unbound") == 0 and sb_aeq(h, a, Nil) == 1 then 1 else sb_atom_in(a, t)
fn sb_atoms_in(xs, allowed) = match xs
    Nil        => 1
    Cons(a, r) => if sb_atom_in(a, allowed) == 1 then sb_atoms_in(r, allowed) else 0
fn sb_hyp_ok(h, site, tx) = if sb_is_form(h, "and", lk_len(lk_slist_items(h))) == 0 then 0 else sb_atoms_in(sb_flat(h, "and", Nil), lk_app(tx.ra, sb_site_atoms(site.atoms, tx)))
fn sb_site_call(site, c, tx) = let xs = lk_slist_items(c) in if lk_svar_name(lk_shd(xs)) != "call" or lk_len(xs) != lk_len(tx.ms) + 2 then 0 else if lk_len(site.args) != lk_len(tx.d.ps) or sb_calls_name_l(site.args, tx.d.nm) == 1 then 0 else if sb_args_match(tx.ms, lk_stl(lk_stl(xs)), site, tx) == 0 then 0 else sb_hyp_ok(sb_a2(xs), site, tx)
fn sb_site_any(s, calls, tx) = match calls
    Nil        => 0
    Cons(c, r) => if sb_site_call(s, c, tx) == 1 then 1 else sb_site_any(s, r, tx)
fn sb_sites_covered(sites, calls, tx) = match sites
    Nil        => 1
    Cons(s, r) => if sb_site_any(s, calls, tx) == 1 then sb_sites_covered(r, calls, tx) else 0
fn sb_call_any(c, sites, tx) = match sites
    Nil        => 0
    Cons(s, r) => if sb_site_call(s, c, tx) == 1 then 1 else sb_call_any(c, r, tx)
fn sb_calls_used(calls, sites, tx) = match calls
    Nil        => 1
    Cons(c, r) => if sb_call_any(c, sites, tx) == 1 then sb_calls_used(r, sites, tx) else 0
## the functions reachable from a body; ok = 0 when one of them is not exactly one readable function
fn sb_callnames(e, acc) = match e
    SList(xs) => let op = lk_svar_name(lk_shd(xs)) in sb_callnames_l(lk_stl(xs), if op == "if" or op == "let" or sb_is_binop(op) == 1 or lk_omem(op, acc) == 1 then acc else Cons(op, acc))
    _         => acc
fn sb_callnames_l(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => sb_callnames_l(t, sb_callnames(h, acc))
fn sb_closure(todo, seen, ctx) = match todo
    Nil        => {ok: 1, names: seen}
    Cons(n, r) => if lk_omem(n, seen) == 1 then sb_closure(r, seen, ctx) else sb_closure1(n, r, seen, sb_decls_named(n, "fn", ctx.decls), ctx)
fn sb_closure1(n, r, seen, ds, ctx) = match ds
    Nil         => {ok: 0, names: seen}
    Cons(g, gr) => if lk_isnil(gr) == 0 or g.ok == 0 then {ok: 0, names: seen} else sb_closure(lk_app(sb_callnames(g.body, Nil), r), Cons(n, seen), ctx)
fn sb_reach(body, ctx) = sb_closure(sb_callnames(body, Nil), Nil, ctx)
fn sb_count_pairs(nm, kd, ps) = match ps
    Nil        => 0
    Cons(p, r) => (if p.nm == nm and p.kd == kd then 1 else 0) + sb_count_pairs(nm, kd, r)
fn sb_tot_callees(d, ctx) = let r = sb_reach(d.body, ctx) in if r.ok == 0 then "it reaches a function the kernel reader cannot follow" else sb_tot_each(r.names, d.nm, ctx)
fn sb_tot_each(names, fnm, ctx) = match names
    Nil        => ""
    Cons(g, r) => if g == fnm then sb_tot_each(r, fnm, ctx) else sb_tot_g(g, r, fnm, sb_decls_named(g, "fn", ctx.decls), ctx)
fn sb_tot_g(g, r, fnm, ds, ctx) = match ds
    Nil         => "it reaches a function the kernel reader cannot follow"
    Cons(gd, x) => let rg = sb_reach(gd.body, ctx) in if lk_omem(fnm, rg.names) == 1 then "it is mutually recursive with '" + g + "'" else if lk_omem(g, rg.names) == 1 and sb_count_pairs(g, "termination", ctx.pairs) == 0 then "it calls the recursive function '" + g + "', which has no termination obligation in the certificate" else sb_tot_each(r, fnm, ctx)

## -- 6.8 binding of the certificate entries --
fn sb_r(ok, code, why) = {ok: ok, code: code, why: why}
fn sb_bind_sx(mine, term_str) = if lk_mentions(mine, "?unbound") == 1 then sb_r(0, "K0014", "it uses a call, a name or an inlining depth outside the fragment the kernel reader lowers") else let n = count(term_str) in let r = lk_parse_sexpr(term_str, 0, n) in if r.ok == 1 and lk_skip_ws(term_str, r.next, n) == n and sb_aeq(mine, r.node, Nil) == 1 then sb_r(1, "", "") else sb_r(0, "K0013", "the proof term is not the obligation the source states, which is " + sb_show(mine))
fn sb_bad_scope() = sb_r(0, "K0014", "a parameter, a binder or a free name of it is outside the fragment (not a parameter, a top-level constant, a declaration name, or 'result' outside 'ensures')")
fn sb_bind_contract(p, d, ctx) = if sb_fn_ok(d, ctx) == 0 then sb_bad_scope() else sb_bind_sx(sb_contract_term(d, ctx), p.tm)
fn sb_bind_law(p, d, ctx) = if sb_names_ok(d.ps, ctx) == 0 or sb_scope(d.body, d.ps, ctx) == 0 then sb_bad_scope() else sb_bind_sx(sb_law_term(d, ctx), p.tm)
fn sb_bind_wcet(p, d, ctx) = if d.bound <= 0 then sb_r(0, "K0014", "its '@bound' value is not a positive literal the kernel reader understands") else if sb_w_res(d.body, ctx, 4) == 0 then sb_r(0, "K0014", "it calls a function the kernel reader cannot follow, so the cycle estimate cannot be recomputed") else let want = "wcet_budget(" + str(if sb_calls_name(d.body, d.nm) == 1 then 100000 else sb_w(d.body, ctx, 4)) + " <= " + str(d.bound) + ")" in if p.tm == want then sb_r(1, "", "") else sb_r(0, "K0013", "the budget term is not the one the source states, which is " + want)
fn sb_measures_ok(cms, d, ctx) = if lk_isnil(cms) == 1 then 0 else if lk_isnil(d.terms) == 1 then sb_all_arith(cms, d.ps) else sb_same_measures(d.terms, cms, ctx)
fn sb_bind_term_sx(xs, d, ctx) = if lk_len(xs) < 4 or lk_svar_name(lk_shd(xs)) != "terminates" or lk_svar_name(sb_a2(xs)) != d.nm then sb_r(0, "K0013", "the termination term is not a measure descent of this function (structural recursion is outside the fragment)") else let cms = lk_term_measures(sb_a3(xs)) in if sb_measures_ok(cms, d, ctx) == 0 then sb_r(0, "K0013", "the measure is not the one the source states (an inferred measure must be + - * over the parameters)") else let calls = lk_stl(lk_stl(lk_stl(xs))) in let sites = sb_sites(d.body, d.nm, Nil, Nil) in let tx = {ms: if lk_isnil(d.terms) == 1 then cms else d.terms, ra: sb_flat_l(sb_clean_args(d.reqs, ctx, 0), "and", Nil), d: d, ctx: ctx} in if sb_sites_covered(sites, calls, tx) == 0 then sb_r(0, "K0013", "a recursive call of the source has no descent entry whose arguments are its own and whose hypotheses are source facts") else if sb_calls_used(calls, sites, tx) == 0 then sb_r(0, "K0013", "a descent entry matches no recursive call of the source") else sb_r(1, "", "")
fn sb_bind_term(p, d, ctx) = if sb_fn_ok(d, ctx) == 0 then sb_bad_scope() else let ce = sb_tot_callees(d, ctx) in if ce != "" then sb_r(0, "K0014", ce) else if sb_calls_name(d.body, d.nm) == 0 then (if p.tm == "nonrecursive(" + d.nm + ")" then sb_r(1, "", "") else sb_r(0, "K0013", "the source function does not call itself: the entry must be nonrecursive(" + d.nm + ")")) else let n = count(p.tm) in let r = lk_parse_sexpr(p.tm, 0, n) in if r.ok == 0 or lk_skip_ws(p.tm, r.next, n) != n then sb_r(0, "K0013", "the termination term is not a measure descent of this function (structural recursion is outside the fragment)") else sb_bind_term_sx(lk_slist_items(r.node), d, ctx)
## which obligations a declaration states. A function with an explicit measure and no recursive call states none.
fn sb_requires(d, kd) = if d.kind == "law" then (if kd == "law" then 1 else 0) else if kd == "contract" then d.hasc else if kd == "wcet" then (if d.bound != 0 then 1 else 0) else if kd != "termination" or d.hast == 0 then 0 else if d.ok == 1 and lk_isnil(d.terms) == 0 and sb_calls_name(d.body, d.nm) == 0 then 0 else 1
fn sb_bind_kind(p, d, ctx) = if p.kd == "contract" then sb_bind_contract(p, d, ctx) else if p.kd == "law" then sb_bind_law(p, d, ctx) else if p.kd == "wcet" then sb_bind_wcet(p, d, ctx) else sb_bind_term(p, d, ctx)
fn sb_bind_ds(p, ds, ctx) = match ds
    Nil        => sb_r(0, "K0012", "the source declares nothing of that name and kind")
    Cons(d, r) => if lk_isnil(r) == 0 then sb_r(0, "K0017", "the source declares it more than once") else if sb_count_pairs(p.nm, p.kd, ctx.pairs) > 1 then sb_r(0, "K0017", "the certificate carries this obligation more than once") else if sb_requires(d, p.kd) == 0 then sb_r(0, "K0012", "the source states no such obligation for it") else if d.ok == 0 then sb_r(0, "K0014", "its declaration is outside the fragment the kernel reader understands") else sb_bind_kind(p, d, ctx)
fn sb_bind_pair(p, ctx) = if p.kd == "contract" or p.kd == "wcet" or p.kd == "termination" then sb_bind_ds(p, sb_decls_named(p.nm, "fn", ctx.decls), ctx) else if p.kd == "law" then sb_bind_ds(p, sb_decls_named(p.nm, "law", ctx.decls), ctx) else sb_r(0, "K0016", "obligations of this kind are outside the source-binding fragment")
fn sb_bind_pairs(ps, ctx, m, un) = match ps
    Nil        => {bound: m, unbound: un}
    Cons(p, r) => let b = sb_bind_pair(p, ctx) in if b.ok == 1 then sb_bind_pairs(r, ctx, m + 1, un) else sb_bind_pairs(r, ctx, m, Cons("[" + b.code + "] " + p.kd + " '" + p.nm + "': " + b.why, un))
fn sb_miss1(d, kd, ctx, acc) = if sb_requires(d, kd) == 1 and sb_count_pairs(d.nm, kd, ctx.pairs) == 0 then Cons("[K0011] " + kd + " '" + d.nm + "': the source states it but the certificate has no obligation for it", acc) else acc
fn sb_missing(ds, ctx, acc) = match ds
    Nil        => acc
    Cons(d, r) => sb_missing(r, ctx, sb_miss1(d, "contract", ctx, sb_miss1(d, "wcet", ctx, sb_miss1(d, "termination", ctx, sb_miss1(d, "law", ctx, acc)))))
fn sb_pairs(terms, obls) = match terms
    Nil         => Nil
    Cons(tm, r) => sb_pairs1(tm, r, obls)
fn sb_pairs1(tm, r, obls) = match obls
    Nil          => Nil
    Cons(ob, ro) => Cons({nm: lk_jstr(tm, "name"), kd: lk_jstr(tm, "kind"), tm: lk_jstr(tm, "term"), st: lk_jstr(ob, "status")}, sb_pairs(r, ro))
fn sb_count_hasc(ds, n) = match ds
    Nil        => n
    Cons(d, r) => sb_count_hasc(r, if d.kind == "fn" and d.hasc == 1 then n + 1 else n)
fn sb_jlist(xs) = match xs
    Nil        => ""
    Cons(h, t) => "\"" + lk_jesc(h) + "\"" + (if lk_isnil(t) == 1 then "" else "," + sb_jlist(t))
fn sb_first(xs) = match xs
    Nil        => ""
    Cons(h, t) => h
fn sb_out(sha, n, m, unbound) = {ok: lk_isnil(unbound), reason: "source binding failed: " + sb_first(unbound), json: ",\"source_binding\":{\"checked\":true,\"source_sha256\":\"" + lk_jesc(sha) + "\",\"functions_with_contracts\":" + str(n) + ",\"obligations_bound\":" + str(m) + ",\"unbound\":[" + sb_jlist(unbound) + "]}"}
fn sb_read(text) = let lx = sb_lex(text, count(text), 0, 0, 1, Nil) in if lx.ok == 0 then {decls: Nil, consts: Nil, bad: "the source has an unterminated string literal"} else sb_items(lx.toks, sb_g0())
fn sb_ctx(g, pairs) = {decls: g.decls, consts: g.consts, names: sb_decl_names(g.decls), pairs: pairs}
fn sb_check(cert_json, src, terms, obls) = if src.ok == 0 then sb_out("", 0, 0, Cons("[K0015] the source file cannot be read", Nil)) else let sha = lc_sha256(src.text) in let u0 = if sha == lk_jstr(cert_json, "source_hash") then Nil else Cons("[K0010] the certificate is bound to another source: its source_hash is not the SHA-256 of this file", Nil) in let g = sb_read(src.text) in if g.bad != "" then sb_out(sha, 0, 0, lk_app(u0, Cons("[K0015] " + g.bad, Nil))) else let ctx = sb_ctx(g, sb_pairs(terms, obls)) in let bp = sb_bind_pairs(ctx.pairs, ctx, 0, Nil) in sb_out(sha, sb_count_hasc(g.decls, 0), bp.bound, lk_app(u0, lk_app(sb_rev(bp.unbound, Nil), sb_missing(g.decls, ctx, Nil))))

## -- 6.9 entry: `lcert --check-source <file.src>` (argv), or a first stdin line `@check-source <file.src>` --
fn sb_read_src(path) = if path == "" then {ok: 0, text: ""} else if fs_path_exists(path) == 1 then {ok: 1, text: fs_read_file(path)} else {ok: 0, text: ""}
fn sb_chomp_cr(s) = let n = count(s) in if n > 0 and at(s, n - 1) == "\r" then slice(s, 0, n - 1) else s
fn sb_stdin_form(input) = let n = count(input) in let le = sb_lineend(input, n, 0) in lcert_verify_core(slice(input, if le < n then le + 1 else le, n), 1, sb_read_src(sb_chomp_cr(slice(input, 14, le))))
fn lcert_main(input) = if os_arg_count() >= 2 then (if os_arg_at(1) != "--check-source" then lcert_verify_artifact(input) else lcert_verify_core(input, 1, sb_read_src(if os_arg_count() >= 3 then os_arg_at(2) else ""))) else if lk_startswith(input, "@check-source ") == 1 then sb_stdin_form(input) else lcert_verify_artifact(input)

fn test_lcert_sha256_nist_kat() = let k0 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" in let k1 = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" in if sha256_hex("") == k0 and lc_sha256("") == "sha256:" + k0 and sha256_hex("abc") == k1 and lc_sha256("abc") == "sha256:" + k1 then 1 else 0

fn test_lcert_terminates_and_soundness() = if lk_prove_term("(terminates fact n)") == 0 and lk_prove_term("(terminates fact (n))") == 0 and lk_prove_term("(terminates fact (implies (>= n 1) (< (- n 1) n)))") == 0 and lk_prove_term("(terminates fact (measure n))") == 0 and lk_prove_term("(terminates fact (measure n) (call (and (>= n 0) (> n 0)) (- n 1)))") == 1 and lk_prove_term("(terminates fact (measure n) (call (and (> n 0)) (+ n 1)))") == 0 and lk_prove_term("(terminates fact (measure n) (call (and) (- n 1)))") == 0 and lk_prove_term("(terminates fact (measure n) (call (and (> n 0)) n))") == 0 and lk_prove_term("(terminates ack (measure m n) (call (and (> m 0) (<= n 0)) (- m 1) 1) (call (and (> m 0) (> n 0)) m (- n 1)))") == 1 and lk_prove_term("(terminates ack (measure m n) (call (and (> m 0) (> n 0)) m (+ n 1)))") == 0 and lk_prove_term("(terminates rs (measure (- hi lo)) (call (and (< lo hi)) (- hi (+ lo 1))))") == 1 and lk_prove_term("(terminates fact ())") == 0 and lk_prove_term("(terminates fact 0)") == 0 and lk_prove_term("(sep_disjoint (+ p 1) p)") == 1 and lk_prove_term("(sep_disjoint p p)") == 0 then 1 else 0

## The remainder bound that does not depend on the sign of the dividend: two TRUE facts and the gcd descent it enables,
## then three FALSE neighbours (one past the bound, a sign claim, and the same claim without b >= 1).
fn test_lcert_remainder_sign_agnostic_bound() = if lk_prove_term("(implies (and (> b 0)) (< (% a b) b))") == 1 and lk_prove_term("(implies (and (> b 0)) (> (% a b) (- 0 b)))") == 1 and lk_prove_term("(terminates gcd_euclid (measure b) (call (and (> b 0)) (% a b)))") == 1 and lk_prove_term("(implies (and (>= a 0) (> b 0)) (>= (% a b) 0))") == 1 and lk_prove_term("(implies (and (> b 0)) (< (% a b) (- b 1)))") == 0 and lk_prove_term("(implies (and (> b 0)) (>= (% a b) 0))") == 0 and lk_prove_term("(implies (and) (< (% a b) b))") == 0 then 1 else 0

## Red-team regressions: each FALSE term below was accepted by an earlier kernel; each is paired with a TRUE control.
fn test_lcert_redteam_exists_witness_capture() = if lk_prove_term("(implies (and (>= x 0) (<= x 100)) (exists_range k x x (forall_range x 0 100 (== k x))))") == 0 and lk_prove_term("(implies (and (>= x 0) (<= x 100)) (exists_range k x x (== k x)))") == 1 then 1 else 0
fn test_lcert_redteam_quantifier_symbol_collision() = if lk_prove_term("(implies (and (>= _q0_k 0) (<= _q0_k 5)) (forall_range k 0 1000 (== k _q0_k)))") == 0 and lk_prove_term("(implies (and (>= n 0)) (forall_range k 0 n (>= (+ k 1) 1)))") == 1 then 1 else 0
fn test_lcert_redteam_let_shadow_scope() = if lk_prove_term("(implies (and (>= x 0) (>= y 0)) (== (let x y x) x))") == 0 and lk_prove_term("(implies (and (>= x 0) (>= y 0)) (== (let x y x) y))") == 1 then 1 else 0
fn test_lcert_redteam_nonlinear_bounds() = if lk_prove_term("(implies (and (>= x 0) (<= x 20)) (<= (* x (- 20 x)) 99))") == 0 and lk_prove_term("(implies (and (>= h 1) (>= w 1) (<= w 100000) (>= d 1) (<= d 10000)) (> (+ h (* w d)) h))") == 1 then 1 else 0
fn test_lcert_redteam_shift_semantics() = if lk_prove_term("(implies (and) (>= (bit_shr (- 0 9) 1) (- 0 4)))") == 0 and lk_prove_term("(implies (and (>= x 0)) (>= (bit_shl x 1) x))") == 0 and lk_prove_term("(implies (and (>= x 0) (<= x 1000)) (== (bit_shl x 3) (* x 8)))") == 1 then 1 else 0

## Source binding (section 6): the reader, the lowering, the comparison and the end-to-end reply.
fn sbt_src() = "## sample\nfn inc(x: int) -> int\n  requires x >= 0\n  ensures result >= 1\n= x + 1\n\nfn clamp(x, lo, hi) requires lo <= hi ensures result >= lo ensures result <= hi = if x < lo then lo else if x > hi then hi else x\n\nfn twice(x: int) -> int\n  requires x >= 0\n  ensures result >= 2\n= let y = inc(x) in y + inc(x)\n\n@bound(cycles: 40)\nfn lim(d: int, c: int) -> int / pure\n  requires c >= 0 and c <= 100 and d >= 0 - 100 and d <= 100\n  ensures result >= c - 1 and result <= c + 1\n= if d > c + 1 then c + 1 else if d < c - 1 then c - 1 else d\n\nfn countdown(n: int) -> int\n  requires n >= 0\n  terminates (n)\n= if n <= 0 then 0 else countdown(n - 1)\n\ntotal fn idt(n: int) -> int = n + 1\n\nfn neg(x: int) -> int requires x > 0 and not (x > 100) ensures result < 0 = -x\n\nlaw inc_mono(a: int) = if a >= 0 then inc(a) > a else 1 == 1\n\nprint twice(3)\n"
fn sbt_ctx(src) = sb_ctx(sb_read(src), Nil)
fn sbt_d1(ds) = match ds
    Nil        => sb_decl("fn", "", 0, sb_nosig(), SNum(0), {bound: 0, hasc: 0, hast: 0})
    Cons(d, r) => d
fn sbt_pair(nm, kd, tm) = {nm: nm, kd: kd, tm: tm, st: "proven"}
fn sbt_contract(src, nm) = let ctx = sbt_ctx(src) in let d = sbt_d1(sb_decls_named(nm, "fn", ctx.decls)) in if d.ok == 0 or sb_fn_ok(d, ctx) == 0 then "?" else sb_show(sb_contract_term(d, ctx))
fn sbt_code(src, nm, kd, tm) = let ctx = sbt_ctx(src) in let b = sb_bind_pair(sbt_pair(nm, kd, tm), ctx) in if b.ok == 1 then "ok" else b.code
fn sbt_has(s, pat) = if lk_find_sub(s, pat, 0) >= 0 then 1 else 0
fn sbt_cert(src, nm, term) = let tr = "{\"name\":\"" + nm + "\",\"kind\":\"contract\",\"term\":\"" + term + "\",\"checked\":true}" in let ob = "{\"name\":\"" + nm + "\",\"kind\":\"contract\",\"status\":\"proven\",\"obligation\":\"o\",\"counterexample\":\"\"}" in let sh = lc_sha256(src) in "{\"ok\":true,\"source_hash\":\"" + sh + "\",\"certificate_hash\":\"" + lc_sha256(sh + "|" + tr + "|" + ob) + "\",\"proven_count\":1,\"budget_checked_count\":0,\"total_obligations\":1,\"proof_terms\":[" + tr + "],\"obligations\":[" + ob + "]}"

## the reader reproduces, token for token, the terms the compiler-as-a-service emits for the same declarations
fn test_lcert_sb_reader_and_lowering() = let s = sbt_src() in if sbt_contract(s, "inc") == "(implies (and (>= x 0)) (>= (+ x 1) 1))" and sbt_contract(s, "clamp") == "(implies (and (<= lo hi)) (if (< x lo) (and (>= lo lo) (<= lo hi)) (if (> x hi) (and (>= hi lo) (<= hi hi)) (and (>= x lo) (<= x hi)))))" and sbt_contract(s, "twice") == "(implies (and (>= x 0)) (let ?L0.y (+ x 1) (>= (+ ?L0.y (+ x 1)) 2)))" and sbt_contract(s, "neg") == "(implies (and (and (> x 0) (== (> x 100) 0))) (< (- 0 x) 0))" and sbt_code(s, "inc_mono", "law", "(implies (and) (if (>= a 0) (> (+ a 1) a) (== 1 1)))") == "ok" and sbt_code(s, "lim", "wcet", "wcet_budget(17 <= 40)") == "ok" and sbt_code(s, "countdown", "termination", "(terminates countdown (measure n) (call (and (>= n 0) (> n 0)) (- n 1)))") == "ok" and sbt_code(s, "idt", "termination", "nonrecursive(idt)") == "ok" then 1 else 0

## equality is up to `let` binder names only: a renamed binder binds, a captured or swapped variable does not
fn test_lcert_sb_alpha_equality() = let s = sbt_src() in if sbt_code(s, "twice", "contract", "(implies (and (>= x 0)) (let k (+ x 1) (>= (+ k (+ x 1)) 2)))") == "ok" and sbt_code(s, "twice", "contract", "(implies (and (>= x 0)) (let x (+ x 1) (>= (+ x (+ x 1)) 2)))") == "K0013" and sbt_code(s, "twice", "contract", "(implies (and (>= x 0)) (let k (+ x 1) (>= (+ k (+ k 1)) 2)))") == "K0013" and sbt_code(s, "inc", "contract", "(implies (and (>= x 0)) (>= (+ x 1) 1)) junk") == "K0013" then 1 else 0

## every weakening is refused: a weaker goal, a stronger hypothesis, an added hypothesis, a dropped `ensures`, a
## budget or an estimate that is not the source's, a descent entry with an invented hypothesis or a missing call site
fn test_lcert_sb_refuses_weaker_obligations() = let s = sbt_src() in if sbt_code(s, "inc", "contract", "(implies (and (>= x 0)) (>= (+ x 1) 0))") == "K0013" and sbt_code(s, "inc", "contract", "(implies (and (>= x 5)) (>= (+ x 1) 1))") == "K0013" and sbt_code(s, "inc", "contract", "(implies (and (>= x 0) (>= x 5)) (>= (+ x 1) 1))") == "K0013" and sbt_code(s, "clamp", "contract", "(implies (and (<= lo hi)) (if (< x lo) (>= lo lo) (if (> x hi) (>= hi lo) (>= x lo))))") == "K0013" and sbt_code(s, "lim", "wcet", "wcet_budget(17 <= 4000)") == "K0013" and sbt_code(s, "lim", "wcet", "wcet_budget(1 <= 40)") == "K0013" and sbt_code(s, "countdown", "termination", "(terminates countdown (measure n) (call (and (>= n 0) (> n 0) (> n 5)) (- n 1)))") == "K0013" and sbt_code(s, "countdown", "termination", "(terminates countdown (measure n) (call (and (>= n 0) (> n 0)) (- n 2)))") == "K0013" and sbt_code(s, "countdown", "termination", "nonrecursive(countdown)") == "K0013" and sbt_code(s, "idt", "termination", "(terminates idt (measure n) (call (and) (- n 1)))") == "K0013" and sbt_code(s, "ghost", "contract", "(implies (and) (>= 1 1))") == "K0012" and sbt_code(s, "idt", "contract", "(implies (and) (>= 1 1))") == "K0012" and sbt_code(s, "inc", "invariant", "(implies (and) (>= 1 1))") == "K0016" then 1 else 0

## fail closed outside the fragment: unknown callee, record/field/match/string bodies, a free name, a top-level constant,
## a refinement type, `result` as a parameter, a duplicated function, recursion past the inlining depth
fn test_lcert_sb_fragment_is_fail_closed() = if sbt_code("fn f(x: int) -> int requires x >= 0 ensures result >= 0 = g(x)\n", "f", "contract", "(implies (and (>= x 0)) (>= (g x) 0))") == "K0014" and sbt_code("fn f(x) ensures result >= 0 = x.len\n", "f", "contract", "(implies (and) (>= 1 1))") == "K0014" and sbt_code("fn f(xs) ensures result >= 0 = match xs\n    Nil => 0\n    Cons(h, t) => 1\n", "f", "contract", "(implies (and) (>= 1 1))") == "K0014" and sbt_code("fn f(x) ensures result >= 0 = count(\"ensures\")\n", "f", "contract", "(implies (and) (>= 1 1))") == "K0014" and sbt_code("fn f(x) ensures result >= k = x\n", "f", "contract", "(implies (and) (>= x k))") == "K0014" and sbt_code("const k = 5\nfn f(k) ensures result >= k = k\n", "f", "contract", "(implies (and) (>= k k))") == "K0014" and sbt_code("fn f(x: int where x > 0) ensures result >= 1 = x\n", "f", "contract", "(implies (and (> x 0)) (>= x 1))") == "K0014" and sbt_code("fn f(result) ensures result >= 0 = 0\n", "f", "contract", "(implies (and) (>= 0 0))") == "K0014" and sbt_code("fn f(x) ensures result >= 0 = 0\nfn f(x) ensures result >= 1 = 1\n", "f", "contract", "(implies (and) (>= 0 0))") == "K0017" and sbt_code("fn f(n) requires n >= 0 ensures result >= 0 = if n <= 0 then 0 else f(n - 1)\n", "f", "contract", "(implies (and (>= n 0)) (>= 0 0))") == "K0014" and (sb_read("fn f(x) = \"abc\n")).bad != "" and (sb_read("type int = int where self > 5\nfn f(x: int) ensures result >= 6 = x\n")).bad != "" and (sb_read("type Acct = {bal: int}\n    invariant bal >= 0\nfn f(x: int) ensures result >= 0 = 0\n")).bad != "" and sbt_code("fn half(total: int) -> int requires total >= 0 ensures result <= total = total / 2\n", "half", "contract", "(implies (and (>= total 0)) (<= (/ total 2) total))") == "ok" then 1 else 0

## hoisting a callee's `let` over the caller must not capture the caller's names: the kernel renames, so the term that
## a capturing lowering would produce (`t` read as the callee's 1) is refused and the capture-free one is bound
fn sbt_capture_src() = "fn g(a) = let t = a in t\nfn f(t) ensures result == 2 = let y = g(1) in y + t\n"
fn test_lcert_sb_no_capture_on_hoist() = let s = sbt_capture_src() in if sbt_code(s, "f", "contract", "(implies (and) (let t 1 (let y t (== (+ y t) 2))))") == "K0013" and sbt_code(s, "f", "contract", "(implies (and) (let q 1 (let y q (== (+ y t) 2))))") == "ok" and lk_prove_term("(implies (and) (let t 1 (let y t (== (+ y t) 2))))") == 1 and lk_prove_term("(implies (and) (let q 1 (let y q (== (+ y t) 2))))") == 0 then 1 else 0

## a contract hidden in text the reader cannot parse is reported as a missing obligation, never dropped
fn sbt_missing(src) = let ctx = sbt_ctx(src) in lk_len(sb_missing(ctx.decls, ctx, Nil))
fn test_lcert_sb_unread_contracts_are_reported() = if sbt_missing("fn f(xs) requires count(xs) > 0 ensures result >= 0 = at(xs, 0).len\nprint 1\n") == 1 and sbt_missing("impl T\n  fn m(x) ensures result >= 0 = x\nprint 1\n") == 1 and sbt_missing("fn f(x) = x + 1\nprint f(1)\n") == 0 and sbt_missing("total fn f(xs) = match xs\n    Nil => 0\n    Cons(h, t) => f(t)\n") == 1 and sbt_missing("@bound(cycles: 9)\nfn f(xs) = xs.n\n") == 1 and sbt_missing("law l(a) = always(a, a, a)\n") == 1 and sbt_missing("fn f(xs) = let total = xs.n in total\n") == 0 and sbt_code("const true = 0\nfn f(x) ensures true = x\n", "f", "contract", "(implies (and) true)") == "K0014" and sbt_missing(sbt_src()) == 10 then 1 else 0

## the whole reply: bound certificate accepted; forged ones accepted WITHOUT the source and refused WITH it
fn sbt_src1() = "fn inc(x: int) -> int\n  requires x >= 0\n  ensures result >= 1\n= x + 1\n"
fn sbt_run(cert, src) = lcert_verify_core(cert, 1, {ok: 1, text: src})
fn test_lcert_sb_end_to_end() = let s = sbt_src1() in let good = sbt_cert(s, "inc", "(implies (and (>= x 0)) (>= (+ x 1) 1))") in let weak = sbt_cert(s, "inc", "(implies (and (>= x 0)) (>= (+ x 1) 0))") in let strong = sbt_cert(s, "inc", "(implies (and (>= x 5)) (>= (+ x 1) 1))") in let ghost = sbt_cert(s, "ghost", "(implies (and (>= x 0)) (>= (+ x 1) 1))") in let rg = sbt_run(good, s) in if sbt_has(rg, "\"ok\":true") == 1 and sbt_has(rg, "\"source_binding\":{\"checked\":true,\"source_sha256\":\"" + lc_sha256(s) + "\",\"functions_with_contracts\":1,\"obligations_bound\":1,\"unbound\":[]}") == 1 and lcert_verify_artifact(good) == lcert_verify_core(good, 0, {ok: 0, text: ""}) and sbt_has(lcert_verify_artifact(good), "source_binding") == 0 and sbt_has(lcert_verify_artifact(weak), "\"ok\":true") == 1 and sbt_has(sbt_run(weak, s), "\"ok\":false") == 1 and sbt_has(sbt_run(weak, s), "[K0013]") == 1 and sbt_has(lcert_verify_artifact(strong), "\"ok\":true") == 1 and sbt_has(sbt_run(strong, s), "\"ok\":false") == 1 and sbt_has(sbt_run(strong, s), "[K0013]") == 1 and sbt_has(lcert_verify_artifact(ghost), "\"ok\":true") == 1 and sbt_has(sbt_run(ghost, s), "\"ok\":false") == 1 and sbt_has(sbt_run(ghost, s), "[K0012]") == 1 and sbt_has(sbt_run(ghost, s), "[K0011]") == 1 and sbt_has(sbt_run(good, s + "\n"), "[K0010]") == 1 and sbt_has(sbt_run(good, s + "\n"), "\"ok\":false") == 1 and sbt_has(lcert_verify_core(good, 1, {ok: 0, text: ""}), "[K0015]") == 1 and sbt_has(lcert_verify_core("{}", 1, {ok: 1, text: s}), "\"source_binding\":{\"checked\":false") == 1 then 1 else 0

## --- 8. Differential fuzz of the QF_LIA core against brute force ---
## A seeded generator builds proof terms `(implies (and H..) G)` over x, y and a `let`-bound v from everything the core
## interprets: + - *, `/` and `%` by constants and by terms, `let`, `if`, shifts, the bit operations and their u8
## forms, comparisons, and/or, forall_range / exists_range. Whenever the kernel answers "proved", the term is evaluated
## with the semantics of the language (truncating `/` and `%`, flooring `bit_shr`, a trap makes the point undefined) at
## every point of the box -3..3 for x, y, v: a point where every hypothesis is true and the goal false is an unsound
## verdict. (Campaign of 2026-11-11: 650 000 terms at depths 1..5, 156 210 proved, 0 unsound.)
fn fz_mix(s) = let a = (s *% 6364136223846793005) +% 1442695040888963407 in bit_xor(a, bit_shr(bit_and(a, 9223372036854775807), 29))
fn fz_kid(s, i) = fz_mix(s +% (i + 1) *% 7046029254386353131)
fn fz_pick(s, n) = bit_and(bit_shr(bit_and(fz_mix(s), 9223372036854775807), 17), 1048575) % n
fn fz_l1(op, a) = SList(Cons(SVar(op), Cons(a, Nil)))
fn fz_l2(op, a, b) = SList(Cons(SVar(op), Cons(a, Cons(b, Nil))))
fn fz_l3(op, a, b, c) = SList(Cons(SVar(op), Cons(a, Cons(b, Cons(c, Nil)))))
fn fz_l4(op, a, b, c, e) = SList(Cons(SVar(op), Cons(a, Cons(b, Cons(c, Cons(e, Nil))))))
fn fz_var(s) = let k = fz_pick(s, 3) in SVar(if k == 0 then "x" else if k == 1 then "y" else "v")
fn fz_const(s) = SNum(fz_pick(s, 9) - 4)
fn fz_pos(s) = SNum(1 + fz_pick(s, 4))
fn fz_mask(s) = let k = fz_pick(s, 4) in SNum(if k == 0 then 1 else if k == 1 then 3 else if k == 2 then 7 else 255)
fn fz_bvop(s) = let k = fz_pick(s, 3) in if k == 0 then "bit_and" else if k == 1 then "bit_or" else "bit_xor"
fn fz_A(s, d) = let k = if d <= 0 then fz_pick(s, 2) else fz_pick(fz_kid(s, 9), 20) in let a1 = fz_kid(s, 1) in let a2 = fz_kid(s, 2) in if k == 0 then fz_var(fz_kid(s, 0)) else if k == 1 then fz_const(fz_kid(s, 0)) else if k == 2 or k == 3 then fz_l2("+", fz_A(a1, d - 1), fz_A(a2, d - 1)) else if k == 4 or k == 5 then fz_l2("-", fz_A(a1, d - 1), fz_A(a2, d - 1)) else if k == 6 then fz_l2("*", fz_A(a1, d - 1), fz_A(a2, d - 1)) else if k == 7 then fz_l2("/", fz_A(a1, d - 1), fz_pos(a2)) else if k == 8 then fz_l2("%", fz_A(a1, d - 1), fz_pos(a2)) else if k == 9 then fz_l2("/", fz_A(a1, d - 1), fz_A(a2, d - 1)) else if k == 10 then fz_l2("%", fz_A(a1, d - 1), fz_A(a2, d - 1)) else if k == 11 then fz_l3("let", SVar("v"), fz_A(a1, d - 1), fz_A(a2, d - 1)) else if k == 12 then fz_l3("if", fz_C(fz_kid(s, 3), d - 1), fz_A(a1, d - 1), fz_A(a2, d - 1)) else if k == 13 then fz_l2("bit_shr", fz_A(a1, d - 1), SNum(fz_pick(a2, 3))) else if k == 14 then fz_l2("bit_shl", fz_A(a1, d - 1), SNum(fz_pick(a2, 3))) else if k == 15 then fz_l2(fz_bvop(fz_kid(s, 4)), fz_A(a1, d - 1), fz_A(a2, d - 1)) else if k == 16 then fz_l2("bit_and", fz_A(a1, d - 1), fz_mask(a2)) else if k == 17 then fz_l1("bv_u8", fz_A(a1, d - 1)) else if k == 18 then fz_l2(if fz_pick(a2, 2) == 0 then "bv_add_u8" else "bv_sub_u8", fz_A(a1, d - 1), fz_A(a2, d - 1)) else fz_l1("bv_not_u8", fz_A(a1, d - 1))
fn fz_cmp(s) = let k = fz_pick(s, 6) in if k == 0 then "==" else if k == 1 then "!=" else if k == 2 then "<" else if k == 3 then "<=" else if k == 4 then ">" else ">="
fn fz_C(s, d) = let k = if d <= 0 then 0 else fz_pick(fz_kid(s, 9), 6) in if k <= 3 then fz_l2(fz_cmp(fz_kid(s, 0)), fz_A(fz_kid(s, 1), d - 1), fz_A(fz_kid(s, 2), d - 1)) else fz_l2(if k == 4 then "and" else "or", fz_C(fz_kid(s, 1), d - 1), fz_C(fz_kid(s, 2), d - 1))
fn fz_G(s, d) = let k = if d <= 0 then 0 else fz_pick(fz_kid(s, 9), 12) in if k <= 4 then fz_C(fz_kid(s, 0), d) else if k == 5 then fz_l3("if", fz_C(fz_kid(s, 3), d - 1), fz_G(fz_kid(s, 1), d - 1), fz_G(fz_kid(s, 2), d - 1)) else if k == 6 then fz_l3("let", SVar("v"), fz_A(fz_kid(s, 1), d - 1), fz_G(fz_kid(s, 2), d - 1)) else if k == 7 then fz_l2("and", fz_G(fz_kid(s, 1), d - 1), fz_G(fz_kid(s, 2), d - 1)) else if k == 8 then fz_l2("or", fz_G(fz_kid(s, 1), d - 1), fz_G(fz_kid(s, 2), d - 1)) else if k == 9 then fz_l4("forall_range", SVar("v"), fz_A(fz_kid(s, 1), 1), fz_A(fz_kid(s, 2), 1), fz_G(fz_kid(s, 3), d - 1)) else if k == 10 then fz_l4("exists_range", SVar("v"), fz_A(fz_kid(s, 1), 1), fz_A(fz_kid(s, 2), 1), fz_G(fz_kid(s, 3), d - 1)) else fz_C(fz_kid(s, 0), d)
fn fz_hyps(s, n, d) = if n <= 0 then Nil else Cons(fz_C(fz_kid(s, n), d), fz_hyps(fz_kid(s, 77), n - 1, d))
fn fz_term(s, d) = fz_l2("implies", SList(Cons(SVar("and"), fz_hyps(fz_kid(s, 5), fz_pick(fz_kid(s, 6), 4), d - 1))), fz_G(fz_kid(s, 7), d))
fn fz_err() = {ok: 0, i: 0}
fn fz_ok(i) = {ok: 1, i: i}
fn fz_p2(k) = if k <= 0 then 1 else 2 * fz_p2(k - 1)
fn fz_big(a) = if a > 1000000000 or a < 0 - 1000000000 then 1 else 0
fn fz_ev2(op, a, b) = if a.ok == 0 or b.ok == 0 or fz_big(a.i) == 1 or fz_big(b.i) == 1 then fz_err() else if op == "+" then fz_ok(a.i + b.i) else if op == "-" then fz_ok(a.i - b.i) else if op == "*" then fz_ok(a.i * b.i) else if op == "/" then (if b.i == 0 then fz_err() else fz_ok(a.i / b.i)) else if op == "%" then (if b.i == 0 then fz_err() else fz_ok(a.i % b.i)) else if op == "bit_shr" or op == "bv_shr" then (if b.i < 0 or b.i > 30 then fz_err() else fz_ok(bit_shr(a.i, b.i))) else if op == "bit_shl" or op == "bv_shl" then (if b.i < 0 or b.i > 20 then fz_err() else fz_ok(a.i * fz_p2(b.i))) else if op == "bit_and" or op == "bv_and" then fz_ok(bit_and(a.i, b.i)) else if op == "bit_or" or op == "bv_or" then fz_ok(bit_or(a.i, b.i)) else if op == "bit_xor" or op == "bv_xor" then fz_ok(bit_xor(a.i, b.i)) else if op == "bv_add_u8" then fz_ok(bit_and(a.i + b.i, 255)) else if op == "bv_sub_u8" then fz_ok(bit_and(a.i - b.i, 255)) else fz_err()
fn fz_look(nm, env) = if nm == "x" then fz_ok(env.x) else if nm == "y" then fz_ok(env.y) else if nm == "v" then fz_ok(env.v) else fz_err()
fn fz_evA(sx, env) = match sx
    SNum(n)   => fz_ok(n)
    SVar(nm)  => fz_look(nm, env)
    SList(xs) => fz_evA_l(lk_svar_name(lk_shd(xs)), lk_stl(xs), env)
fn fz_evA_l(op, args, env) = if op == "let" then (let a = fz_evA(sb_a2(args), env) in if a.ok == 0 then fz_err() else fz_evA(sb_a3(args), {x: env.x, y: env.y, v: a.i})) else if op == "if" then (let c = fz_evG(sb_a1(args), env) in if c == 2 then fz_err() else if c == 1 then fz_evA(sb_a2(args), env) else fz_evA(sb_a3(args), env)) else if op == "bv_u8" then (let a = fz_evA(sb_a1(args), env) in if a.ok == 0 then a else fz_ok(bit_and(a.i, 255))) else if op == "bv_not_u8" then (let a = fz_evA(sb_a1(args), env) in if a.ok == 0 then a else fz_ok(255 - bit_and(a.i, 255))) else fz_ev2(op, fz_evA(sb_a1(args), env), fz_evA(sb_a2(args), env))
fn fz_cmpv(op, a, b) = if a.ok == 0 or b.ok == 0 then 2 else if op == "==" then (if a.i == b.i then 1 else 0) else if op == "!=" then (if a.i != b.i then 1 else 0) else if op == "<" then (if a.i < b.i then 1 else 0) else if op == "<=" then (if a.i <= b.i then 1 else 0) else if op == ">" then (if a.i > b.i then 1 else 0) else if op == ">=" then (if a.i >= b.i then 1 else 0) else 2
## 0 false, 1 true, 2 undefined (a trap, or a form the evaluator does not model)
fn fz_evG(sx, env) = match sx
    SNum(n)   => if n != 0 then 1 else 0
    SVar(nm)  => if nm == "true" then 1 else 2
    SList(xs) => fz_evG_l(lk_svar_name(lk_shd(xs)), lk_stl(xs), env)
fn fz_and(a, b) = if a == 2 or b == 2 then 2 else if a == 1 and b == 1 then 1 else 0
fn fz_or(a, b) = if a == 2 or b == 2 then 2 else if a == 1 or b == 1 then 1 else 0
fn fz_all(xs, env) = match xs
    Nil        => 1
    Cons(h, t) => fz_and(fz_evG(h, env), fz_all(t, env))
fn fz_evG_l(op, args, env) = if op == "and" then fz_all(args, env) else if op == "or" then fz_or(fz_evG(sb_a1(args), env), fz_evG(sb_a2(args), env)) else if op == "let" then (let a = fz_evA(sb_a2(args), env) in if a.ok == 0 then 2 else fz_evG(sb_a3(args), {x: env.x, y: env.y, v: a.i})) else if op == "if" then (let c = fz_evG(sb_a1(args), env) in if c == 2 then 2 else if c == 1 then fz_evG(sb_a2(args), env) else fz_evG(sb_a3(args), env)) else if op == "forall_range" or op == "exists_range" then (let lo = fz_evA(sb_a2(args), env) in let hi = fz_evA(sb_a3(args), env) in if lo.ok == 0 or hi.ok == 0 or hi.i - lo.i > 64 then 2 else fz_q(op, lo.i, hi.i, lk_shd(lk_stl(lk_stl(lk_stl(args)))), env)) else fz_cmpv(op, fz_evA(sb_a1(args), env), fz_evA(sb_a2(args), env))
fn fz_q(op, k, hi, body, env) = if k > hi then (if op == "forall_range" then 1 else 0) else let r = fz_evG(body, {x: env.x, y: env.y, v: k}) in if r == 2 then 2 else if op == "forall_range" and r == 0 then 0 else if op == "exists_range" and r == 1 then 1 else fz_q(op, k + 1, hi, body, env)
## a counterexample: every hypothesis true, the goal false
fn fz_cex_at(hy, g, env) = if fz_evG(hy, env) == 1 and fz_evG(g, env) == 0 then 1 else 0
fn fz_cex(hy, g, b, x, y, v) = if x > b then "" else if y > b then fz_cex(hy, g, b, x + 1, 0 - b, 0 - b) else if v > b then fz_cex(hy, g, b, x, y + 1, 0 - b) else if fz_cex_at(hy, g, {x: x, y: y, v: v}) == 1 then "x=" + str(x) + " y=" + str(y) + " v=" + str(v) else fz_cex(hy, g, b, x, y, v + 1)
fn fz_term_cex(t, b) = match t
    SList(xs) => fz_cex(sb_a2(xs), sb_a3(xs), b, 0 - b, 0 - b, 0 - b)
    _         => ""
fn fz_loop(s, n, d, b, proved, bad, acc) = if n <= 0 then acc + "fuzz: proved " + str(proved) + ", unsound " + str(bad) + "\n" else let t = fz_term(fz_mix(s), d) in if lk_prove_sx(t) == 0 then fz_loop(s + 1, n - 1, d, b, proved, bad, acc) else let cx = fz_term_cex(t, b) in if cx == "" then fz_loop(s + 1, n - 1, d, b, proved + 1, bad, acc) else fz_loop(s + 1, n - 1, d, b, proved + 1, bad + 1, if bad < 40 then acc + "UNSOUND seed " + str(s) + " " + cx + " :: " + sb_show(t) + "\n" else acc)
fn fz_parse(s) = (lk_parse_sexpr(s, 0, count(s))).node
## the oracle itself: it finds the counterexample of a false term and none for a true one (so "unsound 0" means something)
fn test_lcert_fuzz_oracle_finds_counterexamples() = if fz_term_cex(fz_parse("(implies (and (>= x 0)) (>= (/ (- 0 x) 2) (bit_shr (- 0 x) 1)))"), 3) == "" and fz_term_cex(fz_parse("(implies (and) (>= (/ x 2) (bit_shr x 1)))"), 3) == "" and fz_term_cex(fz_parse("(implies (and) (== (/ x 2) (bit_shr x 1)))"), 3) != "" and fz_term_cex(fz_parse("(implies (and (>= y 1)) (>= (% x y) 0))"), 3) != "" and fz_term_cex(fz_parse("(implies (and) (forall_range v 0 3 (>= (+ v x) 0)))"), 3) != "" then 1 else 0
## 4000 seeded terms at depths 2 and 3: some are proved (the test is not vacuous) and none of those has a counterexample
fn test_lcert_fuzz_core_has_no_unsound_verdict() = let r2 = fz_loop(1, 2000, 2, 3, 0, 0, "") in let r3 = fz_loop(5000, 2000, 3, 3, 0, 0, "") in if lk_find_sub(r2, ", unsound 0\n", 0) >= 0 and lk_find_sub(r3, ", unsound 0\n", 0) >= 0 and lk_find_sub(r2, "proved 0,", 0) < 0 and lk_find_sub(r3, "proved 0,", 0) < 0 then 1 else 0

print lcert_main(readall())
