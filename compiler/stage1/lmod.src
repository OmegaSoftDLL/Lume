## lmod.src -- Lume-Core module resolver, topological bundler, capability auditor, and
## package manifest/lockfile/tree engine (Track T, brick T3; Principles P26, P28, P32).
## Compiled to a standalone native ELF by `lumec` + `lasm` with zero C in the loop.
##
## Modes:
##   1. Module graph bundling & capability audit (default):
##      Reads optional `@grant <cap>` plus `@module <name> ... @end` and `@entry <name> ... @end`
##      blocks from stdin, resolves `use <mod>` dependencies in topological order, deduplicates
##      diamond imports, rejects missing modules or circular `use` chains via `ctfail`, enforces
##      capability grants (rejecting I/O calls `read`/`readall`/`emit`/`flush` inside imported
##      modules when `@grant pure` is active), and emits the self-contained Lume-Core bundle.
##   2. Manifest validation (`@manifest` on line 1 of stdin):
##      Parses `lume.toml`, validates required `[package]` fields (`name`, `version`, `edition`),
##      and prints machine-readable JSON metadata (or aborts via `ctfail` on invalid manifests).
##   3. Package generation (`@pkg-init`, `@pkg-lock`, or `@pkg-tree` on line 1):
##      Generates the standard manifest/entry source, a deterministic SHA-256 lockfile from
##      native filesystem evidence, or a sorted dependency tree from framed source blocks.

## --- hot character & string helpers ---
fn isws(c) = c == " " or c == "\t" or c == "\r"
fn isdigit(c) = c >= "0" and c <= "9"
fn isalpha(c) = c >= "a" and c <= "z" or c >= "A" and c <= "Z" or c == "_"
fn isalnum(c) = isdigit(c) or isalpha(c)

fn nlpos(s, n, i) = if i >= n then i else if at(s, i) == "\n" then i else nlpos(s, n, i + 1)
fn skipws(s, i, n) = if i >= n then i else if isws(at(s, i)) then skipws(s, i + 1, n) else i
fn rtrimend(s, e) = if e <= 0 then 0 else if isws(at(s, e - 1)) then rtrimend(s, e - 1) else e
fn rtrim(s) = let n = count(s) in if n <= 0 then s else if isws(at(s, n - 1)) then slicen(s, n, 0, rtrimend(s, n - 1)) else s
fn rtrimnl(s, e) = if e <= 0 then 0 else if at(s, e - 1) == "\n" or isws(at(s, e - 1)) then rtrimnl(s, e - 1) else e
fn chomp(s) = let n = count(s) in if n <= 0 then s else if at(s, n - 1) == "\n" or isws(at(s, n - 1)) then slicen(s, n, 0, rtrimnl(s, n - 1)) else s
fn ltrim(s) = let n = count(s) in if n <= 0 then s else if isws(at(s, 0)) == 0 then s else let a = skipws(s, 1, n) in if a >= n then "" else slicen(s, n, a, n)
fn trim(s) = ltrim(rtrim(s))
fn startswith(s, p) = let m = count(p) in if m == 0 then 1 else if count(s) < m then 0 else if at(s, 0) != at(p, 0) then 0 else slice(s, 0, m) == p
fn isindented(raw) = if count(raw) == 0 then 0 else isws(at(raw, 0))

## --- list & string helpers ---
fn app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, app(t, ys))
fn isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn revacc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => revacc(t, Cons(h, acc))
fn rev(xs) = revacc(xs, Nil)
fn pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => pairs2(a, t)
fn pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, pairs(r))
fn joinall(xs) = match xs
    Nil        => ""
    Cons(a, t) => if isnil(t) == 1 then a else joinall(pairs(xs))
fn addsep(xs, sep) = match xs
    Nil        => Nil
    Cons(h, t) => if isnil(t) == 1 then Cons(h, Nil) else Cons(h + sep, addsep(t, sep))
fn joinsep(xs, sep) = joinall(addsep(xs, sep))

fn rnlpos(s, i) = if i < 0 then 0 - 1 else if at(s, i) == "\n" then i else rnlpos(s, i - 1)
fn splitlinesn(s, n, i) = if i >= n then Nil else let e = nlpos(s, n, i) in Cons(slicen(s, n, i, e), splitlinesn(s, n, if e >= n then e else e + 1))
fn find_nl_from(s, n, mid) = let wn = if mid + 256 <= n then 256 else n - mid in let w = slicen(s, n, mid, mid + wn) in let k = nlpos(w, wn, 0) in if k < wn then mid + k else if mid + wn >= n then n else find_nl_from(s, n, mid + wn)
fn rfind_nl_from(s, n, end_pos) = if end_pos <= 0 then 0 - 1 else let start = if end_pos >= 256 then end_pos - 256 else 0 in let wn = end_pos - start in let w = slicen(s, n, start, end_pos) in let k = rnlpos(w, wn - 1) in if k >= 0 then start + k else rfind_nl_from(s, n, start)
fn splitlines_no_right_nl(s, n, half) = let sp0 = rfind_nl_from(s, n, half) in if sp0 < 0 then Cons(s, Nil) else app(splitlines_dc(slicen(s, n, 0, sp0), sp0), Cons(slicen(s, n, sp0 + 1, n), Nil))
fn splitlines_dc(s, n) = if n <= 256 then splitlinesn(s, n, 0) else let half = n / 2 in let sp = find_nl_from(s, n, half) in if sp >= n then splitlines_no_right_nl(s, n, half) else app(splitlines_dc(slicen(s, n, 0, sp), sp), splitlines_dc(slicen(s, n, sp + 1, n), n - sp - 1))
fn splitlines(s) = splitlines_dc(s, count(s))

fn contains(xs, x) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else contains(t, x)

## --- extract `use <mod>` dependencies & body lines from a module's lines ---
fn modname_clean(s) = let t = trim(s) in if startswith(t, "std.") then slice(t, 4, count(t)) else t
fn extractuses(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let tr = trim(h) in if startswith(tr, "use ") then Cons(modname_clean(slice(tr, 4, count(tr))), extractuses(t)) else extractuses(t)

## For imported library modules, strip `use ...` lines and top-level `print ...` demo lines.
fn liblines(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let raw = rtrim(h) in let tr = ltrim(raw) in if startswith(tr, "use ") or (isindented(raw) == 0 and startswith(tr, "print ")) then liblines(t) else Cons(raw, liblines(t))

## For the root entry module, strip only `use ...` lines (keep all `fn`, `type`, `print`, exprs).
fn entrylines(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let raw = rtrim(h) in let tr = ltrim(raw) in if startswith(tr, "use ") then entrylines(t) else Cons(raw, entrylines(t))

## --- capability scanner: detect I/O calls (`read`, `readall`, `emit`, `flush`, `fs_*`, `os_*`, `net_*`) in module text ---
fn isidch(c) = isalnum(c)
fn prev_boundary(s, i) = if i <= 0 then 1 else isidch(at(s, i - 1)) == 0
fn id_end(s, i, n) = if i >= n then i else if isidch(at(s, i)) == 1 then id_end(s, i + 1, n) else i
fn matchcallat(s, n, i, kw) = let kl = count(kw) in if i + kl > n then 0 else if prev_boundary(s, i) == 0 then 0 else if slicen(s, n, i, i + kl) != kw then 0 else if i + kl < n and isidch(at(s, i + kl)) == 1 then 0 else let j = skipws(s, i + kl, n) in j < n and at(s, j) == "("
fn matchpfxcall(s, n, i, pfx) = let pl = count(pfx) in if i + pl >= n then "" else if prev_boundary(s, i) == 0 then "" else if slicen(s, n, i, i + pl) != pfx then "" else let e = id_end(s, i + pl, n) in if e <= i + pl then "" else let j = skipws(s, e, n) in if j < n and at(s, j) == "(" then slicen(s, n, i, e) else ""
fn iocapat(s, n, i) = if matchcallat(s, n, i, "read") then "read" else if matchcallat(s, n, i, "readall") then "readall" else if matchcallat(s, n, i, "emit") then "emit" else if matchcallat(s, n, i, "flush") then "flush" else let fc = matchpfxcall(s, n, i, "fs_") in if fc != "" then fc else let oc = matchpfxcall(s, n, i, "os_") in if oc != "" then oc else matchpfxcall(s, n, i, "net_")
fn scanioline(s, n, i) = if i >= n then "" else let c = at(s, i) in if c == "#" then "" else if c == "\"" then scanioline(s, n, strend(s, i + 1, n)) else let cap = iocapat(s, n, i) in if cap != "" then cap else scanioline(s, n, i + 1)
fn strend(s, i, n) = if i >= n then i else if at(s, i) == "\"" then i + 1 else if at(s, i) == "\\" then strend(s, i + 2, n) else strend(s, i + 1, n)
fn findiocap(lines) = match lines
    Nil        => ""
    Cons(h, t) => let c = scanioline(h, count(h), 0) in if c != "" then c else findiocap(t)

fn checkcap(nm, lines, grant) = if grant != "pure" then 0 else let cap = findiocap(lines) in if cap == "" then 0 else ctfail("lume: capability error: module '" + nm + "' uses I/O capability '" + cap + "' not granted by lume.toml (allow = [\"pure\"])\n")

## --- parse framed stream (`@grant`, `@module <name> ... @end`, `@entry <name> ... @end`) ---
fn takeuntilend(lines) = match lines
    Nil        => {body: Nil, rest: Nil}
    Cons(h, t) => if trim(h) == "@end" then {body: Nil, rest: t} else let r = takeuntilend(t) in {body: Cons(h, r.body), rest: r.rest}

fn parseblocks(lines, grant, mods, entry) = match lines
    Nil        => {grant: grant, mods: rev(mods), entry: entry}
    Cons(h, t) => parseblock1(trim(h), h, t, grant, mods, entry)
fn parseblock1(tr, h, t, grant, mods, entry) = if tr == "" then parseblocks(t, grant, mods, entry) else if startswith(tr, "@grant ") then parseblocks(t, trim(slice(tr, 7, count(tr))), mods, entry) else if startswith(tr, "@module ") then let nm = trim(slice(tr, 8, count(tr))) in let b = takeuntilend(t) in parseblocks(b.rest, grant, Cons({name: nm, uses: extractuses(b.body), lines: b.body}, mods), entry) else if startswith(tr, "@entry ") then let nm = trim(slice(tr, 7, count(tr))) in let b = takeuntilend(t) in parseblocks(b.rest, grant, mods, {name: nm, uses: extractuses(b.body), lines: b.body}) else {grant: grant, mods: Nil, entry: {name: "main", uses: extractuses(Cons(h, t)), lines: Cons(h, t)}}

fn findmod(mods, nm) = match mods
    Nil        => {found: 0, m: {name: "", uses: Nil, lines: Nil}}
    Cons(h, t) => if h.name == nm then {found: 1, m: h} else findmod(t, nm)

## --- topological DFS resolver with cycle detection & diamond deduplication ---
fn resolve_list(uses, mods, grant, visiting, visited, chunks) = match uses
    Nil        => {visited: visited, chunks: chunks}
    Cons(u, t) => let r1 = resolve_one(u, mods, grant, visiting, visited, chunks) in resolve_list(t, mods, grant, visiting, r1.visited, r1.chunks)

fn resolve_one(nm, mods, grant, visiting, visited, chunks) = if contains(visited, nm) == 1 then {visited: visited, chunks: chunks} else if contains(visiting, nm) == 1 then ctfail("lume: module error: circular module dependency involving '" + nm + "'\n") else let lk = findmod(mods, nm) in if lk.found == 0 then ctfail("lume: module error: module '" + nm + "' not found\n") else resolve_mod(lk.m, mods, grant, Cons(nm, visiting), visited, chunks)

fn resolve_mod(m, mods, grant, visiting, visited, chunks) = let chk = checkcap(m.name, m.lines, grant) in let r = resolve_list(m.uses, mods, grant, visiting, visited, chunks) in {visited: Cons(m.name, r.visited), chunks: app(r.chunks, Cons("## --- module " + m.name + " ---\n" + joinsep(liblines(m.lines), "\n"), Nil))}

fn bundle(lines) = let st = parseblocks(lines, "io", Nil, {name: "main", uses: Nil, lines: Nil}) in let r = resolve_list(st.entry.uses, st.mods, st.grant, Cons(st.entry.name, Nil), Nil, Nil) in let chk_e = checkcap(st.entry.name, st.entry.lines, st.grant) in let ebody = joinsep(entrylines(st.entry.lines), "\n") in joinsep(app(r.chunks, Cons(ebody, Nil)), "\n\n")

## --- `@manifest` mode: parse & validate `lume.toml` in Lume-Core ---
fn unquote(s) = let t = trim(s) in let n = count(t) in if n < 2 then t else if at(t, 0) == "\"" and at(t, n - 1) == "\"" then slicen(t, n, 1, n - 1) else t
fn parse_kv(tr) = let eq = findeq(tr, 0, count(tr)) in if eq >= count(tr) then {k: "", v: ""} else {k: trim(slice(tr, 0, eq)), v: trim(slice(tr, eq + 1, count(tr)))}
fn findeq(s, i, n) = if i >= n then n else if at(s, i) == "=" then i else findeq(s, i + 1, n)

fn parse_cap_val(v) = let hp = contains_sub(v, "\"pure\"", 0, count(v)) in let hf = contains_sub(v, "\"ffi\"", 0, count(v)) in let hi = contains_sub(v, "\"io\"", 0, count(v)) in if hp == 1 and (hf == 1 or hi == 1) then ctfail("lume: manifest error: 'pure' capability cannot be combined with 'io' or 'ffi' in lume.toml\n") else if hp == 1 then "pure" else if hf == 1 then "ffi" else if hi == 1 then "io" else ctfail("lume: manifest error: unsupported or empty capability grant in lume.toml (expected \"pure\", \"io\", or \"ffi\")\n")
fn contains_sub(s, sub, i, n) = let m = count(sub) in if i + m > n then 0 else if slicen(s, n, i, i + m) == sub then 1 else contains_sub(s, sub, i + 1, n)

fn scanmanifest(lines, st) = match lines
    Nil        => st
    Cons(h, t) => let tr = trim(h) in if tr == "" or startswith(tr, "#") or startswith(tr, "[") then scanmanifest(t, st) else let kv = parse_kv(tr) in if kv.k == "name" then scanmanifest(t, {name: unquote(kv.v), version: st.version, edition: st.edition, cap: st.cap, protect: st.protect, ffi_libs: st.ffi_libs}) else if kv.k == "version" then scanmanifest(t, {name: st.name, version: unquote(kv.v), edition: st.edition, cap: st.cap, protect: st.protect, ffi_libs: st.ffi_libs}) else if kv.k == "edition" then scanmanifest(t, {name: st.name, version: st.version, edition: unquote(kv.v), cap: st.cap, protect: st.protect, ffi_libs: st.ffi_libs}) else if kv.k == "allow" or kv.k == "capabilities" then scanmanifest(t, {name: st.name, version: st.version, edition: st.edition, cap: parse_cap_val(kv.v), protect: st.protect, ffi_libs: st.ffi_libs}) else if kv.k == "protect" or kv.k == "level" then scanmanifest(t, {name: st.name, version: st.version, edition: st.edition, cap: st.cap, protect: unquote(kv.v), ffi_libs: st.ffi_libs}) else if kv.k == "libs" or kv.k == "link" then scanmanifest(t, {name: st.name, version: st.version, edition: st.edition, cap: st.cap, protect: st.protect, ffi_libs: kv.v}) else scanmanifest(t, st)

fn checkmanifest(m) = if m.name == "" then ctfail("lume: manifest error: missing 'name' in lume.toml\n") else if m.version == "" then ctfail("lume: manifest error: missing 'version' in lume.toml\n") else if m.edition != "" and m.edition != "2026" then ctfail("lume: manifest error: unsupported edition '" + m.edition + "' in lume.toml (expected \"2026\")\n") else if m.protect != "" and m.protect != "none" and m.protect != "standard" and m.protect != "hardened" and m.protect != "max" then ctfail("lume: manifest error: unsupported protect level '" + m.protect + "' in lume.toml (expected \"none\", \"standard\", \"hardened\", or \"max\")\n") else if m.ffi_libs != "" and m.ffi_libs != "[]" and m.cap != "ffi" then ctfail("lume: capability error [E0200]: [ffi] libs in lume.toml requires \"ffi\" in [capabilities] allow\n") else "{\"name\":\"" + m.name + "\",\"version\":\"" + m.version + "\",\"edition\":\"" + (if m.edition == "" then "2026" else m.edition) + "\",\"capabilities\":\"" + m.cap + "\"" + (if m.protect != "" then ",\"protect\":\"" + m.protect + "\"" else "") + (if m.ffi_libs != "" then ",\"ffi_libs\":" + m.ffi_libs else "") + "}"

## --- package init, deterministic lockfile, and source tree modes ---
fn pkg_init_toml(pkg) = "[package]\nname = \"" + pkg + "\"\nversion = \"0.1.0\"\nedition = \"2026\"\n\n[capabilities]\nallow = [\"io\"]\n\n[dependencies]"
fn pkg_init_main(pkg) = "## " + pkg + " — entry module\nfn main_val() -> int = 42\nprint main_val()"

fn pkg_fmt_lock_mods(mods) = match mods
    Nil        => ""
    Cons(h, t) => "\nmodule \"" + h.rel + "\" sha256 = \"" + h.sha + "\"" + pkg_fmt_lock_mods(t)
fn pkg_lock(st) = "# lume.lock — deterministic content-addressed lockfile (P26, P32)\nversion = 1\nmanifest = " + st.manifest + "\nmanifest_sha256 = \"" + st.manifest_sha + "\"" + pkg_fmt_lock_mods(st.mods)

fn pkg_scan_uses(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let tr = trim(h) in if startswith(tr, "use ") then Cons(trim(slice(tr, 4, count(tr))), pkg_scan_uses(t)) else pkg_scan_uses(t)
fn pkg_fmt_tree_mods(mods) = match mods
    Nil        => ""
    Cons(h, t) => let uses = pkg_scan_uses(splitlines(h.src)) in let line = if isnil(uses) == 1 then "  |-- " + h.rel else "  |-- " + h.rel + " -> " + joinsep(uses, " ") + " " in "\n" + line + pkg_fmt_tree_mods(t)
fn pkg_tree(st) = st.manifest + pkg_fmt_tree_mods(st.mods)

fn pkg_find_sp(s, i) = if i >= count(s) or at(s, i) == " " or at(s, i) == "\t" then i else pkg_find_sp(s, i + 1)
fn pkg_parse_mod_line(text) = let sp = pkg_find_sp(text, 0) in if sp >= count(text) then ctfail("lume: package request error: malformed @module line\n") else {sha: trim(slice(text, 0, sp)), rel: trim(slice(text, sp + 1, count(text))), src: ""}
fn pkg_source_block(lines) = let b = takeuntilend(lines) in {src: if isnil(b.body) == 1 then "" else joinsep(b.body, "\n") + "\n", rest: b.rest}

fn pkg_parse(lines, st) = match lines
    Nil        => {cmd: st.cmd, pkg: st.pkg, part: st.part, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: rev(st.mods)}
    Cons(h, t) => if h == "@pkg-init" or h == "@pkg-lock" or h == "@pkg-tree" then pkg_parse(t, {cmd: h, pkg: st.pkg, part: st.part, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods}) else if startswith(h, "@pkg ") then pkg_parse(t, {cmd: st.cmd, pkg: trim(slice(h, 5, count(h))), part: st.part, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods}) else if startswith(h, "@part ") then pkg_parse(t, {cmd: st.cmd, pkg: st.pkg, part: trim(slice(h, 6, count(h))), manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods}) else if startswith(h, "@manifest ") then pkg_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, manifest: trim(slice(h, 10, count(h))), manifest_sha: st.manifest_sha, mods: st.mods}) else if startswith(h, "@manifest_sha256 ") then pkg_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, manifest: st.manifest, manifest_sha: trim(slice(h, 17, count(h))), mods: st.mods}) else if startswith(h, "@module ") then pkg_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: Cons(pkg_parse_mod_line(trim(slice(h, 8, count(h)))), st.mods)}) else if startswith(h, "@modsrc ") then let rel = trim(slice(h, 8, count(h))) in let b = pkg_source_block(t) in pkg_parse(b.rest, {cmd: st.cmd, pkg: st.pkg, part: st.part, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: Cons({rel: rel, sha: "", src: b.src}, st.mods)}) else pkg_parse(t, st)

fn run_package(lines) = let st = pkg_parse(lines, {cmd: "", pkg: "app", part: "toml", manifest: "{}", manifest_sha: "", mods: Nil}) in if st.cmd == "@pkg-init" then (if st.part == "main" then pkg_init_main(st.pkg) else pkg_init_toml(st.pkg)) else if st.cmd == "@pkg-lock" then pkg_lock(st) else if st.cmd == "@pkg-tree" then pkg_tree(st) else ctfail("lume: package request error: missing package mode\n")

fn run_lmod(lines) = match lines
    Nil        => ""
    Cons(h, t) => let mode = trim(h) in if mode == "@manifest" then checkmanifest(scanmanifest(t, {name: "", version: "", edition: "", cap: "io", protect: "", ffi_libs: ""})) else if mode == "@pkg-init" or mode == "@pkg-lock" or mode == "@pkg-tree" then run_package(lines) else bundle(lines)

print chomp(run_lmod(splitlines(readall())))
