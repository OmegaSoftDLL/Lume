## lmod.src -- Lume-Core module resolver, topological bundler, capability auditor, and
## package manifest/lockfile/tree engine (Track T, brick T3; Principles P26, P28, P32).
## Compiled to a standalone native ELF by `lumec` + `lasm` with zero C in the loop.
##
## Modes:
##   1. Module graph bundling & capability audit (default):
##      Reads optional `@grant <cap>` plus `@module <name> ... @end` and `@entry <name> ... @end`
##      blocks from stdin, resolves `use <mod>` dependencies in topological order, deduplicates
##      diamond imports, rejects missing modules or circular `use` chains via `ctfail`, enforces
##      capability grants (rejecting I/O calls `read`/`readall`/`emit`/`flush` inside imported
##      modules when `@grant pure` is active), and emits the self-contained Lume-Core bundle.
##   2. Manifest validation (`@manifest` on line 1 of stdin):
##      Parses `lume.toml`, validates required `[package]` fields (`name`, `version`, `edition`),
##      and prints machine-readable JSON metadata (or aborts via `ctfail` on invalid manifests).
##   3. Package generation (`@pkg-init`, `@pkg-lock`, or `@pkg-tree` on line 1):
##      Generates the standard manifest/entry source, a deterministic SHA-256 lockfile from
##      native filesystem evidence, or a sorted dependency tree from framed source blocks.

## --- hot character & string helpers ---
fn isws(c) = c == " " or c == "\t" or c == "\r"
fn isdigit(c) = c >= "0" and c <= "9"
fn isalpha(c) = c >= "a" and c <= "z" or c >= "A" and c <= "Z" or c == "_"
fn isalnum(c) = isdigit(c) or isalpha(c)

fn nlpos(s, n, i) = if i >= n then i else if at(s, i) == "\n" then i else nlpos(s, n, i + 1)
fn skipws(s, i, n) = if i >= n then i else if isws(at(s, i)) then skipws(s, i + 1, n) else i
fn rtrimend(s, e) = if e <= 0 then 0 else if isws(at(s, e - 1)) then rtrimend(s, e - 1) else e
fn rtrim(s) = let n = count(s) in if n <= 0 then s else if isws(at(s, n - 1)) then slicen(s, n, 0, rtrimend(s, n - 1)) else s
fn rtrimnl(s, e) = if e <= 0 then 0 else if at(s, e - 1) == "\n" or isws(at(s, e - 1)) then rtrimnl(s, e - 1) else e
fn chomp(s) = let n = count(s) in if n <= 0 then s else if at(s, n - 1) == "\n" or isws(at(s, n - 1)) then slicen(s, n, 0, rtrimnl(s, n - 1)) else s
fn ltrim(s) = let n = count(s) in if n <= 0 then s else if isws(at(s, 0)) == 0 then s else let a = skipws(s, 1, n) in if a >= n then "" else slicen(s, n, a, n)
fn trim(s) = ltrim(rtrim(s))
fn startswith(s, p) = let m = count(p) in if m == 0 then 1 else if count(s) < m then 0 else if at(s, 0) != at(p, 0) then 0 else slice(s, 0, m) == p
fn isindented(raw) = if count(raw) == 0 then 0 else isws(at(raw, 0))

## --- list & string helpers ---
fn app(xs, ys) = match xs
    Nil        => ys
    Cons(h, t) => Cons(h, app(t, ys))
fn isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0
fn revacc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => revacc(t, Cons(h, acc))
fn rev(xs) = revacc(xs, Nil)
fn pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => pairs2(a, t)
fn pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, pairs(r))
fn joinall(xs) = match xs
    Nil        => ""
    Cons(a, t) => if isnil(t) == 1 then a else joinall(pairs(xs))
fn addsep(xs, sep) = match xs
    Nil        => Nil
    Cons(h, t) => if isnil(t) == 1 then Cons(h, Nil) else Cons(h + sep, addsep(t, sep))
fn joinsep(xs, sep) = joinall(addsep(xs, sep))

fn rnlpos(s, i) = if i < 0 then 0 - 1 else if at(s, i) == "\n" then i else rnlpos(s, i - 1)
fn splitlinesn(s, n, i) = if i >= n then Nil else let e = nlpos(s, n, i) in Cons(slicen(s, n, i, e), splitlinesn(s, n, if e >= n then e else e + 1))
fn find_nl_from(s, n, mid) = let wn = if mid + 256 <= n then 256 else n - mid in let w = slicen(s, n, mid, mid + wn) in let k = nlpos(w, wn, 0) in if k < wn then mid + k else if mid + wn >= n then n else find_nl_from(s, n, mid + wn)
fn rfind_nl_from(s, n, end_pos) = if end_pos <= 0 then 0 - 1 else let start = if end_pos >= 256 then end_pos - 256 else 0 in let wn = end_pos - start in let w = slicen(s, n, start, end_pos) in let k = rnlpos(w, wn - 1) in if k >= 0 then start + k else rfind_nl_from(s, n, start)
fn splitlines_no_right_nl(s, n, half) = let sp0 = rfind_nl_from(s, n, half) in if sp0 < 0 then Cons(s, Nil) else app(splitlines_dc(slicen(s, n, 0, sp0), sp0), Cons(slicen(s, n, sp0 + 1, n), Nil))
fn splitlines_dc(s, n) = if n <= 256 then splitlinesn(s, n, 0) else let half = n / 2 in let sp = find_nl_from(s, n, half) in if sp >= n then splitlines_no_right_nl(s, n, half) else app(splitlines_dc(slicen(s, n, 0, sp), sp), splitlines_dc(slicen(s, n, sp + 1, n), n - sp - 1))
fn splitlines(s) = splitlines_dc(s, count(s))

fn contains(xs, x) = match xs
    Nil        => 0
    Cons(h, t) => if h == x then 1 else contains(t, x)

## --- extract `use <mod>` dependencies & body lines from a module's lines ---
fn modname_clean(s) = let t = trim(s) in if startswith(t, "std.") then slice(t, 4, count(t)) else t
fn extractuses(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let tr = trim(h) in if startswith(tr, "use ") then Cons(usemod(slice(tr, 4, count(tr))), extractuses(t)) else extractuses(t)

## For imported library modules, blank `use ...` lines and top-level `print ...` demo lines (an empty line keeps the
## line numbers of the file: diagnostics map back through the `## --- module NAME ---` marker).
fn liblines(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let raw = rtrim(h) in let tr = ltrim(raw) in if startswith(tr, "use ") or (isindented(raw) == 0 and startswith(tr, "print ")) then Cons("", liblines(t)) else Cons(raw, liblines(t))

## For the root entry module, blank only `use ...` lines (keep all `fn`, `type`, `print`, exprs); its marker is
## `## --- entry NAME ---`.
fn entrylines(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let raw = rtrim(h) in let tr = ltrim(raw) in if startswith(tr, "use ") then Cons("", entrylines(t)) else Cons(raw, entrylines(t))

## --- capability scanner: detect I/O calls (`read`, `readall`, `emit`, `flush`, `fs_*`, `os_*`, `net_*`) in module text ---
fn isidch(c) = isalnum(c)
fn prev_boundary(s, i) = if i <= 0 then 1 else isidch(at(s, i - 1)) == 0
fn id_end(s, i, n) = if i >= n then i else if isidch(at(s, i)) == 1 then id_end(s, i + 1, n) else i
fn matchcallat(s, n, i, kw) = let kl = count(kw) in if i + kl > n then 0 else if prev_boundary(s, i) == 0 then 0 else if slicen(s, n, i, i + kl) != kw then 0 else if i + kl < n and isidch(at(s, i + kl)) == 1 then 0 else let j = skipws(s, i + kl, n) in j < n and at(s, j) == "("
fn matchpfxcall(s, n, i, pfx) = let pl = count(pfx) in if i + pl >= n then "" else if prev_boundary(s, i) == 0 then "" else if slicen(s, n, i, i + pl) != pfx then "" else let e = id_end(s, i + pl, n) in if e <= i + pl then "" else let j = skipws(s, e, n) in if j < n and at(s, j) == "(" then slicen(s, n, i, e) else ""
fn iocapat(s, n, i) = if matchcallat(s, n, i, "read") then "read" else if matchcallat(s, n, i, "readall") then "readall" else if matchcallat(s, n, i, "emit") then "emit" else if matchcallat(s, n, i, "flush") then "flush" else let fc = matchpfxcall(s, n, i, "fs_") in if fc != "" then fc else let oc = matchpfxcall(s, n, i, "os_") in if oc != "" then oc else matchpfxcall(s, n, i, "net_")
fn scanioline(s, n, i) = if i >= n then "" else let c = at(s, i) in if c == "#" then "" else if c == "\"" then scanioline(s, n, strend(s, i + 1, n)) else let cap = iocapat(s, n, i) in if cap != "" then cap else scanioline(s, n, i + 1)
fn strend(s, i, n) = if i >= n then i else if at(s, i) == "\"" then i + 1 else if at(s, i) == "\\" then strend(s, i + 2, n) else strend(s, i + 1, n)
fn findiocap(lines) = match lines
    Nil        => ""
    Cons(h, t) => let c = scanioline(h, count(h), 0) in if c != "" then c else findiocap(t)

fn checkcap(nm, lines, grant) = if grant != "pure" then 0 else let cap = findiocap(lines) in if cap == "" then 0 else ctfail("lume: capability error: module '" + nm + "' uses I/O capability '" + cap + "' not granted by lume.toml (allow = [\"pure\"])\n")

## --- parse framed stream (`@grant`, `@module <name> ... @end`, `@entry <name> ... @end`) ---
fn takeuntilend(lines) = match lines
    Nil        => {body: Nil, rest: Nil}
    Cons(h, t) => if trim(h) == "@end" then {body: Nil, rest: t} else let r = takeuntilend(t) in {body: Cons(h, r.body), rest: r.rest}

fn parseblocks(lines, grant, mods, entry) = match lines
    Nil        => {grant: grant, mods: rev(mods), entry: entry}
    Cons(h, t) => parseblock1(trim(h), h, t, grant, mods, entry)
fn parseblock1(tr, h, t, grant, mods, entry) = if tr == "" then parseblocks(t, grant, mods, entry) else if startswith(tr, "@grant ") then parseblocks(t, trim(slice(tr, 7, count(tr))), mods, entry) else if startswith(tr, "@module ") then let nm = trim(slice(tr, 8, count(tr))) in let b = takeuntilend(t) in parseblocks(b.rest, grant, Cons({name: nm, uses: extractuses(b.body), lines: b.body}, mods), entry) else if startswith(tr, "@entry ") then let nm = trim(slice(tr, 7, count(tr))) in let b = takeuntilend(t) in parseblocks(b.rest, grant, mods, {name: nm, uses: extractuses(b.body), lines: b.body}) else {grant: grant, mods: Nil, entry: {name: "main", uses: extractuses(Cons(h, t)), lines: Cons(h, t)}}

fn findmod(mods, nm) = match mods
    Nil        => {found: 0, m: {name: "", uses: Nil, lines: Nil}}
    Cons(h, t) => if h.name == nm then {found: 1, m: h} else findmod(t, nm)

## --- module namespaces: `use X as Y`, `Y.NAME`, and one name defined in several modules ---
## A name defined at the top level of two or more modules is kept apart by a suffix: in a library module M every
## occurrence of the name becomes NAME__M (the entry module keeps its own names, so its tests keep their names). A
## module that uses such a name without defining it means the one owner it can reach through its `use` lines (a direct
## import first); two candidates are an error that asks for a qualified name. `Y.NAME`, with Y a module named in a
## `use` line or the alias of `use X as Y`, means NAME of that module. Lines keep their numbers.
fn wordend(s, i, n) = if i >= n then i else if isws(at(s, i)) then i else wordend(s, i + 1, n)
fn usehead(rest) = let r = trim(rest) in slice(r, 0, wordend(r, 0, count(r)))
fn usemod(rest) = let r = trim(rest) in modname_clean(slice(r, 0, wordend(r, 0, count(r))))
fn usealias(rest) = let r = trim(rest) in let after = trim(slice(r, wordend(r, 0, count(r)), count(r))) in if startswith(after, "as ") then trim(slice(after, 3, count(after))) else ""
## the prefixes a module may write before a name of an imported module: the alias of `use X as Y`, the module as
## written, and, for a module in a folder (`use ns/alfa`) imported without `as`, its last segment (`alfa.nome`) when no
## other `use` line without `as` ends with the same segment (a module imported `as` a name is named by that name)
fn ns_lastseg_go(m, i) = if i < 0 then m else if at(m, i) == "/" then slice(m, i + 1, count(m)) else ns_lastseg_go(m, i - 1)
fn ns_lastseg(m) = ns_lastseg_go(m, count(m) - 1)
fn ns_usemods(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let tr = trim(h) in if startswith(tr, "use ") and usealias(slice(tr, 4, count(tr))) == "" then Cons(usemod(slice(tr, 4, count(tr))), ns_usemods(t)) else ns_usemods(t)
fn ns_segcount(ms, seg) = match ms
    Nil        => 0
    Cons(h, t) => (if ns_lastseg(h) == seg then 1 else 0) + ns_segcount(t, seg)
fn extractaliases(lines) = extractaliases_go(lines, ns_usemods(lines))
fn extractaliases_go(lines, mods) = match lines
    Nil        => Nil
    Cons(h, t) => let tr = trim(h) in if startswith(tr, "use ") then let rest = slice(tr, 4, count(tr)) in let m = usemod(rest) in let a = usealias(rest) in let seg = ns_lastseg(m) in let more = if a != "" then Cons({a: a, m: m}, extractaliases_go(t, mods)) else extractaliases_go(t, mods) in let withseg = if a == "" and seg != m and ns_segcount(mods, seg) == 1 then Cons({a: seg, m: m}, more) else more in Cons({a: m, m: m}, withseg) else extractaliases_go(t, mods)

## the name a top-level line defines (fn, type, law, const, let, effect after pub/total/partial), else ""
fn ns_skipmods(s, i, n) = let j = skipws(s, i, n) in let e = id_end(s, j, n) in let w = slicen(s, n, j, e) in if w == "pub" or w == "total" or w == "partial" then ns_skipmods(s, e, n) else j
fn ns_defname(raw) = let n = count(raw) in if n == 0 then "" else if isws(at(raw, 0)) then "" else if isalpha(at(raw, 0)) == 0 then "" else let j = ns_skipmods(raw, 0, n) in let e = id_end(raw, j, n) in let kw = slicen(raw, n, j, e) in if kw == "fn" or kw == "type" or kw == "law" or kw == "const" or kw == "let" or kw == "effect" then let a = skipws(raw, e, n) in if a < n and isalpha(at(raw, a)) then slicen(raw, n, a, id_end(raw, a, n)) else "" else ""
fn ns_defs(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let d = ns_defname(h) in if d == "" then ns_defs(t) else Cons(d, ns_defs(t))
fn nsrec(m) = {name: m.name, uses: m.uses, lines: m.lines, aliases: extractaliases(m.lines), defs: ns_defs(m.lines)}

## names defined in two or more modules: sort "name\x01module" keys and group equal names
fn ns_keys1(ds, m, acc) = match ds
    Nil        => acc
    Cons(d, t) => ns_keys1(t, m, Cons(d + chr(1) + m, acc))
fn ns_keys(recs, acc) = match recs
    Nil        => acc
    Cons(r, t) => ns_keys(t, ns_keys1(r.defs, r.name, acc))
fn ns_merge(xs, ys, acc) = match xs
    Nil        => revacc(acc, ys)
    Cons(a, t) => ns_merge1(a, t, xs, ys, acc)
fn ns_merge1(a, t, xs, ys, acc) = match ys
    Nil        => revacc(acc, xs)
    Cons(b, u) => if b < a then ns_merge(xs, u, Cons(b, acc)) else ns_merge(t, ys, Cons(a, acc))
fn ns_wrap(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => ns_wrap(t, Cons(Cons(h, Nil), acc))
fn ns_pass(ls, acc) = match ls
    Nil        => acc
    Cons(a, t) => ns_pass1(a, t, acc)
fn ns_pass1(a, t, acc) = match t
    Nil        => Cons(a, acc)
    Cons(b, r) => ns_pass(r, Cons(ns_merge(a, b, Nil), acc))
fn ns_all(ls) = match ls
    Nil        => Nil
    Cons(a, t) => if isnil(t) == 1 then a else ns_all(ns_pass(ls, Nil))
fn ns_sort(xs) = ns_all(ns_wrap(xs, Nil))
fn ns_sep(s, i, n) = if i >= n then n else if at(s, i) == chr(1) then i else ns_sep(s, i + 1, n)
fn ns_kname(k) = slice(k, 0, ns_sep(k, 0, count(k)))
fn ns_kmod(k) = slice(k, ns_sep(k, 0, count(k)) + 1, count(k))
fn ns_take(ks, nm, mods) = match ks
    Nil        => {rest: Nil, mods: mods}
    Cons(k, t) => if ns_kname(k) == nm then ns_take(t, nm, if contains(mods, ns_kmod(k)) == 1 then mods else Cons(ns_kmod(k), mods)) else {rest: ks, mods: mods}
fn ns_groups(ks, acc) = match ks
    Nil        => acc
    Cons(k, t) => let nm = ns_kname(k) in let g = ns_take(t, nm, Cons(ns_kmod(k), Nil)) in ns_groups(g.rest, if isnil(g.mods) == 0 and ns_len(g.mods) >= 2 then Cons({n: nm, owners: rev(g.mods)}, acc) else acc)
fn ns_len(xs) = match xs
    Nil        => 0
    Cons(h, t) => 1 + ns_len(t)

## modules and what a module can reach through its `use` lines
fn ns_find(recs, nm) = match recs
    Nil        => {name: "", uses: Nil, lines: Nil, aliases: Nil, defs: Nil}
    Cons(r, t) => if r.name == nm then r else ns_find(t, nm)
fn ns_reach(todo, recs, seen) = match todo
    Nil        => seen
    Cons(m, t) => if contains(seen, m) == 1 then ns_reach(t, recs, seen) else ns_reach(app((ns_find(recs, m)).uses, t), recs, Cons(m, seen))
fn ns_inter(xs, ys) = match xs
    Nil        => Nil
    Cons(h, t) => if contains(ys, h) == 1 then Cons(h, ns_inter(t, ys)) else ns_inter(t, ys)
fn ns_tagc(s, i, n) = if i >= n then "" else (if isalnum(at(s, i)) then at(s, i) else "_") + ns_tagc(s, i + 1, n)
fn ns_target(m, nm, entry) = if m == entry then nm else nm + "__" + ns_tagc(m, 0, count(m))

## where a shared name points from inside module r: "" (untouched), a new name, or "?a and b" (ambiguous)
fn ns_pick(nm, c, uses, entry) = match c
    Nil        => ""
    Cons(a, rest) => if isnil(rest) == 1 then ns_target(a, nm, entry) else ns_pick_direct(nm, c, ns_inter(c, uses), entry)
fn ns_pick_direct(nm, c, d, entry) = if ns_len(d) == 1 then ns_target(ns_first(d), nm, entry) else "?" + joinsep(c, " and ")
fn ns_first(xs) = match xs
    Nil        => ""
    Cons(h, t) => h
fn ns_to(g, r, reach, entry) = if contains(g.owners, r.name) == 1 then ns_target(r.name, g.n, entry) else ns_pick(g.n, ns_inter(g.owners, reach), r.uses, entry)
fn ns_map(gs, r, reach, entry, acc) = match gs
    Nil        => acc
    Cons(g, t) => let to = ns_to(g, r, reach, entry) in ns_map(t, r, reach, entry, if to == "" or to == g.n then acc else Cons({f: g.n, t: to}, acc))
fn ns_lookup(mp, w) = match mp
    Nil        => ""
    Cons(e, t) => if e.f == w then e.t else ns_lookup(t, w)
fn ns_alias(als, w) = match als
    Nil        => ""
    Cons(e, t) => if e.a == w then e.m else ns_alias(t, w)
fn ns_isdup(gs, w) = match gs
    Nil        => 0
    Cons(g, t) => if g.n == w then 1 else ns_isdup(t, w)

## does s contain w (plain text)?
fn ns_has(s, n, w, m, i) = if i + m > n then 0 else if at(s, i) == at(w, 0) and slicen(s, n, i, i + m) == w then 1 else ns_has(s, n, w, m, i + 1)
fn ns_has_any_map(s, n, mp) = match mp
    Nil        => 0
    Cons(e, t) => if ns_has(s, n, e.f, count(e.f), 0) == 1 then 1 else ns_has_any_map(s, n, t)
fn ns_has_any_alias(s, n, als) = match als
    Nil        => 0
    Cons(e, t) => if ns_has(s, n, e.a + ".", count(e.a) + 1, 0) == 1 then 1 else ns_has_any_alias(s, n, t)

## a record key: the identifier at [i, e) is followed by ':' (not '::') and sits right inside '{', or is the first thing
## on a line outside every bracket (a key of a record written over several lines)
fn ns_top(st) = match st
    Nil        => ""
    Cons(h, t) => h
fn ns_pop(st) = match st
    Nil        => Nil
    Cons(h, t) => t
fn ns_onlyws(s, i, e) = if i >= e then 1 else if isws(at(s, i)) or at(s, i) == "," then ns_onlyws(s, i + 1, e) else 0
fn ns_iskey(s, n, i, e, st) = let j = skipws(s, e, n) in if j >= n or at(s, j) != ":" then 0 else if j + 1 < n and at(s, j + 1) == ":" then 0 else if ns_top(st) == "{" then 1 else isnil(st) == 1 and ns_onlyws(s, 0, i) == 1

## the names a module binds locally (let / var, the parameters of fn and of fn(...) lambdas, the variables of match
## patterns): a shared global name that is also bound locally stays the local one where it is written, so it is not an
## ambiguity (`let c = ...` or `fn(c) => ...` next to two imported modules that both define c)
fn ns_tokw(s, i, n) = if i < n and isidch(at(s, i)) then ns_tokw(s, i + 1, n) else i
fn ns_toks(s, i, n, acc) = if i >= n then rev(acc) else let c = at(s, i) in if c == "\"" then ns_toks(s, strend(s, i + 1, n), n, acc) else if c == "#" then rev(acc) else if isws(c) then ns_toks(s, i + 1, n, acc) else if isalpha(c) then (let e = ns_tokw(s, i, n) in ns_toks(s, e, n, Cons(slicen(s, n, i, e), acc))) else if c == "=" and i + 1 < n and at(s, i + 1) == ">" then ns_toks(s, i + 2, n, Cons("=>", acc)) else ns_toks(s, i + 1, n, Cons(c, acc))
fn ns_kw(w) = w == "let" or w == "var" or w == "fn" or w == "if" or w == "then" or w == "else" or w == "match" or w == "in" or w == "and" or w == "or" or w == "not" or w == "own" or w == "mut" or w == "ref"
fn ns_islower(w) = count(w) > 0 and at(w, 0) >= "a" and at(w, 0) <= "z" and ns_kw(w) == 0
fn ns_has_arrow(ts) = match ts
    Nil        => 0
    Cons(h, t) => if h == "=>" then 1 else ns_has_arrow(t)
fn ns_pat_names(ts, acc) = match ts
    Nil        => acc
    Cons(h, t) => if h == "=>" then acc else ns_pat_names(t, if ns_islower(h) then Cons(h, acc) else acc)
fn ns_params(ts, depth, expect, acc) = match ts
    Nil        => {rest: Nil, acc: acc}
    Cons(h, t) => if h == "(" then ns_params(t, depth + 1, 1, acc) else if h == ")" then (if depth <= 1 then {rest: t, acc: acc} else ns_params(t, depth - 1, 0, acc)) else if h == "," and depth == 1 then ns_params(t, depth, 1, acc) else if expect == 1 and depth == 1 and ns_islower(h) then ns_params(t, depth, 0, Cons(h, acc)) else ns_params(t, depth, 0, acc)
fn ns_bind_toks(ts, acc) = match ts
    Nil        => acc
    Cons(h, t) => if h == "let" or h == "var" then ns_bind_let(t, acc) else if h == "fn" then ns_bind_fn(t, acc) else ns_bind_toks(t, acc)
fn ns_bind_let(ts, acc) = match ts
    Nil        => acc
    Cons(h, t) => ns_bind_toks(t, if ns_islower(h) then Cons(h, acc) else acc)
fn ns_bind_fnp(ts, acc) = let r = ns_params(ts, 0, 1, acc) in ns_bind_toks(r.rest, r.acc)
fn ns_bind_fn(ts, acc) = match ts
    Nil        => acc
    Cons(h, t) => if h == "(" then ns_bind_fnp(ts, acc) else ns_bind_fn2(t, acc)
fn ns_bind_fn2(t, acc) = match t
    Nil          => acc
    Cons(h2, t2) => if h2 == "(" then ns_bind_fnp(t, acc) else ns_bind_toks(t, acc)
fn ns_binders(lines, acc) = match lines
    Nil        => acc
    Cons(l, t) => let ts = ns_toks(l, 0, count(l), Nil) in let a1 = ns_bind_toks(ts, acc) in ns_binders(t, if ns_has_arrow(ts) == 1 then ns_pat_names(ts, a1) else a1)

## rewrite one line; cx = {mp, als, recs, gs, entry, mod, line}
fn ns_rw(s, n, i, start, acc, st, cx) = if i >= n then joinall(rev(Cons(slicen(s, n, start, n), acc))) else let c = at(s, i) in if c == "\"" then ns_rw(s, n, strend(s, i + 1, n), start, acc, st, cx) else if c == "#" then joinall(rev(Cons(slicen(s, n, start, n), acc))) else if c == "(" or c == "[" or c == "{" then ns_rw(s, n, i + 1, start, acc, Cons(c, st), cx) else if c == ")" or c == "]" or c == "}" then ns_rw(s, n, i + 1, start, acc, ns_pop(st), cx) else if isalpha(c) and prev_boundary(s, i) then ns_word(s, n, i, id_end(s, i, n), start, acc, st, cx) else ns_rw(s, n, i + 1, start, acc, st, cx)
## the modules imported without `as` whose last segment is w (`use a/m` and `use b/m` both end in m)
fn ns_segmods(ms, w) = match ms
    Nil        => Nil
    Cons(h, t) => if ns_lastseg(h) == w and h != w then Cons(h, ns_segmods(t, w)) else ns_segmods(t, w)
## `w.name` where w is the last segment of two imported modules: the rule and the fix, at the file, line and column
fn ns_segamb(cx, i, w, ms) = ctfail(cx.mod + ".src:" + str(cx.line) + ":" + str(i + 1) + ": lume: name error: '" + w + "' names more than one module (" + joinsep(ms, " and ") + "): a module in a folder is written by its last segment only when no other `use` without `as` ends the same way; give one of them a name, e.g. `use " + ns_kfirst2(ms) + " as " + w + "2` and then " + w + "2.name\n")
fn ns_kfirst2(ms) = match ms
    Nil        => ""
    Cons(h, t) => ns_ksecond(t, h)
fn ns_ksecond(t, h) = match t
    Nil        => h
    Cons(h2, t2) => h2
fn ns_word(s, n, i, e, start, acc, st, cx) = if i > 0 and at(s, i - 1) == "." then ns_rw(s, n, e, start, acc, st, cx) else let w = slicen(s, n, i, e) in let m = if e + 1 < n and at(s, e) == "." and isalpha(at(s, e + 1)) then ns_alias(cx.als, w) else "" in if m != "" then ns_qual(s, n, i, e, id_end(s, e + 1, n), m, start, acc, st, cx) else if e + 1 < n and at(s, e) == "." and isalpha(at(s, e + 1)) and contains(cx.bnd, w) == 0 and ns_len(ns_segmods(ns_usemods((ns_find(cx.recs, cx.mod)).lines), w)) >= 2 then ns_segamb(cx, i, w, ns_segmods(ns_usemods((ns_find(cx.recs, cx.mod)).lines), w)) else let t = ns_lookup(cx.mp, w) in if t == "" or ns_iskey(s, n, i, e, st) == 1 then ns_rw(s, n, e, start, acc, st, cx) else if at(t, 0) == "?" and contains(cx.bnd, w) == 1 then ns_rw(s, n, e, start, acc, st, cx) else if at(t, 0) == "?" then ctfail(cx.mod + ".src:" + str(cx.line) + ":" + str(i + 1) + ": lume: name error: '" + w + "' is defined in modules " + slice(t, 1, count(t)) + "; write " + ns_lastseg(ns_kfirst(slice(t, 1, count(t)))) + "." + w + (if ns_lastseg(ns_kfirst(slice(t, 1, count(t)))) != ns_kfirst(slice(t, 1, count(t))) then " (or `use " + ns_kfirst(slice(t, 1, count(t))) + " as <alias>` and <alias>." + w + ")" else "") + "\n") else ns_rw(s, n, e, e, Cons(t, Cons(slicen(s, n, start, i), acc)), st, cx)
fn ns_kfirst(s) = slice(s, 0, wordend(s, 0, count(s)))
fn ns_qual(s, n, i, e, ne, m, start, acc, st, cx) = let nm = slicen(s, n, e + 1, ne) in if contains((ns_find(cx.recs, m)).defs, nm) == 0 then ns_rw(s, n, e, start, acc, st, cx) else let t0 = if ns_isdup(cx.gs, nm) == 1 then ns_target(m, nm, cx.entry) else nm in let t = ns_qshadow(s, n, ne, nm, t0, cx) in ns_rw(s, n, ne, ne, Cons(t, Cons(slicen(s, n, start, i), acc)), st, cx)
## `M.name(args)` where a local binding of the same name is in scope (`let name = ...`): the call goes to a reserved
## forwarder lumeq<arity>__<target>, defined at the top level of the bundle (ns_qdefs), where no local can shadow it
fn ns_qshadow(s, n, ne, nm, t, cx) = if contains(cx.bnd, nm) == 0 then t else let j = skipws(s, ne, n) in if j >= n or at(s, j) != "(" then t else "lumeq" + str(ns_argc(s, n, j + 1, 0, 0, 0)) + "__" + t
## the arguments of a call whose "(" ends at j: top-level commas + 1 (0 for "()"); strings and nested brackets skipped
fn ns_argc(s, n, i, depth, commas, any) = if i >= n then commas + any else let c = at(s, i) in if c == "\"" then ns_argc(s, n, ns_strend(s, n, i + 1), depth, commas, 1) else if c == "(" or c == "[" or c == "{" then ns_argc(s, n, i + 1, depth + 1, commas, 1) else if (c == ")" or c == "]" or c == "}") and depth == 0 then (if any == 0 then 0 else commas + 1) else if c == ")" or c == "]" or c == "}" then ns_argc(s, n, i + 1, depth - 1, commas, 1) else if c == "," and depth == 0 then ns_argc(s, n, i + 1, depth, commas + 1, 1) else ns_argc(s, n, i + 1, depth, commas, if isws(c) then any else 1)
fn ns_strend(s, n, i) = if i >= n then n else if at(s, i) == "\\" then ns_strend(s, n, i + 2) else if at(s, i) == "\"" then i + 1 else ns_strend(s, n, i + 1)
## the forwarders the bundle names: fn lumeq2__f(a0, a1) = f(a0, a1), one per distinct name
fn ns_qnames(s, n, i, acc) = if i + 5 >= n then acc else if slicen(s, n, i, i + 5) == "lumeq" and (i == 0 or isalnum(at(s, i - 1)) == 0) then (let e = id_end(s, i, n) in let w = slicen(s, n, i, e) in ns_qnames(s, n, e, if contains(acc, w) == 1 then acc else Cons(w, acc))) else ns_qnames(s, n, i + 1, acc)
fn ns_qsplit(w, i) = if i + 1 >= count(w) then 0 - 1 else if at(w, i) == "_" and at(w, i + 1) == "_" then i else ns_qsplit(w, i + 1)
fn ns_qparams(k, i) = if i >= k then "" else "a" + str(i) + (if i + 1 < k then ", " else "") + ns_qparams(k, i + 1)
fn ns_qdef(w) = let p = ns_qsplit(w, 5) in if p < 0 then "" else let k = toint(slice(w, 5, p)) in let t = slice(w, p + 2, count(w)) in "fn " + w + "(" + ns_qparams(k, 0) + ") = " + t + "(" + ns_qparams(k, 0) + ")\n"
fn ns_qdefs_l(ws) = match ws
    Nil        => ""
    Cons(w, r) => ns_qdef(w) + ns_qdefs_l(r)
fn ns_qdefs(text) = let ws = ns_qnames(text, count(text), 0, Nil) in if isnil(ws) == 1 then text else text + "\n\n## --- forwarders of qualified calls shadowed by a local name ---\n" + ns_qdefs_l(ws)

fn ns_lines(lines, k, mp, cx) = match lines
    Nil        => Nil
    Cons(h, t) => let n = count(h) in let tr = ltrim(h) in let nh = if startswith(tr, "use ") then h else if ns_has_any_map(h, n, mp) == 1 or ns_has_any_alias(h, n, cx.als) == 1 then ns_rw(h, n, 0, 0, Nil, Nil, {mp: cx.mp, als: cx.als, recs: cx.recs, gs: cx.gs, entry: cx.entry, mod: cx.mod, line: k, bnd: cx.bnd}) else h in Cons(nh, ns_lines(t, k + 1, mp, cx))
fn ns_rec(r, recs, gs, entry) = let mp = ns_map(gs, r, ns_reach(r.uses, recs, Nil), entry, Nil) in let qual = ns_any_qual(r.lines, r.aliases) in if isnil(mp) == 1 and qual == 0 then r else {name: r.name, uses: r.uses, lines: ns_lines(r.lines, 1, mp, {mp: mp, als: r.aliases, recs: recs, gs: gs, entry: entry, mod: r.name, line: 0, bnd: ns_binders(r.lines, Nil)}), aliases: r.aliases, defs: r.defs}
fn ns_any_qual(lines, als) = if isnil(als) == 1 then 0 else match lines
    Nil        => 0
    Cons(h, t) => if ns_has_any_alias(h, count(h), als) == 1 then 1 else ns_any_qual(t, als)
fn ns_recs(rs, recs, gs, entry) = match rs
    Nil        => Nil
    Cons(r, t) => Cons(ns_rec(r, recs, gs, entry), ns_recs(t, recs, gs, entry))
fn ns_apply(recs, entry) = ns_recs(recs, recs, ns_groups(ns_sort(ns_keys(recs, Nil)), Nil), entry)
fn ns_texts(recs, entry) = match recs
    Nil        => Nil
    Cons(r, t) => Cons(if r.name == entry then "## --- entry " + r.name + " ---\n" + joinsep(entrylines(r.lines), "\n") else "## --- module " + r.name + " ---\n" + joinsep(liblines(r.lines), "\n"), ns_texts(t, entry))
## "@namespaces" mode (the incremental build asks): "needed" when the namespace pass changes some module, else "none"
fn ns_changed(a, b) = match a
    Nil        => 0
    Cons(r, t) => match b
        Nil        => 0
        Cons(q, u) => if joinsep(r.lines, "\n") != joinsep(q.lines, "\n") then 1 else ns_changed(t, u)

## --- topological DFS resolver with cycle detection & diamond deduplication ---
fn resolve_list(uses, mods, grant, visiting, visited, chunks) = match uses
    Nil        => {visited: visited, chunks: chunks}
    Cons(u, t) => let r1 = resolve_one(u, mods, grant, visiting, visited, chunks) in resolve_list(t, mods, grant, visiting, r1.visited, r1.chunks)

fn resolve_one(nm, mods, grant, visiting, visited, chunks) = if contains(visited, nm) == 1 then {visited: visited, chunks: chunks} else if contains(visiting, nm) == 1 then ctfail("lume: module error: circular module dependency involving '" + nm + "'\n") else let lk = findmod(mods, nm) in if lk.found == 0 then ctfail("lume: module error: module '" + nm + "' not found\n") else resolve_mod(lk.m, mods, grant, Cons(nm, visiting), visited, chunks)

fn resolve_mod(m, mods, grant, visiting, visited, chunks) = let chk = checkcap(m.name, m.lines, grant) in let r = resolve_list(m.uses, mods, grant, visiting, visited, chunks) in {visited: Cons(m.name, r.visited), chunks: app(r.chunks, Cons(nsrec(m), Nil))}

## --- module-private functions (`priv fn name`, LumeDesk 2026-11-18) ----------------------------------------------------
## In a module, `priv fn name` is renamed name__priv_<module> in every line of that module, and `priv` is dropped: other
## modules cannot call it and it never collides with their names. Strings, `##` comments, `.name` field reads and
## `name:` record keys are left alone. In the entry file `priv` is only dropped (there is nothing to hide it from).
fn pv_name(line) = if startswith(line, "fn ") or startswith(line, "pub ") or startswith(line, "    Cons(") then "" else let s = trim(line) in if startswith(s, "priv fn ") then pv_name2(s, count(s)) else ""
fn pv_name2(s, n) = let a = skipws(s, 8, n) in slicen(s, n, a, id_end(s, a, n))
fn pv_names(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let nm = pv_name(h) in if nm == "" then pv_names(t) else Cons(nm, pv_names(t))
fn pv_strip(line) = if startswith(line, "priv fn ") then slice(line, 5, count(line)) else line
## rewrite one line: whole identifiers in names get the suffix, outside strings and comments
fn pv_line(s, names, suf) = pv_go(s, count(s), 0, names, suf, "")
fn pv_go(s, n, i, names, suf, acc) = if i >= n then acc else let c = at(s, i) in if c == "\"" then pv_str(s, n, i + 1, names, suf, acc + c) else if c == "#" and i + 1 < n and at(s, i + 1) == "#" then acc + slice(s, i, n) else if isalpha(c) and (i == 0 or isidch(at(s, i - 1)) == 0) then pv_id(s, n, i, id_end(s, i, n), names, suf, acc) else pv_go(s, n, i + 1, names, suf, acc + c)
fn pv_str(s, n, i, names, suf, acc) = if i >= n then acc else let c = at(s, i) in if c == "\\" and i + 1 < n then pv_str(s, n, i + 2, names, suf, acc + slice(s, i, i + 2)) else if c == "\"" then pv_go(s, n, i + 1, names, suf, acc + c) else pv_str(s, n, i + 1, names, suf, acc + c)
fn pv_id(s, n, i, e, names, suf, acc) = let w = slice(s, i, e) in let field = i > 0 and at(s, i - 1) == "." in let key = e < n and at(s, e) == ":" and (e + 1 >= n or at(s, e + 1) != ":") in if contains(names, w) == 1 and field == false and key == false then pv_go(s, n, e, names, suf, acc + w + suf) else pv_go(s, n, e, names, suf, acc + w)
fn pv_lines(lines, names, suf) = match lines
    Nil        => Nil
    Cons(h, t) => Cons(pv_line(pv_strip(h), names, suf), pv_lines(t, names, suf))
fn pv_drop(lines) = match lines
    Nil        => Nil
    Cons(h, t) => Cons(pv_strip(h), pv_drop(t))
fn pv_mod(m) = let names = pv_names(m.lines) in if isnil(names) == 1 then m else {name: m.name, uses: m.uses, lines: pv_lines(m.lines, names, "__priv_" + ns_tagc(m.name, 0, count(m.name)))}
fn pv_mods(ms) = match ms
    Nil        => Nil
    Cons(h, t) => Cons(pv_mod(h), pv_mods(t))

## --- the same name defined in two modules of one bundle: a warning (W0003), one per name -------------------------------
## a name the entry file declares `priv fn` is its own: no warning for it (the other modules' private names are
## already renamed per module before the names are compared)
fn dup_drop(groups, privs) = match groups
    Nil        => Nil
    Cons(g, t) => if contains(privs, g.n) == 1 then dup_drop(t, privs) else Cons(g, dup_drop(t, privs))
fn dup_warn(groups) = match groups
    Nil        => 0
    Cons(g, t) => let w = fs_append_sync("/dev/stderr", "lume: warning [W0003]: '" + g.n + "' is defined in modules " + joinsep(g.owners, ", ") + "; each module uses its own, and a use where two of them are visible is an ambiguity error (fix-it: rename one, make it `priv fn`, or write module.name)\n") in dup_warn(t)

## --- deprecation (W0005): a comment `## Deprecated: <message>` directly above a function marks it; every module that
## calls it from outside its own module gets one warning per name, with the message (the Go convention, so no tool has
## to parse a new form, and the code keeps compiling for the whole deprecation period)
fn dp_note(line) = let s = trim(line) in if startswith(s, "## Deprecated:") then trim(slice(s, 14, count(s))) else if startswith(s, "## deprecated:") then trim(slice(s, 14, count(s))) else "@none"
fn dp_fn(line) = let s = trim(line) in let s1 = (if startswith(s, "pub ") then trim(slice(s, 4, count(s))) else if startswith(s, "priv ") then trim(slice(s, 5, count(s))) else s) in if startswith(s1, "fn ") then dp_fn2(s1, count(s1)) else ""
fn dp_fn2(s, n) = let a = skipws(s, 3, n) in slice(s, a, id_end(s, a, n))
fn dp_scan(lines, mname, pend, acc) = match lines
    Nil        => acc
    Cons(h, t) => dp_scan1(h, t, mname, pend, acc)
## most lines start with a letter at column 0 (fn ..., type ...): with nothing pending they need no trim
fn dp_cheap(h) = if count(h) == 0 then 1 else let c = at(h, 0) in if c == "#" or c == " " or c == "\t" then 0 else 1
fn dp_scan1(h, t, mname, pend, acc) = if pend == "" and dp_cheap(h) == 1 and startswith(h, "pub ") == false and startswith(h, "priv ") == false then dp_scan(t, mname, "", acc) else if dp_note(h) != "@none" then dp_scan(t, mname, dp_note(h), acc) else if pend != "" and dp_fn(h) != "" then dp_scan(t, mname, "", Cons({n: dp_fn(h), msg: pend, m: mname}, acc)) else if trim(h) == "" or startswith(trim(h), "##") then dp_scan(t, mname, pend, acc) else dp_scan(t, mname, "", acc)
fn dp_all(ms, acc) = match ms
    Nil        => acc
    Cons(m, t) => dp_all(t, dp_scan(m.lines, m.name, "", acc))
## a call `name(` outside a comment, the name not part of a longer identifier
fn dp_idc(c) = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_"
fn dp_at(s, w, i) = let k = count(w) in if i + k + 1 > count(s) then 0 else if slice(s, i, i + k) == w and at(s, i + k) == "(" and (i == 0 or dp_idc(at(s, i - 1)) == false) then 1 else 0
fn dp_in(s, w, i) = if i + count(w) >= count(s) then 0 else if i + 1 < count(s) and at(s, i) == "#" and at(s, i + 1) == "#" then 0 else if dp_at(s, w, i) == 1 then 1 else dp_in(s, w, i + 1)
fn dp_uses(lines, w) = match lines
    Nil        => 0
    Cons(h, t) => if dp_in(h, w, 0) == 1 and dp_fn(h) != w then 1 else dp_uses(t, w)
fn dp_warn1(ds, m) = match ds
    Nil        => 0
    Cons(d, t) => let w = (if d.m != m.name and dp_uses(m.lines, d.n) == 1 then fs_append_sync("/dev/stderr", "lume: warning [W0005]: '" + d.n + "' (module " + d.m + ") is deprecated: " + d.msg + " (used in " + m.name + ")\n") else 0) in dp_warn1(t, m)
fn dp_warn(ds, ms) = match ms
    Nil        => 0
    Cons(m, t) => let w = dp_warn1(ds, m) in dp_warn(ds, t)

fn bundle(lines) = let st0 = parseblocks(lines, "io", Nil, {name: "main", uses: Nil, lines: Nil}) in let st = {mods: pv_mods(st0.mods), entry: {name: st0.entry.name, uses: st0.entry.uses, lines: pv_drop(st0.entry.lines)}, grant: st0.grant} in let r = resolve_list(st.entry.uses, st.mods, st.grant, Cons(st.entry.name, Nil), Nil, Nil) in let chk_e = checkcap(st.entry.name, st.entry.lines, st.grant) in let recs = app(r.chunks, Cons(nsrec(st.entry), Nil)) in let dw = dup_warn(dup_drop(ns_groups(ns_sort(ns_keys(recs, Nil)), Nil), pv_names(st0.entry.lines))) in let dpw = dp_warn(dp_all(Cons(st.entry, st0.mods), Nil), Cons(st.entry, st0.mods)) in ns_qdefs(joinsep(ns_texts(ns_apply(recs, st.entry.name), st.entry.name), "\n\n"))
fn ns_needed(lines) = let st = parseblocks(lines, "io", Nil, {name: "main", uses: Nil, lines: Nil}) in let r = resolve_list(st.entry.uses, st.mods, "io", Cons(st.entry.name, Nil), Nil, Nil) in let recs = app(r.chunks, Cons(nsrec(st.entry), Nil)) in if ns_changed(recs, ns_apply(recs, st.entry.name)) == 1 then "needed" else "none"

## --- `@manifest` mode: parse & validate `lume.toml` in Lume-Core ---
fn unquote(s) = let t = trim(s) in let n = count(t) in if n < 2 then t else if at(t, 0) == "\"" and at(t, n - 1) == "\"" then slicen(t, n, 1, n - 1) else t
fn parse_kv(tr) = let eq = findeq(tr, 0, count(tr)) in if eq >= count(tr) then {k: "", v: ""} else {k: trim(slice(tr, 0, eq)), v: trim(slice(tr, eq + 1, count(tr)))}
fn findeq(s, i, n) = if i >= n then n else if at(s, i) == "=" then i else findeq(s, i + 1, n)

fn parse_cap_val(v) = let hp = contains_sub(v, "\"pure\"", 0, count(v)) in let hf = contains_sub(v, "\"ffi\"", 0, count(v)) in let hi = contains_sub(v, "\"io\"", 0, count(v)) in if hp == 1 and (hf == 1 or hi == 1) then ctfail("lume: manifest error: 'pure' capability cannot be combined with 'io' or 'ffi' in lume.toml\n") else if hp == 1 then "pure" else if hf == 1 then "ffi" else if hi == 1 then "io" else ctfail("lume: manifest error: unsupported or empty capability grant in lume.toml (expected \"pure\", \"io\", or \"ffi\")\n")
fn contains_sub(s, sub, i, n) = let m = count(sub) in if i + m > n then 0 else if slicen(s, n, i, i + m) == sub then 1 else contains_sub(s, sub, i + 1, n)

fn scanmanifest(lines, st) = match lines
    Nil        => st
    Cons(h, t) => let tr = trim(h) in if tr == "" or startswith(tr, "#") or startswith(tr, "[") then scanmanifest(t, st) else let kv = parse_kv(tr) in if kv.k == "name" then scanmanifest(t, {name: unquote(kv.v), version: st.version, edition: st.edition, cap: st.cap, protect: st.protect, ffi_libs: st.ffi_libs}) else if kv.k == "version" then scanmanifest(t, {name: st.name, version: unquote(kv.v), edition: st.edition, cap: st.cap, protect: st.protect, ffi_libs: st.ffi_libs}) else if kv.k == "edition" then scanmanifest(t, {name: st.name, version: st.version, edition: unquote(kv.v), cap: st.cap, protect: st.protect, ffi_libs: st.ffi_libs}) else if kv.k == "allow" or kv.k == "capabilities" then scanmanifest(t, {name: st.name, version: st.version, edition: st.edition, cap: parse_cap_val(kv.v), protect: st.protect, ffi_libs: st.ffi_libs}) else if kv.k == "protect" or kv.k == "level" then scanmanifest(t, {name: st.name, version: st.version, edition: st.edition, cap: st.cap, protect: unquote(kv.v), ffi_libs: st.ffi_libs}) else if kv.k == "libs" or kv.k == "link" then scanmanifest(t, {name: st.name, version: st.version, edition: st.edition, cap: st.cap, protect: st.protect, ffi_libs: kv.v}) else scanmanifest(t, st)

fn checkmanifest(m) = if m.name == "" then ctfail("lume: manifest error: missing 'name' in lume.toml\n") else if m.version == "" then ctfail("lume: manifest error: missing 'version' in lume.toml\n") else if m.edition != "" and m.edition != "2026" then ctfail("lume: manifest error: unsupported edition '" + m.edition + "' in lume.toml (expected \"2026\")\n") else if m.protect != "" and m.protect != "none" and m.protect != "standard" and m.protect != "hardened" and m.protect != "max" then ctfail("lume: manifest error: unsupported protect level '" + m.protect + "' in lume.toml (expected \"none\", \"standard\", \"hardened\", or \"max\")\n") else if m.ffi_libs != "" and m.ffi_libs != "[]" and m.cap != "ffi" then ctfail("lume: capability error [E0200]: [ffi] libs in lume.toml requires \"ffi\" in [capabilities] allow\n") else "{\"name\":\"" + m.name + "\",\"version\":\"" + m.version + "\",\"edition\":\"" + (if m.edition == "" then "2026" else m.edition) + "\",\"capabilities\":\"" + m.cap + "\"" + (if m.protect != "" then ",\"protect\":\"" + m.protect + "\"" else "") + (if m.ffi_libs != "" then ",\"ffi_libs\":" + m.ffi_libs else "") + "}"

## --- package init, deterministic lockfile, and source tree modes ---
fn pkg_init_toml(pkg) = "[package]\nname = \"" + pkg + "\"\nversion = \"0.1.0\"\nedition = \"2026\"\n\n[capabilities]\nallow = [\"io\"]\n\n[dependencies]"
fn pkg_init_main(pkg) = "## " + pkg + " — entry module\nfn main_val() -> int = 42\nprint main_val()"

fn pkg_fmt_lock_mods(mods) = match mods
    Nil        => ""
    Cons(h, t) => "\nmodule \"" + h.rel + "\" sha256 = \"" + h.sha + "\"" + pkg_fmt_lock_mods(t)
fn pkg_lock(st) = "# lume.lock — deterministic content-addressed lockfile (P26, P32)\nversion = 1\nmanifest = " + st.manifest + "\nmanifest_sha256 = \"" + st.manifest_sha + "\"" + pkg_fmt_lock_mods(st.mods)

fn pkg_scan_uses(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let tr = trim(h) in if startswith(tr, "use ") then Cons(usehead(slice(tr, 4, count(tr))), pkg_scan_uses(t)) else pkg_scan_uses(t)
fn pkg_fmt_tree_mods(mods) = match mods
    Nil        => ""
    Cons(h, t) => let uses = pkg_scan_uses(splitlines(h.src)) in let line = if isnil(uses) == 1 then "  |-- " + h.rel else "  |-- " + h.rel + " -> " + joinsep(uses, " ") + " " in "\n" + line + pkg_fmt_tree_mods(t)
fn pkg_tree(st) = st.manifest + pkg_fmt_tree_mods(st.mods)

fn pkg_find_sp(s, i) = if i >= count(s) or at(s, i) == " " or at(s, i) == "\t" then i else pkg_find_sp(s, i + 1)
fn pkg_parse_mod_line(text) = let sp = pkg_find_sp(text, 0) in if sp >= count(text) then ctfail("lume: package request error: malformed @module line\n") else {sha: trim(slice(text, 0, sp)), rel: trim(slice(text, sp + 1, count(text))), src: ""}
fn pkg_source_block(lines) = let b = takeuntilend(lines) in {src: if isnil(b.body) == 1 then "" else joinsep(b.body, "\n") + "\n", rest: b.rest}

fn pkg_parse(lines, st) = match lines
    Nil        => {cmd: st.cmd, pkg: st.pkg, part: st.part, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: rev(st.mods)}
    Cons(h, t) => if h == "@pkg-init" or h == "@pkg-lock" or h == "@pkg-tree" then pkg_parse(t, {cmd: h, pkg: st.pkg, part: st.part, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods}) else if startswith(h, "@pkg ") then pkg_parse(t, {cmd: st.cmd, pkg: trim(slice(h, 5, count(h))), part: st.part, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods}) else if startswith(h, "@part ") then pkg_parse(t, {cmd: st.cmd, pkg: st.pkg, part: trim(slice(h, 6, count(h))), manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods}) else if startswith(h, "@manifest ") then pkg_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, manifest: trim(slice(h, 10, count(h))), manifest_sha: st.manifest_sha, mods: st.mods}) else if startswith(h, "@manifest_sha256 ") then pkg_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, manifest: st.manifest, manifest_sha: trim(slice(h, 17, count(h))), mods: st.mods}) else if startswith(h, "@module ") then pkg_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: Cons(pkg_parse_mod_line(trim(slice(h, 8, count(h)))), st.mods)}) else if startswith(h, "@modsrc ") then let rel = trim(slice(h, 8, count(h))) in let b = pkg_source_block(t) in pkg_parse(b.rest, {cmd: st.cmd, pkg: st.pkg, part: st.part, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: Cons({rel: rel, sha: "", src: b.src}, st.mods)}) else pkg_parse(t, st)

fn run_package(lines) = let st = pkg_parse(lines, {cmd: "", pkg: "app", part: "toml", manifest: "{}", manifest_sha: "", mods: Nil}) in if st.cmd == "@pkg-init" then (if st.part == "main" then pkg_init_main(st.pkg) else pkg_init_toml(st.pkg)) else if st.cmd == "@pkg-lock" then pkg_lock(st) else if st.cmd == "@pkg-tree" then pkg_tree(st) else ctfail("lume: package request error: missing package mode\n")

fn run_lmod(lines) = match lines
    Nil        => ""
    Cons(h, t) => let mode = trim(h) in if mode == "@manifest" then checkmanifest(scanmanifest(t, {name: "", version: "", edition: "", cap: "io", protect: "", ffi_libs: ""})) else if mode == "@pkg-init" or mode == "@pkg-lock" or mode == "@pkg-tree" then run_package(lines) else if mode == "@namespaces" then ns_needed(t) else bundle(lines)

print chomp(run_lmod(splitlines(readall())))
