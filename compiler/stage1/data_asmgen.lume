## data_asmgen.lume — a code generator WRITTEN IN LUME that emits x86-64 machine code
## for the ML-core language, with NO C in the pipeline. The output is assembled by
## `as` and linked by `ld` (assembly is the next dependency to drop, via a direct ELF
## writer). This is "Lume generating machine code": the real target of the project.
##
## Scope (this brick): the functional INTEGER core -- fn, let-in, if/then/else, integer
## arithmetic (+ - * / %), comparisons, and/or/not, calls, recursion, and top-level
## print. Strings / constructors / match / records / lists lower in later bricks.
use data_ast
use runtime_core

fn idx_of(xs: [str], name: str) -> int
    var i = 0
    var found = 0 - 1
    for x in xs
        if x == name and found < 0
            found = i
        i = i + 1
    found

## collect let-bound names reachable in an expression (for frame slots)
fn collect_lets(e: DExpr, acc: mut [str])
    match e
        DLetIn(nm, v, body) => do
            acc.push(nm)
            collect_lets(v, acc)
            collect_lets(body, acc)
        DBin(op, l, r) => do
            collect_lets(l, acc)
            collect_lets(r, acc)
        DIf(c, t, e2) => do
            collect_lets(c, acc)
            collect_lets(t, acc)
            collect_lets(e2, acc)
        DCall(nm, args) => do
            if (nm == "forall_range" or nm == "exists_range") and args.len() == 4
                match args[0]
                    DVar(qv) => acc.push(qv)
                    _ => do
                        let _ = 0
            for a in args
                collect_lets(a, acc)
        DCons(tag, args) => do
            for a in args
                collect_lets(a, acc)
        DMatch(scrut, arms) => do
            collect_lets(scrut, acc)
            for arm in arms
                collect_pat_binds(arm.pat, acc)
                collect_lets(arm.body, acc)
        DAssign(nm, v) => do
            acc.push(nm)
            collect_lets(v, acc)
        DArray(sz) => collect_lets(sz, acc)
        DSetIndex(coll, ix, v) => do
            collect_lets(coll, acc)
            collect_lets(ix, acc)
            collect_lets(v, acc)
        DBlock(exprs) => do
            for x in exprs
                collect_lets(x, acc)
        DWhile(cond, body) => do
            collect_lets(cond, acc)
            collect_lets(body, acc)
        DReturn(v) => collect_lets(v, acc)
        DExit(v) => collect_lets(v, acc)
        DRec(fields) => do
            for f in fields
                collect_lets(f.value, acc)
        DField(obj, name) => collect_lets(obj, acc)
        DList(items) => do
            for x in items
                collect_lets(x, acc)
        DIndex(arr, idx) => do
            collect_lets(arr, acc)
            collect_lets(idx, acc)
        _ => do
            let _ = 0

## the runtime helper of an arithmetic operator: operands in %rdi and %rsi as value words
fn arith_helper(op: str) -> str
    if op == "-"
        "__rt_sub"
    elif op == "*"
        "__rt_mul"
    elif op == "/"
        "__rt_div"
    elif op == "%"
        "__rt_mod"
    elif op == "+%"
        "__rt_wadd"
    elif op == "-%"
        "__rt_wsub"
    else
        "__rt_wmul"

## `out` is a linear output accumulator: aexpr pushes asm chunks into it in
## evaluation order and the caller drains/joins once. Threading it (instead of
## returning concatenated strings) keeps codegen O(n) allocation -- repeated
## `a + b + "..."` per node is O(output^2), and the seed interpreter frees
## nothing, so a big function body would otherwise exhaust memory.
type AC = record
    locals: [str]
    nlabel: int
    data:   [str]
    nstr:   int
    depth:  int
    globals: [str]
    bound:  [str]
    out:    [str]
    retlbl: str
    seen:   [str]

## escape a string for a .asciz directive (quote + backslash)
fn sesc(s: str) -> str
    var out = []
    for ch in s.chars()
        if ch == '"'
            out.push("\\\"")
        elif ch == '\\'
            out.push("\\\\")
        elif ch == '\n'
            out.push("\\n")
        elif ch == '\t'
            out.push("\\t")
        elif ch == '\r'
            out.push("\\r")
        else
            out.push(str(ch))
    out.join("")

## maximum match-nesting depth in an expression (for scrutinee frame slots)
fn imax(a: int, b: int) -> int = if a > b then a else b

fn match_depth(e: DExpr) -> int
    match e
        DMatch(scrut, arms) => do
            var m = match_depth(scrut)
            for arm in arms
                m = imax(m, match_depth(arm.body))
            m + 1
        DIf(cc, t, e2) => imax(match_depth(cc), imax(match_depth(t), match_depth(e2)))
        DBin(op, l, r) => imax(match_depth(l), match_depth(r))
        DLetIn(nm, v, b) => imax(match_depth(v), match_depth(b))
        DCall(nm, args) => do
            var m = 0
            for a in args
                m = imax(m, match_depth(a))
            m
        DCons(tag, args) => do
            var m = 0
            for a in args
                m = imax(m, match_depth(a))
            m
        DAssign(nm, v) => match_depth(v)
        DArray(sz) => match_depth(sz)
        DSetIndex(coll, ix, v) => imax(match_depth(coll), imax(match_depth(ix), match_depth(v)))
        DBlock(exprs) => do
            var m = 0
            for x in exprs
                m = imax(m, match_depth(x))
            m
        DWhile(cond, body) => imax(match_depth(cond), match_depth(body))
        DReturn(v) => match_depth(v)
        DExit(v) => match_depth(v)
        DRec(fields) => do
            var m = 0
            for f in fields
                m = imax(m, match_depth(f.value))
            m
        DField(obj, name) => match_depth(obj)
        DList(items) => do
            var m = 0
            for x in items
                m = imax(m, match_depth(x))
            m
        DIndex(arr, idx) => imax(match_depth(arr), match_depth(idx))
        _ => 0

## collect the PBind names in a pattern (they become frame slots)
fn collect_pat_binds(p: Pat, acc: mut [str])
    match p
        PBind(nm) => acc.push(nm)
        PCons(tag, subs) => do
            for s in subs
                collect_pat_binds(s, acc)
        _ => do
            let _ = 0

## emit a .rodata string literal, returning its label
fn strlabel(s: str, c: mut AC) -> str
    let lab = ".Ls" + str(c.nstr)
    c.nstr = c.nstr + 1
    ## accumulate rodata as a list of chunks, joined once at the end: repeated
    ## `c.data = c.data + piece` is O(n^2) and the seed interpreter frees nothing,
    ## so a growing string literal exhausts memory (StringBuilder / join, not `+`).
    c.data.push(lab + ":\n    .asciz \"" + sesc(s) + "\"\n")
    lab

## static descriptors (runtime_core.lume, "value words"): a label is a pure function of the name, one definition each
fn rodata_once(lab: str, txt: str, c: mut AC)
    if not c.seen.contains(lab)
        c.seen.push(lab)
        c.data.push(txt)

fn ctorlabel(tag: str, n: int, c: mut AC) -> str
    let lab = "__c_" + tag + "_" + str(n)
    rodata_once(lab, "    .balign 8\n" + lab + ":\n    .quad " + lab + "\n    .quad " + str(n * 256 + 2) + "\n    .asciz \"" + tag + "\"\n", c)
    lab

fn keylabel(k: str, c: mut AC) -> str
    let lab = "__k_" + k
    rodata_once(lab, "    .balign 8\n" + lab + ":\n    .asciz \"" + k + "\"\n", c)
    lab

## `acc` is asm that loads a value pointer into %rax. Emit a test that jumps to
## `fail` when pattern `p` does not match that value; otherwise falls through.
fn atest(p: Pat, acc: str, flbl: str, c: mut AC) -> str
    match p
        PWild    => ""
        PBind(nm) => ""
        PInt(n)  => acc + "    movq $" + str(n + n + 1) + ", %rcx\n    cmpq %rcx, %rax\n    jne " + flbl + "\n"
        PCons(tag, subs) => do
            let nlab = ctorlabel(tag, subs.len(), c)
            if subs.len() == 0
                return acc + "    leaq " + nlab + "(%rip), %rcx\n    cmpq %rcx, %rax\n    jne " + flbl + "\n"
            var out = acc + "    testb $7, %al\n    jnz " + flbl + "\n    leaq " + nlab + "(%rip), %rcx\n    cmpq %rcx, (%rax)\n    jne " + flbl + "\n"
            var k = 0
            for s in subs
                let acck = acc + "    movq " + str((k + 1) * 8) + "(%rax), %rax\n"
                out = out + atest(s, acck, flbl, c)
                k = k + 1
            out

## emit the variable bindings a pattern introduces (store value ptrs to slots)
fn abind(p: Pat, acc: str, c: mut AC) -> str
    match p
        PBind(nm) => do
            let k = idx_of(c.locals, nm)
            acc + "    movq %rax, " + str(0 - 8 * (k + 1)) + "(%rbp)\n"
        PCons(tag, subs) => do
            var out = ""
            var k = 0
            for s in subs
                let acck = acc + "    movq " + str((k + 1) * 8) + "(%rax), %rax\n"
                out = out + abind(s, acck, c)
                k = k + 1
            out
        _ => ""

## forall_range(v, lo, hi, pred) / exists_range(...): inclusive bounds, short-circuit (mirrors native lquant)
fn aquant(nm: str, args: [DExpr], c: mut AC)
    var vnm = ""
    match args[0]
        DVar(v) => do
            vnm = v
        _ => do
            vnm = ""
    let kslot = str(0 - 8 * (idx_of(c.locals, vnm) + 1)) + "(%rbp)"
    let lab = str(c.nlabel)
    c.nlabel = c.nlabel + 1
    let shadow = idx_of(c.bound, vnm) >= 0
    let isall = nm == "forall_range"
    aexpr(args[1], c)
    if shadow
        c.out.push("    popq %rcx\n    movq " + kslot + ", %rax\n    pushq %rax\n    movq %rcx, " + kslot + "\n")
    else
        c.out.push("    popq %rax\n    movq %rax, " + kslot + "\n")
    c.bound.push(vnm)
    c.out.push(".Lqloop_" + lab + ":\n")
    aexpr(args[2], c)
    c.out.push("    popq %rsi\n    movq " + kslot + ", %rdi\n    call cmpv\n    cmpq $0, %rax\n    jg .Lqdone_" + lab + "\n")
    aexpr(args[3], c)
    c.out.push("    popq %rax\n    cmpq $1, %rax\n    " + (if isall then "je" else "jne") + " .Lqearly_" + lab + "\n    movq " + kslot + ", %rdi\n    call __rt_qnext\n    testq %rax, %rax\n    jz .Lqdone_" + lab + "\n    movq %rax, " + kslot + "\n    jmp .Lqloop_" + lab + "\n")
    c.out.push(".Lqdone_" + lab + ":\n    movq $" + (if isall then "1" else "0") + ", %rdi\n    call mkint\n    pushq %rax\n    jmp .Lqend_" + lab + "\n")
    c.out.push(".Lqearly_" + lab + ":\n    movq $" + (if isall then "0" else "1") + ", %rdi\n    call mkint\n    pushq %rax\n.Lqend_" + lab + ":\n")
    c.bound.pop()
    if shadow
        c.out.push("    popq %rax\n    popq %rcx\n    movq %rcx, " + kslot + "\n    pushq %rax\n")

## System V: the first 6 integer args travel in registers, the 7th and later on the stack
fn areg(i: int) -> str
    let regs = ["%rdi", "%rsi", "%rdx", "%rcx", "%r8", "%r9"]
    regs[i]

## asm symbol of a top-level `let` global (an 8-byte .bss cell holding a value pointer)
fn gsym(nm: str) -> str = "__g_" + nm

fn decimal_expr(e: DExpr) -> bool
    match e
        DDecimal(coefficient, scale) => true
        DCall(name, args) => name == "decimal" or name == "decimal_make" or name == "decimal_parse" or name == "decimal_cast" or name == "decimal_div_exact" or name == "decimal_add" or name == "decimal_sub" or name == "decimal_mul" or name == "decimal_div"
        DIf(cond, then_value, else_value) => decimal_expr(then_value) and decimal_expr(else_value)
        DLetIn(name, value, body) => decimal_expr(body)
        _ => false

## emit asm that computes `e` and leaves its value pushed on the stack. The asm
## is PUSHED, chunk by chunk, into `c.out` in evaluation order (the caller joins
## once). Pushing instead of returning `a + b + "..."` per node is what keeps the
## generator O(n) allocation instead of O(output^2); byte-identity depends on the
## push order matching the old concatenation order exactly, and on the recursive
## calls / strlabel side effects keeping the exact same evaluation order.
fn aexpr(e: DExpr, c: mut AC)
    match e
        DInt(n) => c.out.push("    movq $" + str(n) + ", %rdi\n    call mkint\n    pushq %rax\n")
        DDecimal(coefficient, scale) => aexpr(DRec(fields: [RecField(name: "coefficient", value: DInt(n: coefficient)), RecField(name: "scale", value: DInt(n: scale)), RecField(name: "precision", value: DInt(n: 0))]), c)
        DStr(v) => do
            let lab = strlabel(v, c)
            c.out.push("    leaq " + lab + "(%rip), %rdi\n    call mkstr\n    pushq %rax\n")
        DVar(nm) => do
            let k = idx_of(c.locals, nm)
            ## a global is shadowed only while a param / let-in / pattern binding of that name is in scope
            if idx_of(c.globals, nm) >= 0 and idx_of(c.bound, nm) < 0
                c.out.push("    movq " + gsym(nm) + "(%rip), %rax\n    pushq %rax\n")
            else
                c.out.push("    movq " + str(0 - 8 * (k + 1)) + "(%rbp), %rax\n    pushq %rax\n")
        DBin(op, l, r) => do
            if op == "and"
                let lab = c.nlabel
                c.nlabel = c.nlabel + 1
                aexpr(l, c)
                c.out.push("    popq %rax\n    cmpq $1, %rax\n    je .Lsc_f" + str(lab) + "\n")
                aexpr(r, c)
                c.out.push("    popq %rax\n    cmpq $1, %rax\n    setne %al\n    movzbq %al, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n    jmp .Lsc_x" + str(lab) + "\n.Lsc_f" + str(lab) + ":\n    movq $0, %rdi\n    call mkint\n    pushq %rax\n.Lsc_x" + str(lab) + ":\n")
            elif op == "or"
                let lab = c.nlabel
                c.nlabel = c.nlabel + 1
                aexpr(l, c)
                c.out.push("    popq %rax\n    cmpq $1, %rax\n    jne .Lsc_t" + str(lab) + "\n")
                aexpr(r, c)
                c.out.push("    popq %rax\n    cmpq $1, %rax\n    setne %al\n    movzbq %al, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n    jmp .Lsc_x" + str(lab) + "\n.Lsc_t" + str(lab) + ":\n    movq $1, %rdi\n    call mkint\n    pushq %rax\n.Lsc_x" + str(lab) + ":\n")
            else
                aexpr(l, c)
                aexpr(r, c)
                if decimal_expr(l) and decimal_expr(r) and (op == "+" or op == "-" or op == "*" or op == "/" or op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=")
                    if op == "+" or op == "-" or op == "*" or op == "/"
                        let callee = if op == "+" then "decimal_add" else if op == "-" then "decimal_sub" else if op == "*" then "decimal_mul" else "decimal_div"
                        c.out.push("    popq %rsi\n    popq %rdi\n    call " + callee + "\n    pushq %rax\n")
                    else
                        var setc = "    setl %al\n"
                        if op == "=="
                            setc = "    sete %al\n"
                        elif op == "!="
                            setc = "    setne %al\n"
                        elif op == ">"
                            setc = "    setg %al\n"
                        elif op == "<="
                            setc = "    setle %al\n"
                        elif op == ">="
                            setc = "    setge %al\n"
                        c.out.push("    popq %rsi\n    popq %rdi\n    call decimal_compare\n    cmpq $1, %rax\n" + setc + "    movzbq %al, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n")
                elif op == "=="
                    c.out.push("    popq %rsi\n    popq %rdi\n    call eqv\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n")
                elif op == "!="
                    c.out.push("    popq %rsi\n    popq %rdi\n    call eqv\n    xorq $1, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n")
                elif op == "+"
                    c.out.push("    popq %rsi\n    popq %rdi\n    call addv\n    pushq %rax\n")
                elif op == "<" or op == ">" or op == "<=" or op == ">="
                    var setc = "    setl %al\n"
                    if op == ">"
                        setc = "    setg %al\n"
                    elif op == "<="
                        setc = "    setle %al\n"
                    elif op == ">="
                        setc = "    setge %al\n"
                    c.out.push("    popq %rsi\n    popq %rdi\n    call cmpv\n    cmpq $0, %rax\n" + setc + "    movzbq %al, %rax\n    movq %rax, %rdi\n    call mkint\n    pushq %rax\n")
                else
                    c.out.push("    popq %rsi\n    popq %rdi\n    call " + arith_helper(op) + "\n    pushq %rax\n")
        DIf(cond, t, e2) => do
            let lab = c.nlabel
            c.nlabel = c.nlabel + 1
            aexpr(cond, c)
            c.out.push("    popq %rax\n    cmpq $1, %rax\n    je .Le" + str(lab) + "\n")
            aexpr(t, c)
            c.out.push("    jmp .Lx" + str(lab) + "\n.Le" + str(lab) + ":\n")
            aexpr(e2, c)
            c.out.push(".Lx" + str(lab) + ":\n")
        DLetIn(nm, v, body) => do
            aexpr(v, c)
            let k = idx_of(c.locals, nm)
            let lslot = str(0 - 8 * (k + 1)) + "(%rbp)"
            let lshadow = idx_of(c.bound, nm) >= 0
            ## no alpha-renaming here: a shadowing binder shares its slot, so keep the outer value on the stack
            if lshadow
                c.out.push("    popq %rcx\n    movq " + lslot + ", %rax\n    pushq %rax\n    movq %rcx, " + lslot + "\n")
            else
                c.out.push("    popq %rax\n    movq %rax, " + lslot + "\n")
            c.bound.push(nm)
            aexpr(body, c)
            c.bound.pop()
            if lshadow
                c.out.push("    popq %rax\n    popq %rcx\n    movq %rcx, " + lslot + "\n    pushq %rax\n")
        DCall(nm, args) => do
            if (nm == "forall_range" or nm == "exists_range") and args.len() == 4
                aquant(nm, args, c)
                return
            let n = args.len()
            ## stack args first, last to 7th, so the 7th ends at the lowest address
            var j = n - 1
            while j >= 6
                aexpr(args[j], c)
                j = j - 1
            ## register args: pushed in order, popped into rdi, rsi, ... below
            var m = n
            if m > 6
                m = 6
            var q = 0
            while q < m
                aexpr(args[q], c)
                q = q + 1
            var i = m - 1
            while i >= 0
                c.out.push("    popq " + areg(i) + "\n")
                i = i - 1
            c.out.push("    call " + nm + "\n")
            if n > 6
                c.out.push("    addq $" + str((n - 6) * 8) + ", %rsp\n")
            c.out.push("    pushq %rax\n")
        DCons(tag, args) => do
            let n = args.len()
            let nlab = ctorlabel(tag, n, c)
            if n == 0
                c.out.push("    leaq " + nlab + "(%rip), %rax\n    pushq %rax\n")
            else
                for a in args
                    aexpr(a, c)
                c.out.push("    movq $" + str((n + 1) * 8) + ", %rdi\n    call alloc\n    movq %rax, %rcx\n")
                var k = n - 1
                while k >= 0
                    c.out.push("    popq %rax\n    movq %rax, " + str((k + 1) * 8) + "(%rcx)\n")
                    k = k - 1
                c.out.push("    leaq " + nlab + "(%rip), %rax\n    movq %rax, (%rcx)\n    pushq %rcx\n")
        DMatch(scrut, arms) => do
            let lab = c.nlabel
            c.nlabel = c.nlabel + 1
            let dep = c.depth
            c.depth = c.depth + 1
            let slotk = idx_of(c.locals, "_sd" + str(dep))
            let soff = str(0 - 8 * (slotk + 1))
            let acc = "    movq " + soff + "(%rbp), %rax\n"
            let endl = ".Lm" + str(lab) + ".Lrt__end"
            aexpr(scrut, c)
            c.out.push("    popq %rax\n    movq %rax, " + soff + "(%rbp)\n")
            var i = 0
            for arm in arms
                let faill = ".Lm" + str(lab) + "_" + str(i + 1)
                var abinds = []
                collect_pat_binds(arm.pat, abinds)
                var ashadow = []
                for ab in abinds
                    if idx_of(c.bound, ab) >= 0
                        ashadow.push(str(0 - 8 * (idx_of(c.locals, ab) + 1)) + "(%rbp)")
                for ab in abinds
                    c.bound.push(ab)
                ## The body is emitted AFTER the pattern test/bind, but it must be
                ## generated BEFORE `atest` runs, because `atest` allocates rodata
                ## labels (strlabel) and the label numbering must stay identical to
                ## the old order (body first, then test). So capture the body into a
                ## private buffer, then splice it in at its output position.
                let saved = c.out
                c.out = []
                aexpr(arm.body, c)
                let bodybuf = c.out
                c.out = saved
                for ab in abinds
                    c.bound.pop()
                c.out.push(".Lm" + str(lab) + "_" + str(i) + ":\n")
                c.out.push(atest(arm.pat, acc, faill, c))
                for sl in ashadow
                    c.out.push("    movq " + sl + ", %rax\n    pushq %rax\n")
                c.out.push(abind(arm.pat, acc, c))
                for bch in bodybuf
                    c.out.push(bch)
                if ashadow.len() > 0
                    c.out.push("    popq %rax\n")
                    var si = ashadow.len() - 1
                    while si >= 0
                        c.out.push("    popq %rcx\n    movq %rcx, " + ashadow[si] + "\n")
                        si = si - 1
                    c.out.push("    pushq %rax\n")
                c.out.push("    jmp " + endl + "\n")
                i = i + 1
            c.out.push(".Lm" + str(lab) + "_" + str(i) + ":\n    movq $0, %rdi\n    call mkint\n    pushq %rax\n" + endl + ":\n")
            c.depth = dep
        DRec(fields) => do
            let n = fields.len()
            let shape = ".Lr" + str(c.nstr)
            c.nstr = c.nstr + 1
            var keys = ""
            for f in fields
                keys = keys + "    .quad " + keylabel(f.name, c) + "\n"
            c.data.push("    .balign 8\n" + shape + ":\n    .quad " + shape + "\n    .quad " + str(n * 256 + 4) + "\n" + keys)
            if n == 0
                c.out.push("    leaq " + shape + "(%rip), %rax\n    pushq %rax\n")
            else
                for f in fields
                    aexpr(f.value, c)
                c.out.push("    movq $" + str((n + 1) * 8) + ", %rdi\n    call alloc\n    movq %rax, %rcx\n")
                var k = n - 1
                while k >= 0
                    c.out.push("    popq %rax\n    movq %rax, " + str((k + 1) * 8) + "(%rcx)\n")
                    k = k - 1
                c.out.push("    leaq " + shape + "(%rip), %rax\n    movq %rax, (%rcx)\n    pushq %rcx\n")
        DField(o, nm) => do
            let nl = keylabel(nm, c)
            aexpr(o, c)
            c.out.push("    popq %rdi\n    leaq " + nl + "(%rip), %rsi\n    call recget\n    pushq %rax\n")
        DList(xs) => do
            let n = xs.len()
            if n == 0
                c.out.push("    movq $0, %rdi\n    movq $0, %rsi\n    call mklist\n    pushq %rax\n")
            else
                for x in xs
                    aexpr(x, c)
                c.out.push("    movq $" + str(n * 8) + ", %rdi\n    call alloc\n    movq %rax, %rcx\n")
                var k = n - 1
                while k >= 0
                    c.out.push("    popq %rax\n    movq %rax, " + str(k * 8) + "(%rcx)\n")
                    k = k - 1
                c.out.push("    movq $" + str(n) + ", %rdi\n    movq %rcx, %rsi\n    call mklist\n    pushq %rax\n")
        DIndex(coll, ix) => do
            aexpr(coll, c)
            aexpr(ix, c)
            c.out.push("    popq %rsi\n    popq %rdi\n    call lidx\n    pushq %rax\n")
        DAssign(nm, v) => do
            aexpr(v, c)
            c.out.push("    popq %rax\n")
            if idx_of(c.globals, nm) >= 0 and idx_of(c.bound, nm) < 0
                c.out.push("    movq %rax, " + gsym(nm) + "(%rip)\n")
            else
                let k = idx_of(c.locals, nm)
                c.out.push("    movq %rax, " + str(0 - 8 * (k + 1)) + "(%rbp)\n")
            c.out.push("    pushq %rax\n")
        DArray(sz) => do
            aexpr(sz, c)
            c.out.push("    popq %rdi\n    call mkarray\n    pushq %rax\n")
        DSetIndex(coll, ix, v) => do
            aexpr(coll, c)
            aexpr(ix, c)
            aexpr(v, c)
            c.out.push("    popq %rdx\n    popq %rsi\n    popq %rdi\n    call lset\n    pushq %rax\n")
        DBlock(exprs) => do
            for x in exprs
                aexpr(x, c)
                c.out.push("    popq %rax\n")
            c.out.push("    movq $0, %rdi\n    call mkint\n    pushq %rax\n")
        DWhile(cond, body) => do
            let lab = c.nlabel
            c.nlabel = c.nlabel + 1
            c.out.push(".Lw" + str(lab) + ":\n")
            aexpr(cond, c)
            c.out.push("    popq %rax\n    cmpq $1, %rax\n    je .Lwe" + str(lab) + "\n")
            aexpr(body, c)
            c.out.push("    popq %rax\n    jmp .Lw" + str(lab) + "\n.Lwe" + str(lab) + ":\n    movq $0, %rdi\n    call mkint\n    pushq %rax\n")
        DReturn(v) => do
            aexpr(v, c)
            c.out.push("    popq %rax\n    jmp " + c.retlbl + "\n")
        DExit(v) => do
            aexpr(v, c)
            c.out.push("    popq %rax\n    call __rt_uint\n    movq %rax, %rdi\n    movq $60, %rax\n    syscall\n")
        _ => c.out.push("    movq $0, %rax\n    pushq %rax\n    # unsupported expr\n")

fn afn(nm: str, params: [str], body: DExpr, c: mut AC) -> str
    var locals = []
    for p in params
        locals.push(p)
    collect_lets(body, locals)
    let md = match_depth(body)
    var di = 0
    while di < md
        locals.push("_sd" + str(di))
        di = di + 1
    c.locals = locals
    c.depth = 0
    var bound = []
    for p in params
        bound.push(p)
    c.bound = bound
    var frame = locals.len() * 8
    if frame % 16 != 0
        frame = frame + 8
    ## use c.out as this function's chunk buffer, joined once at the end (O(n))
    c.out = []
    c.out.push(nm + ":\n    pushq %rbp\n    movq %rsp, %rbp\n")
    if frame > 0
        c.out.push("    subq $" + str(frame) + ", %rsp\n")
    var i = 0
    for p in params
        if i < 6
            c.out.push("    movq " + areg(i) + ", " + str(0 - 8 * (i + 1)) + "(%rbp)\n")
        else
            ## caller-pushed arg: 16(%rbp) is the 7th (above saved rbp + return address)
            c.out.push("    movq " + str(16 + 8 * (i - 6)) + "(%rbp), %rax\n    movq %rax, " + str(0 - 8 * (i + 1)) + "(%rbp)\n")
        i = i + 1
    c.retlbl = ".Lreturn_" + nm
    aexpr(body, c)
    c.out.push("    popq %rax\n" + c.retlbl + ":\n    movq %rbp, %rsp\n    popq %rbp\n    ret\n")
    c.out.join("")

fn uses_fs_expr(e: DExpr) -> bool
    match e
        DCall(nm, args) => do
            if nm == "fs_write_sync" or nm == "fs_append_sync" or nm == "fs_read_file" or nm == "fs_read_dir" or nm == "fs_current_dir" or nm == "fs_path_exists" or nm == "fs_read_byte" or nm == "fs_mkdir" or nm == "fs_files_equal" or nm == "fs_write_hex_file" or nm == "fs_remove"
                true
            else
                var found = false
                for a in args
                    if uses_fs_expr(a)
                        found = true
                found
        DLetIn(nm, v, b) => uses_fs_expr(v) or uses_fs_expr(b)
        DBin(op, l, r) => uses_fs_expr(l) or uses_fs_expr(r)
        DIf(c, t, e2) => uses_fs_expr(c) or uses_fs_expr(t) or uses_fs_expr(e2)
        DField(o, nm) => uses_fs_expr(o)
        DRec(fields) => do
            var found = false
            for f in fields
                if uses_fs_expr(f.value)
                    found = true
            found
        DMatch(sc, arms) => do
            var found = uses_fs_expr(sc)
            for arm in arms
                if uses_fs_expr(arm.body)
                    found = true
            found
        DAssign(nm, v) => uses_fs_expr(v)
        DArray(sz) => uses_fs_expr(sz)
        DSetIndex(coll, ix, v) => uses_fs_expr(coll) or uses_fs_expr(ix) or uses_fs_expr(v)
        DBlock(exprs) => do
            var found = false
            for x in exprs
                if uses_fs_expr(x)
                    found = true
            found
        DWhile(cond, body) => uses_fs_expr(cond) or uses_fs_expr(body)
        DReturn(v) => uses_fs_expr(v)
        DExit(v) => uses_fs_expr(v)
        DCons(tag, args) => do
            var found = false
            for a in args
                if uses_fs_expr(a)
                    found = true
            found
        DList(items) => do
            var found = false
            for x in items
                if uses_fs_expr(x)
                    found = true
            found
        DIndex(arr, idx) => uses_fs_expr(arr) or uses_fs_expr(idx)
        _ => false

fn uses_fs_prog(prog: [DStmt]) -> bool
    var found = false
    for s in prog
        match s
            DFnS(nm, ps, body) => do
                if uses_fs_expr(body)
                    found = true
            DPrint(v) => do
                if uses_fs_expr(v)
                    found = true
            DExprS(v) => do
                if uses_fs_expr(v)
                    found = true
            DLet(nm, v) => do
                if uses_fs_expr(v)
                    found = true
            _ => do
                let _ = 0
    found

fn agen(prog: [DStmt]) -> str
    var c = AC(locals: [], nlabel: 0, data: [], nstr: 0, depth: 0, globals: [], bound: [], out: [], retlbl: "", seen: ["__k_used", "__k_cap", "__k_allocs"])
    ## funcs / main accumulate the whole program: build them as chunk lists and
    ## join once (O(n)), never `s = s + piece` in a loop (O(n^2), and the seed
    ## interpreter never frees the intermediates -> out of memory on large input).
    var funcs = []
    var main = []
    ## top-level `let`s are globals; the main body (lets + prints, in source order) gets a frame
    var gl = []
    var mlocals = []
    var mdepth = 0
    for s in prog
        match s
            DLet(nm, v) => do
                if idx_of(gl, nm) < 0
                    gl.push(nm)
                collect_lets(v, mlocals)
                mdepth = imax(mdepth, match_depth(v))
            DPrint(v) => do
                collect_lets(v, mlocals)
                mdepth = imax(mdepth, match_depth(v))
            DExprS(v) => do
                collect_lets(v, mlocals)
                mdepth = imax(mdepth, match_depth(v))
            DFnS(nm, ps, body) => do
                let _ = 0
    c.globals = gl
    var di = 0
    while di < mdepth
        mlocals.push("_sd" + str(di))
        di = di + 1
    for s in prog
        match s
            DFnS(nm, ps, body) => do
                funcs.push(afn(nm, ps, body, c))
            DPrint(v) => do
                c.locals = mlocals
                c.depth = 0
                c.bound = []
                c.out = []
                aexpr(v, c)
                c.out.push("    popq %rdi\n    call printval\n")
                main.push(c.out.join(""))
            DExprS(v) => do
                c.locals = mlocals
                c.depth = 0
                c.bound = []
                c.out = []
                aexpr(v, c)
                c.out.push("    popq %rax\n")
                main.push(c.out.join(""))
            DLet(nm, v) => do
                c.locals = mlocals
                c.depth = 0
                c.bound = []
                c.out = []
                aexpr(v, c)
                c.out.push("    popq %rax\n    movq %rax, " + gsym(nm) + "(%rip)\n")
                main.push(c.out.join(""))
    var bss = runtime_bss_head() + "    .lcomm .Lrt_ar_table, 96\n"
    var ginit = ""
    for g in gl
        bss = bss + "    .lcomm " + gsym(g) + ", 8\n"
        ## a global read before its `let` runs is int 0 (what the interpreter yields)
        ginit = ginit + "    movq $0, %rdi\n    call mkint\n    movq %rax, " + gsym(g) + "(%rip)\n"
    bss = bss + runtime_bss_gc()
    var mframe = mlocals.len() * 8
    if mframe % 16 != 0
        mframe = mframe + 8
    var mprol = "    movq %rsp, %rbp\n"
    if mframe > 0
        mprol = mprol + "    subq $" + str(mframe) + ", %rsp\n"
    let rodata = runtime_rodata_head() + runtime_rodata_gc() + "    .balign 8\n__k_used:\n    .asciz \"used\"\n    .balign 8\n__k_cap:\n    .asciz \"cap\"\n    .balign 8\n__k_allocs:\n    .asciz \"allocs\"\n    .balign 8\n__r_hs:\n    .quad __r_hs\n    .quad 772\n    .quad __k_used\n    .quad __k_cap\n    .quad __k_allocs\n.Lrt_ar_msg_secret:\n    .asciz \"lume: arena error: a secret arena is never compressed (decompression timing leaks it, [C0009])\\n\"\n.Lrt_ar_msg_many:\n    .asciz \"lume: arena error: too many live arenas (the runtime supports 4)\\n\"\n.Lrt_ar_msg_dead:\n    .asciz \"lume: arena error: no live arena at this handle (arena_new first)\\n\"\n.Lrt_ar_msg_handle:\n    .asciz \"lume: arena error: invalid arena handle\\n\"\n.Lrt_ar_msg_budget:\n    .asciz \"lume: arena error: arena capacity exceeded (arena_new cap_hint is a hard budget)\\n\"\n.Lrt_ar_msg_size:\n    .asciz \"lume: arena error: arena_alloc size must be positive\\n\"\n" + c.data.join("")
    let heap_init = runtime_hosted_init()
    var rtail = runtime_tail() + runtime_block_arrays() + runtime_argv_tail() + runtime_mem_tail()
    if uses_fs_prog(prog)
        rtail = rtail + runtime_fs_tail()
    bss + rodata + "    .section .text\n" + funcs.join("") + rtail + "    .globl _start\n_start:\n" + heap_init + mprol + ginit + main.join("") + "    movq $60, %rax\n    xorq %rdi, %rdi\n    syscall\n"
