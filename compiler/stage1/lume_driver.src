use fs_sha256_file
use linteractive
use capsule

fn ld_rfind_slash(path, i) = if i < 0 then 0 - 1 else if at(path, i) == "/" then i else ld_rfind_slash(path, i - 1)

fn ld_dir(path) = let slash = ld_rfind_slash(path, count(path) - 1) in if slash < 0 then "" else if slash == 0 then "/" else slice(path, 0, slash)

fn ld_base(path) = let slash = ld_rfind_slash(path, count(path) - 1) in slice(path, slash + 1, count(path))

fn ld_root() = let bin = ld_dir(os_arg_at(0)) in let parent = ld_dir(bin) in if ld_base(parent) == "build" then let root = ld_dir(parent) in if root == "" then "." else root else parent

fn ld_tool(root, name) = root + "/build/bin/" + name

fn ld_chomp(text) = if count(text) > 0 and at(text, count(text) - 1) == "\n" then slice(text, 0, count(text) - 1) else text

## Build/compile step timeout (#428): the driver used to pass a hardcoded 120 s to every timed
## child, so compiling the 459 KB lumec.src amalgam (~4 min) was killed with an empty stderr. The
## budget defaults to 10 min for known-large inputs and is configurable per invocation with
## `lume build --build-timeout-ms <n>` (an env var cannot work yet: the native runtime execs every
## child with an empty environment). A killed-by-timeout now says so, naming the tool and budget.
fn ld_all_digits(s, i) = if i >= count(s) then 1 else if at(s, i) >= "0" and at(s, i) <= "9" then ld_all_digits(s, i + 1) else 0

fn ld_positive_int(s) = if count(s) == 0 or ld_all_digits(s, 0) == 0 then 0 else toint(s)

fn ld_build_timeout_ms(root, input_size) = if input_size > 200000 then 600000 else 120000

fn ld_timeout_check(tool, timeout_ms) = if os_last_timed_out() == 1 then ctfail("native " + tool + " killed by timeout after " + str(timeout_ms / 1000) + "s (raise the budget with lume build --build-timeout-ms <milliseconds>)\n") else 0

fn ld_request(root, tool, request) = let input = root + "/build/lume-driver.in" in let output = root + "/build/lume-driver.out" in let errors = root + "/build/lume-driver.err" in let written = fs_write_sync(input, request) in if written != 1 then ctfail("native driver cannot write tool request\n") else let timeout_ms = ld_build_timeout_ms(root, count(request)) in let status = os_run_input_capture_timeout(ld_tool(root, tool), Nil, input, output, errors, timeout_ms) in let zt = ld_timeout_check("driver tool " + tool, timeout_ms) in if status != 0 then ctfail("native driver tool failed: " + tool + " status " + str(status) + "\nstdout:\n" + fs_read_file(output) + "\nstderr:\n" + fs_read_file(errors)) else ld_chomp(fs_read_file(output))

fn ld_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else ld_contains_at(text, part, i + 1)

fn ld_has_import(source) = let text = fs_read_file(source) in if slice(text, 0, 4) == "use " then 1 else ld_contains_at(text, "\nuse ", 0)

fn ld_ltrim(s, i) = if i >= count(s) then "" else if at(s, i) == " " or at(s, i) == "\t" or at(s, i) == "\r" then ld_ltrim(s, i + 1) else slice(s, i, count(s))

fn ld_rtrim(s) = if count(s) == 0 then "" else if at(s, count(s) - 1) == " " or at(s, count(s) - 1) == "\t" or at(s, count(s) - 1) == "\r" or at(s, count(s) - 1) == "\n" then ld_rtrim(slice(s, 0, count(s) - 1)) else s

fn ld_trim(s) = ld_rtrim(ld_ltrim(s, 0))

fn ld_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else ld_line_end(s, i + 1)

fn ld_lines(s, i) = if i >= count(s) then Nil else let e = ld_line_end(s, i) in Cons(slice(s, i, e), ld_lines(s, e + 1))

fn ld_starts(s, prefix) = if count(s) < count(prefix) then 0 else slice(s, 0, count(prefix)) == prefix

fn ld_delim(s, i) = if i >= count(s) then i else if at(s, i) == " " or at(s, i) == "\t" or at(s, i) == "(" then i else ld_delim(s, i + 1)

fn ld_import_line(line) = let tr = ld_trim(line) in if ld_starts(tr, "use ") == 0 then "" else let raw = ld_trim(slice(tr, 4, count(tr))) in let no_std = if ld_starts(raw, "std.") == 1 then slice(raw, 4, count(raw)) else raw in slice(no_std, 0, ld_delim(no_std, 0))

fn ld_imports(path) = ld_import_lines(ld_lines(fs_read_file(path), 0))

fn ld_import_lines(lines) = match lines
    Nil        => Nil
    Cons(h, t) => let name = ld_import_line(h) in if name == "" then ld_import_lines(t) else Cons(name, ld_import_lines(t))

fn ld_member(names, name) = match names
    Nil        => 0
    Cons(h, t) => if h == name then 1 else ld_member(t, name)

fn ld_find_module(root, dir, name) = let local = dir + "/" + name + ".src" in let nested = dir + "/src/" + name + ".src" in let dependency = dir + "/deps/" + name + ".src" in let shared = root + "/compiler/stage1/" + name + ".src" in if fs_path_exists(local) == 1 then local else if fs_path_exists(nested) == 1 then nested else if fs_path_exists(dependency) == 1 then dependency else if fs_path_exists(shared) == 1 then shared else ctfail("lmod: module '" + name + "' not found (native bundling cannot resolve module: " + name + ")\n")

fn ld_append(out, text) = if fs_append_sync(out, text) == 1 then 1 else ctfail("native bundling cannot append request: " + out + "\n")

fn ld_collect(root, dir, out, names, seen) = match names
    Nil        => seen
    Cons(h, t) => if ld_member(seen, h) == 1 then ld_collect(root, dir, out, t, seen) else let path = ld_find_module(root, dir, h) in let written = ld_append(out, "@module " + h + "\n" + fs_read_file(path) + "\n@end\n") in let next_seen = ld_collect(root, dir, out, ld_imports(path), Cons(h, seen)) in ld_collect(root, dir, out, t, next_seen)

fn ld_entry_name(source) = let base = ld_base(source) in if count(base) > 4 and slice(base, count(base) - 4, count(base)) == ".src" then slice(base, 0, count(base) - 4) else base

fn ld_bundle(root, source, out) = ld_bundle_grant(root, source, out, "io")

fn ld_build(root, source, out) = if fs_path_exists(source) == 0 then ctfail("native build cannot read " + source + "\n") else let bundled = ld_bundle(root, source, out) in let assembly = ld_compile_assembly(root, bundled, out, 0) in ld_assemble(root, assembly, out, 0)

fn ld_suffix(text, suffix) = count(text) >= count(suffix) and slice(text, count(text) - count(suffix), count(text)) == suffix

fn ld_infer_target(out) = if ld_suffix(out, ".lumb") then "lumb" else if ld_suffix(out, ".efi") or ld_suffix(out, ".EFI") then "x86_64-uefi-pe" else if ld_suffix(out, ".ptx") then "nvptx64-nvidia-cuda" else if ld_suffix(out, ".spvasm") then "spirv64-vulkan-compute" else if ld_suffix(out, ".v") then "verilog-rtl" else if ld_suffix(out, ".vhd") then "vhdl-rtl" else if ld_suffix(out, ".cortexm") then "arm-none-cortexm" else if ld_suffix(out, ".avr.elf") then "avr-none-elf" else if ld_suffix(out, ".xtensa.elf") then "xtensa-esp32-elf" else if ld_suffix(out, ".avr.hex") or ld_suffix(out, ".avr.ihex") then "avr-none-ihex" else if ld_suffix(out, ".xtensa.hex") or ld_suffix(out, ".xtensa.ihex") then "xtensa-none-ihex" else if ld_suffix(out, ".hex") or ld_suffix(out, ".ihex") then "aarch64-none-ihex" else "x86_64-linux-elf"

fn ld_find_char(text, needle, i) = if i >= count(text) then count(text) else if at(text, i) == needle then i else ld_find_char(text, needle, i + 1)

fn ld_write_target_text(out, text) = if fs_write_sync(out, text) == 1 then 0 else ctfail("native build cannot write target artifact " + out + "\n")

fn ld_target_output(root, out, result) = if ld_starts(result, "ERR:") == 1 then ctfail(slice(result, 4, count(result)) + "\n") else if ld_starts(result, "IHEX:") == 1 then let start = ld_line_end(result, 0) in ld_write_target_text(out, slice(result, start + 1, count(result)) + "\n") else if ld_starts(result, "HEX:") == 1 then let separator = ld_find_char(result, ":", 5) in let written = fs_write_hex_file(out, slice(result, separator + 1, count(result))) in if written != 1 then ctfail("native build cannot write binary target artifact " + out + "\n") else os_run("/bin/chmod", Cons("+x", Cons(out, Nil))) else ctfail("native build received unexpected target compiler output\n")

fn ld_build_target(root, source, out, target) = if target == "" or target == "x86_64-linux-elf" or target == "linux-x86_64" or target == "x86_64-unknown-linux-gnu" or target == "x86_64-none-raw" or target == "x86_64-none-mbr" then ld_build(root, source, out) else if fs_path_exists(source) == 0 then ctfail("native build cannot read " + source + "\n") else let bundled = ld_bundle(root, source, out) in let result = ld_request(root, "ltarget", "@compile " + target + "\n" + fs_read_file(bundled)) in ld_target_output(root, out, result)

fn ld_default_out(source) = if ld_suffix(source, ".src") then slice(source, 0, count(source) - 4) else if ld_suffix(source, ".intent") then slice(source, 0, count(source) - 7) else source + ".out"

## `--build-timeout-ms <n>` (#428): extracted from the raw build argv before ld_build_args runs (it
## would reject the unknown flag), so the compile/assemble budget reaches the build pipeline.
fn ld_scan_btoms(args, rest, btoms) = match args
    Nil => {rest: ld_rev(rest), btoms: btoms}
    Cons(h, t) => if h == "--build-timeout-ms" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => let parsed = ld_positive_int(v) in if parsed <= 0 then ctfail("native build --build-timeout-ms expects a positive integer number of milliseconds\n") else ld_scan_btoms(r, rest, parsed)) else if ld_starts(h, "--build-timeout-ms=") == 1 then let parsed = ld_positive_int(slice(h, 19, count(h))) in if parsed <= 0 then ctfail("native build --build-timeout-ms expects a positive integer number of milliseconds\n") else ld_scan_btoms(t, rest, parsed) else ld_scan_btoms(t, Cons(h, rest), btoms)

fn ld_build_args(args, source, out, target, protect, profile, lsym, links, chdr, incremental) = match args
    Nil => {source: source, out: out, target: target, protect: protect, profile: profile, lsym: lsym, links: ld_rev(links), chdr: chdr, incremental: incremental}
    Cons(h, t) => if h == "-o" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => ld_build_args(r, source, v, target, protect, profile, lsym, links, chdr, incremental)) else if h == "--target" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => ld_build_args(r, source, out, v, protect, profile, lsym, links, chdr, incremental)) else if ld_starts(h, "--target=") == 1 then ld_build_args(t, source, out, slice(h, 9, count(h)), protect, profile, lsym, links, chdr, incremental) else if h == "--incremental" then ld_build_args(t, source, out, target, protect, profile, lsym, links, chdr, 1) else if h == "--protect" then (match t
        Nil => ld_build_args(t, source, out, target, "standard", profile, lsym, links, chdr, incremental)
        Cons(v, r) => if ld_protect_level(v) == 1 then ld_build_args(r, source, out, target, v, profile, lsym, links, chdr, incremental) else ld_build_args(t, source, out, target, "standard", profile, lsym, links, chdr, incremental)) else if ld_starts(h, "--protect=") == 1 then ld_build_args(t, source, out, target, slice(h, 10, count(h)), profile, lsym, links, chdr, incremental) else if h == "--profile" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => ld_build_args(r, source, out, target, protect, v, lsym, links, chdr, incremental)) else if ld_starts(h, "--profile=") == 1 then ld_build_args(t, source, out, target, protect, slice(h, 10, count(h)), lsym, links, chdr, incremental) else if h == "--lsym" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => ld_build_args(r, source, out, target, protect, profile, v, links, chdr, incremental)) else if ld_starts(h, "--lsym=") == 1 then ld_build_args(t, source, out, target, protect, profile, slice(h, 7, count(h)), links, chdr, incremental) else if h == "--link" or h == "-l" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => if v == "" then ctfail("native build --link requires a nonempty library\n") else ld_build_args(r, source, out, target, protect, profile, lsym, Cons(v, links), chdr, incremental)) else if ld_starts(h, "--link=") == 1 then (if count(h) == 7 then ctfail("native build --link requires a nonempty library\n") else ld_build_args(t, source, out, target, protect, profile, lsym, Cons(slice(h, 7, count(h)), links), chdr, incremental)) else if ld_starts(h, "-l") == 1 and count(h) > 2 then ld_build_args(t, source, out, target, protect, profile, lsym, Cons(slice(h, 2, count(h)), links), chdr, incremental) else if h == "--emit-c-header" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => ld_build_args(r, source, out, target, protect, profile, lsym, links, v, incremental)) else if ld_starts(h, "--emit-c-header=") == 1 then ld_build_args(t, source, out, target, protect, profile, lsym, links, slice(h, 16, count(h)), incremental) else if h != "" and at(h, 0) == "-" then ctfail(ld_build_usage()) else if source != "" then ctfail("native build accepts exactly one source file\n") else ld_build_args(t, h, out, target, protect, profile, lsym, links, chdr, incremental)

fn ld_scan_mem(args, rest, mem) = match args
    Nil => {rest: ld_rev(rest), mem: mem}
    Cons(h, t) => if h == "--memory" then ld_scan_mem(t, rest, 1) else ld_scan_mem(t, Cons(h, rest), mem)

fn ld_report_memory(tag) = let st = __lume_heap_stats() in let pk = __lume_heap_peak_used() in let crss = os_last_child_maxrss_kb() in let srss = os_self_maxrss_kb() in fs_write_sync("/dev/stderr", "[memory:" + tag + "] child_maxrss_kb=" + str(crss) + " self_maxrss_kb=" + str(srss) + " heap_used=" + str(st.used) + " heap_peak=" + str(pk) + " heap_allocs=" + str(st.allocs) + "\n")

fn ld_build_entry(root) = let mem_scan = ld_scan_mem(ld_args_from(2), Nil, 0) in let scanned = ld_scan_btoms(mem_scan.rest, Nil, 0) in let args = ld_build_args(scanned.rest, "", "", "", "", "", "", Nil, "", 0) in if args.source == "" then ctfail(ld_build_usage()) else if fs_path_exists(args.source) == 0 then ctfail("native build cannot read " + args.source + "\n") else let out = if args.out == "" then ld_default_out(args.source) else args.out in let target = if args.target == "" then ld_infer_target(out) else args.target in let manifest = ld_manifest_config(root, args.source) in let profile_protect = ld_profile_protect(args.profile) in let selected_protect = if args.protect != "" then args.protect else if profile_protect != "" then profile_protect else manifest.protect in let links = ld_list_append(args.links, manifest.links) in let valid = ld_validate_build(out, target, if args.target == "" then 0 else 1, selected_protect, args.lsym, links, args.chdr) in let rc = if args.incremental == 1 then ld_build_incremental(root, args.source, out, target, manifest.grant, selected_protect, args.lsym, links, args.chdr, scanned.btoms) else ld_build_configured(root, args.source, out, target, manifest.grant, selected_protect, args.lsym, links, args.chdr, scanned.btoms) in let zm = if mem_scan.mem == 1 then ld_report_memory("build") else 0 in os_exit(rc)

fn ld_args_from(i) = if i >= os_arg_count() then Nil else Cons(os_arg_at(i), ld_args_from(i + 1))

fn ld_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128

fn ld_json_fail(result) = let z = fs_write_sync("/dev/stdout", result + "\n") in ctfail(result + "\n")

fn ld_run_with_args(root, source, prog_args) = let binary = root + "/build/lume-driver-run" in let built = ld_build(root, source, binary) in if built != 0 then built else ld_wait_exit(os_run(binary, prog_args))

fn ld_run(root, source) = ld_run_with_args(root, source, ld_args_from(3))

fn ld_run_entry(root) = if os_arg_at(2) == "--memory" then (if os_arg_count() < 4 then ctfail("usage: lume_driver run [--memory] <source.src> [args]\n") else let rc = ld_run_with_args(root, os_arg_at(3), ld_args_from(4)) in let zm = ld_report_memory("run") in os_exit(rc)) else os_exit(ld_run(root, os_arg_at(2)))

fn ld_capsule_seal_v2(root, src, out_path) = if fs_path_exists(src) == 0 then ctfail("lume capsule: cannot read " + src + "\n") else let src_text = fs_read_file(src) in let bin = root + "/build/lume-capsule-bin" in let built = ld_build(root, src, bin) in if built != 0 then ctfail("lume capsule: build failed for " + src + "\n") else let run_out = root + "/build/lume-capsule-run.out" in let run_err = root + "/build/lume-capsule-run.err" in let rc = os_run_capture_timeout(bin, Nil, run_out, run_err, 60000) in if rc != 0 then ctfail("lume capsule: execution failed for " + src + "\n") else let stdout_text = fs_read_file(run_out) in let b = capsule_bundle_create2(ld_base(src), "io", src_text, "", stdout_text, 1) in let w = fs_write_sync(out_path, capsule_bundle_encode(b)) in if w != 1 then ctfail("lume capsule: cannot write " + out_path + "\n") else "{\"ok\":true,\"mode\":\"capsule-seal-v2\",\"format\":\"LUME_ECAPSULE_V2\",\"cid\":\"" + b.cid + "\",\"manifest_digest\":\"" + b.manifest_digest + "\",\"code_cid\":\"" + b.code_cid + "\",\"stdout_sha\":\"" + b.stdout_sha + "\",\"proof_digest\":\"" + b.proof_digest + "\"}"

fn ld_capsule_entry(root) = if os_arg_count() < 4 then ctfail("usage: lume_driver capsule seal <name> <grant> <source> -o <out.cap> | seal <source.src> -o <out.lcaps> | verify <in.cap|in.lcaps> [grant] | replay <in.lcaps> | open <in.cap> <grant>\n") else let act = os_arg_at(2) in if act == "seal" then (if os_arg_count() == 6 and os_arg_at(4) == "-o" then ld_capsule_seal_v2(root, os_arg_at(3), os_arg_at(5)) else if os_arg_count() != 8 or os_arg_at(6) != "-o" then ctfail("usage: lume_driver capsule seal <name> <grant> <source> -o <out.cap> | seal <source.src> -o <out.lcaps>\n") else let src = os_arg_at(5) in if fs_path_exists(src) == 0 then ctfail("lume capsule: cannot read " + src + "\n") else let cap = capsule_seal(os_arg_at(3), os_arg_at(4), fs_read_file(src)) in let w = fs_write_sync(os_arg_at(7), cap_serialize(cap)) in if w != 1 then ctfail("lume capsule: cannot write " + os_arg_at(7) + "\n") else "{\"ok\":true,\"mode\":\"capsule-seal\",\"name\":\"" + cap.name + "\",\"grant\":\"" + cap.cap_grant + "\",\"digest\":\"" + cap.digest + "\"}") else if act == "verify" then (let path = os_arg_at(3) in if fs_path_exists(path) == 0 then ctfail("lume capsule: cannot read " + path + "\n") else let raw = fs_read_file(path) in if ld_starts(raw, "@lcaps LUME_ECAPSULE_V2") == 1 then let b = capsule_bundle_decode(raw) in let v = capsule_bundle_verify(b) in if v.ok == 0 then ld_json_fail("{\"ok\":false,\"mode\":\"capsule-verify\",\"error\":\"" + v.error + "\"}") else "{\"ok\":true,\"mode\":\"capsule-verify\",\"format\":\"LUME_ECAPSULE_V2\",\"cid\":\"" + b.cid + "\",\"manifest_digest\":\"" + b.manifest_digest + "\",\"proof_digest\":\"" + b.proof_digest + "\"}" else let cap = cap_deserialize(raw) in if capsule_verify(cap) == 0 then ld_json_fail("{\"ok\":false,\"mode\":\"capsule-verify\",\"error\":\"[C0430] capsule integrity check failed\"}") else "{\"ok\":true,\"mode\":\"capsule-verify\",\"name\":\"" + cap.name + "\",\"grant\":\"" + cap.cap_grant + "\",\"digest\":\"" + cap.digest + "\"}") else if act == "replay" then (let path = os_arg_at(3) in if fs_path_exists(path) == 0 then ctfail("lume capsule: cannot read " + path + "\n") else let b = capsule_bundle_decode(fs_read_file(path)) in let rep = capsule_bundle_replay(b, b.expected_stdout, 1) in if rep.ok == 0 then ld_json_fail("{\"ok\":false,\"mode\":\"capsule-replay\",\"error\":\"" + rep.error + "\"}") else "{\"ok\":true,\"mode\":\"capsule-replay\",\"format\":\"LUME_ECAPSULE_V2\",\"cid\":\"" + b.cid + "\",\"manifest_digest\":\"" + b.manifest_digest + "\",\"tick\":" + str(rep.tick) + ",\"next_tick\":" + str(rep.next_tick) + ",\"seed\":" + str(b.seed) + ",\"proof_verified\":true}") else if act == "open" then (if os_arg_count() < 5 then ctfail("usage: lume_driver capsule open <in.cap> <grant>\n") else let path = os_arg_at(3) in if fs_path_exists(path) == 0 then ctfail("lume capsule: cannot read " + path + "\n") else let cap = cap_deserialize(fs_read_file(path)) in let res = capsule_open(cap, os_arg_at(4)) in if res.ok == 0 then ctfail(res.error + "\n") else ld_chomp(res.value)) else ctfail("usage: lume_driver capsule seal|verify|replay|open ...\n")

fn ld_test(root, source) = if fs_path_exists(source) == 0 then ctfail("native test cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-test") in let generated = ld_request(root, "ltest", fs_read_file(bundled)) in let harness = root + "/build/lume-driver-test-harness.src" in let written = fs_write_sync(harness, generated + "\n") in if written != 1 then ctfail("native test cannot write generated harness\n") else let binary = root + "/build/lume-driver-test-bin" in let built = ld_build(root, harness, binary) in if built != 0 then built else ld_wait_exit(os_run(binary, Nil))

fn ld_certify(root, source) = if fs_path_exists(source) == 0 then ctfail("native certify cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-certify") in let result = ld_request(root, "lcaas", "@mode certify\n@sha256 " + fs_sha256_file(bundled) + "\n" + fs_read_file(bundled)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ld_json_fail(result)

fn ld_verify_cert(root, source) = if fs_path_exists(source) == 0 then ctfail("native verify-cert cannot read " + source + "\n") else let result = ld_request(root, "lcert", fs_read_file(source)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ld_json_fail(result)

fn ld_certify_src(root, cmd, source) = if cmd == "certify" then ld_certify(root, source) else if cmd == "verify-cert" then ld_verify_cert(root, source) else ld_info(root)

fn ld_certify_entry(root) = if os_arg_count() == 3 then ld_certify_src(root, os_arg_at(1), os_arg_at(2)) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_certify_src(root, os_arg_at(1), os_arg_at(3)) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_certify_src(root, os_arg_at(1), os_arg_at(2)) else ctfail("usage: lume_driver certify|verify-cert <source.src|certificate.json>\n")

fn ld_check(root, source, json) = if fs_path_exists(source) == 0 then ctfail("native check cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-check") in let result = ld_request(root, "lcaas", fs_read_file(bundled)) in if ld_contains_at(result, "\"ok\":false", 0) == 1 then ld_json_fail(result) else if json == 1 then os_exit(0) else let reported = fs_write_sync("/dev/stderr", source + ": OK (Lume-Core parsed and checked)\n") in os_exit(0)

fn ld_check_entry(root) = if os_arg_count() == 3 then ld_check(root, os_arg_at(2), 0) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_check(root, os_arg_at(3), 1) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_check(root, os_arg_at(2), 1) else ctfail("usage: lume_driver check <source.src> [--json]\n")

fn ld_fmt(root, source, mode) = if fs_path_exists(source) == 0 then ctfail("native fmt cannot read " + source + "\n") else let formatted = ld_request(root, "lfmt", fs_read_file(source)) in let generated = formatted + "\n" in if mode == "--check" then (if fs_read_file(source) == generated then 0 else let reported = fs_write_sync("/dev/stderr", "lume fmt: " + source + " is not canonically formatted\n") in 1) else let written = fs_write_sync(source, generated) in if written != 1 then ctfail("native fmt cannot rewrite " + source + "\n") else 0

fn ld_fmt_entry(root) = let args = ld_fmt_args(ld_args_from(2), Nil, "") in if ld_has_links(args.sources) == 0 then ctfail("usage: lume_driver fmt <source.src>... [--check|--stdout]\n") else if args.mode == "--stdout" then let written = fs_write_sync("/dev/stdout", ld_fmt_stdout_all(root, args.sources)) in if written != 1 then ctfail("native fmt cannot write formatted output\n") else os_exit(0) else os_exit(ld_fmt_files(root, args.sources, args.mode, 0))

fn ld_line_count_at(text, i) = if i >= count(text) then 0 else (if at(text, i) == "\n" then 1 else 0) + ld_line_count_at(text, i + 1)

fn ld_compile_json(root, exit_code, asm_lines, ran, run_exit, diag, stdout) = ld_request(root, "lcli", "@cmd compile-json\n@exit " + str(exit_code) + "\n@asm_lines " + str(asm_lines) + "\n@ran " + str(ran) + "\n@run_exit " + str(run_exit) + "\n@diag\n" + diag + "\n@end\n@stdout\n" + stdout + "\n@end\n")

fn ld_compile_run(root, assembly, binary) = let assemble_errors = binary + ".assemble.err" in let assemble_ms = ld_build_timeout_ms(root, count(fs_read_file(assembly))) in let assembled = os_run_capture_timeout(ld_tool(root, "lasm"), Cons("--strict", Cons(assembly, Nil)), binary, assemble_errors, assemble_ms) in let zt0 = ld_timeout_check("compile assembler (lasm)", assemble_ms) in if assembled != 0 then ctfail("native compile assembler failed:\n" + fs_read_file(assemble_errors)) else let changed = os_run("/bin/chmod", Cons("+x", Cons(binary, Nil))) in if changed != 0 then ctfail("native compile cannot mark artifact executable\n") else let output = binary + ".out" in let errors = binary + ".err" in let run_ms = ld_build_timeout_ms(root, 0) in let executed = os_run_capture_timeout(binary, Nil, output, errors, run_ms) in let zt1 = ld_timeout_check("compiled program", run_ms) in {ran: 1, run_exit: ld_wait_exit(executed), stdout: fs_read_file(output)}

fn ld_compile_report(root, source, assembly) = let reported = fs_write_sync("/dev/stderr", "lume compile: " + source + " OK (" + str(ld_line_count_at(fs_read_file(assembly), 0)) + " asm lines)\n") in ld_chomp(fs_read_file(assembly))

fn ld_compile_result(root, source, json, execute, compiled, assembly, diag) = let exit_code = ld_wait_exit(compiled) in let asm_lines = ld_line_count_at(fs_read_file(assembly), 0) in if compiled != 0 then (if json == 1 then let response = ld_compile_json(root, exit_code, asm_lines, 0, 0, fs_read_file(diag), "") in let reported = fs_write_sync("/dev/stdout", response + "\n") in os_exit(exit_code) else ctfail(fs_read_file(diag))) else let binary = root + "/build/lume-driver-compile-bin" in let outcome = if execute == 1 then ld_compile_run(root, assembly, binary) else {ran: 0, run_exit: 0, stdout: ""} in if json == 1 then ld_compile_json(root, 0, asm_lines, outcome.ran, outcome.run_exit, fs_read_file(diag), outcome.stdout) else ld_compile_report(root, source, assembly)

fn ld_compile(root, source, json, execute) = if fs_path_exists(source) == 0 then ctfail("native compile cannot read " + source + "\n") else if count(source) < 5 or slice(source, count(source) - 4, count(source)) != ".src" then ctfail("native compile expects a .src Lume-Core file\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-compile") in let assembly = root + "/build/lume-driver-compile.s" in let diag = root + "/build/lume-driver-compile.diag" in let compile_ms = ld_build_timeout_ms(root, count(fs_read_file(bundled))) in let compiled = os_run_input_capture_timeout(ld_tool(root, "lumec"), Nil, bundled, assembly, diag, compile_ms) in let zt = ld_timeout_check("compile compiler (lumec)", compile_ms) in if compiled != 0 then ld_compile_result(root, source, json, execute, compiled, assembly, diag) else let checked = ld_request(root, "lcaas", fs_read_file(bundled)) in if ld_contains_at(checked, "\"ok\":false", 0) == 1 then (if json == 1 then let reported = fs_write_sync("/dev/stdout", checked + "\n") in os_exit(1) else ctfail(checked + "\n")) else ld_compile_result(root, source, json, execute, compiled, assembly, diag)

fn ld_compile_args(args, source, json, execute) = match args
    Nil        => {source: source, json: json, execute: execute}
    Cons(h, t) => if h == "--json" then ld_compile_args(t, source, 1, execute) else if h == "--run" then ld_compile_args(t, source, json, 1) else if slice(h, 0, 1) == "-" then ctfail("usage: lume_driver compile [--json] [--run] <source.src>\n") else ld_compile_args(t, h, json, execute)

fn ld_compile_entry(root) = let args = ld_compile_args(ld_args_from(2), "", 0, 0) in if args.source == "" then ctfail("usage: lume_driver compile [--json] [--run] <source.src>\n") else ld_compile(root, args.source, args.json, args.execute)

fn ld_agent_direct(mode) = if mode == "check" or mode == "compile" or mode == "fill" or mode == "prove" or mode == "ast" or mode == "expand" or mode == "symbols" or mode == "eval" then 1 else 0

fn ld_agent_query(mode) = if mode == "witness" or mode == "repair" or mode == "impact" or mode == "hashes" or mode == "grammar" or mode == "project" or mode == "bind" or mode == "skeleton" or mode == "cegis" or mode == "synthesize" or mode == "trace" then 1 else 0

fn ld_agent_patch_fn(root, source, fn_name, new_fn) = if fs_path_exists(source) == 0 then ctfail("native agent patch-fn cannot read " + source + "\n") else let result = ld_request(root, "lcaas", "@mode patch-fn\n" + fn_name + "\n" + new_fn + "\n@split\n" + fs_read_file(source)) in if ld_contains_at(result, "\"ok\":false", 0) == 1 then ld_json_fail(result) else result

fn ld_agent_diff_semver(root, old_source, new_source) = if fs_path_exists(old_source) == 0 or fs_path_exists(new_source) == 0 then ctfail("native agent diff-semver cannot read requested sources\n") else let result = ld_request(root, "lcaas", "@mode diff-semver\n" + fs_read_file(old_source) + "\n@split\n" + fs_read_file(new_source)) in if ld_contains_at(result, "\"ok\":false", 0) == 1 then ld_json_fail(result) else result

fn ld_agent(root, mode, source) = if ld_agent_direct(mode) == 0 and ld_agent_query(mode) == 0 then ctfail("usage: lume_driver agent <mode> <source.src> [args]\n") else if fs_path_exists(source) == 0 then ctfail("native agent cannot read " + source + "\n") else let prefix = if ld_agent_query(mode) == 1 then "@mode " + mode + "\n" else "" in let result = ld_request(root, "lcaas", prefix + fs_read_file(source)) in if ld_contains_at(result, "\"ok\":false", 0) == 1 then ld_json_fail(result) else result

fn ld_agent_source(root, mode, source, suffix) = if fs_path_exists(source) == 0 then ctfail("native agent cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-agent-" + mode) in let result = ld_request(root, "lcaas", "@mode " + mode + "\n" + fs_read_file(bundled) + suffix) in if ld_contains_at(result, "\"ok\":true", 0) == 0 then ld_json_fail(result) else result

fn ld_agent_rot(root, old_source, new_source, shared_source) = if fs_path_exists(old_source) == 0 or fs_path_exists(new_source) == 0 or fs_path_exists(shared_source) == 0 then ctfail("native agent check-rot cannot read requested sources\n") else let old_bundle = ld_bundle(root, old_source, root + "/build/lume-driver-agent-rot-old") in let new_bundle = ld_bundle(root, new_source, root + "/build/lume-driver-agent-rot-new") in let shared_bundle = ld_bundle(root, shared_source, root + "/build/lume-driver-agent-rot-shared") in let result = ld_request(root, "lcaas", "@mode check-rot\n" + fs_read_file(old_bundle) + "\n@split\n" + fs_read_file(new_bundle) + "\n@split\n" + fs_read_file(shared_bundle)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ld_json_fail(result)

fn ld_agent_entry(root) = let mode = os_arg_at(2) in if (mode == "kernel" or mode == "c-export" or mode == "replay") and os_arg_count() == 4 then ld_agent_source(root, mode, os_arg_at(3), "") else if (mode == "kernel" or mode == "c-export" or mode == "replay") and os_arg_count() == 5 and os_arg_at(3) == "--json" then ld_agent_source(root, mode, os_arg_at(4), "") else if mode == "lineage" and os_arg_count() == 4 then ld_agent_source(root, "lineage", os_arg_at(3), "") else if mode == "lineage" and os_arg_count() == 5 then ld_agent_source(root, "lineage", os_arg_at(3), "\n@split\n" + os_arg_at(4)) else if mode == "patch" and os_arg_count() == 6 then ld_agent_source(root, "patch", os_arg_at(3), "\n@split\n" + os_arg_at(4) + "\n@split\n" + os_arg_at(5)) else if mode == "patch-fn" and os_arg_count() == 6 then ld_agent_patch_fn(root, os_arg_at(3), os_arg_at(4), os_arg_at(5)) else if mode == "diff-semver" and os_arg_count() == 5 then ld_agent_diff_semver(root, os_arg_at(3), os_arg_at(4)) else if mode == "check-rot" and os_arg_count() == 6 then ld_agent_rot(root, os_arg_at(3), os_arg_at(4), os_arg_at(5)) else if os_arg_count() == 4 then ld_agent(root, mode, os_arg_at(3)) else if os_arg_count() == 5 and os_arg_at(3) == "--json" then ld_agent(root, mode, os_arg_at(4)) else if os_arg_count() == 5 and os_arg_at(4) == "--json" then ld_agent(root, mode, os_arg_at(3)) else ctfail("usage: lume_driver agent <mode> <source.src> [args]\n")

fn ld_protocol(root, mode, source) = if fs_path_exists(source) == 0 then ctfail("native " + mode + " cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-" + mode) in ld_request(root, "lcaas", "@mode " + mode + "\n" + fs_read_file(bundled))

fn ld_protocol_entry(root, mode) = if (os_arg_count() == 3 or os_arg_count() == 4) and os_arg_at(2) == "--stdio" then (if mode == "lsp" then os_exit(li_lsp(root, if os_arg_count() == 4 then os_arg_at(3) else "")) else if mode == "dap" then os_exit(li_dap(root, if os_arg_count() == 4 then os_arg_at(3) else "")) else ctfail("usage: lume_driver lsp|dap [--json] <source.src>|--stdio [source.src]\n")) else if os_arg_count() == 3 then ld_protocol(root, mode, os_arg_at(2)) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_protocol(root, mode, os_arg_at(3)) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_protocol(root, mode, os_arg_at(2)) else ctfail("usage: lume_driver lsp|dap [--json] <source.src>|--stdio [source.src]\n")

fn ld_repl_entry(root) = if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_protocol(root, "repl", os_arg_at(3)) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_protocol(root, "repl", os_arg_at(2)) else if os_arg_count() == 2 then os_exit(li_repl_interactive(root)) else if os_arg_count() == 3 and (os_arg_at(2) == "--kernel" or os_arg_at(2) == "--json") then os_exit(li_repl_kernel(root)) else ctfail("usage: lume_driver repl [--json <source.src>|--kernel|--stdio]\n")

fn ld_intent_input(source, cache) = let text = fs_read_file(source) in if fs_path_exists(cache) == 1 then text + "\n@split\n" + fs_read_file(cache) else text

fn ld_intent_build(root, source, cache, out) = let checked = ld_request(root, "lcaas", "@mode intent-build\n" + ld_intent_input(source, cache)) in if ld_contains_at(checked, "\"ok\":true", 0) == 0 then ld_json_fail(checked) else let updated = if ld_contains_at(checked, "\"cache_hit\":true", 0) == 1 and fs_path_exists(cache) == 1 then 1 else let generated = ld_request(root, "lcaas", "@mode intent-code\n" + ld_intent_input(source, cache)) in fs_write_sync(cache, generated + "\n") in if updated != 1 then ctfail("native intent cannot write cache " + cache + "\n") else let cert_path = ld_intent_cert(cache) in let cert_ok = if ld_contains_at(checked, "\"cache_hit\":true", 0) == 1 and fs_path_exists(cert_path) == 1 then 1 else fs_write_sync(cert_path, ld_certify(root, cache) + "\n") in if cert_ok != 1 then ctfail("native intent cannot write certificate " + cert_path + "\n") else let built = if out == "" then 0 else ld_build(root, cache, out) in if built != 0 then ctfail("native intent cannot build " + out + "\n") else checked

fn ld_intent_verify(root, source, cache) = let result = ld_request(root, "lcaas", "@mode intent-verify\n" + ld_intent_input(source, cache)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ld_json_fail(result)

fn ld_intent_run(root, source, cache) = let generated = ld_intent_build(root, source, cache, "") in os_exit(ld_run(root, cache))

fn ld_intent_clean(cache) = let removed_cache = ld_remove_if_present(cache) in let removed_cert = ld_remove_if_present(ld_intent_cert(cache)) in if removed_cache == 1 and removed_cert == 1 then "{\"ok\":true,\"mode\":\"intent-clean\",\"cache_file\":\"" + cache + "\"}" else ctfail("native intent cannot clean " + cache + "\n")

fn ld_intent_cert(cache) = if ld_suffix(cache, ".src") == 1 then slice(cache, 0, count(cache) - 4) + ".cert.json" else cache + ".cert.json"

fn ld_remove_if_present(path) = if fs_path_exists(path) == 1 then fs_remove(path) else 1

fn ld_intent(root, action, source, cache, out) = if fs_path_exists(source) == 0 then ctfail("native intent cannot read " + source + "\n") else let target = if cache == "" then source + ".cache.src" else cache in if action == "build" then ld_intent_build(root, source, target, out) else if action == "verify" or action == "status" then ld_intent_verify(root, source, target) else if action == "run" then ld_intent_run(root, source, target) else if action == "clean" then ld_intent_clean(target) else ctfail("usage: lume_driver intent build|run|verify|status|clean <file.intent> [--cache <cache.src>]\n")

fn ld_intent_args_cache(t, st) = match t
    Nil        => ctfail("usage: lume_driver intent build|run|verify|status|clean <file.intent> [--cache <cache.src>]\n")
    Cons(v, r) => ld_intent_args(r, {action: st.action, source: st.source, cache: v, out: st.out})

fn ld_intent_args_out(t, st) = match t
    Nil        => ctfail("usage: lume_driver intent build|run|verify|status|clean <file.intent> [--cache <cache.src>]\n")
    Cons(v, r) => ld_intent_args(r, {action: st.action, source: st.source, cache: st.cache, out: v})

fn ld_intent_args(args, st) = match args
    Nil        => st
    Cons(h, t) => if h == "--json" then ld_intent_args(t, st) else if h == "--cache" then ld_intent_args_cache(t, st) else if h == "-o" or h == "--output" then ld_intent_args_out(t, st) else if slice(h, 0, 1) == "-" then ctfail("usage: lume_driver intent build|run|verify|status|clean <file.intent> [--cache <cache.src>]\n") else if st.action == "" then ld_intent_args(t, {action: h, source: st.source, cache: st.cache, out: st.out}) else if st.source == "" then ld_intent_args(t, {action: st.action, source: h, cache: st.cache, out: st.out}) else ctfail("usage: lume_driver intent build|run|verify|status|clean <file.intent> [--cache <cache.src>]\n")

fn ld_intent_entry(root) = let args = ld_intent_args(ld_args_from(2), {action: "", source: "", cache: "", out: ""}) in if args.action == "" or args.source == "" then ctfail("usage: lume_driver intent build|run|verify|status|clean <file.intent> [--cache <cache.src>]\n") else ld_intent(root, args.action, args.source, args.cache, args.out)

fn ld_mesh(root, source) = if source == "bench" then ctfail("lume mesh: 'bench' has been removed; use 'lume economy' instead\n") else if fs_path_exists(source) == 0 then ctfail("native mesh cannot read " + source + "\n") else let result = ld_request(root, "lmesh", fs_read_file(source)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ld_json_fail(result)

fn ld_mesh_entry(root) = if os_arg_count() == 3 then ld_mesh(root, os_arg_at(2)) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_mesh(root, os_arg_at(3)) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_mesh(root, os_arg_at(2)) else ctfail("usage: lume_driver mesh <request.mesh> [--json]\n")

fn ld_adapt(root, source, json, out) = if fs_path_exists(source) == 0 then ctfail("native adapt cannot read " + source + "\n") else if json == 1 and out != "" then ctfail("lume adapt: --json and --output are mutually exclusive\n") else let checked = ld_request(root, "lcaas", "@mode bind\n" + fs_read_file(source)) in if ld_contains_at(checked, "\"ok\":true", 0) == 0 then ld_json_fail(checked) else if json == 1 then checked else let generated = ld_request(root, "lcaas", "@mode bind-source\n" + fs_read_file(source)) in if out == "" then generated else let written = fs_write_sync(out, generated + "\n") in if written != 1 then ctfail("native adapt cannot write " + out + "\n") else os_exit(0)

fn ld_adapt_entry(root) = if os_arg_at(2) != "c" then ctfail("usage: lume_driver adapt c <header.h> [--json] [-o <out.src>]\n") else if os_arg_count() == 4 then ld_adapt(root, os_arg_at(3), 0, "") else if os_arg_count() == 5 and os_arg_at(3) == "--json" then ld_adapt(root, os_arg_at(4), 1, "") else if os_arg_count() == 5 and os_arg_at(4) == "--json" then ld_adapt(root, os_arg_at(3), 1, "") else if os_arg_count() == 6 and (os_arg_at(3) == "-o" or os_arg_at(3) == "--output") then ld_adapt(root, os_arg_at(5), 0, os_arg_at(4)) else if os_arg_count() == 6 and (os_arg_at(4) == "-o" or os_arg_at(4) == "--output") then ld_adapt(root, os_arg_at(3), 0, os_arg_at(5)) else ctfail("usage: lume_driver adapt c <header.h> [--json] [-o <out.src>]\n")

fn ld_prove(root, source) = if fs_path_exists(source) == 0 then ctfail("native prove cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-prove") in let result = ld_request(root, "lcaas", fs_read_file(bundled)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ld_json_fail(result)

fn ld_proof_mode(root, mode, source, second) = if fs_path_exists(source) == 0 or mode != "share" and fs_path_exists(second) == 0 then ctfail("native prove cannot read requested sources\n") else let first_bundle = ld_bundle(root, source, root + "/build/lume-driver-prove-" + mode + "-first") in let first = fs_read_file(first_bundle) in let body = if mode == "share" then first else first + "\n@split\n" + fs_read_file(ld_bundle(root, second, root + "/build/lume-driver-prove-" + mode + "-second")) in let result = ld_request(root, "lcaas", "@mode " + mode + "\n" + body) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ld_json_fail(result)

fn ld_prove_args(args, mode, first, second) = match args
    Nil        => {mode: mode, first: first, second: second}
    Cons(h, t) => if h == "--json" then ld_prove_args(t, mode, first, second) else if h == "--diff" then ld_prove_args(t, "proof-diff", first, second) else if h == "--share" then ld_prove_args(t, "share", first, second) else if h == "--compositional" then ld_prove_args(t, "compose", first, second) else if slice(h, 0, 1) == "-" then ctfail("usage: lume_driver prove [--diff|--share|--compositional] <source.src> [new.src]\n") else if first == "" then ld_prove_args(t, mode, h, second) else ld_prove_args(t, mode, first, h)

fn ld_prove_entry(root) = let args = ld_prove_args(ld_args_from(2), "", "", "") in if args.first == "" then ctfail("usage: lume_driver prove [--diff|--share|--compositional] <source.src> [new.src]\n") else if args.mode == "" and args.second == "" then ld_prove(root, args.first) else if args.mode == "share" and args.second == "" then ld_proof_mode(root, "share", args.first, "") else if (args.mode == "proof-diff" or args.mode == "compose") and args.second != "" then ld_proof_mode(root, args.mode, args.first, args.second) else ctfail("usage: lume_driver prove [--diff|--share|--compositional] <source.src> [new.src]\n")

fn ld_doc(root, source, json) = if fs_path_exists(source) == 0 then ctfail("native doc cannot read " + source + "\n") else ld_request(root, "ldoc", (if json == 1 then "@json\n" else "") + fs_read_file(source))

fn ld_doc_entry(root) = if os_arg_count() == 3 then ld_doc(root, os_arg_at(2), 0) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_doc(root, os_arg_at(3), 1) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_doc(root, os_arg_at(2), 1) else ctfail("usage: lume_driver doc <source.src> [--json]\n")

fn ld_pkg(root, action, dir) = if action == "init" then ld_pkg_init(root, dir) else if action == "check" or action == "manifest" then ld_pkg_manifest(root, dir) else if action == "lock" then ld_pkg_lock(root, dir) else if action == "verify" then ld_pkg_verify(root, dir) else if action == "tree" then ld_pkg_tree(root, dir) else ctfail("usage: lume_driver pkg init|check|manifest|lock|verify|tree [dir]\n")

fn ld_pkg_clean_dir(dir) = if count(dir) > 1 and at(dir, count(dir) - 1) == "/" then ld_pkg_clean_dir(slice(dir, 0, count(dir) - 1)) else dir

fn ld_pkg_name(dir) = let clean = ld_pkg_clean_dir(dir) in if clean == "." or clean == "" then ld_base(fs_current_dir()) else ld_base(clean)

fn ld_pkg_mkdirs(dir) = if fs_path_exists(dir) == 1 then 1 else let parent = ld_dir(dir) in let made = if parent == "" or parent == dir then 1 else ld_pkg_mkdirs(parent) in if made != 1 then 0 else fs_mkdir(dir)

fn ld_pkg_init(root, dir) = let pkg = ld_pkg_name(dir) in let made = ld_pkg_mkdirs(ld_pkg_clean_dir(dir)) in if made != 1 then ctfail("lume pkg: cannot create " + dir + "\n") else let manifest = dir + "/lume.toml" in let main = dir + "/main.src" in let manifest_written = if fs_path_exists(manifest) == 1 then 1 else fs_write_sync(manifest, ld_request(root, "lmod", "@pkg-init\n@pkg " + pkg + "\n@part toml\n") + "\n") in let main_written = if fs_path_exists(main) == 1 then 1 else fs_write_sync(main, ld_request(root, "lmod", "@pkg-init\n@pkg " + pkg + "\n@part main\n") + "\n") in if manifest_written != 1 or main_written != 1 then ctfail("lume pkg: cannot initialize " + dir + "\n") else "lume pkg: initialized " + pkg + " in " + manifest

fn ld_pkg_manifest(root, dir) = let manifest = dir + "/lume.toml" in if fs_path_exists(manifest) == 0 then ctfail("lume pkg: missing " + manifest + "\n") else ld_request(root, "lmod", "@manifest\n" + fs_read_file(manifest))

fn ld_pkg_source(path, include_lume) = ld_suffix(path, ".src") or (include_lume == 1 and ld_suffix(path, ".lume"))

fn ld_pkg_join_rel(parent, name) = if parent == "" then name else parent + "/" + name

fn ld_pkg_walk(dir, rel, depth, include_lume) = if rel != "" and ld_pkg_source(rel, include_lume) then Cons(rel, Nil) else if rel != "" and depth >= 2 then Nil else ld_pkg_walk_entries(dir, rel, depth, include_lume, ld_lines(fs_read_dir(ld_pkg_join_rel(dir, rel)), 0))

fn ld_pkg_walk_entries(dir, rel, depth, include_lume, entries) = match entries
    Nil        => Nil
    Cons(h, t) => let child = ld_pkg_join_rel(rel, h) in let rest = ld_pkg_walk_entries(dir, rel, depth, include_lume, t) in ld_list_append(ld_pkg_walk(dir, child, depth + 1, include_lume), rest)

fn ld_list_append(xs, ys) = match xs
    Nil => ys
    Cons(h, t) => Cons(h, ld_list_append(t, ys))

fn ld_pkg_insert(paths, path) = match paths
    Nil => Cons(path, Nil)
    Cons(h, t) => if path < h then Cons(path, Cons(h, t)) else Cons(h, ld_pkg_insert(t, path))

fn ld_pkg_sort(paths) = match paths
    Nil => Nil
    Cons(h, t) => ld_pkg_insert(ld_pkg_sort(t), h)

fn ld_pkg_files(dir, include_lume) = ld_pkg_sort(ld_pkg_walk(dir, "", 0, include_lume))

fn ld_pkg_lock_modules(root, dir, paths) = match paths
    Nil => ""
    Cons(h, t) => "@module " + fs_sha256_file(dir + "/" + h) + " " + h + "\n" + ld_pkg_lock_modules(root, dir, t)

fn ld_pkg_expected_lock(root, dir) = let manifest = ld_pkg_manifest(root, dir) in ld_request(root, "lmod", "@pkg-lock\n@manifest " + manifest + "\n@manifest_sha256 " + fs_sha256_file(dir + "/lume.toml") + "\n" + ld_pkg_lock_modules(root, dir, ld_pkg_files(dir, 1))) + "\n"

fn ld_pkg_lock(root, dir) = let generated = ld_pkg_expected_lock(root, dir) in let path = dir + "/lume.lock" in let written = fs_write_sync(path, generated) in if written != 1 then ctfail("lume pkg: cannot write " + path + "\n") else "lume pkg: wrote " + path

fn ld_pkg_verify(root, dir) = let lock = dir + "/lume.lock" in if fs_path_exists(dir + "/lume.toml") == 0 or fs_path_exists(lock) == 0 then ctfail("lume pkg: missing lume.toml or lume.lock in " + dir + "\n") else let expected = ld_pkg_expected_lock(root, dir) in if fs_read_file(lock) != expected then ctfail("lume pkg: lockfile verification failed (source or manifest drift detected)\n") else "lume pkg: verified " + lock + " (all SHA-256 digests match)"

fn ld_pkg_tree_sources(dir, paths) = match paths
    Nil => ""
    Cons(h, t) => "@modsrc " + h + "\n" + fs_read_file(dir + "/" + h) + "\n@end\n" + ld_pkg_tree_sources(dir, t)

fn ld_pkg_tree(root, dir) = let manifest = ld_pkg_manifest(root, dir) in ld_request(root, "lmod", "@pkg-tree\n@manifest " + manifest + "\n" + ld_pkg_tree_sources(dir, ld_pkg_files(dir, 0)))

fn ld_pkg_entry(root) = if os_arg_count() == 3 then ld_pkg(root, os_arg_at(2), ".") else if os_arg_count() == 4 then ld_pkg(root, os_arg_at(2), os_arg_at(3)) else if os_arg_count() == 6 and os_arg_at(2) == "check-rot" then ld_agent_rot(root, os_arg_at(3), os_arg_at(4), os_arg_at(5)) else ctfail("usage: lume_driver pkg init|check|manifest|lock|verify|tree [dir]\n")

fn ld_pubkeys_lines(lines) = match lines
    Nil => ""
    Cons(h, t) => let line = ld_trim(h) in (if line == "" or ld_starts(line, "#") == 1 then "" else "@pubkey " + line + "\n") + ld_pubkeys_lines(t)

fn ld_evolve_path(source, default_path) = let selected = if source == "" then default_path else source in if fs_path_exists(selected + "/proposal.bundle") == 1 then selected + "/proposal.bundle" else selected

fn ld_evolve_fixpoint(root) = let stage2 = root + "/build/bootstrap/lumec2" in let stage3 = root + "/build/bootstrap/lumec3" in if fs_path_exists(stage2) == 1 and fs_path_exists(stage3) == 1 then fs_files_equal(stage2, stage3) else 1

fn ld_evolve_input(root, bundle, approval) = ld_pubkeys_lines(ld_lines(fs_read_file(root + "/evolve/maintainers.pub"), 0)) + bundle + approval

fn ld_evolve_evaluate(root, bundle, approval) = if ld_evolve_fixpoint(root) != 1 then ctfail("lume evolve: stage2 != stage3 binary fixpoint failure\n") else ld_request(root, "levolve", ld_evolve_input(root, bundle, approval))

fn ld_evolve_propose(root, source, domain) = let path = ld_evolve_path(source, root + "/evolve/proposals/0001_math_clamp/proposal.bundle") in if fs_path_exists(path) == 1 or (source == "" and domain == "") then let result = if fs_path_exists(path) == 1 then ld_evolve_evaluate(root, fs_read_file(path), "") else ctfail("native evolve cannot read " + path + "\n") in if ld_contains_at(result, "\"gates_ok\":true", 0) == 1 then result else ld_json_fail(result) else let generated = ld_request(root, "lcli", "@cmd evolve-propose\n@part " + domain + "\n@goal " + source + "\n") in let result = ld_evolve_evaluate(root, generated + "\n", "") in if ld_contains_at(result, "\"gates_ok\":true", 0) == 1 then result else ld_json_fail(result)

fn ld_evolve_propose_args(args, source, domain) = match args
    Nil => {source: source, domain: domain}
    Cons(h, t) => if h == "--json" then ld_evolve_propose_args(t, source, domain) else if h == "--domain" then (match t
        Nil => ctfail("usage: lume_driver evolve propose [goal|proposal.bundle] [--domain <domain>]\n")
        Cons(v, r) => ld_evolve_propose_args(r, source, v)) else if slice(h, 0, 1) == "-" then ctfail("usage: lume_driver evolve propose [goal|proposal.bundle] [--domain <domain>]\n") else ld_evolve_propose_args(t, h, domain)

fn ld_evolve_apply_args(args, source, by, sig, target, apply_root) = match args
    Nil => {source: source, by: by, sig: sig, target: target, apply_root: apply_root}
    Cons(h, t) => if h == "--json" then ld_evolve_apply_args(t, source, by, sig, target, apply_root) else if h == "--by" then (match t
        Nil => ctfail("usage: lume_driver evolve apply|grow [proposal.bundle] [--by <maintainer>] [--sig <signature>] [--target <file>] [--root <dir>]\n")
        Cons(v, r) => ld_evolve_apply_args(r, source, v, sig, target, apply_root)) else if h == "--sig" then (match t
        Nil => ctfail("usage: lume_driver evolve apply|grow [proposal.bundle] [--by <maintainer>] [--sig <signature>] [--target <file>] [--root <dir>]\n")
        Cons(v, r) => ld_evolve_apply_args(r, source, by, v, target, apply_root)) else if h == "--target" then (match t
        Nil => ctfail("usage: lume_driver evolve apply|grow [proposal.bundle] [--by <maintainer>] [--sig <signature>] [--target <file>] [--root <dir>]\n")
        Cons(v, r) => ld_evolve_apply_args(r, source, by, sig, v, apply_root)) else if h == "--root" then (match t
        Nil => ctfail("usage: lume_driver evolve apply|grow [proposal.bundle] [--by <maintainer>] [--sig <signature>] [--target <file>] [--root <dir>]\n")
        Cons(v, r) => ld_evolve_apply_args(r, source, by, sig, target, v)) else if slice(h, 0, 1) == "-" then ctfail("usage: lume_driver evolve apply|grow [proposal.bundle] [--by <maintainer>] [--sig <signature>] [--target <file>] [--root <dir>]\n") else ld_evolve_apply_args(t, h, by, sig, target, apply_root)

fn ld_evolve_approval(args) = if args.sig != "" then "\n@approval signed:" + (if args.by == "" then "ricardo" else args.by) + ":" + args.sig + "\n" else if args.by != "" then "\n@approval approved:" + args.by + "\n" else ""

fn ld_evolve_has_files(lines) = match lines
    Nil => 0
    Cons(h, t) => if ld_starts(h, "@file ") == 1 then 1 else ld_evolve_has_files(t)

fn ld_evolve_target(lines) = match lines
    Nil => ""
    Cons(h, t) => if ld_starts(h, "@target ") == 1 then ld_trim(slice(h, 8, count(h))) else ld_evolve_target(t)

fn ld_evolve_candidates(root, bundle, approval, paths) = match paths
    Nil => Nil
    Cons(h, t) => Cons({path: h, candidate: ld_request(root, "levolve", "@mode apply\n@apply_file " + h + "\n" + ld_evolve_input(root, bundle, approval))}, ld_evolve_candidates(root, bundle, approval, t))

fn ld_evolve_resolve(apply_root, path) = if ld_starts(path, "/") == 1 then path else apply_root + "/" + path

fn ld_evolve_snapshots(apply_root, candidates) = match candidates
    Nil => Nil
    Cons(h, t) => let path = ld_evolve_resolve(apply_root, h.path) in let existed = fs_path_exists(path) in Cons({path: path, existed: existed, original: if existed == 1 then fs_read_file(path) else "", candidate: h.candidate}, ld_evolve_snapshots(apply_root, t))

fn ld_evolve_mkdirs(path) = if path == "" or fs_path_exists(path) == 1 then 1 else if ld_evolve_mkdirs(ld_dir(path)) == 1 then fs_mkdir(path) else 0

fn ld_evolve_prepare_dirs(files) = match files
    Nil => 1
    Cons(h, t) => if ld_evolve_mkdirs(ld_dir(h.path)) == 1 then ld_evolve_prepare_dirs(t) else 0

fn ld_evolve_write_files(files) = match files
    Nil => ""
    Cons(h, t) => if fs_write_sync(h.path, ld_ensure_nl(h.candidate)) != 1 then h.path else ld_evolve_write_files(t)

fn ld_evolve_rollback(files) = match files
    Nil => ""
    Cons(h, t) => let rest = ld_evolve_rollback(t) in let restored = if h.existed == 1 then fs_write_sync(h.path, h.original) else os_run("/bin/rm", Cons("-f", Cons(h.path, Nil))) in if (h.existed == 1 and restored != 1) or (h.existed == 0 and restored != 0) then h.path else rest

fn ld_evolve_fail(files, message) = let failed = ld_evolve_rollback(files) in ctfail(message + (if failed == "" then "All target files were rolled back.\n" else "Rollback also failed for " + failed + "; manual restoration is required.\n"))

fn ld_evolve_test_lines(lines) = match lines
    Nil => 0
    Cons(h, t) => if ld_starts(ld_trim(h), "fn test_") == 1 then 1 else ld_evolve_test_lines(t)

fn ld_evolve_run_tests(root, files) = match files
    Nil => ""
    Cons(h, t) => if ld_evolve_test_lines(ld_lines(fs_read_file(h.path), 0)) == 0 then ld_evolve_run_tests(root, t) else let output = root + "/build/lume-evolve-test.out" in let errors = root + "/build/lume-evolve-test.err" in let status = os_run_capture_timeout(ld_tool(root, "lume_driver"), Cons("test", Cons(h.path, Nil)), output, errors, 900000) in if status != 0 then h.path + ":\n" + fs_read_file(output) + fs_read_file(errors) else ld_evolve_run_tests(root, t)

fn ld_evolve_apply(root, args) = let path = ld_evolve_path(args.source, root + "/evolve/proposals/0003_decimal_clamp/proposal.bundle") in if fs_path_exists(path) == 0 then ctfail("native evolve cannot read " + path + "\n") else let bundle = fs_read_file(path) in let approval = ld_evolve_approval(args) in let result = ld_evolve_evaluate(root, bundle, approval) in if ld_contains_at(result, "\"can_merge\":true", 0) == 0 or ld_contains_at(result, "\"signature_verified\":true", 0) == 0 then ld_json_fail(result) else let apply_root = if args.apply_root == "" then root else args.apply_root in let lines = ld_lines(bundle, 0) in let candidates = if ld_evolve_has_files(lines) == 1 then let listed = ld_request(root, "levolve", "@mode list-files\n" + ld_evolve_input(root, bundle, approval)) in ld_evolve_candidates(root, bundle, approval, ld_lines(listed, 0)) else let target = if args.target != "" then args.target else ld_evolve_target(lines) in if target == "" then ctfail("lume evolve apply: proposal has no @target and --target was not specified\n") else Cons({path: target, candidate: ld_request(root, "levolve", "@mode apply\n" + ld_evolve_input(root, bundle, approval))}, Nil) in let files = ld_evolve_snapshots(apply_root, candidates) in if ld_evolve_prepare_dirs(files) == 0 then ctfail("lume evolve apply: cannot create target directories; no target files were written\n") else let failed_write = ld_evolve_write_files(files) in if failed_write != "" then ld_evolve_fail(files, "lume evolve apply: cannot write " + failed_write + "\n") else let failed_test = ld_evolve_run_tests(root, files) in if failed_test != "" then ld_evolve_fail(files, "lume evolve apply: target test suite failed after apply on " + failed_test + "\n") else result

fn ld_evolve_request(root, action, source, approval) = let path = if source == "" then root + "/evolve/proposals/0001_math_clamp/proposal.bundle" else if fs_path_exists(source + "/proposal.bundle") == 1 then source + "/proposal.bundle" else source in if fs_path_exists(path) == 0 then ctfail("native evolve cannot read " + path + "\n") else let fixpoint = if fs_path_exists(root + "/build/bootstrap/lumec2") == 1 and fs_path_exists(root + "/build/bootstrap/lumec3") == 1 then fs_files_equal(root + "/build/bootstrap/lumec2", root + "/build/bootstrap/lumec3") else 1 in if fixpoint != 1 then ctfail("lume evolve: stage2 != stage3 binary fixpoint failure\n") else let result = ld_request(root, "levolve", ld_pubkeys_lines(ld_lines(fs_read_file(root + "/evolve/maintainers.pub"), 0)) + fs_read_file(path) + approval) in if action == "approve" then (if ld_contains_at(result, "\"can_merge\":true", 0) == 1 then result else ld_json_fail(result)) else if ld_contains_at(result, "\"gates_ok\":true", 0) == 1 then result else ld_json_fail(result)

fn ld_evolve_args(args, source, by, sig) = match args
    Nil => {source: source, by: by, sig: sig}
    Cons(h, t) => if h == "--json" then ld_evolve_args(t, source, by, sig) else if h == "--by" then (match t
        Nil => ctfail("usage: lume_driver evolve verify|status|approve [proposal.bundle] [--by <maintainer>] [--sig <signature>]\n")
        Cons(v, r) => ld_evolve_args(r, source, v, sig)) else if h == "--sig" then (match t
        Nil => ctfail("usage: lume_driver evolve verify|status|approve [proposal.bundle] [--by <maintainer>] [--sig <signature>]\n")
        Cons(v, r) => ld_evolve_args(r, source, by, v)) else if slice(h, 0, 1) == "-" then ctfail("usage: lume_driver evolve verify|status|approve [proposal.bundle] [--by <maintainer>] [--sig <signature>]\n") else ld_evolve_args(t, h, by, sig)

fn ld_evolve_entry(root) = if os_arg_count() < 3 then ctfail("usage: lume_driver evolve goals|budgets|propose|apply|grow|verify|status|approve [proposal.bundle] [--by <maintainer>] [--sig <signature>]
") else let action = os_arg_at(2) in if action == "goals" then os_exit(ld_run(root, root + "/evolve/goals.src")) else if action == "budgets" then os_exit(ld_run(root, root + "/evolve/budgets.src")) else if action == "propose" then let args = ld_evolve_propose_args(ld_args_from(3), "", "") in ld_evolve_propose(root, args.source, args.domain) else if action == "apply" or action == "grow" then let args = ld_evolve_apply_args(ld_args_from(3), "", "", "", "", "") in ld_evolve_apply(root, args) else if action == "verify" or action == "status" or action == "check" then let args = ld_evolve_args(ld_args_from(3), "", "maintainer", "") in ld_evolve_request(root, "verify", args.source, "") else if action == "approve" then let args = ld_evolve_args(ld_args_from(3), "", "maintainer", "") in let approval = if args.sig == "" then "
@approval approved:" + args.by + "
" else "
@approval signed:" + args.by + ":" + args.sig + "
" in ld_evolve_request(root, "approve", args.source, approval) else ctfail("usage: lume_driver evolve goals|budgets|propose|apply|grow|verify|status|approve [proposal.bundle] [--by <maintainer>] [--sig <signature>]
")

fn ld_rfind_dot(path, i) = if i < 0 then 0 - 1 else if at(path, i) == "." then i else ld_rfind_dot(path, i - 1)

fn ld_artifacts_default(out) = let dot = ld_rfind_dot(out, count(out) - 1) in if dot < 0 then out + ".artifacts" else slice(out, 0, dot) + ".artifacts"

fn ld_economy(root, out, artifacts, self_test) = if out == "" then ctfail("lume economy: --output is required\n") else let parent = ld_dir(out) in let made = if parent == "" then 1 else fs_mkdir(parent) in let art = if artifacts == "" then ld_artifacts_default(out) else artifacts in let made_art = fs_mkdir(art) in if made != 1 or made_art != 1 then ctfail("native economy cannot create output directories\n") else let base = if parent == "" then "." else parent in ld_request(root, "leconomy", "@output " + out + "\n@artifacts " + art + "\n@base " + base + "\n@root " + root + "\n@self_test " + str(self_test) + "\n")

fn ld_economy_entry(root) = if os_arg_at(2) != "--output" then ctfail("usage: lume_driver economy --output <results.json> [--artifacts <dir>] [--self-test]\n") else if os_arg_count() == 4 then ld_economy(root, os_arg_at(3), "", 0) else if os_arg_count() == 6 and os_arg_at(4) == "--artifacts" then ld_economy(root, os_arg_at(3), os_arg_at(5), 0) else if os_arg_count() == 6 and os_arg_at(4) == "--self-test" then ld_economy(root, os_arg_at(3), "", 1) else if os_arg_count() == 7 and os_arg_at(4) == "--artifacts" and os_arg_at(6) == "--self-test" then ld_economy(root, os_arg_at(3), os_arg_at(5), 1) else if os_arg_count() == 7 and os_arg_at(4) == "--self-test" and os_arg_at(5) == "--artifacts" then ld_economy(root, os_arg_at(3), os_arg_at(6), 1) else ctfail("usage: lume_driver economy --output <results.json> [--artifacts <dir>] [--self-test]\n")

fn ld_mcp(root, source) = if fs_path_exists(source) == 0 then ctfail("native mcp cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-mcp") in ld_wait_exit(os_run(ld_tool(root, "lcaas"), Cons("@mcp-server", Cons(bundled, Cons(fs_sha256_file(bundled), Nil)))))

fn ld_mcp_entry(root) = if os_arg_count() == 3 then os_exit(ld_mcp(root, os_arg_at(2))) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then os_exit(ld_mcp(root, os_arg_at(3))) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then os_exit(ld_mcp(root, os_arg_at(2))) else ctfail("usage: lume_driver mcp [--json] <source.src>\n")

fn ld_manifest_check(root, prefix, lines, seen) = match lines
    Nil => {ok: 1, seen: seen, error: ""}
    Cons(h, t) => let line = ld_trim(h) in if line == "" then ld_manifest_check(root, prefix, t, seen) else if count(line) < 67 then {ok: 0, seen: seen, error: "invalid manifest entry"} else let start = if at(line, 66) == "*" then 67 else 66 in let relative = slice(line, start, count(line)) in let path = prefix + "/" + relative in if fs_path_exists(path) == 0 then {ok: 0, seen: seen, error: relative + " (missing)"} else if ld_hash_file(root, path) != slice(line, 0, 64) then {ok: 0, seen: seen, error: relative + " (sha256 mismatch)"} else ld_manifest_check(root, prefix, t, seen + 1)

fn ld_hash_file(root, path) = let lsha = if fs_path_exists(root + "/build/bin/lsha") == 1 then root + "/build/bin/lsha" else if fs_path_exists(root + "/bin/lsha") == 1 then root + "/bin/lsha" else "" in if lsha == "" then fs_sha256_file(path) else let tmp_dir = if fs_path_exists(root + "/build") == 1 then root + "/build" else "/tmp" in let output = tmp_dir + "/lume-driver-hash-" + str(os_getpid()) + ".out" in let errors = tmp_dir + "/lume-driver-hash-" + str(os_getpid()) + ".err" in let status = os_run_capture_timeout(lsha, Cons(path, Nil), output, errors, 900000) in let res = if status != 0 then fs_sha256_file(path) else ld_chomp(fs_read_file(output)) in let z1 = fs_remove(output) in let z2 = fs_remove(errors) in res

fn ld_self_verify(root, action, prefix) = let manifest = prefix + "/MANIFEST.sha256" in if fs_path_exists(manifest) == 0 then (if action == "status" then "{\"ok\":true,\"command\":\"self-status\",\"version\":\"0.2.0\",\"edition\":\"2026\",\"prefix\":\"" + prefix + "\",\"zero_c_required\":true,\"manifest_verified\":false,\"mode\":\"in-tree\"}" else ld_json_fail("{\"ok\":false,\"command\":\"self-verify\",\"version\":\"0.2.0\",\"prefix\":\"" + prefix + "\",\"manifest_verified\":false,\"mode\":\"in-tree\",\"error\":\"MANIFEST.sha256 not found\"}")) else let checked = ld_manifest_check(root, prefix, ld_lines(fs_read_file(manifest), 0), 0) in if checked.ok == 1 and checked.seen > 0 then "{\"ok\":true,\"command\":\"self-" + action + "\",\"version\":\"0.2.0\",\"edition\":\"2026\",\"prefix\":\"" + prefix + "\",\"zero_c_required\":true,\"manifest_verified\":true,\"verified_files\":" + str(checked.seen) + "}" else ld_json_fail("{\"ok\":false,\"command\":\"self-" + action + "\",\"version\":\"0.2.0\",\"prefix\":\"" + prefix + "\",\"manifest_verified\":false,\"error\":\"manifest verification failed: " + checked.error + "\"}"))

fn ld_self_update(root, prefix, from) = let installer = root + "/build/bin/native_installer" in let built = ld_build(root, root + "/scripts/install.src", installer) in if built != 0 then ctfail("native self-update could not build installer\n") else let input = root + "/build/lume-driver-self-update.in" in let output = root + "/build/lume-driver-self-update.out" in let errors = root + "/build/lume-driver-self-update.err" in let request = fs_write_sync(input, "@prefix " + prefix + "\n@from-local " + root + "\n@from-dir " + from + "\n") in let status = os_run_input_capture_timeout(installer, Nil, input, output, errors, 900000) in if request != 1 or status != 0 then ctfail("native self-update failed:\n" + fs_read_file(errors)) else if fs_path_exists(prefix + "/MANIFEST.sha256") == 0 then ctfail("update did not produce MANIFEST.sha256\n") else "{\"ok\":true,\"command\":\"self-update\",\"version\":\"0.2.0\",\"edition\":\"2026\",\"prefix\":\"" + prefix + "\",\"from\":\"" + from + "\",\"manifest_sha256\":\"" + fs_sha256_file(prefix + "/MANIFEST.sha256") + "\",\"manifest_verified\":true}"

fn ld_self_args(args, prefix, from) = match args
    Nil => {prefix: prefix, from: from}
    Cons(h, t) => if h == "--json" then ld_self_args(t, prefix, from) else if h == "--prefix" then (match t
        Nil => ctfail("usage: lume_driver self status|verify|update [--prefix <dir>] [--from <bin-dir>]\n")
        Cons(v, r) => ld_self_args(r, v, from)) else if h == "--from" then (match t
        Nil => ctfail("usage: lume_driver self status|verify|update [--prefix <dir>] [--from <bin-dir>]\n")
        Cons(v, r) => ld_self_args(r, prefix, v)) else ld_self_args(t, prefix, from)

fn ld_self_entry(root) = let action = if os_arg_count() == 2 then "status" else os_arg_at(2) in let args = ld_self_args(ld_args_from(3), root, root + "/build/bin") in if action == "status" or action == "verify" then ld_self_verify(root, action, args.prefix) else if action == "update" then ld_self_update(root, args.prefix, args.from) else ctfail("usage: lume_driver self status|verify|update [--prefix <dir>] [--from <bin-dir>]\n")

fn ld_bundle_grant(root, source, out, grant) = let bundled = out + ".bundled.src" in if ld_has_import(source) == 0 then let written = fs_write_sync(bundled, fs_read_file(source)) in if written != 1 then ctfail("native bundling cannot copy source\n") else bundled else let request = out + ".bundle.in" in let started = fs_write_sync(request, "@grant " + grant + "\n") in if started != 1 then ctfail("native bundling cannot initialize request\n") else let dir = ld_dir(source) in let collected = ld_collect(root, dir, request, ld_imports(source), Nil) in let entry = ld_append(request, "@entry " + ld_entry_name(source) + "\n" + fs_read_file(source) + "\n@end\n") in let errors = out + ".bundle.err" in let status = os_run_input_capture_timeout(ld_tool(root, "lmod"), Nil, request, bundled, errors, 900000) in if status != 0 then ctfail("native bundling failed:\n" + fs_read_file(errors)) else bundled

fn ld_find_sub(text, part, i) = if i + count(part) > count(text) then count(text) else if slice(text, i, i + count(part)) == part then i else ld_find_sub(text, part, i + 1)

fn ld_json_skip_ws(text, i) = if i >= count(text) then i else if at(text, i) == " " or at(text, i) == "\t" or at(text, i) == "\r" or at(text, i) == "\n" then ld_json_skip_ws(text, i + 1) else i

fn ld_json_string_end(text, i) = if i >= count(text) then i else if at(text, i) == "\"" then i else if at(text, i) == "\\" then ld_json_string_end(text, i + 2) else ld_json_string_end(text, i + 1)

fn ld_json_unescape(text, i, acc) = if i >= count(text) then {ok: 1, text: acc} else if at(text, i) != "\\" then ld_json_unescape(text, i + 1, acc + at(text, i)) else if i + 1 >= count(text) then {ok: 0, text: ""} else let escaped = at(text, i + 1) in let decoded = if escaped == "n" then "\n" else if escaped == "r" then "\r" else if escaped == "t" then "\t" else if escaped == "\\" then "\\" else if escaped == "\"" then "\"" else if escaped == "/" then "/" else "" in if decoded == "" then {ok: 0, text: ""} else ld_json_unescape(text, i + 2, acc + decoded)

fn ld_json_string_at(text, i) = let start = ld_json_skip_ws(text, i) in if start >= count(text) or at(text, start) != "\"" then {ok: 0, text: "", next: start} else let finish = ld_json_string_end(text, start + 1) in if finish >= count(text) then {ok: 0, text: "", next: finish} else let decoded = ld_json_unescape(slice(text, start + 1, finish), 0, "") in {ok: decoded.ok, text: decoded.text, next: finish + 1}

fn ld_json_field(text, key) = let marker = "\"" + key + "\":" in let found = ld_find_sub(text, marker, 0) in if found >= count(text) then {ok: 0, text: "", next: found} else ld_json_string_at(text, found + count(marker))

fn ld_json_array_items(text, i) = let start = ld_json_skip_ws(text, i) in if start >= count(text) then ctfail("native manifest contains an unterminated JSON array\n") else if at(text, start) == "]" then Nil else let item = ld_json_string_at(text, start) in if item.ok == 0 then ctfail("native manifest library arrays must contain only JSON strings\n") else let next = ld_json_skip_ws(text, item.next) in if next < count(text) and at(text, next) == "," then Cons(item.text, ld_json_array_items(text, next + 1)) else if next < count(text) and at(text, next) == "]" then Cons(item.text, Nil) else ctfail("native manifest contains an invalid library array\n")

fn ld_json_array_field(text, key) = let field_marker = "\"" + key + "\":" in let marker = field_marker + "[" in let field = ld_find_sub(text, field_marker, 0) in if field >= count(text) then Nil else let found = ld_find_sub(text, marker, 0) in if found >= count(text) then ctfail("native manifest field '" + key + "' must be a JSON array\n") else ld_json_array_items(text, found + count(marker))

fn ld_child(dir, name) = if dir == "" then name else dir + "/" + name

fn ld_manifest_path(source) = let dir = ld_dir(source) in let local = ld_child(dir, "lume.toml") in let parent = ld_child(ld_child(dir, ".."), "lume.toml") in if fs_path_exists(local) == 1 then local else if fs_path_exists(parent) == 1 then parent else ""

fn ld_manifest_config(root, source) = let path = ld_manifest_path(source) in if path == "" then {grant: "io", protect: "", links: Nil} else let metadata = ld_request(root, "lmod", "@manifest\n" + fs_read_file(path)) in let grant = ld_json_field(metadata, "capabilities") in if grant.ok == 0 then ctfail("native build cannot read manifest capabilities from " + path + "\n") else let protect = ld_json_field(metadata, "protect") in {grant: grant.text, protect: protect.text, links: ld_json_array_field(metadata, "ffi_libs")}

fn ld_rev_acc(items, acc) = match items
    Nil => acc
    Cons(h, t) => ld_rev_acc(t, Cons(h, acc))

fn ld_rev(items) = ld_rev_acc(items, Nil)

fn ld_compile_assembly(root, bundled, out, btoms) = let assembly = out + ".s" in let compile_errors = out + ".compile.err" in let compile_ms = if btoms > 0 then btoms else ld_build_timeout_ms(root, count(fs_read_file(bundled))) in let compiled = os_run_input_capture_timeout(ld_tool(root, "lumec"), Nil, bundled, assembly, compile_errors, compile_ms) in let zt = ld_timeout_check("build compiler (lumec)", compile_ms) in if compiled != 0 then ctfail("native build compiler failed:\n" + fs_read_file(compile_errors)) else assembly

fn ld_assemble(root, assembly, out, btoms) = let assemble_errors = out + ".assemble.err" in let assemble_ms = if btoms > 0 then btoms else ld_build_timeout_ms(root, count(fs_read_file(assembly))) in let zrm = if fs_path_exists(out) == 1 then fs_remove(out) else 0 in let assembled = os_run_capture_timeout(ld_tool(root, "lasm"), Cons("--strict", Cons(assembly, Nil)), out, assemble_errors, assemble_ms) in let zt = ld_timeout_check("build assembler (lasm)", assemble_ms) in if assembled != 0 then ctfail("native build assembler failed:\n" + fs_read_file(assemble_errors)) else os_run("/bin/chmod", Cons("+x", Cons(out, Nil)))

fn ld_native_target(target) = target == "" or target == "x86_64-linux-elf" or target == "linux-x86_64" or target == "x86_64-unknown-linux-gnu" or target == "x86_64-none-raw" or target == "x86_64-none-mbr"

fn ld_protect_level(level) = level == "none" or level == "standard" or level == "hardened" or level == "max"

fn ld_profile_protect(profile) = if profile == "" then "" else if profile == "release" then "standard" else if profile == "ship" then "hardened" else if profile == "debug" then "none" else ctfail("native build invalid --profile '" + profile + "' (expected debug|release|ship)\n")

fn ld_static_link(links) = match links
    Nil => 0
    Cons(h, t) => if ld_suffix(h, ".a") or ld_suffix(h, ".o") then 1 else ld_static_link(t)

fn ld_has_links(links) = match links
    Nil => 0
    Cons(_, _) => 1

fn ld_validate_build(out, target, explicit_target, protect, lsym, links, chdr) = if ld_protect_level(protect) == 0 and protect != "" then ctfail("native build invalid --protect level '" + protect + "' (expected none|standard|hardened|max)\n") else if ld_suffix(out, ".a") or ld_suffix(out, ".so") then ctfail("native build library output '.a' and '.so' is not migrated; external cc/ar archiving is not invoked\n") else if ld_static_link(links) == 1 then ctfail("native build static linking of '.a' and '.o' is not migrated; use a dynamic library or omit --link\n") else if lsym != "" and (protect == "" or protect == "none") then ctfail("native build --lsym requires --protect standard|hardened|max or an equivalent manifest/profile setting\n") else if explicit_target == 0 and ld_suffix(out, ".wasm") then ctfail("native C-export '.wasm' output is not migrated; use --target wasm32-wasi for a real WASI executable\n") else if ld_suffix(out, ".wat") and explicit_target == 1 then ctfail("native C-export WAT output does not accept --target\n") else if ld_suffix(out, ".wat") and ((protect != "" and protect != "none") or ld_has_links(links) == 1) then ctfail("native C-export WAT output does not support protection or linking\n") else if ld_native_target(target) == 0 and (chdr != "" or (protect != "" and protect != "none") or ld_has_links(links) == 1) then ctfail("native build --emit-c-header, protection, and linking currently require an x86-64 native target\n") else 0

fn ld_cexport(root, bundled) = let result = ld_request(root, "lcaas", "@mode c-export\n" + fs_read_file(bundled)) in if ld_contains_at(result, "\"ok\":true", 0) == 0 then ctfail(result + "\n") else result

fn ld_write_json_text(result, key, out) = let field = ld_json_field(result, key) in if field.ok == 0 then ctfail("native C-export response is missing '" + key + "'\n") else ld_write_target_text(out, field.text + "\n")

fn ld_maybe_header(root, bundled, chdr) = if chdr == "" then 0 else ld_write_json_text(ld_cexport(root, bundled), "c_header", chdr)

fn ld_protect_assembly(root, assembly, out, protect, lsym) = if protect == "" or protect == "none" then assembly else let sidecar = if lsym == "" then out + ".lsym" else lsym in let symbols = ld_request(root, "lprotect", "@lsym " + protect + "\n" + fs_read_file(assembly)) in let saved = fs_write_sync(sidecar, symbols + "\n") in if saved != 1 then ctfail("native build cannot write protection sidecar " + sidecar + "\n") else let transformed = ld_request(root, "lprotect", "@asm " + protect + "\n" + fs_read_file(assembly)) in let protected_assembly = out + ".protected.s" in let written = fs_write_sync(protected_assembly, transformed + "\n") in if written != 1 then ctfail("native build cannot write protected assembly\n") else protected_assembly

fn ld_need_library(lib) = if lib == "c" then "    .need \"libc.so.6\"\n" else if lib == "m" then "    .need \"libm.so.6\"\n" else if ld_contains_at(lib, ".so", 0) == 1 then "    .need \"" + ld_base(lib) + "\"\n" else "    .need \"lib" + lib + ".so\"\n"

fn ld_need_headers(links) = match links
    Nil => ""
    Cons(h, t) => ld_need_library(h) + ld_need_headers(t)

fn ld_link_assembly(assembly, out, links) = match links
    Nil => assembly
    Cons(_, _) => let linked = out + ".linked.s" in let written = fs_write_sync(linked, ld_need_headers(links) + fs_read_file(assembly)) in if written != 1 then ctfail("native build cannot write dynamic-link assembly\n") else linked

fn ld_build_native_options(root, source, out, grant, protect, lsym, links, chdr, btoms) = let bundled = ld_bundle_grant(root, source, out, grant) in let header = ld_maybe_header(root, bundled, chdr) in let assembly = ld_compile_assembly(root, bundled, out, btoms) in let protected_assembly = ld_protect_assembly(root, assembly, out, protect, lsym) in let linked = ld_link_assembly(protected_assembly, out, links) in ld_assemble(root, linked, out, btoms)

fn ld_build_wat(root, source, out, grant, chdr) = let bundled = ld_bundle_grant(root, source, out, grant) in let exported = ld_cexport(root, bundled) in let header = if chdr == "" then 0 else ld_write_json_text(exported, "c_header", chdr) in ld_write_json_text(exported, "wat", out)

fn ld_build_configured(root, source, out, target, grant, protect, lsym, links, chdr, btoms) = if ld_suffix(out, ".wat") then ld_build_wat(root, source, out, grant, chdr) else if ld_native_target(target) == 0 then let bundled = ld_bundle_grant(root, source, out, grant) in let result = ld_request(root, "ltarget", "@compile " + target + "\n" + fs_read_file(bundled)) in ld_target_output(root, out, result) else ld_build_native_options(root, source, out, grant, protect, lsym, links, chdr, btoms)

## --- incremental build orchestration (#310, docs/38): per-module AST-hash cache behind --incremental.
## The driver replicates the bundler's topological order and `use`/print stripping; anything that is not
## incrementally self-contained falls back to the whole-bundle build above (reported on stderr). ---
fn ld_ipairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => ld_ipairs2(a, t)

fn ld_ipairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, ld_ipairs(r))

fn ld_ijoin(xs) = match xs
    Nil        => ""
    Cons(a, t) => match t
        Nil        => a
        Cons(_, _) => ld_ijoin(ld_ipairs(xs))

fn ld_isnil_list(xs) = match xs
    Nil        => 1
    Cons(_, _) => 0

fn ld_isindented(raw) = if count(raw) == 0 then 0 else if at(raw, 0) == " " or at(raw, 0) == "\t" or at(raw, 0) == "\r" then 1 else 0

fn ld_istrip_lines(lines, is_lib) = match lines
    Nil        => Nil
    Cons(h, t) => let raw = ld_rtrim(h) in let tr = ld_ltrim(raw, 0) in if ld_starts(tr, "use ") == 1 then ld_istrip_lines(t, is_lib) else if is_lib == 1 and ld_isindented(h) == 0 and ld_starts(tr, "print ") == 1 then ld_istrip_lines(t, is_lib) else Cons(raw + "\n", ld_istrip_lines(t, is_lib))

fn ld_istrip_text(text, is_lib) = ld_ijoin(ld_istrip_lines(ld_lines(text, 0), is_lib))

fn ld_imod_visit(root, dir, name, visiting, visited) = if ld_member(visited, name) == 1 then {visited: visited, order: Nil} else if ld_member(visiting, name) == 1 then ctfail("lume: module error: circular module dependency involving '" + name + "'\n") else let path = ld_find_module(root, dir, name) in let sub = ld_imod_visit_uses(root, dir, ld_imports(path), Cons(name, visiting), visited) in {visited: Cons(name, sub.visited), order: Cons({name: name, path: path}, sub.order)}

fn ld_imod_visit_uses(root, dir, names, visiting, visited) = match names
    Nil        => {visited: visited, order: Nil}
    Cons(h, t) => let r1 = ld_imod_visit(root, dir, h, visiting, visited) in let r2 = ld_imod_visit_uses(root, dir, t, visiting, r1.visited) in {visited: r2.visited, order: ld_list_append(r1.order, r2.order)}

fn ld_imods(root, source) = let dir = ld_dir(source) in let entry_name = ld_entry_name(source) in let r = ld_imod_visit_uses(root, dir, ld_imports(source), Cons(entry_name, Nil), Nil) in ld_list_append(r.order, Cons({name: entry_name, path: source}, Nil))

fn ld_iprepare(root, mods, entry_name) = match mods
    Nil        => Nil
    Cons(h, t) => let is_entry = if h.name == entry_name then 1 else 0 in Cons({name: h.name, role: (if is_entry == 1 then "entry" else "lib"), path: h.path, text: ld_istrip_text(fs_read_file(h.path), if is_entry == 1 then 0 else 1)}, ld_iprepare(root, t, entry_name))

fn ld_iostr_end(s, i) = if i >= count(s) then i else if at(s, i) == "\"" then i + 1 else if at(s, i) == "\\" then ld_iostr_end(s, i + 2) else ld_iostr_end(s, i + 1)

fn ld_isidch(c) = (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_"

fn ld_previdok(s, i) = if i <= 0 then 1 else ld_isidch(at(s, i - 1)) == 0

fn ld_io_cap_at(s, i) = if i + 5 <= count(s) and slice(s, i, i + 5) == "read(" and ld_previdok(s, i) == 1 then "read" else if i + 8 <= count(s) and slice(s, i, i + 8) == "readall(" and ld_previdok(s, i) == 1 then "readall" else if i + 5 <= count(s) and slice(s, i, i + 5) == "emit(" and ld_previdok(s, i) == 1 then "emit" else if i + 6 <= count(s) and slice(s, i, i + 6) == "flush(" and ld_previdok(s, i) == 1 then "flush" else ""

fn ld_iocap_line(s, i) = if i >= count(s) then "" else let c = at(s, i) in if c == "#" then "" else if c == "\"" then ld_iocap_line(s, ld_iostr_end(s, i + 1)) else let cap = ld_io_cap_at(s, i) in if cap != "" then cap else ld_iocap_line(s, i + 1)

fn ld_iocap_lines(lines) = match lines
    Nil        => ""
    Cons(h, t) => let cap = ld_iocap_line(h, 0) in if cap != "" then cap else ld_iocap_lines(t)

fn ld_icap_audit(mods, grant) = if grant != "pure" then 0 else match mods
    Nil        => 0
    Cons(h, t) => if h.role == "lib" then let cap = ld_iocap_lines(ld_lines(fs_read_file(h.path), 0)) in if cap != "" then ctfail("lume: capability error: module '" + h.name + "' uses I/O capability '" + cap + "' not granted by lume.toml (allow = [\"pure\"])\n") else ld_icap_audit(t, grant) else ld_icap_audit(t, grant)

fn ld_ensure_nl(text) = if count(text) > 0 and at(text, count(text) - 1) == "\n" then text else text + "\n"

fn ld_ihash_stream(prepared) = match prepared
    Nil        => ""
    Cons(h, t) => "@begin " + h.name + " " + h.role + "\n" + ld_ensure_nl(h.text) + "@end-mod\n" + ld_ihash_stream(t)

fn ld_ispace(line, i) = if i >= count(line) then i else if at(line, i) == " " then i else ld_ispace(line, i + 1)

fn ld_ifieldn(line, n, i) = if n <= 0 then slice(line, i, ld_ispace(line, i)) else let e = ld_ispace(line, i) in ld_ifieldn(line, n - 1, if e >= count(line) then e else e + 1)

fn ld_ifield(line, n) = ld_ifieldn(line, n, 0)

fn ld_ihash_parse(lines) = match lines
    Nil        => Nil
    Cons(h, t) => if ld_trim(h) == "" then ld_ihash_parse(t) else Cons(h, ld_ihash_parse(t))

fn ld_ifallback_line(lines) = match lines
    Nil        => ""
    Cons(h, t) => if ld_ifield(h, 2) == "0" then ld_ifield(h, 0) + ": " + ld_ifield(h, 3) else ld_ifallback_line(t)

fn ld_ihash_of(lines, name) = match lines
    Nil        => ctfail("native incremental internal error: missing hash for module " + name + "\n")
    Cons(h, t) => if ld_ifield(h, 0) == name then ld_ifield(h, 4) else ld_ihash_of(t, name)

fn ld_ihash_run(root, stream) = let input = root + "/build/lume-inc-hash.in" in let output = root + "/build/lume-inc-hash.out" in let errors = root + "/build/lume-inc-hash.err" in let written = fs_write_sync(input, stream) in if written != 1 then ctfail("native incremental cannot write hash request\n") else let status = os_run_input_capture_timeout(ld_tool(root, "lumec"), Cons("--ast-hash", Nil), input, output, errors, 120000) in if status != 0 then ctfail("native incremental compiler failed:\n" + fs_read_file(errors)) else fs_read_file(output)

fn ld_imod_compile(root, name, role, toolchain, text, hash) = let cache = root + "/build/cache/" + name + "__" + hash + ".frag" in if fs_path_exists(cache) == 1 and ld_contains_at(fs_read_file(cache), "@toolchain " + toolchain + "\n", 0) == 1 then fs_read_file(cache) else let input = root + "/build/lume-inc-module.in" in let output = root + "/build/lume-inc-module.out" in let errors = root + "/build/lume-inc-module.err" in let written = fs_write_sync(input, ld_ensure_nl(text)) in if written != 1 then ctfail("native incremental cannot write module request\n") else let status = os_run_input_capture_timeout(ld_tool(root, "lumec"), Cons("--module", Cons(name, Cons(role, Cons(toolchain, Nil)))), input, output, errors, 120000) in if status != 0 then (if ld_contains_at(fs_read_file(errors), "lume: incremental fallback:", 0) == 1 then "" else ctfail("native incremental module compile failed for " + name + ":\n" + fs_read_file(errors))) else let fragment = fs_read_file(output) in if ld_contains_at(fragment, "@asthash " + hash + "\n", 0) == 0 then ctfail("native incremental internal error: fragment hash mismatch for module " + name + "\n") else let saved = fs_write_sync(cache, fragment) in if saved != 1 then ctfail("native incremental cannot write cache " + cache + "\n") else fragment

fn ld_ifragments(root, prepared, hashlines, toolchain) = match prepared
    Nil        => Nil
    Cons(h, t) => let hash = ld_ihash_of(hashlines, h.name) in let frag = ld_imod_compile(root, h.name, h.role, toolchain, h.text, hash) in if frag == "" then Nil else let rest = ld_ifragments(root, t, hashlines, toolchain) in Cons({name: h.name, hash: hash, text: frag}, rest)

fn ld_ilink_stream(frags) = match frags
    Nil        => ""
    Cons(h, t) => "@mod " + h.name + " " + h.hash + "\n" + ld_ensure_nl(h.text) + "@stop\n" + ld_ilink_stream(t)

fn ld_inc_fallback(root, source, out, grant, protect, lsym, links, btoms, why) = let reported = fs_write_sync("/dev/stderr", "lume build --incremental: falling back to whole-bundle build (" + why + ")\n") in ld_build_native_options(root, source, out, grant, protect, lsym, links, "", btoms)

fn ld_build_incremental(root, source, out, target, grant, protect, lsym, links, chdr, btoms) = if ld_native_target(target) == 0 then ctfail("native build --incremental currently requires a native x86-64 target\n") else if chdr != "" then ctfail("native build --incremental does not support --emit-c-header in this increment\n") else let made = fs_mkdir(root + "/build/cache") in if made != 1 then ctfail("native incremental cannot create build/cache\n") else let entry_name = ld_entry_name(source) in let mods = ld_iprepare(root, ld_imods(root, source), entry_name) in let audited = ld_icap_audit(mods, grant) in let hashout = ld_ihash_run(root, ld_ihash_stream(mods)) in let hashlines = ld_ihash_parse(ld_lines(hashout, 0)) in let fb = ld_ifallback_line(hashlines) in if fb != "" then ld_inc_fallback(root, source, out, grant, protect, lsym, links, btoms, "module " + fb) else let toolchain = fs_sha256_file(ld_tool(root, "lumec")) in let frags = ld_ifragments(root, mods, hashlines, toolchain) in if ld_isnil_list(frags) == 1 then ld_inc_fallback(root, source, out, grant, protect, lsym, links, btoms, "module declined separate compilation") else let first = ld_ilink_assemble(root, out, target, frags, protect, lsym, links, btoms) in if first.code == 3 then let healed = ld_iheal(root, first.module, mods, hashlines, toolchain) in if healed != 1 then ctfail("native incremental cache entry for module " + first.module + " is corrupt and recompilation did not heal it\n") else let frags2 = ld_ifragments(root, mods, hashlines, toolchain) in let second = ld_ilink_assemble(root, out, target, frags2, protect, lsym, links, btoms) in if second.code == 3 then ctfail("native incremental cache entry for module " + second.module + " is corrupt after recompilation\n") else second.code else first.code

fn ld_iheal(root, name, mods, hashlines, toolchain) = let hash = ld_ihash_of(hashlines, name) in let removed = fs_remove(root + "/build/cache/" + name + "__" + hash + ".frag") in let found = ld_ifind_mod(mods, name) in match found
    Nil        => 0
    Cons(m, _) => let frag = ld_imod_compile(root, m.name, m.role, toolchain, m.text, hash) in if frag == "" then 0 else 1

fn ld_ifind_mod(mods, name) = match mods
    Nil        => Nil
    Cons(h, t) => if h.name == name then Cons(h, Nil) else ld_ifind_mod(t, name)

fn ld_ilink_assemble(root, out, target, frags, protect, lsym, links, btoms) = let input = root + "/build/lume-inc-link.in" in let output = root + "/build/lume-inc-link.out" in let errors = root + "/build/lume-inc-link.err" in let stream = "@lume-link 1\n@target " + target + "\n" + ld_ilink_stream(frags) + "@end\n" in let written = fs_write_sync(input, stream) in if written != 1 then ctfail("native incremental cannot write link request\n") else let status = os_run_input_capture_timeout(ld_tool(root, "lumec"), Cons("--link", Nil), input, output, errors, 120000) in if status != 0 then let errtext = fs_read_file(errors) in if ld_contains_at(errtext, "corrupt cache entry for module ", 0) == 1 then {code: 3, module: ld_imod_name_from_err(errtext)} else ctfail("native incremental link failed:\n" + errtext) else let assembly = out + ".s" in let saved = fs_write_sync(assembly, fs_read_file(output)) in if saved != 1 then ctfail("native incremental cannot write assembly " + assembly + "\n") else let protected = ld_protect_assembly(root, assembly, out, protect, lsym) in let linked = ld_link_assembly(protected, out, links) in let assembled = ld_assemble(root, linked, out, btoms) in {code: assembled, module: ""}

fn ld_imod_name_from_err(errors) = let marker = "corrupt cache entry for module " in let start = ld_find_sub(errors, marker, 0) in if start >= count(errors) then "" else let vend = ld_line_end(errors, start + count(marker)) in slice(errors, start + count(marker), vend)

fn ld_build_usage() = "usage: lume_driver build [--incremental] [--target <triple>] [--protect [none|standard|hardened|max]] [--profile debug|release|ship] [--lsym <file>] [--link <lib>] [--emit-c-header <file.h>] [--build-timeout-ms <n>] <source.src> [-o <out>]\n"

fn ld_test_many(root, sources, overall) = match sources
    Nil => overall
    Cons(h, t) => let status = ld_test(root, h) in ld_test_many(root, t, if status == 0 then overall else 1)

fn ld_test_entry(root, sources) = match sources
    Nil => ctfail("usage: lume_driver test <source.src>...\n")
    Cons(h, t) => match t
        Nil => os_exit(ld_test(root, h))
        Cons(_, _) => os_exit(ld_test_many(root, sources, 0))

fn ld_fmt_stdout_all(root, sources) = match sources
    Nil => ""
    Cons(h, t) => if fs_path_exists(h) == 0 then ctfail("native fmt cannot read " + h + "\n") else let formatted = ld_request(root, "lfmt", fs_read_file(h)) in formatted + "\n" + ld_fmt_stdout_all(root, t)

fn ld_fmt_files(root, sources, mode, overall) = match sources
    Nil => overall
    Cons(h, t) => let status = ld_fmt(root, h, mode) in ld_fmt_files(root, t, mode, if status == 0 then overall else 1)

fn ld_fmt_args(args, sources, mode) = match args
    Nil => {sources: ld_rev(sources), mode: mode}
    Cons(h, t) => if h == "--check" or h == "--stdout" then (if mode != "" and mode != h then ctfail("native fmt --check and --stdout are mutually exclusive\n") else ld_fmt_args(t, sources, h)) else if h != "" and at(h, 0) == "-" then ctfail("usage: lume_driver fmt <source.src>... [--check|--stdout]\n") else ld_fmt_args(t, Cons(h, sources), mode)

fn ld_symbolize_entry(root) = if os_arg_count() != 4 then ctfail("usage: lume_driver symbolize <file.lsym> <symbol|id|code|0xaddr>\n") else let sidecar = os_arg_at(2) in let query = os_arg_at(3) in if fs_path_exists(sidecar) == 0 then ctfail("lume symbolize: cannot read " + sidecar + "\n") else let result = ld_request(root, "lprotect", "@symbolize " + query + "\n" + fs_read_file(sidecar)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ld_json_fail(result)

fn ld_registry_entry(root) = if fs_path_exists(ld_tool(root, "lregistry")) == 0 then ctfail("native registry tool is missing: " + ld_tool(root, "lregistry") + "\n") else os_exit(ld_wait_exit(os_run(ld_tool(root, "lregistry"), Cons("registry", ld_args_from(2)))))

fn ld_info(root) = if os_arg_count() != 2 and (os_arg_count() != 3 or os_arg_at(2) != "--json") then ctfail("usage: lume_driver --version|--help|describe|targets|build [--incremental] [--target <triple>] [--protect [level]] [--link <lib>] [--emit-c-header <file.h>] <source> [-o <out>]|run <source> [args]|test <source.src>|intent build|run|verify|status|clean <file.intent>|compile [--json] [--run] <source.src>|agent <mode> <source.src>|self status|verify|update|evolve goals|budgets|propose|apply|grow|verify|status|approve|lsp|dap [--json <source.src>|--stdio [source.src]]|repl [--json <source.src>|--kernel|--stdio]|certify|verify-cert <source>|mcp [--json] <source.src>|check <source.src> [--json]|fmt <source.src> [--check|--stdout]|pkg init|check|lock|verify|tree|manifest [dir]|registry publish|resolve|discover|doc <source.src> [--json]|prove [--diff|--share|--compositional] <source.src> [new.src]|adapt c <header.h>|mesh <request.mesh>|economy --output <results.json>\n") else let command = os_arg_at(1) in if command == "--version" or command == "version" then ld_request(root, "lcli", "@cmd version\n") else if command == "--help" or command == "-h" or command == "help" then ld_request(root, "lcli", "@cmd help\n") else if command == "describe" or command == "--describe" then ld_request(root, "lcli", "@cmd describe\n") else if command == "targets" or command == "--targets" then ld_request(root, "ltarget", "@targets-json\n") else ctfail("unknown native driver command: " + command + "\n")

fn ld_entry(root) = if os_arg_count() >= 2 and os_arg_at(1) == "build" then ld_build_entry(root) else if os_arg_count() >= 3 and os_arg_at(1) == "run" then ld_run_entry(root) else if os_arg_count() >= 2 and os_arg_at(1) == "capsule" then ld_capsule_entry(root) else if os_arg_count() >= 2 and os_arg_at(1) == "symbolize" then ld_symbolize_entry(root) else if os_arg_count() == 3 and os_arg_at(1) == "trace" then ld_agent(root, "trace", os_arg_at(2)) else if os_arg_count() == 4 and os_arg_at(1) == "diff-semver" then ld_agent_diff_semver(root, os_arg_at(2), os_arg_at(3)) else if os_arg_count() == 5 and os_arg_at(1) == "patch-fn" then ld_agent_patch_fn(root, os_arg_at(2), os_arg_at(3), os_arg_at(4)) else if os_arg_at(1) == "test" then ld_test_entry(root, ld_args_from(2)) else if os_arg_at(1) == "intent" then ld_intent_entry(root) else if os_arg_at(1) == "compile" then ld_compile_entry(root) else if os_arg_at(1) == "agent" then ld_agent_entry(root) else if os_arg_at(1) == "self" then ld_self_entry(root) else if os_arg_at(1) == "evolve" then ld_evolve_entry(root) else if os_arg_at(1) == "lsp" or os_arg_at(1) == "dap" then ld_protocol_entry(root, os_arg_at(1)) else if os_arg_at(1) == "repl" then ld_repl_entry(root) else if os_arg_at(1) == "mcp" then ld_mcp_entry(root) else if os_arg_at(1) == "certify" or os_arg_at(1) == "verify-cert" then ld_certify_entry(root) else if os_arg_at(1) == "check" then ld_check_entry(root) else if os_arg_at(1) == "fmt" then ld_fmt_entry(root) else if os_arg_at(1) == "pkg" then ld_pkg_entry(root) else if os_arg_at(1) == "registry" then ld_registry_entry(root) else if os_arg_at(1) == "doc" then ld_doc_entry(root) else if os_arg_at(1) == "prove" then ld_prove_entry(root) else if os_arg_at(1) == "adapt" then ld_adapt_entry(root) else if os_arg_at(1) == "mesh" then ld_mesh_entry(root) else if os_arg_at(1) == "economy" then ld_economy_entry(root) else ld_info(root)

print ld_entry(ld_root())
