use fs_sha256_file

fn ld_rfind_slash(path, i) = if i < 0 then 0 - 1 else if at(path, i) == "/" then i else ld_rfind_slash(path, i - 1)

fn ld_dir(path) = let slash = ld_rfind_slash(path, count(path) - 1) in if slash < 0 then "" else if slash == 0 then "/" else slice(path, 0, slash)

fn ld_base(path) = let slash = ld_rfind_slash(path, count(path) - 1) in slice(path, slash + 1, count(path))

fn ld_root() = let bin = ld_dir(os_arg_at(0)) in let parent = ld_dir(bin) in if ld_base(parent) == "build" then let root = ld_dir(parent) in if root == "" then "." else root else parent

fn ld_tool(root, name) = root + "/build/bin/" + name

fn ld_chomp(text) = if count(text) > 0 and at(text, count(text) - 1) == "\n" then slice(text, 0, count(text) - 1) else text

fn ld_request(root, tool, request) = let input = root + "/build/lume-driver.in" in let output = root + "/build/lume-driver.out" in let errors = root + "/build/lume-driver.err" in let written = fs_write_sync(input, request) in if written != 1 then ctfail("native driver cannot write tool request\n") else let status = os_run_input_capture_timeout(ld_tool(root, tool), Nil, input, output, errors, 120000) in if status != 0 then ctfail("native driver tool failed: " + tool + " status " + str(status) + "\nstdout:\n" + fs_read_file(output) + "\nstderr:\n" + fs_read_file(errors)) else ld_chomp(fs_read_file(output))

fn ld_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else ld_contains_at(text, part, i + 1)

fn ld_has_import(source) = let text = fs_read_file(source) in if slice(text, 0, 4) == "use " then 1 else ld_contains_at(text, "\nuse ", 0)

fn ld_ltrim(s, i) = if i >= count(s) then "" else if at(s, i) == " " or at(s, i) == "\t" or at(s, i) == "\r" then ld_ltrim(s, i + 1) else slice(s, i, count(s))

fn ld_rtrim(s) = if count(s) == 0 then "" else if at(s, count(s) - 1) == " " or at(s, count(s) - 1) == "\t" or at(s, count(s) - 1) == "\r" or at(s, count(s) - 1) == "\n" then ld_rtrim(slice(s, 0, count(s) - 1)) else s

fn ld_trim(s) = ld_rtrim(ld_ltrim(s, 0))

fn ld_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else ld_line_end(s, i + 1)

fn ld_lines(s, i) = if i >= count(s) then Nil else let e = ld_line_end(s, i) in Cons(slice(s, i, e), ld_lines(s, e + 1))

fn ld_starts(s, prefix) = if count(s) < count(prefix) then 0 else slice(s, 0, count(prefix)) == prefix

fn ld_delim(s, i) = if i >= count(s) then i else if at(s, i) == " " or at(s, i) == "\t" or at(s, i) == "(" then i else ld_delim(s, i + 1)

fn ld_import_line(line) = let tr = ld_trim(line) in if ld_starts(tr, "use ") == 0 then "" else let raw = ld_trim(slice(tr, 4, count(tr))) in let no_std = if ld_starts(raw, "std.") == 1 then slice(raw, 4, count(raw)) else raw in slice(no_std, 0, ld_delim(no_std, 0))

fn ld_imports(path) = ld_import_lines(ld_lines(fs_read_file(path), 0))

fn ld_import_lines(lines) = match lines
    Nil => Nil
    Cons(h, t) => let name = ld_import_line(h) in if name == "" then ld_import_lines(t) else Cons(name, ld_import_lines(t))

fn ld_member(names, name) = match names
    Nil => 0
    Cons(h, t) => if h == name then 1 else ld_member(t, name)

fn ld_find_module(root, dir, name) = let local = dir + "/" + name + ".src" in let nested = dir + "/src/" + name + ".src" in let dependency = dir + "/deps/" + name + ".src" in let shared = root + "/compiler/stage1/" + name + ".src" in if fs_path_exists(local) == 1 then local else if fs_path_exists(nested) == 1 then nested else if fs_path_exists(dependency) == 1 then dependency else if fs_path_exists(shared) == 1 then shared else ctfail("native bundling cannot resolve module: " + name + "\n")

fn ld_append(out, text) = if fs_append_sync(out, text) == 1 then 1 else ctfail("native bundling cannot append request: " + out + "\n")

fn ld_collect(root, dir, out, names, seen) = match names
    Nil => seen
    Cons(h, t) => if ld_member(seen, h) == 1 then ld_collect(root, dir, out, t, seen) else let path = ld_find_module(root, dir, h) in let written = ld_append(out, "@module " + h + "\n" + fs_read_file(path) + "\n@end\n") in let next_seen = ld_collect(root, dir, out, ld_imports(path), Cons(h, seen)) in ld_collect(root, dir, out, t, next_seen)

fn ld_entry_name(source) = let base = ld_base(source) in if count(base) > 4 and slice(base, count(base) - 4, count(base)) == ".src" then slice(base, 0, count(base) - 4) else base

fn ld_bundle_grant(root, source, out, grant) = let bundled = out + ".bundled.src" in if ld_has_import(source) == 0 then let written = fs_write_sync(bundled, fs_read_file(source)) in if written != 1 then ctfail("native bundling cannot copy source\n") else bundled else let request = out + ".bundle.in" in let started = fs_write_sync(request, "@grant " + grant + "\n") in if started != 1 then ctfail("native bundling cannot initialize request\n") else let dir = ld_dir(source) in let collected = ld_collect(root, dir, request, ld_imports(source), Cons(ld_entry_name(source), Nil)) in let entry = ld_append(request, "@entry " + ld_entry_name(source) + "\n" + fs_read_file(source) + "\n@end\n") in let errors = out + ".bundle.err" in let status = os_run_input_capture_timeout(ld_tool(root, "lmod"), Nil, request, bundled, errors, 120000) in if status != 0 then ctfail("native bundling failed:\n" + fs_read_file(errors)) else bundled

fn ld_bundle(root, source, out) = ld_bundle_grant(root, source, out, "io")

fn ld_suffix(text, suffix) = count(text) >= count(suffix) and slice(text, count(text) - count(suffix), count(text)) == suffix

fn ld_find_sub(text, part, i) = if i + count(part) > count(text) then count(text) else if slice(text, i, i + count(part)) == part then i else ld_find_sub(text, part, i + 1)

fn ld_json_skip_ws(text, i) = if i >= count(text) then i else if at(text, i) == " " or at(text, i) == "\t" or at(text, i) == "\r" or at(text, i) == "\n" then ld_json_skip_ws(text, i + 1) else i

fn ld_json_string_end(text, i) = if i >= count(text) then i else if at(text, i) == "\"" then i else if at(text, i) == "\\" then ld_json_string_end(text, i + 2) else ld_json_string_end(text, i + 1)

fn ld_json_unescape(text, i, acc) = if i >= count(text) then {ok: 1, text: acc} else if at(text, i) != "\\" then ld_json_unescape(text, i + 1, acc + at(text, i)) else if i + 1 >= count(text) then {ok: 0, text: ""} else let escaped = at(text, i + 1) in let decoded = if escaped == "n" then "\n" else if escaped == "r" then "\r" else if escaped == "t" then "\t" else if escaped == "\\" then "\\" else if escaped == "\"" then "\"" else if escaped == "/" then "/" else "" in if decoded == "" then {ok: 0, text: ""} else ld_json_unescape(text, i + 2, acc + decoded)

fn ld_json_string_at(text, i) = let start = ld_json_skip_ws(text, i) in if start >= count(text) or at(text, start) != "\"" then {ok: 0, text: "", next: start} else let finish = ld_json_string_end(text, start + 1) in if finish >= count(text) then {ok: 0, text: "", next: finish} else let decoded = ld_json_unescape(slice(text, start + 1, finish), 0, "") in {ok: decoded.ok, text: decoded.text, next: finish + 1}

fn ld_json_field(text, key) = let marker = "\"" + key + "\":" in let found = ld_find_sub(text, marker, 0) in if found >= count(text) then {ok: 0, text: "", next: found} else ld_json_string_at(text, found + count(marker))

fn ld_json_array_items(text, i) = let start = ld_json_skip_ws(text, i) in if start >= count(text) then ctfail("native manifest contains an unterminated JSON array\n") else if at(text, start) == "]" then Nil else let item = ld_json_string_at(text, start) in if item.ok == 0 then ctfail("native manifest library arrays must contain only JSON strings\n") else let next = ld_json_skip_ws(text, item.next) in if next < count(text) and at(text, next) == "," then Cons(item.text, ld_json_array_items(text, next + 1)) else if next < count(text) and at(text, next) == "]" then Cons(item.text, Nil) else ctfail("native manifest contains an invalid library array\n")

fn ld_json_array_field(text, key) = let field_marker = "\"" + key + "\":" in let marker = field_marker + "[" in let field = ld_find_sub(text, field_marker, 0) in if field >= count(text) then Nil else let found = ld_find_sub(text, marker, 0) in if found >= count(text) then ctfail("native manifest field '" + key + "' must be a JSON array\n") else ld_json_array_items(text, found + count(marker))

fn ld_child(dir, name) = if dir == "" then name else dir + "/" + name

fn ld_manifest_path(source) = let dir = ld_dir(source) in let local = ld_child(dir, "lume.toml") in let parent = ld_child(ld_child(dir, ".."), "lume.toml") in if fs_path_exists(local) == 1 then local else if fs_path_exists(parent) == 1 then parent else ""

fn ld_manifest_config(root, source) = let path = ld_manifest_path(source) in if path == "" then {grant: "io", protect: "", links: Nil} else let metadata = ld_request(root, "lmod", "@manifest\n" + fs_read_file(path)) in let grant = ld_json_field(metadata, "capabilities") in if grant.ok == 0 then ctfail("native build cannot read manifest capabilities from " + path + "\n") else let protect = ld_json_field(metadata, "protect") in {grant: grant.text, protect: protect.text, links: ld_json_array_field(metadata, "ffi_libs")}

fn ld_rev_acc(items, acc) = match items
    Nil => acc
    Cons(h, t) => ld_rev_acc(t, Cons(h, acc))

fn ld_rev(items) = ld_rev_acc(items, Nil)

fn ld_list_append(xs, ys) = match xs
    Nil => ys
    Cons(h, t) => Cons(h, ld_list_append(t, ys))

fn ld_compile_assembly(root, bundled, out) = let assembly = out + ".s" in let compile_errors = out + ".compile.err" in let compiled = os_run_input_capture_timeout(ld_tool(root, "lumec"), Nil, bundled, assembly, compile_errors, 120000) in if compiled != 0 then ctfail("native build compiler failed:\n" + fs_read_file(compile_errors)) else assembly

fn ld_assemble(root, assembly, out) = let assemble_errors = out + ".assemble.err" in let assembled = os_run_input_capture_timeout(ld_tool(root, "lasm"), Nil, assembly, out, assemble_errors, 120000) in if assembled != 0 then ctfail("native build assembler failed:\n" + fs_read_file(assemble_errors)) else os_run("/bin/chmod", Cons("+x", Cons(out, Nil)))

fn ld_build(root, source, out) = if fs_path_exists(source) == 0 then ctfail("native build cannot read " + source + "\n") else let bundled = ld_bundle(root, source, out) in let assembly = ld_compile_assembly(root, bundled, out) in ld_assemble(root, assembly, out)

fn ld_infer_target(out) = if ld_suffix(out, ".lumb") then "lumb" else if ld_suffix(out, ".ptx") then "nvptx64-nvidia-cuda" else if ld_suffix(out, ".spvasm") then "spirv64-vulkan-compute" else if ld_suffix(out, ".v") then "verilog-rtl" else if ld_suffix(out, ".vhd") then "vhdl-rtl" else if ld_suffix(out, ".cortexm") then "arm-none-cortexm" else if ld_suffix(out, ".avr.elf") then "avr-none-elf" else if ld_suffix(out, ".xtensa.elf") then "xtensa-esp32-elf" else if ld_suffix(out, ".avr.hex") or ld_suffix(out, ".avr.ihex") then "avr-none-ihex" else if ld_suffix(out, ".xtensa.hex") or ld_suffix(out, ".xtensa.ihex") then "xtensa-none-ihex" else if ld_suffix(out, ".hex") or ld_suffix(out, ".ihex") then "aarch64-none-ihex" else "x86_64-linux-elf"

fn ld_find_char(text, needle, i) = if i >= count(text) then count(text) else if at(text, i) == needle then i else ld_find_char(text, needle, i + 1)

fn ld_write_target_text(out, text) = if fs_write_sync(out, text) == 1 then 0 else ctfail("native build cannot write target artifact " + out + "\n")

fn ld_target_output(root, out, result) = if ld_starts(result, "ERR:") == 1 then ctfail(slice(result, 4, count(result)) + "\n") else if ld_starts(result, "IHEX:") == 1 then let start = ld_line_end(result, 0) in ld_write_target_text(out, slice(result, start + 1, count(result)) + "\n") else if ld_starts(result, "HEX:") == 1 then let separator = ld_find_char(result, ":", 5) in let written = fs_write_hex_file(out, slice(result, separator + 1, count(result))) in if written != 1 then ctfail("native build cannot write binary target artifact " + out + "\n") else os_run("/bin/chmod", Cons("+x", Cons(out, Nil))) else ctfail("native build received unexpected target compiler output\n")

fn ld_native_target(target) = target == "" or target == "x86_64-linux-elf" or target == "linux-x86_64" or target == "x86_64-unknown-linux-gnu" or target == "x86_64-none-raw" or target == "x86_64-none-mbr"

fn ld_protect_level(level) = level == "none" or level == "standard" or level == "hardened" or level == "max"

fn ld_profile_protect(profile) = if profile == "" then "" else if profile == "release" then "standard" else if profile == "ship" then "hardened" else if profile == "debug" then "none" else ctfail("native build invalid --profile '" + profile + "' (expected debug|release|ship)\n")

fn ld_static_link(links) = match links
    Nil => 0
    Cons(h, t) => if ld_suffix(h, ".a") or ld_suffix(h, ".o") then 1 else ld_static_link(t)

fn ld_has_links(links) = match links
    Nil => 0
    Cons(_, _) => 1

fn ld_validate_build(out, target, explicit_target, protect, lsym, links, chdr) = if ld_protect_level(protect) == 0 and protect != "" then ctfail("native build invalid --protect level '" + protect + "' (expected none|standard|hardened|max)\n") else if ld_suffix(out, ".a") or ld_suffix(out, ".so") then ctfail("native build library output '.a' and '.so' is not migrated; external cc/ar archiving is not invoked\n") else if ld_static_link(links) == 1 then ctfail("native build static linking of '.a' and '.o' is not migrated; use a dynamic library or omit --link\n") else if lsym != "" and (protect == "" or protect == "none") then ctfail("native build --lsym requires --protect standard|hardened|max or an equivalent manifest/profile setting\n") else if explicit_target == 0 and ld_suffix(out, ".wasm") then ctfail("native C-export '.wasm' output is not migrated; use --target wasm32-wasi for a real WASI executable\n") else if ld_suffix(out, ".wat") and explicit_target == 1 then ctfail("native C-export WAT output does not accept --target\n") else if ld_suffix(out, ".wat") and ((protect != "" and protect != "none") or ld_has_links(links) == 1) then ctfail("native C-export WAT output does not support protection or linking\n") else if ld_native_target(target) == 0 and (chdr != "" or (protect != "" and protect != "none") or ld_has_links(links) == 1) then ctfail("native build --emit-c-header, protection, and linking currently require an x86-64 native target\n") else 0

fn ld_cexport(root, bundled) = let result = ld_request(root, "lcaas", "@mode c-export\n" + fs_read_file(bundled)) in if ld_contains_at(result, "\"ok\":true", 0) == 0 then ctfail(result + "\n") else result

fn ld_write_json_text(result, key, out) = let field = ld_json_field(result, key) in if field.ok == 0 then ctfail("native C-export response is missing '" + key + "'\n") else ld_write_target_text(out, field.text + "\n")

fn ld_maybe_header(root, bundled, chdr) = if chdr == "" then 0 else ld_write_json_text(ld_cexport(root, bundled), "c_header", chdr)

fn ld_protect_assembly(root, assembly, out, protect, lsym) = if protect == "" or protect == "none" then assembly else let sidecar = if lsym == "" then out + ".lsym" else lsym in let symbols = ld_request(root, "lprotect", "@lsym " + protect + "\n" + fs_read_file(assembly)) in let saved = fs_write_sync(sidecar, symbols + "\n") in if saved != 1 then ctfail("native build cannot write protection sidecar " + sidecar + "\n") else let transformed = ld_request(root, "lprotect", "@asm " + protect + "\n" + fs_read_file(assembly)) in let protected_assembly = out + ".protected.s" in let written = fs_write_sync(protected_assembly, transformed + "\n") in if written != 1 then ctfail("native build cannot write protected assembly\n") else protected_assembly

fn ld_need_library(lib) = if lib == "c" then "    .need \"libc.so.6\"\n" else if lib == "m" then "    .need \"libm.so.6\"\n" else if ld_contains_at(lib, ".so", 0) == 1 then "    .need \"" + ld_base(lib) + "\"\n" else "    .need \"lib" + lib + ".so\"\n"

fn ld_need_headers(links) = match links
    Nil => ""
    Cons(h, t) => ld_need_library(h) + ld_need_headers(t)

fn ld_link_assembly(assembly, out, links) = match links
    Nil => assembly
    Cons(_, _) => let linked = out + ".linked.s" in let written = fs_write_sync(linked, ld_need_headers(links) + fs_read_file(assembly)) in if written != 1 then ctfail("native build cannot write dynamic-link assembly\n") else linked

fn ld_build_native_options(root, source, out, grant, protect, lsym, links, chdr) = let bundled = ld_bundle_grant(root, source, out, grant) in let header = ld_maybe_header(root, bundled, chdr) in let assembly = ld_compile_assembly(root, bundled, out) in let protected_assembly = ld_protect_assembly(root, assembly, out, protect, lsym) in let linked = ld_link_assembly(protected_assembly, out, links) in ld_assemble(root, linked, out)

fn ld_build_wat(root, source, out, grant, chdr) = let bundled = ld_bundle_grant(root, source, out, grant) in let exported = ld_cexport(root, bundled) in let header = if chdr == "" then 0 else ld_write_json_text(exported, "c_header", chdr) in ld_write_json_text(exported, "wat", out)

fn ld_build_configured(root, source, out, target, grant, protect, lsym, links, chdr) = if ld_suffix(out, ".wat") then ld_build_wat(root, source, out, grant, chdr) else if ld_native_target(target) == 0 then let bundled = ld_bundle_grant(root, source, out, grant) in let result = ld_request(root, "ltarget", "@compile " + target + "\n" + fs_read_file(bundled)) in ld_target_output(root, out, result) else ld_build_native_options(root, source, out, grant, protect, lsym, links, chdr)

fn ld_default_out(source) = if ld_suffix(source, ".src") then slice(source, 0, count(source) - 4) else if ld_suffix(source, ".intent") then slice(source, 0, count(source) - 7) else source + ".out"

fn ld_build_usage() = "usage: lume_driver build [--target <triple>] [--protect [none|standard|hardened|max]] [--profile debug|release|ship] [--lsym <file>] [--link <lib>] [--emit-c-header <file.h>] <source.src> [-o <out>]\n"

fn ld_build_args(args, source, out, target, protect, profile, lsym, links, chdr) = match args
    Nil => {source: source, out: out, target: target, protect: protect, profile: profile, lsym: lsym, links: ld_rev(links), chdr: chdr}
    Cons(h, t) => if h == "-o" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => ld_build_args(r, source, v, target, protect, profile, lsym, links, chdr)) else if h == "--target" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => ld_build_args(r, source, out, v, protect, profile, lsym, links, chdr)) else if ld_starts(h, "--target=") == 1 then ld_build_args(t, source, out, slice(h, 9, count(h)), protect, profile, lsym, links, chdr) else if h == "--protect" then (match t
        Nil => ld_build_args(t, source, out, target, "standard", profile, lsym, links, chdr)
        Cons(v, r) => if ld_protect_level(v) == 1 then ld_build_args(r, source, out, target, v, profile, lsym, links, chdr) else ld_build_args(t, source, out, target, "standard", profile, lsym, links, chdr)) else if ld_starts(h, "--protect=") == 1 then ld_build_args(t, source, out, target, slice(h, 10, count(h)), profile, lsym, links, chdr) else if h == "--profile" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => ld_build_args(r, source, out, target, protect, v, lsym, links, chdr)) else if ld_starts(h, "--profile=") == 1 then ld_build_args(t, source, out, target, protect, slice(h, 10, count(h)), lsym, links, chdr) else if h == "--lsym" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => ld_build_args(r, source, out, target, protect, profile, v, links, chdr)) else if ld_starts(h, "--lsym=") == 1 then ld_build_args(t, source, out, target, protect, profile, slice(h, 7, count(h)), links, chdr) else if h == "--link" or h == "-l" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => if v == "" then ctfail("native build --link requires a nonempty library\n") else ld_build_args(r, source, out, target, protect, profile, lsym, Cons(v, links), chdr)) else if ld_starts(h, "--link=") == 1 then (if count(h) == 7 then ctfail("native build --link requires a nonempty library\n") else ld_build_args(t, source, out, target, protect, profile, lsym, Cons(slice(h, 7, count(h)), links), chdr)) else if ld_starts(h, "-l") == 1 and count(h) > 2 then ld_build_args(t, source, out, target, protect, profile, lsym, Cons(slice(h, 2, count(h)), links), chdr) else if h == "--emit-c-header" then (match t
        Nil => ctfail(ld_build_usage())
        Cons(v, r) => ld_build_args(r, source, out, target, protect, profile, lsym, links, v)) else if ld_starts(h, "--emit-c-header=") == 1 then ld_build_args(t, source, out, target, protect, profile, lsym, links, slice(h, 16, count(h))) else if h != "" and at(h, 0) == "-" then ctfail(ld_build_usage()) else if source != "" then ctfail("native build accepts exactly one source file\n") else ld_build_args(t, h, out, target, protect, profile, lsym, links, chdr)

fn ld_build_entry(root) = let args = ld_build_args(ld_args_from(2), "", "", "", "", "", "", Nil, "") in if args.source == "" then ctfail(ld_build_usage()) else if fs_path_exists(args.source) == 0 then ctfail("native build cannot read " + args.source + "\n") else let out = if args.out == "" then ld_default_out(args.source) else args.out in let target = if args.target == "" then ld_infer_target(out) else args.target in let manifest = ld_manifest_config(root, args.source) in let profile_protect = ld_profile_protect(args.profile) in let selected_protect = if args.protect != "" then args.protect else if profile_protect != "" then profile_protect else manifest.protect in let links = ld_list_append(args.links, manifest.links) in let valid = ld_validate_build(out, target, if args.target == "" then 0 else 1, selected_protect, args.lsym, links, args.chdr) in os_exit(ld_build_configured(root, args.source, out, target, manifest.grant, selected_protect, args.lsym, links, args.chdr))

fn ld_args_from(i) = if i >= os_arg_count() then Nil else Cons(os_arg_at(i), ld_args_from(i + 1))

fn ld_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128

fn ld_run(root, source) = let binary = root + "/build/lume-driver-run" in let built = ld_build(root, source, binary) in if built != 0 then built else ld_wait_exit(os_run(binary, ld_args_from(3)))

fn ld_test(root, source) = if fs_path_exists(source) == 0 then ctfail("native test cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-test") in let generated = ld_request(root, "ltest", fs_read_file(bundled)) in let harness = root + "/build/lume-driver-test-harness.src" in let written = fs_write_sync(harness, generated + "\n") in if written != 1 then ctfail("native test cannot write generated harness\n") else let binary = root + "/build/lume-driver-test-bin" in let built = ld_build(root, harness, binary) in if built != 0 then built else ld_wait_exit(os_run(binary, Nil))

fn ld_test_many(root, sources, overall) = match sources
    Nil => overall
    Cons(h, t) => let status = ld_test(root, h) in ld_test_many(root, t, if status == 0 then overall else 1)

fn ld_test_entry(root, sources) = match sources
    Nil => ctfail("usage: lume_driver test <source.src>...\n")
    Cons(h, t) => match t
        Nil => os_exit(ld_test(root, h))
        Cons(_, _) => os_exit(ld_test_many(root, sources, 0))

fn ld_certify(root, source) = if fs_path_exists(source) == 0 then ctfail("native certify cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-certify") in let result = ld_request(root, "lcaas", "@mode certify\n@sha256 " + fs_sha256_file(bundled) + "\n" + fs_read_file(bundled)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ctfail(result + "\n")

fn ld_verify_cert(root, source) = if fs_path_exists(source) == 0 then ctfail("native verify-cert cannot read " + source + "\n") else let result = ld_request(root, "lcert", fs_read_file(source)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ctfail(result + "\n")

fn ld_certify_entry(root) = if os_arg_count() != 3 then ctfail("usage: lume_driver certify|verify-cert <source.src|certificate.json>\n") else if os_arg_at(1) == "certify" then ld_certify(root, os_arg_at(2)) else if os_arg_at(1) == "verify-cert" then ld_verify_cert(root, os_arg_at(2)) else ld_info(root)

fn ld_check(root, source, json) = if fs_path_exists(source) == 0 then ctfail("native check cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-check") in let result = ld_request(root, "lcaas", fs_read_file(bundled)) in if ld_contains_at(result, "\"ok\":false", 0) == 1 then ctfail(result + "\n") else if json == 1 then os_exit(0) else let reported = fs_write_sync("/dev/stderr", source + ": OK (Lume-Core parsed and checked)\n") in os_exit(0)

fn ld_check_entry(root) = if os_arg_count() == 3 then ld_check(root, os_arg_at(2), 0) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_check(root, os_arg_at(3), 1) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_check(root, os_arg_at(2), 1) else ctfail("usage: lume_driver check <source.src> [--json]\n")

fn ld_fmt(root, source, mode) = if fs_path_exists(source) == 0 then ctfail("native fmt cannot read " + source + "\n") else let formatted = ld_request(root, "lfmt", fs_read_file(source)) in let generated = formatted + "\n" in if mode == "--check" then (if fs_read_file(source) == generated then 0 else let reported = fs_write_sync("/dev/stderr", "lume fmt: " + source + " is not canonically formatted\n") in 1) else let written = fs_write_sync(source, generated) in if written != 1 then ctfail("native fmt cannot rewrite " + source + "\n") else 0

fn ld_fmt_stdout_all(root, sources) = match sources
    Nil => ""
    Cons(h, t) => if fs_path_exists(h) == 0 then ctfail("native fmt cannot read " + h + "\n") else let formatted = ld_request(root, "lfmt", fs_read_file(h)) in formatted + "\n" + ld_fmt_stdout_all(root, t)

fn ld_fmt_files(root, sources, mode, overall) = match sources
    Nil => overall
    Cons(h, t) => let status = ld_fmt(root, h, mode) in ld_fmt_files(root, t, mode, if status == 0 then overall else 1)

fn ld_fmt_args(args, sources, mode) = match args
    Nil => {sources: ld_rev(sources), mode: mode}
    Cons(h, t) => if h == "--check" or h == "--stdout" then (if mode != "" and mode != h then ctfail("native fmt --check and --stdout are mutually exclusive\n") else ld_fmt_args(t, sources, h)) else if h != "" and at(h, 0) == "-" then ctfail("usage: lume_driver fmt <source.src>... [--check|--stdout]\n") else ld_fmt_args(t, Cons(h, sources), mode)

fn ld_fmt_entry(root) = let args = ld_fmt_args(ld_args_from(2), Nil, "") in if ld_has_links(args.sources) == 0 then ctfail("usage: lume_driver fmt <source.src>... [--check|--stdout]\n") else if args.mode == "--stdout" then let written = fs_write_sync("/dev/stdout", ld_fmt_stdout_all(root, args.sources)) in if written != 1 then ctfail("native fmt cannot write formatted output\n") else os_exit(0) else os_exit(ld_fmt_files(root, args.sources, args.mode, 0))

fn ld_line_count_at(text, i) = if i >= count(text) then 0 else (if at(text, i) == "\n" then 1 else 0) + ld_line_count_at(text, i + 1)

fn ld_compile_json(root, exit_code, asm_lines, ran, run_exit, diag, stdout) = ld_request(root, "lcli", "@cmd compile-json\n@exit " + str(exit_code) + "\n@asm_lines " + str(asm_lines) + "\n@ran " + str(ran) + "\n@run_exit " + str(run_exit) + "\n@diag\n" + diag + "\n@end\n@stdout\n" + stdout + "\n@end\n")

fn ld_compile_run(root, assembly, binary) = let assemble_errors = binary + ".assemble.err" in let assembled = os_run_input_capture_timeout(ld_tool(root, "lasm"), Nil, assembly, binary, assemble_errors, 120000) in if assembled != 0 then ctfail("native compile assembler failed:\n" + fs_read_file(assemble_errors)) else let changed = os_run("/bin/chmod", Cons("+x", Cons(binary, Nil))) in if changed != 0 then ctfail("native compile cannot mark artifact executable\n") else let output = binary + ".out" in let errors = binary + ".err" in let executed = os_run_capture_timeout(binary, Nil, output, errors, 120000) in {ran: 1, run_exit: ld_wait_exit(executed), stdout: fs_read_file(output)}

fn ld_compile_report(root, source, assembly) = let reported = fs_write_sync("/dev/stderr", "lume compile: " + source + " OK (" + str(ld_line_count_at(fs_read_file(assembly), 0)) + " asm lines)\n") in ld_chomp(fs_read_file(assembly))

fn ld_compile_result(root, source, json, execute, compiled, assembly, diag) = let exit_code = ld_wait_exit(compiled) in let asm_lines = ld_line_count_at(fs_read_file(assembly), 0) in if compiled != 0 then (if json == 1 then let response = ld_compile_json(root, exit_code, asm_lines, 0, 0, fs_read_file(diag), "") in let reported = fs_write_sync("/dev/stdout", response + "\n") in os_exit(exit_code) else ctfail(fs_read_file(diag))) else let binary = root + "/build/lume-driver-compile-bin" in let outcome = if execute == 1 then ld_compile_run(root, assembly, binary) else {ran: 0, run_exit: 0, stdout: ""} in if json == 1 then ld_compile_json(root, 0, asm_lines, outcome.ran, outcome.run_exit, fs_read_file(diag), outcome.stdout) else ld_compile_report(root, source, assembly)

fn ld_compile(root, source, json, execute) = if fs_path_exists(source) == 0 then ctfail("native compile cannot read " + source + "\n") else if count(source) < 5 or slice(source, count(source) - 4, count(source)) != ".src" then ctfail("native compile expects a .src Lume-Core file\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-compile") in let checked = ld_request(root, "lcaas", fs_read_file(bundled)) in if ld_contains_at(checked, "\"ok\":false", 0) == 1 then (if json == 1 then let reported = fs_write_sync("/dev/stdout", checked + "\n") in os_exit(1) else ctfail(checked + "\n")) else let assembly = root + "/build/lume-driver-compile.s" in let diag = root + "/build/lume-driver-compile.diag" in let compiled = os_run_input_capture_timeout(ld_tool(root, "lumec"), Nil, bundled, assembly, diag, 120000) in ld_compile_result(root, source, json, execute, compiled, assembly, diag)

fn ld_compile_args(args, source, json, execute) = match args
    Nil => {source: source, json: json, execute: execute}
    Cons(h, t) => if h == "--json" then ld_compile_args(t, source, 1, execute) else if h == "--run" then ld_compile_args(t, source, json, 1) else if slice(h, 0, 1) == "-" then ctfail("usage: lume_driver compile [--json] [--run] <source.src>\n") else ld_compile_args(t, h, json, execute)

fn ld_compile_entry(root) = let args = ld_compile_args(ld_args_from(2), "", 0, 0) in if args.source == "" then ctfail("usage: lume_driver compile [--json] [--run] <source.src>\n") else ld_compile(root, args.source, args.json, args.execute)

fn ld_agent_direct(mode) = if mode == "check" or mode == "compile" or mode == "prove" or mode == "ast" or mode == "expand" or mode == "symbols" or mode == "eval" then 1 else 0

fn ld_agent_query(mode) = if mode == "witness" or mode == "repair" or mode == "impact" or mode == "hashes" or mode == "grammar" or mode == "project" then 1 else 0

fn ld_agent(root, mode, source) = if ld_agent_direct(mode) == 0 and ld_agent_query(mode) == 0 then ctfail("usage: lume_driver agent check|compile|prove|ast|expand|symbols|eval|witness|repair|impact|hashes|grammar|project <source.src>\n") else if fs_path_exists(source) == 0 then ctfail("native agent cannot read " + source + "\n") else let prefix = if ld_agent_query(mode) == 1 then "@mode " + mode + "\n" else "" in let result = ld_request(root, "lcaas", prefix + fs_read_file(source)) in if ld_contains_at(result, "\"ok\":false", 0) == 1 then ctfail(result + "\n") else result

fn ld_agent_entry(root) = if os_arg_count() == 4 then ld_agent(root, os_arg_at(2), os_arg_at(3)) else ctfail("usage: lume_driver agent <mode> <source.src>\n")

fn ld_intent_input(source, cache) = let text = fs_read_file(source) in if fs_path_exists(cache) == 1 then text + "\n@split\n" + fs_read_file(cache) else text

fn ld_intent_build(root, source, cache) = let checked = ld_request(root, "lcaas", "@mode intent-build\n" + ld_intent_input(source, cache)) in if ld_contains_at(checked, "\"ok\":true", 0) == 0 then ctfail(checked + "\n") else let generated = ld_request(root, "lcaas", "@mode intent-code\n" + ld_intent_input(source, cache)) in let written = fs_write_sync(cache, generated + "\n") in if written != 1 then ctfail("native intent cannot write cache " + cache + "\n") else checked

fn ld_intent_verify(root, source, cache) = let result = ld_request(root, "lcaas", "@mode intent-verify\n" + ld_intent_input(source, cache)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ctfail(result + "\n")

fn ld_intent(root, action, source, cache) = if fs_path_exists(source) == 0 then ctfail("native intent cannot read " + source + "\n") else let target = if cache == "" then source + ".cache.src" else cache in if action == "build" then ld_intent_build(root, source, target) else if action == "verify" then ld_intent_verify(root, source, target) else ctfail("usage: lume_driver intent build|verify <file.intent> [--cache <cache.src>]\n")

fn ld_intent_entry(root) = if os_arg_count() == 4 then ld_intent(root, os_arg_at(2), os_arg_at(3), "") else if os_arg_count() == 6 and os_arg_at(4) == "--cache" then ld_intent(root, os_arg_at(2), os_arg_at(3), os_arg_at(5)) else ctfail("usage: lume_driver intent build|verify <file.intent> [--cache <cache.src>]\n")

fn ld_mesh(root, source) = if fs_path_exists(source) == 0 then ctfail("native mesh cannot read " + source + "\n") else let result = ld_request(root, "lmesh", fs_read_file(source)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ctfail(result + "\n")

fn ld_mesh_entry(root) = if os_arg_count() == 3 then ld_mesh(root, os_arg_at(2)) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_mesh(root, os_arg_at(3)) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_mesh(root, os_arg_at(2)) else ctfail("usage: lume_driver mesh <request.mesh> [--json]\n")

fn ld_adapt(root, source, json, out) = if fs_path_exists(source) == 0 then ctfail("native adapt cannot read " + source + "\n") else if json == 1 and out != "" then ctfail("lume adapt: --json and --output are mutually exclusive\n") else let checked = ld_request(root, "lcaas", "@mode bind\n" + fs_read_file(source)) in if ld_contains_at(checked, "\"ok\":true", 0) == 0 then ctfail(checked + "\n") else if json == 1 then checked else let generated = ld_request(root, "lcaas", "@mode bind-source\n" + fs_read_file(source)) in if out == "" then generated else let written = fs_write_sync(out, generated) in if written != 1 then ctfail("native adapt cannot write " + out + "\n") else os_exit(0)

fn ld_adapt_entry(root) = if os_arg_at(2) != "c" then ctfail("usage: lume_driver adapt c <header.h> [--json] [-o <out.src>]\n") else if os_arg_count() == 4 then ld_adapt(root, os_arg_at(3), 0, "") else if os_arg_count() == 5 and os_arg_at(3) == "--json" then ld_adapt(root, os_arg_at(4), 1, "") else if os_arg_count() == 5 and os_arg_at(4) == "--json" then ld_adapt(root, os_arg_at(3), 1, "") else if os_arg_count() == 6 and (os_arg_at(3) == "-o" or os_arg_at(3) == "--output") then ld_adapt(root, os_arg_at(5), 0, os_arg_at(4)) else if os_arg_count() == 6 and (os_arg_at(4) == "-o" or os_arg_at(4) == "--output") then ld_adapt(root, os_arg_at(3), 0, os_arg_at(5)) else ctfail("usage: lume_driver adapt c <header.h> [--json] [-o <out.src>]\n")

fn ld_prove(root, source) = if fs_path_exists(source) == 0 then ctfail("native prove cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-prove") in let result = ld_request(root, "lcaas", fs_read_file(bundled)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ctfail(result + "\n")

fn ld_prove_entry(root) = if os_arg_count() == 3 then ld_prove(root, os_arg_at(2)) else ctfail("usage: lume_driver prove <source.src>\n")

fn ld_doc(root, source, json) = if fs_path_exists(source) == 0 then ctfail("native doc cannot read " + source + "\n") else ld_request(root, "ldoc", (if json == 1 then "@json\n" else "") + fs_read_file(source))

fn ld_doc_entry(root) = if os_arg_count() == 3 then ld_doc(root, os_arg_at(2), 0) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_doc(root, os_arg_at(3), 1) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_doc(root, os_arg_at(2), 1) else ctfail("usage: lume_driver doc <source.src> [--json]\n")

fn ld_pkg(root, action, dir) = if action != "check" and action != "manifest" then ctfail("usage: lume_driver pkg check [dir]\n") else let manifest = dir + "/lume.toml" in if fs_path_exists(manifest) == 0 then ctfail("lume pkg: missing " + manifest + "\n") else ld_request(root, "lmod", "@manifest\n" + fs_read_file(manifest))

fn ld_pkg_entry(root) = if os_arg_count() == 3 then ld_pkg(root, os_arg_at(2), ".") else if os_arg_count() == 4 then ld_pkg(root, os_arg_at(2), os_arg_at(3)) else ctfail("usage: lume_driver pkg check [dir]\n")

fn ld_rfind_dot(path, i) = if i < 0 then 0 - 1 else if at(path, i) == "." then i else ld_rfind_dot(path, i - 1)

fn ld_artifacts_default(out) = let dot = ld_rfind_dot(out, count(out) - 1) in if dot < 0 then out + ".artifacts" else slice(out, 0, dot) + ".artifacts"

fn ld_economy(root, out, artifacts, self_test) = if out == "" then ctfail("lume economy: --output is required\n") else let parent = ld_dir(out) in let made = if parent == "" then 1 else fs_mkdir(parent) in let art = if artifacts == "" then ld_artifacts_default(out) else artifacts in let made_art = fs_mkdir(art) in if made != 1 or made_art != 1 then ctfail("native economy cannot create output directories\n") else let base = if parent == "" then "." else parent in ld_request(root, "leconomy", "@output " + out + "\n@artifacts " + art + "\n@base " + base + "\n@root " + root + "\n@self_test " + str(self_test) + "\n")

fn ld_economy_entry(root) = if os_arg_at(2) != "--output" then ctfail("usage: lume_driver economy --output <results.json> [--artifacts <dir>] [--self-test]\n") else if os_arg_count() == 4 then ld_economy(root, os_arg_at(3), "", 0) else if os_arg_count() == 6 and os_arg_at(4) == "--artifacts" then ld_economy(root, os_arg_at(3), os_arg_at(5), 0) else if os_arg_count() == 6 and os_arg_at(4) == "--self-test" then ld_economy(root, os_arg_at(3), "", 1) else if os_arg_count() == 7 and os_arg_at(4) == "--artifacts" and os_arg_at(6) == "--self-test" then ld_economy(root, os_arg_at(3), os_arg_at(5), 1) else if os_arg_count() == 7 and os_arg_at(4) == "--self-test" and os_arg_at(5) == "--artifacts" then ld_economy(root, os_arg_at(3), os_arg_at(6), 1) else ctfail("usage: lume_driver economy --output <results.json> [--artifacts <dir>] [--self-test]\n")

fn ld_info(root) = if os_arg_count() != 2 then ctfail("usage: lume_driver --version|--help|describe|targets|build [--target <triple>] [--protect [level]] [--link <lib>] [--emit-c-header <file.h>] <source> [-o <out>]|run <source> [args]|test <source.src>...|intent build|verify <file.intent>|compile [--json] [--run] <source.src>|agent <mode> <source.src>|certify|verify-cert <source>|check <source.src> [--json]|fmt <source.src>... [--check|--stdout]|pkg check [dir]|doc <source.src> [--json]|prove <source.src>|adapt c <header.h>|mesh <request.mesh>|economy --output <results.json>\n") else let command = os_arg_at(1) in if command == "--version" or command == "version" then ld_request(root, "lcli", "@cmd version\n") else if command == "--help" or command == "-h" or command == "help" then ld_request(root, "lcli", "@cmd help\n") else if command == "describe" or command == "--describe" then ld_request(root, "lcli", "@cmd describe\n") else if command == "targets" or command == "--targets" then ld_request(root, "ltarget", "@targets-json\n") else ctfail("unknown native driver command: " + command + "\n")

fn ld_entry(root) = if os_arg_count() >= 2 and os_arg_at(1) == "build" then ld_build_entry(root) else if os_arg_count() >= 3 and os_arg_at(1) == "run" then os_exit(ld_run(root, os_arg_at(2))) else if os_arg_at(1) == "test" then ld_test_entry(root, ld_args_from(2)) else if os_arg_at(1) == "intent" then ld_intent_entry(root) else if os_arg_at(1) == "compile" then ld_compile_entry(root) else if os_arg_at(1) == "agent" then ld_agent_entry(root) else if os_arg_at(1) == "certify" or os_arg_at(1) == "verify-cert" then ld_certify_entry(root) else if os_arg_at(1) == "check" then ld_check_entry(root) else if os_arg_at(1) == "fmt" then ld_fmt_entry(root) else if os_arg_at(1) == "pkg" then ld_pkg_entry(root) else if os_arg_at(1) == "doc" then ld_doc_entry(root) else if os_arg_at(1) == "prove" then ld_prove_entry(root) else if os_arg_at(1) == "adapt" then ld_adapt_entry(root) else if os_arg_at(1) == "mesh" then ld_mesh_entry(root) else if os_arg_at(1) == "economy" then ld_economy_entry(root) else ld_info(root)

print ld_entry(ld_root())
