use fs_sha256_file

fn ld_rfind_slash(path, i) = if i < 0 then 0 - 1 else if at(path, i) == "/" then i else ld_rfind_slash(path, i - 1)

fn ld_dir(path) = let slash = ld_rfind_slash(path, count(path) - 1) in if slash < 0 then "" else if slash == 0 then "/" else slice(path, 0, slash)

fn ld_base(path) = let slash = ld_rfind_slash(path, count(path) - 1) in slice(path, slash + 1, count(path))

fn ld_root() = let bin = ld_dir(os_arg_at(0)) in let parent = ld_dir(bin) in if ld_base(parent) == "build" then let root = ld_dir(parent) in if root == "" then "." else root else parent

fn ld_tool(root, name) = root + "/build/bin/" + name

fn ld_chomp(text) = if count(text) > 0 and at(text, count(text) - 1) == "\n" then slice(text, 0, count(text) - 1) else text

fn ld_request(root, tool, request) = let input = root + "/build/lume-driver.in" in let output = root + "/build/lume-driver.out" in let errors = root + "/build/lume-driver.err" in let written = fs_write_sync(input, request) in if written != 1 then ctfail("native driver cannot write tool request\n") else let status = os_run_input_capture_timeout(ld_tool(root, tool), Nil, input, output, errors, 120000) in if status != 0 then ctfail("native driver tool failed: " + tool + " status " + str(status) + "\nstdout:\n" + fs_read_file(output) + "\nstderr:\n" + fs_read_file(errors)) else ld_chomp(fs_read_file(output))

fn ld_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else ld_contains_at(text, part, i + 1)

fn ld_has_import(source) = let text = fs_read_file(source) in if slice(text, 0, 4) == "use " then 1 else ld_contains_at(text, "\nuse ", 0)

fn ld_ltrim(s, i) = if i >= count(s) then "" else if at(s, i) == " " or at(s, i) == "\t" or at(s, i) == "\r" then ld_ltrim(s, i + 1) else slice(s, i, count(s))

fn ld_rtrim(s) = if count(s) == 0 then "" else if at(s, count(s) - 1) == " " or at(s, count(s) - 1) == "\t" or at(s, count(s) - 1) == "\r" or at(s, count(s) - 1) == "\n" then ld_rtrim(slice(s, 0, count(s) - 1)) else s

fn ld_trim(s) = ld_rtrim(ld_ltrim(s, 0))

fn ld_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else ld_line_end(s, i + 1)

fn ld_lines(s, i) = if i >= count(s) then Nil else let e = ld_line_end(s, i) in Cons(slice(s, i, e), ld_lines(s, e + 1))

fn ld_starts(s, prefix) = if count(s) < count(prefix) then 0 else slice(s, 0, count(prefix)) == prefix

fn ld_delim(s, i) = if i >= count(s) then i else if at(s, i) == " " or at(s, i) == "\t" or at(s, i) == "(" then i else ld_delim(s, i + 1)

fn ld_import_line(line) = let tr = ld_trim(line) in if ld_starts(tr, "use ") == 0 then "" else let raw = ld_trim(slice(tr, 4, count(tr))) in let no_std = if ld_starts(raw, "std.") == 1 then slice(raw, 4, count(raw)) else raw in slice(no_std, 0, ld_delim(no_std, 0))

fn ld_imports(path) = ld_import_lines(ld_lines(fs_read_file(path), 0))

fn ld_import_lines(lines) = match lines
    Nil => Nil
    Cons(h, t) => let name = ld_import_line(h) in if name == "" then ld_import_lines(t) else Cons(name, ld_import_lines(t))

fn ld_member(names, name) = match names
    Nil => 0
    Cons(h, t) => if h == name then 1 else ld_member(t, name)

fn ld_find_module(root, dir, name) = let local = dir + "/" + name + ".src" in let nested = dir + "/src/" + name + ".src" in let dependency = dir + "/deps/" + name + ".src" in let shared = root + "/compiler/stage1/" + name + ".src" in if fs_path_exists(local) == 1 then local else if fs_path_exists(nested) == 1 then nested else if fs_path_exists(dependency) == 1 then dependency else if fs_path_exists(shared) == 1 then shared else ctfail("native bundling cannot resolve module: " + name + "\n")

fn ld_append(out, text) = if fs_append_sync(out, text) == 1 then 1 else ctfail("native bundling cannot append request: " + out + "\n")

fn ld_collect(root, dir, out, names, seen) = match names
    Nil => seen
    Cons(h, t) => if ld_member(seen, h) == 1 then ld_collect(root, dir, out, t, seen) else let path = ld_find_module(root, dir, h) in let written = ld_append(out, "@module " + h + "\n" + fs_read_file(path) + "\n@end\n") in let next_seen = ld_collect(root, dir, out, ld_imports(path), Cons(h, seen)) in ld_collect(root, dir, out, t, next_seen)

fn ld_entry_name(source) = let base = ld_base(source) in if count(base) > 4 and slice(base, count(base) - 4, count(base)) == ".src" then slice(base, 0, count(base) - 4) else base

fn ld_bundle(root, source, out) = let bundled = out + ".bundled.src" in if ld_has_import(source) == 0 then let written = fs_write_sync(bundled, fs_read_file(source)) in if written != 1 then ctfail("native bundling cannot copy source\n") else bundled else let request = out + ".bundle.in" in let started = fs_write_sync(request, "@grant io\n") in if started != 1 then ctfail("native bundling cannot initialize request\n") else let dir = ld_dir(source) in let collected = ld_collect(root, dir, request, ld_imports(source), Cons(ld_entry_name(source), Nil)) in let entry = ld_append(request, "@entry " + ld_entry_name(source) + "\n" + fs_read_file(source) + "\n@end\n") in let errors = out + ".bundle.err" in let status = os_run_input_capture_timeout(ld_tool(root, "lmod"), Nil, request, bundled, errors, 120000) in if status != 0 then ctfail("native bundling failed:\n" + fs_read_file(errors)) else bundled

fn ld_build(root, source, out) = if fs_path_exists(source) == 0 then ctfail("native build cannot read " + source + "\n") else let bundled = ld_bundle(root, source, out) in let assembly = out + ".s" in let compile_errors = out + ".compile.err" in let compiled = os_run_input_capture_timeout(ld_tool(root, "lumec"), Nil, bundled, assembly, compile_errors, 120000) in if compiled != 0 then ctfail("native build compiler failed:\n" + fs_read_file(compile_errors)) else let assemble_errors = out + ".assemble.err" in let assembled = os_run_input_capture_timeout(ld_tool(root, "lasm"), Nil, assembly, out, assemble_errors, 120000) in if assembled != 0 then ctfail("native build assembler failed:\n" + fs_read_file(assemble_errors)) else os_run("/bin/chmod", Cons("+x", Cons(out, Nil)))

fn ld_suffix(text, suffix) = count(text) >= count(suffix) and slice(text, count(text) - count(suffix), count(text)) == suffix

fn ld_infer_target(out) = if ld_suffix(out, ".lumb") then "lumb" else if ld_suffix(out, ".ptx") then "nvptx64-nvidia-cuda" else if ld_suffix(out, ".spvasm") then "spirv64-vulkan-compute" else if ld_suffix(out, ".v") then "verilog-rtl" else if ld_suffix(out, ".vhd") then "vhdl-rtl" else if ld_suffix(out, ".cortexm") then "arm-none-cortexm" else if ld_suffix(out, ".avr.elf") then "avr-none-elf" else if ld_suffix(out, ".xtensa.elf") then "xtensa-esp32-elf" else if ld_suffix(out, ".avr.hex") or ld_suffix(out, ".avr.ihex") then "avr-none-ihex" else if ld_suffix(out, ".xtensa.hex") or ld_suffix(out, ".xtensa.ihex") then "xtensa-none-ihex" else if ld_suffix(out, ".hex") or ld_suffix(out, ".ihex") then "aarch64-none-ihex" else "x86_64-linux-elf"

fn ld_find_char(text, needle, i) = if i >= count(text) then count(text) else if at(text, i) == needle then i else ld_find_char(text, needle, i + 1)

fn ld_write_target_text(out, text) = if fs_write_sync(out, text) == 1 then 0 else ctfail("native build cannot write target artifact " + out + "\n")

fn ld_target_output(root, out, result) = if ld_starts(result, "ERR:") == 1 then ctfail(slice(result, 4, count(result)) + "\n") else if ld_starts(result, "IHEX:") == 1 then let start = ld_line_end(result, 0) in ld_write_target_text(out, slice(result, start + 1, count(result)) + "\n") else if ld_starts(result, "HEX:") == 1 then let separator = ld_find_char(result, ":", 5) in let written = fs_write_hex_file(out, slice(result, separator + 1, count(result))) in if written != 1 then ctfail("native build cannot write binary target artifact " + out + "\n") else os_run("/bin/chmod", Cons("+x", Cons(out, Nil))) else ctfail("native build received unexpected target compiler output\n")

fn ld_build_target(root, source, out, target) = if target == "" or target == "x86_64-linux-elf" or target == "linux-x86_64" or target == "x86_64-unknown-linux-gnu" or target == "x86_64-none-raw" or target == "x86_64-none-mbr" then ld_build(root, source, out) else if fs_path_exists(source) == 0 then ctfail("native build cannot read " + source + "\n") else let bundled = ld_bundle(root, source, out) in let result = ld_request(root, "ltarget", "@compile " + target + "\n" + fs_read_file(bundled)) in ld_target_output(root, out, result)

fn ld_default_out(source) = if ld_suffix(source, ".src") then slice(source, 0, count(source) - 4) else if ld_suffix(source, ".intent") then slice(source, 0, count(source) - 7) else source + ".out"

fn ld_build_args(args, source, out, target) = match args
    Nil => {source: source, out: out, target: target}
    Cons(h, t) => if h == "-o" then (match t
        Nil => ctfail("usage: lume_driver build [--target <triple>] <source.src> [-o <out>]\n")
        Cons(v, r) => ld_build_args(r, source, v, target)) else if h == "--target" then (match t
        Nil => ctfail("usage: lume_driver build [--target <triple>] <source.src> [-o <out>]\n")
        Cons(v, r) => ld_build_args(r, source, out, v)) else if ld_starts(h, "--target=") == 1 then ld_build_args(t, source, out, slice(h, 9, count(h))) else if slice(h, 0, 1) == "-" then ctfail("usage: lume_driver build [--target <triple>] <source.src> [-o <out>]\n") else ld_build_args(t, h, out, target)

fn ld_build_entry(root) = let args = ld_build_args(ld_args_from(2), "", "", "") in if args.source == "" then ctfail("usage: lume_driver build [--target <triple>] <source.src> [-o <out>]\n") else let out = if args.out == "" then ld_default_out(args.source) else args.out in let target = if args.target == "" then ld_infer_target(out) else args.target in os_exit(ld_build_target(root, args.source, out, target))

fn ld_args_from(i) = if i >= os_arg_count() then Nil else Cons(os_arg_at(i), ld_args_from(i + 1))

fn ld_wait_exit(raw) = if raw < 0 or raw % 256 == 127 then 1 else if raw % 256 == 0 then raw / 256 else 128 + raw % 128

fn ld_run(root, source) = let binary = root + "/build/lume-driver-run" in let built = ld_build(root, source, binary) in if built != 0 then built else ld_wait_exit(os_run(binary, ld_args_from(3)))

fn ld_test(root, source) = if fs_path_exists(source) == 0 then ctfail("native test cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-test") in let generated = ld_request(root, "ltest", fs_read_file(bundled)) in let harness = root + "/build/lume-driver-test-harness.src" in let written = fs_write_sync(harness, generated + "\n") in if written != 1 then ctfail("native test cannot write generated harness\n") else ld_run(root, harness)

fn ld_certify(root, source) = if fs_path_exists(source) == 0 then ctfail("native certify cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-certify") in let result = ld_request(root, "lcaas", "@mode certify\n@sha256 " + fs_sha256_file(bundled) + "\n" + fs_read_file(bundled)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ctfail(result + "\n")

fn ld_verify_cert(root, source) = if fs_path_exists(source) == 0 then ctfail("native verify-cert cannot read " + source + "\n") else let result = ld_request(root, "lcert", fs_read_file(source)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ctfail(result + "\n")

fn ld_certify_entry(root) = if os_arg_count() != 3 then ctfail("usage: lume_driver certify|verify-cert <source.src|certificate.json>\n") else if os_arg_at(1) == "certify" then ld_certify(root, os_arg_at(2)) else if os_arg_at(1) == "verify-cert" then ld_verify_cert(root, os_arg_at(2)) else ld_info(root)

fn ld_check(root, source, json) = if fs_path_exists(source) == 0 then ctfail("native check cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-check") in let result = ld_request(root, "lcaas", fs_read_file(bundled)) in if ld_contains_at(result, "\"ok\":false", 0) == 1 then ctfail(result + "\n") else if json == 1 then os_exit(0) else let reported = fs_write_sync("/dev/stderr", source + ": OK (Lume-Core parsed and checked)\n") in os_exit(0)

fn ld_check_entry(root) = if os_arg_count() == 3 then ld_check(root, os_arg_at(2), 0) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_check(root, os_arg_at(3), 1) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_check(root, os_arg_at(2), 1) else ctfail("usage: lume_driver check <source.src> [--json]\n")

fn ld_fmt(root, source, mode) = if fs_path_exists(source) == 0 then ctfail("native fmt cannot read " + source + "\n") else let formatted = ld_request(root, "lfmt", fs_read_file(source)) in if mode == "--stdout" then formatted else let generated = formatted + "\n" in if mode == "--check" then (if fs_read_file(source) == generated then os_exit(0) else let reported = fs_write_sync("/dev/stderr", "lume fmt: " + source + " is not canonically formatted\n") in os_exit(1)) else let written = fs_write_sync(source, generated) in if written != 1 then ctfail("native fmt cannot rewrite " + source + "\n") else os_exit(0)

fn ld_fmt_entry(root) = if os_arg_count() == 3 then ld_fmt(root, os_arg_at(2), "") else if os_arg_count() == 4 and (os_arg_at(2) == "--check" or os_arg_at(2) == "--stdout") then ld_fmt(root, os_arg_at(3), os_arg_at(2)) else if os_arg_count() == 4 and (os_arg_at(3) == "--check" or os_arg_at(3) == "--stdout") then ld_fmt(root, os_arg_at(2), os_arg_at(3)) else ctfail("usage: lume_driver fmt <source.src> [--check|--stdout]\n")

fn ld_line_count_at(text, i) = if i >= count(text) then 0 else (if at(text, i) == "\n" then 1 else 0) + ld_line_count_at(text, i + 1)

fn ld_compile_json(root, exit_code, asm_lines, ran, run_exit, diag, stdout) = ld_request(root, "lcli", "@cmd compile-json\n@exit " + str(exit_code) + "\n@asm_lines " + str(asm_lines) + "\n@ran " + str(ran) + "\n@run_exit " + str(run_exit) + "\n@diag\n" + diag + "\n@end\n@stdout\n" + stdout + "\n@end\n")

fn ld_compile_run(root, assembly, binary) = let assemble_errors = binary + ".assemble.err" in let assembled = os_run_input_capture_timeout(ld_tool(root, "lasm"), Nil, assembly, binary, assemble_errors, 120000) in if assembled != 0 then ctfail("native compile assembler failed:\n" + fs_read_file(assemble_errors)) else let changed = os_run("/bin/chmod", Cons("+x", Cons(binary, Nil))) in if changed != 0 then ctfail("native compile cannot mark artifact executable\n") else let output = binary + ".out" in let errors = binary + ".err" in let executed = os_run_capture_timeout(binary, Nil, output, errors, 120000) in {ran: 1, run_exit: ld_wait_exit(executed), stdout: fs_read_file(output)}

fn ld_compile_report(root, source, assembly) = let reported = fs_write_sync("/dev/stderr", "lume compile: " + source + " OK (" + str(ld_line_count_at(fs_read_file(assembly), 0)) + " asm lines)\n") in ld_chomp(fs_read_file(assembly))

fn ld_compile_result(root, source, json, execute, compiled, assembly, diag) = let exit_code = ld_wait_exit(compiled) in let asm_lines = ld_line_count_at(fs_read_file(assembly), 0) in if compiled != 0 then (if json == 1 then let response = ld_compile_json(root, exit_code, asm_lines, 0, 0, fs_read_file(diag), "") in let reported = fs_write_sync("/dev/stdout", response + "\n") in os_exit(exit_code) else ctfail(fs_read_file(diag))) else let binary = root + "/build/lume-driver-compile-bin" in let outcome = if execute == 1 then ld_compile_run(root, assembly, binary) else {ran: 0, run_exit: 0, stdout: ""} in if json == 1 then ld_compile_json(root, 0, asm_lines, outcome.ran, outcome.run_exit, fs_read_file(diag), outcome.stdout) else ld_compile_report(root, source, assembly)

fn ld_compile(root, source, json, execute) = if fs_path_exists(source) == 0 then ctfail("native compile cannot read " + source + "\n") else if count(source) < 5 or slice(source, count(source) - 4, count(source)) != ".src" then ctfail("native compile expects a .src Lume-Core file\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-compile") in let checked = ld_request(root, "lcaas", fs_read_file(bundled)) in if ld_contains_at(checked, "\"ok\":false", 0) == 1 then (if json == 1 then let reported = fs_write_sync("/dev/stdout", checked + "\n") in os_exit(1) else ctfail(checked + "\n")) else let assembly = root + "/build/lume-driver-compile.s" in let diag = root + "/build/lume-driver-compile.diag" in let compiled = os_run_input_capture_timeout(ld_tool(root, "lumec"), Nil, bundled, assembly, diag, 120000) in ld_compile_result(root, source, json, execute, compiled, assembly, diag)

fn ld_compile_args(args, source, json, execute) = match args
    Nil => {source: source, json: json, execute: execute}
    Cons(h, t) => if h == "--json" then ld_compile_args(t, source, 1, execute) else if h == "--run" then ld_compile_args(t, source, json, 1) else if slice(h, 0, 1) == "-" then ctfail("usage: lume_driver compile [--json] [--run] <source.src>\n") else ld_compile_args(t, h, json, execute)

fn ld_compile_entry(root) = let args = ld_compile_args(ld_args_from(2), "", 0, 0) in if args.source == "" then ctfail("usage: lume_driver compile [--json] [--run] <source.src>\n") else ld_compile(root, args.source, args.json, args.execute)

fn ld_agent_direct(mode) = if mode == "check" or mode == "compile" or mode == "prove" or mode == "ast" or mode == "expand" or mode == "symbols" or mode == "eval" then 1 else 0

fn ld_agent_query(mode) = if mode == "witness" or mode == "repair" or mode == "impact" or mode == "hashes" or mode == "grammar" or mode == "project" then 1 else 0

fn ld_agent(root, mode, source) = if ld_agent_direct(mode) == 0 and ld_agent_query(mode) == 0 then ctfail("usage: lume_driver agent check|compile|prove|ast|expand|symbols|eval|witness|repair|impact|hashes|grammar|project <source.src>\n") else if fs_path_exists(source) == 0 then ctfail("native agent cannot read " + source + "\n") else let prefix = if ld_agent_query(mode) == 1 then "@mode " + mode + "\n" else "" in let result = ld_request(root, "lcaas", prefix + fs_read_file(source)) in if ld_contains_at(result, "\"ok\":false", 0) == 1 then ctfail(result + "\n") else result

fn ld_agent_entry(root) = if os_arg_count() == 4 then ld_agent(root, os_arg_at(2), os_arg_at(3)) else ctfail("usage: lume_driver agent <mode> <source.src>\n")

fn ld_intent_input(source, cache) = let text = fs_read_file(source) in if fs_path_exists(cache) == 1 then text + "\n@split\n" + fs_read_file(cache) else text

fn ld_intent_build(root, source, cache) = let checked = ld_request(root, "lcaas", "@mode intent-build\n" + ld_intent_input(source, cache)) in if ld_contains_at(checked, "\"ok\":true", 0) == 0 then ctfail(checked + "\n") else let generated = ld_request(root, "lcaas", "@mode intent-code\n" + ld_intent_input(source, cache)) in let written = fs_write_sync(cache, generated + "\n") in if written != 1 then ctfail("native intent cannot write cache " + cache + "\n") else checked

fn ld_intent_verify(root, source, cache) = let result = ld_request(root, "lcaas", "@mode intent-verify\n" + ld_intent_input(source, cache)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ctfail(result + "\n")

fn ld_intent(root, action, source, cache) = if fs_path_exists(source) == 0 then ctfail("native intent cannot read " + source + "\n") else let target = if cache == "" then source + ".cache.src" else cache in if action == "build" then ld_intent_build(root, source, target) else if action == "verify" then ld_intent_verify(root, source, target) else ctfail("usage: lume_driver intent build|verify <file.intent> [--cache <cache.src>]\n")

fn ld_intent_entry(root) = if os_arg_count() == 4 then ld_intent(root, os_arg_at(2), os_arg_at(3), "") else if os_arg_count() == 6 and os_arg_at(4) == "--cache" then ld_intent(root, os_arg_at(2), os_arg_at(3), os_arg_at(5)) else ctfail("usage: lume_driver intent build|verify <file.intent> [--cache <cache.src>]\n")

fn ld_mesh(root, source) = if fs_path_exists(source) == 0 then ctfail("native mesh cannot read " + source + "\n") else let result = ld_request(root, "lmesh", fs_read_file(source)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ctfail(result + "\n")

fn ld_mesh_entry(root) = if os_arg_count() == 3 then ld_mesh(root, os_arg_at(2)) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_mesh(root, os_arg_at(3)) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_mesh(root, os_arg_at(2)) else ctfail("usage: lume_driver mesh <request.mesh> [--json]\n")

fn ld_adapt(root, source, json, out) = if fs_path_exists(source) == 0 then ctfail("native adapt cannot read " + source + "\n") else if json == 1 and out != "" then ctfail("lume adapt: --json and --output are mutually exclusive\n") else let checked = ld_request(root, "lcaas", "@mode bind\n" + fs_read_file(source)) in if ld_contains_at(checked, "\"ok\":true", 0) == 0 then ctfail(checked + "\n") else if json == 1 then checked else let generated = ld_request(root, "lcaas", "@mode bind-source\n" + fs_read_file(source)) in if out == "" then generated else let written = fs_write_sync(out, generated) in if written != 1 then ctfail("native adapt cannot write " + out + "\n") else os_exit(0)

fn ld_adapt_entry(root) = if os_arg_at(2) != "c" then ctfail("usage: lume_driver adapt c <header.h> [--json] [-o <out.src>]\n") else if os_arg_count() == 4 then ld_adapt(root, os_arg_at(3), 0, "") else if os_arg_count() == 5 and os_arg_at(3) == "--json" then ld_adapt(root, os_arg_at(4), 1, "") else if os_arg_count() == 5 and os_arg_at(4) == "--json" then ld_adapt(root, os_arg_at(3), 1, "") else if os_arg_count() == 6 and (os_arg_at(3) == "-o" or os_arg_at(3) == "--output") then ld_adapt(root, os_arg_at(5), 0, os_arg_at(4)) else if os_arg_count() == 6 and (os_arg_at(4) == "-o" or os_arg_at(4) == "--output") then ld_adapt(root, os_arg_at(3), 0, os_arg_at(5)) else ctfail("usage: lume_driver adapt c <header.h> [--json] [-o <out.src>]\n")

fn ld_prove(root, source) = if fs_path_exists(source) == 0 then ctfail("native prove cannot read " + source + "\n") else let bundled = ld_bundle(root, source, root + "/build/lume-driver-prove") in let result = ld_request(root, "lcaas", fs_read_file(bundled)) in if ld_contains_at(result, "\"ok\":true", 0) == 1 then result else ctfail(result + "\n")

fn ld_prove_entry(root) = if os_arg_count() == 3 then ld_prove(root, os_arg_at(2)) else ctfail("usage: lume_driver prove <source.src>\n")

fn ld_doc(root, source, json) = if fs_path_exists(source) == 0 then ctfail("native doc cannot read " + source + "\n") else ld_request(root, "ldoc", (if json == 1 then "@json\n" else "") + fs_read_file(source))

fn ld_doc_entry(root) = if os_arg_count() == 3 then ld_doc(root, os_arg_at(2), 0) else if os_arg_count() == 4 and os_arg_at(2) == "--json" then ld_doc(root, os_arg_at(3), 1) else if os_arg_count() == 4 and os_arg_at(3) == "--json" then ld_doc(root, os_arg_at(2), 1) else ctfail("usage: lume_driver doc <source.src> [--json]\n")

fn ld_pkg(root, action, dir) = if action != "check" and action != "manifest" then ctfail("usage: lume_driver pkg check [dir]\n") else let manifest = dir + "/lume.toml" in if fs_path_exists(manifest) == 0 then ctfail("lume pkg: missing " + manifest + "\n") else ld_request(root, "lmod", "@manifest\n" + fs_read_file(manifest))

fn ld_pkg_entry(root) = if os_arg_count() == 3 then ld_pkg(root, os_arg_at(2), ".") else if os_arg_count() == 4 then ld_pkg(root, os_arg_at(2), os_arg_at(3)) else ctfail("usage: lume_driver pkg check [dir]\n")

fn ld_rfind_dot(path, i) = if i < 0 then 0 - 1 else if at(path, i) == "." then i else ld_rfind_dot(path, i - 1)

fn ld_artifacts_default(out) = let dot = ld_rfind_dot(out, count(out) - 1) in if dot < 0 then out + ".artifacts" else slice(out, 0, dot) + ".artifacts"

fn ld_economy(root, out, artifacts, self_test) = if out == "" then ctfail("lume economy: --output is required\n") else let parent = ld_dir(out) in let made = if parent == "" then 1 else fs_mkdir(parent) in let art = if artifacts == "" then ld_artifacts_default(out) else artifacts in let made_art = fs_mkdir(art) in if made != 1 or made_art != 1 then ctfail("native economy cannot create output directories\n") else let base = if parent == "" then "." else parent in ld_request(root, "leconomy", "@output " + out + "\n@artifacts " + art + "\n@base " + base + "\n@root " + root + "\n@self_test " + str(self_test) + "\n")

fn ld_economy_entry(root) = if os_arg_at(2) != "--output" then ctfail("usage: lume_driver economy --output <results.json> [--artifacts <dir>] [--self-test]\n") else if os_arg_count() == 4 then ld_economy(root, os_arg_at(3), "", 0) else if os_arg_count() == 6 and os_arg_at(4) == "--artifacts" then ld_economy(root, os_arg_at(3), os_arg_at(5), 0) else if os_arg_count() == 6 and os_arg_at(4) == "--self-test" then ld_economy(root, os_arg_at(3), "", 1) else if os_arg_count() == 7 and os_arg_at(4) == "--artifacts" and os_arg_at(6) == "--self-test" then ld_economy(root, os_arg_at(3), os_arg_at(5), 1) else if os_arg_count() == 7 and os_arg_at(4) == "--self-test" and os_arg_at(5) == "--artifacts" then ld_economy(root, os_arg_at(3), os_arg_at(6), 1) else ctfail("usage: lume_driver economy --output <results.json> [--artifacts <dir>] [--self-test]\n")

fn ld_reg_step(ok, code, message, text) = {ok: ok, code: code, message: message, text: text, capabilities: ""}

fn ld_reg_step_caps(ok, code, message, text, capabilities) = {ok: ok, code: code, message: message, text: text, capabilities: capabilities}

fn ld_reg_fail(result) = ld_reg_step(0, result.code, result.message, "")

fn ld_reg_error(code, message) = {ok: 0, code: code, message: message, text: "", capabilities: "", cid: "", adapter_sha: "", source_sha: "", proof_sha: "", tests_sha: "", test_output_sha: "", target: "", toolchain_sha: "", contract_signature: "", public_contracts: 0, proof_kernel: ""}

fn ld_reg_evidence(cid, adapter_sha, source_sha, proof_sha, tests_sha, test_output_sha, target, toolchain_sha, capabilities, contract_signature, public_contracts, proof_kernel) = {ok: 1, code: "", message: "", text: "", capabilities: capabilities, cid: cid, adapter_sha: adapter_sha, source_sha: source_sha, proof_sha: proof_sha, tests_sha: tests_sha, test_output_sha: test_output_sha, target: target, toolchain_sha: toolchain_sha, contract_signature: contract_signature, public_contracts: public_contracts, proof_kernel: proof_kernel}

fn ld_reg_find(text, part, i) = if i + count(part) > count(text) then count(text) else if slice(text, i, i + count(part)) == part then i else ld_reg_find(text, part, i + 1)

fn ld_reg_json_string(text, key) = let marker = "\"" + key + "\":\"" in let found = ld_reg_find(text, marker, 0) in if found >= count(text) then "" else let start = found + count(marker) in let finish = ld_find_char(text, "\"", start) in if finish >= count(text) then "" else slice(text, start, finish)

fn ld_reg_number_end(text, i) = if i >= count(text) then i else if at(text, i) >= "0" and at(text, i) <= "9" then ld_reg_number_end(text, i + 1) else i

fn ld_reg_json_number(text, key) = let marker = "\"" + key + "\":" in let found = ld_reg_find(text, marker, 0) in if found >= count(text) then "" else let start = found + count(marker) in let finish = ld_reg_number_end(text, start) in if finish == start then "" else slice(text, start, finish)

fn ld_reg_hex(text, i) = if i >= count(text) then 1 else let c = at(text, i) in if (c >= "0" and c <= "9") or (c >= "a" and c <= "f") then ld_reg_hex(text, i + 1) else 0

fn ld_reg_valid_cid(cid) = count(cid) == 71 and slice(cid, 0, 7) == "sha256:" and ld_reg_hex(slice(cid, 7, 71), 0) == 1

fn ld_reg_nonempty(path) = fs_path_exists(path) == 1 and count(fs_read_file(path)) > 0

fn ld_reg_copy(source, destination) = fs_write_sync(destination, fs_read_file(source))

fn ld_reg_remove(path) = os_run("/bin/rm", Cons("-rf", Cons(path, Nil)))

fn ld_reg_remove_file(path) = os_run("/bin/rm", Cons("-f", Cons(path, Nil)))

fn ld_reg_mkdirs(path) = if path == "" or path == "." or path == "/" or fs_path_exists(path) == 1 then 1 else let parent = ld_dir(path) in if ld_reg_mkdirs(parent) != 1 then 0 else fs_mkdir(path)

fn ld_reg_trace(root, stage) = fs_write_sync(root + "/build/lume-driver-registry-stage.txt", stage + "\n")

fn ld_reg_tool(root, tool, input, tag) = let traced = ld_reg_trace(root, "tool " + tool + " " + tag) in let output = root + "/build/lume-driver-registry-" + tag + ".out" in let errors = root + "/build/lume-driver-registry-" + tag + ".err" in let status = os_run_input_capture_timeout(ld_tool(root, tool), Nil, input, output, errors, 120000) in let traced_status = ld_reg_trace(root, "tool " + tool + " " + tag + " raw_status " + str(status)) in {status: status, output: fs_read_file(output), errors: fs_read_file(errors)}

fn ld_reg_env(root, name) = let output = root + "/build/lume-driver-registry-env.out" in let errors = root + "/build/lume-driver-registry-env.err" in let status = os_run_capture_timeout("/usr/bin/printenv", Cons(name, Nil), output, errors, 10000) in if status != 0 then "" else ld_chomp(fs_read_file(output))

fn ld_reg_default_store(root) = let configured = ld_reg_env(root, "LUME_REGISTRY_DIR") in if configured != "" then configured else let temporary = ld_reg_env(root, "TMPDIR") in (if temporary == "" then "/tmp" else temporary) + "/lume_verified_registry"

fn ld_reg_text_sha(root, material) = let path = root + "/build/lume-driver-registry-sha.material" in if fs_write_sync(path, material) != 1 then "" else "sha256:" + fs_sha256_file(path)

fn ld_reg_toolchain_material(root) = "cli=" + fs_sha256_file(ld_tool(root, "lume_driver")) + "\nlumec=" + fs_sha256_file(ld_tool(root, "lumec")) + "\nlasm=" + fs_sha256_file(ld_tool(root, "lasm")) + "\nlcaas=" + fs_sha256_file(ld_tool(root, "lcaas")) + "\nlcert=" + fs_sha256_file(ld_tool(root, "lcert")) + "\nltest=" + fs_sha256_file(ld_tool(root, "ltest")) + "\nlregistry=" + fs_sha256_file(ld_tool(root, "lregistry")) + "\n"

fn ld_reg_tools_exist(root, tools) = match tools
    Nil => 1
    Cons(h, t) => if fs_path_exists(ld_tool(root, h)) == 0 then 0 else ld_reg_tools_exist(root, t)

fn ld_reg_toolchain(root) = let traced = ld_reg_trace(root, "toolchain") in if ld_reg_tools_exist(root, Cons("lume_driver", Cons("lumec", Cons("lasm", Cons("lcaas", Cons("lcert", Cons("ltest", Cons("lregistry", Nil)))))))) == 0 then "" else ld_reg_text_sha(root, ld_reg_toolchain_material(root))

fn ld_reg_certificate_ok(root, path, tag) = let checked = ld_reg_tool(root, "lcert", path, tag) in checked.status == 0 and ld_contains_at(checked.output, "\"kernel_verified\":true", 0) == 1 and ld_contains_at(checked.output, "\"hash_verified\":true", 0) == 1

fn ld_reg_proof_failure(dir, code, message) = let removed = ld_reg_remove_file(dir + "/proof.fresh.json") in ld_reg_step(0, code, message, "")

fn ld_reg_verify_proof(root, dir) = let traced = ld_reg_trace(root, "proof") in let proof = dir + "/proof.cert.json" in let supplied = fs_path_exists(proof) == 1 in if supplied == 1 and ld_reg_certificate_ok(root, proof, "supplied-cert") == 0 then ld_reg_step(0, "R0002", "independent proof kernel rejected supplied certificate", "") else let component = dir + "/component.src" in let request = root + "/build/lume-driver-registry-certify.in" in let written = fs_write_sync(request, "@mode certify\n@sha256 sha256:" + fs_sha256_file(component) + "\n" + fs_read_file(component)) in if written != 1 then ld_reg_step(0, "R0002", "source and adapter failed proof certification", "") else let certified = ld_reg_tool(root, "lcaas", request, "fresh-certify") in if certified.status != 0 or ld_contains_at(certified.output, "\"ok\":true", 0) == 0 then ld_reg_step(0, "R0002", "source and adapter failed proof certification", "") else let fresh = dir + "/proof.fresh.json" in let fresh_written = fs_write_sync(fresh, certified.output) in if fresh_written != 1 then ld_reg_step(0, "R0002", "source and adapter failed proof certification", "") else if ld_reg_certificate_ok(root, fresh, "fresh-cert") == 0 then ld_reg_proof_failure(dir, "R0002", "independent proof kernel rejected fresh certificate") else if supplied == 1 and fs_files_equal(proof, fresh) != 1 then ld_reg_proof_failure(dir, "R0002", "proof certificate is stale or does not bind the actual source and adapter") else let copied = ld_reg_copy(fresh, proof) in let kernel = ld_reg_json_string(fs_read_file(root + "/build/lume-driver-registry-fresh-cert.out"), "kernel_id") in let removed = ld_reg_remove_file(fresh) in if copied != 1 then ld_reg_step(0, "R0002", "source and adapter failed proof certification", "") else if kernel == "" then ld_reg_step(0, "R0002", "proof kernel identity is missing", "") else ld_reg_step(1, "", "", kernel)

fn ld_reg_cleanup_tests(dir) = let first = os_run("/bin/rm", Cons("-f", Cons(dir + "/test-harness.src", Cons(dir + "/test-harness.s", Cons(dir + "/test-harness", Cons(dir + "/test-output.fresh.txt", Nil)))))) in os_run("/bin/rm", Cons("-f", Cons(dir + "/test-compile.err", Cons(dir + "/test-assemble.err", Cons(dir + "/test-run.err", Nil)))))

fn ld_reg_test_failure(dir, message) = let removed = ld_reg_cleanup_tests(dir) in ld_reg_step(0, "R0005", message, "")

fn ld_reg_digits(text, i) = if i >= count(text) then 1 else if at(text, i) >= "0" and at(text, i) <= "9" then ld_reg_digits(text, i + 1) else 0

fn ld_reg_pass_line(line) = let suffix = " passed, 0 failed" in if count(line) <= count(suffix) or slice(line, count(line) - count(suffix), count(line)) != suffix then 0 else let digits = count(line) - count(suffix) in if at(line, 0) < "1" or at(line, 0) > "9" then 0 else ld_reg_digits(slice(line, 0, digits), 0)

fn ld_reg_pass_lines(lines) = match lines
    Nil => 0
    Cons(h, t) => if ld_reg_pass_line(h) == 1 then 1 else ld_reg_pass_lines(t)

fn ld_reg_execute_tests(root, dir) = let generated = ld_reg_tool(root, "ltest", dir + "/test-component.src", "test-generate") in if generated.status != 0 then ld_reg_test_failure(dir, "component test execution failed") else let harness = dir + "/test-harness.src" in let harness_written = fs_write_sync(harness, generated.output) in if harness_written != 1 then ld_reg_test_failure(dir, "component test execution failed") else let assembly = dir + "/test-harness.s" in let compile_errors = dir + "/test-compile.err" in let trace_compile = ld_reg_trace(root, "tests lumec") in let compiled = os_run_input_capture_timeout(ld_tool(root, "lumec"), Nil, harness, assembly, compile_errors, 120000) in let trace_compiled = ld_reg_trace(root, "tests lumec raw_status " + str(compiled)) in if compiled != 0 then ld_reg_test_failure(dir, "component test execution failed") else let binary = dir + "/test-harness" in let assemble_errors = dir + "/test-assemble.err" in let trace_assemble = ld_reg_trace(root, "tests lasm") in let assembled = os_run_input_capture_timeout(ld_tool(root, "lasm"), Nil, assembly, binary, assemble_errors, 120000) in let trace_assembled = ld_reg_trace(root, "tests lasm raw_status " + str(assembled)) in if assembled != 0 then ld_reg_test_failure(dir, "component test execution failed") else let changed = os_run("/bin/chmod", Cons("+x", Cons(binary, Nil))) in if changed != 0 then ld_reg_test_failure(dir, "component test execution failed") else let fresh = dir + "/test-output.fresh.txt" in let run_errors = dir + "/test-run.err" in let trace_run = ld_reg_trace(root, "tests execute") in let executed = os_run_capture_timeout(binary, Nil, fresh, run_errors, 120000) in let trace_executed = ld_reg_trace(root, "tests execute raw_status " + str(executed)) in if executed != 0 then ld_reg_test_failure(dir, "component test execution failed") else if ld_reg_pass_lines(ld_lines(fs_read_file(fresh), 0)) == 0 then ld_reg_test_failure(dir, "component must execute at least one passing test with zero failures") else let stored = dir + "/test-output.txt" in if fs_path_exists(stored) == 1 and fs_files_equal(stored, fresh) != 1 then ld_reg_test_failure(dir, "stored test evidence is stale or tampered") else let copied = ld_reg_copy(fresh, stored) in let removed = ld_reg_cleanup_tests(dir) in if copied != 1 then ld_reg_step(0, "R0005", "component test execution failed", "") else ld_reg_step(1, "", "", "")

fn ld_reg_cid_material(evidence) = "lume-verified-component/0.1\nadapter_sha256=" + evidence.adapter_sha + "\nsource_sha256=" + evidence.source_sha + "\nproof_sha256=" + evidence.proof_sha + "\ntests_sha256=" + evidence.tests_sha + "\ntest_output_sha256=" + evidence.test_output_sha + "\ntarget=" + evidence.target + "\ntoolchain_sha256=" + evidence.toolchain_sha + "\ncapabilities=" + evidence.capabilities + "\ncontract_signature=" + evidence.contract_signature + "\npublic_contracts=" + str(evidence.public_contracts) + "\nproof_kernel=" + evidence.proof_kernel + "\n"

fn ld_reg_evaluate(root, dir, target) = let traced = ld_reg_trace(root, "evaluate " + dir) in if target != "x86_64-linux-elf" then ld_reg_error("R0004", "this increment publishes and resolves only on the x86_64-linux-elf execution target") else if ld_reg_nonempty(dir + "/adapter.src") == 0 then ld_reg_error("R0001", "missing or empty artifact: adapter.src") else if ld_reg_nonempty(dir + "/source.src") == 0 then ld_reg_error("R0001", "missing or empty artifact: source.src") else if ld_reg_nonempty(dir + "/tests.src") == 0 then ld_reg_error("R0001", "missing or empty artifact: tests.src") else let component_text = fs_read_file(dir + "/adapter.src") + "\n" + fs_read_file(dir + "/source.src") + "\n" in let component_written = fs_write_sync(dir + "/component.src", component_text) in let test_written = fs_write_sync(dir + "/test-component.src", component_text + fs_read_file(dir + "/tests.src") + "\n") in if component_written != 1 or test_written != 1 then ld_reg_error("R0001", "component artifacts could not be constructed") else let proof = ld_reg_verify_proof(root, dir) in if proof.ok == 0 then ld_reg_error(proof.code, proof.message) else let tested = ld_reg_execute_tests(root, dir) in if tested.ok == 0 then ld_reg_error(tested.code, tested.message) else let request = root + "/build/lume-driver-registry-interface.in" in let interface_written = fs_write_sync(request, "@mode registry-interface\n" + fs_read_file(dir + "/component.src")) in if interface_written != 1 then ld_reg_error("R0002", "parsed public interface derivation failed") else let interface = ld_reg_tool(root, "lcaas", request, "interface") in if interface.status != 0 or ld_contains_at(interface.output, "\"ok\":true", 0) == 0 then ld_reg_error("R0002", "parsed public interface derivation failed") else let capabilities = ld_reg_json_string(interface.output, "capabilities") in let signature = ld_reg_json_string(interface.output, "contract_signature") in let public_text = ld_reg_json_number(interface.output, "public_contracts") in if ld_reg_valid_cid(signature) == 0 then ld_reg_error("R0002", "invalid derived contract signature") else if public_text == "" or toint(public_text) <= 0 then ld_reg_error("R0002", "component needs at least one public contract") else let toolchain = ld_reg_toolchain(root) in if toolchain == "" then ld_reg_error("R0003", "native registry toolchain is incomplete") else let adapter_sha = "sha256:" + fs_sha256_file(dir + "/adapter.src") in let source_sha = "sha256:" + fs_sha256_file(dir + "/source.src") in let proof_sha = "sha256:" + fs_sha256_file(dir + "/proof.cert.json") in let tests_sha = "sha256:" + fs_sha256_file(dir + "/tests.src") in let output_sha = "sha256:" + fs_sha256_file(dir + "/test-output.txt") in let base = ld_reg_evidence("", adapter_sha, source_sha, proof_sha, tests_sha, output_sha, target, toolchain, capabilities, signature, toint(public_text), proof.text) in let cid = ld_reg_text_sha(root, ld_reg_cid_material(base)) in if cid == "" then ld_reg_error("R0003", "content identifier derivation failed") else ld_reg_evidence(cid, adapter_sha, source_sha, proof_sha, tests_sha, output_sha, target, toolchain, capabilities, signature, toint(public_text), proof.text)

fn ld_reg_manifest_input(mode, evidence, manifest) = "@mode " + mode + "\n@cid " + evidence.cid + "\n@adapter-sha256 " + evidence.adapter_sha + "\n@source-sha256 " + evidence.source_sha + "\n@proof-sha256 " + evidence.proof_sha + "\n@tests-sha256 " + evidence.tests_sha + "\n@test-output-sha256 " + evidence.test_output_sha + "\n@target " + evidence.target + "\n@toolchain-sha256 " + evidence.toolchain_sha + "\n@capabilities " + evidence.capabilities + "\n@contract-signature " + evidence.contract_signature + "\n@public-contracts " + str(evidence.public_contracts) + "\n@proof-kernel " + evidence.proof_kernel + "\n" + (if mode == "verify" then "@manifest\n" + manifest + "\n@end\n" else "")

fn ld_reg_emit_manifest(root, evidence) = let request = root + "/build/lume-driver-registry-manifest.in" in let written = fs_write_sync(request, ld_reg_manifest_input("emit", evidence, "")) in if written != 1 then "" else let emitted = ld_reg_tool(root, "lregistry", request, "manifest-emit") in if emitted.status != 0 or ld_starts(emitted.output, "{\"schema\":\"lume-verified-component/0.1\"") == 0 then "" else emitted.output

fn ld_reg_verify_manifest(root, dir, evidence) = let manifest = fs_read_file(dir + "/manifest.json") in let request = root + "/build/lume-driver-registry-manifest.in" in let written = fs_write_sync(request, ld_reg_manifest_input("verify", evidence, manifest)) in if written != 1 then ld_reg_step(0, "R0003", "artifact hashes, interface, CID, or manifest do not match fresh derivation", "") else let verified = ld_reg_tool(root, "lregistry", request, "manifest-verify") in if verified.status != 0 or ld_contains_at(verified.output, "\"ok\":true", 0) == 0 then ld_reg_step(0, "R0003", "artifact hashes, interface, CID, or manifest do not match fresh derivation", "") else ld_reg_step_caps(1, "", "", manifest, evidence.capabilities)

fn ld_reg_entry_complete(dir) = ld_reg_nonempty(dir + "/manifest.json") == 1 and ld_reg_nonempty(dir + "/adapter.src") == 1 and ld_reg_nonempty(dir + "/source.src") == 1 and ld_reg_nonempty(dir + "/proof.cert.json") == 1 and ld_reg_nonempty(dir + "/tests.src") == 1 and ld_reg_nonempty(dir + "/test-output.txt") == 1

fn ld_reg_verify_entry(root, dir, cid, target) = if ld_reg_valid_cid(cid) == 0 then ld_reg_step(0, "R0001", "invalid content identifier", "") else if ld_reg_entry_complete(dir) == 0 then ld_reg_step(0, "R0003", "registry entry is incomplete", "") else let manifest = fs_read_file(dir + "/manifest.json") in if ld_reg_json_string(manifest, "target") != target then ld_reg_step(0, "R0004", "component target is incompatible with the requested target", "") else let evaluated = ld_reg_evaluate(root, dir, target) in if evaluated.ok == 0 then ld_reg_fail(evaluated) else if ld_reg_json_string(manifest, "toolchain_sha256") != evaluated.toolchain_sha then ld_reg_step(0, "R0004", "component evidence is stale for the current toolchain", "") else ld_reg_verify_manifest(root, dir, evaluated)

fn ld_reg_new_temp(store, attempt) = if attempt > 16 then "" else let path = store + "/components/.publish." + str(os_getpid()) + "." + str(os_monotonic_ns()) + "." + str(attempt) in if fs_path_exists(path) == 1 then ld_reg_new_temp(store, attempt + 1) else let made = os_run("/bin/mkdir", Cons(path, Nil)) in if made == 0 then path else if fs_path_exists(path) == 1 then ld_reg_new_temp(store, attempt + 1) else ""

fn ld_reg_stage(options, temp) = if ld_reg_copy(options.adapter, temp + "/adapter.src") != 1 or ld_reg_copy(options.source, temp + "/source.src") != 1 or ld_reg_copy(options.tests, temp + "/tests.src") != 1 then 0 else if options.proof != "" and ld_reg_copy(options.proof, temp + "/proof.cert.json") != 1 then 0 else 1

fn ld_reg_publish(root, options) = if ld_reg_nonempty(options.adapter) == 0 or ld_reg_nonempty(options.source) == 0 or ld_reg_nonempty(options.tests) == 0 then ld_reg_step(0, "R0001", "input artifact is missing or empty", "") else if options.proof != "" and ld_reg_nonempty(options.proof) == 0 then ld_reg_step(0, "R0001", "proof artifact is missing or empty", "") else if ld_reg_mkdirs(options.store + "/components") != 1 then ld_reg_step(0, "R0003", "registry store could not be created", "") else let temp = ld_reg_new_temp(options.store, 0) in if temp == "" then ld_reg_step(0, "R0003", "publication staging directory could not be created", "") else if ld_reg_stage(options, temp) == 0 then let removed = ld_reg_remove(temp) in ld_reg_step(0, "R0003", "publication staging failed", "") else let evaluated = ld_reg_evaluate(root, temp, options.target) in if evaluated.ok == 0 then let removed = ld_reg_remove(temp) in ld_reg_fail(evaluated) else let manifest = ld_reg_emit_manifest(root, evaluated) in if manifest == "" then let removed = ld_reg_remove(temp) in ld_reg_step(0, "R0003", "manifest generation failed", "") else let manifest_written = fs_write_sync(temp + "/manifest.json", manifest) in if manifest_written != 1 then let removed = ld_reg_remove(temp) in ld_reg_step(0, "R0003", "manifest generation failed", "") else let destination = options.store + "/components/" + evaluated.cid in if fs_path_exists(destination) == 1 then let removed = ld_reg_remove(temp) in ld_reg_step(0, "R0003", "content identifier already exists; resolve it instead of overwriting", "") else let moved = os_run("/bin/mv", Cons("-T", Cons(temp, Cons(destination, Nil)))) in if moved != 0 then let removed = ld_reg_remove(temp) in ld_reg_step(0, "R0003", "staged component could not be moved into the registry", "") else ld_reg_step(1, "", "", fs_read_file(destination + "/manifest.json"))

fn ld_reg_capability_matches(capabilities, query) = if query == "" then 1 else if query == "pure" and capabilities == "" then 1 else ld_contains_at("," + capabilities + ",", "," + query + ",", 0)

fn ld_reg_dir_name(line) = if count(line) < 2 or at(line, count(line) - 1) != "/" then "" else let name = slice(line, 0, count(line) - 1) in if ld_starts(name, "sha256:") == 1 then name else ""

fn ld_reg_items_error(result) = {ok: 0, code: result.code, message: result.message, items: Nil}

fn ld_reg_discover_scan(root, store, target, capability, signature, lines) = match lines
    Nil => {ok: 1, code: "", message: "", items: Nil}
    Cons(h, t) => let name = ld_reg_dir_name(h) in if name == "" then ld_reg_discover_scan(root, store, target, capability, signature, t) else let dir = store + "/components/" + name in let manifest_path = dir + "/manifest.json" in if fs_path_exists(manifest_path) == 0 then ld_reg_items_error(ld_reg_step(0, "R0003", "registry entry has no manifest", "")) else let manifest = fs_read_file(manifest_path) in if ld_reg_json_string(manifest, "target") != target then ld_reg_discover_scan(root, store, target, capability, signature, t) else if signature != "" and ld_reg_json_string(manifest, "contract_signature") != signature then ld_reg_discover_scan(root, store, target, capability, signature, t) else let verified = ld_reg_verify_entry(root, dir, name, target) in if verified.ok == 0 then ld_reg_items_error(verified) else let rest = ld_reg_discover_scan(root, store, target, capability, signature, t) in if rest.ok == 0 then rest else if ld_reg_capability_matches(verified.capabilities, capability) == 1 then {ok: 1, code: "", message: "", items: Cons(ld_chomp(verified.text), rest.items)} else rest

fn ld_reg_join_items(items) = match items
    Nil => ""
    Cons(h, t) => h + (match t
        Nil => ""
        Cons(x, xs) => "," + ld_reg_join_items(t))

fn ld_reg_discover(root, options) = let components = options.store + "/components" in if fs_path_exists(components) == 0 then ld_reg_step(1, "", "", "{\"ok\":true,\"action\":\"discover\",\"target\":\"" + options.target + "\",\"components\":[]}") else let output = root + "/build/lume-driver-registry-list.out" in let errors = root + "/build/lume-driver-registry-list.err" in let listed = os_run_capture_timeout("/bin/ls", Cons("-1p", Cons(components, Nil)), output, errors, 10000) in if listed != 0 then ld_reg_step(0, "R0003", "registry entries could not be enumerated", "") else let found = ld_reg_discover_scan(root, options.store, options.target, options.capability, options.contract, ld_lines(fs_read_file(output), 0)) in if found.ok == 0 then ld_reg_fail(found) else ld_reg_step(1, "", "", "{\"ok\":true,\"action\":\"discover\",\"target\":\"" + options.target + "\",\"components\":[" + ld_reg_join_items(found.items) + "]}")

fn ld_reg_error_json(action, result) = "{\"ok\":false,\"action\":\"" + action + "\",\"error\":{\"code\":\"" + result.code + "\",\"message\":\"" + result.message + "\"}}"

fn ld_reg_finish(action, result) = if result.ok == 1 then ld_chomp(result.text) else let written = fs_write_sync("/dev/stdout", ld_reg_error_json(action, result) + "\n") in os_exit(1)

fn ld_reg_args(args, options) = match args
    Nil => options
    Cons(h, t) => if h == "--json" then ld_reg_args(t, options) else if h == "--store" then (match t
        Nil => ctfail("usage: lume_driver registry publish|resolve|discover [options]\n")
        Cons(v, r) => ld_reg_args(r, {store: v, target: options.target, adapter: options.adapter, source: options.source, proof: options.proof, tests: options.tests, cid: options.cid, capability: options.capability, contract: options.contract})) else if ld_starts(h, "--store=") == 1 then ld_reg_args(t, {store: slice(h, 8, count(h)), target: options.target, adapter: options.adapter, source: options.source, proof: options.proof, tests: options.tests, cid: options.cid, capability: options.capability, contract: options.contract}) else if h == "--target" then (match t
        Nil => ctfail("usage: lume_driver registry publish|resolve|discover [options]\n")
        Cons(v, r) => ld_reg_args(r, {store: options.store, target: v, adapter: options.adapter, source: options.source, proof: options.proof, tests: options.tests, cid: options.cid, capability: options.capability, contract: options.contract})) else if ld_starts(h, "--target=") == 1 then ld_reg_args(t, {store: options.store, target: slice(h, 9, count(h)), adapter: options.adapter, source: options.source, proof: options.proof, tests: options.tests, cid: options.cid, capability: options.capability, contract: options.contract}) else if h == "--adapter" then (match t
        Nil => ctfail("usage: lume_driver registry publish|resolve|discover [options]\n")
        Cons(v, r) => ld_reg_args(r, {store: options.store, target: options.target, adapter: v, source: options.source, proof: options.proof, tests: options.tests, cid: options.cid, capability: options.capability, contract: options.contract})) else if ld_starts(h, "--adapter=") == 1 then ld_reg_args(t, {store: options.store, target: options.target, adapter: slice(h, 10, count(h)), source: options.source, proof: options.proof, tests: options.tests, cid: options.cid, capability: options.capability, contract: options.contract}) else if h == "--source" then (match t
        Nil => ctfail("usage: lume_driver registry publish|resolve|discover [options]\n")
        Cons(v, r) => ld_reg_args(r, {store: options.store, target: options.target, adapter: options.adapter, source: v, proof: options.proof, tests: options.tests, cid: options.cid, capability: options.capability, contract: options.contract})) else if ld_starts(h, "--source=") == 1 then ld_reg_args(t, {store: options.store, target: options.target, adapter: options.adapter, source: slice(h, 9, count(h)), proof: options.proof, tests: options.tests, cid: options.cid, capability: options.capability, contract: options.contract}) else if h == "--proof" then (match t
        Nil => ctfail("usage: lume_driver registry publish|resolve|discover [options]\n")
        Cons(v, r) => ld_reg_args(r, {store: options.store, target: options.target, adapter: options.adapter, source: options.source, proof: v, tests: options.tests, cid: options.cid, capability: options.capability, contract: options.contract})) else if ld_starts(h, "--proof=") == 1 then ld_reg_args(t, {store: options.store, target: options.target, adapter: options.adapter, source: options.source, proof: slice(h, 8, count(h)), tests: options.tests, cid: options.cid, capability: options.capability, contract: options.contract}) else if h == "--tests" then (match t
        Nil => ctfail("usage: lume_driver registry publish|resolve|discover [options]\n")
        Cons(v, r) => ld_reg_args(r, {store: options.store, target: options.target, adapter: options.adapter, source: options.source, proof: options.proof, tests: v, cid: options.cid, capability: options.capability, contract: options.contract})) else if ld_starts(h, "--tests=") == 1 then ld_reg_args(t, {store: options.store, target: options.target, adapter: options.adapter, source: options.source, proof: options.proof, tests: slice(h, 8, count(h)), cid: options.cid, capability: options.capability, contract: options.contract}) else if h == "--cid" then (match t
        Nil => ctfail("usage: lume_driver registry publish|resolve|discover [options]\n")
        Cons(v, r) => ld_reg_args(r, {store: options.store, target: options.target, adapter: options.adapter, source: options.source, proof: options.proof, tests: options.tests, cid: v, capability: options.capability, contract: options.contract})) else if ld_starts(h, "--cid=") == 1 then ld_reg_args(t, {store: options.store, target: options.target, adapter: options.adapter, source: options.source, proof: options.proof, tests: options.tests, cid: slice(h, 6, count(h)), capability: options.capability, contract: options.contract}) else if h == "--capability" then (match t
        Nil => ctfail("usage: lume_driver registry publish|resolve|discover [options]\n")
        Cons(v, r) => ld_reg_args(r, {store: options.store, target: options.target, adapter: options.adapter, source: options.source, proof: options.proof, tests: options.tests, cid: options.cid, capability: v, contract: options.contract})) else if ld_starts(h, "--capability=") == 1 then ld_reg_args(t, {store: options.store, target: options.target, adapter: options.adapter, source: options.source, proof: options.proof, tests: options.tests, cid: options.cid, capability: slice(h, 13, count(h)), contract: options.contract}) else if h == "--contract-signature" then (match t
        Nil => ctfail("usage: lume_driver registry publish|resolve|discover [options]\n")
        Cons(v, r) => ld_reg_args(r, {store: options.store, target: options.target, adapter: options.adapter, source: options.source, proof: options.proof, tests: options.tests, cid: options.cid, capability: options.capability, contract: v})) else if ld_starts(h, "--contract-signature=") == 1 then ld_reg_args(t, {store: options.store, target: options.target, adapter: options.adapter, source: options.source, proof: options.proof, tests: options.tests, cid: options.cid, capability: options.capability, contract: slice(h, 21, count(h))}) else ctfail("usage: lume_driver registry publish|resolve|discover [options]\n")

fn ld_registry_entry(root) = if os_arg_count() < 3 then ctfail("usage: lume_driver registry publish|resolve|discover [options]\n") else let action = os_arg_at(2) in let traced = ld_reg_trace(root, "registry " + action) in let initial = {store: ld_reg_default_store(root), target: "x86_64-linux-elf", adapter: "", source: "", proof: "", tests: "", cid: "", capability: "", contract: ""} in let options = ld_reg_args(ld_args_from(3), initial) in if action == "publish" then (if options.adapter == "" or options.source == "" or options.tests == "" then ctfail("usage: lume_driver registry publish --adapter <adapter.src> --source <source.src> --tests <tests.src> [--proof <proof.cert.json>]\n") else ld_reg_finish(action, ld_reg_publish(root, options))) else if action == "resolve" then (if options.cid == "" then ctfail("usage: lume_driver registry resolve --cid <sha256:...>\n") else ld_reg_finish(action, ld_reg_verify_entry(root, options.store + "/components/" + options.cid, options.cid, options.target))) else if action == "discover" then ld_reg_finish(action, ld_reg_discover(root, options)) else ctfail("usage: lume_driver registry publish|resolve|discover [options]\n")

fn ld_info(root) = if os_arg_count() != 2 then ctfail("usage: lume_driver --version|--help|describe|targets|build [--target <triple>] <source> [-o <out>]|run <source> [args]|test <source.src>|intent build|verify <file.intent>|compile [--json] [--run] <source.src>|agent <mode> <source.src>|certify|verify-cert <source>|check <source.src> [--json]|fmt <source.src> [--check|--stdout]|pkg check [dir]|doc <source.src> [--json]|prove <source.src>|adapt c <header.h>|mesh <request.mesh>|registry publish|resolve|discover|economy --output <results.json>\n") else let command = os_arg_at(1) in if command == "--version" or command == "version" then ld_request(root, "lcli", "@cmd version\n") else if command == "--help" or command == "-h" or command == "help" then ld_request(root, "lcli", "@cmd help\n") else if command == "describe" or command == "--describe" then ld_request(root, "lcli", "@cmd describe\n") else if command == "targets" or command == "--targets" then ld_request(root, "ltarget", "@targets-json\n") else ctfail("unknown native driver command: " + command + "\n")

fn ld_entry(root) = if os_arg_count() >= 2 and os_arg_at(1) == "build" then ld_build_entry(root) else if os_arg_count() >= 3 and os_arg_at(1) == "run" then os_exit(ld_run(root, os_arg_at(2))) else if os_arg_at(1) == "test" then (if os_arg_count() != 3 then ctfail("usage: lume_driver test <source.src>\n") else os_exit(ld_test(root, os_arg_at(2)))) else if os_arg_at(1) == "intent" then ld_intent_entry(root) else if os_arg_at(1) == "compile" then ld_compile_entry(root) else if os_arg_at(1) == "agent" then ld_agent_entry(root) else if os_arg_at(1) == "certify" or os_arg_at(1) == "verify-cert" then ld_certify_entry(root) else if os_arg_at(1) == "check" then ld_check_entry(root) else if os_arg_at(1) == "fmt" then ld_fmt_entry(root) else if os_arg_at(1) == "pkg" then ld_pkg_entry(root) else if os_arg_at(1) == "doc" then ld_doc_entry(root) else if os_arg_at(1) == "prove" then ld_prove_entry(root) else if os_arg_at(1) == "adapt" then ld_adapt_entry(root) else if os_arg_at(1) == "mesh" then ld_mesh_entry(root) else if os_arg_at(1) == "registry" then ld_registry_entry(root) else if os_arg_at(1) == "economy" then ld_economy_entry(root) else ld_info(root)

print ld_entry(ld_root())
