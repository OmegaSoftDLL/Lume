## block_cc.lume — native block-language compiler, written in Lume.
## Reads a source file and emits x86-64 assembly for lasm; no C is generated.
use block_ast
use block_parser
use block_native_codegen
use data_asmgen
use std.io

fn main()
    let args = env.args()
    if args.len() < 2
        io.println("usage: block_cc.lume <in.blk> <out.s>")
        return
    let asm = agen(bn_program(parse_block_program(io.read_file(args[0]))))
    let wrote = io.write_file(args[1], asm)
    io.println("emitted asm {args[0]} -> {args[1]}")
