## regex_ok.src -- `use std/regex`: classes, anchors, groups, alternation, greedy and lazy quantifiers, replace, split
use regex

fn test_match_basics() = re_match("abc", "abc") and re_match("a.c", "axc") and re_match("a.c", "ac") == false and re_match("ab*c", "ac") and re_match("ab+c", "ac") == false and re_match("colou?r", "color") and re_match("colou?r", "colour")
fn test_classes() = re_match("[a-z]+[0-9]{{2,3}}", "abc12") and re_match("[a-z]+[0-9]{{2,3}}", "abc1234") == false and re_match("[^0-9]+", "abc") and re_match("\\d\\d-\\w+", "42-x_y") and re_match("\\s+", " \t ") and re_match("[\\d.]+", "3.14")
fn test_alternation() = re_match("cat|dog", "dog") and re_match("(cat|dog)s?", "cats") and re_match("a(b|bc)d", "abcd") and re_match("(a|ab)(c|bcd)", "abcd")
fn test_search() = (re_search("o+", "hello world")).start == 4 and (re_search("o+", "hello world")).end == 5 and (re_search("z", "abc")).start == 0 - 1 and re_find("\\d+", "id: 4521, x") == "4521"
fn test_anchors() = re_find("^ab", "abab") == "ab" and (re_search("^b", "ab")).start == 0 - 1 and re_find("b$", "abab") == "b" and re_match("^$", "")
fn test_find_all() = re_find_all("\\d+", "a1b22c333") == ["1", "22", "333"] and re_find_all("x", "abc") == Nil
fn test_groups() = re_groups("(\\d{{4}})-(\\d{{2}})-(\\d{{2}})", "on 2026-11-19 at") == ["2026-11-19", "2026", "11", "19"] and re_groups("(?:a)(b)", "ab") == ["ab", "b"]
fn test_lazy() = re_find("<.+>", "<a><b>") == "<a><b>" and re_find("<.+?>", "<a><b>") == "<a>" and re_find("a{{2,}}?", "aaaa") == "aa"
fn test_replace() = re_replace("\\s+", "a  b   c", " ") == "a b c" and re_replace("(\\w+)@(\\w+)", "ana@x bob@y", "\$2:\$1") == "x:ana y:bob" and re_replace("o", "foo", "0") == "f00"
fn test_split() = re_split(",\\s*", "a, b,c,  d") == ["a", "b", "c", "d"] and re_split(";", "x") == ["x"]
fn test_utf8() = re_match("aç.o", "ação") and re_find("[àáãâ]", "pão") == "ã" and re_find_all(".", "aé") == ["a", "é"]
fn test_word_boundary() = re_find_all("\\bcat\\b", "cat concat cat_ cat.") == ["cat", "cat"] and re_match("\\Bb\\B", "abc") == false and re_find("\\Bb\\B", "abc") == "b" and re_find_all("\\b\\w+\\b", "hi, you!") == ["hi", "you"] and re_match("\\b", "") == false
fn test_backrefs() = re_match("(\\w+) \\1", "bye bye") and re_match("(\\w+) \\1", "bye buy") == false and re_find("(a|b)\\1+", "xabbbx") == "bbb" and re_match("(a)?b\\1", "b") == false and re_groups("<(\\w+)>.*</\\1>", "<b>x</i><b>y</b>") == ["<b>x</i><b>y</b>", "b"]
fn test_lookahead() = re_find("\\w+(?=!)", "hey you!") == "you" and re_find_all("\\d(?!\\d)", "12 345 6") == ["2", "5", "6"] and re_match("(?=.*\\d)(?=.*[a-z]).{{6,}}", "abc123") and re_match("(?=.*\\d)(?=.*[a-z]).{{6,}}", "abcdef") == false and re_groups("(?=(\\w+))\\w", "abc") == ["a", "abc"]
fn test_named_groups() = re_named("(?<y>\\d{{4}})-(?<m>\\d\\d)", "on 2026-11 ok", "m") == "11" and re_named("(?P<y>\\d{{4}})-(?P<m>\\d\\d)", "on 2026-11 ok", "y") == "2026" and re_named("(?<y>\\d+)", "x", "y") == "" and re_named("(?<y>\\d+)", "7", "z") == "" and re_group_names("(a)(?<n>b)(?:c)[(](d)") == ["", "n", ""] and re_groups("(a)(?<n>b)[(]", "ab(") == ["ab(", "a", "b"]
fn test_case_insensitive() = re_match("(?i)hello", "HeLLo") and re_match("(?i)[a-c]+x", "AbCX") and re_find_all("(?i)ab", "ab AB aB x") == ["ab", "AB", "aB"] and re_match("hello", "HELLO") == false and re_match("(?i)(ab)\\1", "abAB") and re_match("(?i)[^a]", "A") == false
fn test_hex_escape_and_ranges() = re_match("\\x41\\x7a", "Az") and re_match("[\\x30-\\x39]+", "0459") and re_match("\\xe9", "é") and re_match("[a-ž]+", "aéžb") and re_match("[à-ÿ]", "z") == false and re_find("[α-ω]+", "x λόγος y") == "λ"
fn test_empty_matches() = re_find_all("x*", "ab") == ["", "", ""] and re_find_all_groups("(\\d)(\\w)", "1a 2b") == [["1a", "1", "a"], ["2b", "2", "b"]] and re_replace("x*", "ab", "-") == "-a-b-" and re_split("", "abc") == ["abc"]
fn test_backtracking_nested() =re_match("(a+)+b", "aaab") and re_match("(x|xy)*z", "xyxz") and re_match("(a*)*b", "b")
