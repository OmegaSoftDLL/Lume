@bound(cycles: 32)
fn cham_go_cgo_pointer_pinned(cgo_pinned: int, has_go_ptr_to_go_ptr: int) -> int / pure
  requires cgo_pinned >= 0 and has_go_ptr_to_go_ptr >= 0
  ensures result == 0 or result == 1
= if cgo_pinned == 1 and has_go_ptr_to_go_ptr == 0 then 1 else 0

## 1f. Java / JVM (`JNIEnv*` Local Frame Capacity & Exception Check):
@bound(cycles: 32)
fn cham_java_jni_local_frame_ok(local_refs: int, frame_cap: int, pending_exc: int) -> int / pure
  requires local_refs >= 0 and frame_cap >= 16 and pending_exc >= 0
  ensures result == 0 or result == 1
= if local_refs <= frame_cap and pending_exc == 0 then 1 else 0

