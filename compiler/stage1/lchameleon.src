@bound(cycles: 24)
fn lumeputer_swiglu_exact_relu_unit(a_val: int, b_gate: int, k_gain: int) -> int / pure
  requires a_val >= 0 and k_gain >= 18
  ensures result >= 0
= if b_gate <= 0 then 0 else a_val * b_gate

law lumeputer_swiglu_relu_zero_gate_law(a_val: int, b_gate: int, k_gain: int) =
  if a_val >= 0 and b_gate <= 0 and k_gain >= 18 then
    lumeputer_swiglu_exact_relu_unit(a_val, b_gate, k_gain) == 0
  else 1 == 1

@bound(cycles: 24)
fn lumeputer_ballast_rmsnorm_guard_ok(residual_abs: int, ballast_b: int) -> int / pure
  requires residual_abs >= 0 and ballast_b >= 1
  ensures result == 0 or result == 1
