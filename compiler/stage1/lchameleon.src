law lumeputer_norm_absorption_immunity_law(residual_abs: int, ballast_b: int) =
  if residual_abs >= 0 and ballast_b >= 1 and residual_abs * 4 > ballast_b then
    lumeputer_ballast_rmsnorm_guard_ok(residual_abs, ballast_b) == 0
  else 1 == 1

@bound(cycles: 24)
fn lumeputer_deltanet_ram_step_exact(old_row_val: int, key_one_hot: int, beta_write: int, new_val: int) -> int / pure
  requires old_row_val >= 0 and key_one_hot >= 0 and key_one_hot <= 1 and beta_write >= 0 and beta_write <= 1 and new_val >= 0
  ensures result >= 0
= if key_one_hot == 1 and beta_write == 1 then new_val else old_row_val

law lumeputer_deltanet_zero_drift_retention_law(old_row_val: int, new_val: int) =
  if old_row_val >= 0 and new_val >= 0 then
    lumeputer_deltanet_ram_step_exact(old_row_val, 0, 0, new_val) == old_row_val
  else 1 == 1

@bound(cycles: 28)
fn lumeputer_rv32im_pc_step(rom_base: int, anchor_word: int, commits_n: int, is_jump: int, jump_target_word: int) -> int / pure
  requires rom_base >= 262144 and anchor_word >= 0 and commits_n >= 0 and commits_n <= 63 and is_jump >= 0 and is_jump <= 1 and jump_target_word >= 0
  ensures result >= rom_base
= if is_jump == 1 then rom_base + jump_target_word * 4 else rom_base + (anchor_word + commits_n) * 4

law lumeputer_rv32im_pc_4byte_aligned_law(rom_base: int, anchor_word: int, commits_n: int) =
  if rom_base >= 262144 and anchor_word >= 0 and commits_n >= 0 and commits_n <= 63 then
    lumeputer_rv32im_pc_step(rom_base, anchor_word, commits_n, 0, 0) >= rom_base
  else 1 == 1

@bound(cycles: 28)
fn lumeputer_bmac_digit_file_step(digit_d: int, src_digit: int, mult_m: int, carry_in: int, overwrite_flag: int) -> int / pure
  requires digit_d >= 0 and digit_d <= 9 and src_digit >= 0 and src_digit <= 9 and mult_m >= 0 and mult_m <= 9 and carry_in >= 0 and overwrite_flag >= 0 and overwrite_flag <= 1
  ensures result >= 0
= (if overwrite_flag == 1 then 0 else digit_d) + src_digit * mult_m + carry_in

@bound(cycles: 28)
fn lumepu_vdot_int8_int4_mac(acc_rd: int, act0: int, w0: int, act1: int, w1: int) -> int / pure
  requires acc_rd >= 0 and act0 >= 0 and w0 >= 0 and act1 >= 0 and w1 >= 0
  ensures result >= acc_rd
