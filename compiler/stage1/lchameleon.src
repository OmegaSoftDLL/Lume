@bound(cycles: 32)
fn cham_dotnet_blittable_check(is_blittable: int, gc_handle_pinned: int, struct_bytes: int) -> int / pure
  requires is_blittable >= 0 and gc_handle_pinned >= 0 and struct_bytes >= 1
  ensures result == 0 or result == 1
