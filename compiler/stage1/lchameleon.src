@bound(cycles: 28)
fn lumepu_vx_vmat_row_mac_exact(acc_vm: int, dot64_sum: int, row_scale_sr: int) -> int / pure
  requires acc_vm >= 0 and dot64_sum >= 0 and row_scale_sr >= 1
  ensures result >= acc_vm
= acc_vm + dot64_sum * row_scale_sr

law lumepu_vx_vmat_zero_bf16_drift_law(acc_vm: int, dot64_sum: int, row_scale_sr: int) =
  if acc_vm >= 0 and dot64_sum >= 0 and row_scale_sr >= 1 then
    lumepu_vx_vmat_row_mac_exact(acc_vm, dot64_sum, row_scale_sr) >= acc_vm
