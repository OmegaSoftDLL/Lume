## 1j. 2nd-Order Dynamical Transition Engine (OTE) & Singularity Boundary Omega Guards:
@bound(cycles: 24)
fn ote_singularity_tau_max_ms(tm_ms: int) -> int / pure
  requires tm_ms >= 4
  ensures result >= 1 and result * 4 <= tm_ms
= tm_ms / 4

@bound(cycles: 24)
fn ote_omega_boundary_crossed(tau_ms: int, tm_ms: int) -> int / pure
  requires tau_ms >= 0 and tm_ms >= 4
  ensures result == 0 or result == 1
= if tau_ms * 4 > tm_ms then 1 else 0

@bound(cycles: 24)
fn ote_nyquist_status_code(tm_ms: int, ts_ms: int) -> int / pure
  requires tm_ms >= 1 and ts_ms >= 1
  ensures result == 0 or result == 1 or result == 2
= if tm_ms < 2 * ts_ms then 2 else if tm_ms < 4 * ts_ms then 1 else 0

@bound(cycles: 24)
fn ote_select_damping_regime(peak_count: int, rise_ratio_milli: int) -> int / pure
  requires peak_count >= 0 and rise_ratio_milli >= 1000
  ensures result == 0 or result == 1 or result == 2 or result == 3
= if peak_count >= 2 then 1 else if rise_ratio_milli == 3632 then 2 else if rise_ratio_milli > 3632 and rise_ratio_milli <= 7213 then 3 else 0

@bound(cycles: 24)
fn ote_phase_coherence_ok(phi_power_deg: int, phi_delay_deg: int) -> int / pure
  requires phi_power_deg >= 0 and phi_delay_deg >= 0
  ensures result == 0 or result == 1
= let diff = if phi_power_deg >= phi_delay_deg then phi_power_deg - phi_delay_deg else phi_delay_deg - phi_power_deg in if diff <= 10 then 1 else 0

@bound(cycles: 48)
fn ote_diagnose_primary_code(nyq_code: int, omega_crossed: int, pf_milli: int, mf_deg: int, casc_deg: int, zeta_milli: int, qamp_milli: int) -> str / pure
= if nyq_code == 2 then "NYQ-ALIAS" else if nyq_code == 1 then "NYQ-LIMIT" else if omega_crossed == 1 then "OMEGA-CROSS" else if pf_milli < 700 then "PF-LOW" else if mf_deg < 45 then "MF-LOW" else if casc_deg >= 135 then "CASCADE-DEEP" else if zeta_milli < 400 then "ZETA-LOW" else if zeta_milli > 1200 then "ZETA-HIGH" else if qamp_milli > 2000 then "QAMP-HIGH" else "TUNED"

law ote_omega_counterphase_law(tau_ms: int, tm_ms: int) =
  if tm_ms >= 4 and tau_ms >= 0 and tau_ms * 4 > tm_ms then
    ote_omega_boundary_crossed(tau_ms, tm_ms) == 1
  else 1 == 1

law ote_nyquist_aliasing_law(tm_ms: int, ts_ms: int) =
  if tm_ms >= 1 and ts_ms >= 1 and tm_ms < 2 * ts_ms then
    ote_nyquist_status_code(tm_ms, ts_ms) == 2
  else 1 == 1

@bound(cycles: 36)
fn ote_power_factor_milli(p_active_milli: int, s_apparent_milli: int) -> int / pure
  requires p_active_milli >= 0 and s_apparent_milli >= 1 and p_active_milli <= s_apparent_milli
  ensures result >= 0 and result <= 1000
= let pf = if p_active_milli == s_apparent_milli then 1000 else (p_active_milli * 1000) / s_apparent_milli in if pf <= 0 then 0 else if pf >= 1000 then 1000 else pf

@bound(cycles: 36)
fn ote_reactive_waste_ratio_milli(q_reactive_milli: int, s_apparent_milli: int) -> int / pure
  requires q_reactive_milli >= 0 and s_apparent_milli >= 1 and q_reactive_milli <= s_apparent_milli
  ensures result >= 0 and result <= 1000
= let qf = if q_reactive_milli == 0 then 0 else (q_reactive_milli * 1000) / s_apparent_milli in if qf <= 0 then 0 else if qf >= 1000 then 1000 else qf

law ote_power_triangle_conservation_law(s_app: int) =
  if s_app >= 1 and s_app <= 1000000 then
    ote_power_factor_milli(s_app, s_app) == 1000 and ote_reactive_waste_ratio_milli(0, s_app) == 0
  else 1 == 1

@bound(cycles: 24)
fn ote_singularity_margin_zone(tau_ms: int, tm_ms: int) -> int / pure
  requires tau_ms >= 0 and tm_ms >= 20
  ensures result == 0 or result == 1 or result == 2
= if 4 * tau_ms > tm_ms then 2 else if 5 * tau_ms >= tm_ms then 1 else 0

@bound(cycles: 24)
fn ote_cascade_bandwidth_decoupled_ok(tm_inner_ms: int, tm_outer_ms: int) -> int / pure
  requires tm_inner_ms >= 1 and tm_outer_ms >= 1
  ensures result == 0 or result == 1
= if tm_outer_ms >= 3 * tm_inner_ms then 1 else 0

law ote_cascade_resonance_law(tm_in: int, tm_out: int) =
  if tm_in >= 1 and tm_out >= 1 and tm_out < 3 * tm_in then
    ote_cascade_bandwidth_decoupled_ok(tm_in, tm_out) == 0
  else 1 == 1

@bound(cycles: 32)
fn ote_estimate_zeta_milli(regime: int, mp_permille: int, rise_ratio_milli: int) -> int / pure
  requires regime >= 1 and regime <= 3 and mp_permille >= 0 and mp_permille <= 1000 and rise_ratio_milli >= 1000
  ensures result >= 50 and result <= 100000
= if regime == 1 then (if mp_permille >= 800 then 50 else if mp_permille >= 500 then 215 else if mp_permille >= 250 then 404 else if mp_permille >= 100 then 591 else 707) else if regime == 2 then 1000 else if rise_ratio_milli <= 2200 then 1200 else if rise_ratio_milli >= 9000 then 100000 else 2000

@bound(cycles: 24)
fn ote_retune_kp_scale_milli(omega_crossed: int, zeta_low: int, zeta_high: int) -> int / pure
  ensures result >= 650 and result <= 1250
= if omega_crossed == 1 then 650 else if zeta_low == 1 then 750 else if zeta_high == 1 then 1250 else 1000

## 1k. Empirical-Bayes Beta-Binomial SPC CUSUM, Critical Path Total Float & k-Anonymous Isotonic PAVA:
@bound(cycles: 24)
fn spc_beta_binomial_posterior_num(k_failures: int, n_trials: int, alpha_prior: int, beta_prior: int) -> int / pure
  requires k_failures >= 0 and n_trials >= k_failures and n_trials <= 1000000000 and alpha_prior >= 1 and alpha_prior <= 1000000000 and beta_prior >= 1 and beta_prior <= 1000000000
  ensures result >= 1 and result < alpha_prior + beta_prior + n_trials
= alpha_prior + k_failures

@bound(cycles: 24)
fn spc_cusum_upper_step_milli(c_prev_milli: int, x_milli: int, target_plus_slack_milli: int) -> int / pure
  requires c_prev_milli >= 0
  ensures result >= 0
= if c_prev_milli + x_milli - target_plus_slack_milli > 0 then c_prev_milli + x_milli - target_plus_slack_milli else 0

law spc_cusum_nonnegative_law(c_prev: int, x: int, k_ref: int) =
  if c_prev >= 0 then
    spc_cusum_upper_step_milli(c_prev, x, k_ref) >= 0
  else 1 == 1

@bound(cycles: 24)
fn ops_cpm_total_float_hours(early_start_h: int, duration_h: int, late_finish_h: int) -> int / pure
  requires early_start_h >= 0 and duration_h >= 0 and late_finish_h >= early_start_h + duration_h
  ensures result >= 0 and result == late_finish_h - (early_start_h + duration_h)
= late_finish_h - (early_start_h + duration_h)

law ops_cpm_critical_path_zero_float_law(es: int, dur: int) =
  if es >= 0 and dur >= 0 then
    ops_cpm_total_float_hours(es, dur, es + dur) == 0
  else 1 == 1

@bound(cycles: 24)
fn analytics_k_anonymity_release_ok(distinct_contributors: int, k_min: int) -> int / pure
  requires distinct_contributors >= 0 and k_min >= 5
  ensures result == 0 or result == 1
= if distinct_contributors >= k_min then 1 else 0

law analytics_k_anonymity_privacy_law(contributors: int, k_min: int) =
  if contributors >= 0 and k_min >= 5 and contributors < k_min then
    analytics_k_anonymity_release_ok(contributors, k_min) == 0
  else 1 == 1

@bound(cycles: 24)
fn analytics_pava_monotonic_pair_hi(y0_milli: int, y1_milli: int) -> int / pure
  requires y0_milli >= 0 and y1_milli >= 0
  ensures result >= 0
= if y0_milli <= y1_milli then y1_milli else (y0_milli + y1_milli) / 2

## 1l. Sovereign Floating-Point (`BF16`/`FP16`/`FP32`/`FP64`), `Posit-Quire` Exact Accumulator, `QF_FP_Interval` Proof Algebra, GPU Tensor Core MMA & Autonomous Package Assimilator / `Omni-Stdlib` ACID B+Tree/MVCC:
@bound(cycles: 24)
fn fp_bf16_is_finite_ok(exp_8bit: int, mant_7bit: int) -> int / pure
  requires exp_8bit >= 0 and exp_8bit <= 255 and mant_7bit >= 0 and mant_7bit <= 127
  ensures result == 0 or result == 1
= if exp_8bit < 255 then 1 else 0

@bound(cycles: 24)
fn fp_fp16_is_finite_ok(exp_5bit: int, mant_10bit: int) -> int / pure
  requires exp_5bit >= 0 and exp_5bit <= 31 and mant_10bit >= 0 and mant_10bit <= 1023
  ensures result == 0 or result == 1
= if exp_5bit < 31 then 1 else 0

law fp_bf16_nan_inf_rejection_law(mant: int) =
  if mant >= 0 and mant <= 127 then
    fp_bf16_is_finite_ok(255, mant) == 0
  else 1 == 1

@bound(cycles: 24)
fn fp_quire_exact_dot_accum(quire_acc: int, prod_scaled: int) -> int / pure
  ensures result == quire_acc + prod_scaled
= quire_acc + prod_scaled

law fp_quire_associativity_law(q0: int, p1: int, p2: int) =
  fp_quire_exact_dot_accum(fp_quire_exact_dot_accum(q0, p1), p2) == fp_quire_exact_dot_accum(q0, p1 + p2)

@bound(cycles: 24)
fn fp_interval_add_lo(x_lo: int, y_lo: int, ulp_eps: int) -> int / pure
  requires ulp_eps >= 0
  ensures result <= x_lo + y_lo
= x_lo + y_lo - ulp_eps

@bound(cycles: 24)
fn fp_interval_add_hi(x_hi: int, y_hi: int, ulp_eps: int) -> int / pure
  requires ulp_eps >= 0
  ensures result >= x_hi + y_hi
= x_hi + y_hi + ulp_eps

law fp_interval_soundness_enclosure_law(x: int, y: int, eps: int) =
  if eps >= 0 then
    fp_interval_add_lo(x, y, eps) <= x + y and fp_interval_add_hi(x, y, eps) >= x + y
  else 1 == 1

@bound(cycles: 24)
fn fp_tensor_core_mma_m16n8k16_waves(tiles_m: int, tiles_n: int, tiles_k: int) -> int / pure
  requires tiles_m >= 1 and tiles_n >= 1 and tiles_k >= 1
  ensures result >= 3 and result == tiles_m + tiles_n + tiles_k
= tiles_m + tiles_n + tiles_k

@bound(cycles: 32)
fn fp_flash_attention_o1_sram_tiles(seq_len_tokens: int, tile_size_br: int) -> int / pure
  requires seq_len_tokens >= 1 and tile_size_br >= 1
  ensures result >= 1
= (seq_len_tokens + tile_size_br - 1) / tile_size_br

@bound(cycles: 24)
fn pkg_assimilate_purity_gate_ok(has_hidden_io: int, has_unbounded_ptr: int, qflia_proven: int, ed25519_signed: int) -> int / pure
  requires has_hidden_io >= 0 and has_hidden_io <= 1 and has_unbounded_ptr >= 0 and has_unbounded_ptr <= 1 and qflia_proven >= 0 and qflia_proven <= 1 and ed25519_signed >= 0 and ed25519_signed <= 1
  ensures result == 0 or result == 1
= if has_hidden_io == 0 and has_unbounded_ptr == 0 and qflia_proven == 1 and ed25519_signed == 1 then 1 else 0

law pkg_assimilate_supply_chain_backdoor_rejected_law(ptr_bad: int, proven: int, signed: int) =
  if ptr_bad >= 0 and ptr_bad <= 1 and proven >= 0 and proven <= 1 and signed >= 0 and signed <= 1 then
    pkg_assimilate_purity_gate_ok(1, ptr_bad, proven, signed) == 0
  else 1 == 1

@bound(cycles: 24)
fn pkg_omni_stdlib_btree_split_mid(keys_count: int, min_degree_t: int) -> int / pure
  requires min_degree_t >= 2 and keys_count == 2 * min_degree_t - 1
  ensures result >= 1 and result == min_degree_t - 1
= min_degree_t - 1

@bound(cycles: 24)
fn pkg_omni_stdlib_mvcc_visibility_ok(tx_snapshot_ts: int, row_commit_ts: int, row_deleted_ts: int) -> int / pure
  requires tx_snapshot_ts >= 1 and row_commit_ts >= 1 and row_deleted_ts >= 0
  ensures result == 0 or result == 1
= if row_commit_ts <= tx_snapshot_ts and (row_deleted_ts == 0 or row_deleted_ts > tx_snapshot_ts) then 1 else 0

law pkg_mvcc_uncommitted_invisible_law(snap_ts: int, future_commit: int) =
  if snap_ts >= 1 and future_commit > snap_ts then
    pkg_omni_stdlib_mvcc_visibility_ok(snap_ts, future_commit, 0) == 0
  else 1 == 1

