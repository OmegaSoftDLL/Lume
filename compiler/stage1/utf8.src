## utf8.src -- UTF-8 text by character (`use std/utf8`). Lume strings are bytes: count(s) and at(s, i) count bytes;
## these functions count and cut by code point.
##   utf8_valid(s)          true when s is well-formed UTF-8 (no overlong forms, no surrogates, nothing above U+10FFFF)
##   utf8_len(s)            the number of code points (an invalid byte counts as one)
##   utf8_decode(s)         the list of code points (an invalid byte decodes as U+FFFD)
##   utf8_encode(cps)       a string from a list of code points
##   utf8_char(s, k)        the k-th character as a string ("" past the end)
##   utf8_cp(s, k)          the k-th code point (-1 past the end)
##   utf8_slice(s, a, b)    characters a .. b-1
##   utf8_upper(s) / utf8_lower(s)   case mapping for ASCII and Latin-1 (a-z, à-þ)
##   utf8_reverse(s)        the characters in reverse order

fn u8_b(s, i) = ord_at(s, i)
fn u8_cont(s, i) = i < count(s) and bit_and(u8_b(s, i), 192) == 128
## the sequence at byte i: {cp, len}; an invalid lead or tail gives {65533, 1}
fn u8_at(s, i) =
    let c = u8_b(s, i) in
    if c < 128 then
        {cp: c, len: 1}
    else if c >= 194 and c <= 223 and u8_cont(s, i + 1) then
        {cp: bit_and(c, 31) * 64 + bit_and(u8_b(s, i + 1), 63), len: 2}
    else if c >= 224 and c <= 239 and u8_cont(s, i + 1) and u8_cont(s, i + 2) then
        u8_three(s, i, c)
    else if c >= 240 and c <= 244 and u8_cont(s, i + 1) and u8_cont(s, i + 2) and u8_cont(s, i + 3) then
        u8_four(s, i, c)
    else
        {cp: 65533, len: 1}
fn u8_three(s, i, c) =
    let cp = bit_and(c, 15) * 4096 + bit_and(u8_b(s, i + 1), 63) * 64 + bit_and(u8_b(s, i + 2), 63) in
    if cp < 2048 or cp >= 55296 and cp <= 57343 then
        {cp: 65533, len: 1}
    else
        {cp: cp, len: 3}
fn u8_four(s, i, c) =
    let cp = bit_and(c, 7) * 262144 + bit_and(u8_b(s, i + 1), 63) * 4096 + bit_and(u8_b(s, i + 2), 63) * 64 + bit_and(u8_b(s, i + 3), 63) in
    if cp < 65536 or cp > 1114111 then
        {cp: 65533, len: 1}
    else
        {cp: cp, len: 4}
fn utf8_valid(s) = u8_valid_go(s, 0)
fn u8_valid_go(s, i) =
    if i >= count(s) then
        true
    else
        let r = u8_at(s, i) in
        if r.cp == 65533 and r.len == 1 then
            false
        else
            u8_valid_go(s, i + r.len)
fn utf8_len(s) = u8_len_go(s, 0, 0)
fn u8_len_go(s, i, n) = if i >= count(s) then n else u8_len_go(s, i + (u8_at(s, i)).len, n + 1)
fn utf8_decode(s) = u8_dec(s, 0)
fn u8_dec(s, i) = if i >= count(s) then Nil else let r = u8_at(s, i) in Cons(r.cp, u8_dec(s, i + r.len))
fn utf8_encode(cps) = match cps
    Nil        => ""
    Cons(h, t) => utf8_chr(h) + utf8_encode(t)
## the byte offset of character k (count(s) past the end)
fn u8_off(s, i, k) = if k <= 0 or i >= count(s) then i else u8_off(s, i + (u8_at(s, i)).len, k - 1)
fn utf8_char(s, k) = let o = u8_off(s, 0, k) in if o >= count(s) then "" else slice(s, o, o + (u8_at(s, o)).len)
fn utf8_cp(s, k) = let o = u8_off(s, 0, k) in if o >= count(s) then 0 - 1 else (u8_at(s, o)).cp
fn utf8_slice(s, a, b) =
    let oa = u8_off(s, 0, a) in
    let ob = u8_off(s, oa, b - a) in
    if b <= a then
        ""
    else
        slice(s, oa, ob)
fn u8_upcp(c) = if c >= 97 and c <= 122 then c - 32 else if c >= 224 and c <= 254 and c != 247 then c - 32 else c
fn u8_lowcp(c) = if c >= 65 and c <= 90 then c + 32 else if c >= 192 and c <= 222 and c != 215 then c + 32 else c
fn u8_map(cps, up) = match cps
    Nil        => Nil
    Cons(h, t) => Cons(if up == 1 then u8_upcp(h) else u8_lowcp(h), u8_map(t, up))
fn utf8_upper(s) = utf8_encode(u8_map(utf8_decode(s), 1))
fn utf8_lower(s) = utf8_encode(u8_map(utf8_decode(s), 0))
fn utf8_reverse(s) = u8_rev(s, 0, "")
fn u8_rev(s, i, acc) =
    if i >= count(s) then
        acc
    else
        let r = u8_at(s, i) in
        u8_rev(s, i + r.len, slice(s, i, i + r.len) + acc)
