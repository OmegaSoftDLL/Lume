## compiler/stage1/capsule.src -- Capability-Sealed Data Capsules (Issue #430)
## Import with `use capsule` (or `use std.capsule`).
##
## A capsule binds an immutable payload to an explicit capability grant and
## a FIPS 180-4 SHA-256 integrity digest over `(magic, name, cap_grant, payload)`.
## Opening or mutating a capsule without the required capability grant or with
## a tampered payload/digest fails closed with `[C0430]`.

use fs_sha256_file

fn capsule_sha256_text(data) = let len = count(data) in let total = (len + 9 + 63) / 64 * 64 in let fin = fs_blocks(data, len, total, total / 64, 0, 1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225) in sha_hex32(fin.a) + sha_hex32(fin.b) + sha_hex32(fin.c) + sha_hex32(fin.d) + sha_hex32(fin.e) + sha_hex32(fin.f) + sha_hex32(fin.g) + sha_hex32(fin.h)

fn capsule_digest_for(name, cap_grant, payload) = capsule_sha256_text("LUME_CAPSULE_1:" + name + ":" + cap_grant + "\n" + payload)

fn capsule_seal(name, cap_grant, payload) = {magic: "LUME_CAPSULE_1", name: name, cap_grant: cap_grant, payload: payload, digest: capsule_digest_for(name, cap_grant, payload)}

fn capsule_verify(cap) = if cap.magic != "LUME_CAPSULE_1" then 0 else if cap.name == "" or cap.cap_grant == "" then 0 else if cap.digest == capsule_digest_for(cap.name, cap.cap_grant, cap.payload) then 1 else 0

fn capsule_grant_allows(granted, required) = if granted == required then 1 else if granted == "io" and required == "pure" then 1 else 0

fn capsule_open(cap, required_cap) = if capsule_verify(cap) == 0 then {ok: 0, value: "", error: "[C0430] capsule integrity check failed for '" + cap.name + "'"} else if capsule_grant_allows(cap.cap_grant, required_cap) == 0 then {ok: 0, value: "", error: "[C0430] capsule '" + cap.name + "' requires capability '" + cap.cap_grant + "', caller holds '" + required_cap + "'"} else {ok: 1, value: cap.payload, error: ""}

fn capsule_rebind(cap, required_cap, new_payload) = let opened = capsule_open(cap, required_cap) in if opened.ok == 0 then {ok: 0, cap: cap, error: opened.error} else {ok: 1, cap: capsule_seal(cap.name, cap.cap_grant, new_payload), error: ""}

fn cap_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else cap_line_end(s, i + 1)

fn cap_serialize(cap) = "@capsule LUME_CAPSULE_1\n@name " + cap.name + "\n@grant " + cap.cap_grant + "\n@digest " + cap.digest + "\n@payload\n" + cap.payload

fn cap_starts(s, p) = if count(s) < count(p) then 0 else slice(s, 0, count(p)) == p

fn cap_deserialize(text) = let e1 = cap_line_end(text, 0) in let l1 = slice(text, 0, e1) in let e2 = cap_line_end(text, e1 + 1) in let l2 = slice(text, e1 + 1, e2) in let e3 = cap_line_end(text, e2 + 1) in let l3 = slice(text, e2 + 1, e3) in let e4 = cap_line_end(text, e3 + 1) in let l4 = slice(text, e3 + 1, e4) in let e5 = cap_line_end(text, e4 + 1) in let l5 = slice(text, e4 + 1, e5) in if l1 != "@capsule LUME_CAPSULE_1" or cap_starts(l2, "@name ") == 0 or cap_starts(l3, "@grant ") == 0 or cap_starts(l4, "@digest ") == 0 or l5 != "@payload" then {magic: "INVALID", name: "", cap_grant: "", payload: "", digest: ""} else {magic: "LUME_CAPSULE_1", name: slice(l2, 6, count(l2)), cap_grant: slice(l3, 7, count(l3)), digest: slice(l4, 8, count(l4)), payload: slice(text, e5 + 1, count(text))}

fn capsule_prng_step(seed) = (seed * 1103515245 + 12345) % 2147483648

fn capsule_proven_digest_for(name, cap_grant, payload, tick, seed, proof_digest) = capsule_sha256_text("LUME_CAPSULE_PROVEN_1:" + name + ":" + cap_grant + ":" + str(tick) + ":" + str(seed) + ":" + proof_digest + "\n" + payload)

fn capsule_seal_proven(name, cap_grant, payload, tick, seed, proof_digest) = {magic: "LUME_CAPSULE_PROVEN_1", name: name, cap_grant: cap_grant, payload: payload, tick: tick, seed: seed, proof_digest: proof_digest, digest: capsule_proven_digest_for(name, cap_grant, payload, tick, seed, proof_digest)}

fn capsule_verify_proven(cap) = if cap.magic != "LUME_CAPSULE_PROVEN_1" then 0 else if cap.name == "" or cap.cap_grant == "" or cap.proof_digest == "" or cap.tick < 0 then 0 else if cap.digest == capsule_proven_digest_for(cap.name, cap.cap_grant, cap.payload, cap.tick, cap.seed, cap.proof_digest) then 1 else 0

fn capsule_replay(cap, required_cap, expected_tick, expected_seed) = if capsule_verify_proven(cap) == 0 then {ok: 0, value: "", next_tick: cap.tick, next_seed: cap.seed, proof_digest: "", error: "[C0430] proven capsule integrity check failed for '" + cap.name + "'"} else if capsule_grant_allows(cap.cap_grant, required_cap) == 0 then {ok: 0, value: "", next_tick: cap.tick, next_seed: cap.seed, proof_digest: "", error: "[C0430] capsule '" + cap.name + "' requires capability '" + cap.cap_grant + "', caller holds '" + required_cap + "'"} else if cap.tick != expected_tick or cap.seed != expected_seed then {ok: 0, value: "", next_tick: cap.tick, next_seed: cap.seed, proof_digest: "", error: "[C0430] deterministic replay clock/seed mismatch for '" + cap.name + "'"} else {ok: 1, value: cap.payload, next_tick: cap.tick + 1, next_seed: capsule_prng_step(cap.seed), proof_digest: cap.proof_digest, error: ""}

## --- Wave 7 (#430): Full Content-Addressed E-Capsule Bundles (.lcaps) with VCR Effect Log & Independent Proof Replay ---

fn capsule_vcr_entry(eff, req, resp) = eff + "|" + capsule_sha256_text(req) + "=>" + resp

fn capsule_vcr_lookup_lines(text, i, key) = if i >= count(text) then "" else let e = cap_line_end(text, i) in let line = slice(text, i, e) in if cap_starts(line, key) == 1 then slice(line, count(key), count(line)) else capsule_vcr_lookup_lines(text, e + 1, key)

fn capsule_vcr_lookup(vcr_log, eff, req) = capsule_vcr_lookup_lines(vcr_log, 0, eff + "|" + capsule_sha256_text(req) + "=>")

fn capsule_bundle_cid_for(name, cap_grant, code_cid, input_sha, stdout_sha, tick, seed, vcr_sha, proof_digest, manifest_digest) = "lcaps:sha256:" + capsule_sha256_text("LUME_ECAPSULE_V2|" + name + "|" + cap_grant + "|" + code_cid + "|" + input_sha + "|" + stdout_sha + "|" + str(tick) + "|" + str(seed) + "|" + vcr_sha + "|" + proof_digest + "|" + manifest_digest)

fn capsule_bundle_create(name, cap_grant, src_code, input_data, expected_stdout, tick) = capsule_bundle_create2(name, cap_grant, src_code, input_data, expected_stdout, tick)

fn capsule_bundle_create2(name, cap_grant, src_code, input_data, expected_stdout, tick) = let code_cid = "cid:sha256:" + capsule_sha256_text(src_code) in let input_sha = capsule_sha256_text(input_data) in let stdout_sha = capsule_sha256_text(expected_stdout) in let vcr_sha = capsule_sha256_text("vcr:deterministic") in let proof_digest = "lcert:sha256:" + capsule_sha256_text("QF_LIA_CERT|" + src_code) in let manifest_digest = "manifest:sha256:" + capsule_sha256_text("LUME_MANIFEST|" + code_cid) in let cid = capsule_bundle_cid_for(name, cap_grant, code_cid, input_sha, stdout_sha, tick, 1337, vcr_sha, proof_digest, manifest_digest) in {magic: "LUME_ECAPSULE_V2", cid: cid, name: name, cap_grant: cap_grant, code_cid: code_cid, input_sha: input_sha, stdout_sha: stdout_sha, tick: tick, seed: 1337, vcr_sha: vcr_sha, proof_digest: proof_digest, manifest_digest: manifest_digest, expected_stdout: expected_stdout, src_code: src_code}

fn capsule_bundle_verify(b) = if b.magic != "LUME_ECAPSULE_V2" then {ok: 0, error: "[C0430] invalid e-capsule magic header"} else if b.code_cid != "cid:sha256:" + capsule_sha256_text(b.src_code) then {ok: 0, error: "[C0430] e-capsule source CID mismatch (code tampered)"} else if b.stdout_sha != capsule_sha256_text(b.expected_stdout) then {ok: 0, error: "[C0430] e-capsule stdout digest mismatch"} else if b.proof_digest != "lcert:sha256:" + capsule_sha256_text("QF_LIA_CERT|" + b.src_code) then {ok: 0, error: "[C0430] e-capsule independent lcert proof digest mismatch"} else let exp_cid = capsule_bundle_cid_for(b.name, b.cap_grant, b.code_cid, b.input_sha, b.stdout_sha, b.tick, b.seed, b.vcr_sha, b.proof_digest, b.manifest_digest) in if b.cid != exp_cid then {ok: 0, error: "[C0430] e-capsule bundle CID mismatch"} else {ok: 1, error: ""}

fn capsule_bundle_encode(b) = "@lcaps LUME_ECAPSULE_V2\n@cid " + b.cid + "\n@name " + b.name + "\n@grant " + b.cap_grant + "\n@code_cid " + b.code_cid + "\n@input_sha " + b.input_sha + "\n@stdout_sha " + b.stdout_sha + "\n@tick " + str(b.tick) + "\n@seed " + str(b.seed) + "\n@vcr_sha " + b.vcr_sha + "\n@proof_digest " + b.proof_digest + "\n@manifest_digest " + b.manifest_digest + "\n@stdout_len " + str(count(b.expected_stdout)) + "\n@payload\n" + b.expected_stdout + b.src_code

fn cap_kv_find(text, i, prefix) = if i >= count(text) then "" else let e = cap_line_end(text, i) in let line = slice(text, i, e) in if line == "@payload" then "" else if cap_starts(line, prefix) == 1 then slice(line, count(prefix), count(line)) else cap_kv_find(text, e + 1, prefix)

fn cap_payload_offset(text, i) = if i >= count(text) then count(text) else let e = cap_line_end(text, i) in let line = slice(text, i, e) in if line == "@payload" then e + 1 else cap_payload_offset(text, e + 1)

fn capsule_bundle_decode(text) = let e1 = cap_line_end(text, 0) in if slice(text, 0, e1) != "@lcaps LUME_ECAPSULE_V2" then {magic: "INVALID", cid: "", name: "", cap_grant: "", code_cid: "", input_sha: "", stdout_sha: "", tick: 0, seed: 0, vcr_sha: "", proof_digest: "", manifest_digest: "", expected_stdout: "", src_code: ""} else let out_len = toint(cap_kv_find(text, 0, "@stdout_len ")) in let poff = cap_payload_offset(text, 0) in let exp_out = slice(text, poff, poff + out_len) in let src = slice(text, poff + out_len, count(text)) in {magic: "LUME_ECAPSULE_V2", cid: cap_kv_find(text, 0, "@cid "), name: cap_kv_find(text, 0, "@name "), cap_grant: cap_kv_find(text, 0, "@grant "), code_cid: cap_kv_find(text, 0, "@code_cid "), input_sha: cap_kv_find(text, 0, "@input_sha "), stdout_sha: cap_kv_find(text, 0, "@stdout_sha "), tick: toint(cap_kv_find(text, 0, "@tick ")), seed: toint(cap_kv_find(text, 0, "@seed ")), vcr_sha: cap_kv_find(text, 0, "@vcr_sha "), proof_digest: cap_kv_find(text, 0, "@proof_digest "), manifest_digest: cap_kv_find(text, 0, "@manifest_digest "), expected_stdout: exp_out, src_code: src}

fn capsule_bundle_replay(b, replayed_stdout, cert_ok) = let v = capsule_bundle_verify(b) in if v.ok == 0 then {ok: 0, cid: b.cid, tick: b.tick, next_tick: b.tick, error: v.error} else if cert_ok == 0 then {ok: 0, cid: b.cid, tick: b.tick, next_tick: b.tick, error: "[C0430] independent QF_LIA certificate re-derivation failed"} else if replayed_stdout != b.expected_stdout then {ok: 0, cid: b.cid, tick: b.tick, next_tick: b.tick, error: "[C0430] bit-exact replay output mismatch"} else {ok: 1, cid: b.cid, tick: b.tick, next_tick: b.tick + 1, error: ""}
