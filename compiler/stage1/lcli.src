## lcli.src -- Self-Hosted Lume CLI Control Plane (`#204`, Track T / P28).
## Implements the Lume CLI control-plane commands (`version`, `help`, `describe`,
## `compile-json`, `pkg-init`, `pkg-lock`, `pkg-tree`, `evolve-propose`) in Lume,
## compiled to native ELF by `lumec` + `lasm` and verified in the `stage2 == stage3`
## bootstrap fixpoint (`scripts/bootstrap.src`, `scripts/zero_c.src`). Surface
## `.lume` checking and testing use the seed lexer/parser/resolver directly.

fn cli_is_ws(c) = c == " " or c == "\t" or c == "\r"
fn cli_ltrim(s, i, n) = if i >= n then "" else if cli_is_ws(at(s, i)) then cli_ltrim(s, i + 1, n) else slice(s, i, n)
fn cli_rtrim(s, n) = if n <= 0 then "" else if cli_is_ws(at(s, n - 1)) or at(s, n - 1) == "\n" then cli_rtrim(s, n - 1) else slice(s, 0, n)
fn cli_trim(s) = let s1 = cli_ltrim(s, 0, count(s)) in cli_rtrim(s1, count(s1))
fn cli_chomp(s) = let n = count(s) in if n == 0 then "" else if at(s, n - 1) == "\n" then (if n >= 2 and at(s, n - 2) == "\r" then slice(s, 0, n - 2) else slice(s, 0, n - 1)) else if at(s, n - 1) == "\r" then slice(s, 0, n - 1) else s

fn cli_startswith(s, p) = let n = count(s) in let m = count(p) in if n < m then 0 else if slice(s, 0, m) == p then 1 else 0
fn cli_lineend(s, i, n) = if i >= n then n else if at(s, i) == "\n" then i + 1 else cli_lineend(s, i + 1, n)
fn cli_lines(s, i, n) = if i >= n then Nil else let le = cli_lineend(s, i, n) in Cons(cli_chomp(slice(s, i, le)), cli_lines(s, le, n))
fn cli_find_sp(s, i, n) = if i >= n then n else if at(s, i) == " " or at(s, i) == "\t" then i else cli_find_sp(s, i + 1, n)

fn cli_isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0

fn cli_joinsep(xs, sep) = match xs
    Nil        => ""
    Cons(h, t) => if cli_isnil(t) == 1 then h else h + sep + cli_joinsep(t, sep)

fn cli_jesc1(c) = if c == "\"" then "\\\"" else if c == "\\" then "\\\\" else if c == "\n" then "\\n" else if c == "\r" then "\\r" else if c == "\t" then "\\t" else c
fn cli_jesc_i(s, i, n) = if i >= n then "" else cli_jesc1(at(s, i)) + cli_jesc_i(s, i + 1, n)
fn cli_jesc(s) = cli_jesc_i(s, 0, count(s))

fn cli_count_nl(s, i, n) = if i >= n then 0 else (if at(s, i) == "\n" then 1 else 0) + cli_count_nl(s, i + 1, n)
fn cli_strip_nl(s, n) = if n <= 0 then "" else if at(s, n - 1) == "\n" or at(s, n - 1) == "\r" then cli_strip_nl(s, n - 1) else slice(s, 0, n)

fn cli_version() = "lume 1.1.0 (edition 2026)"

## The usage lines below are checked against the dispatcher table of lume_driver.src by the cli_parity_gate of
## tests/cli/driver_gate.src, in both directions: a command, alias, option, subcommand or value written here must be in
## the table (`lume help --json`), and everything in the table must be written here, on a line of its own command.
## Keep one `lume <command>` synopsis per line and put the description after it.
fn cli_help() = "lume 1.1.0 -- the AI-first & Human-Friendly programming language (edition 2026 / Wave 12 — 122 Sovereign Domains)\n\nusage:\n" +
"  lume manual|man|guide [--pt|--pt-br|--pt-BR|--pt_br|--pt_BR|--en|--en-us|--en-US] [pt|pt-BR|pt-br|pt_BR|pt_br|en|en-US|en-us] [--json] [--export <file.md>] [overview|syntax|types|contracts|effects|stdlib|targets|commands|examples|errors|all] built-in programmer's manual (EN & PT-BR); `lume manual-pt|man-pt|guia` starts in PT-BR\n" +
"  lume help|--help|-h                       this text; `lume help --json` prints the command table (names, aliases, options, subcommands, values) as JSON (native driver only, x86-64 Linux: on other hosts scripts/lume_legacy.sh prints this text and does not implement it)\n" +
"  lume help|--help|-h [--pt|--pt-br|--pt-BR|--pt_br|--pt_BR|--en|--en-us|--en-US] [pt|pt-BR|pt-br|pt_BR|pt_br|en|en-US|en-us] [--export <file.md>] <chapter> one chapter of the built-in manual (the same as lume manual; native driver only, the legacy script serves lume manual instead)\n" +
"  lume <command> --help                     print the synopsis of one command, generated from the table the driver dispatches on (native driver only, x86-64 Linux: on other hosts scripts/lume_legacy.sh prints this text and does not implement it)\n" +
"  lume build [--target <triple>] [--incremental] [--memory] [--protect [none|standard|hardened|max]] [--profile <debug|release|ship>] [--lsym <file>] [--link <lib>] [-l <lib>] [--emit-c-header <file.h>] [--build-timeout-ms <n>] <file.src> [-o <out>] compile native/target artifacts\n" +
"  lume build [--dwarf|-g] [--keep-proven-checks|--critical] <file.src> [-o <out>] DWARF v4 line table and symbols; keep the run-time check of every proven ensures (x86_64-linux-elf only; these options combine only with each other and with -o)\n" +
"  lume build --target safetensors [--entry <fn>] <file.src> -o <out.safetensors> neural cartridge of a pure integer function\n" +
"  lume targets|--targets [--json]           list every target triple lume build accepts (ISA x container x OS/ABI, incl. aarch64-*, riscv*); safetensors is a build target outside this list\n" +
"  lume mir    <target> <file.src>           emit target-independent SSA LumeMIR intermediate representation\n" +
"  lume package <apk|ipa|iso|uefi> <file.src> -o <out> package mobile store or bootable OS images in one command; the JSON reports `bootable_el_torito` as read from the written image (true for an iso only)\n" +
"  lume run   [--memory] <file.src|file.lumb|file.lume> [args] run a Lume program (native executable or portable LUMB bytecode)\n" +
"  lume test  <file.src|file.lume>...        discover and run unit tests (`fn test_*()` and runtime contracts)\n" +
"  lume doc   [--json] <file.src|file.lume>  render module & item documentation + contracts (Markdown or JSON)\n" +
"  lume fmt   [--check|--stdout] <file>...   format Lume source files in place, check, or write canonical stdout\n" +
"  lume pkg   <init|check|manifest|lock|verify|tree> [dir] manage lume.toml and the SHA-256 lume.lock\n" +
"  lume pkg   check-rot <old.src> <new.src> <shared.src> detect contract rot of a shared dependency\n" +
"  lume pkg   <publish|audit> [dir]          verified registry publication and audit (served by the POSIX shim, scripts/lume_legacy.sh)\n" +
"  lume agent <check|compile|fill|prove|ast|expand|symbols|eval|witness|repair|impact|hashes|grammar|project|bind|skeleton|cegis|synthesize|trace|heal|morph|kernel|c-export|replay> [--json] <file.src> query the in-process compiler-as-a-service JSON protocol\n" +
"  lume agent <lineage|patch|patch-fn|diff-semver|equiv|check-rot> <file.src> [more arguments] the multi-file queries of the same protocol\n" +
"  lume agent <capability> <file>            run the sovereign capability command of that name on a file\n" +
"  lume adapt c [--preprocess] [--json] <header.h> [-o <out.src>] [--output <out.src>] generate strict [I0003] fail-closed C ABI adapters (c-raw: lume adapt c-raw <header.h> skips the header normalisation)\n" +
"  lume adapt <rust|python|js|ts|node|go|java|csharp|dotnet|sql|openapi|polyglot|all> [file] polyglot adapter report of the Chameleon engine\n" +
"  lume lsp   [--stdio|--json] [file.src]    run JSON-RPC-over-stdio Language Server (or --json one-shot analysis)\n" +
"  lume dap   [--stdio|--json] [file.src]    run JSON-RPC-over-stdio Debug Adapter with DWARF v4/v5 & stepBack replay (or --json one-shot)\n" +
"  lume repl  [--kernel|--json] [file.src]   interactive read-eval-print loop (:chameleon, :camaleao, :no-alloc, :dwarf, :lockstep, :qualify) & Jupyter kernel\n" +
"  lume prove [--json] [--diff|--share|--compositional] <file.src> [new.src] verify requires/ensures/invariant/law/wcet/@no_alloc contracts statically\n" +
"  lume certify [--json] <file.src>          emit machine-checkable proof certificate & Lume Verified badge\n" +
"  lume verify-cert [--json] <certificate.json> independently verify a proof certificate via the minimal proof kernel\n" +
"  lume verify-cert --check-source <file.src> <certificate.json> the same, plus the source-to-obligation binding check\n" +
"  lume proof-cache <self-test|check|store> [<file.src>] [<cache_dir>] [--require-all-hits] sub-30ms SHA-256 incremental proof-certificate cache\n" +
"  lume tv-rt-gate [--stride <n>]            mutation gate of the runtime-helper verifier: every behaviour-changing mutant of a helper must be rejected\n" +
"  lume smt-cert-gate [--require-z3] [--solver <none>] [--chameleon] [--sites <n>] [--corpus <dir>] gate of the certificate checker: fixed controls, fresh ltv certificates, their mutants, and z3 as ground truth when it is installed\n" +
"  lume lcaas-scale-gate [--full] [--modes <a,b>] [--fams <x,y>] [--reps <k>] [--timeout <ms>] [--lcaas <path>] complexity regression gate of lcaas: the time may not grow faster than the compiler alone when the input doubles (--full prints the table of every mode and family, restricted by --modes and --fams)\n" +
"  lume cli-parity                           the command-line parity gate alone: the command table, this text, both manuals, README.md and skills/lume/SKILL.md may not drift (needs build/bin/native_driver_gate, i.e. a source checkout)\n" +
"  lume synergy-gate                         end-to-end cross-module gate: prove, proof-cache, certify, source-bound verify-cert, stack, a critical build with DWARF, tv with tv-rt and smt-check, mcdc, safety-envelope (clean-room channel B, split bundle, safetensors) and the signed dossier in one chain, with a tamper check per link\n" +
"  lume realtime-gate|concurrency-gate|crypto-gate|multi-arch-gate|safetensors-gate|dwarf-cache-gate|cert-source-gate acceptance gates (@no_alloc real-time, [E0305]/[E0306] linear concurrency, cryptography + TLS 1.3, AArch64/RISC-V kernel back ends, neural cartridges, DWARF + proof cache, certificate-to-source binding)\n" +
"  lume capsule <seal|verify|replay|open> <file> [-o <out.lcaps>] seal, verify, replay or open tamper-evident deterministic execution capsules\n" +
"  lume pack|unpack <in> -o <out>            compress any file with the compactor and restore it: LZ4 block format behind a 20-byte header (magic `LZ1`, length, checksum); it is not an LZ4 frame, so other lz4 tools do not read the file\n" +
"  lume symbolize <file.lsym> <query>        resolve P33 obfuscated symbol, diagnostic ID, or instruction address\n" +
"  lume patch-fn <file.src> <fn> <patch.src> AST surgical single-function replacement with proof re-verification\n" +
"  lume trace <file.src>                     emit structured JSON execution trace\n" +
"  lume diff-semver <old.src> <new.src>      compute mathematical SemVer bump (MAJOR/MINOR/PATCH) from contracts\n" +
"  lume genesis <app_name> [domain]          synthesize full-stack verified application across 8 targets\n" +
"  lume heal  <file.src>                     autonomous counterexample-driven contract self-healing\n" +
"  lume equiv <spec.src> <fast.src>          prove formal algorithmic equivalence & superoptimize\n" +
"  lume morph <legacy_file>                  transmute legacy SQL/Python/C/OpenAPI into proven Lume-Core\n" +
"  lume neural-kernel [--json] <file.src>    synthesize differentiable CUDA PTX, SPIR-V, Verilog & VHDL RTL\n" +
"  lume intent <build|run|verify|status|clean> <file.intent> [--cache <cache.src>] [-o <out>] [--output <out>] [--json] compile, run, verify or clean a verified intent specification and its proof cache\n" +
"  lume synapse|orchestrate [file.src]       Universal Module Orchestrator (LumeSynapse real-time cross-organ bus & omni-warming)\n" +
"  lume recall [file.src|query]              query Proactive Sovereign Memory O(1) cache & SHA-256 anti-tamper seals\n" +
"  lume reversa|reverse-engineer|reveng|decompile [target] unified binary (ELF64/PE64/UEFI/Mach-O/WASM) & 7-phase SDD reverse engineering (soul.md, Mermaid, 3D Code City SVG, Lume-Core)\n" +
"  lume pingora|proxy|cdn|load-balancer [target] Pingora-Lume Edge Proxy Engine v1.0 (TinyUFO cache, Ketama + P2C, dual-window rate limiter, stampede lock, TLS 1.3 pool, circuit breaker, 7-phase ProxyHttp)\n" +
"  lume egm|elephant-goldfish|goldfish-review|drift-report|heilmeier [target] EGM-Lume Elephant-Goldfish Model Engine v1.0 (8-pillar Heilmeier Catechism, zero-context Goldfish 5-stage review, anti-glazing scanner, Reversa SDD drift report)\n" +
"  lume ncm|next-concept|ncm-quantize|ncm-generate|ncm-solve [target] NCM-Lume Next-Concept Modeling Engine v1.0 (MS-RVQ scales [4,8,16,32,64], Tied Codebook Head, Block-Diagonal Attention + Reset RoPE, CFG parallel decoding, Sudoku constraint solver)\n" +
"  lume opentpu|tpu|otpu-asm|k-smooth|stream-se|tpu-scoreboard [target] OpenTPU-Lume Systolic AI Accelerator & ISA Engine v1.0 (openTPU ISA v1 MXU replay, QACT Sa*2^-da + FP4 4.25b/w, K-Smoothing outlier migration, 5-stage STREAM SE 0x13, WAITW MoE PCIe overlap, 0-ULP RTL roofline)\n" +
"  lume continuum|nexus|billion-context|acp|ecc-shield|agentshield|bend-laws|ai-memory|notebook|podcast|doory|canvas-crdt [target] Lume Continuum Nexus v1.0 (ECC AgentShield & Bayesian instincts, Bend tree laws, Billion-Context ACP reversible pruning, AI-Memory decay & wiki, Quota LLM router, Open-Notebook 3-speaker WAV podcast, Doory CRDT slide)\n" +
"  lume quantum-nexus|quantum-zx|quantum-stabilizer|quantum-qec|quantum-vqe|quantum-uncompute|silq|quizx|stim [target] Lume Sovereign Quantum Nexus v1.0 (Silq qfree uncomputation & linear Qubit, QuiZX/PyZX spider fusion, Google Stim stabilizer tableau, Surface Code [[9,1,3]] QEC, Catalyst parameter-shift VQE & .qbin pulses)\n" +
"  lume chameleon|camaleao|polyglot|ffi-bridge [target] Lume Universal Chameleon Polyglot Interop v1.0 (C/C++ ABI, Rust cdylib, Python C-API + DLPack, Node.js/JS/TS/WASM, Go c-shared, Java JNI, C#/.NET P/Invoke, SQL & OpenAPI/gRPC with [I0003] fail-closed contracts)\n" +
"  lume unified-field|ufe|subsea [target]    Lume Sovereign Unified Field Engine (7-DOF DLS kinematics, 3D Laplace Red-Black SOR, GNRON swirl attenuation, capsule self-collision, IEEE-754 finite guard, 5-sigma Mahalanobis + Joseph EKF, stiction/RUL, swarm separation, IAPWS-IF97 + Carnot, 1 kHz LatencyMonitor & Wave 3 Subsea Catenary/VIV/DNV-H001/Buhlmann/Well-Kill/B31G)\n" +
"  lume singularity|ote|transition-engine [target] 2nd-Order Dynamical Transition Engine & Singularity Boundary Omega (underdamped/overdamped step ID & zeta estimator, Power Triangle S/P/Q/cosPhi, tau_max = Tm/4 & margin zones, Nyquist guard, cascade decoupling, gain retuning, 9 leverage-ordered prescriptions & Wave 3 Bayes SPC/CUSUM/CPM/k-Anonymity/PAVA)\n" +
"  lume net-sentinel|iec62443|conduite|omega-mesh [target] NetSentinel IEC 62443, Conduite HA & Omega-Mesh P2P Guard (Purdue L0..L4 + L3.5 DMZ conduit guard, OT firewall policy audit, read-only DCS guard, tri-state quality, 1e12 finite sentinel, Conduite HA/GOOSE/Storm & Omega-Mesh Frame/NAT/DHT/Raft/TOFU/Mux)\n" +
"  lume lumeputer|lumepu|qwenputer|weight-vm|in-weights-npu [target] LumePuter & LumePU Weight-Compiled RV32IM_Zba + Bignum + Vector/Matrix NPU (VDOT/SMAQA/VX VMAT) & Zero-Drift Gated-DeltaNet RAM Engine (11/13 layers, SwiGLU exact ReLU, Ballast B=10000, stories260K in-weights, 17 modules, build targets safetensors and lumeputer-rv32im-weights, 122/122 Sovereign Domains)\n" +
"  lume lumeputer|lumepu|qwenputer|weight-vm|in-weights-npu <exec|run> <kernel.src> --fn <f> --args <a,b,..> [--budget <cycles>] run a kernel on the LumePuter RV32IM monitor alone\n" +
"  lume self-prove|prove-all|verify-all [--json] run the proof batteries: certify 13 modules with lcaas + the lcert kernel (obligation counts measured by the run, none may stay runtime-checked), unit tests, [K0005]/[K0006]/[C0009]/SRA probes, ltv over lstd.src, one LumePuter lockstep vote\n" +
"  lume tv|translation-validate <file.src> [--fn <name>] [--exec] [--json] translation validation of the emitted x86-64 against the AST, per integer function (ltv); SMT-LIB2 + Lean 4 certificates in build/certification/proofs; for a `@secret fn` also the machine-level constant-time check, transitive over every routine it reaches by `call` (diagnostic C0010; a `@secret` + `@no_alloc` constant-time kernel is lowered branch-free, [C0011] refuses what cannot be)\n" +
"  lume stack <file.src> [--fn <f[,g]>] [--asm <file.s>] [--critical] [--json] static worst-case stack bytes of `@no_alloc` functions, computed on the emitted x86-64 text (lstack); the bound on the proven paths is conditional on the [E0210] range proofs; exit 3 when a bound is rejected\n" +
"  lume smt-check <file.smt2>... [--dir <dir>] [--raw] [--budget <n>] [--verbose] [--json] check the SMT-LIB2 certificates of lume tv with the clean-room native checker (lsmt, no code shared with ltv); exit 0 only when every file is unsat\n" +
"  lume tv-rt <file.src> [--asm <file.s>] [--canon] [--json] verify the emitted machine code of the integer runtime helpers (the axioms of lume tv) against their specification by symbolic execution (ltv_rt); the allocator and the trap tail stay axioms\n" +
"  lume x509 verify --chain <leaf.der,ca.der> --anchor <root.der> --now <unix-seconds> [--json] X.509 v3 path validation (Ed25519 only, DER or PEM files, at most 8 certificates); exit 0 valid, 3 invalid; no host name matching, no revocation\n" +
"  lume x509 show <certificate>              the parsed fields of one certificate as JSON (the signature is not checked by show)\n" +
"  lume entropy [--bytes <n>] [--source <device>] [--json] bytes of the OS random source (/dev/urandom), released only after the health checks: they detect a dead or stuck source, they do not certify entropy\n" +
"  lume mcdc <file.src> [--fn <name>] [--exec] [--budget <vectors>] [--json] decision + MC/DC obligations with witnesses run on the real binary (lmcdc)\n" +
"  lume bundle <file.src>                    print the path of the self-contained bundle of a source (the text tv and mcdc read)\n" +
"  lume safety-envelope|lockstep <kernel.src> --fn <f> --args <a,b,..> [--budget <cycles>] [--timeout-ms <n>] [--ltv <path>] [--ltv-timeout-ms <n>] [--log <file>] [--work <dir>] [--inject <kind:params>] [--reset] 2oo2 lockstep: native x86-64 against the LumePuter RV32IM monitor, whose compiler is a clean-room channel B (its own lexer, parser, checker and code generator, no code of lumec); fail-closed latch\n" +
"  lume safety-envelope|lockstep --gate      the fault-injection gate of the envelope (bit flips, RAM / register / ROM upsets, source and code-generator mutants, cycle budget, certificate)\n" +
"  lume safety-envelope|lockstep <kernel.src> --fn <f> --split <outdir> [--budget <cycles>] export the split bundle: channel A as x86-64, AArch64 and RV64 programs, channel B as a bare-metal RV32IM image, and manifest.json with the SHA-256 of each\n" +
"  lume safety-envelope|lockstep --split-run --manifest <manifest.json> --seq <n> --args <a,b,..> --cmd-a <command> --cmd-b <command> [--cmd-c <command>] [--frame-timeout-ms <n>] [--log <file>] [--reset] vote over the exported programs through the frame protocol (run on this host and on QEMU, not on two boards)\n" +
"  lume safety-envelope|lockstep --split-verify <manifest.json> re-hash every artifact of a split bundle against its manifest\n" +
"  lume tv-gate [--stride <n>]               certification gate: ltv must reject every behaviour-changing assembly mutant\n" +
"  lume soak|soak-battle|battle [--rounds <n>] [--procs <n>] [--seed <n>] soak battle + hash-chained telemetry ledger\n" +
"  lume prover-fuzz [--n <k>] [--seed <s>]   false-theorem fuzzer against lumec, lcaas and the lcert kernel\n" +
"  lume qualify|qualification [--quick] [--sign-key <file>] tool qualification battery and dossier (TOR, TQP, RTM, evidence) in build/certification; developer evidence, not a qualification\n" +
"  lume qualify|qualification --verify       re-check the hash chain and the Ed25519 signature of build/certification\n" +
"  lume ui-layout|@ui-layout|consult|laws|constitution|sanctuary|replicate|swarm-evolve|bios-core|firmware|kernel-core|daemon-triad|hot-evolve|live-cockpit|self-build|interface|portal|chat|crypto-engine|cripto|blockchain|sensory-cortex|peripherals|file-indexer|pc-master|omni-reader|wireshark|packet-dissect|switch-fabric|scada-ics|modbus|dnp3|iec104|iec61850|gfx|render-3d|scada-hmi|ied-protection|memory|os-control|optimize|doctor|net-omni|network|web-research|internet|search|hive|central-core|ventral-core|saturate-contracts|fuse-mir-neural|triad-orchestrate|evolve-all|multimodal|talk|voice|listen|vision [--json] [sync|status|file] Wave 9-12 Sovereign capabilities; these and the engine commands above (synapse ... in-weights-npu) run on their built-in default when no file is given, and take sync or status in its place\n" +
"  lume synapse|orchestrate|recall|reversa|reverse-engineer|reveng|decompile|pingora|proxy|cdn|load-balancer|egm|elephant-goldfish|goldfish-review|drift-report|heilmeier|ncm|next-concept|ncm-quantize|ncm-generate|ncm-solve|opentpu|tpu|otpu-asm|k-smooth|stream-se|tpu-scoreboard|continuum|nexus|billion-context|acp|ecc-shield|agentshield|bend-laws|ai-memory|notebook|podcast|doory|canvas-crdt|quantum-nexus|quantum-zx|quantum-stabilizer|quantum-qec|quantum-vqe|quantum-uncompute|silq|quizx|stim|chameleon|camaleao|polyglot|ffi-bridge|unified-field|ufe|subsea|singularity|ote|transition-engine|net-sentinel|iec62443|conduite|omega-mesh|lumeputer|lumepu|qwenputer|weight-vm|in-weights-npu [--json] [sync|status|file] the same options for the engine commands\n" +
"  lume awaken|morph-ast|quantum|bio-dna|cosmic-tmr|hologram|chronos|omega-net|llm-forge [--json] <file.src> Wave 9 Sovereign capabilities that need a source file\n" +
"  lume mcp   [--json] <file.src>            serve Model Context Protocol (MCP) tools & diagnostics for AI agents\n" +
"  lume registry <publish|resolve|discover> [--json] [--store <dir>] [--target <triple>] [--adapter <name>] [--source <file>] [--proof <file>] [--tests <file>] [--cid <cid>] [--capability <name>] [--contract-signature <sig>] verify, publish, discover & resolve content-addressed components\n" +
"  lume mesh  [--json] <request.mesh>        negotiate intent and run validated AST transactions (P0)\n" +
"  lume economy --output <results.json> [--artifacts <dir>] [--self-test] execute real compilation, proof, native execution & maintenance evidence\n" +
"  lume evolve <list|goals|budgets|propose|apply|grow|verify|status|check|approve> [proposal] [--domain <domain>] [--by <maintainer>] [--sig <signature>] [--target <file>] [--root <dir>] [--json] run self-evolution gates, Ed25519 signature check & apply loop\n" +
"  lume self  [status|verify|update|prove|prove-all] [--prefix <dir>] [--from <bin-dir>] [--json] verify SHA-256 install manifest, update the prebuilt zero-C toolchain, or run the proof batteries (no action: status)\n" +
"  lume check [--json] <file.lume|file.src>  run static semantic checks\n" +
"  lume compile [--json] [--run] <file.src>  compile-as-a-service: structured {{ok, diagnostics, asm, stdout}}\n" +
"  lume describe|--describe [--json]         emit machine-readable language self-description for AI agents\n" +
"  lume bootstrap|zero-c|amalgamate|seed|clean maintenance of a source checkout: runs build/bin/lume_make with that target\n" +
"  lume --version|version                    print version"

fn cli_describe() = "{\n  \"language\": \"Lume\",\n  \"stage\": \"self-hosted (lumec + lasm + lcli)\",\n  \"version\": \"1.1.0\",\n  \"edition\": \"2026\",\n  \"audience\": \"authored by AI, reviewed by humans\",\n  \"sovereign_domains\": 122,\n  \"keywords\": [\"fn\", \"pub\", \"total\", \"llm\", \"kernel\", \"extern\", \"law\", \"rule\", \"model\", \"effect\", \"let\", \"var\", \"const\", \"mut\", \"own\", \"qfree\", \"type\", \"enum\", \"record\", \"match\", \"if\", \"then\", \"else\", \"elif\", \"in\", \"use\", \"comptime\", \"quote\", \"unquote\", \"splice\", \"requires\", \"ensures\", \"invariant\", \"with\", \"handler\", \"scope\", \"spawn\", \"print\", \"and\", \"or\", \"not\"],\n  \"attributes\": [\"@bound\", \"@no_alloc\", \"@secret\", \"@freestanding\", \"@ui-layout\", \"@neural-kernel\"],\n  \"operators\": [\"+\", \"-\", \"*\", \"/\", \"%\", \"==\", \"!=\", \"<\", \">\", \"<=\", \">=\", \"=\", \"->\", \"=>\", \"|>\"],\n  \"subcommands\": [\"version\", \"help\", \"manual\", \"man\", \"guide\", \"manual-pt\", \"man-pt\", \"guia\", \"describe\", \"targets\", \"build\", \"run\", \"test\", \"check\", \"compile\", \"fmt\", \"doc\", \"prove\", \"certify\", \"verify-cert\", \"proof-cache\", \"pkg\", \"registry\", \"agent\", \"adapt\", \"lsp\", \"dap\", \"repl\", \"mcp\", \"intent\", \"mesh\", \"economy\", \"evolve\", \"self\", \"self-prove\", \"prove-all\", \"verify-all\", \"capsule\", \"pack\", \"unpack\", \"package\", \"mir\", \"genesis\", \"neural-kernel\", \"symbolize\", \"patch-fn\", \"trace\", \"diff-semver\", \"heal\", \"equiv\", \"morph\", \"tv\", \"translation-validate\", \"mcdc\", \"bundle\", \"safety-envelope\", \"lockstep\", \"tv-gate\", \"soak\", \"soak-battle\", \"battle\", \"prover-fuzz\", \"qualify\", \"qualification\", \"realtime-gate\", \"concurrency-gate\", \"crypto-gate\", \"multi-arch-gate\", \"safetensors-gate\", \"dwarf-cache-gate\", \"cert-source-gate\", \"bootstrap\", \"zero-c\", \"amalgamate\", \"seed\", \"clean\", \"qwenputer\", \"lumeputer\", \"lumepu\", \"weight-vm\", \"in-weights-npu\", \"ui-layout\", \"@ui-layout\", \"unified-field\", \"ufe\", \"singularity\", \"ote\", \"transition-engine\", \"net-sentinel\", \"iec62443\", \"conduite\", \"omega-mesh\", \"subsea\", \"consult\", \"laws\", \"constitution\", \"sanctuary\", \"replicate\", \"swarm-evolve\", \"bios-core\", \"firmware\", \"kernel-core\", \"daemon-triad\", \"hot-evolve\", \"live-cockpit\", \"self-build\", \"reverse-engineer\", \"reveng\", \"decompile\", \"reversa\", \"pingora\", \"proxy\", \"cdn\", \"load-balancer\", \"egm\", \"elephant-goldfish\", \"goldfish-review\", \"drift-report\", \"heilmeier\", \"ncm\", \"next-concept\", \"ncm-quantize\", \"ncm-generate\", \"ncm-solve\", \"opentpu\", \"tpu\", \"otpu-asm\", \"k-smooth\", \"stream-se\", \"tpu-scoreboard\", \"continuum\", \"nexus\", \"billion-context\", \"acp\", \"ecc-shield\", \"agentshield\", \"bend-laws\", \"ai-memory\", \"notebook\", \"podcast\", \"doory\", \"canvas-crdt\", \"quantum-nexus\", \"quantum-zx\", \"quantum-stabilizer\", \"quantum-qec\", \"quantum-vqe\", \"quantum-uncompute\", \"silq\", \"quizx\", \"stim\", \"chameleon\", \"camaleao\", \"polyglot\", \"ffi-bridge\", \"interface\", \"portal\", \"chat\", \"crypto-engine\", \"cripto\", \"blockchain\", \"sensory-cortex\", \"peripherals\", \"file-indexer\", \"pc-master\", \"omni-reader\", \"wireshark\", \"packet-dissect\", \"switch-fabric\", \"scada-ics\", \"modbus\", \"dnp3\", \"iec104\", \"iec61850\", \"gfx\", \"render-3d\", \"scada-hmi\", \"ied-protection\", \"memory\", \"recall\", \"synapse\", \"orchestrate\", \"os-control\", \"optimize\", \"doctor\", \"net-omni\", \"network\", \"web-research\", \"internet\", \"search\", \"hive\", \"central-core\", \"ventral-core\", \"saturate-contracts\", \"fuse-mir-neural\", \"triad-orchestrate\", \"evolve-all\", \"multimodal\", \"talk\", \"voice\", \"listen\", \"vision\", \"awaken\", \"morph-ast\", \"quantum\", \"bio-dna\", \"cosmic-tmr\", \"hologram\", \"chronos\", \"omega-net\", \"llm-forge\"
],\n  \"targets\": [\"x86_64-linux-elf\", \"aarch64-linux-elf\", \"aarch64-linux-gnu\", \"aarch64-elf\", \"aarch64-none-elf\", \"aarch64-macos-macho\", \"x86_64-macos-macho\", \"x86_64-windows-pe\", \"x86_64-windows-gui\", \"x86_64-windows-gui-protected\", \"riscv32-none-elf\", \"riscv32-none-bin\", \"riscv64-none-elf\", \"riscv64-none-bin\", \"riscv64-linux-gnu\", \"riscv64-linux-elf\", \"aarch64-none-ihex\", \"riscv64-none-ihex\", \"x86_64-none-ihex\", \"x86_64-none-raw\", \"wasm32-wasi\", \"lumb\", \"nvptx64-nvidia-cuda\", \"spirv64-vulkan-compute\", \"arm-none-cortexm\", \"avr-none-elf\", \"avr-none-ihex\", \"xtensa-esp32-elf\", \"xtensa-none-ihex\", \"verilog-rtl\", \"vhdl-rtl\", \"aarch64-ios-macho\", \"aarch64-android-elf\", \"wasm32-web-dom\", \"x86_64-uefi-pe\", \"qasm3-quantum\", \"dna-quaternary\", \"lumeputer-rv32im-weights\", \"safetensors\"],\n  \"diagnostics_protocol\": \"lume agent check|compile|fill|prove|ast|expand|symbols|eval|witness|repair|impact|hashes|grammar|project|bind|skeleton|cegis|synthesize|trace|heal|morph|kernel|c-export|replay|lineage|patch|patch-fn|diff-semver|equiv|check-rot emits structured JSON diagnostics with codes, spans, counterexamples, AST hashes, and deterministic fix-its\",\n  \"workflow\": \"write .src -> `lume manual` / `lume agent check` / `lume prove` -> read diagnostics/witness -> `lume heal` -> `lume build [--dwarf|-g] [--keep-proven-checks|--critical]` (native ELF/Mach-O/PE/UEFI/APK/IPA/ISO/IHEX/PTX/SPIR-V/HDL/WASM/LUMB/QASM3/DNA4/Safetensors via lumec + lasm + ltarget + lneural_cartridge, zero C, zero as/ld)\",\n  \"spec\": \"docs/03-specification.md\",\n  \"self_description\": \"docs/08-ai-first.md\",\n  \"built_in_manual\": \"lume manual [--pt] [overview|syntax|types|contracts|effects|stdlib|targets|commands|examples|errors|all]\"\n}"

fn cli_compile_json(st) = let ok_s = if st.exit_code == 0 then "true" else "false" in let alines = if st.asm_lines >= 0 then st.asm_lines else cli_count_nl(st.asm, 0, count(st.asm)) in let base = "{\"ok\":" + ok_s + ",\"exit\":" + str(st.exit_code) + ",\"asm_lines\":" + str(alines) + ",\"diagnostics\":\"" + cli_jesc(cli_strip_nl(st.diag, count(st.diag))) + "\"" in if st.ran == 1 then base + ",\"ran\":true,\"run_exit\":" + str(st.run_exit) + ",\"stdout\":\"" + cli_jesc(cli_strip_nl(st.stdout, count(st.stdout))) + "\"}" else base + ",\"ran\":false}"

fn cli_pkg_init_toml(pkg) = "[package]\nname = \"" + pkg + "\"\nversion = \"0.1.0\"\nedition = \"2026\"\n\n[capabilities]\nallow = [\"io\"]\n\n[dependencies]"

fn cli_pkg_init_main(pkg) = "## " + pkg + " — entry module\nfn main_val() -> int = 42\nprint main_val()"

fn cli_fmt_lock_mods(ms) = match ms
    Nil        => ""
    Cons(h, t) => "\nmodule \"" + h.rel + "\" sha256 = \"" + h.sha + "\"" + cli_fmt_lock_mods(t)

fn cli_rev_mods(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => cli_rev_mods(t, Cons(h, acc))

fn cli_pkg_lock(st) = "# lume.lock — deterministic content-addressed lockfile (P26, P32)\nversion = 1\nmanifest = " + st.manifest + "\nmanifest_sha256 = \"" + st.manifest_sha + "\"" + cli_fmt_lock_mods(cli_rev_mods(st.mods, Nil))

fn cli_scan_uses(ls) = match ls
    Nil        => Nil
    Cons(h, t) => let tr = cli_trim(h) in if cli_startswith(tr, "use ") == 1 then let u = cli_trim(slice(tr, 4, count(tr))) in Cons(u, cli_scan_uses(t)) else cli_scan_uses(t)

fn cli_fmt_tree_mods(ms) = match ms
    Nil        => ""
    Cons(h, t) => let us = cli_scan_uses(cli_lines(h.sha, 0, count(h.sha))) in let line = if cli_isnil(us) == 1 then "  |-- " + h.rel else "  |-- " + h.rel + " -> " + cli_joinsep(us, " ") + " " in "\n" + line + cli_fmt_tree_mods(t)

fn cli_pkg_tree(st) = st.manifest + cli_fmt_tree_mods(cli_rev_mods(st.mods, Nil))

fn cli_evolve_propose_target(goal) = "@proposal 0004_target_rv64_sll\n@domain target\n@goal " + (if count(goal) > 0 then goal else "Grow multi-file RV64 shift encoder and target assembly emitter") + "\n@principles P1,P7,P24,P30,P31\n@capability pure\n@max_asm_lines 400\n@approval none\n@file compiler/stage1/mod_target_isa.src\n@baseline\nfn rv64_add(rd: int, rs1: int, rs2: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and rs2 >= 0 and rs2 < 32 ensures result >= 51 = 51 + rd * 128 + rs1 * 32768 + rs2 * 1048576\n@end\n@candidate\nfn rv64_add(rd: int, rs1: int, rs2: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and rs2 >= 0 and rs2 < 32 ensures result >= 51 = 51 + rd * 128 + rs1 * 32768 + rs2 * 1048576\n@bound(cycles: 32)\nfn rv64_slli(rd: int, rs1: int, shamt: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and shamt >= 0 and shamt < 64 ensures result >= 19 = 19 + rd * 128 + 4096 + rs1 * 32768 + shamt * 1048576\nfn test_rv64_slli_encodes_opcode_and_shamt() = rv64_slli(10, 11, 3) == 3511571\n@end\n@file compiler/stage1/mod_target_emit.src\n@baseline\nuse mod_target_isa\nfn emit_rv64_pair(rd: int, rs1: int, rs2: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and rs2 >= 0 and rs2 < 32 ensures result >= 51 = rv64_add(rd, rs1, rs2)\n@end\n@candidate\nuse mod_target_isa\nfn emit_rv64_pair(rd: int, rs1: int, rs2: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and rs2 >= 0 and rs2 < 32 ensures result >= 51 = rv64_add(rd, rs1, rs2)\n@bound(cycles: 64)\nfn emit_rv64_scale(rd: int, rs1: int, shamt: int) -> int requires rd >= 0 and rd < 32 and rs1 >= 0 and rs1 < 32 and shamt >= 0 and shamt < 64 ensures result >= 70 = rv64_slli(rd, rs1, shamt) + rv64_add(rd, rd, rs1)\nfn test_emit_rv64_scale_combines_slli_and_add() = emit_rv64_scale(10, 11, 3) == 15374918\n@end\n@tests\nprint rv64_slli(10, 11, 3)\nprint emit_rv64_scale(10, 11, 3)\n@end\n@expected\n3511571\n15374918\n@end"

fn cli_evolve_propose_prover(goal) = "@proposal 0005_prover_interval\n@domain prover\n@goal " + (if count(goal) > 0 then goal else "Grow multi-file interval arithmetic abstract domain and sound prover transfer") + "\n@principles P1,P7,P30,P31,P34\n@capability pure\n@max_asm_lines 400\n@approval none\n@file compiler/stage1/mod_prover_iv.src\n@baseline\nfn iv_contains(lo: int, hi: int, x: int) -> int requires lo <= hi ensures result == 0 or result == 1 = if x >= lo and x <= hi then 1 else 0\n@end\n@candidate\nfn iv_contains(lo: int, hi: int, x: int) -> int requires lo <= hi ensures result == 0 or result == 1 = if x >= lo and x <= hi then 1 else 0\n@bound(cycles: 32)\nfn iv_add_lo(a_lo: int, b_lo: int) -> int requires a_lo >= 0 requires b_lo >= 0 ensures result == a_lo + b_lo and result >= a_lo = _\n@bound(cycles: 32)\nfn iv_add_hi(a_hi: int, b_hi: int) -> int requires a_hi >= 0 requires b_hi >= 0 ensures result == a_hi + b_hi and result >= a_hi = _\n@end\n@file compiler/stage1/mod_prover_check.src\n@baseline\nuse mod_prover_iv\nfn check_in_bounds(lo: int, hi: int, x: int) -> int requires lo <= hi ensures result == 0 or result == 1 = iv_contains(lo, hi, x)\n@end\n@candidate\nuse mod_prover_iv\nfn check_in_bounds(lo: int, hi: int, x: int) -> int requires lo <= hi ensures result == 0 or result == 1 = iv_contains(lo, hi, x)\n@bound(cycles: 48)\nfn prove_sum_in_iv(a_lo: int, a_hi: int, b_lo: int, b_hi: int, s: int) -> int requires a_lo >= 0 and b_lo >= 0 and a_lo <= a_hi and b_lo <= b_hi ensures result == 0 or result == 1 = iv_contains(iv_add_lo(a_lo, b_lo), iv_add_hi(a_hi, b_hi), s)\nlaw iv_add_lo_comm(x: int, y: int) = iv_add_lo(x, y) == iv_add_lo(y, x)\n@end\n@tests\nprint iv_add_lo(10, 20)\nprint iv_add_hi(15, 25)\nprint prove_sum_in_iv(10, 15, 20, 25, 35)\n@end\n@expected\n30\n40\n1\n@end"

fn cli_evolve_propose_stdlib(goal) = "@proposal 0006_stdlib_math_mod\n@domain stdlib\n@goal " + (if count(goal) > 0 then goal else "Grow multi-file stdlib bounded math helpers with contracts and laws") + "\n@principles P1,P7,P23,P26,P30,P31,P35\n@capability pure\n@max_asm_lines 400\n@approval none\n@file compiler/stage1/mod_base.src\n@baseline\nfn sq(x: int) -> int = x * x\nfn cube(x: int) -> int = x * sq(x)\n@end\n@candidate\nfn sq(x: int) -> int = x * x\nfn cube(x: int) -> int = x * sq(x)\n@bound(cycles: 24)\nfn abs_val(x: int) -> int ensures result >= 0 = if x < 0 then 0 - x else x\n@end\n@file compiler/stage1/mod_math.src\n@baseline\nuse mod_base\nfn hypot_sq(a: int, b: int) -> int = sq(a) + sq(b)\nfn quad(x: int) -> int = sq(sq(x))\n@end\n@candidate\nuse mod_base\nfn hypot_sq(a: int, b: int) -> int = sq(a) + sq(b)\nfn quad(x: int) -> int = sq(sq(x))\n@bound(cycles: 32)\nfn manhattan(dx: int, dy: int) -> int ensures result >= 0 = abs_val(dx) + abs_val(dy)\nlaw manhattan_sym(a: int, b: int) = manhattan(a, b) == manhattan(b, a)\n@end\n@tests\nprint abs_val(0 - 12)\nprint manhattan(0 - 3, 4)\nprint hypot_sq(3, 4)\n@end\n@expected\n12\n7\n25\n@end"

fn cli_evolve_propose_dom(dom, goal) = if dom == "target" then cli_evolve_propose_target(goal) else if dom == "prover" then cli_evolve_propose_prover(goal) else if dom == "stdlib" then cli_evolve_propose_stdlib(goal) else "@proposal 0003_goal_proposal\n@goal " + goal + "\n@principles P1,P7,P30,P31\n@capability pure\n@max_asm_lines 160\n@approval none\n@baseline\nfn add(a: int, b: int) -> int = a + b\nfn scale(x: int, k: int) -> int = x * k\n@end\n@candidate\nfn add(a: int, b: int) -> int = a + b\nfn scale(x: int, k: int) -> int = x * k\n@bound(cycles: 32)\nfn clamp(x: int, lo: int, hi: int) -> int requires lo <= hi ensures result >= lo and result <= hi = if x < lo then lo else if x > hi then hi else x\n@end\n@tests\nprint clamp(3, 10, 20)\nprint clamp(25, 10, 20)\nprint clamp(15, 10, 20)\n@end\n@expected\n10\n20\n15\n@end"

fn cli_evolve_propose(goal) = cli_evolve_propose_dom("", goal)

fn cli_collect_end(ls) = match ls
    Nil        => {lines: Nil, rest: Nil}
    Cons(h, t) => if h == "@end" then {lines: Nil, rest: t} else let r = cli_collect_end(t) in {lines: Cons(h, r.lines), rest: r.rest}

fn cli_collect_block(ls) = let r = cli_collect_end(ls) in {body: if cli_isnil(r.lines) == 1 then "" else cli_joinsep(r.lines, "\n") + "\n", rest: r.rest}

fn cli_parse_mod_line(s, mods) = let sp = cli_find_sp(s, 0, count(s)) in if sp >= count(s) then mods else let sha = cli_trim(slice(s, 0, sp)) in let rel = cli_trim(slice(s, sp + 1, count(s))) in Cons({rel: rel, sha: sha}, mods)

fn cli_parse(ls, st) = match ls
    Nil        => st
    Cons(h, t) => if count(h) == 0 then cli_parse(t, st) else if cli_startswith(h, "@cmd ") == 1 then cli_parse(t, {cmd: cli_trim(slice(h, 5, count(h))), pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if cli_startswith(h, "@pkg ") == 1 then cli_parse(t, {cmd: st.cmd, pkg: cli_trim(slice(h, 5, count(h))), part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if cli_startswith(h, "@part ") == 1 then cli_parse(t, {cmd: st.cmd, pkg: st.pkg, part: cli_trim(slice(h, 6, count(h))), goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if cli_startswith(h, "@goal ") == 1 then cli_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: cli_trim(slice(h, 6, count(h))), manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if cli_startswith(h, "@manifest ") == 1 then cli_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: cli_trim(slice(h, 10, count(h))), manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if cli_startswith(h, "@manifest_sha256 ") == 1 then cli_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: cli_trim(slice(h, 17, count(h))), mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if cli_startswith(h, "@module ") == 1 then cli_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: cli_parse_mod_line(cli_trim(slice(h, 8, count(h))), st.mods), exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if cli_startswith(h, "@modsrc ") == 1 then let rel = cli_trim(slice(h, 8, count(h))) in let b = cli_collect_block(t) in cli_parse(b.rest, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: Cons({rel: rel, sha: b.body}, st.mods), exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if cli_startswith(h, "@exit ") == 1 then cli_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: toint(cli_trim(slice(h, 6, count(h)))), asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if cli_startswith(h, "@asm_lines ") == 1 then cli_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: toint(cli_trim(slice(h, 11, count(h)))), ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if cli_startswith(h, "@ran ") == 1 then cli_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: toint(cli_trim(slice(h, 5, count(h)))), run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if cli_startswith(h, "@run_exit ") == 1 then cli_parse(t, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: toint(cli_trim(slice(h, 10, count(h)))), asm: st.asm, diag: st.diag, stdout: st.stdout, src: st.src}) else if h == "@asm" then let b = cli_collect_block(t) in cli_parse(b.rest, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: b.body, diag: st.diag, stdout: st.stdout, src: st.src}) else if h == "@diag" then let b = cli_collect_block(t) in cli_parse(b.rest, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: b.body, stdout: st.stdout, src: st.src}) else if h == "@stdout" then let b = cli_collect_block(t) in cli_parse(b.rest, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: b.body, src: st.src}) else if h == "@src" then let b = cli_collect_block(t) in cli_parse(b.rest, {cmd: st.cmd, pkg: st.pkg, part: st.part, goal: st.goal, manifest: st.manifest, manifest_sha: st.manifest_sha, mods: st.mods, exit_code: st.exit_code, asm_lines: st.asm_lines, ran: st.ran, run_exit: st.run_exit, asm: st.asm, diag: st.diag, stdout: st.stdout, src: b.body}) else cli_parse(t, st)

fn cli_dispatch(text) = let st = cli_parse(cli_lines(text, 0, count(text)), {cmd: "version", pkg: "app", part: "toml", goal: "", manifest: "{}", manifest_sha: "", mods: Nil, exit_code: 0, asm_lines: 0 - 1, ran: 0, run_exit: 0, asm: "", diag: "", stdout: "", src: ""}) in if st.cmd == "version" then cli_version() else if st.cmd == "help" then cli_help() else if st.cmd == "describe" then cli_describe() else if st.cmd == "compile-json" then cli_compile_json(st) else if st.cmd == "pkg-init" then (if st.part == "main" then cli_pkg_init_main(st.pkg) else cli_pkg_init_toml(st.pkg)) else if st.cmd == "pkg-lock" then cli_pkg_lock(st) else if st.cmd == "pkg-tree" then cli_pkg_tree(st) else if st.cmd == "evolve-propose" then cli_evolve_propose_dom(st.part, st.goal) else cli_help()

print cli_dispatch(readall())
