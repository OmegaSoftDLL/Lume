## compiler/stage1/ltarget.src — Universal Targets Backend (Issue #206 & #215, docs/26-targets.md)
##
## Orthogonal Target-Triple Architecture (T0):
##   target = (ISA encoder)  _||_  (object/container writer)  _||_  (OS / ABI + syscall layer)
##
## Supported Target Triples:
##   1. `x86_64-linux-elf`    — x86-64 ISA + ELF64 (EM_X86_64=62) + Linux System V AMD64 ABI (shipped)
##   2. `aarch64-linux-elf`   — AArch64 A64 ISA + ELF64 (EM_AARCH64=183) + Linux AAPCS64 ABI (shipped; runs in qemu-aarch64)
##   3. `aarch64-macos-macho` — AArch64 A64 ISA + Mach-O 64 (MH_MAGIC_64) + Darwin AAPCS64 ABI (shipped; runs natively on Apple Silicon)
##   4. `x86_64-macos-macho`  — x86-64 ISA + Mach-O 64 (MH_MAGIC_64) + Darwin System V AMD64 ABI (shipped; runs on macOS x86_64 / Rosetta 2)
##   5. `x86_64-windows-pe`   — x86-64 ISA + PE32+/COFF (0x8664) + Windows x64 ABI (shipped; runs natively on Windows x64)
##   6. `riscv64-linux-elf`   — RISC-V RV64IM ISA + ELF64 (EM_RISCV=243) + Linux LP64 ABI (shipped; runs in qemu-riscv64)
##   7. `<isa>-none-ihex`     — AArch64 / RISC-V / x86-64 freestanding firmware in Intel HEX (`.hex`) format (shipped)
##   8. `x86_64-none-raw`     — Bare-metal bootable MBR + 64-bit Long Mode kernel image (shipped via lasm `.kernel`, boots in qemu-system-x86_64)
##   9. `lumb`                — Portable Lume Bytecode (`LUMB\x01`) container + deterministic stack VM (shipped; closes #215 `lumb` brick)
##
## Proof-Preserving Guarantee (H5 / docs/28):
##   - Every target enforces Lume's `requires`/`ensures` contracts.
##   - Contracts discharged as `proven` by the sound QF_LIA prover have their runtime guard elided (`guards_elided > 0`).
##   - Contracts marked `runtime_checked` (e.g., nonlinear `x * x`) emit a native target-ISA runtime trap that exits with status 3.
##   - Out-of-fragment constructs emit explicit `[T0900]`/`[T0901]` diagnostics (never a silent 0).

## --- 0. Basic List, Byte & Hex Helpers ---

fn tg_rev_append(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => tg_rev_append(t, Cons(h, acc))

fn tg_app(xs, ys) = tg_rev_append(tg_rev_append(xs, Nil), ys)

fn tg_len_acc(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => tg_len_acc(t, acc + 1)

fn tg_len(xs) = tg_len_acc(xs, 0)

fn tg_nth(xs, idx) = match xs
    Nil        => 0
    Cons(h, t) => if idx <= 0 then h else tg_nth(t, idx - 1)

fn tg_rev_acc(xs, acc) = tg_rev_append(xs, acc)

fn tg_rev(xs) = tg_rev_append(xs, Nil)

fn tg_zeros_acc(n, acc) = if n <= 0 then acc else tg_zeros_acc(n - 1, Cons(0, acc))

fn tg_zeros(n) = tg_zeros_acc(n, Nil)

fn tg_repeat_str(s, n) = if n <= 0 then "" else if n == 1 then s else let h = tg_repeat_str(s, n / 2) in h + h + (if n % 2 == 1 then s else "")

fn tg_lowbyte(x) = let m = x % 256 in if m < 0 then m + 256 else m

fn tg_b2(x) = Cons(tg_lowbyte(x), Cons(tg_lowbyte(x / 256), Nil))

fn tg_b4(x) = let u = if x < 0 then 4294967296 + x else x in tg_app(tg_b2(u % 65536), tg_b2(u / 65536))

fn tg_b8(x) = tg_app(tg_b4(x % 4294967296), tg_b4(x / 4294967296))

fn tg_hex_digit(n) = let v = tg_lowbyte(n) % 16 in if v < 10 then str(v) else if v == 10 then "a" else if v == 11 then "b" else if v == 12 then "c" else if v == 13 then "d" else if v == 14 then "e" else "f"

fn tg_hex_digit_upper(n) = let v = tg_lowbyte(n) % 16 in if v < 10 then str(v) else if v == 10 then "A" else if v == 11 then "B" else if v == 12 then "C" else if v == 13 then "D" else if v == 14 then "E" else "F"

fn tg_byte_hex(b) = let v = tg_lowbyte(b) in tg_hex_digit(v / 16) + tg_hex_digit(v % 16)

fn tg_byte_hex_upper(b) = let v = tg_lowbyte(b) in tg_hex_digit_upper(v / 16) + tg_hex_digit_upper(v % 16)

fn tg_isnil(xs) = match xs
    Nil        => 1
    Cons(h, t) => 0

fn tg_pairs(xs) = match xs
    Nil        => Nil
    Cons(a, t) => tg_pairs2(a, t)

fn tg_pairs2(a, t) = match t
    Nil        => Cons(a, Nil)
    Cons(b, r) => Cons(a + b, tg_pairs(r))

fn tg_joinall(xs) = match xs
    Nil        => ""
    Cons(a, t) => if tg_isnil(t) == 1 then a else tg_joinall(tg_pairs(xs))

fn tg_bytes_to_hex_list(bs) = match bs
    Nil        => Nil
    Cons(b, t) => Cons(tg_byte_hex(b), tg_bytes_to_hex_list(t))

fn tg_bytes_to_hex(bs) = tg_joinall(tg_bytes_to_hex_list(bs))

fn tg_find_ascii(c, i) = let tab = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~" in if i >= 95 then 31 else if slice(tab, i, i + 1) == c then i else tg_find_ascii(c, i + 1)

fn tg_char_code(c) = let o = ord(c) in if o > 0 then o else if c == "\n" then 10 else if c == "\r" then 13 else if c == "\t" then 9 else if c == "" then 0 else 32 + tg_find_ascii(c, 0)

fn tg_str_bytes_i(s, i, n) = if i >= n then Nil else Cons(tg_char_code(at(s, i)), tg_str_bytes_i(s, i + 1, n))

fn tg_str_bytes(s) = tg_str_bytes_i(s, 0, count(s))

fn tg_str_pad(s, total_len) = let bs = tg_str_bytes(s) in tg_app(bs, tg_zeros(total_len - tg_len(bs)))

## --- 1. T0: Orthogonal Target-Triple Registry & Selector ---

fn target_parse_triple(triple) = if triple == "x86_64-linux-elf" or triple == "linux-x86_64" or triple == "x86_64-unknown-linux-gnu" then {valid: 1, triple: "x86_64-linux-elf", isa: "x86_64", os: "linux", fmt: "elf64", abi: "sysv64", e_machine: 62, status: "shipped", subset: "full-core", diag: ""} else if triple == "aarch64-linux-elf" or triple == "linux-aarch64" or triple == "arm64-linux" or triple == "aarch64-unknown-linux-gnu" then {valid: 1, triple: "aarch64-linux-elf", isa: "aarch64", os: "linux", fmt: "elf64", abi: "aapcs64-linux", e_machine: 183, status: "shipped", subset: "verified-core-subset", diag: ""} else if triple == "aarch64-macos-macho" or triple == "macos-aarch64" or triple == "arm64-macos" or triple == "aarch64-apple-darwin" then {valid: 1, triple: "aarch64-macos-macho", isa: "aarch64", os: "macos", fmt: "macho64", abi: "aapcs64-darwin", e_machine: 16777228, status: "shipped", subset: "verified-core-subset", diag: ""} else if triple == "x86_64-macos-macho" or triple == "macos-x86_64" or triple == "x86_64-macos" or triple == "x86_64-apple-darwin" then {valid: 1, triple: "x86_64-macos-macho", isa: "x86_64", os: "macos", fmt: "macho64", abi: "sysv64-darwin", e_machine: 16777223, status: "shipped", subset: "verified-core-subset", diag: ""} else if triple == "x86_64-windows-pe" or triple == "windows-x86_64" or triple == "x86_64-pc-windows-msvc" then {valid: 1, triple: "x86_64-windows-pe", isa: "x86_64", os: "windows", fmt: "pe64", abi: "win64", e_machine: 34404, status: "shipped", subset: "verified-core-subset", diag: ""} else if triple == "x86_64-windows-gui" or triple == "windows-gui-x86_64" or triple == "win64-gui" or triple == "pe64-gui" then {valid: 1, triple: "x86_64-windows-gui", isa: "x86_64", os: "windows", fmt: "pe64-gui", abi: "win64-gui", e_machine: 34404, status: "shipped", subset: "pe64-gui-template", diag: ""} else if triple == "x86_64-windows-gui-protected" or triple == "win64-gui-protected" or triple == "pe64-gui-protected" then {valid: 1, triple: "x86_64-windows-gui-protected", isa: "x86_64", os: "windows", fmt: "pe64-gui-prot", abi: "win64-gui", e_machine: 34404, status: "shipped", subset: "pe64-gui-template", diag: ""} else if triple == "riscv64-linux-elf" or triple == "linux-riscv64" or triple == "riscv64" or triple == "riscv64gc-unknown-linux-gnu" then {valid: 1, triple: "riscv64-linux-elf", isa: "riscv64", os: "linux", fmt: "elf64", abi: "lp64-linux", e_machine: 243, status: "shipped", subset: "verified-core-subset", diag: ""} else if triple == "aarch64-none-ihex" or triple == "arm64-none-ihex" then {valid: 1, triple: "aarch64-none-ihex", isa: "aarch64", os: "none", fmt: "ihex", abi: "freestanding", e_machine: 183, status: "shipped", subset: "verified-core-subset", diag: ""} else if triple == "riscv64-none-ihex" then {valid: 1, triple: "riscv64-none-ihex", isa: "riscv64", os: "none", fmt: "ihex", abi: "freestanding", e_machine: 243, status: "shipped", subset: "verified-core-subset", diag: ""} else if triple == "x86_64-none-ihex" then {valid: 1, triple: "x86_64-none-ihex", isa: "x86_64", os: "none", fmt: "ihex", abi: "freestanding", e_machine: 62, status: "shipped", subset: "verified-core-subset", diag: ""} else if triple == "x86_64-none-raw" or triple == "x86_64-none-mbr" then {valid: 1, triple: "x86_64-none-raw", isa: "x86_64", os: "none", fmt: "raw", abi: "freestanding", e_machine: 62, status: "shipped", subset: "full-core", diag: ""} else if triple == "lumb" or triple == "lumb-portable-vm" then {valid: 1, triple: "lumb", isa: "lumb", os: "portable", fmt: "lumb", abi: "stack-vm", e_machine: 0, status: "shipped", subset: "verified-core-subset", diag: ""} else if triple == "wasm32-wasi" or triple == "wasm32" then {valid: 1, triple: "wasm32-wasi", isa: "wasm32", os: "wasi", fmt: "wasm", abi: "wasi", e_machine: 0, status: "shipped", subset: "verified-core-subset", diag: ""} else if triple == "nvptx64-nvidia-cuda" or triple == "nvptx64" or triple == "cuda-ptx" then {valid: 1, triple: "nvptx64-n