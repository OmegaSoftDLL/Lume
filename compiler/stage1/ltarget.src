>= 0\r\n" + "=\r\n" + "    balance - amount\r\n\r\n" + "@bound(cycles: 24)\r\n" + "pub fn clamp_metric(val: int, lo: int, hi: int) -> int / pure\r\n" + "    requires lo <= hi\r\n" + "    ensures result >= lo and result <= hi\r\n" + "=\r\n" + "    if val < lo then lo else if val > hi then hi else val\r\n") in let v_sdd = wgui_lookup_fn_str(fns, "app_secondary_buffer", "=== RELATORIO DE VERIFICACAO FORMAL & ARQUITETURA NATIVA LUME PE64 ===\r\n" + "1. Compilador & Prover: Lume Stage-2 Self-Hosted (stage2 == stage3 fixpoint)\r\n" + "2. Verificacao Formal: Decisor QF_LIA embutido (requires / ensures / law / @bound)\r\n" + "3. Memoria Deterministica: Perceus Reference Counting + Drop-Guided Reuse\r\n" + "4. Interop Camaleao: C/C++, Rust, Python, Node/JS, Go, Java, C#, SQL, OpenAPI\r\n" + "5. Blindagem P33: Secao .data protegida com XOR k=178 + Prologo MBA + LUME_SEAL\r\n") in let v_audit_title = wgui_lookup_fn_str(fns, "app_audit_dialog_title", "Auditoria Formal Lume & Blindagem P33 Anti-REA") in let v_audit_body = wgui_lookup_fn_str(fns, "app_audit_dialog_body", "VEREDITO SOBERANO LUME PE64 GUI:\r\n\r\n" + "- Binario Executavel: PE32+ x86-64 Windows GUI Nativo (Zero C/C++/C#/.NET)\r\n" + "- Provas Formais: Contratos QF_LIA e orcamento WCET verificados estaticamente\r\n" + "- Protecao P33 Anti-REA: Secao .data criptografada em disco com XOR k=178 (0xB2) + Prologo MBA + LUME_SEAL:178\r\n" + "- Camaleao Polyglot Interop: Fronteiras externas validadas fail-closed") in let v_cmd_run = wgui_lookup_fn_str(fns, "app_cmd_run", "cmd.exe /c lume --version & pause") in let v_cmd_prv = wgui_lookup_fn_str(fns, "app_cmd_prove", "cmd.exe /c lume targets & pause") in let v_cmd_tst = wgui_lookup_fn_str(fns, "app_cmd_test", "cmd.exe /c lume self status & pause") in let v_svg_path = wgui_lookup_fn_str(fns, "app_svg_path", "index.html") in let s_title = wgui_str_slot_hex(v_title, 128, k) in let s_status = wgui_str_slot_hex(v_status, 160, k) in let s_log = wgui_str_slot_hex(v_log, 384, k) in let s_code = wgui_str_slot_hex(v_code, 2400, k) in let s_sdd = wgui_str_slot_hex(v_sdd, 768, k) in let s_audit_title = wgui_str_slot_hex(v_audit_title, 64, k) in let s_audit_body = wgui_str_slot_hex(v_audit_body, 448, k) in let s_filter = wgui_str_slot_hex("All Files (*.*)", 16, k) + wgui_str_slot_hex("*.*", 4, k) + wgui_str_slot_hex("Lume (.src)", 12, k) + wgui_str_slot_hex("*.src", 32, k) in let s_defext = wgui_str_slot_hex("src", 64, k) in let s_cmd_run = wgui_str_slot_hex(v_cmd_run, 128, k) in let s_cmd_prv = wgui_str_slot_hex(v_cmd_prv, 128, k) in let s_cmd_tst = wgui_str_slot_hex(v_cmd_tst, 128, k) in let s_svg_path = wgui_str_slot_hex(v_svg_path, 128, k) in let s_open_verb = wgui_str_slot_hex("open", 64, k) in let s_hex_table = wgui_str_slot_hex("0123456789ABCDEF", 64, k) in wgui_pad_hex(wgui_pe64_data_slots_0_to_39(k) + wgui_pe64_data_slots_40_to_79(fns, k) + s_title + s_status + s_log + s_code + s_sdd + s_audit_title + s_audit_body + s_filter + s_defext + s_cmd_run + s_cmd_prv + s_cmd_tst + s_svg_path + s_open_verb + s_hex_table, 16384)

fn wgui_emit_pe64_hex(fns, protect_mode: int) -> str = let seal = if protect_mode == 1 then wgui_str_slot_hex("LUME_SEAL:P33_MAX:178:PE64_GUI", 32, 0) else "" in wgui_pe64_headers_hex() + wgui_pe64_text_hex(protect_mode) + wgui_pe64_idata_hex() + wgui_pe64_data_hex(fns, protect_mode) + wgui_pe64_rsrc_hex() + seal

fn wgui_compile_target(tp, src) = let toks = tg_lex(src, 0, count(src)) in let parsed = tg_parse_prog(toks) in let num_fns = wgui_filter_num_fns(parsed.fns) in let ifns = tg_instrument_all(num_fns, num_fns) in let ref_nm = tg_has_refuted(ifns) in if ref_nm != "" then {ok: 0, triple: tp.triple, diag: "[V0001] error: contract on '" + ref_nm + "' refuted at compile time for target '" + tp.triple + "'", guards_elided: 0, bytes: Nil, hex: "", ihex: ""} else let pmode = if tp.fmt == "pe64-gui-prot" then 1 else 0 in let hex = wgui_emit_pe64_hex(parsed.fns, pmode) in {ok: 1, triple: tp.triple, diag: "", guards_elided: tg_count_elided(ifns), bytes: Cons(77, Cons(90, Nil)), hex: hex, ihex: ""}

fn test_t13_win64_pe64_gui_and_p33_protection() = let src_gui = "fn clamp_pos(x: int) -> int requires x >= 0 ensures result >= 0 = x + 5\nfn app_window_title() -> str = \"Lume Custom GUI Test\"\n" in let r_unp = target_compile("x86_64-windows-gui", src_gui) in let r_prt = target_compile("x86_64-windows-gui-protected", src_gui) in if r_unp.ok == 1 and r_unp.guards_elided == 1 and count(r_unp.hex) == 67584 and slice(r_unp.hex, 0, 4) == "4d5a" and r_prt.ok == 1 and count(r_prt.hex) == 67648 and r_unp.hex != r_prt.hex then 1 else 0

## --- 9B. High-Level Declarative UI Layout Engine (`@ui-layout` / `ui-layout`) ---

@bound(cycles: 32)
fn ui_split_horizontal(total_w: int, left_pct: int, gap: int) -> int / pure
  requires total_w >= 200 and left_pct >= 10 and left_pct <= 90 and gap >= 0 and gap <= 32
  ensures result >= 0 and result <= total_w
= let raw = (total_w - gap) * left_pct / 100 in if raw < 0 then 0 else if raw > total_w then total_w else raw

@bound(cycles: 16)
fn ui_split_right_width(total_w: int, left_w: int, gap: int) -> int / pure
  requires total_w >= left_w + gap and left_w >= 0 and gap >= 0
  ensures result == total_w - left_w - gap and result >= 0
= total_w - left_w - gap

law ui_split_conservation_law(total_w: int, left_w: int, gap: int) = if total_w >= left_w + gap and left_w >= 0 and gap >= 0 then left_w + gap + ui_split_right_width(total_w, left_w, gap) == total_w else 1 == 1

@bound(cycles: 8)
fn ui_style_resizable_listbox() -> int / pure
  ensures result == 1412694337
= 1412694337

@bound(cycles: 8)
fn ui_style_resizable_editor() -> int / pure
  ensures result == 1412698308
= 1412698308

@bound(cycles: 64)
fn ui_emit_declarative_studio_report(title: str) -> str / pure = "{\"engine\":\"@ui-layout\",\"title\":\"" + title + "\",\"window\":\"1400x780\",\"pane_1_listbox_style\":" + str(ui_style_resizable_listbox()) + ",\"pane_2_editor_style\":" + str(ui_style_resizable_editor()) + ",\"pane_3_listbox_style\":" + str(ui_style_resizable_listbox()) + ",\"pane_4_telemetry_style\":" + str(ui_style_resizable_editor()) + ",\"win32_nc_hittest_rax_preserved\":true,\"web_grid_lowering\":\"css-grid-4pane-wasm\"}"

fn test_t14_declarative_ui_layout_engine() = let l = ui_split_horizontal(1400, 22, 12) in let r = ui_split_right_width(1400, l, 12) in let rep = ui_emit_declarative_studio_report("Lume Declarative Studio") in if l == 305 and r == 1083 and l + 12 + r == 1400 and ui_style_resizable_listbox() == 1412694337 and ui_style_resizable_editor() == 1412698308 and count(rep) > 100 then 1 else 0

## --- 10. CLI Dispatch (`run_core_tool ltarget <input>`) ---

fn tg_first_nl(s, i, n) = if i >= n then n else if at(s, i) == "\n" then i else tg_first_nl(s, i + 1, n)
fn tg_strip_cr(s) = let n = count(s) in if n > 0 and at(s, n - 1) == "\r" then slice(s, 0, n - 1) else s

fn tg_fmt_vm_res(vm) = if vm.status == 3 then "TRAP:3" else if vm.ok == 0 then "ERR:" + vm.output else "OK:0\n" + vm.output

fn tg_self_test() = str(test_t0_orthogonal_target_triple_registry()) + "," + str(test_t6_gpu_ptx_and_spirv_lowering_and_vm()) + "," + str(test_t7_mcu_cortexm_avr_xtensa_and_traps()) + "," + str(test_t8_fpga_verilog_and_vhdl_rtl_sim()) + "," + str(test_t9_mobile_ios_android_and_web_dom_wasm())

fn target_cli_dispatch(text) = let n = count(text) in let nl = tg_first_nl(text, 0, n) in let hdr = tg_strip_cr(slice(text, 0, nl)) in let body = if nl + 1 < n then slice(text, nl + 1, n) else "" in if hdr == "@targets-json" then target_list_json() else if hdr == "@self-test" then tg_self_test() else if hdr == "ui-layout" or hdr == "@ui-layout" or slice(hdr, 0, 10) == "ui-layout " or slice(hdr, 0, 11) == "@ui-layout " then ui_emit_declarative_studio_report("Lume Declarative Studio") else if hdr == "@wasm-sandbox" then let sb = wasm_sandbox_verify(tg_strip_cr(body)) in if sb.ok == 1 then sb.diag else "ERR:" + sb.diag else if hdr == "@neural-kernel" then neural_kernel_synthesize(body) else if slice(hdr, 0, 5) == "@mir " then lume_mir_lower(slice(hdr, 5, count(hdr)), body) else if slice(hdr, 0, 9) == "@package " then let pk = target_package(slice(hdr, 9, count(hdr)), body) in if pk.ok == 0 then "ERR:[T0900] unsupported package format '" + pk.kind + "'" else "HEX:1:" + pk.hex else if slice(hdr, 0, 9) == "@compile " then let tr = slice(hdr, 9, count(hdr)) in let r = target_compile(tr, body) in if r.ok == 0 then "ERR:" + r.diag else if r.ihex != "" then "IHEX:" + str(r.guards_elided) + "\n" + r.ihex else "HEX:" + str(r.guards_elided) + ":" + r.hex else if hdr == "@run-lumb" then let r = target_compile("lumb", body) in if r.ok == 0 then "ERR:" + r.diag else let vm = lumb_verify_and_run(r.bytes) in if vm.status == 3 then "TRAP:3" else "OK:" + str(vm.guards_elided) + "\n" + vm.output else if hdr == "@run-lumb-hex" then let vm = lumb_verify_and_run(tg_hex_to_bytes(body)) in if vm.status == 3 then "TRAP:3" else if vm.ok == 0 then "ERR:" + vm.output else "OK:" + str(vm.guards_elided) + "\n" + vm.output else if hdr == "@run-ptx" then tg_fmt_vm_res(ptx_vm_run(body)) else if hdr == "@run-spirv" then tg_fmt_vm_res(spirv_vm_run(body)) else if hdr == "@run-hdl" then tg_fmt_vm_res(hdl_vm_run(body)) else if slice(hdr, 0, 13) == "@run-mcu-hex " then let isa = slice(hdr, 13, count(hdr)) in tg_fmt_vm_res(mcu_vm_run(isa, tg_hex_to_bytes(body), 0)) else if slice(hdr, 0, 14) == "@run-mcu-ihex " then let isa = slice(hdr, 14, count(hdr)) in let dec = ihex_decode_and_verify(body) in if dec.ok == 0 then "ERR:" + dec.diag else tg_fmt_vm_res(mcu_vm_run(isa, dec.bytes, 1)) else target_list_json()

fn target_main() = if os_arg_count() >= 2 then target_cli_dispatch(os_arg_at(1) + (if os_arg_count() >= 3 then " " + os_arg_at(2) else "")) else target_cli_dispatch(readall())

print target_main()
