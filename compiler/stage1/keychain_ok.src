## keychain_ok.src -- owner-only files (fs_create_private, fs_write_private, fs_mkdir_private, fs_is_private) and the
## keychain module, on both systems (Windows: Credential Manager and protected DACLs; Linux: 0600 / 0700 files).
use keychain

fn kc_big(s, n) = if count(s) >= n then s else kc_big(s + s, n)
fn kc_secret() = "k" + chr(0) + chr(255) + "z-" + kc_big("s", 70)

fn test_create_private_is_owner_only() = let p = "kc_probe_create" in let r0 = fs_remove(p) in let a = fs_create_private(p, "abc") in let b = fs_create_private(p, "xyz") in let ok = a == 1 and b == 0 and fs_read_file(p) == "abc" and fs_is_private(p) == 1 in let r1 = fs_remove(p) in ok
fn test_write_private_replaces_a_shared_file() = let p = "kc_probe_write" in let r0 = fs_remove(p) in let w = fs_write_sync(p, "old") in let before = fs_is_private(p) in let r = fs_write_private(p, "new") in let ok = w == 1 and before == 0 and r == 1 and fs_read_file(p) == "new" and fs_is_private(p) == 1 in let r1 = fs_remove(p) in ok
fn test_write_private_creates_and_keeps_bytes() = let p = "kc_probe_bytes" in let r0 = fs_remove(p) in let s = kc_secret() in let r = fs_write_private(p, s) in let ok = r == 1 and fs_read_file(p) == s and fs_is_private(p) == 1 in let r1 = fs_remove(p) in ok
fn test_write_private_empty() = let p = "kc_probe_empty" in let r0 = fs_remove(p) in let r = fs_write_private(p, "") in let ok = r == 1 and fs_path_exists(p) == 1 and fs_read_file(p) == "" and fs_is_private(p) == 1 in let r1 = fs_remove(p) in ok
fn test_mkdir_private_new_and_again() = let d = "kc_probe_dir" in let r0 = fs_rmdir(d) in let a = fs_mkdir_private(d) in let b = fs_mkdir_private(d) in let ok = a == 1 and b == 1 and fs_is_private(d) == 1 in let r1 = fs_rmdir(d) in ok
fn test_mkdir_private_tightens_an_open_directory() = let d = "kc_probe_open_dir" in let r0 = fs_rmdir(d) in let m = fs_mkdir(d) in let before = fs_is_private(d) in let a = fs_mkdir_private(d) in let ok = m == 1 and before == 0 and a == 1 and fs_is_private(d) == 1 in let r1 = fs_rmdir(d) in ok
fn test_mkdir_private_refuses_a_file() = let p = "kc_probe_notdir" in let w = fs_write_sync(p, "x") in let a = fs_mkdir_private(p) in let r1 = fs_remove(p) in w == 1 and a == 0
fn test_chmod_owner_only_makes_private() = let p = "kc_probe_chmod" in let w = fs_write_sync(p, "x") in let before = fs_is_private(p) in let c = fs_chmod(p, 384) in let ok = w == 1 and before == 0 and c == 1 and fs_is_private(p) == 1 in let r1 = fs_remove(p) in ok
fn test_is_private_missing() = fs_is_private("kc_probe_no_such_file") == 0 - 1

fn test_keychain_backend_per_system() = if os_platform() == "windows" then keychain_backend() == "os" else keychain_backend() == "file"
fn test_keychain_roundtrip() = let s = kc_secret() in let r0 = keychain_delete("lume-test-kc", "acct-1") in let a = keychain_set("lume-test-kc", "acct-1", s) in let g = keychain_get("lume-test-kc", "acct-1") in let a2 = keychain_set("lume-test-kc", "acct-1", "second") in let g2 = keychain_get("lume-test-kc", "acct-1") in let d = keychain_delete("lume-test-kc", "acct-1") in let g3 = keychain_get("lume-test-kc", "acct-1") in let d2 = keychain_delete("lume-test-kc", "acct-1") in a.ok == 1 and g.ok == 1 and g.value == s and a2.ok == 1 and g2.value == "second" and d.ok == 1 and g3.ok == 0 and g3.err == "not_found" and d2.ok == 0 and d2.err == "not_found"
fn test_keychain_accounts_kept_apart() = let a = keychain_set("lume-test-kc", "one", "1") in let b = keychain_set("lume-test-kc", "two", "2") in let ok = keychain_get("lume-test-kc", "one").value == "1" and keychain_get("lume-test-kc", "two").value == "2" in let d1 = keychain_delete("lume-test-kc", "one") in let d2 = keychain_delete("lume-test-kc", "two") in a.ok == 1 and b.ok == 1 and ok and d1.ok == 1 and d2.ok == 1
fn test_keychain_rejects_bad_names() = keychain_set("", "a", "x").err == "bad_name" and keychain_set("a:b", "c", "x").err == "bad_name" and keychain_get("svc", "").err == "bad_name" and keychain_delete("s" + chr(0), "a").err == "bad_name"
fn test_keychain_too_large() = let r = keychain_set("lume-test-kc", "big", kc_big("x", 2561)) in let ok2560 = keychain_set("lume-test-kc", "big", slice(kc_big("x", 4096), 0, 2560)) in let g = keychain_get("lume-test-kc", "big") in let d = keychain_delete("lume-test-kc", "big") in r.ok == 0 and r.err == "too_large" and ok2560.ok == 1 and count(g.value) == 2560 and d.ok == 1
fn test_keychain_file_backend_is_owner_only() = let s0 = os_setenv("LUME_KEYCHAIN_DIR", "kc_probe_store") in let a = keychain_set("svc", "acct", "v") in let p = "kc_probe_store/" + kc_hex("svc") + "." + kc_hex("acct") in let ok = keychain_backend() == "file" and a.ok == 1 and fs_is_private("kc_probe_store") == 1 and fs_is_private(p) == 1 and keychain_get("svc", "acct").value == "v" in let d = keychain_delete("svc", "acct") in let r = fs_rmdir("kc_probe_store") in let u = os_unsetenv("LUME_KEYCHAIN_DIR") in ok and d.ok == 1
## on Windows a file made inside the owner-only store inherits its owner-only entry, so it stays private there
fn test_keychain_file_backend_refuses_a_shared_secret() = let s0 = os_setenv("LUME_KEYCHAIN_DIR", "kc_probe_store2") in let a = keychain_set("svc", "acct", "v") in let p = "kc_probe_store2/" + kc_hex("svc") + "." + kc_hex("acct") in let rm0 = fs_remove(p) in let w = fs_write_sync(p, "planted") in let c = fs_chmod(p, 420) in let g = keychain_get("svc", "acct") in let rm = fs_remove(p) in let r = fs_rmdir("kc_probe_store2") in let u = os_unsetenv("LUME_KEYCHAIN_DIR") in a.ok == 1 and w == 1 and (if os_platform() == "windows" then g.ok == 1 else g.ok == 0 and g.err == "not_private")

## fs_mode: the permission bits on both systems (Windows composes them from the attributes and the owner-only DACL)
fn test_fs_mode_private_file_and_dir() = let p = "kc_probe_mode" in let d = "kc_probe_mode_dir" in let r0 = fs_remove(p) in let r1 = fs_rmdir(d) in let a = fs_create_private(p, "m") in let b = fs_mkdir_private(d) in let ok = a == 1 and b == 1 and fs_mode(p) == 384 and fs_mode(d) == 448 in let r2 = fs_remove(p) in let r3 = fs_rmdir(d) in ok
fn test_fs_mode_follows_chmod() = let p = "kc_probe_mode2" in let r0 = fs_remove(p) in let w = fs_write_sync(p, "m") in let c1 = fs_chmod(p, 420) in let m1 = fs_mode(p) in let c2 = fs_chmod(p, 256) in let m2 = fs_mode(p) in let c3 = fs_chmod(p, 384) in let m3 = fs_mode(p) in let r1 = fs_remove(p) in w == 1 and c1 == 1 and m1 == 420 and c2 == 1 and m2 == 256 and c3 == 1 and m3 == 384 and r1 == 1
fn test_fs_mode_missing() = fs_mode("kc_probe_no_such_file") == 0 - 1
## os_env_has: a variable set to "" is present; os_getenv alone cannot tell it from an absent one
fn test_os_env_has_tells_empty_from_absent() = let u0 = os_unsetenv("LUME_KC_PROBE_ENV") in let before = os_env_has("LUME_KC_PROBE_ENV") in let s = os_setenv("LUME_KC_PROBE_ENV", "") in let during = os_env_has("LUME_KC_PROBE_ENV") in let v = os_getenv("LUME_KC_PROBE_ENV") in let u = os_unsetenv("LUME_KC_PROBE_ENV") in let after = os_env_has("LUME_KC_PROBE_ENV") in before == 0 and during == 1 and v == "" and after == 0 and os_env_has("PATH") == 1
