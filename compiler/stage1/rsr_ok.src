## Records and short lists kept in locals instead of the heap (05_codegen rxq_ / rsr_): every result here must be the
## one the plain code gives. Loops whose state is a record or a list used as a tuple, helpers that return one, calls
## that pass a literal, `{r with ...}`, and the cases that must keep the ordinary path (another key order, an extra
## field, a value that escapes).
fn step(s) = {x: s.x + 1, y: s.y + s.x}
fn loop(s, n) = if n == 0 then s else loop(step(s), n - 1)
fn start(r, n) = loop(r, n)
fn tup(p, n) = if n == 0 then p else tup([p[1], p[0] + p[1]], n - 1)
fn walk(s, n, acc) = if n == 0 then acc + show(s) else walk({x: s.x * 2, y: s.y - 1}, n - 1, acc + show(s) + ";")
fn show(r) = str(r.x) + "/" + str(r.y)
fn nt(p, n) = if n == 0 then p.a else nt({a: p.a + 1}, n - 1) + 1
fn dist2(p, q) = (p.x - q.x) * (p.x - q.x) + (p.y - q.y) * (p.y - q.y) + p.x * q.y - 7 * p.y
fn st(m, n) = if n == 0 then m else st(if m.k % 2 == 0 then {k: m.k + 3, s: m.s + "a"} else {k: m.k - 1, s: m.s}, n - 1)
fn nest(s, n) = if n == 0 then s else nest({pos: {x: s.pos.x + 1, y: s.pos.y}, n: s.n + n}, n - 1)
fn pair(a, b) = [a, b]
fn sum3(i) = let t = pair(i, i * 2) in t[0] + t[1] + [i, 7][1]
fn pick(i) = if i % 2 == 0 then {a: i, b: "even"} else {a: 0 - i, b: "odd"}
fn usepick(i) = let r = pick(i) in str(r.a) + r.b
fn gstep(st, h) = {n: st.n + 1, sum: st.sum + h}
fn go(xs, st) = match xs
    Nil        => st
    Cons(h, t) => go(t, gstep(st, h))
fn loop2(s, n) = if n == 0 then s else loop2({s with x: s.x + s.y, y: s.y + 1}, n - 1)
fn keep(s, n, acc) = if n == 0 then acc else keep(s, n - 1, acc + str({s with x: n}))
fn idxcap(y) = (let y = [1, 2, 3] in y)[y]
fn test_record_loop() = loop({x: 0, y: 0}, 10) == {x: 10, y: 45} and str(loop({x: 2, y: 3}, 4)) == "{x: 6, y: 17}"
fn test_record_loop_entered_with_a_built_record() = start({x: 0, y: 0}, 10) == {x: 10, y: 45}
fn test_other_key_order_and_extra_field_keep_their_shape() = str(loop({y: 5, x: 1}, 0)) == "{y: 5, x: 1}" and str(loop({y: 5, x: 1}, 3)) == "{x: 4, y: 11}" and str(loop({x: 1, y: 2, z: 3}, 0)) == "{x: 1, y: 2, z: 3}" and str(loop({x: 1, y: 2, z: 3}, 2)) == "{x: 3, y: 5}"
fn test_tuple_loop() = str(tup([0, 1], 10)) == str([55, 89]) and str(tup([1, 2, 3], 0)) == str([1, 2, 3])
fn test_value_escaping_each_iteration() = walk({x: 1, y: 9}, 3, "") == "1/9;2/8;4/7;8/6"
fn test_not_a_tail_call() = nt({a: 1}, 5) == 11
fn test_literal_passed_to_a_callee() = dist2({x: 1, y: 2}, {x: 4, y: 6}) == 17 and dist2({x: 4, y: 6}, {x: 1, y: 2}) == 0 - 9
fn test_if_of_literals_as_the_next_state() = st({k: 0, s: ""}, 7) == {k: 9, s: "aaaa"}
fn test_nested_record_state() = nest({pos: {x: 0, y: 1}, n: 0}, 4) == {pos: {x: 4, y: 1}, n: 10}
fn test_list_used_as_a_tuple() = sum3(5) == 22 and idxcap(2) == 3
fn test_helper_returning_one_of_two_records() = usepick(3) + usepick(4) == "-3odd4even"
fn test_match_loop() = go([1, 2, 3, 4], {n: 0, sum: 0}) == {n: 4, sum: 10} and go(Nil, {n: 5, sum: 5}) == {n: 5, sum: 5}
fn test_with_update() = loop2({x: 1, y: 2}, 5) == {x: 21, y: 7} and keep({x: 0, y: 7}, 2, "") == "{x: 2, y: 7}{x: 1, y: 7}"
