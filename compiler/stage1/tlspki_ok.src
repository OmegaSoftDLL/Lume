## tlspki_ok.src -- `use std/tlspki`: SHA-384, RSA (PKCS #1 v1.5 and PSS) and ECDSA P-384 signatures made by openssl,
## and an openssl-made chain (RSA root, P-384 intermediate, P-256 leaf with SANs) validated against its root
use tlspki
use lcrypto_tls

fn msg() = "lume rsa test message"
fn n() = lcs_unhex("")
fn e() = lcs_unhex("010001")
fn root() = lcs_unhex("")
fn inter() = lcs_unhex("")
fn leaf() = lcs_unhex("")
fn now() = 1795106182
fn test_sha384() = lcs_hex(pki_sha384("abc")) == "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7" and lcs_hex(pki_sha384(msg())) == "39f2e86c38dfa47cac5e8e18c4b14274482abff3dfd6f6c9c2f0cbd22d18fad58bffb59e9814461aa503537fde466cb8"
fn test_rsa_pkcs1() = rsa_verify_pkcs1(n(), e(), "sha256", msg(), lcs_unhex("")) and rsa_verify_pkcs1(n(), e(), "sha256", msg() + "x", lcs_unhex("")) == false
fn test_rsa_pss() = rsa_verify_pss(n(), e(), "sha256", msg(), lcs_unhex("")) and rsa_verify_pss(n(), e(), "sha256", "other", lcs_unhex("")) == false
fn test_ecdsa_p384() = ecdsa_verify("p384", lcs_unhex("04460ac3164e1c8a543580d08777f8a3646c1517f601ff9f59429db5bf7b0792afaa49e4dbad0c0d50c830d366dad24325c89f9e31b2ed9d4178c87cf4accb7259d7dd323e7ced7422f05cb67f967443ec38d1f036fcf78a657cb342a6d7a5d1cb"), "sha384", msg(), lcs_unhex("3066023100ebaaec3d73916b84e19c0559350f90c4c27d6bae2422e24eab7489b7333d4e9505e139b8b83e7abb3536541a46ce370c023100c42dc1735a5ce3e1bfb2ae1a284c804e895ab163cbedcda39ab45f1f2f57425c7200faaaa049f14e41c57bed33c98bb8")) and ecdsa_verify("p384", lcs_unhex("04460ac3164e1c8a543580d08777f8a3646c1517f601ff9f59429db5bf7b0792afaa49e4dbad0c0d50c830d366dad24325c89f9e31b2ed9d4178c87cf4accb7259d7dd323e7ced7422f05cb67f967443ec38d1f036fcf78a657cb342a6d7a5d1cb"), "sha384", "tampered", lcs_unhex("3066023100ebaaec3d73916b84e19c0559350f90c4c27d6bae2422e24eab7489b7333d4e9505e139b8b83e7abb3536541a46ce370c023100c42dc1735a5ce3e1bfb2ae1a284c804e895ab163cbedcda39ab45f1f2f57425c7200faaaa049f14e41c57bed33c98bb8")) == false
fn test_x509_parse() = let c = x509_parse(leaf()) in c.ok == 1 and c.sigalg == "ecdsa-sha384" and c.key.kind == "ec" and c.key.curve == "p256" and c.dns == ["test.lume.dev", "*.api.lume.dev"] and c.ca == false and (x509_parse(inter())).ca and (x509_parse(root())).key.kind == "rsa"
fn test_chain_ok() = x509_verify_chain([leaf(), inter()], [root()], "test.lume.dev", now()) == "" and x509_verify_chain([leaf(), inter()], [root()], "x.api.lume.dev", now()) == ""
fn test_chain_rejects() = x509_verify_chain([leaf(), inter()], [root()], "evil.dev", now()) != "" and x509_verify_chain([leaf(), inter()], Nil, "test.lume.dev", now()) != "" and x509_verify_chain([leaf()], [root()], "test.lume.dev", now()) != "" and x509_verify_chain([leaf(), inter()], [root()], "test.lume.dev", now() + 4000 * 86400) != "" and x509_verify_chain([leaf(), inter()], [root()], "a.b.api.lume.dev", now()) != ""
