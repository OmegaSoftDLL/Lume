## seq_ok.src -- tests of seq.src: list combinators, integer loops and string folds, with named functions and
## lambdas that capture variables; a million-step loop and a 200 000-element map check constant stack and linear time.

use seq

fn inc(x) = x + 1
fn even(x) = x % 2 == 0
fn js(xs) = seq_fold(xs, "", fn(a, x) => if a == "" then str(x) else a + "," + str(x))

fn test_map_filter_fold() = js(seq_map([1, 2, 3], inc)) == "2,3,4" and js(seq_filter([1, 2, 3, 4, 5, 6], even)) == "2,4,6" and seq_fold([1, 2, 3, 4], 0, fn(a, x) => a + x) == 10
fn test_lambda_captures() = let k = 10 in js(seq_map([1, 2, 3], fn(x) => x * k)) == "10,20,30"
fn test_foldr_order() = seq_foldr([1, 2, 3], "", fn(x, acc) => str(x) + acc) == "123" and seq_fold([1, 2, 3], "", fn(acc, x) => str(x) + acc) == "321"
fn test_reduce_and_empty() = seq_reduce([5, 3, 9, 1], fn(a, x) => if x > a then x else a) == 9 and js(seq_map([], inc)) == "" and seq_fold([], 7, fn(a, x) => a + x) == 7
fn test_any_all_find_index() = seq_any([1, 3, 4], even) == 1 and seq_all([2, 4], even) == 1 and seq_all([2, 3], even) == 0 and seq_find([1, 3, 8, 10], even) == 8 and seq_index([1, 3, 8], even) == 2 and seq_index([1, 3], even) == 0 - 1
fn test_list_shapes() = seq_len([1, 2, 3]) == 3 and seq_sum([1, 2, 3, 4]) == 10 and js(seq_rev([1, 2, 3])) == "3,2,1" and js(seq_concat([1, 2], [3, 4])) == "1,2,3,4" and js(seq_flatten([[1], [2, 3], [], [4]])) == "1,2,3,4" and js(seq_take([1, 2, 3, 4], 2)) == "1,2" and js(seq_drop([1, 2, 3, 4], 3)) == "4" and seq_nth([7, 8, 9], 1) == 8
fn test_zip() = let z = seq_zip([1, 2, 3], [10, 20]) in seq_len(z) == 2 and seq_fold(z, 0, fn(a, p) => a + p.a * p.b) == 50
fn test_range_and_loop() = js(seq_range(3, 7)) == "3,4,5,6" and js(seq_range(5, 5)) == "" and seq_loop(1, 11, 0, fn(i, acc) => acc + i) == 55 and seq_loop_down(0, 4, "", fn(i, acc) => acc + str(i)) == "3210"
fn test_while() = seq_while(1, fn(x) => x < 1000, fn(x) => x * 2) == 1024 and seq_count(0, 100, fn(i) => i % 7 == 0) == 15
fn test_strings() = js(seq_bytes("A" + chr(0) + chr(255))) == "65,0,255" and seq_str_fold("abc", 0, fn(a, b) => a + b) == 294
fn test_million_step_loop() = seq_loop(0, 1000000, 0, fn(i, acc) => acc + i % 3) == 999999
fn test_long_list_is_linear() = let xs = seq_range(0, 200000) in seq_sum(seq_map(xs, fn(x) => x * 2)) == 39999800000 and seq_len(seq_filter(xs, even)) == 100000

print seq_loop(1, 101, 0, fn(i, acc) => acc + i)
