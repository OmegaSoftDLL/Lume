## string_escape_ok.src -- string literal escapes: \0 is byte 0 and \xHH any byte; a str carries every byte 0..255
## (its length is in its cell). A \x without two hexadecimal digits is rejected with [L0002]
## (tests/conformance/stage1/fail_closed/L0002_bad_hex_escape.src).

fn test_nul_escape_is_byte_zero() = count("a\0b") == 3 and ord(at("a\0b", 1)) == 0 and "a\0b" == "a" + chr(0) + "b"
fn test_hex_escape_low_and_high() = "\x41\x62" == "Ab" and ord(at("\xff", 0)) == 255 and ord(at("\x80", 0)) == 128 and "\xFF" == "\xff"
fn test_hex_zero_bytes() = count("\x00\x00\x00") == 3 and "\x00" == "\0"
fn test_escapes_in_long_literal() = count("0123456789\0abcdef\x01\x02") == 19 and ord(at("0123456789\0abcdef\x01\x02", 10)) == 0
fn test_escapes_with_interpolation_text() = count("x=\x7B\x7D") == 4

print count("a\0b\xff")
