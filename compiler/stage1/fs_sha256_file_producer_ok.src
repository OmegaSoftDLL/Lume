use fs_sha256_file

## an ELF64 x86-64 header shape with NUL bytes, made here (the file passes from any working directory and on every
## system); the producer and the verifier hash the same bytes and must print the same digest
fn fp_fixture() = let path = "fs_sha256_elf_probe" in let body = chr(127) + "ELF" + chr(2) + chr(1) + chr(1) + chr(0) + chr(0) + chr(0) + chr(0) + chr(0) + chr(0) + chr(0) + chr(0) + chr(0) + chr(2) + chr(0) + chr(62) + chr(0) + "lume sha256 fixture" + chr(0) + chr(255) + chr(128) + "binary tail" in let w = fs_write_sync(path, body) in if w == 1 then path else ctfail("binary SHA-256 producer cannot write its fixture")
fn fp_probe() = let path = fp_fixture() in if fs_read_byte(path, 0) == 127 and fs_read_byte(path, 7) == 0 and fs_read_byte(path, 18) == 62 then (let h = fs_sha256_file(path) in let z = fs_remove(path) in h) else ctfail("binary SHA-256 producer requires a real x86-64 ELF input")

print fp_probe()
