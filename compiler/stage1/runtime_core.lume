fn runtime_hosted_init() = "    movq $97, %rax\n" + "    movq $3, %rdi\n" + "    leaq -16(%rsp), %rsi\n" + "    syscall\n" + "    movq -16(%rsp), %rax\n" + "    movq %rax, .Lrt_stk_orig(%rip)\n" + "    movq -8(%rsp), %rax\n" + "    movq %rax, .Lrt_stk_orig+8(%rip)\n" + "    movq -8(%rsp), %rax\n" + "    movq $4294967296, %rcx\n" + "    testq %rax, %rax\n" + "    js __rt_stk_cap\n" + "    cmpq %rcx, %rax\n" + "    jle __rt_stk_set\n" + "__rt_stk_cap:\n" + "    movq %rcx, %rax\n" + "__rt_stk_set:\n" + "    movq %rax, -16(%rsp)\n" + "    movq $160, %rax\n" + "    movq $3, %rdi\n" + "    leaq -16(%rsp), %rsi\n" + "    syscall\n" + "    movq (%rsp), %rax\n" + "    movq %rax, .Lrt_os_argc(%rip)\n" + "    leaq 8(%rsp), %rax\n" + "    movq %rax, .Lrt_os_argv(%rip)\n" + "    movq %rsp, __gc_stack_top(%rip)\n" + "    call __rt_stack_guard\n" + "    call .Lrt_lume_env_cap\n" + "    call __gc_init\n"

## --- Win64 layer (`lumec --win64` + `lasm --pe`, docs/42-windows-native-toolchain.md) ---
## The Linux runtime above is used unchanged on Windows. lumec --win64 replaces runtime_hosted_init by rt_win64_init and
## every `syscall` by `call __win_syscall`, and appends rt_win64_imports + rt_win64_layer:
##   __win_syscall  the Linux x86-64 syscall ABI (rax = number; rdi rsi rdx r10 r8 r9; result or -errno in rax; only
##                  rax, rcx, r11 clobbered) on KERNEL32: read write open close lseek mmap mprotect munmap madvise exit
##                  exit_group flock fsync getcwd mkdir unlink getdents64 getpid clock_gettime nanosleep getrusage
##                  getrlimit; rt_sigaction / sigaltstack / setrlimit succeed as no-ops (faults arrive through
##                  __win_veh); any other number returns -ENOSYS. fds 0-2 are the standard handles, an odd fd is a
##                  directory stream (FindFirstFileW record + 1), 2147483632 is /dev/urandom (BCryptGenRandom), any
##                  other fd is the HANDLE. Paths are UTF-8, converted to UTF-16; /dev/null is NUL.
##                  mmap is anonymous only (VirtualAlloc reserve, or reserve+commit); mprotect(PROT_NONE) decommits
##                  (the runtime calls it only right after MADV_DONTNEED); munmap releases the whole allocation.
##   __win_start    argc / argv / envp as UTF-8 in the layout of the Linux initial stack, UTF-8 console, no error
##                  boxes, a 64 KiB stack guarantee and the vectored exception handler.
##   __win_veh      access violation and stack overflow -> __rt_on_segv with a Linux-shaped siginfo/ucontext (so frozen
##                  arena pages are paged in and resumed, and a stack overflow is the same diagnosed stop); integer
##                  division faults -> __rt_on_fpe.
fn rt_win64_init() = "    call __win_start\n" + "    movq %rsp, __gc_stack_top(%rip)\n" + "    call __rt_stack_guard\n" + "    call .Lrt_lume_env_cap\n" + "    call __gc_init\n"
