fn runtime_fs_dir_tail() = ""

fn rt_fs_files() = rt_fs_private()
## Owner-only files and directories (created 0600 / 0700 from birth; on Windows a protected DACL that grants the
## owner alone), and the OS keychain primitives (Windows: Credential Manager through the layer's calls 1001-1004;
## Linux has none in the kernel, so they answer "not available" and the keychain module keeps owner-only files).
## fs_is_private: Linux reads stat (no group or other bits, owned by getuid); Windows answers through call 1005.
## fs_mode: Linux st_mode & 07777; Windows call 1006 (0755/0644, 0700/0600 when owner-only, read-only drops 0222).
## fs_write_private writes PATH.~<pid hex> (O_CREAT|O_EXCL|O_NOFOLLOW, 0600), fsyncs it and renames it over PATH.
fn rt_fs_private() = ""

fn runtime_fs_tail() = runtime_fs_dir_tail() + rt_fs_files()

## Block-language arrays. Only the ML-core oracle (`data_asmgen`) lowers them: `lumec` programs may freely
## define functions with these names, so the labels must stay out of the runtime `lumec` always links.

