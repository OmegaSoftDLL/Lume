## runtime_core.lume -- the hosted x86-64 Linux native runtime, in one reviewable place.
##
## This module is the single source of the hosted runtime. `lumec` gets it through the amalgamation
## (scripts/amalgamate.src) and the ML-core oracle gets it through `use runtime_core`
## (compiler/stage1/data_asmgen.lume), so the two code generators cannot drift apart.
## The file is valid in both front-ends: keep it to `fn name() = "..." + ...` definitions.
## `lumec` folds a `+` chain of literals into one .rodata string (lstr_chain in 05_codegen.src).
##
## Every instruction here must assemble with BOTH assemblers: the frozen seed (`lume0 asm`,
## bootstrap/lume0/elf.c) and `lasm`. The seed has no unsigned conditional jumps, which is why this code
## divides with `mulq` by a reciprocal and compares addresses as signed values.
##
## Memory management: a non-moving mark-sweep collector (docs/38-memory-management.md).
##   heap     one reserved address range (mmap PROT_NONE, committed by mprotect as it grows), never brk:
##            brk belongs to malloc in any process that links C code, and to the host of a Lume `.so`.
##            It is cut into 64 KiB chunks, indexed by the chunk table `__gc_tab`:
##            0 free | 1 small objects | 2 first chunk of a large object | <0 (~head) continuation.
##   chunk    header: 0 object size, 8 object count, 16 reciprocal of the size, 24 offset of the first
##            object, 32 size-class record, 40 atomic flag, 48 marked objects, 56 large: chunk count;
##            then one mark byte per object from offset 64.
##   class    `__gc_cls` holds 43 scanned records, then 43 atomic ones. Record: 0 free list, 8 carve
##            cursor, 16 carve end, 24 object size, 32 kind. A free object is zero except its first
##            word, the complement of the next free object, so free memory never looks like a pointer.
##   roots    all registers (saved by __gc_slow, so `alloc` keeps its contract of clobbering only
##            rax and r10), the stack, the bss up to `__gc_bss_hi`, and every live arena. Roots and
##            scanned objects are conservative: any word that points into a live object, interior
##            pointers included, keeps it alive. Atomic objects (`__lume_alloc_a`) hold bytes only.
##   freeing  a chunk with no marked object goes back to the free pool through madvise(MADV_DONTNEED),
##            so the OS really gets the memory back and a free chunk always reads as zero. `alloc`
##            therefore always returns zeroed memory.
##   values   see the "value words" note above rt_boxes: most values are immediates and never reach this heap.
##   library  a Lume `.so` has no `_start`: the export stubs call __lume_lib_init, which leaves the collector
##            off. The host can keep pointers it got from Lume, and those are invisible to the collector.
##   tuning   LUME_GC=on|off, LUME_GC_STRESS=<n> (collect on every n-th allocation and poison freed
##            objects: this is how the collector itself is tested), LUME_HEAP_CAP=<bytes>.

fn rt_alloc() = "alloc:\n" + "    testq %rdi, %rdi\n" + "    js .Lrt_alloc_oom\n" + "    incq .Lrt_heap_allocs(%rip)\n" + "    addq %rdi, .Lrt_heap_used(%rip)\n" + "    leaq 7(%rdi), %r10\n" + "    andq $-8, %r10\n" + "    js .Lrt_alloc_oom\n" + "    cmpq $32480, %r10\n" + "    jg __gc_miss_s\n" + "    leaq __gc_map_s(%rip), %rax\n" + "    movq (%rax,%r10), %r10\n" + "    testq %r10, %r10\n" + "    jz __gc_miss_s\n" + "__gc_pop:\n" + "    movq (%r10), %rax\n" + "    testq %rax, %rax\n" + "    jz __gc_refill\n" + "    pushq %r11\n" + "    movq (%rax), %r11\n" + "    notq %r11\n" + "    movq %r11, (%r10)\n" + "    popq %r11\n" + "    movq $0, (%rax)\n" + "    ret\n" + "__lume_alloc_a:\n" + "    testq %rdi, %rdi\n" + "    js .Lrt_alloc_oom\n" + "    incq .Lrt_heap_allocs(%rip)\n" + "    addq %rdi, .Lrt_heap_used(%rip)\n" + "    leaq 7(%rdi), %r10\n" + "    andq $-8, %r10\n" + "    js .Lrt_alloc_oom\n" + "    cmpq $32480, %r10\n" + "    jg __gc_miss_a\n" + "    leaq __gc_map_a(%rip), %rax\n" + "    movq (%rax,%r10), %r10\n" + "    testq %r10, %r10\n" + "    jnz __gc_pop\n" + "__gc_miss_a:\n" + "    movq $1, %r10\n" + "    jmp __gc_slow\n" + "__gc_miss_s:\n" + "    xorq %r10, %r10\n" + "    jmp __gc_slow\n" + "__gc_refill:\n" + "    movq 32(%r10), %r10\n" + "__gc_slow:\n" + "    pushq %rcx\n" + "    pushq %rdx\n" + "    pushq %rbx\n" + "    pushq %rbp\n" + "    pushq %rsi\n" + "    pushq %rdi\n" + "    pushq %r8\n" + "    pushq %r9\n" + "    pushq %r11\n" + "    pushq %r12\n" + "    pushq %r13\n" + "    pushq %r14\n" + "    pushq %r15\n" + "    movq %r10, %rsi\n" + "    call __gc_slow_alloc\n" + "    popq %r15\n" + "    popq %r14\n" + "    popq %r13\n" + "    popq %r12\n" + "    popq %r11\n" + "    popq %r9\n" + "    popq %r8\n" + "    popq %rdi\n" + "    popq %rsi\n" + "    popq %rbp\n" + "    popq %rbx\n" + "    popq %rdx\n" + "    popq %rcx\n" + "    ret\n"

