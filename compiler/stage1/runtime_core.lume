fn runtime_bss_head() = "    .section .bss\n" + "    .lcomm __gc_bss_lo, 8\n" + "    .lcomm .Lrt_pbuf, 32\n" + "    .lcomm .Lrt_heap_cur, 8\n" + "    .lcomm .Lrt_heap_end, 8\n" + "    .lcomm .Lrt_heap_used, 8\n" + "    .lcomm .Lrt_heap_base, 8\n" + "    .lcomm .Lrt_heap_allocs, 8\n" + "    .lcomm .Lrt_heap_peak, 8\n" + "    .lcomm .Lrt_heap_cap, 8\n" + "    .lcomm .Lrt_brk_end, 8\n" + "    .lcomm .Lrt_ar_floor, 8\n" + "    .lcomm .Lrt_heap_arena_used, 8\n" + "    .lcomm .Lrt_emit_buf, 8\n" + "    .lcomm .Lrt_emit_len, 8\n" + "    .lcomm .Lrt_emit_cap, 8\n" + "    .lcomm .Lrt_os_argc, 8\n" + "    .lcomm .Lrt_os_argv, 8\n" + "    .lcomm __rt_sb0, 8\n    .lcomm __rt_sb1, 8\n    .lcomm __rt_sb2, 8\n"

fn runtime_bss_gc() = "    .lcomm __rt_cap_buf, 8\n    .lcomm __rt_gtab, 8\n    .lcomm __rt_try_msg, 8\n    .lcomm __gc_bss_hi, 8\n    .lcomm __rt_try_n, 8\n    .lcomm __rt_try_stk, 384\n    .lcomm __rt_cap_on, 8\n    .lcomm __rt_cap_len, 8\n    .lcomm __rt_cap_cap, 8\n    .lcomm __rt_gcap, 8\n    .lcomm __gc_lo, 8\n    .lcomm __gc_rsv, 8\n    .lcomm __gc_span, 8\n    .lcomm __gc_nchunks, 8\n    .lcomm __gc_nfree, 8\n    .lcomm __gc_limit, 8\n    .lcomm __gc_cursor, 8\n    .lcomm __gc_off, 8\n    .lcomm __gc_stress, 8\n    .lcomm __gc_st_ctr, 8\n    .lcomm __gc_poison, 8\n    .lcomm __gc_count, 8\n    .lcomm __gc_stack_top, 8\n    .lcomm __gc_ms_base, 8\n    .lcomm __gc_ms_size, 8\n    .lcomm __gc_run, 8\n    .lcomm __gc_retry, 8\n    .lcomm __gc_tab, 8\n    .lcomm __gc_tabcap, 8\n    .lcomm __gc_arena_mapped, 8\n    .lcomm __gc_ar_cur, 8\n    .lcomm __gc_az_cur, 8\n    .lcomm __rt_az_cold, 8\n    .lcomm __rt_az, 256\n    .lcomm __rt_lz_tab, 4096\n    .lcomm __rt_dir_end, 8\n    .lcomm __rt_ss, 24\n    .lcomm __rt_sa, 32\n    .lcomm __rt_altstack, 32768\n    .lcomm __gc_cls, 4128\n    .lcomm __gc_map_s, 32488\n    .lcomm __gc_map_a, 32488\n    .lcomm __gc_tab0, 32768\n"

fn runtime_rodata_head() = "    .section .rodata\n" + "__rt_opaque:\n" + "    .asciz \"<opaque>\"\n" + "__rt_dzero_msg:\n" + "    .asciz \"lume: division by zero\\n\"\n" + "__rt_shc_msg:\n" + "    .asciz \"lume: shift count outside 0..63\\n\"\n" + "__rt_nint_msg:\n" + "    .asciz \"lume: type error: arithmetic needs integers\\n\"\n" + "__rt_nbool_msg:\n" + "    .asciz \"lume: type error: a condition needs a boolean\\n\"\n" + "__rt_nmatch_msg:\n" + "    .asciz \"lume: no match arm accepts this value\\n\"\n" + "__rt_nfield_msg:\n" + "    .asciz \"lume: this value has no such field\\n\"\n" + "__rt_deep_msg:\n" + "    .asciz \"lume: too many nested failure handlers\\n\"\n" + "__rt_ovf_msg:\n" + "    .asciz \"lume: integer overflow\\n\"\n" + "__rt_oob_msg:\n" + "    .asciz \"lume: list index out of bounds\\n\"\n" + "__rt_nidx_msg:\n" + "    .asciz \"lume: type error: indexing needs a list or a string\\n\"\n" + "__rt_soob_msg:\n" + "    .asciz \"lume: string index out of bounds\\n\"\n" + "__rt_nchr_msg:\n" + "    .asciz \"lume: chr needs a byte, 0 to 255\\n\"\n" + "__rt_nneed_msg:\n" + "    .asciz \"lume: type error: this needs an integer\\n\"\n" + "__rt_nul_msg:\n" + "    .asciz \"lume: invalid path with NUL byte\\n\"\n" + ".Lrt_oom_msg:\n" + "    .asciz \"lume: out of memory (heap exhausted)\\n\"\n" + ".Lrt_utf8_msg:\n" + "    .asciz \"lume: utf8_chr requires a non-zero Unicode scalar <= U+10FFFF\\n\"\n" + ".Lrt_cap_msg:\n" + "    .asciz \"lume: heap cap exceeded (LUME_HEAP_CAP=\"\n" + ".Lrt_lec_prefix:\n" + "    .asciz \"LUME_HEAP_CAP=\"\n" + ".Lrt_lec_bad_msg:\n" + "    .asciz \"lume: invalid LUME_HEAP_CAP (expected a byte count, optionally K/M/G-suffixed)\\n\"\n" + ".Lrt_pin_msg:\n" + "    .asciz \"lume: out of memory (heap ceiling pinned by a live arena region; reset or destroy arenas to grow the heap)\\n\"\n" + ".Lrt_cap_tail:\n" + "    .asciz \")\\n\"\n"

fn runtime_rodata_gc() = "__gc_k_off:\n" + "    .asciz \"LUME_GC=\"\n" + "__gc_k_cold:\n" + "    .asciz \"LUME_ARENA_COLD=\"\n" + "__rt_pack_msg:\n" + "    .asciz \"lume: packed data is corrupt\\n\"\n" + "__gc_k_st:\n" + "    .asciz \"LUME_GC_STRESS=\"\n" + "__gc_bad_msg:\n" + "    .asciz \"lume: invalid LUME_GC or LUME_GC_STRESS (expected LUME_GC=on|off, LUME_GC_STRESS=<positive int>)\\n\"\n" + "__rt_ov_msg:\n" + "    .asciz \"lume: stack overflow (recursion too deep)\\n\"\n" + "__rt_str_msg:\n" + "    .asciz \"lume: type error: this operation needs a string\\n\"\n" + "__rt_early_msg:\n" + "    .asciz \"lume: top-level value read before its definition ran\\n\"\n" + "__rt_div_msg:\n" + "    .asciz \"lume: division by zero or integer overflow\\n\"\n" + "__rt_fault_msg:\n" + "    .asciz \"lume: invalid memory access\\n\"\n" + "__rt_goob_msg:\n" + "    .asciz \"lume: global index out of bounds\\n\"\n" + "__gc_ms_msg:\n" + "    .asciz \"lume: out of memory (cannot map the collector mark stack)\\n\"\n"

fn runtime_hosted_init() = "    movq $97, %rax\n" + "    movq $3, %rdi\n" + "    leaq -16(%rsp), %rsi\n" + "    syscall\n" + "    movq -8(%rsp), %rax\n" + "    movq $4294967296, %rcx\n" + "    testq %rax, %rax\n" + "    js __rt_stk_cap\n" + "    cmpq %rcx, %rax\n" + "    jle __rt_stk_set\n" + "__rt_stk_cap:\n" + "    movq %rcx, %rax\n" + "__rt_stk_set:\n" + "    movq %rax, -16(%rsp)\n" + "    movq $160, %rax\n" + "    movq $3, %rdi\n" + "    leaq -16(%rsp), %rsi\n" + "    syscall\n" + "    movq (%rsp), %rax\n" + "    movq %rax, .Lrt_os_argc(%rip)\n" + "    leaq 8(%rsp), %rax\n" + "    movq %rax, .Lrt_os_argv(%rip)\n" + "    movq %rsp, __gc_stack_top(%rip)\n" + "    call __rt_stack_guard\n" + "    call .Lrt_lume_env_cap\n" + "    call __gc_init\n"
