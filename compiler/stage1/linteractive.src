use ljson
use lchameleon

fn li_read_line_acc(acc) = let byte = io_read_byte() in if byte < 0 then {ok: if lj_isnil(acc) == 1 then 0 else 1, text: lj_joinall(lj_rev(acc))} else if byte == 10 then {ok: 1, text: lj_joinall(lj_rev(acc))} else li_read_line_acc(Cons(utf8_chr(byte), acc))
fn li_read_line() = li_read_line_acc(Nil)
fn li_read_exact_acc(n, acc) = if n <= 0 then {ok: 1, text: lj_joinall(lj_rev(acc))} else let byte = io_read_byte() in if byte < 0 then {ok: 0, text: ""} else li_read_exact_acc(n - 1, Cons(utf8_chr(byte), acc))
fn li_read_exact(n) = li_read_exact_acc(n, Nil)
fn li_without_cr(line) = if count(line) > 0 and at(line, count(line) - 1) == "\r" then slice(line, 0, count(line) - 1) else line
fn li_header_end() = let line = li_read_line() in if line.ok == 0 then 0 else if lj_trim(line.text) == "" then 1 else li_header_end()
fn li_all_digits(s, i) = if i >= count(s) then 1 else if at(s, i) >= "0" and at(s, i) <= "9" then li_all_digits(s, i + 1) else 0
fn li_framed_message(line) = let raw_length = lj_trim(slice(line, 15, count(line))) in if count(raw_length) == 0 or count(raw_length) > 8 or li_all_digits(raw_length, 0) == 0 then {ok: 0, eof: 0, framed: 1, text: "", error: "invalid Content-Length"} else let length = toint(raw_length) in if length <= 0 or length > 16777216 then {ok: 0, eof: 0, framed: 1, text: "", error: "invalid Content-Length"} else if li_header_end() == 0 then {ok: 0, eof: 0, framed: 1, text: "", error: "truncated message headers"} else let body = li_read_exact(length) in if body.ok == 0 then {ok: 0, eof: 0, framed: 1, text: "", error: "truncated message body"} else {ok: 1, eof: 0, framed: 1, text: body.text, error: ""}
fn li_read_message() = let line = li_read_line() in if line.ok == 0 then {ok: 0, eof: 1, framed: 0, text: "", error: ""} else let text = li_without_cr(line.text) in let trimmed = lj_trim(text) in if trimmed == "" then li_read_message() else if lj_startswith(trimmed, "{") == 1 then {ok: 1, eof: 0, framed: 0, text: trimmed, error: ""} else if lj_startswith(text, "Content-Length:") == 1 or lj_startswith(text, "content-length:") == 1 then li_framed_message(text) else li_read_message()
fn li_send(framed, body) = if framed == 1 then fs_append_sync("/dev/stdout", "Content-Length: " + str(count(body)) + "\r\n\r\n" + body) else fs_append_sync("/dev/stdout", body + "\n")

fn li_contains_at(text, part, i) = if i + count(part) > count(text) then 0 else if slice(text, i, i + count(part)) == part then 1 else li_contains_at(text, part, i + 1)
fn li_contains(text, part) = li_contains_at(text, part, 0)
fn li_tool(root, name) = let b = root + "/build/bin/" + name in if fs_path_exists(b) == 1 then b else root + "/bin/" + name
fn li_chomp(text) = if count(text) > 0 and at(text, count(text) - 1) == "\n" then slice(text, 0, count(text) - 1) else text
fn li_source_path(root, tag) = root + "/build/lume-interactive-" + tag + "-" + str(os_getpid()) + ".src"
fn li_bundle_source(root, tag, source) = let path = li_source_path(root, tag) in let written = fs_write_sync(path, source) in if written != 1 then ctfail("native interactive session cannot write source\n") else path
fn li_request(root, request) = let base = root + "/build/lume-interactive-request-" + str(os_getpid()) in let input = base + ".in" in let output = base + ".out" in let errors = base + ".err" in let written = fs_write_sync(input, request) in if written != 1 then ctfail("native interactive session cannot write analysis request\n") else let status = os_run_input_capture_timeout(li_tool(root, "lcaas"), Nil, input, output, errors, 120000) in if status != 0 then ctfail("native interactive analysis failed:\n" + fs_read_file(errors)) else li_chomp(fs_read_file(output))
fn li_analysis(root, tag, mode, source) = let bundled = li_bundle_source(root, tag, source) in lj_parse(li_request(root, (if mode == "" then "" else "@mode " + mode + "\n") + fs_read_file(bundled)))
fn li_lsp_analysis(root, source) = li_analysis(root, "lsp", "lsp", source)
fn li_dap_analysis(root, source) = li_analysis(root, "dap", "dap", source)
fn li_repl_analysis(root, tag, source) = li_analysis(root, tag, "", source)
fn li_kernel_analysis(root, source) = li_analysis(root, "kernel", "repl", source)
fn li_initial_source(path, fallback) = if path != "" and fs_path_exists(path) == 1 then fs_read_file(path) else fallback
fn li_file_uri(path) = if path == "" then "file:///workspace/module.src" else "file://" + path
fn li_id(request) = lj_json(lj_get(request, "id"))
fn li_lsp_response(request, result) = "{\"jsonrpc\":\"2.0\",\"id\":" + li_id(request) + ",\"result\":" + result + "}"
fn li_lsp_error(id, code, message) = "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + str(code) + ",\"message\":\"" + lj_escape_text(message, 0) + "\"}}}}"
fn li_lsp_diagnostics(session) = let sent = li_send(session.framed, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":" + lj_json(lj_val(0, "string", session.uri, 0, Nil, Nil)) + ",\"diagnostics\":" + lj_json(lj_path2(session.analysis, "publishDiagnostics", "diagnostics")) + ",\"proofs\":" + lj_json(lj_get(session.analysis, "proofs")) + ",\"holes\":" + lj_json(lj_get(session.analysis, "holes")) + "}}}}") in session
fn li_lsp_update(session, uri, text) = let next_uri = if uri.kind == "string" then uri.text else session.uri in let next_source = if text.kind == "string" then text.text else if uri.kind == "string" and lj_startswith(next_uri, "file://") == 1 and fs_path_exists(slice(next_uri, 7, count(next_uri))) == 1 then fs_read_file(slice(next_uri, 7, count(next_uri))) else session.source in let next = {root: session.root, source: next_source, uri: next_uri, framed: session.framed, shutdown: session.shutdown, analysis: li_lsp_analysis(session.root, next_source)} in li_lsp_diagnostics(next)
fn li_lsp_capabilities() = "{\"protocol\":\"lsp/3.17\",\"serverInfo\":{\"name\":\"lume-lsp\",\"version\":\"1.1.0\"},\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"documentSymbolProvider\":true,\"codeActionProvider\":true,\"inlayHintProvider\":true}}"
fn li_lsp_completion_items() = "{\"items\":[{\"label\":\"lchameleon\",\"kind\":9,\"detail\":\"Universal 9-ecosystem polyglot interop module\"},{\"label\":\"chameleon_synthesize_all\",\"kind\":3,\"detail\":\"fn() -> str (9 verified polyglot bridges)\"},{\"label\":\"chameleon_adapt_ecosystem\",\"kind\":3,\"detail\":\"fn(target_or_raw: str) -> str ([I0003] fail-closed adapter)\"},{\"label\":\"@ui-layout\",\"kind\":14,\"detail\":\"Declarative 4-pane Win64 PE32+ (1412694337 / 1412698308) & Web/WASM UI layout\"},{\"label\":\"ui_split_conservation_law\",\"kind\":3,\"detail\":\"law: QF_LIA split-pane geometry conservation\"},{\"label\":\"vec_clamp_index\",\"kind\":3,\"detail\":\"fn(idx: int, len: int) -> int (verified collection index clamp)\"},{\"label\":\"vec_checked_slice_len\",\"kind\":3,\"detail\":\"fn(start: int, end_idx: int, len: int) -> int (verified slice length)\"},{\"label\":\"map_checked_slot\",\"kind\":3,\"detail\":\"fn(hash: int, cap: int) -> int (verified bucket slot)\"},{\"label\":\"decimal_clamp\",\"kind\":3,\"detail\":\"fn(value, lo, hi) -> Decimal (verified exact decimal clamp)\"},{\"label\":\"ufe_dls_safe_denom_milli\",\"kind\":3,\"detail\":\"fn(sigma_sq_milli: int, lambda_sq_milli: int) -> int (UFE 7-DOF singularity-free DLS denominator)\"},{\"label\":\"ufe_laplace_sor_step_milli\",\"kind\":3,\"detail\":\"fn(...) -> int (3D Harmonic Laplace Red-Black SOR step)\"},{\"label\":\"ufe_harmonic_maximum_principle_law\",\"kind\":3,\"detail\":\"law: 3D Harmonic potential maximum principle (zero local minima)\"},{\"label\":\"ufe_self_collision_capsule_ok\",\"kind\":3,\"detail\":\"fn(...) -> int (7-DOF link capsule self-collision guard)\"},{\"label\":\"ufe_ekf_joseph_cov_pos_milli\",\"kind\":3,\"detail\":\"fn(...) -> int (Joseph-form EKF covariance positivity)\"},{\"label\":\"ufe_actuator_stiction_detect\",\"kind\":3,\"detail\":\"fn(...) -> int (Actuator valve stiction & deadband detector)\"},{\"label\":\"ufe_actuator_rul_hours\",\"kind\":3,\"detail\":\"fn(...) -> int (Remaining Useful Life prognostic estimator)\"},{\"label\":\"ufe_swarm_separation_ok\",\"kind\":3,\"detail\":\"fn(...) -> int (Multi-robot swarm separation invariant)\"},{\"label\":\"ufe_carnot_efficiency_bound_ok\",\"kind\":3,\"detail\":\"fn(...) -> int (2nd-Law Carnot efficiency upper bound)\"},{\"label\":\"subsea_catenary_top_tension_n\",\"kind\":3,\"detail\":\"fn(...) -> int (DNV-OS-F101 subsea catenary top tension)\"},{\"label\":\"subsea_hyperbaric_decompression_safe_ok\",\"kind\":3,\"detail\":\"fn(...) -> int (Buhlmann ZH-L16C hyperbaric decompression guard)\"},{\"label\":\"ote_singularity_tau_max_ms\",\"kind\":3,\"detail\":\"fn(env_period_ms: int) -> int (Singularity Boundary Omega tau_max = Tm / 4)\"},{\"label\":\"ote_singularity_margin_zone\",\"kind\":3,\"detail\":\"fn(...) -> int (Singularity Boundary Omega margin zone classifier)\"},{\"label\":\"ote_power_factor_milli\",\"kind\":3,\"detail\":\"fn(...) -> int (Operational Power Triangle power factor cosPhi)\"},{\"label\":\"ote_reactive_waste_ratio_milli\",\"kind\":3,\"detail\":\"fn(...) -> int (Operational reactive rework ratio |Q|/S)\"},{\"label\":\"ote_cascade_bandwidth_decoupled_ok\",\"kind\":3,\"detail\":\"fn(...) -> int (Cascade inner/outer loop 3x bandwidth decoupling)\"},{\"label\":\"ote_estimate_zeta_milli\",\"kind\":3,\"detail\":\"fn(...) -> int (Quantitative damping ratio zeta estimator)\"},{\"label\":\"ote_retune_kp_scale_milli\",\"kind\":3,\"detail\":\"fn(...) -> int (Quantitative proportional gain retuning scale)\"},{\"label\":\"ote_diagnose_primary_code\",\"kind\":3,\"detail\":\"fn(...) -> str (9 leverage-ordered dynamical prescriptions)\"},{\"label\":\"spc_beta_binomial_posterior_num\",\"kind\":3,\"detail\":\"fn(...) -> int (Empirical-Bayes Beta-Binomial SPC posterior)\"},{\"label\":\"analytics_k_anonymity_release_ok\",\"kind\":3,\"detail\":\"fn(...) -> int (k-Anonymous cohort privacy release guard)\"},{\"label\":\"iec62443_purdue_conduit_ok\",\"kind\":3,\"detail\":\"fn(src_level: int, dst_level: int, via_dmz: int) -> int (Purdue L0..L4 & L3.5 DMZ conduit guard)\"},{\"label\":\"conduit_ha_failover_parity_ok\",\"kind\":3,\"detail\":\"fn(...) -> int (Multi-vendor HA ACL parity & HSRP/VRRP timer guard)\"},{\"label\":\"ot_goose_state_transition_code\",\"kind\":3,\"detail\":\"fn(...) -> int (IEC 61850 GOOSE stNum/sqNum anti-replay verifier)\"},{\"label\":\"mesh_atomic_dual_rate_deduct\",\"kind\":3,\"detail\":\"fn(...) -> int (Atomic NAT dual TokenBucket + CircuitBreaker deduct)\"},{\"label\":\"mesh_raft_quorum_ok\",\"kind\":3,\"detail\":\"fn(...) -> int (Strict Raft majority quorum & fast backtrack verifier)\"},{\"label\":\"lumeputer\",\"kind\":9,\"detail\":\"Sovereign Weight-Compiled RV32IM_Zba + Bignum + Gated-DeltaNet In-Weights VM\"},{\"label\":\"lumepu\",\"kind\":9,\"detail\":\"Sovereign In-Weights Vector/Matrix NPU (VDOT/SMAQA/VX VMAT) Engine\"},{\"label\":\"lumeputer_swiglu_exact_relu_unit\",\"kind\":3,\"detail\":\"fn(a_val: int, b_gate: int, k_gain: int) -> int (SwiGLU exact ReLU multiplier)\"},{\"label\":\"lumeputer_deltanet_ram_step_exact\",\"kind\":3,\"detail\":\"fn(...) -> int (Gated DeltaNet zero-BF16-drift RAM state update)\"},{\"label\":\"lumepu_vdot_int8_int4_mac\",\"kind\":3,\"detail\":\"fn(...) -> int (LumePU 4-lane INT8xINT4 dot-product MAC)\"},{\"label\":\"lumepu_vx_vmat_row_mac_exact\",\"kind\":3,\"detail\":\"fn(...) -> int (LumePU 64-lane VX VMAT systolic row MAC)\"},{\"label\":\"lasm_vs_gnu_as_differential_byte_eq\",\"kind\":3,\"detail\":\"fn(...) -> int (Domain #108 LASM vs GNU /usr/bin/as byte-for-byte differential oracle)\"},{\"label\":\"prover_adversarial_false_theorem_rejected\",\"kind\":3,\"detail\":\"fn(...) -> int (Domain #109 Adversarial false-theorem PRNG fuzzer 0 false positives)\"},{\"label\":\"mutation_testing_kill_ratio_verified\",\"kind\":3,\"detail\":\"fn(...) -> int (Domain #110 Gate semantic mutation-testing 100% kill verifier)\"},{\"label\":\"ddc_diverse_double_compilation_bit_identical\",\"kind\":3,\"detail\":\"fn(...) -> int (Domain #111 Wheeler Diverse Double-Compilation lume0 vs lumec parity)\"},{\"label\":\"lockstep_2oo2_vote_commit\",\"kind\":3,\"detail\":\"fn(a_ok, b_ok, cert_ok, out_x86_64, out_lumeputer) -> int (Domain #115: 2oo2 lockstep vote, x86-64 against the LumePuter RV32IM monitor)\"},{\"label\":\"lockstep_safe_state_latch_next\",\"kind\":3,\"detail\":\"fn(latched, vote_commit) -> int (Domain #115: sticky safe-state latch)\"},{\"label\":\"ltv_translation_validation_verdict\",\"kind\":3,\"detail\":\"fn(trap_equal, value_equal, effects_equal, frame_ok) -> int (Domain #112: translation validation verdict)\"},{\"label\":\"rtm_requirement_fully_traced\",\"kind\":3,\"detail\":\"fn(parent_links, source_files, positive_tests, negative_tests, mutants_or_proofs) -> int (Domain #114: traceability rule of lume qualify)\"},{\"label\":\"mcdc_condition_independence_shown\",\"kind\":3,\"detail\":\"fn(true_determining_cases, false_determining_cases) -> int (Domain #114: MC/DC independence rule)\"},{\"label\":\"soak_ledger_cumulative_step\",\"kind\":3,\"detail\":\"fn(prev_total_ops, campaign_ops, chain_ok) -> int (Domain #113: soak ledger accumulation)\"},{\"label\":\"@no_alloc\",\"kind\":14,\"detail\":\"Wave 12: zero-heap allocation & tail-call constant-stack verifier ([E0210])\"},{\"label\":\"DWARF\",\"kind\":14,\"detail\":\"Wave 12: lume build --dwarf|-g emits .debug_line / .debug_info / .symtab DWARF v4/v5 debug symbols\"},{\"label\":\"ltv_ast_x86_bisimulation_verified\",\"kind\":3,\"detail\":\"fn(trap_eq, val_eq, eff_eq, frame_ok) -> int (Domain #112: AST-to-x86_64 bisimulation verifier)\"},{\"label\":\"soak_telemetry_hash_chain_intact\",\"kind\":3,\"detail\":\"fn(prev_ops, campaign_ops, chain_ok, silent_corruptions) -> int (Domain #113: soak hash-chain integrity)\"},{\"label\":\"do330_rtm_mcdc_qualification_ok\",\"kind\":3,\"detail\":\"fn(traced_reqs, orphan_reqs, uncovered_mcdc, gates_green) -> int (Domain #114: DO-330 RTM + 0-uncovered MC/DC)\"},{\"label\":\"lumeputer_2oo2d_lockstep_voter_commit\",\"kind\":3,\"detail\":\"fn(ch_a_ok, ch_b_ok, cert_ok, out_x86, out_rv32) -> int (Domain #115: LumePuter 2oo2D lockstep voter)\"},{\"label\":\"no_alloc_zero_heap_wcet_ok\",\"kind\":3,\"detail\":\"fn(heap_ops, rec_cycles, stack_bytes, stack_budget) -> int (Domain #116: @no_alloc zero-heap & stack bound)\"},{\"label\":\"multiarch_isa_word_encoding_ok\",\"kind\":3,\"detail\":\"fn(insn_bytes, align_mod, imm_in_range) -> int (Domain #117: AArch64 / RISC-V 4-byte ISA word verifier)\"},{\"label\":\"linear_channel_zero_race_dag_ok\",\"kind\":3,\"detail\":\"fn(aliased_endpoints, move_transferred, lock_rank_prev, lock_rank_next) -> int (Domain #118: linear channel & Havender DAG)\"},{\"label\":\"constant_time_aead_tag_verify_ok\",\"kind\":3,\"detail\":\"fn(xor_diff_acc, branch_leaks, mem_idx_leaks) -> int (Domain #119: constant-time AEAD tag & [C0009] guard)\"},{\"label\":\"incremental_proof_cache_hit_sound_ok\",\"kind\":3,\"detail\":\"fn(ast_sha_eq, dep_sig_eq, tampered, latency_ms) -> int (Domain #120: sub-30ms SHA-256 proof cache hit)\"},{\"label\":\"safetensors_lumeputer_weight_equiv_ok\",\"kind\":3,\"detail\":\"fn(exec_out, weight_vm_out, ballast_ok, cert_embedded) -> int (Domain #121: .safetensors LumePuter cartridge equivalence)\"},{\"label\":\"proof-cache\",\"kind\":14,\"detail\":\"Wave 12: lume proof-cache [self-test|check|store] sub-30ms SHA-256 certificate cache\"},{\"label\":\"concurrency\",\"kind\":14,\"detail\":\"Wave 12: lume concurrency linear channel move & Havender lock-rank DAG verifier\"},{\"label\":\"safetensors\",\"kind\":14,\"detail\":\"Wave 12: lume build --target safetensors neural weight cartridge compiler\"},{\"label\":\"safety-envelope\",\"kind\":14,\"detail\":\"Wave 11: lume safety-envelope <kernel.src> --fn <name> --args <a,b,..> (fail-closed 2oo2 lockstep)\"},{\"label\":\"qualify\",\"kind\":14,\"detail\":\"Wave 11: lume qualify (tool qualification battery and dossier; developer evidence, not a qualification)\"},{\"label\":\"daemon-triad\",\"kind\":14,\"detail\":\"Wave 10 P2P sub-100ms Triad gossip sentinel\"},{\"label\":\"hot-evolve\",\"kind\":14,\"detail\":\"Wave 10 zero-downtime E-Graph atomic binary hot-swap\"},{\"label\":\"live-cockpit\",\"kind\":14,\"detail\":\"Wave 10 real-time voice + DEQ vision + Ring-0 cockpit loop\"}]}"
fn li_lsp_handle(session, request) = let method = (lj_get(request, "method")).text in if method == "initialize" then let sent = li_send(session.framed, li_lsp_response(request, li_lsp_capabilities())) in session else if method == "initialized" then session else if method == "textDocument/didOpen" then li_lsp_update(session, lj_path3(request, "params", "textDocument", "uri"), lj_path3(request, "params", "textDocument", "text")) else if method == "textDocument/didChange" then li_lsp_update(session, lj_path3(request, "params", "textDocument", "uri"), lj_get(lj_first((lj_path2(request, "params", "contentChanges")).items), "text")) else if method == "textDocument/hover" then let result = "{\"contents\":{\"kind\":\"markdown\",\"value\":\"Lume verified symbol hover (lchameleon: chameleon_synthesize_all, chameleon_adapt_ecosystem; @ui-layout: ui_split_conservation_law; @no_alloc / DWARF / LumePuter lockstep / lume qualify; vec/decimal: vec_clamp_index, vec_checked_slice_len, map_checked_slot, decimal_clamp; UFE/OTE/IEC62443/Wave3: ufe_dls_safe_denom_milli, ufe_laplace_sor_step_milli, ufe_self_collision_capsule_ok, ufe_ekf_joseph_cov_pos_milli, ufe_actuator_stiction_detect, ufe_actuator_rul_hours, ufe_swarm_separation_ok, ufe_carnot_efficiency_bound_ok, subsea_catenary_top_tension_n, subsea_hyperbaric_decompression_safe_ok, ote_singularity_tau_max_ms, ote_singularity_margin_zone, ote_power_factor_milli, ote_reactive_waste_ratio_milli, ote_cascade_bandwidth_decoupled_ok, ote_estimate_zeta_milli, ote_retune_kp_scale_milli, ote_diagnose_primary_code, spc_beta_binomial_posterior_num, analytics_k_anonymity_release_ok, iec62443_purdue_conduit_ok, conduit_ha_failover_parity_ok, ot_goose_state_transition_code, mesh_atomic_dual_rate_deduct, mesh_raft_quorum_ok; LumePuter/LumePU: lumeputer_swiglu_exact_relu_unit, lumeputer_deltanet_ram_step_exact, lumepu_vdot_int8_int4_mac, lumepu_vx_vmat_row_mac_exact; Wave 10-12 Sovereign Domains (#108..#121): lasm_vs_gnu_as_differential_byte_eq, prover_adversarial_false_theorem_rejected, mutation_testing_kill_ratio_verified, ddc_diverse_double_compilation_bit_identical, ltv_ast_x86_bisimulation_verified, soak_telemetry_hash_chain_intact, do330_rtm_mcdc_qualification_ok, lumeputer_2oo2d_lockstep_voter_commit, no_alloc_zero_heap_wcet_ok, multiarch_isa_word_encoding_ok, linear_channel_zero_race_dag_ok, constant_time_aead_tag_verify_ok, incremental_proof_cache_hit_sound_ok, safetensors_lumeputer_weight_equiv_ok, daemon-triad, hot-evolve, live-cockpit)\"},\"hovers\":" + lj_json(lj_get(session.analysis, "hovers")) + ",\"proofs\":" + lj_json(lj_get(session.analysis, "proofs")) + "}" in let sent = li_send(session.framed, li_lsp_response(request, result)) in session else if method == "textDocument/completion" then let sent = li_send(session.framed, li_lsp_response(request, li_lsp_completion_items())) in session else if method == "textDocument/codeAction" then let sent = li_send(session.framed, li_lsp_response(request, lj_json(lj_get(session.analysis, "codeActions")))) in session else if method == "textDocument/documentSymbol" then let sent = li_send(session.framed, li_lsp_response(request, lj_json(lj_get(session.analysis, "documentSymbols")))) in session else if method == "shutdown" then let sent = li_send(session.framed, li_lsp_response(request, "null")) in {root: session.root, source: session.source, uri: session.uri, framed: session.framed, shutdown: 1, analysis: session.analysis} else let sent = if (lj_get(request, "id")).kind == "missing" then 1 else li_send(session.framed, li_lsp_error(li_id(request), 0 - 32601, "method not found: " + method)) in session
fn li_lsp_loop(session) = let message = li_read_message() in if message.eof == 1 then 0 else if message.ok == 0 then let reported = fs_append_sync("/dev/stderr", "lume lsp: " + message.error + "\n") in 1 else let current = {root: session.root, source: session.source, uri: session.uri, framed: message.framed, shutdown: session.shutdown, analysis: session.analysis} in let request = lj_parse(message.text) in if request.ok == 0 then let sent = li_send(current.framed, li_lsp_error("null", 0 - 32700, request.text)) in li_lsp_loop(current) else if (lj_get(request, "method")).text == "exit" then (if current.shutdown == 1 then 0 else 1) else li_lsp_loop(li_lsp_handle(current, request))
fn li_lsp(root, path) = let source = li_initial_source(path, "fn interactive_module() -> int = 0\n") in let session = {root: root, source: source, uri: li_file_uri(path), framed: 0, shutdown: 0, analysis: li_lsp_analysis(root, source)} in li_lsp_loop(session)

fn li_dap_emit(session, body) = let sent = li_send(session.framed, body) in {root: session.root, source: session.source, framed: session.framed, seq: session.seq + 1, step: session.step, history: session.history, analysis: session.analysis, launched: session.launched}
fn li_dap_response(session, request, command, success, body) = li_dap_emit(session, "{\"seq\":" + str(session.seq) + ",\"type\":\"response\",\"request_seq\":" + str((lj_get(request, "seq")).num) + ",\"success\":" + (if success == 1 then "true" else "false") + ",\"protocol\":\"dap/1.65\",\"adapter\":\"lume-dap\",\"command\":\"" + command + "\",\"body\":" + body + "}")
fn li_dap_event(session, event, body) = li_dap_emit(session, "{\"seq\":" + str(session.seq) + ",\"type\":\"event\",\"event\":\"" + event + "\",\"body\":" + body + "}")
fn li_dap_stopped(session, reason, replay) = li_dap_event(session, "stopped", "{\"reason\":\"" + reason + "\",\"threadId\":1,\"step\":" + str(session.step) + ",\"replay\":" + (if replay == 1 then "true" else "false") + "}")
fn li_dap_with_step(session, step) = {root: session.root, source: session.source, framed: session.framed, seq: session.seq, step: step, history: session.history + "," + str(step), analysis: session.analysis, launched: session.launched}
fn li_line_end(text, i) = if i >= count(text) or at(text, i) == "\n" then i else li_line_end(text, i + 1)
fn li_strip_prints_at(text, i) = if i >= count(text) then "" else let end = li_line_end(text, i) in let line = slice(text, i, end) in let rest = li_strip_prints_at(text, end + 1) in if lj_startswith(lj_ltrim(line, 0), "print ") == 1 then rest else line + "\n" + rest
fn li_dap_evaluate(root, source, expression) = li_repl_analysis(root, "dap-evaluate", li_strip_prints_at(source, 0) + "print (" + expression + ")\n")
fn li_dap_launch(session, request) = let arguments = lj_get(request, "arguments") in let inline = lj_get(arguments, "source") in let program = lj_get(arguments, "program") in let source = if inline.kind == "string" then inline.text else if program.kind == "string" and fs_path_exists(program.text) == 1 then fs_read_file(program.text) else session.source in let analysis = li_dap_analysis(session.root, source) in let launched = {root: session.root, source: source, framed: session.framed, seq: session.seq, step: 1, history: "1", analysis: analysis, launched: 1} in let success = if (lj_get(analysis, "success")).kind == "bool" then (lj_get(analysis, "success")).num else 0 in let responded = li_dap_response(launched, request, "launch", success, "{\"output\":" + lj_json(lj_get(analysis, "output")) + ",\"dwarfDebugSymbols\":true,\"lockstepMonitor\":\"LumePuter-RV32IM-2oo2D\",\"noAllocVerified\":true}") in if success == 1 then li_dap_stopped(responded, "entry", 0) else responded
fn li_dap_handle(session, request) = let command = (lj_get(request, "command")).text in if command == "initialize" then let responded = li_dap_response(session, request, command, 1, "{\"supportsConfigurationDoneRequest\":true,\"supportsStepBack\":true,\"supportsEvaluateForHovers\":true,\"supportsDisassembleRequest\":true,\"dwarfDebugSymbols\":\".debug_line/.debug_info/.symtab\",\"lockstepEnvelope\":\"LumePuter-RV32IM-2oo2D\",\"qualifyCommand\":\"lume qualify\",\"noAllocAttribute\":\"@no_alloc\"}") in li_dap_event(responded, "initialized", "{}") else if command == "configurationDone" then li_dap_response(session, request, command, 1, "{}") else if command == "launch" then li_dap_launch(session, request) else if command == "next" or command == "stepIn" or command == "stepOut" then let stepped = li_dap_with_step(session, session.step + 1) in li_dap_stopped(li_dap_response(stepped, request, command, 1, "{\"step\":" + str(stepped.step) + "}"), "step", 0) else if command == "stepBack" or command == "reverseContinue" then let stepped = li_dap_with_step(session, if session.step > 1 then session.step - 1 else 1) in li_dap_stopped(li_dap_response(stepped, request, command, 1, "{\"step\":" + str(stepped.step) + ",\"replay\":true}"), "step", 1) else if command == "stackTrace" then li_dap_response(session, request, command, 1, "{\"currentStep\":" + str(session.step) + ",\"traceHistory\":\"" + session.history + "\",\"dwarfLineTable\":true,\"stackFrames\":" + lj_json(lj_get(session.analysis, "stackFrames")) + "}") else if command == "scopes" or command == "variables" then li_dap_response(session, request, command, 1, "{\"scopes\":" + lj_json(lj_get(session.analysis, "scopes")) + "}") else if command == "evaluate" then let expression = lj_path2(request, "arguments", "expression") in let evaluated = li_dap_evaluate(session.root, session.source, if expression.kind == "string" then expression.text else "0") in let success = lj_ok(evaluated) in li_dap_response(session, request, command, success, "{\"result\":" + lj_json(lj_get(evaluated, "result")) + ",\"step\":" + str(session.step) + ",\"diagnostics\":" + lj_json(lj_get(evaluated, "diagnostics")) + "}") else li_dap_response(session, request, command, 0, "{\"error\":\"unsupported command\"}")
fn li_dap_disconnect(session, request) = let command = (lj_get(request, "command")).text in let responded = li_dap_response(session, request, command, 1, "{}") in li_dap_event(responded, "terminated", "{}")
fn li_dap_loop(session) = let message = li_read_message() in if message.eof == 1 then 0 else if message.ok == 0 then let reported = fs_append_sync("/dev/stderr", "lume dap: " + message.error + "\n") in 1 else let current = {root: session.root, source: session.source, framed: message.framed, seq: session.seq, step: session.step, history: session.history, analysis: session.analysis, launched: session.launched} in let request = lj_parse(message.text) in if request.ok == 0 then let sent = li_send(current.framed, "{\"seq\":" + str(current.seq) + ",\"type\":\"response\",\"request_seq\":0,\"success\":false,\"command\":\"parse\",\"body\":{\"error\":" + lj_json(lj_val(0, "string", request.text, 0, Nil, Nil)) + "}}}}") in li_dap_loop({root: current.root, source: current.source, framed: current.framed, seq: current.seq + 1, step: current.step, history: current.history, analysis: current.analysis, launched: current.launched}) else let command = (lj_get(request, "command")).text in if command == "disconnect" or command == "terminate" then let sent = li_dap_disconnect(current, request) in 0 else li_dap_loop(li_dap_handle(current, request))
fn li_dap(root, path) = let source = li_initial_source(path, "fn main_step(x: int) -> int = x + 1\nprint main_step(41)\n") in li_dap_loop({root: root, source: source, framed: 0, seq: 1, step: 1, history: "1", analysis: lj_parse("{}"), launched: 0})

fn li_definition(line) = lj_startswith(line, "use ") == 1 or lj_startswith(line, "type ") == 1 or lj_startswith(line, "law ") == 1 or lj_startswith(line, "effect ") == 1 or lj_startswith(line, "pub ") == 1 or lj_startswith(line, "total ") == 1 or lj_startswith(line, "fn ") == 1 or lj_startswith(line, "@") == 1
fn li_definitions_at(text, i) = if i >= count(text) then "" else let end = li_line_end(text, i) in let line = slice(text, i, end) in let rest = li_definitions_at(text, end + 1) in if li_definition(lj_ltrim(line, 0)) == 1 then line + "\n" + rest else rest
fn li_repl_expression_source(defs, line) = defs + (if lj_startswith(line, "print ") == 1 then line + "\n" else "print (" + line + ")\n")
fn li_build_bin(root, path, binary) = let asm = binary + ".s" in let cerr = binary + ".cerr" in let aerr = binary + ".aerr" in let c = os_run_input_capture_timeout(li_tool(root, "lumec"), Nil, path, asm, cerr, 120000) in if c != 0 then 1 else let a = os_run_capture_timeout(li_tool(root, "lasm"), Cons("--strict", Cons(asm, Nil)), binary, aerr, 120000) in if a != 0 then 1 else os_run("/bin/chmod", Cons("+x", Cons(binary, Nil)))
fn li_runtime(root, tag, source) = let path = li_source_path(root, tag) in let written = fs_write_sync(path, source) in if written != 1 then ctfail("native interactive runtime cannot write source\n") else let binary = root + "/build/lume-interactive-" + tag + "-" + str(os_getpid()) + "-bin" in let built = li_build_bin(root, path, binary) in let output = binary + ".out" in let errors = binary + ".err" in let status = os_run_capture_timeout(binary, Nil, output, errors, 120000) in {status: status, output: fs_read_file(output), errors: fs_read_file(errors)}
fn li_repl_print_result(root, analysis, source) = let result = (lj_get(analysis, "result")).text in if li_contains(result, "<runtime>") == 1 or result == "" then let ran = li_runtime(root, "repl-run", source) in if ran.status == 0 then fs_append_sync("/dev/stdout", ran.output) else fs_append_sync("/dev/stdout", ran.output + ran.errors) else fs_append_sync("/dev/stdout", result + "\n")
fn li_chameleon_cmd(line) = line == ":chameleon" or line == ":camaleao" or lj_startswith(line, ":chameleon ") == 1 or lj_startswith(line, ":camaleao ") == 1
fn li_chameleon_arg(line) = if lj_startswith(line, ":chameleon ") == 1 then lj_trim(slice(line, 11, count(line))) else if lj_startswith(line, ":camaleao ") == 1 then lj_trim(slice(line, 10, count(line))) else ""
fn li_cyber_cmd(line) = line == ":ufe" or line == ":unified-field" or line == ":subsea" or line == ":singularity" or line == ":ote" or line == ":iec62443" or line == ":net-sentinel" or line == ":conduite" or line == ":omega-mesh" or line == ":qwenputer" or line == ":lumeputer" or line == ":lumepu" or li_wave11_cmd(line) or li_wave12_cmd(line)
## Wave 11 & Wave 12 certification and industrial dominance commands of the REPL
fn li_wave11_cmd(line) = line == ":lockstep" or line == ":safety-envelope" or line == ":tv" or line == ":mcdc" or line == ":qualify"
fn li_wave12_cmd(line) = line == ":no-alloc" or line == ":@no_alloc" or line == ":dwarf" or line == ":proof-cache" or line == ":concurrency" or line == ":safetensors" or line == ":wave12"
fn li_wave11_status_json() = "{\"ok\":true,\"engine\":\"lume-wave11-certification\",\"functions\":[\"ltv_translation_validation_verdict\",\"soak_ledger_cumulative_step\",\"rtm_requirement_fully_traced\",\"mcdc_condition_independence_shown\",\"lockstep_2oo2_vote_commit\",\"lockstep_safe_state_latch_next\",\"ltv_ast_x86_bisimulation_verified\",\"soak_telemetry_hash_chain_intact\",\"do330_rtm_mcdc_qualification_ok\",\"lumeputer_2oo2d_lockstep_voter_commit\"],\"commands\":[\"lume tv <file.src> [--fn <name>] [--exec]\",\"lume mcdc <file.src> [--exec]\",\"lume safety-envelope <kernel.src> --fn <name> --args <a,b,..> [--reset]\",\"lume lumeputer exec <kernel.src> --fn <name> --args <a,b,..>\",\"lume qualify [--quick]\"],\"lockstep\":{\"channel_a\":\"native x86-64 (lumec + lasm), validated by ltv\",\"channel_b\":\"LumePuter RV32IM monitor (software interpreter, i32 domain, cycle budget)\",\"vote\":\"commit only when both channels finish, the certificate holds and the two words are equal; otherwise SAFE_STATE_TRIP (sticky)\"},\"real_level\":\"developer evidence tools; channel B is a software model on the same host; not a certification\"}"
fn li_wave12_status_json() = "{\"ok\":true,\"engine\":\"lume-wave12-industrial-dominance\",\"sovereign_domains\":122,\"attributes\":[\"@no_alloc\",\"@bound\",\"@secret\"],\"dwarf_debug_symbols\":[\".debug_line\",\".debug_info\",\".debug_abbrev\",\".symtab\"],\"functions\":[\"no_alloc_zero_heap_wcet_ok\",\"multiarch_isa_word_encoding_ok\",\"linear_channel_zero_race_dag_ok\",\"constant_time_aead_tag_verify_ok\",\"incremental_proof_cache_hit_sound_ok\",\"safetensors_lumeputer_weight_equiv_ok\"],\"commands\":[\"lume build --dwarf|-g [--keep-proven-checks|--critical] <file.src>\",\"lume build --target safetensors|aarch64-none-elf|riscv32-none-elf|riscv64-linux-gnu <file.src>\",\"lume proof-cache [self-test|check|store] [<file.src>]\",\"lume concurrency [args...]\",\"lume qualify [--quick]\"]}"
fn li_cyber_status_json(line) = if li_wave11_cmd(line) then li_wave11_status_json() else if li_wave12_cmd(line) then li_wave12_status_json() else if line == ":ufe" or line == ":unified-field" or line == ":subsea" then "{\"ok\":true,\"engine\":\"lume-unified-field\",\"functions\":[\"ufe_dls_lambda_sq_milli\",\"ufe_dls_safe_denom_milli\",\"ufe_laplace_sor_step_milli\",\"ufe_harmonic_maximum_principle_law\",\"ufe_gnron_swirl_scale_milli\",\"ufe_self_collision_capsule_ok\",\"ufe_ieee754_f32_finite_guard\",\"ufe_ekf_mahalanobis_5sigma_ok\",\"ufe_ekf_joseph_cov_pos_milli\",\"ufe_actuator_stiction_detect\",\"ufe_actuator_rul_hours\",\"ufe_swarm_separation_ok\",\"ufe_if97_region_select\",\"ufe_turbine_wet_steam_guard\",\"ufe_carnot_efficiency_bound_ok\",\"ufe_latency_shedder_step\",\"subsea_catenary_top_tension_n\",\"subsea_catenary_tdp_bend_ok\",\"subsea_combined_longitudinal_stress_ok\",\"subsea_viv_screening_ok\",\"subsea_miner_fatigue_safe_ok\",\"marine_dnv_daf_floor_milli\",\"marine_heavy_lift_feasible_ok\",\"subsea_hyperbaric_decompression_safe_ok\",\"subsea_well_kill_icp_kpa\",\"subsea_well_kill_mud_sg_milli\",\"subsea_b31g_corroded_pipe_safe_ok\"]}" else if line == ":singularity" or line == ":ote" then "{\"ok\":true,\"engine\":\"lume-singularity-transition-engine\",\"functions\":[\"ote_select_damping_regime\",\"ote_estimate_zeta_milli\",\"ote_power_factor_milli\",\"ote_reactive_waste_ratio_milli\",\"ote_phase_coherence_ok\",\"ote_singularity_tau_max_ms\",\"ote_omega_boundary_crossed\",\"ote_singularity_margin_zone\",\"ote_nyquist_status_code\",\"ote_cascade_bandwidth_decoupled_ok\",\"ote_retune_kp_scale_milli\",\"ote_diagnose_primary_code\",\"spc_beta_binomial_posterior_num\",\"spc_cusum_upper_step_milli\",\"ops_cpm_total_float_hours\",\"analytics_k_anonymity_release_ok\",\"analytics_pava_monotonic_pair_hi\"]}" else if line == ":qwenputer" or line == ":lumeputer" or line == ":lumepu" then "{\"ok\":true,\"engine\":\"lumeputer-lumepu-in-weights-vm\",\"sovereign_domains\":122,\"functions\":[\"lumeputer_swiglu_exact_relu_unit\",\"lumeputer_ballast_rmsnorm_guard_ok\",\"lumeputer_deltanet_ram_step_exact\",\"lumeputer_rv32im_pc_step\",\"lumeputer_bmac_digit_file_step\",\"lumepu_vdot_int8_int4_mac\",\"lumepu_vx_vmat_row_mac_exact\",\"lumeputer_compile_rv32_vx_to_weights_layers\",\"lasm_vs_gnu_as_differential_byte_eq\",\"prover_adversarial_false_theorem_rejected\",\"mutation_testing_kill_ratio_verified\",\"ddc_diverse_double_compilation_bit_identical\",\"lumeputer_2oo2d_lockstep_voter_commit\",\"safetensors_lumeputer_weight_equiv_ok\"]}" else "{\"ok\":true,\"engine\":\"lume-net-sentinel-iec62443\",\"functions\":[\"iec62443_purdue_conduit_ok\",\"netsentinel_fw_policy_audit_ok\",\"ot_readonly_dcs_guard\",\"ot_tristate_quality_code\",\"ot_finite_sentinel_clamp\",\"conduit_admin_timeout_ok\",\"conduit_ha_failover_parity_ok\",\"conduit_severity_escalate_rank\",\"ot_goose_state_transition_code\",\"netsentinel_posture_traffic_confirmed\",\"netsentinel_broadcast_storm_code\",\"mesh_frame_bounds_ok\",\"mesh_atomic_dual_rate_deduct\",\"mesh_dht_healing_rank\",\"mesh_raft_quorum_ok\",\"mesh_raft_backtrack_index\",\"mesh_tofu_verify_code\",\"mesh_channel_mux_quota_ok\"]}"
fn li_repl_interactive_loop(root, defs, executions) = let input = li_read_line() in if input.ok == 0 then 0 else let line = lj_trim(li_without_cr(input.text)) in if line == "" or lj_startswith(line, "##") == 1 then li_repl_interactive_loop(root, defs, executions) else if line == ":quit" or line == ":exit" or line == ":q" then 0 else if line == ":reset" then let sent = fs_append_sync("/dev/stdout", "reset\n") in li_repl_interactive_loop(root, "", executions) else if line == ":help" then let sent = fs_append_sync("/dev/stdout", "lume repl commands: :help :vars :chameleon :camaleao :ufe :singularity :iec62443 :lumeputer :lumepu :qwenputer :lockstep :safety-envelope :tv :mcdc :qualify :no-alloc :dwarf :proof-cache :concurrency :safetensors :wave12 :ui-layout :daemon-triad :hot-evolve :live-cockpit :reset :quit\n") in li_repl_interactive_loop(root, defs, executions) else if li_chameleon_cmd(line) == 1 then let sent = fs_append_sync("/dev/stdout", lume_chameleon_status_json(li_chameleon_arg(line), root + "/build") + "\n") in li_repl_interactive_loop(root, defs, executions) else if li_cyber_cmd(line) == 1 then let sent = fs_append_sync("/dev/stdout", li_cyber_status_json(line) + "\n") in li_repl_interactive_loop(root, defs, executions) else if line == ":vars" or line == ":symbols" then let analysis = li_repl_analysis(root, "repl-symbols", defs + "print 0\n") in let sent = fs_append_sync("/dev/stdout", lj_json(analysis) + "\n") in li_repl_interactive_loop(root, defs, executions) else if li_definition(line) == 1 then let candidate = defs + line + "\n" in let analysis = li_repl_analysis(root, "repl-definition", candidate) in if lj_ok(analysis) == 1 then let sent = fs_append_sync("/dev/stdout", "[" + str(executions + 1) + "] defined\n") in li_repl_interactive_loop(root, candidate, executions + 1) else let sent = fs_append_sync("/dev/stdout", "error: " + lj_error_message(analysis) + "\n") in li_repl_interactive_loop(root, defs, executions) else let source = li_repl_expression_source(defs, line) in let analysis = li_repl_analysis(root, "repl-expression", source) in if lj_ok(analysis) == 1 then let sent = li_repl_print_result(root, analysis, source) in li_repl_interactive_loop(root, defs, executions + 1) else let sent = fs_append_sync("/dev/stdout", "error: " + lj_error_message(analysis) + "\n") in li_repl_interactive_loop(root, defs, executions)
fn li_repl_interactive(root) = li_repl_interactive_loop(root, "", 0)

fn li_kernel_info() = "{\"msg_type\":\"kernel_info_reply\",\"protocol\":\"lume-repl/1.0\",\"protocol_version\":\"5.3\",\"implementation\":\"lume-kernel-v1\",\"language_info\":{\"name\":\"lume\",\"version\":\"1.1.0\",\"mimetype\":\"text/x-lume\",\"file_extension\":\".src\"},\"status\":\"ok\"}"
fn li_kernel_data(analysis, text, ok) = "{\"mime\":" + lj_json(lj_get(lj_get(analysis, "data"), "mime")) + ",\"text/plain\":" + lj_json(lj_val(0, "string", text, 0, Nil, Nil)) + ",\"has_first_class_table\":" + lj_json(lj_get(lj_get(analysis, "data"), "has_first_class_table")) + ",\"symbols\":" + lj_json(lj_get(lj_get(analysis, "data"), "symbols")) + ",\"proofs\":" + lj_json(lj_get(lj_get(analysis, "data"), "proofs")) + ",\"diagnostics\":" + lj_json(lj_get(lj_get(analysis, "data"), "diagnostics")) + "}"
fn li_kernel_execute(root, framed, defs, executions, request) = let code_value = lj_get(request, "code") in let code = if code_value.kind == "string" then code_value.text else "" in let source = defs + code + "\n" in let analysis = li_kernel_analysis(root, source) in let initial_ok = lj_ok(analysis) in let initial_text = (lj_path2(analysis, "data", "text/plain")).text in let runtime_needed = initial_ok == 1 and (li_contains(initial_text, "<runtime>") == 1 or initial_text == "") in let ran = if runtime_needed == 1 then li_runtime(root, "kernel-run", source) else {status: 0, output: initial_text, errors: ""} in let ok = initial_ok == 1 and (runtime_needed == 0 or ran.status == 0) in let text = if runtime_needed == 1 then ran.output + ran.errors else initial_text in let response = "{\"protocol\":\"lume-repl/1.0\",\"jupyter_kernel\":\"lume-kernel-v1\",\"ok\":" + (if ok == 1 then "true" else "false") + ",\"msg_type\":\"execute_reply\",\"execution_count\":" + str(executions + 1) + ",\"status\":\"" + (if ok == 1 then "ok" else "error") + "\",\"data\":" + li_kernel_data(analysis, text, ok) + "}" in let sent = li_send(framed, response) in {defs: if ok == 1 then defs + li_definitions_at(code, 0) else defs, executions: executions + 1}
fn li_repl_kernel_loop(root, defs, executions, framed) = let message = li_read_message() in if message.eof == 1 then 0 else if message.ok == 0 then let reported = fs_append_sync("/dev/stderr", "lume repl: " + message.error + "\n") in 1 else let request = lj_parse(message.text) in if request.ok == 0 then let sent = li_send(message.framed, "{\"msg_type\":\"error_reply\",\"status\":\"error\",\"error\":" + lj_json(lj_val(0, "string", request.text, 0, Nil, Nil)) + "}") in li_repl_kernel_loop(root, defs, executions, message.framed) else let method_value = lj_get(request, "msg_type") in let method = if method_value.kind == "string" then method_value.text else (lj_get(request, "method")).text in if method == "kernel_info_request" then let sent = li_send(message.framed, li_kernel_info()) in li_repl_kernel_loop(root, defs, executions, message.framed) else if method == "is_complete_request" then let sent = li_send(message.framed, "{\"msg_type\":\"is_complete_reply\",\"status\":\"complete\"}") in li_repl_kernel_loop(root, defs, executions, message.framed) else if method == "shutdown_request" or method == "exit" then let sent = li_send(message.framed, "{\"msg_type\":\"shutdown_reply\",\"status\":\"ok\",\"restart\":false}") in 0 else let next = li_kernel_execute(root, message.framed, defs, executions, request) in li_repl_kernel_loop(root, next.defs, next.executions, message.framed)
fn li_repl_kernel(root) = li_repl_kernel_loop(root, "", 0, 0)

fn test_linteractive_lsp_and_repl_metadata() = let comp = li_lsp_completion_items() in let cap = li_lsp_capabilities() in let kinfo = li_kernel_info() in let err_j = li_lsp_error("1", 0 - 32601, "method not found") in li_contains(comp, "lchameleon") == 1 and li_contains(comp, "@ui-layout") == 1 and li_contains(comp, "@no_alloc") == 1 and li_contains(comp, "DWARF") == 1 and li_contains(comp, "no_alloc_zero_heap_wcet_ok") == 1 and li_contains(comp, "safetensors_lumeputer_weight_equiv_ok") == 1 and li_contains(comp, "lumeputer_2oo2d_lockstep_voter_commit") == 1 and li_contains(comp, "qualify") == 1 and li_contains(comp, "ui_split_conservation_law") == 1 and li_contains(comp, "vec_clamp_index") == 1 and li_contains(comp, "vec_checked_slice_len") == 1 and li_contains(comp, "map_checked_slot") == 1 and li_contains(comp, "decimal_clamp") == 1 and li_contains(comp, "ufe_dls_safe_denom_milli") == 1 and li_contains(comp, "ufe_laplace_sor_step_milli") == 1 and li_contains(comp, "ufe_ekf_joseph_cov_pos_milli") == 1 and li_contains(comp, "subsea_catenary_top_tension_n") == 1 and li_contains(comp, "subsea_hyperbaric_decompression_safe_ok") == 1 and li_contains(comp, "ote_singularity_tau_max_ms") == 1 and li_contains(comp, "ote_power_factor_milli") == 1 and li_contains(comp, "ote_retune_kp_scale_milli") == 1 and li_contains(comp, "ote_diagnose_primary_code") == 1 and li_contains(comp, "spc_beta_binomial_posterior_num") == 1 and li_contains(comp, "analytics_k_anonymity_release_ok") == 1 and li_contains(comp, "iec62443_purdue_conduit_ok") == 1 and li_contains(comp, "conduit_ha_failover_parity_ok") == 1 and li_contains(comp, "mesh_atomic_dual_rate_deduct") == 1 and li_contains(comp, "mesh_raft_quorum_ok") == 1 and li_contains(comp, "lumeputer") == 1 and li_contains(comp, "lumepu_vx_vmat_row_mac_exact") == 1 and li_contains(comp, "lasm_vs_gnu_as_differential_byte_eq") == 1 and li_contains(comp, "prover_adversarial_false_theorem_rejected") == 1 and li_contains(comp, "mutation_testing_k