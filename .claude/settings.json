{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash L:/lume/build/windows-native/mem/lexguard.sh",
            "timeout": 60,
            "statusMessage": "lume check --lex"
          }
        ]
      }
    ]
  }
}
