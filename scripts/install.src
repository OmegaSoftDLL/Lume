use fs_sha256_file

fn ni_chomp(s) = let n = count(s) in if n == 0 then "" else let c = at(s, n - 1) in if c == "\n" or c == "\r" then ni_chomp(slice(s, 0, n - 1)) else s
fn ni_line_end(s, i) = if i >= count(s) or at(s, i) == "\n" then i else ni_line_end(s, i + 1)
fn ni_lines(s, i) = if i >= count(s) then Nil else let e = ni_line_end(s, i) in Cons(slice(s, i, e), ni_lines(s, e + 1))
fn ni_value(lines, prefix) = match lines
    Nil        => ""
    Cons(h, t) => let line = ni_chomp(h) in if count(line) >= count(prefix) and slice(line, 0, count(prefix)) == prefix then slice(line, count(prefix), count(line)) else ni_value(t, prefix)
fn ni_request(input) = let lines = ni_lines(input, 0) in {prefix: ni_value(lines, "@prefix "), root: ni_value(lines, "@from-local "), bin: ni_value(lines, "@from-dir ")}
fn ni_run(path, args) = os_run_capture_timeout(path, args, "/dev/null", "/dev/null", 900000)
fn ni_copy(source, destination) = if source == destination then 0 else let z = if fs_path_exists(destination) == 1 then fs_remove(destination) else 0 in if ni_run("/bin/cp", Cons("-f", Cons(source, Cons(destination, Nil)))) != 0 then 1 else ni_run("/bin/chmod", Cons("+x", Cons(destination, Nil)))
fn ni_copy_optional(source, destination) = if source == destination then 0 else if fs_path_exists(source) == 1 then ni_copy(source, destination) else 0
fn ni_mkdirs(prefix) = ni_run("/bin/mkdir", Cons("-p", Cons("/root/.lume_sovereign_memory", Cons("/var/lib/lume_sovereign_vault", Cons(prefix + "/bin", Cons(prefix + "/compiler/stage1/lume", Cons(prefix + "/build/bin", Cons(prefix + "/evolve", Cons(prefix + "/scripts", Cons(prefix + "/docs", Nil))))))))))
fn ni_binary_names() = Cons("lume_driver", Cons("lume_make", Cons("leconomy", Cons("lc", Cons("lumec", Cons("lumec0", Cons("lumec1", Cons("lumec2", Cons("lumec3", Cons("lasm", Cons("lasm0", Cons("lasm1", Cons("lasm2", Cons("lasm3", Cons("lcli", Cons("lcli0", Cons("lcli1", Cons("lcli2", Cons("lcli3", Cons("lmod", Cons("lcaas", Cons("lcert", Cons("levolve", Cons("levidence", Cons("ldoc", Cons("ltest", Cons("lfmt", Cons("lprotect", Cons("ltarget", Cons("lregistry", Cons("lregistry_cid", Cons("lsha", Cons("lmesh", Cons("los", Cons("lume0", Cons("lume0.exe", Cons("lume-target-check", Cons("lume-target-trap", Cons("lume-target-check.exe", Cons("lume-target-trap.exe", Nil))))))))))))))))))))))))))))))))))))))))
fn ni_install_binary(source, prefix, name) = if fs_path_exists(source + "/" + name) == 0 then 0 else let a = ni_copy(source + "/" + name, prefix + "/build/bin/" + name) in if a != 0 then a else ni_copy(source + "/" + name, prefix + "/bin/" + name)
fn ni_install_binaries(source, prefix, names) = match names
    Nil        => 0
    Cons(h, t) => let installed = ni_install_binary(source, prefix, h) in if installed != 0 then installed else ni_install_binaries(source, prefix, t)
fn ni_alias_lc(prefix) = if fs_path_exists(prefix + "/build/bin/lc") == 1 and fs_path_exists(prefix + "/build/bin/lumec") == 0 then let a = ni_copy(prefix + "/build/bin/lc", prefix + "/build/bin/lumec") in if a != 0 then a else ni_copy(prefix + "/build/bin/lc", prefix + "/bin/lumec") else 0
fn ni_install_l0(source, root, prefix) = let first = if fs_path_exists(source + "/lume0") == 1 then source + "/lume0" else if fs_path_exists(source + "/lume0.exe") == 1 then source + "/lume0.exe" else if fs_path_exists(root + "/bootstrap/lume0/lume0") == 1 then root + "/bootstrap/lume0/lume0" else root + "/bootstrap/lume0/lume0.exe" in if fs_path_exists(first) == 0 then 0 else let made = ni_run("/bin/mkdir", Cons("-p", Cons(prefix + "/bootstrap/lume0", Nil))) in if made != 0 then made else let name = if count(first) >= 4 and slice(first, count(first) - 4, count(first)) == ".exe" then "lume0.exe" else "lume0" in let a = ni_copy(first, prefix + "/bootstrap/lume0/" + name) in if a != 0 then a else ni_copy(first, prefix + "/bin/" + name)
fn ni_install_files(req) = let prefix = req.prefix in let root = req.root in if root == prefix then ni_copy(root + "/lume", prefix + "/bin/lume") else let a = ni_copy(root + "/lume", prefix + "/lume") in if a != 0 then a else let b = ni_copy(root + "/lume", prefix + "/bin/lume") in if b != 0 then b else let c = ni_run("/bin/cp", Cons("-R", Cons(root + "/compiler/stage1/.", Cons(prefix + "/compiler/stage1/", Nil)))) in if c != 0 then c else let d = ni_run("/bin/cp", Cons("-R", Cons(root + "/evolve/.", Cons(prefix + "/evolve/", Nil)))) in if d != 0 then d else let e = ni_copy_optional(root + "/scripts/amalgamate.src", prefix + "/scripts/amalgamate.src") in if e != 0 then e else let f = ni_copy_optional(root + "/scripts/install.src", prefix + "/scripts/install.src") in if f != 0 then f else let g = ni_copy_optional(root + "/scripts/lume_legacy.sh", prefix + "/scripts/lume_legacy.sh") in if g != 0 then g else ni_copy_optional(root + "/scripts/lume_make.src", prefix + "/scripts/lume_make.src")
fn ni_sha256(path) = let out = "/tmp/lume-ni-sha-" + str(os_getpid()) + ".out" in let status = os_run_capture_timeout("/usr/bin/sha256sum", Cons(path, Nil), out, out + ".err", 900000) in let text = if status == 0 then fs_read_file(out) else "" in if count(text) >= 64 then slice(text, 0, 64) else fs_sha256_file(path)
fn ni_manifest_line(prefix, relative) = ni_sha256(prefix + "/" + relative) + "  " + relative + "\n"
fn ni_manifest_binaries(prefix, names) = match names
    Nil        => ""
    Cons(h, t) => (if fs_path_exists(prefix + "/build/bin/" + h) == 1 then ni_manifest_line(prefix, "build/bin/" + h) else "") + ni_manifest_binaries(prefix, t)
fn ni_source_names_core() = Cons("lume_driver.src", Cons("lcli.src", Cons("lasm.src", Cons("lcaas.src", Cons("lcert.src", Cons("lmod.src", Cons("ltarget.src", Cons("lregistry.src", Cons("lmesh.src", Cons("los.src", Cons("lprotect.src", Cons("protect.src", Cons("leconomy.src", Cons("levolve.src", Cons("levidence.src", Cons("ldoc.src", Cons("lfmt.src", Cons("ltest.src", Cons("linteractive.src", Cons("ljson.src", Cons("lclex.src", Cons("lcparse.src", Cons("lsha.src", Nil)))))))))))))))))))))))
fn ni_source_names_std() = Cons("capsule.src", Cons("arena.src", Cons("bytes.src", Cons("fs.src", Cons("process.src", Cons("fs_sha256_file.src", Cons("net.src", Cons("gfx.src", Cons("async_rt.src", Cons("gui.src", Cons("db.src", Cons("media.src", Cons("nn.src", Cons("tensor.src", Cons("ai_runtime.src", Cons("actor.src", Cons("concurrency.src", Cons("ownership.src", Cons("decimal.src", Cons("table.src", Cons("query.src", Cons("interop.src", Cons("map.src", Cons("lgenesis.src", Cons("lsentience.src", Cons("lmanual.src", Cons("lume_crypto_blockchain_engine.src", Cons("lume_reversa_engine.src", Cons("lume_pingora_proxy_engine.src", Cons("lume_egm_engine.src", Cons("lume_ncm_engine.src", Cons("lume_opentpu_engine.src", Cons("lume_continuum_nexus_engine.src", Cons("lume_quantum_nexus_engine.src", Nil))))))))))))))))))))))))))))))))))
fn ni_source_names_lume() = Cons("lume/01_lexer.src", Cons("lume/02_parser.src", Cons("lume/03_comptime.src", Cons("lume/04_parser_decls.src", Cons("lume/05_codegen.src", Cons("lume/06_typecheck.src", Cons("lume/06b_phase3.src", Cons("lume/06c_phase4.src", Cons("lume/06d_phase5.src", Cons("lume/07_driver.src", Nil))))))))))
fn ni_source_names() = ni_source_names_core()
fn ni_manifest_all_sources(prefix) = ni_manifest_sources(prefix, ni_source_names_core()) + ni_manifest_sources(prefix, ni_source_names_std()) + ni_manifest_sources(prefix, ni_source_names_lume())
fn ni_manifest_sources(prefix, names) = match names
    Nil        => ""
    Cons(h, t) => (if fs_path_exists(prefix + "/compiler/stage1/" + h) == 1 then ni_manifest_line(prefix, "compiler/stage1/" + h) else "") + ni_manifest_sources(prefix, t)
fn ni_manifest(prefix) = let text = ni_manifest_line(prefix, "lume") + ni_manifest_line(prefix, "bin/lume") + ni_manifest_binaries(prefix, ni_binary_names()) + ni_manifest_all_sources(prefix) in if fs_write_sync(prefix + "/MANIFEST.sha256", text) == 1 then ni_sha256(prefix + "/MANIFEST.sha256") else ""
fn ni_main(req) = if req.prefix == "" or req.root == "" then "installer requires @prefix and @from-local" else if fs_path_exists(req.root + "/lume") == 0 then "repository root has no lume launcher" else if ni_mkdirs(req.prefix) != 0 then "cannot create installation directories" else let files = ni_install_files(req) in if files != 0 then "cannot install source artifacts: native status " + str(files) else let source = if req.bin == "" then req.root + "/build/bin" else req.bin in let binaries = ni_install_binaries(source, req.prefix, ni_binary_names()) in if binaries != 0 then "cannot install native binaries: native status " + str(binaries) else let alias = ni_alias_lc(req.prefix) in if alias != 0 then "cannot install lumec alias" else let seeded = ni_install_l0(source, req.root, req.prefix) in if seeded != 0 then "cannot install frozen seed" else let digest = ni_manifest(req.prefix) in if digest == "" then "cannot write installation manifest" else "{\"ok\":true,\"installer\":\"lume-install-v1\",\"prefix\":\"" + req.prefix + "\",\"version\":\"0.3.0-rc.3\",\"edition\":\"2026\",\"zero_c_steady_state\":true,\"manifest_sha256\":\"sha256:" + digest + "\"}"
fn ni_dispatch(input) = let result = ni_main(ni_request(input)) in if count(result) >= 6 and slice(result, 0, 6) == "{\"ok\":" then result else ctfail("native installer failed: " + result + "\n")

fn ni_arg0_idx() = if os_arg_count() >= 2 and os_arg_at(1) == "--" then 2 else 1
fn ni_cli_flag(i, flag, def) = if i + 1 >= os_arg_count() then def else if os_arg_at(i) == flag then os_arg_at(i + 1) else ni_cli_flag(i + 1, flag, def)
fn ni_entry() = let idx = ni_arg0_idx() in if os_arg_count() > idx and os_arg_at(idx) == "--write-manifest" then let pfx = if os_arg_count() > idx + 1 then os_arg_at(idx + 1) else "." in let digest = ni_manifest(pfx) in "{\"ok\":true,\"installer\":\"lume-install-v1\",\"prefix\":\"" + pfx + "\",\"manifest_sha256\":\"sha256:" + digest + "\"}" else if os_arg_count() > idx and ni_cli_flag(idx, "--prefix", "") != "" then ni_main({prefix: ni_cli_flag(idx, "--prefix", ""), root: ni_cli_flag(idx, "--from-local", "."), bin: ni_cli_flag(idx, "--from-dir", "build/bin")}) else if os_arg_count() > idx then ctfail("usage: install.src [--write-manifest [prefix] | --prefix <dir> [--from-local <root>] [--from-dir <bin>]]\n") else ni_dispatch(readall())

fn test_request_reads_all_install_modes() = let req = ni_request("@prefix /tmp/lume\n@from-local /work/lume\n@from-dir /work/lume/build/bin\n") in req.prefix == "/tmp/lume" and req.root == "/work/lume" and req.bin == "/work/lume/build/bin"
fn test_binary_set_contains_cross_target_probes() = let names = ni_binary_names() in ni_install_binary("/definitely/missing", "/definitely/missing", "lume-target-check.exe") == 0
fn test_manifest_line_binds_exact_file_bytes() = let written = fs_write_sync("ni_manifest_probe", "abc") in ni_manifest_line(".", "ni_manifest_probe") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  ni_manifest_probe\n"
fn test_same_file_copy_and_same_root_install_are_safe() = ni_copy("/tmp/same_path_probe", "/tmp/same_path_probe") == 0 and ni_copy_optional("/tmp/same_path_probe", "/tmp/same_path_probe") == 0

print ni_entry()
