#!/bin/sh
# lume — thin POSIX bootstrap shim for the native Lume driver (P0 final: the wrapper is gone).
#
# Every command is implemented natively by build/bin/lume_driver (compiled from
# compiler/stage1/lume_driver.src). This shim keeps only the shell that the native
# toolchain cannot provide:
#   1. locate the repository root,
#   2. on a fresh clone, build the frozen seed and bootstrap the native toolchain
#      (lumec + lasm + lmod, then lume_driver and the core tools it dispatches to),
#   3. exec the native driver.
#
# Line budget: the bootstrap+exec core below aims at <= 60 lines; the file is 136
# lines because the routing guard for commands with no native equivalent (27 lines)
# is kept here on purpose. Everything that needs more shell has no native equivalent
# and stays on the legacy dispatcher scripts/lume_legacy.sh (surface .lume check/run/
# test, the canonical .lume formatting fallback, the POSIX installer emit, and any
# host where the x86_64-linux-elf toolchain cannot run: macOS, Windows, qemu runners).
# See docs/PROJECT_STATE.md — that remaining liability is reported, not hidden.
set -eu
PATH="${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}"; export PATH
# The self-hosted lexer/parser recurse per source character; raise the native stack.
ulimit -s unlimited 2>/dev/null || ulimit -s 524288 2>/dev/null || ulimit -s 65520 2>/dev/null || ulimit -s 32768 2>/dev/null || true

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ ! -d "$ROOT/compiler/stage1" ] && [ -d "$ROOT/../compiler/stage1" ]; then
    ROOT=$(CDPATH= cd -- "$ROOT/.." && pwd)
fi
SRC="$ROOT/compiler/stage1"
BIN="$ROOT/build/bin"
DRIVER="$BIN/lume_driver"
LEGACY="$ROOT/scripts/lume_legacy.sh"
L0="${LUME0_BIN:-$ROOT/bootstrap/lume0/lume0}"
[ -f "$L0" ] || L0="$ROOT/bootstrap/lume0/lume0.exe"

# Route what has no native equivalent to the legacy dispatcher.
if [ "$(uname -s 2>/dev/null || echo unknown)" != "Linux" ] || [ "$(uname -m 2>/dev/null || echo unknown)" != "x86_64" ] || [ -n "${LUME0_RUNNER:-}" ]; then
    exec "$LEGACY" "$@"
fi
if [ ! -x "$DRIVER" ] && { [ ! -f "$ROOT/bootstrap/lume0/Makefile" ] || [ -n "${LUME0_RUNNER:-}" ]; }; then
    # Installed prefix without the native driver (older installs): seed fallback.
    exec "$LEGACY" "$@"
fi
case "${1:-}" in
    build | check | test)
        for _a in "$@"; do
            case "$_a" in
                *.lume | *.lbe | *.intent) exec "$LEGACY" "$@" ;;
            esac
        done
        ;;
    run)
        case "${2:-}" in
            *.lume | *.lbe | *.intent | *.lumb | *.wasm | *.ptx | *.spvasm | *.v | *.vhd | *.cortexm | *.avr.elf | *.xtensa.elf | *.avr.hex | *.avr.ihex | *.xtensa.hex | *.xtensa.ihex) exec "$LEGACY" "$@" ;;
        esac
        ;;
    fmt)
        for _a in "$@"; do
            case "$_a" in
                -* | *.src) ;;
                *) exec "$LEGACY" "$@" ;;
            esac
        done
        ;;
esac

# Module helpers for the lume_driver bundle below (imports live in compiler/stage1).
imports_of() {
    awk '/^[ \t]*use[ \t]+/{sub(/^[ \t]*use[ \t]+/,""); sub(/[ \t\r]+$/,""); sub(/^std\./,""); print $1}' "$1"
}

add_mod() {
    case " $SEEN " in
        *" $1 "*) return 0 ;;
    esac
    SEEN="$SEEN $1"
    printf '@module %s\n' "$1"
    cat "$SRC/$1.src"
    printf '\n@end\n'
    for _m in $(imports_of "$SRC/$1.src"); do
        add_mod "$_m"
    done
}

if [ ! -x "$DRIVER" ]; then
    # Fresh clone: frozen C seed -> lumec + lasm + lmod -> lume_driver -> core tools.
    [ -x "$L0" ] || make -s -C "$ROOT/bootstrap/lume0"
    mkdir -p "$BIN"
    LUMEC="$BIN/lumec"
    LASM="$BIN/lasm"
    if { [ ! -x "$LUMEC" ] || [ ! -x "$LASM" ]; } && [ -n "${LUME_BIN_DIR:-}" ] && [ -x "$LUME_BIN_DIR/lc" ] && [ -x "$LUME_BIN_DIR/lasm" ]; then
        LUMEC="$LUME_BIN_DIR/lc"
        LASM="$LUME_BIN_DIR/lasm"
    fi
    if [ ! -x "$LUMEC" ]; then
        "$L0" run "$SRC/data_asm_cc.lume" "$ROOT/scripts/amalgamate.src" "$BIN/amalgamate.s" >/dev/null 2>&1
        "$L0" asm "$BIN/amalgamate.s" "$BIN/amalgamate" >/dev/null 2>&1
        chmod +x "$BIN/amalgamate"
        printf '@root %s\n' "$ROOT" | "$BIN/amalgamate" >/dev/null
        rm -f "$BIN/amalgamate.s"
        [ -f "$SRC/lumec.src" ] || { echo "lume: amalgamation did not produce compiler/stage1/lumec.src" >&2; exit 1; }
        "$L0" run "$SRC/data_asm_cc.lume" "$SRC/lumec.src" "$BIN/lumec.s" >/dev/null 2>&1
        "$L0" asm "$BIN/lumec.s" "$LUMEC" >/dev/null 2>&1
        chmod +x "$LUMEC"
        rm -f "$BIN/lumec.s"
    fi
    if [ ! -x "$LASM" ]; then
        "$LUMEC" < "$SRC/lasm.src" > "$BIN/lasm.s" 2>/dev/null
        "$L0" asm "$BIN/lasm.s" "$LASM" >/dev/null 2>&1
        chmod +x "$LASM"
        rm -f "$BIN/lasm.s"
    fi
    "$LUMEC" < "$SRC/lmod.src" > "$BIN/lmod.s" 2>/dev/null
    "$LASM" < "$BIN/lmod.s" > "$BIN/lmod"
    chmod +x "$BIN/lmod"
    rm -f "$BIN/lmod.s"
    # lume_driver uses fs_sha256_file and linteractive (which uses ljson): bundle via lmod.
    SEEN="lume_driver"
    BUN="$BIN/lume_driver.bundle"
    {
        printf '@grant io\n'
        for _m in $(imports_of "$SRC/lume_driver.src"); do add_mod "$_m"; done
        printf '@entry lume_driver\n'
        cat "$SRC/lume_driver.src"
        printf '\n@end\n'
    } > "$BUN"
    "$BIN/lmod" < "$BUN" > "$BIN/lume_driver.flat"
    "$LUMEC" < "$BIN/lume_driver.flat" > "$BIN/lume_driver.s" 2>/dev/null
    "$LASM" < "$BIN/lume_driver.s" > "$DRIVER"
    chmod +x "$DRIVER"
    rm -f "$BUN" "$BIN/lume_driver.flat" "$BIN/lume_driver.s"
    for _t in lcli lcaas lcert lfmt ltest ldoc lmesh levolve leconomy lprotect ltarget lregistry lume_make; do
        "$DRIVER" build "$SRC/$_t.src" -o "$BIN/$_t" || { echo "lume: bootstrap failed building $_t" >&2; exit 1; }
    done
fi

exec "$DRIVER" "$@"
