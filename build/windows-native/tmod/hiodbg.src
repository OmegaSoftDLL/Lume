use hostio
let base = "build/hostio_dbg"
let r0 = hio_remove_tree(base)
print "r0 " + str(r0) + " exists " + str(fs_path_exists(base))
print "mk " + str(hio_mkdir_p(base + "/a/b/c"))
print "isdir a " + str(hio_is_dir(base + "/a")) + " dot " + str(fs_path_exists(base + "/a/."))
let w = fs_write_sync(base + "/a/b/c/f.txt", "x\ny")
let w2 = fs_write_sync(base + "/a/top.txt", "t")
print "isdir file " + str(hio_is_dir(base + "/a/top.txt"))
print "entries [" + fs_read_dir(base + "/a") + "]"
print "cp " + str(hio_run("cp", Cons("-R", Cons(base + "/a", Cons(base + "/copy", Nil)))))
print "same " + str(fs_read_file(base + "/copy/b/c/f.txt") == "x\ny")
print "mv " + str(hio_run("mv", Cons("-f", Cons(base + "/copy/top.txt", Cons(base + "/moved.txt", Nil)))))
print "moved " + str(fs_path_exists(base + "/moved.txt")) + " gone " + str(fs_path_exists(base + "/copy/top.txt"))
print "into " + str(hio_run("cp", Cons("-f", Cons(base + "/moved.txt", Cons(base + "/a", Nil)))))
print "inside " + str(fs_path_exists(base + "/a/moved.txt"))
print "rm " + str(hio_run("rm", Cons("-rf", Cons(base, Nil)))) + " exists " + str(fs_path_exists(base))
