# asm2lume.src -- turn an assembly file into one Lume-Core runtime function in the style of runtime_core.lume:
#   fn <name>() = "line\n" + "line\n" + ...
# Usage: lume run build/windows-native/asm2lume.src <name> < file.s
# Comment lines (starting with '#') are dropped; quotes and backslashes are escaped.

fn esc_ch(c) = if c == "\\" then "\\\\" else if c == "\"" then "\\\"" else c
fn esc(s, i, n, acc) = if i >= n then acc else esc(s, i + 1, n, acc + esc_ch(at(s, i)))
fn line_end(s, n, i) = if i >= n then n else if at(s, i) == "\n" then i else line_end(s, n, i + 1)
fn is_comment(l) = count(l) > 0 and at(l, 0) == "#"
fn piece(l) = "\"" + esc(l, 0, count(l), "") + "\\n\""
fn pieces(s, n, i, acc) = if i >= n then acc else let e = line_end(s, n, i) in let l = slicen(s, n, i, e) in let acc2 = if count(l) == 0 or is_comment(l) then acc else Cons(piece(l), acc) in pieces(s, n, e + 1, acc2)
fn join_plus(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => join_plus(t, if acc == "" then h else h + " + " + acc)
fn convert(name, src) = "fn " + name + "() = " + join_plus(pieces(src, count(src), 0, Nil), "")

print convert(os_arg_at(1), readall())
