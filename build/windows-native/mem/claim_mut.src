## Claim 1: "Lume has no mutable binary array at run time" - the raw-memory builtins that exist today
let base = os_shm_map(4096)
print "os_shm_map(4096) gives an address: " + str(if base > 0 then 1 else 0)
let w0 = mmio_volatile_write8(base + 0, 0)
let w1 = mmio_volatile_write8(base + 1, 255)
let w2 = mmio_volatile_write8(base + 2, 7)
print "bytes written/read: " + str(mmio_volatile_read8(base + 0)) + " " + str(mmio_volatile_read8(base + 1)) + " " + str(mmio_volatile_read8(base + 2))
let w3 = mmio_volatile_write8(base + 1, 128)
print "same address changed in place: " + str(mmio_volatile_read8(base + 1))
let f = mem_set(base + 16, 65, 4)
print "mem_set 4 x 65: " + str(mmio_volatile_read8(base + 16)) + " " + str(mmio_volatile_read8(base + 19))
let c = mem_copy(base + 32, base, 3)
print "mem_copy: " + str(mmio_volatile_read8(base + 32)) + " " + str(mmio_volatile_read8(base + 33)) + " " + str(mmio_volatile_read8(base + 34))
print "no bounds check: reading past the 4096 bytes is not stopped by the language (not run here)"
