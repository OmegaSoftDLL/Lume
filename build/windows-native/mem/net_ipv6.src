## IPv6: UDP over ::1 both ways with the sender reported, TCP listening on :: and connecting to ::1, address forms
let a = net_udp_bind_addr("::1", 47840)
let b = net_udp_bind_addr("::", 47841)
let msg = "QUIC" + chr(0) + chr(255)
let s1 = net_udp_send_to(a, "::1", 47841, msg)
let r1 = net_udp_recv_from(b, 2048)
print "udp6 a -> b: sent " + str(s1) + ", identical " + str(if r1 == msg then 1 else 0) + ", from [" + net_last_peer_ip() + "]:" + str(net_last_peer_port())
let s2 = net_udp_send_to(b, net_last_peer_ip(), net_last_peer_port(), "pong6")
print "udp6 reply to the sender: " + net_udp_recv_from(a, 64) + " from [" + net_last_peer_ip() + "]:" + str(net_last_peer_port())
let sfd = net_tcp_listen_addr("::", 47842)
let pid = os_fork()
let r = if pid == 0 then (let c = net_tcp_connect_addr("::1", 47842) in let s = net_send_str(c, "tcp6" + chr(0)) in let z = net_close(c) in os_exit(if s == 5 then 0 else 1)) else 0
let afd = net_tcp_accept(sfd)
let peer = net_last_peer_ip()
let got = net_recv_str(afd, 64)
let st = os_waitpid_status(pid)
print "tcp6: listen ok " + str(if sfd >= 0 then 1 else 0) + ", client [" + peer + "], got " + str(count(got)) + " bytes, child " + str(st)
fn ok(ip) = let fd = net_udp_bind_addr(ip, 0) in let r = if fd >= 0 then net_close(fd) else 0 in if fd >= 0 then 1 else 0
print "forms: ::1 " + str(ok("::1")) + ", 0:0:0:0:0:0:0:1 " + str(ok("0:0:0:0:0:0:0:1")) + ", 0::1 " + str(ok("0::1")) + ", :: " + str(ok("::")) + ", ::0:1 " + str(ok("::0:1"))
print "bad: " + str(net_udp_bind_addr("1::2::3", 1)) + " " + str(net_udp_bind_addr("12345::1", 1)) + " " + str(net_udp_bind_addr("::g", 1)) + " " + str(net_udp_bind_addr("1:2:3:4:5:6:7:8:9", 1)) + " " + str(net_udp_bind_addr("1:", 1)) + " " + str(net_udp_bind_addr("::ffff:1.2.3.4", 1))
print "ipv4 still: " + str(ok("127.0.0.1")) + " " + str(ok("0.0.0.0"))
