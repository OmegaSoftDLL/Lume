## Where a NUL byte is really lost: the socket builtins
let msg = "AB" + chr(0) + "CD"
let sfd = net_tcp_listen(42993)
let pid = os_fork()
let r = if pid == 0 then (let c = net_tcp_connect(42993) in let s = net_send_str(c, msg) in let p = fs_write_sync("claim_net_sent", str(s)) in let z = net_close(c) in os_exit(0)) else 0
let afd = net_tcp_accept(sfd)
let got = net_recv_str(afd, 64)
let st = os_waitpid_status(pid)
print "net_send_str of a 5-byte string with NUL at 2 sent " + fs_read_file("claim_net_sent") + " bytes"
print "net_recv_str got count " + str(count(got)) + ": " + got
let z1 = fs_remove("claim_net_sent")
print "file path with NUL: fs_write_sync = " + str(fs_write_sync("a" + chr(0) + "b", "x"))
