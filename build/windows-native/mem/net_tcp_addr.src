## TCP with addresses: listen on every interface, connect by address, the client is reported by accept
let sfd = net_tcp_listen_addr("0.0.0.0", 47830)
let pid = os_fork()
let r = if pid == 0 then (let c = net_tcp_connect_addr("127.0.0.1", 47830) in let s = net_send_str(c, "hi" + chr(0) + "there") in let z = net_close(c) in os_exit(if s == 8 then 0 else 1)) else 0
let afd = net_tcp_accept(sfd)
let peer = net_last_peer_ip()
let got = net_recv_str(afd, 64)
let st = os_waitpid_status(pid)
print "listen 0.0.0.0 ok " + str(if sfd >= 0 then 1 else 0) + ", client " + peer + ", got " + str(count(got)) + " bytes, identical " + str(if got == "hi" + chr(0) + "there" then 1 else 0) + ", child " + str(st)
print "connect to a closed port: " + str(net_tcp_connect_addr("127.0.0.1", 47839)) + ", bad ip: " + str(net_tcp_connect_addr("localhost", 80))
