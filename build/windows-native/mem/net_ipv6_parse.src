## IPv6 parser through net_udp_send_to: a well-formed address reaches the system (bytes sent or a network error), a
## malformed one gives -1 before any system call
let u = net_udp_bind_addr("::", 0)
fn try6(ip) = let r = net_udp_send_to(u, ip, 9, "x") in if r == 0 - 1 then "malformed" else "accepted"
print "2001:db8::8a2e:370:7334 " + try6("2001:db8::8a2e:370:7334")
print "2001:DB8:0:0:8:800:200C:417A " + try6("2001:DB8:0:0:8:800:200C:417A")
print "fe80::1 " + try6("fe80::1") + ", ff02::1 " + try6("ff02::1") + ", 1:: " + try6("1::")
print "1:2:3:4:5:6:7:: " + try6("1:2:3:4:5:6:7::") + ", ::2:3:4:5:6:7:8 " + try6("::2:3:4:5:6:7:8")
print "1:2:3:4:5:6:7:8:: " + try6("1:2:3:4:5:6:7:8::") + ", :1 " + try6(":1") + ", 1:::2 " + try6("1:::2") + ", empty " + try6("")
