## a live lookup through the system's nameservers (needs the network)
use dns
fn js(xs) = match xs
    Nil        => ""
    Cons(h, t) => h + " " + js(t)
print "localhost: " + js(dns_resolve("localhost"))
print "example.com: " + js(dns_resolve("example.com"))
print "github.com first: " + dns_resolve_first("github.com")
print "no such name: [" + js(dns_resolve("no-such-host.invalid")) + "]"
let fd = dns_tcp_connect("example.com", 80)
let s = if fd >= 0 then net_send_str(fd, "HEAD / HTTP/1.0\r\nHost: example.com\r\n\r\n") else 0
let r = if fd >= 0 then net_recv_str(fd, 64) else ""
print "tcp to example.com:80 by name: " + slice(r, 0, 12)
