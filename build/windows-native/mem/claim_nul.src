## Claim 2: "the runtime string ends in NUL, so it cannot carry byte 0" - what the builtins really do
let z = chr(0)
print "chr(0) count = " + str(count(z))
let s = "AB" + z + "CD"
print "\"AB\" + chr(0) + \"CD\": count = " + str(count(s))
print "ord(at(s, 2)) = " + str(ord(at(s, 2)))
print "ord(at(s, 3)) = " + str(ord(at(s, 3)))
print "slice(s, 3, 5) = " + slice(s, 3, 5)
let big = "0123456789" + z + "abcdefghij"
print "long string with NUL: count = " + str(count(big)) + ", at 11 = " + at(big, 11)
let w = fs_write_sync("claim_nul_probe", s)
print "fs_write_sync ok = " + str(w)
let back = fs_read_file("claim_nul_probe")
print "fs_read_file count = " + str(count(back)) + ", equal = " + str(if back == s then 1 else 0)
print "fs_read_byte offset 2 = " + str(fs_read_byte("claim_nul_probe", 2)) + ", offset 3 = " + str(fs_read_byte("claim_nul_probe", 3))
let r = fs_remove("claim_nul_probe")
print "bytes 0..255 in one string:"
fn mk(i, acc) = if i > 255 then acc else mk(i + 1, acc + chr(i))
let b256 = mk(0, "")
print "  count = " + str(count(b256)) + ", ord(at 0) = " + str(ord(at(b256, 0))) + ", ord(at 255) = " + str(ord(at(b256, 255)))
let w2 = fs_write_sync("claim_nul_probe2", b256)
print "  file roundtrip equal = " + str(if fs_read_file("claim_nul_probe2") == b256 then 1 else 0)
let r2 = fs_remove("claim_nul_probe2")
