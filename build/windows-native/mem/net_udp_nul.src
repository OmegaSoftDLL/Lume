## UDP: a datagram with byte 0 and high bytes, sent with the port-only net_udp_sendto and received whole
let u = net_udp_bind(47814)
let sent = net_udp_sendto(47814, "A" + chr(0) + "B" + chr(255))
let got = net_recv_str(u, 64)
print "net_udp_sendto sent " + str(sent) + ", received count " + str(count(got)) + ", identical " + str(if got == "A" + chr(0) + "B" + chr(255) then 1 else 0)
