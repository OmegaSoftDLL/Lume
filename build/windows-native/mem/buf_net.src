## binary data over a socket: a string with NUL and high bytes goes through net_send_str / net_recv_str whole
let msg = "AB" + chr(0) + "CD" + chr(255) + chr(0)
let sfd = net_tcp_listen(42991)
let pid = os_fork()
let r = if pid == 0 then (let c = net_tcp_connect(42991) in let s = net_send_str(c, msg) in let z = net_close(c) in os_exit(if s == 7 then 0 else 1)) else 0
let afd = net_tcp_accept(sfd)
let got = net_recv_str(afd, 64)
let st = os_waitpid_status(pid)
print "sender sent all 7 bytes: " + str(if st == 0 then 1 else 0)
print "received count " + str(count(got)) + ", identical " + str(if got == msg then 1 else 0) + ", byte 2 = " + str(ord(at(got, 2))) + ", byte 5 = " + str(ord(at(got, 5)))
let b = buf_from_str(got)
print "as a buffer: len " + str(buf_len(b)) + ", byte 6 = " + str(buf_get(b, 6))
