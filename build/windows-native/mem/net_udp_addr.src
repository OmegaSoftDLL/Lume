## UDP with addresses: two bound sockets talk with net_udp_send_to / net_udp_recv_from, the sender is reported
let a = net_udp_bind_addr("127.0.0.1", 47820)
let b = net_udp_bind_addr("0.0.0.0", 47821)
let msg = "STUN" + chr(0) + chr(1) + chr(255)
let s1 = net_udp_send_to(a, "127.0.0.1", 47821, msg)
let r1 = net_udp_recv_from(b, 2048)
print "a -> b: sent " + str(s1) + ", got " + str(count(r1)) + " bytes, identical " + str(if r1 == msg then 1 else 0) + ", from " + net_last_peer_ip() + ":" + str(net_last_peer_port())
let s2 = net_udp_send_to(b, net_last_peer_ip(), net_last_peer_port(), "pong")
let r2 = net_udp_recv_from(a, 2048)
print "b -> a (reply to the sender): " + r2 + ", from " + net_last_peer_ip() + ":" + str(net_last_peer_port())
print "bad ip: " + str(net_udp_bind_addr("300.1.1.1", 47822)) + " " + str(net_udp_bind_addr("1.2.3", 47822)) + " " + str(net_udp_send_to(a, "x.y", 1, "z")) + ", bad port: " + str(net_udp_bind_addr("127.0.0.1", 70000))
