use dns
fn js(xs) = match xs
    Nil        => ""
    Cons(h, t) => h + " " + js(t)
print "servers used: " + js(dnsr_nameservers(os_dns_servers()))
let u = net_udp_bind_addr("::", 0)
print "zone by friendly name: " + str(net_udp_send_to(u, "fe80::1%Loopback Pseudo-Interface 1", 9, "x"))
print "zone by unknown name: " + str(net_udp_send_to(u, "fe80::1%nosuchif", 9, "x"))
