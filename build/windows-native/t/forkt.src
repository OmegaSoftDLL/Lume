# forkt.src -- a real fork: parent and child run at once, talk through a socket, share nothing after fork
fn big(n, acc) = if n == 0 then acc else big(n - 1, acc + "x")
let keep = big(100000, "")
fn try_port(p) = let s = net_tcp_listen(p) in if s >= 0 or p > 48999 then {s: s, p: p} else try_port(p + 1)
let l = try_port(48210)
let pid = os_fork()
let r = if pid == 0 then (let c = net_tcp_connect(l.p) in let s = net_send_str(c, "hello from child " + str(count(keep))) in let back = net_recv_str(c, 128) in let z = net_close(c) in os_exit(if back == "ack" then 7 else 1)) else (let a = net_tcp_accept(l.s) in let m = net_recv_str(a, 128) in let s = net_send_str(a, "ack") in let z = net_close(a) in m)
let st = os_waitpid_status(pid)
print "parent got [" + r + "] child status " + str(st)
