# gcbench.src -- collector throughput measured inside the process (no process start-up in the number):
# 2 GiB of short-lived cells; run under LUME_HEAP_CAP=32m so the collector and the chunk release run constantly.
fn cell_chain(n, acc) = if n == 0 then acc else cell_chain(n - 1, Cons({v: n}, acc))
fn len_of(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => len_of(t, acc + 1)
fn spin(i, acc) = if i == 0 then acc else spin(i - 1, acc + len_of(cell_chain(1000, Nil), 0))
fn keep(n, acc) = if n == 0 then acc else keep(n - 1, Cons("s" + str(n), acc))
let t0 = os_monotonic_ns()
let a = spin(10000, 0)
let t1 = os_monotonic_ns()
let big = keep(400000, Nil)
let b = spin(2000, 0)
let t2 = os_monotonic_ns()
print "churn_ms " + str((t1 - t0) / 1000000)
print "churn_with_live_ms " + str((t2 - t1) / 1000000)
print a + b + len_of(big, 0)
