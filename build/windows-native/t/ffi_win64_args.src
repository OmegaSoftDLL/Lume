## Win64 C ABI: the 5th and 6th arguments travel on the stack above the shadow space (Windows only, --link kernel32).
## MultiByteToWideChar(CP_UTF8, 0, "abc", 3, dst, cap): 0 when cap (6th) is too small, 3 when dst (5th) has room.
extern "c" fn MultiByteToWideChar(cp: int, flags: int, src: str, n: int, dst: str, cap: int) -> int
fn pad(s, n) = if count(s) >= n then s else pad(s + "x", n)
fn conv(cap) / {ffi} = MultiByteToWideChar(65001, 0, "abc", 3, pad("y", 32), cap)
print "room 1: " + str(conv(1))
print "room 8: " + str(conv(8))
