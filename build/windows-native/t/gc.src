fn build(n, acc) = if n == 0 then acc else build(n - 1, Cons("item" + str(n), acc))
fn total(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => total(t, acc + count(h))
fn loop(i, s) = if i == 0 then s else loop(i - 1, s + total(build(20000, Nil), 0))
print loop(30, 0)
print 9223372036854775807 +% 1
