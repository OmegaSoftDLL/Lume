# probe.src -- contracts, law, wrapping arithmetic and tests, for the native Windows toolchain
fn soma_mod(a, b) = a +% b

fn limite(n)
  requires n >= 0 and n <= 255
  ensures result >= 0
= n

law limite_nao_negativo(n) = if n >= 0 then n + 1 > n else 1 == 1

fn test_soma() = soma_mod(2, 3) == 5
fn test_limite() = limite(10) == 10
fn test_wrap() = soma_mod(9223372036854775807, 1) < 0

print limite(42)
