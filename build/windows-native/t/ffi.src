## extern "c": C library functions through the platform C ABI (System V on Linux, Win64 on Windows), --link c
extern "c" fn atoi(s: str) -> int
extern "c" fn labs(x: int) -> int
fn ffi_atoi(s) / {ffi} = atoi(s)
fn ffi_labs(x) / {ffi} = labs(x)
print "atoi " + str(ffi_atoi("4242"))
print "labs " + str(ffi_labs(0 - 77))
