## os_shm_map: an anonymous shared mapping stays shared with a fork child (MAP_SHARED | MAP_ANONYMOUS)
let base = os_shm_map(65536)
let w0 = mmio_volatile_write64(base, 11)
let pid = os_fork()
let r = if pid == 0 then (let w1 = mmio_volatile_write64(base + 8, 4242) in let w2 = mmio_volatile_write64(base, mmio_volatile_read64(base) + 1) in os_exit(0)) else 0
let st = os_waitpid_status(pid)
print "child status " + str(st)
print "parent sees " + str(mmio_volatile_read64(base)) + " " + str(mmio_volatile_read64(base + 8))
