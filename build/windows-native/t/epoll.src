## epoll on pipes: readiness order, level-triggered re-report, DEL, timeout with nothing ready
let epfd = epoll_create_fd()
let pk1 = os_pipe_new()
let r1 = pk1 / 10000
let w1 = pk1 % 10000
let pk2 = os_pipe_new()
let r2 = pk2 / 10000
let w2 = pk2 % 10000
let a1 = epoll_add_in(epfd, r1, 101)
let a2 = epoll_add_in(epfd, r2, 202)
print "add " + str(a1) + " " + str(a2) + " again " + str(epoll_add_in(epfd, r1, 303))
let t0 = os_monotonic_ns()
let none = epoll_wait_one(epfd, 50)
let ms = (os_monotonic_ns() - t0) / 1000000
print "nothing ready: " + str(none) + " waited>=40ms " + str(if ms >= 40 and ms < 2000 then 1 else 0)
let x2 = os_pipe_write_int(w2, 12345)
let e1 = epoll_wait_one(epfd, 1000)
let e1b = epoll_wait_one(epfd, 0)
print "ready " + str(e1 % 1000) + " still ready (level) " + str(e1b % 1000)
let g2 = os_pipe_read_int(r2)
let x1 = os_pipe_write_int(w1, 777)
let e2 = epoll_wait_one(epfd, 1000)
let g1 = os_pipe_read_int(r1)
print "then " + str(e2 % 1000) + " values " + str(g2) + " " + str(g1)
let c = net_close(w1)
let e3 = epoll_wait_one(epfd, 1000)
print "writer closed: " + str(e3 % 1000)
