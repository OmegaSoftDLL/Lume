let d = "lume_win_fs_probe"
let mk = fs_mkdir(d)
let w = fs_write_sync(d + "/a.txt", "linha um\n")
let ap = fs_append_sync(d + "/a.txt", "linha dois\n")
print fs_read_file(d + "/a.txt")
print fs_path_exists(d + "/a.txt")
print fs_path_exists(d + "/nao_existe.txt")
print fs_read_byte(d + "/a.txt", 0)
let w2 = fs_write_sync(d + "/b.txt", "linha um\nlinha dois\n")
print fs_files_equal(d + "/a.txt", d + "/b.txt")
print at(fs_current_dir(), 0)
print fs_read_dir(d)
let r1 = fs_remove(d + "/a.txt")
let r2 = fs_remove(d + "/b.txt")
print fs_path_exists(d + "/a.txt")
print fs_read_dir(d) == ""
print "ação ✓ 日本"
