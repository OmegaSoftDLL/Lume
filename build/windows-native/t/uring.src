## io_uring through the three raw system calls (the rings are not mapped by Lume programs: the queues stay empty)
let fd = os_io_uring_setup(8, 0)
print "setup " + str(if fd >= 3 then 1 else fd)
print "setup 0 entries " + str(os_io_uring_setup(0, 0))
print "setup bad flags " + str(os_io_uring_setup(8, 4194304))
print "enter submit 0 " + str(os_io_uring_enter(fd, 0, 0))
print "enter submit 4 " + str(os_io_uring_enter(fd, 4, 0))
print "enter on a pipe " + str(os_io_uring_enter(os_pipe_new() / 10000, 0, 0))
print "register op 99 " + str(os_io_uring_register(fd, 99, 0))
print "register nop " + str(os_io_uring_register(fd, 0, 0))
print "close " + str(net_close(fd))
