fn fib(n: int) -> int = if n < 2 then n else fib(n - 1) + fib(n - 2)
fn build(n, acc) = if n == 0 then acc else build(n - 1, Cons("item" + str(n), acc))
fn total(xs, acc) = match xs
    Nil        => acc
    Cons(h, t) => total(t, acc + count(h))
fn loop(i, s) = if i == 0 then s else loop(i - 1, s + total(build(20000, Nil), 0))
let t0 = os_monotonic_ns()
let a = fib(32)
let t1 = os_monotonic_ns()
let b = loop(30, 0)
let t2 = os_monotonic_ns()
print "fib32_us " + str((t1 - t0) / 1000)
print "alloc_us " + str((t2 - t1) / 1000)
print a + b
