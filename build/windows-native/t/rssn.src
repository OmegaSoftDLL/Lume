fn mk(n, acc) = if n == 0 then acc else mk(n - 1, Cons(n, acc))
fn len(xs, a) = match xs
    Nil => a
    Cons(h, t) => len(t, a + 1)
let n = toint(os_arg_at(1))
let base = os_self_maxrss_kb()
let xs = mk(n, Nil)
let after = os_self_maxrss_kb()
print str(n) + " base " + str(base) + " growth " + str(after - base) + " n " + str(len(xs, 0))
