let p = "mem/probes_w/os_run_probe"
let t0 = os_monotonic_ns()
let st = os_run_capture_timeout(p, Nil, "ort_out", "ort_err", 1000)
let t1 = os_monotonic_ns()
print "t1000: status " + str(st) + " timed_out " + str(os_last_timed_out()) + " ms " + str((t1 - t0) / 1000000) + " out [" + fs_read_file("ort_out") + "]"
let st2 = os_run_capture_timeout(p, Nil, "ort_out", "ort_err", 30000)
let t2 = os_monotonic_ns()
print "t30000: status " + str(st2) + " timed_out " + str(os_last_timed_out()) + " ms " + str((t2 - t1) / 1000000) + " out [" + fs_read_file("ort_out") + "]"
let st3 = os_run_capture(p, Nil, "ort_out", "ort_err")
let t3 = os_monotonic_ns()
print "no timeout: status " + str(st3) + " ms " + str((t3 - t2) / 1000000) + " out [" + fs_read_file("ort_out") + "]"
let st4 = os_run_capture_timeout(p, Nil, "ort_out", "ort_err", 1000)
print "t1000 again: status " + str(st4) + " timed_out " + str(os_last_timed_out()) + " ms " + str((os_monotonic_ns() - t3) / 1000000)
