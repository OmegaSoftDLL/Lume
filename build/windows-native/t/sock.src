# sock.src -- TCP over loopback in one process: listen, connect, accept, send both ways, shutdown, close
fn try_port(p) = let s = net_tcp_listen(p) in if s >= 0 or p > 47999 then {s: s, p: p} else try_port(p + 1)
let l = try_port(47710)
let c = net_tcp_connect(l.p)
let a = net_tcp_accept(l.s)
let s1 = net_send_str(c, "ping from client")
let r1 = net_recv_str(a, 64)
let s2 = net_send_str(a, "pong from server")
let r2 = net_recv_str(c, 64)
let sh = net_shutdown_write(c)
let eof = net_recv_str(a, 64)
print "listen " + str(l.s >= 0) + " connect " + str(c >= 0) + " accept " + str(a >= 0)
print "[" + r1 + "] [" + r2 + "] eof [" + eof + "]"
print "close " + str(net_close(a)) + " " + str(net_close(c)) + " " + str(net_close(l.s))
print "refused " + str(net_tcp_connect(1) < 0)
