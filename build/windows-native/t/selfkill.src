## kill(own pid, sig): the process ends by that signal, and a waiting parent sees exactly that signal
let pid = os_fork()
let r = if pid == 0 then (let k = os_kill(os_getpid(), 15) in os_exit(3)) else 0
print "fork child killed itself: status " + str(os_waitpid_status(pid))
let self = os_arg_at(0)
let st = if os_arg_count() >= 2 then os_kill(os_getpid(), 9) else os_run(self, Cons("again", Nil))
print "os_run child killed itself: status " + str(st)
