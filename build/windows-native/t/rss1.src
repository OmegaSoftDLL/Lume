fn mk(n, acc) = if n == 0 then acc else mk(n - 1, Cons("item" + str(n), acc))
fn len(xs, a) = match xs
    Nil => a
    Cons(h, t) => len(t, a + 1)
let base = os_self_maxrss_kb()
let xs = mk(300000, Nil)
let after = os_self_maxrss_kb()
print "base " + str(base) + " after " + str(after) + " growth " + str(after - base) + " n " + str(len(xs, 0))
