let st = os_run("t/child", Cons("hello world", Cons("x\"y\\", Nil)))
print "run status " + str(st)
let st2 = os_run_capture("t/child", Cons("cap", Nil), "proc_out.txt", "proc_err.txt")
print "capture status " + str(st2)
print fs_read_file("proc_out.txt")
let t0 = os_monotonic_ns()
let st3 = os_run_capture_timeout("t/sleeper", Nil, "p3o.txt", "p3e.txt", 300)
let t1 = os_monotonic_ns()
print "timeout status " + str(st3) + " timed_out " + str(os_last_timed_out())
print (t1 - t0) < 2000000000
let st4 = os_run("t/nonexistent_prog", Nil)
print "missing status " + str(st4)
let st5 = os_run_capture_timeout("t/child", Cons("fast", Nil), "p5o.txt", "p5e.txt", 5000)
print "fast status " + str(st5) + " timed_out " + str(os_last_timed_out()) + " rss_ok " + str(os_last_child_maxrss_kb() > 0)
let c1 = fs_remove("proc_out.txt")
let c2 = fs_remove("proc_err.txt")
let c3 = fs_remove("p3o.txt")
let c4 = fs_remove("p3e.txt")
let c5 = fs_remove("p5o.txt")
let c6 = fs_remove("p5e.txt")
