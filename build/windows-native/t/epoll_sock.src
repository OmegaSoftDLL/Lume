## epoll on sockets: a listening socket is readable when a client connects, an accepted socket when bytes arrive
## or the peer closes
let sfd = net_tcp_listen(42997)
let epfd = epoll_create_fd()
let a = epoll_add_in(epfd, sfd, 11)
let idle = epoll_wait_one(epfd, 30)
let pid = os_fork()
let r = if pid == 0 then (let c = net_tcp_connect(42997) in let w = os_sleep_ms(100) in let s = net_send_str(c, "ping") in let w2 = os_sleep_ms(100) in let z = net_close(c) in os_exit(0)) else 0
let e1 = epoll_wait_one(epfd, 5000)
let afd = net_tcp_accept(sfd)
let b = epoll_add_in(epfd, afd, 22)
let e2 = epoll_wait_one(epfd, 5000)
let msg = net_recv_str(afd, 64)
let e3 = epoll_wait_one(epfd, 5000)
let st = os_waitpid_status(pid)
print "idle " + str(idle) + " connect " + str(e1 % 1000) + " data " + str(e2 % 1000) + " " + msg + " peer closed " + str(e3 % 1000)
